// ent map: a program's world map in a window (tools/ent map program.ent
// makes the map, with the compiler's --ent-world-map, and opens it here).
//
//   ent_map program.map
//
// At the top, what the program's world is made of. At the left, its
// archetypes, those whose entities change state first. In the middle, the
// entities' lifecycle as a MatrixWave (Zhao et al., CHI 2015): a matrix for
// each run of `main`'s schedules that changes an entity's state, in the
// order they run; a cell is a change from the state of its row to that of
// its column (or, in every other matrix, which is turned, of its column to
// its row): each matrix's states that come out are the next one's that go
// in, along the axis they share. As the paper draws it, the matrices are
// turned by 45 degrees, up and down by turns, so the wave runs to the
// right as the schedules do; on each axis a bar for each state, as long as
// how many changes come into it and go out of it; the states' names on
// each matrix's side across from the axis they go in by. An axis has only
// the states that something comes into or goes out of there, so the
// matrices grow and shrink along the wave; A, or the line at the foot of
// the list, puts every state on every axis (the paper's proxy nodes). A
// state is an archetype with which of its optional
// components of the lens are present; "born" and "gone" are before a spawn
// and after a despawn.
//
// The other view, Systems × data: a row for each run of a system, a column
// for each component, unique and the like, a cell where the run reads or
// writes it; its stage and why it waits, at the pointer.
//
// Time, of a trace of the program (ent map program.ent --trace): how many
// entities each archetype had as it ran, how long each run of the
// schedules took, and the systems, schedules and loops by their time.
//
// Memory: the world's bytes as a treemap, each archetype, unique,
// relation, buffer and index, its parts and fields as big as they are.
//
// And Provenance: a value (a component's field, a unique's...), the writes
// that give it one, each with the values it is made from and those it
// depends on, and the writes it goes into; a click on one shows that one.
//
// Click an archetype to see its entities (All: every one); the wheel
// zooms, dragging moves the wave; the pointer on a cell says which run,
// from what to what, and where in the program; on a bar of an axis, how
// many changes come into that state there and go out of it.
//
// With ENT_MAP_SHOT=picture.png it draws the wave once (of the archetype
// whose label ENT_MAP_ARCH is, where set; ENT_MAP_VIEW=data, schedule, cores, provenance, time
// or memory: those views, ENT_MAP_ZOOM the memory's node shown whole, ENT_MAP_VALUE the value's words), saves its picture there and
// ends: for checks and pictures of it. ENT_MAP_POINT=x,y puts the pointer
// there in it (in the window's points).
import window
import console
import files
import text

// What the map says of the program as a whole.
unique Map {
  sources: i32, loaded: bool, program: text, lens: text, labels: text, names: text,
  archetypes: i32, systems: i32, components: i32, tags: i32, resources: i32,
  schedules: i32, queries: i32, states: i32, flows: i32, steps: i32,
  rows: i32, columns: i32, cells: i32, main_rows: i32,
  gpu: i32, opaque: i32, error: text
}
// An archetype: its number in the map, how it is told from the others,
// how many states its entities have; its row in the list (-1: not in it).
component Arch { index: i32, label: text, states: i32, row: i32 }
// A state: its number, archetype, name; its place on the axes (-1: not
// shown).
component St { index: i32, arch: i32, name: text, slot: i32 }
// A change of state: the step (the run) it is in, from and to which state
// (-1 born, -2 gone) and their archetypes (-1 for those), what it is and
// where; the matrix it is drawn in (-1: not shown).
component Fl {
  step: i32, from: i32, to: i32, from_arch: i32, to_arch: i32, kind: text,
  place: text, col: i32
}
// A step: its number, the run's system and schedule, which archetypes'
// entities it changes (",3,7,"); its matrix (-1: not shown).
component Stp { step: i32, system: text, schedule: text, archs: text, col: i32 }

// By number: a state's archetype and place, a step's matrix, how many
// states an archetype has.
buffer StateRow { arch: i32, slot: i32 } capacity 65536
buffer StepRow { seen: i32, col: i32 } capacity 65536
buffer ArchRow { states: i32 } capacity 65536

// What is shown: the archetype (-1 all), how big a cell is, where the wave
// is; how many states its axes have and how many matrices; and whether to
// work that out again.
unique View {
  mode: i32, arch: i32, cell: f32, gap: f32, ox: f32, oy: f32, n: i32, shown: i32, dirty: bool,
  listed: i32, dragging: bool, most: i32, longest: f32, names: text, every: bool, moved: f32,
  clicked: bool
}
// How many changes come into each place of an axis (by the run before)
// and go out of it (by the run after): axis by axis, place by place.
buffer AxVol { inn: i32, out: i32 } capacity 1048576
// Matrix k (and the axis that goes into it): its run, its top left on the
// staircase in cells, how many places its axis has.
buffer WaveCol { step: i32, x: f32, y: f32, count: i32 } capacity 16385
// Where a state (or born, gone) is on an axis (-1: not on it), by axis
// times places; and which is the p-th place of an axis.
buffer WaveAt { pos: i32 } capacity 1048576
buffer WaveNode { j: i32 } capacity 1048576
// What the pointer is on: a cell's words, or none.
// The picture asked for (ENT_MAP_SHOT), and the frames before it is taken.
unique Shot { file: text, arch: text, frames: i32, done: bool, px: f32, py: f32 }
unique Hover {
  words: text, x: f32, y: f32, k: i32, from: i32, to: i32, from_name: text, to_name: text,
  step_words: text, tip: text, axis: i32, node: i32
}

default_capacity 65536
capacity Arch 4096
capacity Stp 16384

world {
  Window.width = 1400
  Window.height = 900
  Window.min_width = 640
  Window.min_height = 420
  Window.title = "ent map"
  Window.background = 0x101418
  Window.fps = 60
  Window.resizable = true
  // (Escape closes the source, not the map.)
  Window.escape = true
  View.arch = -1
  View.cell = 14.0
  View.ox = 420.0
  View.oy = 150.0
  View.dirty = true
  Hover.k = -1
  Hover.axis = -1
}

fn top() -> f32 { 96.0 }
fn panel() -> f32 { 260.0 }
fn row_height() -> f32 { 22.0 }
fn born() -> i32 { -1 }
fn gone() -> i32 { -2 }

// The n-th tab-separated field of a line (from 0); none where it has fewer.
fn part(line: text, n: i32) -> text {
  var at = 0
  var k = 0
  while k < n && at >= 0 {
    let tab = find(line, "\t", at)
    at = if tab < 0 { -1 } else { tab + 1 }
    k += 1
  }
  var out = ""
  if at >= 0 {
    let end = find(line, "\t", at)
    out = slice(line, at, if end < 0 { len(line) } else { end })
  }
  out
}
fn int(t: text) -> i32 { number(t) as i32 }
// The n-th line of a text (from 0).
fn line_at(t: text, n: i32) -> text {
  var at = 0
  var k = 0
  while k < n && at >= 0 {
    let nl = find(t, "\n", at)
    at = if nl < 0 { -1 } else { nl + 1 }
    k += 1
  }
  var out = ""
  if at >= 0 {
    let end = find(t, "\n", at)
    out = slice(t, at, if end < 0 { len(t) } else { end })
  }
  out
}
// A module's name taken off ("field.Focused": "Focused").
fn short(name: text) -> text {
  var at = len(name) - 1
  while at >= 0 && name[at] != '.' { at -= 1 }
  slice(name, at + 1, len(name))
}
// "field.Focused,field.Edited": " +Focused +Edited".
fn present_words(list: text) -> text {
  var out = ""
  var from = 0
  var i = 0
  while i <= len(list) {
    if i == len(list) || list[i] == ',' {
      if i > from { out = out + " +" + short(slice(list, from, i)) }
      from = i + 1
    }
    i += 1
  }
  out
}
fn in_view(arch: i32, chosen: i32) -> bool { chosen == -1 || arch == chosen }
// (Several changes in one run, one after the other: violet.)
fn kind_colour(kind: text) -> i32 {
  if find(kind, ", ", 0) >= 0 { 0xa77be0 }
  else if kind == "spawn" { 0x4f9de0 }
  else if kind == "despawn" { 0xe0564f }
  else if slice(kind, 0, 4) == "add " { 0x56c26a }
  else { 0xe0a03a }
}
// The axis place of a state: born and gone after the states.
fn axis(state: i32, slot: i32, n: i32) -> i32 {
  if state == -1 { n } else if state == -2 { n + 1 } else { slot }
}
// The wave, as MatrixWave draws it (Zhao, Liu, Dontcheva, Hertzmann and
// Wilson, CHI 2015): a transition matrix for each run, turned by 45
// degrees, one beside the other up and down, each sharing the axis of
// what comes out of it with the next, which takes it as what goes in.
// Laid out first as a staircase (u to the right, v down), then turned:
// the even matrices have what goes in down their left (rows), the odd
// ones along their top (columns), with a strip of three cells between one
// and the next for the axis they share. As in the paper, an axis has only
// the states something comes into or goes out of there, so a matrix is
// as big as the states before its run and after it, and the wave grows and
// shrinks; with View.every (the paper's "proxy nodes") every state is on
// every axis.
fn strip() -> f32 { 3.0 }
// Where a point (u, v) of the staircase is in the window: turned by 45
// degrees about (ox, oy), so that the staircase runs to the right.
fn wave_x(ox: f32, u: f32, v: f32) -> f32 { ox + (u + v) * 0.70710678 }
fn wave_y(oy: f32, u: f32, v: f32) -> f32 { oy + (v - u) * 0.70710678 }
// A box of the staircase, turned: a diamond.
proc wave_box(ox: f32, oy: f32, u0: f32, v0: f32, u1: f32, v1: f32, colour: i32) {
  quad(wave_x(ox, u0, v0), wave_y(oy, u0, v0), wave_x(ox, u1, v0), wave_y(oy, u1, v0),
       wave_x(ox, u1, v1), wave_y(oy, u1, v1), wave_x(ox, u0, v1), wave_y(oy, u0, v1), colour)
}
proc wave_line(ox: f32, oy: f32, u0: f32, v0: f32, u1: f32, v1: f32, colour: i32) {
  line(wave_x(ox, u0, v0), wave_y(oy, u0, v0), wave_x(ox, u1, v1), wave_y(oy, u1, v1), colour)
}
// A name written at a matrix (its top left x0, y0 and size w, h, all on
// the staircase, in pixels) for the place p of the axis it goes in by, on
// the side across from that axis, away from it.
proc wave_name(name: text, odd: bool, p: i32, x0: f32, y0: f32, w: f32, h: f32, cell: f32, size: f32,
               ox: f32, oy: f32, colour: i32) {
  let c = (p as f32 + 0.5) * cell
  if !odd {
    let u = x0 + w + 5.0
    let v = y0 + c - size * 0.5
    label_turned(name as text[126], wave_x(ox, u, v), wave_y(oy, u, v), size, -45.0, colour)
  } else {
    let u = x0 + c + size * 0.5
    let v = y0 + h + 5.0
    label_turned(name as text[126], wave_x(ox, u, v), wave_y(oy, u, v), size, 45.0, colour)
  }
}
// The name of the run of a matrix ("3. fill").
fn run_name(step: i32, system: text) -> text { "{step + 1}. " + short(system) }

// ---- Systems × data -------------------------------------------------
// A row for each run of a system, in the order `main` runs the schedules;
// a column for each component, unique, relation, buffer, and the
// entities and ticks themselves, in the order of the first row that
// touches it; a cell where the row reads it (blue), writes it (orange) or
// both. At the left of a row its stage (runs of one stage commute) and a
// red dot where the system has effects outside the world, which keep it
// in its place among all others.

// A run: its row, schedule, place in it, system, stage, what it waits
// for and why, where it is, where it calls out, whether on the GPU, the
// first of its schedule; where it is shown (-1: not).
component Rw {
  index: i32, schedule: text, position: i32, system: text, stage: i32, waits: text,
  why: text, place: text, opaque: text, gpu: bool, first: bool, shown: i32, main: bool
}
// A column: its number, kind, name; where it is shown (-1: not).
component Cn { index: i32, kind: text, name: text, shown: i32 }
// A cell: row, column, 0 reads 1 writes 2 both, the parts read and written.
component Ce { row: i32, col: i32, how: i32, reads: text, writes: text }
// A schedule in the list: its name, how many runs, its row in the list.
component Sch { name: text, runs: i32, row: i32 }
buffer RowAt { shown: i32 } capacity 65536
buffer SchRuns { runs: i32 } capacity 4096
buffer ColAt { used: i32, shown: i32 } capacity 65536

// The grid: the schedule shown (-1 all), how big a cell is, where the grid
// is; how many rows and columns are shown; what the pointer is on and the
// words of it, where.
unique Grid {
  sched: i32, cell: f32, ox: f32, oy: f32, rows: i32, cols: i32, dirty: bool,
  dragging: bool, r: i32, c: i32, words: text, tx: f32, ty: f32, scheds: i32,
  name: text, at: i32, moved: f32, clicked: bool
}

fn read_colour() -> i32 { 0x4f9de0 }
fn write_colour() -> i32 { 0xe0a03a }
fn opaque_colour() -> i32 { 0xe0564f }
fn kind_band(kind: text) -> i32 {
  if kind == "unique" { 0xa77be0 }
  else if kind == "world" { 0x3fb8a8 }
  else if kind == "relation" { 0xd0c050 }
  else if kind == "buffer" { 0xc07850 }
  else { 0x5a6878 }
}
fn label_room() -> f32 { 300.0 }
fn header_room() -> f32 { 150.0 }


// ---- Provenance -------------------------------------------------------
// A value (a field of a component, unique, relation or buffer, a
// component's presence, the entities; or where values come from that are
// none of those: outside, a constant) and the writes that give it one,
// each from which values and depending on which; and the writes it goes
// into. A chip is a value: clicked, it is the one shown.

// A value: its number, kind, name, field, short words; how many writes give
// it one and use it; its row in the list (-1: not in it).
component Val {
  index: i32, kind: text, name: text, field: text, label: text, writes: i32, uses: i32,
  row: i32
}
// A write: its number, system, where, how, the value it gives and that
// value's words and kind.
component Wr { index: i32, system: text, place: text, how: text, value: i32, label: text, kind: text }
// A source of a write: the write, the value, 0 made from it 1 depending on
// it, its number in the map; the value's words and kind; the chip, in its
// card.
component Fr {
  write: i32, value: i32, role: i32, order: i32, label: text, kind: text, x: f32, y: f32,
  w: f32, shown: bool
}
// By number: where a value's words are in Prov.names, its kind, how many
// writes give it one and use it; a write's value, its chips' cursor and
// lines, whether it has chips of what it depends on, whether it is made
// from or depends on the value shown; its card in "comes from" (y, height)
// and in "goes into" (-1: not there).
buffer ValAt { start: i32, end: i32, kind: i32, writes: i32, uses: i32 } capacity 65536
buffer WrAt {
  value: i32, cx: f32, lines: i32, when: i32, from_it: i32, on_it: i32, y: f32, h: f32, gy: f32
} capacity 65536
// The values shown before, to go back to.
buffer Back { value: i32 } capacity 4096

// The value shown (-1 none), what the list is narrowed to, how far the
// list and the cards are scrolled, the list's length; the words of every
// value; the heights of the two columns; whether to lay them out again;
// the value asked for by name (ENT_MAP_VALUE).
unique Prov {
  sel: i32, filter: text, list_top: f32, top: f32, listed: i32, names: text,
  from_h: f32, to_h: f32, dirty: bool, list_dirty: bool, counted: bool, value: text, go: i32
}

fn chip_h() -> f32 { 26.0 }
fn card_head() -> f32 { 30.0 }
fn card_width() -> f32 { 520.0 }
fn kind_number(kind: text) -> i32 {
  if kind == "component" { 0 } else if kind == "unique" { 1 } else if kind == "buffer" { 2 }
  else if kind == "relation" { 3 } else if kind == "world" { 4 } else if kind == "outside" { 5 }
  else { 6 }
}
fn kind_word(n: i32) -> text {
  if n == 0 { "component" } else if n == 1 { "unique" } else if n == 2 { "buffer" }
  else if n == 3 { "relation" } else if n == 4 { "world" } else if n == 5 { "outside" }
  else { "constant" }
}
fn value_colour(kind: text) -> i32 {
  if kind == "unique" { 0xa77be0 }
  else if kind == "world" { 0x3fb8a8 }
  else if kind == "relation" { 0xd0c050 }
  else if kind == "buffer" { 0xc07850 }
  else if kind == "outside" { 0xe0564f }
  else if kind == "constant" { 0x5a6878 }
  else { 0x4f9de0 }
}
// A value's short words: "Box.x", "Lit?", "Trail.rows", "outside: clipboard".
fn value_words(kind: text, name: text, field: text) -> text {
  if kind == "constant" { "a constant" }
  else if kind == "outside" { "outside: " + short(name) }
  else if kind == "world" { if len(field) > 0 { "entities." + field } else { "entities" } }
  else if field == "?" { short(name) + "?" }
  else { short(name) + "." + field }
}
// Its words at length.
fn value_title(kind: text, name: text, field: text) -> text {
  if kind == "constant" { "a constant of the program" }
  else if kind == "outside" { "what " + name + " gives: from outside the world" }
  else if kind == "world" { "the entities" + (if len(field) > 0 { " (their " + field + ")" } else { "" }) }
  else if field == "?" { "whether an entity has " + name }
  else { kind + " " + name + "." + field }
}

// ---- Time ---------------------------------------------------------------
// How the program ran, of a trace of it (`ent map program.ent --trace`,
// after a run of it built with --trace; tools/ent's trace_into_map): how
// many entities each archetype had after each run of a schedule `main`
// runs, and how long those runs took, over the run; and each system,
// schedule, sort and loop over entities by its own time, the most first.

// A site: its order (the most own time first), kind, whose (the system's,
// or the function's a loop is in), where, how often, its own time and all
// of it (microseconds), how much of a loop its threads worked, its words.
component Tk {
  order: i32, kind: text, who: text, place: text, times: i32, own: f32, all: f32,
  busy: text, label: text
}
// The runs of the schedules (at, in ms of the run; how long); the counts
// (at; where its archetypes' numbers begin in TVal); an archetype's most
// entities, its line's colour and place among the lines (-1: none).
buffer TRun { at: f32, ms: f32 } capacity 8192
buffer TCnt { at: f32, start: i32 } capacity 8192
buffer TVal { n: i32 } capacity 1048576
buffer ArchPk { peak: i32, colour: i32, rank: i32 } capacity 65536

// Whether there is a trace; how long it ran, on how many threads, its
// file; how many sites, the most own time of one; the most entities and
// the longest run; the schedules run; how many lines; the archetype
// chosen (-1 none); how far the table is scrolled; where the pointer is in
// the time (ms, -1 not) and what it is on; its words, where.
unique Tm {
  traced: bool, seconds: f32, threads: i32, file: text, took: i32, most: f32, peak: i32,
  run_peak: f32, schedules: text, lines: i32, arch: i32, scroll: f32, at: f32, row: i32,
  words: text, tx: f32, ty: f32
}

// "12.5": 12.5 (number gives whole numbers).
fn decimal(t: text) -> f64 {
  var whole = 0.0 as f64
  var part = 0.0 as f64
  var scale = 1.0 as f64
  var after = false
  var negative = false
  var i = 0
  while i < len(t) {
    let c = t[i] as i32
    if c == 45 { negative = true }
    else if c == 46 { after = true }
    else if c >= 48 && c <= 57 {
      if after {
        scale = scale / 10.0
        part = part + (c - 48) as f64 * scale
      } else {
        whole = whole * 10.0 + (c - 48) as f64
      }
    }
    i += 1
  }
  if negative { -(whole + part) } else { whole + part }
}
// x with `places` digits after the point ("1.50").
fn fixed(x: f64, places: i32) -> text {
  var scale = 1
  var k = 0
  while k < places {
    scale = scale * 10
    k += 1
  }
  let negative = x < 0.0
  let all = ((if negative { -x } else { x }) * scale as f64 + 0.5) as i64
  let whole = all / scale as i64
  var rest = "{all - whole * scale as i64}"
  while len(rest) < places { rest = "0" + rest }
  var out = "{whole}"
  if places > 0 { out = out + "." + rest }
  if negative { out = "-" + out }
  out
}
// A time in microseconds as it is best read: "820 µs", "12.40 ms", "3.21 s".
fn duration(us: f64) -> text {
  var out = fixed(us / 1000000.0, 2) + " s"
  if us < 1000.0 { out = fixed(us, 0) + " µs" }
  else if us < 1000000.0 { out = fixed(us / 1000.0, 2) + " ms" }
  out
}
// The lines' colours, by their place.
fn series_colour(rank: i32) -> i32 {
  if rank == 0 { 0x4f9de0 } else if rank == 1 { 0xe0a03a } else if rank == 2 { 0x56c26a }
  else if rank == 3 { 0xe0564f } else if rank == 4 { 0xa77be0 } else if rank == 5 { 0x3fb8a8 }
  else if rank == 6 { 0xd0c050 } else if rank == 7 { 0xc07850 } else if rank == 8 { 0xe07bb0 }
  else { 0x8fa0b0 }
}
fn most_lines() -> i32 { 10 }
// Where the charts and the table are.
fn chart_x() -> f32 { panel() + 64.0 }
fn chart_w(width: f32) -> f32 { width - chart_x() - 32.0 }
fn counts_y() -> f32 { top() + 40.0 }
fn counts_h() -> f32 { 170.0 }
fn runs_y() -> f32 { counts_y() + counts_h() + 34.0 }
fn runs_h() -> f32 { 70.0 }
fn table_y() -> f32 { runs_y() + runs_h() + 44.0 }
fn took_h() -> f32 { 20.0 }
// The x of a time (ms).
fn time_x(ms: f32, all_ms: f32, w: f32) -> f32 {
  chart_x() + (if all_ms > 0.0 { ms / all_ms } else { 0.0 }) * w
}

// The line of a text that is `name` (-1: none).
fn line_index(t: text, name: text) -> i32 {
  var at = 0
  var k = 0
  var found = -1
  while at < len(t) && found < 0 {
    var end = find(t, "\n", at)
    if end < 0 { end = len(t) }
    if slice(t, at, end) == name { found = k }
    at = end + 1
    k += 1
  }
  found
}

// ---- Schedule -----------------------------------------------------------
// The runs of each schedule as the lowering fuses them (--ent-fusion-map,
// as `ent build` always builds): the runs of a group are one loop over
// each archetype their queries go over, each entity going through every
// run's body in turn; a run that cannot be fused runs alone, and the map
// says why, as it says why each group ends where it does.

// A line: a schedule (0), something else the schedule does there, which
// ends a group (1), a group's head (2), a run (3); its schedule, place
// among its runs, group; its words (a system, the archetypes of a group, a
// break's reason) and why (a run's not fused, a group's not joining the
// one before); how many runs a head's group has (by its number in FHead,
// `ref`); its order and where it is (-1: not shown).
component FL {
  kind: i32, sname: text, position: i32, group: i32, words: text, why: text, count: i32, ref: i32,
  key: i32, y: f32, queries: i32, many: i32, one: text, most: i32, least: i32
}
buffer FHead { count: i32 } capacity 65536

// The schedules' names in the list's order; whether to lay the lines out
// again (and of which schedule); how high they are and how far they are
// scrolled; the line under the pointer, its words and where.
unique Fz {
  names: text, dirty: bool, chosen: i32, height: f32, top: f32, over: i32, words: text, tx: f32,
  ty: f32, groups: i32, alone: i32, over_sname: text, over_pos: i32
}

fn group_colour(group: i32) -> i32 {
  let k = group % 6
  if k == 0 { 0x4f9de0 } else if k == 1 { 0x56c26a } else if k == 2 { 0xe0a03a }
  else if k == 3 { 0xa77be0 } else if k == 4 { 0x3fb8a8 } else { 0xd0c050 }
}
fn fl_height(kind: i32, has_why: bool, count: i32, queries: i32) -> f32 {
  if kind == 0 { 44.0 } else if kind == 1 { 26.0 }
  else if kind == 2 { if count < 2 { 0.0 } else if has_why { 44.0 } else { 28.0 } }
  else if queries > 0 { 42.0 } else { 24.0 }
}
// From how many entities on a loop runs on many threads, in a build with
// --parallel: what its query says, else parallel-min-entities' default.
fn threshold(least: i32) -> i32 { if least > 0 { least } else { 1000000 } }
// "131072": "131,072".
fn three(n: i32) -> text { if n < 10 { "00{n}" } else if n < 100 { "0{n}" } else { "{n}" } }
fn grouped(n: i32) -> text {
  if n < 1000 { "{n}" }
  else if n < 1000000 { "{n / 1000}," + three(n % 1000) }
  else { "{n / 1000000}," + three((n / 1000) % 1000) + "," + three(n % 1000) }
}
// What a run's loops do with cores, a line.
fn cores_words(queries: i32, many: i32, one: text, most: i32, least: i32) -> text {
  let loops = if queries == 1 { "its loop" } else { "its {queries} loops" }
  if many == queries {
    if most >= threshold(least) {
      "many threads (--parallel): " + loops + ", from {grouped(threshold(least))} entities on (up to {grouped(most)} here)"
    } else {
      "one thread: at most {grouped(most)} entities, fewer than the {grouped(threshold(least))} from which " + loops +
        " would run on many (--parallel)"
    }
  } else if many == 0 {
    "one thread: " + one
  } else {
    "one thread for {queries - many} of its {queries} loops: " + one
  }
}
fn cores_colour(queries: i32, many: i32, most: i32, least: i32) -> i32 {
  if many == queries { if most >= threshold(least) { 0x56c26a } else { 0x7d8a98 } } else { 0xc98a8a }
}
fn fl_order(kind: i32) -> i32 { if kind == 1 { 0 } else if kind == 2 { 1 } else if kind == 3 { 2 } else { 0 } }
// "field.Url,field.Body": "Url, Body", by the archetypes' labels.
fn group_words(list: text, names: text, labels: text) -> text {
  var out = ""
  var from = 0
  var i = 0
  while i <= len(list) {
    if i == len(list) || list[i] == ',' {
      if i > from {
        let at = line_index(names, slice(list, from, i))
        if len(out) > 0 { out = out + ", " }
        if at >= 0 { out = out + line_at(labels, at) } else { out = out + short(slice(list, from, i)) }
      }
      from = i + 1
    }
    i += 1
  }
  out
}

// ---- Cores --------------------------------------------------------------
// What each thread did in a few runs of the schedule `main` runs most, of
// a run with a trace (`ent map --trace` of a build with --parallel and
// --trace): a lane for each thread, the time across; on the first, the
// schedule, its systems, their loops and that thread's share of each
// loop's work, one inside the other; on the others, their shares. A loop
// of runs fused is in its group's colour (as the Schedule view has it).

// A run of the schedule: its number, schedule, where it is in the run of
// the program, how long (us), why it was chosen, on how many threads.
component CFrame { index: i32, schedule: text, at: f32, us: f32, why: text, threads: i32 }
// What a thread did in one: its frame, thread, depth (inside how many of
// its thread's others), kind (0 a span: a schedule, system or sort; 1 a
// loop on many threads, entered and left on the first; 2 a thread's work
// in one; 3 a loop on one thread), from (us after the frame starts), how
// long, group of fused runs (-1 none), name and the words drawn on it.
component CSlice {
  frame: i32, thread: i32, depth: i32, kind: i32, from: f32, us: f32, group: i32, name: text, label: text
}
// A loop over entities of a frame: how long it took, how long its threads
// worked in it all told, its group, its name, the order it came in.
component CShare { frame: i32, us: f32, work: f32, group: i32, name: text, label: text, order: i32, times: i32 }

// How long each thread worked in the frame shown, by its number.
buffer CBusy { us: f32 } capacity 1024

// The frame shown; how many; the deepest of the first thread's slices in
// it; how long its threads worked, and in loops on many; the slice under
// the pointer, its words and where.
unique Co {
  frame: i32, frames: i32, dirty: bool, depth: i32, threads: i32, us: f32, work: f32, parallel: f32,
  words: text, tx: f32, ty: f32, shares: i32, schedule: text, why: text, over_group: i32
}

fn starts(name: text, with: text) -> bool { len(name) >= len(with) && slice(name, 0, len(with)) == with }
// "loop lanes.ent:187 in lanes.decide": "decide"; "system lanes.think
// (lanes.ent:174)": "think"; "schedule lanes.step (..)": "step"; "loop
// lanes.ent:285 in lanes.step" of fused runs: "fused".
fn slice_label(name: text, schedule: text) -> text {
  var who = name
  let at = find(name, " in ", 0)
  if starts(name, "loop ") && at >= 0 {
    var end = find(name, " ", at + 4)
    if end < 0 { end = len(name) }
    who = slice(name, at + 4, end)
    if who == schedule { who = "fused runs" }
  } else {
    let space = find(name, " ", 0)
    var end = find(name, " (", space + 1)
    if end < 0 { end = len(name) }
    if space >= 0 { who = slice(name, space + 1, end) }
  }
  if starts(name, "sort ") { "sort" } else { short(who) }
}
fn slice_kind(kind: text) -> i32 {
  if kind == "loop" { 1 } else if kind == "work" { 2 } else if kind == "serial" { 3 } else { 0 }
}
fn slice_colour(kind: i32, group: i32, name: text) -> i32 {
  if group >= 0 { if kind == 2 || kind == 1 { group_colour(group) } else { 0x3a4756 } }
  else if kind == 2 { 0x7d8ea2 }
  else if kind == 1 { 0x56677a }
  else if kind == 3 { 0xb07a5a }
  else if starts(name, "schedule ") { 0x26303a }
  else if starts(name, "sort ") { 0x8a7a5a }
  else { 0x3a4756 }
}
fn lane_h() -> f32 { 18.0 }
// Where a thread's row at `depth` is, below `y0`: the first thread's rows,
// then a row each.
fn lane_y(y0: f32, thread: i32, depth: i32, deepest: i32) -> f32 {
  if thread == 0 { y0 + depth as f32 * lane_h() }
  else { y0 + (deepest + 1) as f32 * lane_h() + 10.0 + (thread - 1) as f32 * lane_h() }
}
fn us_words(us: f32) -> text {
  if us >= 1000.0 { "{(us / 10.0) as i32 as f32 / 100.0} ms" } else { "{us as i32} µs" }
}
fn cores_x0() -> f32 { panel() + 130.0 }

// ---- Source ---------------------------------------------------------------
// The program's source where a place is (a click on a run, a slice, a site):
// a panel at the right with the file at that line, coloured as the editors
// colour it and by what each name declares (`ent map` gives the files to
// the map, coloured: tools/ent's sources_into_map); and buttons that open
// it there in VS Code or Zed.

// A file of the program: its number, its name (as places say it), where
// it is.
component SrcFile { index: i32, name: text, path: text }
// A line of one: its file, number, coloured words ("from,length,kind;..",
// in bytes), text.
component CodeLine { file: i32, line: i32, spans: text, text: text }

// Whether the panel is open; the place asked for (until it is opened);
// the file shown, its name and where it is; the line asked for and the
// first one shown; the font of code; what the pointer is on (a button: 1
// VS Code, 2 Zed, 3 close); a word of what could not be.
unique Src {
  open: bool, want: text, file: i32, name: text, path: text, line: i32, top: f32, mono: i32, over: i32,
  note: text, lines: i32
}

fn source_x(width: f32) -> f32 { width * 0.42 }
fn magnitude(x: f32) -> f32 { if x < 0.0 { -x } else { x } }
fn code_size() -> f32 { 13.0 }
fn code_h() -> f32 { 18.0 }
// The place in a trace's name of a site: "system lanes.drive
// (lanes.ent:251)", "loop lanes.ent:254 in lanes.drive": "lanes.ent:254";
// "" where it names none in a file of the program.
fn place_in(name: text) -> text {
  var out = ""
  let open = find(name, " (", 0)
  if starts(name, "loop ") {
    let end = find(name, " in ", 5)
    if end > 5 { out = slice(name, 5, end) }
  } else if open >= 0 {
    let end = find(name, ")", open)
    if end > open { out = slice(name, open + 2, end) }
  }
  if find(out, ".ent:", 0) < 0 { out = "" }
  out
}
// A path as a URL's: a space and what else a URL keeps for itself written
// "%20" and the like.
fn url_path(path: text) -> text {
  var out = ""
  var i = 0
  while i < len(path) {
    let c = path[i]
    if c == ' ' { out = out + "%20" }
    else if c == '#' { out = out + "%23" }
    else if c == '?' { out = out + "%3F" }
    else if c == '%' { out = out + "%25" }
    else { out = out + slice(path, i, i + 1) }
    i += 1
  }
  out
}
// The colour of a kind of word (see sources_into_map), on a dark ground,
// near what VS Code's dark theme gives the same.
fn code_colour(kind: text) -> i32 {
  if kind == "k" { 0xc586c0 } else if kind == "t" { 0x569cd6 } else if kind == "s" { 0xce9178 }
  else if kind == "n" { 0xb5cea8 } else if kind == "c" { 0x6a9955 } else if kind == "C" { 0x4ec9b0 }
  else if kind == "U" { 0xe5c07b } else if kind == "T" { 0x9fb4ff } else if kind == "K" { 0x4fc1ff }
  else if kind == "S" { 0xf0a050 } else if kind == "F" { 0xdcdcaa } else if kind == "H" { 0xe07a8a }
  else if kind == "M" { 0x8a98a6 } else if kind == "p" { 0x9cdcfe } else if kind == "f" { 0xdcdcaa }
  else { 0xd4d4d4 }
}
// A line of code, its words in their colours, from `x`.
proc code_line(text: text, spans: text, x: f32, y: f32, font: i32, size: f32) {
  var at = 0
  var cx = x
  var i = 0
  while i < len(spans) {
    var end = find(spans, ";", i)
    if end < 0 { end = len(spans) }
    let one = find(spans, ",", i)
    let two = find(spans, ",", one + 1)
    let from = int(slice(spans, i, one))
    let length = int(slice(spans, one + 1, two))
    let kind = slice(spans, two + 1, end)
    if from > at {
      let plain = slice(text, at, from)
      window::write(plain, cx, y, 4000.0, font, size, 0.0, 0.0, 2, 0, 0xd4d4d4)
      cx += text_extent(plain, font, size, 0.0, 2)
    }
    let word = slice(text, from, from + length)
    window::write(word, cx, y, 4000.0, font, size, 0.0, 0.0, 2, 0, code_colour(kind))
    cx += text_extent(word, font, size, 0.0, 2)
    at = from + length
    i = end + 1
  }
  if at < len(text) {
    window::write(slice(text, at, len(text)), cx, y, 4000.0, font, size, 0.0, 0.0, 2, 0, 0xd4d4d4)
  }
}

// ---- Memory -------------------------------------------------------------
// The world's memory, laid out once for all its life (--ent-memory-map):
// a treemap of its bytes, as disk space analyzers draw a disk, each box as
// big as what it holds: the kinds of arrays, each archetype, unique,
// relation, buffer and index in them, their components or parts, the
// fields. A click goes into the box under the pointer, one level; the
// secondary button, Backspace or a click on the path goes back out.

// A node: its parent, depth, bytes, first byte, kind, rows (of an
// archetype, relation or buffer), its first child and how many; where its
// name is in Mem.names; its box (w < 0: not shown).
buffer MemAt {
  parent: i32, depth: i32, bytes: f64, from: f64, kind: i32, rows: i32, first: i32, count: i32,
  start: i32, end: i32, x: f32, y: f32, w: f32, h: f32
} capacity 65536

// How big the world is and what a saved one holds; the names; the node
// shown whole (the root of the boxes) and the box under the pointer; its
// words and where; whether to lay the boxes out again (and of what size
// the window was).
unique Mem {
  total: f64, saved: f64, names: text, root: i32, over: i32, words: text, tx: f32, ty: f32,
  dirty: bool, lw: i32, lh: i32, zoom: text
}

fn mem_kind(kind: text) -> i32 {
  if kind == "archetype" { 0 } else if kind == "unique" { 1 } else if kind == "relation" { 2 }
  else if kind == "buffer" { 3 } else if kind == "index" { 4 } else if kind == "query" { 5 }
  else if kind == "log" { 6 } else if kind == "entities" { 7 } else if kind == "padding" { 8 }
  else { 9 }
}
fn mem_colour(kind: i32) -> i32 {
  if kind == 0 { 0x4f9de0 } else if kind == 1 { 0xa77be0 } else if kind == 2 { 0xd0c050 }
  else if kind == 3 { 0xe0a03a } else if kind == 4 { 0xe07bb0 } else if kind == 5 { 0x56c26a }
  else if kind == 6 { 0x3fb8a8 } else if kind == 7 { 0x8fc0e0 } else if kind == 8 { 0x3a434d }
  else { 0x7d8a98 }
}
// Darker, for the boxes that hold others.
fn mem_shade(colour: i32, depth: i32) -> i32 {
  let k = if depth <= 1 { 0.30 } else if depth == 2 { 0.42 } else { 0.55 }
  let r = (((colour / 65536) % 256) as f32 * k) as i32
  let g = (((colour / 256) % 256) as f32 * k) as i32
  let b = ((colour % 256) as f32 * k) as i32
  r * 65536 + g * 256 + b
}
// "1.50 MiB".
fn size_text(bytes: f64) -> text {
  var out = fixed(bytes, 0) + " B"
  if bytes >= 1073741824.0 { out = fixed(bytes / 1073741824.0, 2) + " GiB" }
  else if bytes >= 1048576.0 { out = fixed(bytes / 1048576.0, 2) + " MiB" }
  else if bytes >= 1024.0 { out = fixed(bytes / 1024.0, 1) + " KiB" }
  out
}
// Where the boxes are.
fn mem_y() -> f32 { top() + 40.0 }
fn mem_head() -> f32 { 17.0 }

// The map read: every line a record (lib/Ent/Transforms/WorldMap.cpp).
system load_map() {
  if !Map.loaded {
    Map.loaded = true
    let path = argument(0)
    let all = read_text(path)
    if len(all) == 0 {
      Map.error = "no map in '" + path + "' (ent map program.ent makes one)"
    }
    // (Its name: the map's file's, without its folder and ".map".)
    var cut = len(path) - 1
    while cut >= 0 && path[cut] != '/' { cut -= 1 }
    let file = slice(path, cut + 1, len(path))
    Map.program = if len(file) > 4 && slice(file, len(file) - 4, len(file)) == ".map" {
      slice(file, 0, len(file) - 4) + ".ent"
    } else { file }
    var labels = ""
    // (The node shown whole in a picture: ENT_MAP_ZOOM, by its name.)
    Mem.zoom = environment_variable("ENT_MAP_ZOOM")
    var at = 0
    var step = -1
    var system_name = ""
    var schedule_name = ""
    var archs = ","
    var froms = 0
    var fuse_sched = ""
    var fuse_group = -1
    var share_frame = -1
    var share_n = 0
    while at < len(all) {
      var end = find(all, "\n", at)
      if end < 0 { end = len(all) }
      let line = slice(all, at, end)
      at = end + 1
      let kind = part(line, 0)
      if kind == "component" {
        if len(part(line, 2)) == 0 { Map.tags += 1 } else { Map.components += 1 }
      } else if kind == "resource" {
        Map.resources += 1
      } else if kind == "archetype" {
        let label = part(line, 7)
        labels = labels + label + "\n"
        Map.names = Map.names + part(line, 2) + "\n"
        spawn { Arch { index: int(part(line, 1)), label: label, states: 0, row: -1 } }
        ArchRow += { states: 0 }
        ArchPk += { peak: 0, colour: 0x8fa0b0, rank: -1 }
        Map.archetypes += 1
      } else if kind == "system" {
        Map.systems += 1
        if part(line, 3) == "1" { Map.gpu += 1 }
        if len(part(line, 4)) > 0 { Map.opaque += 1 }
      } else if kind == "query" {
        Map.queries += 1
      } else if kind == "schedule" {
        Map.schedules += 1
        spawn {
          FL { kind: 0, sname: part(line, 1), position: -1, group: -1, words: part(line, 1), why: "", count: 0,
               ref: -1, key: 0, y: -1.0, queries: 0, many: 0, one: "", most: 0, least: 0 }
        }
      } else if kind == "fused" {
        let sname = part(line, 1)
        let group = int(part(line, 4))
        let why = part(line, 5)
        if group >= 0 && (sname != fuse_sched || group != fuse_group) {
          spawn {
            FL { kind: 2, sname: sname, position: int(part(line, 2)), group: group, words: "", why: why,
                 count: 0, ref: len(FHead), key: 0, y: -1.0, queries: 0, many: 0, one: "", most: 0, least: 0 }
          }
          FHead += { count: 0 }
        }
        if group >= 0 { FHead[len(FHead) - 1].count += 1 }
        fuse_sched = sname
        fuse_group = group
        spawn {
          FL { kind: 3, sname: sname, position: int(part(line, 2)), group: group, words: part(line, 3),
               why: why, count: 0, ref: if group >= 0 { len(FHead) - 1 } else { -1 }, key: 0, y: -1.0,
               queries: int(part(line, 6)), many: int(part(line, 7)), one: part(line, 8),
               most: int(part(line, 9)), least: int(part(line, 10)) }
        }
        Fz.dirty = true
      } else if kind == "source" {
        spawn { SrcFile { index: Map.sources, name: part(line, 1), path: part(line, 2) } }
        Map.sources += 1
      } else if kind == "code" {
        spawn {
          CodeLine { file: int(part(line, 1)), line: int(part(line, 2)), spans: part(line, 3),
                     text: part(line, 4) }
        }
      } else if kind == "frame" {
        let threads = int(part(line, 6))
        spawn {
          CFrame { index: int(part(line, 1)), schedule: part(line, 2), at: decimal(part(line, 3)) as f32,
                   us: decimal(part(line, 4)) as f32, why: part(line, 5), threads: threads }
        }
        while len(CBusy) < threads && len(CBusy) < 1024 { CBusy += { us: 0.0 } }
        Co.schedule = part(line, 2)
        if starts(part(line, 5), "the median") { Co.frame = int(part(line, 1)) }
        Co.frames += 1
        Co.dirty = true
      } else if kind == "slice" {
        let name = part(line, 8)
        spawn {
          CSlice { frame: int(part(line, 1)), thread: int(part(line, 2)), depth: int(part(line, 3)),
                   kind: slice_kind(part(line, 4)), from: decimal(part(line, 5)) as f32,
                   us: decimal(part(line, 6)) as f32, group: int(part(line, 7)), name: name,
                   label: slice_label(name, Co.schedule) }
        }
      } else if kind == "share" {
        let frame = int(part(line, 1))
        if frame != share_frame {
          share_frame = frame
          share_n = 0
        }
        let name = part(line, 5)
        spawn {
          CShare { frame: frame, us: decimal(part(line, 2)) as f32, work: decimal(part(line, 3)) as f32,
                   group: int(part(line, 4)), name: name, label: slice_label(name, Co.schedule), order: share_n,
                   times: max(int(part(line, 6)), 1) }
        }
        share_n += 1
      } else if kind == "fusebreak" {
        spawn {
          FL { kind: 1, sname: part(line, 1), position: int(part(line, 2)), group: -1, words: part(line, 3),
               why: "", count: 0, ref: -1, key: 0, y: -1.0, queries: 0, many: 0, one: "", most: 0, least: 0 }
        }
      } else if kind == "fusegroup" {
        let sname = part(line, 1)
        let group = int(part(line, 2))
        let words = group_words(part(line, 3), Map.names, labels) as text[2048]
        for h: mut FL where h.kind == 2 && h.sname == sname && h.group == group { h.words = words }
      } else if kind == "row" {
        let schedule = part(line, 2)
        let first = schedule != schedule_name
        if first {
          schedule_name = schedule
          SchRuns += { runs: 0 }
          spawn { Sch { name: schedule, runs: 0, row: len(SchRuns) } }
        }
        SchRuns[len(SchRuns) - 1].runs += 1
        spawn {
          Rw { index: int(part(line, 1)), schedule: schedule, position: int(part(line, 3)),
               system: part(line, 4), stage: int(part(line, 5)), waits: part(line, 6),
               why: part(line, 7), place: part(line, 8), opaque: part(line, 9),
               gpu: part(line, 10) == "1", first: first, shown: -1, main: part(line, 11) == "1" }
        }
        RowAt += { shown: -1 }
        Map.rows += 1
        if part(line, 11) == "1" { Map.main_rows += 1 }
      } else if kind == "column" {
        spawn { Cn { index: int(part(line, 1)), kind: part(line, 2), name: part(line, 3), shown: -1 } }
        Map.columns += 1
      } else if kind == "cell" {
        let how = part(line, 3)
        spawn {
          Ce { row: int(part(line, 1)), col: int(part(line, 2)),
               how: if how == "r" { 0 } else if how == "w" { 1 } else { 2 },
               reads: part(line, 4), writes: part(line, 5) }
        }
        Map.cells += 1
      } else if kind == "value" {
        let vk = part(line, 2)
        let words = value_words(vk, part(line, 3), part(line, 4))
        ValAt += { start: len(Prov.names), end: len(Prov.names) + len(words), kind: kind_number(vk),
                   writes: 0, uses: 0 }
        Prov.names = Prov.names + words
        spawn {
          Val { index: int(part(line, 1)), kind: vk, name: part(line, 3), field: part(line, 4),
                label: words, writes: 0, uses: 0, row: -1 }
        }
      } else if kind == "write" {
        let v = int(part(line, 5))
        spawn {
          Wr { index: int(part(line, 1)), system: part(line, 2), place: part(line, 3),
               how: part(line, 4), value: v, label: slice(Prov.names, ValAt[v].start, ValAt[v].end),
               kind: kind_word(ValAt[v].kind) }
        }
        WrAt += { value: v, cx: 0.0, lines: 0, when: 0, from_it: 0, on_it: 0, y: -1.0, h: 0.0, gy: -1.0 }
        ValAt[v].writes += 1
      } else if kind == "from" {
        let v = int(part(line, 2))
        spawn {
          Fr { write: int(part(line, 1)), value: v, role: if part(line, 3) == "when" { 1 } else { 0 },
               order: froms, label: slice(Prov.names, ValAt[v].start, ValAt[v].end),
               kind: kind_word(ValAt[v].kind), x: 0.0, y: 0.0, w: 0.0, shown: false }
        }
        ValAt[v].uses += 1
        froms += 1
      } else if kind == "memory" {
        Mem.total = decimal(part(line, 1))
        Mem.saved = decimal(part(line, 2))
      } else if kind == "mem" {
        let k = len(MemAt)
        let parent = int(part(line, 2))
        let mk = mem_kind(part(line, 6))
        var name = part(line, 7)
        // (An archetype by its label, as the other views say it.)
        if mk == 0 && int(part(line, 3)) == 2 {
          let at = line_index(Map.names, name)
          if at >= 0 { name = line_at(labels, at) }
        }
        MemAt += { parent: parent, depth: int(part(line, 3)), bytes: decimal(part(line, 4)),
                   from: decimal(part(line, 5)), kind: mk, rows: int(part(line, 8)), first: -1, count: 0,
                   start: len(Mem.names), end: len(Mem.names) + len(name), x: 0.0, y: 0.0, w: -1.0, h: 0.0 }
        Mem.names = Mem.names + name
        if parent >= 0 {
          if MemAt[parent].count == 0 { MemAt[parent].first = k }
          MemAt[parent].count += 1
        }
        if name == Mem.zoom && Mem.root == 0 { Mem.root = k }
      } else if kind == "traced" {
        Tm.traced = true
        Tm.seconds = decimal(part(line, 1)) as f32
        Tm.threads = int(part(line, 2))
        Tm.file = part(line, 3)
      } else if kind == "took" {
        let own = decimal(part(line, 5)) as f32
        if Tm.took == 0 { Tm.most = own }
        spawn {
          Tk { order: Tm.took, kind: part(line, 1), who: part(line, 2), place: part(line, 3),
               times: int(part(line, 4)), own: own, all: decimal(part(line, 6)) as f32,
               busy: part(line, 7), label: part(line, 8) }
        }
        Tm.took += 1
      } else if kind == "ran" {
        let ms = decimal(part(line, 3)) as f32
        TRun += { at: decimal(part(line, 2)) as f32, ms: ms }
        Tm.run_peak = max(Tm.run_peak, ms)
        let ran = part(line, 1)
        if find(", " + Tm.schedules + ", ", ", " + ran + ", ", 0) < 0 {
          if len(Tm.schedules) > 0 { Tm.schedules = Tm.schedules + ", " }
          Tm.schedules = Tm.schedules + ran
        }
      } else if kind == "entities" {
        TCnt += { at: decimal(part(line, 1)) as f32, start: len(TVal) }
        let list = part(line, 2)
        var i = 0
        var n = 0
        var a = 0
        while i <= len(list) {
          if i == len(list) || list[i] == ',' {
            TVal += { n: n }
            if a < len(ArchPk) && n > ArchPk[a].peak { ArchPk[a].peak = n }
            a += 1
            n = 0
          } else {
            n = n * 10 + (list[i] as i32 - 48)
          }
          i += 1
        }
      } else if kind == "lens" {
        schedule_name = ""
        Map.lens = part(line, 1)
      } else if kind == "state" {
        let arch = int(part(line, 2))
        spawn {
          St { index: int(part(line, 1)), arch: arch,
               name: line_at(labels, arch) + present_words(part(line, 3)), slot: -1 }
        }
        StateRow += { arch: arch, slot: -1 }
        ArchRow[arch].states += 1
        Map.states += 1
      } else if kind == "flow" {
        let s = int(part(line, 1))
        if s != step {
          if step >= 0 {
            spawn { Stp { step: step, system: system_name, schedule: schedule_name, archs: archs, col: -1 } }
          }
          step = s
          system_name = part(line, 4)
          schedule_name = part(line, 2)
          archs = ","
        }
        let from = int(part(line, 5))
        let to = int(part(line, 6))
        let from_arch = if from >= 0 { StateRow[from].arch } else { -1 }
        let to_arch = if to >= 0 { StateRow[to].arch } else { -1 }
        if from_arch >= 0 && find(archs, ",{from_arch},", 0) < 0 { archs = archs + "{from_arch}," }
        if to_arch >= 0 && find(archs, ",{to_arch},", 0) < 0 { archs = archs + "{to_arch}," }
        spawn {
          Fl { step: s, from: from, to: to, from_arch: from_arch, to_arch: to_arch,
               kind: part(line, 7), place: part(line, 8), col: -1 }
        }
        Map.flows += 1
      }
    }
    if step >= 0 {
      spawn { Stp { step: step, system: system_name, schedule: schedule_name, archs: archs, col: -1 } }
    }
    Map.steps = step + 1
    Map.labels = labels
    Shot.file = environment_variable("ENT_MAP_SHOT")
    Shot.arch = environment_variable("ENT_MAP_ARCH")
    if environment_variable("ENT_MAP_VIEW") == "data" { View.mode = 1 }
    if environment_variable("ENT_MAP_VIEW") == "provenance" { View.mode = 2 }
    if environment_variable("ENT_MAP_VIEW") == "time" { View.mode = 3 }
    if environment_variable("ENT_MAP_VIEW") == "memory" { View.mode = 4 }
    if environment_variable("ENT_MAP_VIEW") == "schedule" { View.mode = 5 }
    if environment_variable("ENT_MAP_VIEW") == "cores" { View.mode = 6 }
    // (Code in a font of letters as wide as each other, where the machine
    // has one; ENT_MAP_PLACE, a place shown at the start.)
    Src.mono = font("/System/Library/Fonts/SFNSMono.ttf", 32)
    if Src.mono == 0 { Src.mono = font("/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf", 32) }
    Src.want = environment_variable("ENT_MAP_PLACE")
    for h: mut FL where h.ref >= 0 { h.count = FHead[h.ref].count }
    Mem.dirty = true
    // (The archetypes with the most entities, a line each.)
    Tm.arch = -1
    Tm.at = -1.0
    Tm.row = -1
    var rank = 0
    while rank < most_lines() {
      var best = -1
      var most = 0
      var a = 0
      while a < len(ArchPk) {
        if ArchPk[a].rank < 0 && ArchPk[a].peak > most {
          best = a
          most = ArchPk[a].peak
        }
        a += 1
      }
      if best >= 0 {
        ArchPk[best].rank = rank
        ArchPk[best].colour = series_colour(rank)
        Tm.peak = max(Tm.peak, most)
        Tm.lines += 1
      }
      rank += 1
    }
    Prov.value = environment_variable("ENT_MAP_VALUE")
    Prov.sel = -1
    Prov.list_dirty = true
    Grid.sched = -1
    Grid.dirty = true
    // (And where the pointer is in the picture: ENT_MAP_POINT=x,y.)
    let point = environment_variable("ENT_MAP_POINT")
    let comma = find(point, ",", 0)
    Shot.px = if comma > 0 { number(slice(point, 0, comma)) as f32 } else { -1.0 }
    Shot.py = if comma > 0 { number(slice(point, comma + 1, len(point))) as f32 } else { -1.0 }
    StepRow = [{ seen: 0, col: -1 }; step + 1]
  }
}

// The archetypes in the list: those whose entities have states, in the
// map's order; All above them.
system list_archetypes() {
  for a: mut Arch { a.states = ArchRow[a.index].states }
  View.listed = 1
  for a: mut Arch in turn by a.index {
    if a.states > 0 {
      a.row = View.listed
      View.listed += 1
    }
  }
}

// What is shown worked out again: the states' places, the matrices.
system arrange() {
  if View.dirty {
    View.dirty = false
    View.n = 0
    for s: mut St in turn by s.index {
      if in_view(s.arch, View.arch) {
        s.slot = View.n
        View.n += 1
      } else {
        s.slot = -1
      }
      StateRow[s.index].slot = s.slot
    }
    View.shown = 0
    let chosen = View.arch
    for st: mut Stp in turn by st.step {
      if chosen == -1 || find(st.archs, ",{chosen},", 0) >= 0 {
        st.col = View.shown
        View.shown += 1
      } else {
        st.col = -1
      }
      StepRow[st.step].col = st.col
    }
    for f: mut Fl {
      let seen = in_view(f.from_arch, chosen) || in_view(f.to_arch, chosen)
      f.col = if seen { StepRow[f.step].col } else { -1 }
    }
    // What comes into each place of each axis and goes out of it.
    let places = View.n + 2
    let cells = min((View.shown + 1) * places, 1048576)
    AxVol = [{ inn: 0, out: 0 }; cells]
    WaveCol = [{ step: 0, x: 0.0, y: 0.0, count: 0 }; View.shown + 1]
    for st: Stp in turn by st.step where st.col >= 0 { WaveCol[st.col].step = st.step }
    let total = View.n
    for f: Fl in turn by f.step where f.col >= 0 {
      let a = axis(f.from, StateRow[max(f.from, 0)].slot, total)
      let b = axis(f.to, StateRow[max(f.to, 0)].slot, total)
      if a >= 0 && b >= 0 && (f.col + 1) * places + b < cells {
        AxVol[f.col * places + a].out += 1
        AxVol[(f.col + 1) * places + b].inn += 1
      }
    }
    var most = 1
    var i = 0
    while i < cells {
      most = max(most, max(AxVol[i].inn, AxVol[i].out))
      i += 1
    }
    View.most = most
    // The places of each axis: those something comes into or goes out of
    // there (or all), in the states' order.
    WaveAt = [{ pos: -1 }; cells]
    WaveNode = [{ j: 0 }; cells]
    var ax = 0
    while ax <= View.shown {
      var p = 0
      var j = 0
      while j < places {
        let at = ax * places + j
        if at < cells && (View.every || AxVol[at].inn + AxVol[at].out > 0) {
          WaveAt[at].pos = p
          WaveNode[ax * places + p].j = j
          p += 1
        }
        j += 1
      }
      WaveCol[ax].count = p
      ax += 1
    }
    // Where each matrix is, in cells: the next below an even one (it
    // shares its columns), right of an odd one (its rows); and how high
    // the wave is once turned (v - u from least to most).
    var x = 0.0
    var y = 0.0
    var low = 0.0
    var high = 0.0
    var k = 0
    while k <= View.shown {
      WaveCol[k].x = x
      WaveCol[k].y = y
      let lin = WaveCol[k].count as f32
      let lout = if k < View.shown { WaveCol[k + 1].count as f32 } else { 0.0 }
      if k % 2 == 0 {
        low = min(low, y - x - lout)
        high = max(high, y + lin - x + strip())
        y += lin + strip()
      } else {
        low = min(low, y - strip() - x - lin)
        high = max(high, y + lout - x)
        x += lin + strip()
      }
      k += 1
    }
    // (The names of the places in order, a line each, and how wide the
    // widest is.)
    View.names = ""
    View.longest = text_extent("gone", 0, 12.0, 0.0, 2)
    for s: St in turn by s.index where s.slot >= 0 {
      View.names += s.name + "\n"
      View.longest max= text_extent(s.name, 0, 12.0, 0.0, 2)
    }
    // (Cells as big as let the wave's height, and the names above and
    // below it where cells are big enough to name, be in the window; no
    // bigger than 40; the wave in the middle of the height.)
    let span = max(1.0, high - low) * 0.70710678
    let free = Window.height as f32 - top() - 40.0
    var room = 0.0
    var tall = free / span
    if tall >= 8.0 {
      room = (View.longest + 10.0) * 0.70710678
      tall = max(8.0, (free - 2.0 * room) / span)
    }
    View.cell = max(1.0, min(40.0, if tall >= 4.0 { tall as i32 as f32 } else { tall }))
    View.gap = strip() * View.cell
    let used = span * View.cell + 2.0 * room
    View.ox = panel() + 40.0 + View.gap * 0.70710678
    View.oy = top() + 20.0 + max(0.0, (free - used) * 0.5) + room - low * 0.70710678 * View.cell
  }
}

// Clicks in the list, the wheel, dragging; A (or the line at the foot of
// the list) puts every state on every axis, or only those used there.
system steer() {
  let mx = Mouse.x
  let my = Mouse.y
  if key_pressed(65) || (Mouse.clicks > 0 && mx < panel() && my > Window.height as f32 - 36.0) {
    View.every = !View.every
    View.dirty = true
  }
  if Mouse.clicks > 0 && mx < panel() && my > top() && my <= Window.height as f32 - 36.0 {
    let row = ((my - top() - 30.0) / row_height()) as i32
    if row == 0 {
      View.arch = -1
      View.dirty = true
    }
    for a: Arch where a.row == row && row > 0 {
      View.arch = a.index
      View.dirty = true
    }
  }
  // (Not under the source, where it is open; a press let go of where it
  // was is a click, which shows the source of what it is on.)
  View.clicked = false
  let free = !Src.open || mx < source_x(Window.width as f32)
  if mx > panel() && my > top() && free {
    if Mouse.wheel_y != 0.0 {
      let was = View.cell
      let cell = min(64.0, max(1.0, if Mouse.wheel_y > 0.0 { was * 1.15 } else { was / 1.15 }))
      View.ox = mx - (mx - View.ox) * cell / was
      View.oy = my - (my - View.oy) * cell / was
      View.cell = cell
      View.gap = 3.0 * cell
    }
    if Mouse.clicks > 0 {
      View.dragging = true
      View.moved = 0.0
    }
  }
  if !Mouse.left {
    if View.dragging && View.moved < 4.0 { View.clicked = true }
    View.dragging = false
  }
  if View.dragging {
    View.ox += Mouse.dx
    View.oy += Mouse.dy
    View.moved += magnitude(Mouse.dx) + magnitude(Mouse.dy)
  }
}

// What the pointer is on: a cell of a matrix, or a place on an axis.
system hover() {
  Hover.words = ""
  Hover.tip = ""
  Hover.k = -1
  Hover.axis = -1
  let cell = View.cell
  let g = strip()
  let n = View.n + 2
  let px = if Shot.px >= 0.0 { Shot.px } else { Mouse.x }
  let py = if Shot.px >= 0.0 { Shot.py } else { Mouse.y }
  // (Where it is on the staircase, turned back, in cells.)
  let u = (px - View.ox - (py - View.oy)) * 0.70710678 / cell
  let v = (px - View.ox + (py - View.oy)) * 0.70710678 / cell
  if px > panel() && py > top() && !View.dragging && View.mode == 0 && len(WaveCol) > View.shown {
    var k = 0
    var on = -1
    var a = -1
    var b = -1
    var ax = -1
    var node = -1
    while k <= View.shown {
      let x0 = WaveCol[k].x
      let y0 = WaveCol[k].y
      let lin = WaveCol[k].count
      let lout = if k < View.shown { WaveCol[k + 1].count } else { 0 }
      let w = (if k % 2 == 0 { lout } else { lin }) as f32
      let h = (if k % 2 == 0 { lin } else { lout }) as f32
      if k < View.shown && u >= x0 && u < x0 + w && v >= y0 && v < y0 + h {
        on = k
        let cx = (u - x0) as i32
        let cy = (v - y0) as i32
        // (Even: rows go in, columns come out; odd: the other way.)
        let pa = if k % 2 == 0 { cy } else { cx }
        let pb = if k % 2 == 0 { cx } else { cy }
        a = WaveNode[k * n + pa].j
        b = WaveNode[(k + 1) * n + pb].j
      }
      // (The axis that goes into matrix k: left of an even one, above an
      // odd one.)
      if k % 2 == 0 && u >= x0 - g && u < x0 && v >= y0 && v < y0 + lin as f32 {
        ax = k
        node = WaveNode[k * n + (v - y0) as i32].j
      }
      if k % 2 == 1 && v >= y0 - g && v < y0 && u >= x0 && u < x0 + lin as f32 {
        ax = k
        node = WaveNode[k * n + (u - x0) as i32].j
      }
      k += 1
    }
    let total = View.n
    if on >= 0 {
      Hover.k = on
      Hover.from = a
      Hover.to = b
      for f: Fl in turn by f.step where f.col == on {
        if axis(f.from, StateRow[max(f.from, 0)].slot, total) == a &&
           axis(f.to, StateRow[max(f.to, 0)].slot, total) == b {
          if View.clicked && len(Src.want) == 0 { Src.want = f.place }
          Hover.words = Hover.words + f.kind + "  (" + f.place + ")\n"
        }
      }
      Hover.from_name = if a == total { "born" } else if a == total + 1 { "gone" } else { "?" }
      Hover.to_name = if b == total { "born" } else if b == total + 1 { "gone" } else { "?" }
      for s: St in turn by s.index where s.slot >= 0 {
        if s.slot == a { Hover.from_name = s.name }
        if s.slot == b { Hover.to_name = s.name }
      }
      for st: Stp in turn by st.step where st.col == on {
        Hover.step_words = run_name(st.step, st.system) + " (in " + st.schedule + ")"
      }
      var words = Hover.words as text[4094]
      if len(words) == 0 { words = "no change\n" }
      Hover.tip = Hover.step_words + "\n" + Hover.from_name + "  ->  " + Hover.to_name + "\n" + words
    } else if ax >= 0 {
      Hover.axis = ax
      Hover.node = node
      var name = line_at(View.names, node) as text[512]
      if node == total { name = "born" }
      if node == total + 1 { name = "gone" }
      Hover.from_name = "the start"
      Hover.to_name = "the end"
      if ax > 0 {
        let step = WaveCol[ax - 1].step
        for st: Stp in turn by st.step where st.step == step { Hover.from_name = run_name(st.step, st.system) }
      }
      if ax < View.shown {
        let step = WaveCol[ax].step
        for st: Stp in turn by st.step where st.step == step { Hover.to_name = run_name(st.step, st.system) }
      }
      let before = Hover.from_name as text[512]
      let after = Hover.to_name as text[512]
      let at = ax * n + node
      let inn = if at < len(AxVol) { AxVol[at].inn } else { 0 }
      let out = if at < len(AxVol) { AxVol[at].out } else { 0 }
      var counts = "{inn} changes come in, "
      if inn == 1 { counts = "1 change comes in, " }
      if out == 1 { counts = counts + "1 goes out" } else { counts = counts + "{out} go out" }
      Hover.tip = name + "\nbetween " + before + " and " + after + "\n" + counts + "\n"
    }
    Hover.x = px + 16.0
    Hover.y = py + 14.0
  }
}

// The lifecycle: the wave, and the archetypes at the left.
system draw_wave() {
  let cell = View.cell
  let g = View.gap
  let n = View.n + 2
  let ox = View.ox
  let oy = View.oy
  let total = View.n
  let right = Window.width as f32
  let ready = len(WaveCol) > View.shown
  clip(panel(), top(), Window.width as f32 - panel(), Window.height as f32 - top())
  // (The matrices in the window: from first to before last.)
  var first = 0
  var last = 0
  if ready {
    while first < View.shown && wave_x(ox, WaveCol[first + 1].x * cell, WaveCol[first + 1].y * cell) < panel() {
      first += 1
    }
    last = first
    while last < View.shown && wave_x(ox, WaveCol[last].x * cell, WaveCol[last].y * cell) - g < right {
      last += 1
    }
  }
  // The matrices: their ground, born's row and gone's column apart, a
  // line every place, the run's number faint in the middle.
  var k = first
  while k < last {
    let x0 = WaveCol[k].x * cell
    let y0 = WaveCol[k].y * cell
    let lin = WaveCol[k].count
    let lout = WaveCol[k + 1].count
    let w = (if k % 2 == 0 { lout } else { lin }) as f32 * cell
    let h = (if k % 2 == 0 { lin } else { lout }) as f32 * cell
    wave_box(ox, oy, x0, y0, x0 + w, y0 + h, 0x18202a)
    let born_at = WaveAt[k * n + total].pos
    let gone_at = WaveAt[(k + 1) * n + total + 1].pos
    if born_at >= 0 {
      let d = born_at as f32 * cell
      if k % 2 == 0 { wave_box(ox, oy, x0, y0 + d, x0 + w, y0 + d + cell, 0x1b2836) }
      else { wave_box(ox, oy, x0 + d, y0, x0 + d + cell, y0 + h, 0x1b2836) }
    }
    if gone_at >= 0 {
      let d = gone_at as f32 * cell
      if k % 2 == 0 { wave_box(ox, oy, x0 + d, y0, x0 + d + cell, y0 + h, 0x2a1d22) }
      else { wave_box(ox, oy, x0, y0 + d, x0 + w, y0 + d + cell, 0x2a1d22) }
    }
    if cell >= 7.0 {
      var i = 1
      while i < max(lin, lout) {
        let d = i as f32 * cell
        if d < w { wave_line(ox, oy, x0 + d, y0, x0 + d, y0 + h, 0x222b35) }
        if d < h { wave_line(ox, oy, x0, y0 + d, x0 + w, y0 + d, 0x222b35) }
        i += 1
      }
    }
    let least = min(w, h)
    let size = min(72.0, least * 0.3)
    let cx = wave_x(ox, x0 + w * 0.5, y0 + h * 0.5)
    let cy = wave_y(oy, x0 + w * 0.5, y0 + h * 0.5)
    let step = WaveCol[k].step
    window::write("{step + 1}", cx - least * 0.5, cy - size * 0.6, least, 0, size, 0.0, 0.0, 2, 1, 0x26303b)
    wave_line(ox, oy, x0, y0, x0 + w, y0, 0x4a5866)
    wave_line(ox, oy, x0 + w, y0, x0 + w, y0 + h, 0x4a5866)
    wave_line(ox, oy, x0 + w, y0 + h, x0, y0 + h, 0x4a5866)
    wave_line(ox, oy, x0, y0 + h, x0, y0, 0x4a5866)
    k += 1
  }
  // The runs' names under their numbers, where a matrix has room.
  for st: Stp where st.col >= first && st.col < last && ready {
    let x0 = WaveCol[st.col].x * cell
    let y0 = WaveCol[st.col].y * cell
    let w = (if st.col % 2 == 0 { WaveCol[st.col + 1].count } else { WaveCol[st.col].count }) as f32 * cell
    let h = (if st.col % 2 == 0 { WaveCol[st.col].count } else { WaveCol[st.col + 1].count }) as f32 * cell
    let least = min(w, h)
    let words = short(st.system)
    if least >= 90.0 && text_extent(words, 0, 13.0, 0.0, 2) < least * 0.9 {
      let cx = wave_x(ox, x0 + w * 0.5, y0 + h * 0.5)
      let cy = wave_y(oy, x0 + w * 0.5, y0 + h * 0.5)
      window::write(words, cx - least * 0.5, cy + min(72.0, least * 0.3) * 0.45, least, 0, 13.0, 0.0, 0.0, 2,
            1, 0x3a4652)
    }
  }
  // Where the pointer is: the row and column of a cell; or a place on an
  // axis, the row or column it goes out by and that it comes in by.
  if Hover.k >= 0 && ready {
    let k = Hover.k
    let x0 = WaveCol[k].x * cell
    let y0 = WaveCol[k].y * cell
    let w = (if k % 2 == 0 { WaveCol[k + 1].count } else { WaveCol[k].count }) as f32 * cell
    let h = (if k % 2 == 0 { WaveCol[k].count } else { WaveCol[k + 1].count }) as f32 * cell
    let pa = WaveAt[k * n + Hover.from].pos as f32 * cell
    let pb = WaveAt[(k + 1) * n + Hover.to].pos as f32 * cell
    let r = if k % 2 == 0 { pa } else { pb }
    let c = if k % 2 == 0 { pb } else { pa }
    wave_box(ox, oy, x0, y0 + r, x0 + w, y0 + r + cell, 0x28ffffff)
    wave_box(ox, oy, x0 + c, y0, x0 + c + cell, y0 + h, 0x28ffffff)
  }
  if Hover.axis >= 0 && ready {
    let a = Hover.axis
    let j = WaveAt[a * n + Hover.node].pos as f32 * cell
    if a < View.shown {
      let x0 = WaveCol[a].x * cell
      let y0 = WaveCol[a].y * cell
      let w = (if a % 2 == 0 { WaveCol[a + 1].count } else { WaveCol[a].count }) as f32 * cell
      let h = (if a % 2 == 0 { WaveCol[a].count } else { WaveCol[a + 1].count }) as f32 * cell
      if a % 2 == 0 { wave_box(ox, oy, x0, y0 + j, x0 + w, y0 + j + cell, 0x28ffffff) }
      else { wave_box(ox, oy, x0 + j, y0, x0 + j + cell, y0 + h, 0x28ffffff) }
    }
    if a > 0 {
      let x0 = WaveCol[a - 1].x * cell
      let y0 = WaveCol[a - 1].y * cell
      let w = (if a % 2 == 1 { WaveCol[a].count } else { WaveCol[a - 1].count }) as f32 * cell
      let h = (if a % 2 == 1 { WaveCol[a - 1].count } else { WaveCol[a].count }) as f32 * cell
      if a % 2 == 1 { wave_box(ox, oy, x0 + j, y0, x0 + j + cell, y0 + h, 0x28ffffff) }
      else { wave_box(ox, oy, x0, y0 + j, x0 + w, y0 + j + cell, 0x28ffffff) }
    }
  }
  // The changes: a square in their cell.
  let pad = if cell >= 6.0 { cell * 0.16 } else { 0.0 }
  for f: Fl where f.col >= first && f.col < last && ready {
    let a = axis(f.from, StateRow[max(f.from, 0)].slot, total)
    let b = axis(f.to, StateRow[max(f.to, 0)].slot, total)
    if a >= 0 && b >= 0 {
      let pa = WaveAt[f.col * n + a].pos as f32 * cell
      let pb = WaveAt[(f.col + 1) * n + b].pos as f32 * cell
      let x0 = WaveCol[f.col].x * cell
      let y0 = WaveCol[f.col].y * cell
      let u = if f.col % 2 == 0 { x0 + pb } else { x0 + pa }
      let v = if f.col % 2 == 0 { y0 + pa } else { y0 + pb }
      wave_box(ox, oy, u + pad, v + pad, u + cell - pad, v + cell - pad, kind_colour(f.kind))
    }
  }
  // The axes, between the matrices: each place a bar, as long as how
  // many changes come into it (towards the matrix before) and go out of it
  // (towards the one after).
  var ax = first
  while ax <= last && ready {
    let x0 = WaveCol[ax].x * cell
    let y0 = WaveCol[ax].y * cell
    let count = WaveCol[ax].count
    let long = count as f32 * cell
    let even = ax % 2 == 0
    let mid = if even { x0 - g * 0.5 } else { y0 - g * 0.5 }
    if even {
      wave_box(ox, oy, x0 - g, y0, x0, y0 + long, 0x0d1115)
      wave_line(ox, oy, mid, y0, mid, y0 + long, 0x3a4652)
    } else {
      wave_box(ox, oy, x0, y0 - g, x0 + long, y0, 0x0d1115)
      wave_line(ox, oy, x0, mid, x0 + long, mid, 0x3a4652)
    }
    let half = g * 0.5 - 1.0
    let inset = if cell >= 6.0 { 1.0 } else { 0.0 }
    var p = 0
    while p < count {
      let j = WaveNode[ax * n + p].j
      let at = ax * n + j
      let inn = AxVol[at].inn
      let out = AxVol[at].out
      let lin = if inn > 0 { max(2.0, half * inn as f32 / View.most as f32) } else { 0.0 }
      let lout = if out > 0 { max(2.0, half * out as f32 / View.most as f32) } else { 0.0 }
      let p0 = (if even { y0 } else { x0 }) + p as f32 * cell + inset
      let p1 = p0 + cell - 2.0 * inset
      let colour = if j == total { 0x4f9de0 } else if j == total + 1 { 0xe0564f } else { 0xaab8c6 }
      let lit = Hover.axis == ax && Hover.node == j
      let shown = if lit { 0xffffff } else { colour }
      if lin + lout > 0.0 {
        if even { wave_box(ox, oy, mid - lin, p0, mid + lout, p1, shown) }
        else { wave_box(ox, oy, p0, mid - lin, p1, mid + lout, shown) }
      } else if lit {
        if even { wave_box(ox, oy, mid - half, p0, mid + half, p1, 0x30ffffff) }
        else { wave_box(ox, oy, p0, mid - half, p1, mid + half, 0x30ffffff) }
      }
      if cell >= 7.0 {
        if even { wave_line(ox, oy, mid - 3.0, p0 - inset, mid + 3.0, p0 - inset, 0x3a4652) }
        else { wave_line(ox, oy, p0 - inset, mid - 3.0, p0 - inset, mid + 3.0, 0x3a4652) }
      }
      p += 1
    }
    ax += 1
  }
  // The names, as the paper writes them: on the side of each matrix
  // across from the axis they go in by, away from it; up and to the right
  // of the ones above, down and to the right of the ones below.
  if cell >= 8.0 && ready {
    let size = min(12.0, cell - 2.0)
    for s: St where s.slot >= 0 {
      var k = first
      while k < last {
        let p = WaveAt[k * n + s.slot].pos
        if p >= 0 {
          let w = (if k % 2 == 0 { WaveCol[k + 1].count } else { WaveCol[k].count }) as f32 * cell
          let h = (if k % 2 == 0 { WaveCol[k].count } else { WaveCol[k + 1].count }) as f32 * cell
          let lit = (Hover.k == k && Hover.from == s.slot) || (Hover.axis == k && Hover.node == s.slot)
          wave_name(s.name, k % 2 == 1, p, WaveCol[k].x * cell, WaveCol[k].y * cell, w, h, cell, size, ox, oy,
                    if lit { 0xffffff } else { 0x9fb0c0 })
        }
        k += 1
      }
    }
    var k = first
    while k < last {
      let w = (if k % 2 == 0 { WaveCol[k + 1].count } else { WaveCol[k].count }) as f32 * cell
      let h = (if k % 2 == 0 { WaveCol[k].count } else { WaveCol[k + 1].count }) as f32 * cell
      let pb = WaveAt[k * n + total].pos
      if pb >= 0 {
        wave_name("born", k % 2 == 1, pb, WaveCol[k].x * cell, WaveCol[k].y * cell, w, h, cell, size, ox, oy,
                  0x4f9de0)
      }
      k += 1
    }
  }
  unclip()

  // The list of archetypes.
  rect(0.0, top(), panel(), Window.height as f32 - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, Window.height as f32 - top(), 0x26303a)
  window::write("Archetypes", 16.0, top() + 8.0, panel() - 24.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
  let first = top() + 30.0
  if View.arch == -1 { rect(0.0, first, panel() - 1.0, row_height(), 0x24405e) }
  window::write("All ({Map.states} states)", 16.0, first + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  for a: Arch where a.row > 0 {
    let y = first + a.row as f32 * row_height()
    if a.index == View.arch { rect(0.0, y, panel() - 1.0, row_height(), 0x24405e) }
    window::write(a.label + "  ({a.states})", 16.0, y + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  }
  // Every state on every axis, or only those used there (A).
  let foot = Window.height as f32 - 32.0
  rect(0.0, foot - 4.0, panel() - 1.0, 1.0, 0x26303a)
  rounded(16.0, foot + 4.0, 14.0, 14.0, 3.0, 3.0, 3.0, 3.0, if View.every { 0x4f9de0 } else { 0x26303a })
  window::write("Every state on each axis (A)", 38.0, foot + 2.0, panel() - 46.0, 0, 13.0, 0.0, 0.0, 2, 0,
        0x9fb0c0)

}


// A tab of the views.
proc tab(name: text, x: f32, on: bool) {
  rounded(x, 10.0, 122.0, 28.0, 6.0, 6.0, 6.0, 6.0, if on { 0x24405e } else { 0x1a2129 })
  window::write(name, x, 15.0, 122.0, 0, 14.0, 0.0, 0.0, 2, 1, if on { 0xe2ecf5 } else { 0x9fb0c0 })
}
system tabs() {
  if Mouse.clicks > 0 && Mouse.y >= 10.0 && Mouse.y < 38.0 {
    Src.open = false
    let x = Mouse.x - (Window.width as f32 - 980.0)
    if x >= 0.0 && x < 122.0 { View.mode = 0 }
    if x >= 130.0 && x < 252.0 { View.mode = 1 }
    if x >= 260.0 && x < 382.0 { View.mode = 5 }
    if x >= 390.0 && x < 512.0 { View.mode = 6 }
    if x >= 520.0 && x < 642.0 { View.mode = 2 }
    if x >= 650.0 && x < 772.0 { View.mode = 3 }
    if x >= 780.0 && x < 902.0 { View.mode = 4 }
  }
}

// The schedules in the list, in the rows' order (their row is from 1);
// All above them; how many runs each has.
system list_schedules() {
  for c: mut Sch { c.runs = SchRuns[c.row - 1].runs }
  Grid.scheds = len(SchRuns) + 1
}

// What is shown worked out again: rows of the schedule, the columns they
// touch.
system arrange_grid() {
  if Grid.dirty {
    Grid.dirty = false
    Grid.rows = 0
    let chosen = Grid.sched
    let name = Grid.name as text[1024]
    for r: mut Rw in turn by r.index {
      if (chosen == -1 && r.main) || (chosen != -1 && r.schedule == name) {
        r.shown = Grid.rows
        Grid.rows += 1
      } else {
        r.shown = -1
      }
      RowAt[r.index].shown = r.shown
    }
    ColAt = [{ used: 0, shown: -1 }; Map.columns]
    for c: Ce in turn by c.row {
      if RowAt[c.row].shown >= 0 { ColAt[c.col].used = 1 }
    }
    Grid.cols = 0
    for n: mut Cn in turn by n.index {
      if ColAt[n.index].used == 1 {
        n.shown = Grid.cols
        Grid.cols += 1
      } else {
        n.shown = -1
      }
      ColAt[n.index].shown = n.shown
    }
    // (All rows in the window where that leaves them big enough for their
    // names; else as big as that, and the rest a drag or the wheel away.)
    let tall = (Window.height as f32 - top() - header_room() - 40.0) / max(Grid.rows, 1) as f32
    Grid.cell = max(12.0, min(22.0, tall as i32 as f32))
    Grid.ox = panel() + label_room()
    Grid.oy = top() + header_room()
  }
}

// Clicks in the list, the wheel, dragging.
system steer_grid() {
  let mx = Mouse.x
  let my = Mouse.y
  if Mouse.clicks > 0 && mx < panel() && my > top() {
    let row = ((my - top() - 30.0) / row_height()) as i32
    if row == 0 {
      Grid.sched = -1
      Grid.dirty = true
    }
    for c: Sch in turn by c.row where c.row == row && row > 0 {
      Grid.sched = c.row
      Grid.name = c.name
      Grid.dirty = true
    }
  }
  Grid.clicked = false
  let free = !Src.open || mx < source_x(Window.width as f32)
  if mx > panel() && my > top() && free {
    if Mouse.wheel_y != 0.0 {
      let was = Grid.cell
      let cell = min(40.0, max(3.0, if Mouse.wheel_y > 0.0 { was * 1.15 } else { was / 1.15 }))
      Grid.ox = mx - (mx - Grid.ox) * cell / was
      Grid.oy = my - (my - Grid.oy) * cell / was
      Grid.cell = cell
    }
    if Mouse.clicks > 0 {
      Grid.dragging = true
      Grid.moved = 0.0
    }
  }
  if !Mouse.left {
    if Grid.dragging && Grid.moved < 4.0 { Grid.clicked = true }
    Grid.dragging = false
  }
  if Grid.dragging {
    Grid.ox += Mouse.dx
    Grid.oy += Mouse.dy
    Grid.moved += magnitude(Mouse.dx) + magnitude(Mouse.dy)
  }
}

// What the pointer is on: a row (its run, stage and why it waits), and
// where on a column, the cell (what of it is read and written).
system hover_grid() {
  Grid.words = ""
  Grid.r = -1
  Grid.c = -1
  let px = if Shot.px >= 0.0 { Shot.px } else { Mouse.x }
  let py = if Shot.px >= 0.0 { Shot.py } else { Mouse.y }
  if px > panel() && py > top() && !Grid.dragging {
    let cell = Grid.cell
    let r = ((py - Grid.oy) / cell) as i32
    let c = if px >= Grid.ox { ((px - Grid.ox) / cell) as i32 } else { -1 }
    if py >= Grid.oy && r < Grid.rows {
      Grid.r = r
      Grid.c = if c < Grid.cols { c } else { -1 }
      Grid.tx = px + 16.0
      Grid.ty = py + 14.0
      for w: Rw in turn by w.index where w.shown == r {
        if Grid.clicked && len(w.place) > 0 { Src.want = w.place }
        Grid.words = w.system + "  (" + w.schedule + ", run {w.position + 1}, stage {w.stage + 1})" +
                     (if len(w.place) > 0 { "  " + w.place + " (a click: its source)" } else { "" }) + "\n"
        if len(w.waits) > 0 { Grid.words = Grid.words + "waits for " + w.waits + ": " + w.why + "\n" }
        if len(w.opaque) > 0 { Grid.words = Grid.words + "effects outside the world at " + w.opaque + "\n" }
        if w.gpu { Grid.words = Grid.words + "on the GPU\n" }
      }
      let column = Grid.c
      if column >= 0 {
        Grid.at = -1
        for n: Cn in turn by n.index where n.shown == column {
          Grid.words = Grid.words + n.kind + " " + n.name + "\n"
          Grid.at = n.index
        }
        let at = Grid.at
        for e: Ce in turn by e.row where e.col == at && RowAt[e.row].shown == r {
          if len(e.reads) > 0 { Grid.words = Grid.words + "reads " + e.reads + "\n" }
          if len(e.writes) > 0 { Grid.words = Grid.words + "writes " + e.writes + "\n" }
        }
      }
      Grid.words = slice(Grid.words, 0, len(Grid.words) - 1)
    }
  }
}

system draw_grid() {
  let cell = Grid.cell
  let ox = Grid.ox
  let oy = Grid.oy
  let w = Grid.cols as f32 * cell
  let h = Grid.rows as f32 * cell
  clip(panel(), top(), Window.width as f32 - panel(), Window.height as f32 - top())
  rect(ox, oy, w, h, 0x171d24)
  // (Lines between the schedules' rows; every row and column a line.)
  if cell >= 6.0 {
    var i = 1
    while i < Grid.cols {
      rect(ox + i as f32 * cell, oy, 1.0, h, 0x20272f)
      i += 1
    }
    i = 1
    while i < Grid.rows {
      rect(ox, oy + i as f32 * cell, w, 1.0, 0x20272f)
      i += 1
    }
  }
  // Where the pointer is: its row and column.
  if Grid.r >= 0 { rect(ox - label_room() + 8.0, oy + Grid.r as f32 * cell, w + label_room() - 8.0, cell, 0x26ffffff) }
  if Grid.c >= 0 { rect(ox + Grid.c as f32 * cell, oy - header_room() + 10.0, cell, h + header_room() - 10.0, 0x26ffffff) }
  // The cells.
  let pad = if cell >= 6.0 { 1.0 } else { 0.0 }
  for e: Ce {
    let r = RowAt[e.row].shown
    let c = ColAt[e.col].shown
    if r >= 0 && c >= 0 {
      let x = ox + c as f32 * cell + pad
      let y = oy + r as f32 * cell + pad
      let s = cell - 2.0 * pad
      if e.how == 0 { rect(x, y, s, s, read_colour()) }
      if e.how == 1 { rect(x, y, s, s, write_colour()) }
      if e.how == 2 {
        rect(x, y, s * 0.5, s, read_colour())
        rect(x + s * 0.5, y, s * 0.5, s, write_colour())
      }
    }
  }
  // The rows: the system, its stage, a dot where it calls out; a line
  // and the schedule's name where one begins.
  let size = min(14.0, cell - 1.0)
  for r: Rw where r.shown >= 0 {
    let y = oy + r.shown as f32 * cell
    if r.first {
      rect(ox - label_room() + 8.0, y, w + label_room() - 8.0, 1.0, 0x55657a)
      window::write(r.schedule, ox + w + 10.0, y + 1.0, 300.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
    }
    if cell >= 9.0 {
      let name = short(r.system)
      let tw = text_extent(name, 0, size, 0.0, 2)
      window::write(name, ox - tw - 44.0, y + (cell - size) * 0.5, tw + 4.0, 0, size, 0.0, 0.0, 2, 0,
                    0xc8d4e0)
      window::write("{r.stage + 1}", ox - 34.0, y + (cell - size) * 0.5, 22.0, 0, size, 0.0, 0.0, 2, 2,
                    0x7d8a98)
    }
    if len(r.opaque) > 0 { circle(ox - 6.0, y + cell * 0.5, max(2.0, cell * 0.22), opaque_colour()) }
  }
  // The columns: their names going up to the right, and their kind as a
  // band over them.
  for n: Cn where n.shown >= 0 {
    let x = ox + n.shown as f32 * cell
    rect(x + 1.0, oy - 6.0, cell - 2.0, 4.0, kind_band(n.kind))
    if cell >= 9.0 {
      label_turned(short(n.name), x + cell * 0.5 - size * 0.35, oy - 10.0, size, -45.0, 0xa8b6c4)
    }
  }
  unclip()
  // The list of schedules.
  rect(0.0, top(), panel(), Window.height as f32 - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, Window.height as f32 - top(), 0x26303a)
  window::write("Schedules", 16.0, top() + 8.0, panel() - 24.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
  let first = top() + 30.0
  if Grid.sched == -1 { rect(0.0, first, panel() - 1.0, row_height(), 0x24405e) }
  window::write("All main runs ({Map.main_rows})", 16.0, first + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  for c: Sch where c.row > 0 {
    let y = first + c.row as f32 * row_height()
    if c.row == Grid.sched { rect(0.0, y, panel() - 1.0, row_height(), 0x24405e) }
    window::write(short(c.name) + "  ({c.runs})", 16.0, y + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  }
}


fn to_card_h() -> f32 { card_head() + chip_h() + 12.0 }
// Where the cards begin: of "comes from", of "goes into"; how far down.
fn from_x() -> f32 { panel() + 24.0 }
fn to_x() -> f32 { panel() + 48.0 + card_width() }
fn cards_y() -> f32 { top() + 100.0 }
fn list_y() -> f32 { top() + 56.0 }
fn over_back(mx: f32, my: f32) -> bool {
  mx > from_x() && mx < from_x() + 72.0 && my > top() + 14.0 && my < top() + 40.0
}

// ---- Provenance: what is shown --------------------------------------

// How many writes give each value one, and use it.
system count_values() {
  for v: mut Val {
    v.writes = ValAt[v.index].writes
    v.uses = ValAt[v.index].uses
  }
  Prov.counted = true
}

// The list: the values whose words have what is typed.
system list_values() {
  if Prov.list_dirty {
    Prov.list_dirty = false
    Prov.listed = 0
    let filter = lower(Prov.filter) as text[1024]
    for v: mut Val in turn by v.index {
      if (len(filter) == 0 || find(lower(v.label), filter, 0) >= 0) && v.kind != "constant" {
        v.row = Prov.listed
        Prov.listed += 1
      } else {
        v.row = -1
      }
    }
    Prov.list_top = 0.0
  }
}

// The cards laid out again: those of the writes that give the value shown
// one, with their chips; those of the writes it goes into.
system lay_out_cards() {
  if Prov.dirty {
    Prov.dirty = false
    Prov.top = 0.0
    let sel = Prov.sel
    let width = card_width()
    WrAt = [{ value: 0, cx: 0.0, lines: 0, when: 0, from_it: 0, on_it: 0, y: -1.0, h: 0.0, gy: -1.0 }; len(WrAt)]
    for w: Wr in turn by w.index { WrAt[w.index].value = w.value }
    // The chips: the values it is made from first, then those it depends on.
    for f: mut Fr in turn by f.order {
      f.shown = false
      if f.value == sel && f.role == 0 { WrAt[f.write].from_it = 1 }
      if f.value == sel && f.role == 1 { WrAt[f.write].on_it = 1 }
    }
    var role = 0
    while role < 2 {
      let r = role
      for f: mut Fr in turn by f.order where WrAt[f.write].value == sel && f.role == r {
        let w = text_extent(f.label, 0, 13.0, 0.0, 2) + 22.0
        let at = f.write
        // (Those it depends on on lines of their own, after "depending on".)
        if r == 1 && WrAt[at].when == 0 {
          WrAt[at].when = 1
          WrAt[at].lines += 1
          WrAt[at].cx = 104.0
        } else if WrAt[at].lines == 0 {
          WrAt[at].lines = 1
        } else if WrAt[at].cx + w > width - 28.0 {
          WrAt[at].lines += 1
          WrAt[at].cx = if r == 1 { 104.0 } else { 0.0 }
        }
        f.x = WrAt[at].cx
        f.y = (WrAt[at].lines - 1) as f32 * (chip_h() + 4.0)
        f.w = w
        f.shown = true
        WrAt[at].cx += w + 6.0
      }
      role += 1
    }
    Prov.from_h = 0.0
    Prov.to_h = 0.0
    for w: Wr in turn by w.index {
      if w.value == sel {
        WrAt[w.index].y = Prov.from_h
        WrAt[w.index].h = card_head() + max(WrAt[w.index].lines, 1) as f32 * (chip_h() + 4.0) + 10.0
        Prov.from_h += WrAt[w.index].h + 10.0
      }
      if WrAt[w.index].from_it + WrAt[w.index].on_it > 0 {
        WrAt[w.index].gy = Prov.to_h
        Prov.to_h += to_card_h() + 10.0
      }
    }
  }
}


// Typing narrows the list (Backspace takes a letter back, or with nothing
// typed goes back); clicks in the list, on a chip, on "back"; the wheel.
system steer_provenance() {
  Prov.go = -1
  var back = false
  // (The value asked for by name, for a picture: ENT_MAP_VALUE.)
  if len(Prov.value) > 0 && Prov.counted {
    let wanted = Prov.value as text[1024]
    for v: Val where v.label == wanted { Prov.go max= v.index }
    Prov.value = ""
  }
  var typed = 0
  while typed < Window.typed && typed < 256 {
    Prov.filter = Prov.filter + character(Typed[typed].code)
    Prov.list_dirty = true
    typed += 1
  }
  if key_pressed(259) {
    if len(Prov.filter) > 0 {
      Prov.filter = slice(Prov.filter, 0, len(Prov.filter) - 1)
      Prov.list_dirty = true
    } else {
      back = true
    }
  }
  let mx = Mouse.x
  let my = Mouse.y
  let free = !Src.open || mx < source_x(Window.width as f32)
  if Mouse.wheel_y != 0.0 && free {
    if mx < panel() {
      let most = max(0.0, Prov.listed as f32 * row_height() - (Window.height as f32 - list_y()))
      Prov.list_top = min(most, max(0.0, Prov.list_top - Mouse.wheel_y * 40.0))
    } else {
      let most = max(0.0, max(Prov.from_h, Prov.to_h) - (Window.height as f32 - cards_y() - 20.0))
      Prov.top = min(most, max(0.0, Prov.top - Mouse.wheel_y * 40.0))
    }
  }
  if Mouse.clicks > 0 && my > top() && free {
    if mx < panel() && my > list_y() {
      let row = ((my - list_y() + Prov.list_top) / row_height()) as i32
      for v: Val where v.row == row { Prov.go max= v.index }
    }
    if over_back(mx, my) { back = true }
    if my > cards_y() - 30.0 {
      let y0 = cards_y() - Prov.top
      // A chip of what a value comes from.
      for f: Fr where f.shown && f.kind != "constant" {
        let cx = from_x() + 14.0 + f.x
        let cy = y0 + WrAt[f.write].y + card_head() + f.y
        if mx >= cx && mx < cx + f.w && my >= cy && my < cy + chip_h() { Prov.go max= f.value }
      }
      // The head of a card: the write's source.
      for w: Wr in turn by w.index where WrAt[w.index].y >= 0.0 || WrAt[w.index].gy >= 0.0 {
        let fy = y0 + WrAt[w.index].y
        let gy = y0 + WrAt[w.index].gy
        if WrAt[w.index].y >= 0.0 && mx >= from_x() && mx < from_x() + card_width() && my >= fy &&
           my < fy + card_head() {
          Src.want = w.place
        }
        if WrAt[w.index].gy >= 0.0 && mx >= to_x() && mx < to_x() + card_width() && my >= gy &&
           my < gy + card_head() {
          Src.want = w.place
        }
      }
      // The value a write it goes into gives.
      if mx >= to_x() && mx < to_x() + card_width() {
        for w: Wr where WrAt[w.index].gy >= 0.0 {
          let cy = y0 + WrAt[w.index].gy + card_head()
          if my >= cy && my < cy + chip_h() { Prov.go max= w.value }
        }
      }
    }
  }
  let target = Prov.go
  if target >= 0 && target != Prov.sel {
    if Prov.sel >= 0 { Back += { value: Prov.sel } }
    Prov.sel = target
    Prov.dirty = true
  } else if back && len(Back) > 0 {
    Prov.sel = Back[len(Back) - 1].value
    Back = Back[..len(Back) - 1]
    Prov.dirty = true
  }
}

// A chip: a value's words, its kind's colour at the left.
proc chip(words: text, kind: text, x: f32, y: f32, w: f32, over: bool) {
  rounded(x, y, w, chip_h(), 5.0, 5.0, 5.0, 5.0, if over { 0x34495e } else { 0x232d38 })
  rect(x, y + 3.0, 4.0, chip_h() - 6.0, value_colour(kind))
  window::write(words, x + 12.0, y + 5.0, w - 14.0, 0, 13.0, 0.0, 0.0, 2, 0, 0xd8e2ec)
}

system draw_provenance() {
  let mx = Mouse.x
  let my = Mouse.y
  let sel = Prov.sel
  let x0 = from_x()
  let tx = to_x()
  let y0 = cards_y() - Prov.top
  let width = card_width()
  let bottom = Window.height as f32
  clip(panel(), cards_y() - 30.0, Window.width as f32 - panel(), bottom - cards_y() + 30.0)
  if sel >= 0 {
    window::write("COMES FROM", x0, y0 - 26.0, 400.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x7d8a98)
    window::write("GOES INTO", tx, y0 - 26.0, 400.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x7d8a98)
  }
  // "Comes from": a card for each write that gives it a value.
  for w: Wr where WrAt[w.index].y >= 0.0 {
    let y = y0 + WrAt[w.index].y
    let h = WrAt[w.index].h
    if y < bottom && y + h > top() {
      rounded(x0, y, width, h, 8.0, 8.0, 8.0, 8.0, 0x171d24)
      window::write(short(w.system) + "  ·  " + w.how, x0 + 14.0, y + 8.0, width - 200.0, 0, 14.0, 0.0, 0.0, 2, 0,
                    0xe2ecf5)
      window::write(w.place, x0 + width - 214.0, y + 9.0, 200.0, 0, 12.0, 0.0, 0.0, 2, 2, 0x6fa8dc)
      if WrAt[w.index].lines == 0 {
        window::write("from nothing it reads", x0 + 14.0, y + card_head() + 5.0, width - 28.0, 0, 13.0, 0.0,
                      0.0, 2, 0, 0x6a7886)
      }
    }
  }
  for f: Fr where f.shown {
    let cx = x0 + 14.0 + f.x
    let cy = y0 + WrAt[f.write].y + card_head() + f.y
    if cy < bottom && cy + chip_h() > top() {
      let over = mx >= cx && mx < cx + f.w && my >= cy && my < cy + chip_h() && f.kind != "constant"
      chip(f.label, f.kind, cx, cy, f.w, over)
      if f.role == 1 && f.x == 104.0 {
        window::write("depending on", x0 + 14.0, cy + 6.0, 90.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x7d8a98)
      }
    }
  }
  // "Goes into": a card for each write made from it or depending on it.
  for w: Wr where WrAt[w.index].gy >= 0.0 {
    let y = y0 + WrAt[w.index].gy
    if y < bottom && y + to_card_h() > top() {
      rounded(tx, y, width, to_card_h(), 8.0, 8.0, 8.0, 8.0, 0x171d24)
      var head = short(w.system) + "  ·  " + w.how
      if WrAt[w.index].on_it == 1 {
        if WrAt[w.index].from_it == 1 { head = head + "  (from it, depending on it)" }
        else { head = head + "  (depending on it)" }
      }
      window::write(head, tx + 14.0, y + 8.0, width - 200.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xe2ecf5)
      window::write(w.place, tx + width - 214.0, y + 9.0, 200.0, 0, 12.0, 0.0, 0.0, 2, 2, 0x6fa8dc)
      let cw = text_extent(w.label, 0, 13.0, 0.0, 2) + 22.0
      let cy = y + card_head()
      let over = mx >= tx && mx < tx + width && my >= cy && my < cy + chip_h()
      window::write("gives", tx + 14.0, cy + 6.0, 50.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x7d8a98)
      chip(w.label, w.kind, tx + 60.0, cy, cw, over)
    }
  }
  unclip()
  // The value shown, at the top.
  rect(panel(), top(), Window.width as f32 - panel(), 70.0, 0x101418)
  if sel >= 0 {
    var bx = x0
    if len(Back) > 0 {
      rounded(bx, top() + 14.0, 72.0, 26.0, 6.0, 6.0, 6.0, 6.0, if over_back(mx, my) { 0x34495e } else { 0x1a2129 })
      window::write("< back", bx, top() + 19.0, 72.0, 0, 13.0, 0.0, 0.0, 2, 1, 0xc8d4e0)
      bx += 88.0
    }
    let left = bx
    for v: Val where v.index == sel {
      rect(left, top() + 17.0, 5.0, 20.0, value_colour(v.kind))
      window::write(value_title(v.kind, v.name, v.field), left + 16.0, top() + 14.0, 1000.0, 0, 18.0, 0.0, 0.0, 2, 0,
                    0xe2ecf5)
      window::write("{v.writes} writes give it a value · it goes into {v.uses}", left + 16.0, top() + 42.0, 900.0, 0,
                    13.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    }
  } else {
    window::write("Pick a value at the left (or type to find one): where it comes from, and where it goes.",
                  x0, top() + 20.0, 1000.0, 0, 16.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  // The list of values.
  rect(0.0, top(), panel(), bottom - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, bottom - top(), 0x26303a)
  rounded(12.0, top() + 12.0, panel() - 24.0, 30.0, 6.0, 6.0, 6.0, 6.0, 0x0c1014)
  window::write(if len(Prov.filter) > 0 { Prov.filter + "|" } else { "Type to find a value" }, 22.0, top() + 18.0,
                panel() - 40.0, 0, 14.0, 0.0, 0.0, 2, 0, if len(Prov.filter) > 0 { 0xe2ecf5 } else { 0x6a7886 })
  clip(0.0, list_y(), panel() - 1.0, bottom - list_y())
  for v: Val where v.row >= 0 {
    let y = list_y() + v.row as f32 * row_height() - Prov.list_top
    if y > list_y() - row_height() && y < bottom {
      if v.index == sel { rect(0.0, y, panel() - 1.0, row_height(), 0x24405e) }
      rect(10.0, y + 6.0, 4.0, 10.0, value_colour(v.kind))
      window::write(v.label, 22.0, y + 3.0, panel() - 90.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
      window::write("{v.writes} · {v.uses}", panel() - 74.0, y + 4.0, 60.0, 0, 12.0, 0.0, 0.0, 2, 2, 0x6a7886)
    }
  }
  unclip()
}

// The top: the program, what its world has, the views, what the colours
// say; and the words of what the pointer is on.
system draw_top() {
  rect(0.0, 0.0, Window.width as f32, top(), 0x0c1014)
  rect(0.0, top() - 1.0, Window.width as f32, 1.0, 0x26303a)
  window::write("World map of " + Map.program, 16.0, 12.0, Window.width as f32 - 32.0, 0, 18.0, 0.0, 0.0, 2, 0, 0xe2ecf5)
  window::write("{Map.archetypes} archetypes · {Map.components} components, {Map.tags} tags · {Map.resources} uniques · " +
        "{Map.systems} systems ({Map.queries} queries; {Map.opaque} with effects outside the world, {Map.gpu} on the GPU) · " +
        "{Map.schedules} schedules", 16.0, 40.0, Window.width as f32 - 32.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  // The views, as tabs.
  tab("Lifecycle", Window.width as f32 - 980.0, View.mode == 0)
  tab("Systems × data", Window.width as f32 - 850.0, View.mode == 1)
  tab("Schedule", Window.width as f32 - 720.0, View.mode == 5)
  tab("Cores", Window.width as f32 - 590.0, View.mode == 6)
  if View.mode == 6 && Co.frames > 0 {
    let busy = Co.work / max(Co.us * Co.threads as f32, 1.0)
    window::write("Cores: a frame of " + Co.schedule + ", " + us_words(Co.us) + " on {Co.threads} threads · " +
          "in loops on many threads " + us_words(Co.parallel) + " ({(Co.parallel * 100.0 / max(Co.us, 1.0)) as i32}%) · " +
          "the threads busy {(busy * 100.0) as i32}% of it · a fused loop in its group's colour · a click shows the source",
          16.0, 62.0, Window.width as f32 - 32.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  tab("Provenance", Window.width as f32 - 460.0, View.mode == 2)
  tab("Time", Window.width as f32 - 330.0, View.mode == 3)
  tab("Memory", Window.width as f32 - 200.0, View.mode == 4)
  if View.mode == 5 {
    window::write("Schedule: each schedule's runs as `ent build` fuses them · a group is one loop over each archetype, " +
          "every run's body in turn for an entity · {Fz.groups} groups of several runs, {Fz.alone} runs alone · a click shows the source",
          16.0, 62.0, Window.width as f32 - 32.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  if View.mode == 4 {
    window::write("Memory: the world's bytes, laid out when it is made, as boxes as big as what they hold · " +
          "a click goes in, the secondary button or Backspace out", 16.0, 62.0, Window.width as f32 - 32.0, 0,
          14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  if View.mode == 3 {
    if Tm.traced {
      window::write("Time: how it ran (" + Tm.file + "): the entities of each archetype after each run of " +
            Tm.schedules + ", how long each run took; each system, schedule and loop by its own time",
            16.0, 62.0, Window.width as f32 - 32.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    } else {
      window::write("Time: how the program ran, of a trace of it", 16.0, 62.0, Window.width as f32 - 32.0, 0,
            14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    }
  }
  if View.mode == 1 {
    window::write("Systems × data: {Map.main_rows} runs of systems, {Map.columns} components, uniques and the like they touch, " +
          "{Map.cells} cells · a row's stage: runs of one stage touch nothing another writes", 16.0, 62.0,
          Window.width as f32 - 480.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    var x = Window.width as f32 - 470.0
    rect(x, 64.0, 12.0, 12.0, read_colour())
    window::write("reads", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    x += 80.0
    rect(x, 64.0, 12.0, 12.0, write_colour())
    window::write("writes", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    x += 80.0
    rect(x, 64.0, 6.0, 12.0, read_colour())
    rect(x + 6.0, 64.0, 6.0, 12.0, write_colour())
    window::write("both", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    x += 70.0
    circle(x + 6.0, 70.0, 5.0, opaque_colour())
    window::write("effects outside the world", x + 16.0, 62.0, 220.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  if View.mode == 2 {
    window::write("Provenance: where each value comes from, within each system that writes it: " +
          "the values it is made from, and those that decide whether it is made · a card's place shows the source",
          16.0, 62.0,
          Window.width as f32 - 520.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  if View.mode == 0 {
  window::write("Lifecycle: {Map.states} states, {Map.flows} changes in {Map.steps} runs · states tell " +
        (if Map.lens == "*" { "every optional component" } else { Map.lens }) + " · a click on a change shows the source",
        16.0, 62.0,
        Window.width as f32 - 480.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  var x = Window.width as f32 - 540.0
  rect(x, 64.0, 12.0, 12.0, 0x4f9de0)
  window::write("spawn", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  x += 80.0
  rect(x, 64.0, 12.0, 12.0, 0x56c26a)
  window::write("add", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  x += 70.0
  rect(x, 64.0, 12.0, 12.0, 0xe0a03a)
  window::write("remove", x + 16.0, 62.0, 70.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  x += 90.0
  rect(x, 64.0, 12.0, 12.0, 0xe0564f)
  window::write("despawn", x + 16.0, 62.0, 80.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  x += 100.0
  rect(x, 64.0, 12.0, 12.0, 0xa77be0)
  window::write("several", x + 16.0, 62.0, 80.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  if len(Map.error) > 0 {
    window::write(Map.error, panel() + 24.0, top() + 24.0, 900.0, 0, 16.0, 0.0, 0.0, 2, 0, 0xe0564f)
  }

  // The words of the cell the pointer is on.
  if len(Hover.tip) > 0 && View.mode == 0 {
    let all = Hover.tip as text[4094]
    // (Without the line break at its end.)
    let words = slice(all, 0, len(all) - 1)
    let w = max(text_extent(words, 0, 14.0, 0.0, 1), 120.0) + 20.0
    let lines = text_lines(words, w, 0, 14.0, 0.0, 1)
    let h = lines as f32 * 18.0 + 14.0
    let x0 = min(Hover.x, Window.width as f32 - w - 8.0)
    let y0 = min(Hover.y, Window.height as f32 - h - 8.0)
    rounded(x0, y0, w, h, 6.0, 6.0, 6.0, 6.0, 0xf0222b35)
    window::write(words, x0 + 10.0, y0 + 7.0, w - 16.0, 0, 14.0, 0.0, 18.0, 1, 0, 0xe2ecf5)
  }
  if len(Grid.words) > 0 && View.mode == 1 {
    let words = Grid.words as text[4094]
    let w = max(text_extent(words, 0, 14.0, 0.0, 1), 120.0) + 20.0
    let lines = text_lines(words, w, 0, 14.0, 0.0, 1)
    let h = lines as f32 * 18.0 + 14.0
    let x0 = min(Grid.tx, Window.width as f32 - w - 8.0)
    let y0 = min(Grid.ty, Window.height as f32 - h - 8.0)
    rounded(x0, y0, w, h, 6.0, 6.0, 6.0, 6.0, 0xf0222b35)
    window::write(words, x0 + 10.0, y0 + 7.0, w - 16.0, 0, 14.0, 0.0, 18.0, 1, 0, 0xe2ecf5)
  }  if len(Tm.words) > 0 && View.mode == 3 {
    let words = Tm.words as text[4094]
    let w = max(text_extent(words, 0, 14.0, 0.0, 1), 120.0) + 20.0
    let lines = text_lines(words, w, 0, 14.0, 0.0, 1)
    let h = lines as f32 * 18.0 + 14.0
    let x0 = min(Tm.tx, Window.width as f32 - w - 8.0)
    let y0 = min(Tm.ty, Window.height as f32 - h - 8.0)
    rounded(x0, y0, w, h, 6.0, 6.0, 6.0, 6.0, 0xf0222b35)
    window::write(words, x0 + 10.0, y0 + 7.0, w - 16.0, 0, 14.0, 0.0, 18.0, 1, 0, 0xe2ecf5)
  }  if len(Co.words) > 0 && View.mode == 6 {
    let words = Co.words as text[4094]
    let w = min(max(text_extent(words, 0, 14.0, 0.0, 1), 120.0) + 20.0, 720.0)
    let lines = text_lines(words, w - 16.0, 0, 14.0, 0.0, 0)
    let h = lines as f32 * 18.0 + 14.0
    let x0 = min(Co.tx, Window.width as f32 - w - 8.0)
    let y0 = min(Co.ty, Window.height as f32 - h - 8.0)
    rounded(x0, y0, w, h, 6.0, 6.0, 6.0, 6.0, 0xf0222b35)
    window::write(words, x0 + 10.0, y0 + 7.0, w - 16.0, 0, 14.0, 0.0, 18.0, 0, 0, 0xe2ecf5)
  }  if len(Fz.words) > 0 && View.mode == 5 {
    let words = Fz.words as text[4094]
    let w = min(max(text_extent(words, 0, 14.0, 0.0, 1), 120.0) + 20.0, 640.0)
    let lines = text_lines(words, w - 16.0, 0, 14.0, 0.0, 0)
    let h = lines as f32 * 18.0 + 14.0
    let x0 = min(Fz.tx, Window.width as f32 - w - 8.0)
    let y0 = min(Fz.ty, Window.height as f32 - h - 8.0)
    rounded(x0, y0, w, h, 6.0, 6.0, 6.0, 6.0, 0xf0222b35)
    window::write(words, x0 + 10.0, y0 + 7.0, w - 16.0, 0, 14.0, 0.0, 18.0, 0, 0, 0xe2ecf5)
  }  if len(Mem.words) > 0 && View.mode == 4 {
    let words = Mem.words as text[4094]
    let w = max(text_extent(words, 0, 14.0, 0.0, 1), 120.0) + 20.0
    let lines = text_lines(words, w, 0, 14.0, 0.0, 1)
    let h = lines as f32 * 18.0 + 14.0
    let x0 = min(Mem.tx, Window.width as f32 - w - 8.0)
    let y0 = min(Mem.ty, Window.height as f32 - h - 8.0)
    rounded(x0, y0, w, h, 6.0, 6.0, 6.0, 6.0, 0xf0222b35)
    window::write(words, x0 + 10.0, y0 + 7.0, w - 16.0, 0, 14.0, 0.0, 18.0, 1, 0, 0xe2ecf5)
  }  if len(Tm.words) > 0 && View.mode == 3 {
    let words = Tm.words as text[4094]
    let w = max(text_extent(words, 0, 14.0, 0.0, 1), 120.0) + 20.0
    let lines = text_lines(words, w, 0, 14.0, 0.0, 1)
    let h = lines as f32 * 18.0 + 14.0
    let x0 = min(Tm.tx, Window.width as f32 - w - 8.0)
    let y0 = min(Tm.ty, Window.height as f32 - h - 8.0)
    rounded(x0, y0, w, h, 6.0, 6.0, 6.0, 6.0, 0xf0222b35)
    window::write(words, x0 + 10.0, y0 + 7.0, w - 16.0, 0, 14.0, 0.0, 18.0, 1, 0, 0xe2ecf5)
  }
}

// An even step for the time axis, of about `about` ms: 1, 2 or 5 of a
// power of ten.
fn even_step(about: f32) -> f32 {
  var step = 0.001
  while step * 10.0 <= about { step = step * 10.0 }
  if step * 5.0 <= about { step = step * 5.0 }
  else if step * 2.0 <= about { step = step * 2.0 }
  step
}
fn kind_mark(kind: text) -> i32 {
  if kind == "system" { 0x4f9de0 } else if kind == "schedule" { 0xa77be0 }
  else if kind == "loop" { 0x56c26a } else if kind == "sort" { 0xd0c050 } else { 0x7d8a98 }
}
fn time_list_y() -> f32 { top() + 96.0 }

// An archetype chosen in the list (its line stands out); the table
// scrolled.
system steer_time() {
  let mx = Mouse.x
  let my = Mouse.y
  if Mouse.clicks > 0 && mx < panel() && my >= time_list_y() {
    let row = ((my - time_list_y()) / row_height()) as i32
    var a = 0
    var chosen = -2
    while a < len(ArchPk) {
      if ArchPk[a].rank == row { chosen = a }
      a += 1
    }
    if chosen >= 0 { Tm.arch = if Tm.arch == chosen { -1 } else { chosen } }
  }
  if mx > panel() && my > table_y() && Mouse.wheel_y != 0.0 && (!Src.open || mx < source_x(Window.width as f32)) {
    let room = Window.height as f32 - table_y() - 30.0
    let most = max(0.0, Tm.took as f32 * took_h() - room)
    Tm.scroll = min(most, max(0.0, Tm.scroll - Mouse.wheel_y * 3.0 * took_h()))
  }
}

// What the pointer is on: a time in the charts (that run, the entities
// then) or a site in the table.
system hover_time() {
  Tm.words = ""
  Tm.at = -1.0
  Tm.row = -1
  let px = if Shot.px >= 0.0 { Shot.px } else { Mouse.x }
  let py = if Shot.px >= 0.0 { Shot.py } else { Mouse.y }
  let all_ms = Tm.seconds * 1000.0
  Tm.tx = px + 16.0
  Tm.ty = py + 14.0
  if Tm.traced && px >= chart_x() && px <= chart_x() + chart_w(Window.width as f32) && py >= counts_y() &&
     py <= runs_y() + runs_h() {
    let t = (px - chart_x()) / chart_w(Window.width as f32) * all_ms
    Tm.at = t
    var words = "at " + fixed(t as f64 / 1000.0, 3) + " s"
    var k = 0
    var ran = -1
    while k < len(TRun) {
      if TRun[k].at <= t { ran = k }
      k += 1
    }
    if ran >= 0 {
      words = words + "\nthat run took " + duration(TRun[ran].ms as f64 * 1000.0)
    }
    k = 0
    var counted = -1
    while k < len(TCnt) {
      if TCnt[k].at <= t { counted = k }
      k += 1
    }
    if counted >= 0 {
      let start = TCnt[counted].start
      var rank = 0
      while rank < Tm.lines {
        var a = 0
        while a < len(ArchPk) {
          if ArchPk[a].rank == rank {
            words = words + "\n" + line_at(Map.labels, a) + ": {TVal[start + a].n}"
          }
          a += 1
        }
        rank += 1
      }
    }
    Tm.words = words
  }
  if Tm.traced && px > panel() && py > table_y() + 24.0 {
    let row = ((py - table_y() - 24.0 + Tm.scroll) / took_h()) as i32
    if row < Tm.took {
      Tm.row = row
      for k: Tk in turn by k.order where k.order == row {
        if Mouse.clicks > 0 && (!Src.open || Mouse.x < source_x(Window.width as f32)) && find(k.place, ".ent:", 0) >= 0 {
          Src.want = k.place
        }
        Tm.words = k.label + "\n{k.times} times: " + duration(k.own as f64) + " its own, " +
                   duration(k.all as f64) + " in all, " + duration(k.all as f64 / k.times as f64) + " each" +
                   (if len(k.busy) > 0 { "\nits threads worked " + k.busy + "% of it" } else { "" })
      }
    }
  }
}

system draw_time() {
  if !Tm.traced {
    window::write("No trace of this program in the map.\n\nRun it built with --trace:  ent run program.ent --trace\n" +
          "(it writes program.trace.json where it runs; ENT_TRACE says where instead),\nthen:  ent map program.ent " +
          "--trace", panel() + 24.0, top() + 24.0, Window.width as f32 - panel() - 48.0, 0, 16.0, 0.0, 24.0, 1, 0,
          0xc8d4e0)
  } else {
    let all_ms = Tm.seconds * 1000.0
    let x0 = chart_x()
    let w = chart_w(Window.width as f32)
    // The entities: a line of each of the archetypes with the most.
    window::write("Entities after each run", x0, counts_y() - 24.0, w, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
    rect(x0, counts_y(), w, counts_h(), 0x171d24)
    let peak = max(Tm.peak, 1)
    rect(x0, counts_y(), w, 1.0, 0x20272f)
    rect(x0, counts_y() + counts_h() * 0.5, w, 1.0, 0x20272f)
    window::write("{peak}", x0 - 60.0, counts_y() - 7.0, 52.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x7d8a98)
    window::write("{peak / 2}", x0 - 60.0, counts_y() + counts_h() * 0.5 - 7.0, 52.0, 0, 13.0, 0.0, 0.0, 2, 2,
                  0x7d8a98)
    window::write("0", x0 - 60.0, counts_y() + counts_h() - 7.0, 52.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x7d8a98)
    let bottom = counts_y() + counts_h()
    var a = 0
    while a < len(ArchPk) {
      if ArchPk[a].rank >= 0 && len(TCnt) > 0 {
        var colour = ArchPk[a].colour
        if Tm.arch >= 0 && Tm.arch != a { colour = colour + 0x50000000 }
        let thick = Tm.arch == a
        var k = 0
        var lx = 0.0
        var ly = 0.0
        while k < len(TCnt) {
          let x = time_x(TCnt[k].at, all_ms, w)
          let y = bottom - TVal[TCnt[k].start + a].n as f32 / peak as f32 * (counts_h() - 4.0)
          if k == 0 {
            lx = x
            ly = y
          } else if y != ly {
            line(lx, ly, x, ly, colour)
            line(x, ly, x, y, colour)
            if thick {
              line(lx, ly - 1.0, x, ly - 1.0, colour)
              line(x + 1.0, ly, x + 1.0, y, colour)
            }
            lx = x
            ly = y
          }
          k += 1
        }
        line(lx, ly, x0 + w, ly, colour)
        if thick { line(lx, ly - 1.0, x0 + w, ly - 1.0, colour) }
      }
      a += 1
    }
    // How long each run took.
    window::write("How long each run of " + Tm.schedules + " took", x0, runs_y() - 24.0, w, 0, 13.0, 0.0, 0.0,
                  2, 0, 0x7d8a98)
    rect(x0, runs_y(), w, runs_h(), 0x171d24)
    let longest = max(Tm.run_peak, 0.001)
    window::write(duration(longest as f64 * 1000.0), x0 - 64.0, runs_y() - 7.0, 56.0, 0, 13.0, 0.0, 0.0, 2, 2,
                  0x7d8a98)
    window::write("0", x0 - 60.0, runs_y() + runs_h() - 7.0, 52.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x7d8a98)
    var k = 0
    while k < len(TRun) {
      let x = time_x(TRun[k].at, all_ms, w)
      let bw = max(1.0, time_x(TRun[k].at + TRun[k].ms, all_ms, w) - x)
      let h = max(1.0, TRun[k].ms / longest * runs_h())
      rect(x, runs_y() + runs_h() - h, bw, h, 0x8fa0b0)
      k += 1
    }
    // The time, along both.
    let step = even_step(all_ms / 8.0)
    var t = 0.0
    while t <= all_ms && step > 0.0 {
      let x = time_x(t, all_ms, w)
      rect(x, runs_y() + runs_h(), 1.0, 5.0, 0x55657a)
      var words = fixed(t as f64, if step >= 1.0 { 0 } else { 2 }) + " ms"
      if all_ms >= 2000.0 { words = fixed(t as f64 / 1000.0, if step >= 1000.0 { 0 } else { 1 }) + " s" }
      window::write(words, x - 40.0, runs_y() + runs_h() + 7.0, 80.0, 0, 12.0, 0.0, 0.0, 2, 1, 0x7d8a98)
      t += step
    }
    if Tm.at >= 0.0 {
      let x = time_x(Tm.at, all_ms, w)
      rect(x, counts_y(), 1.0, runs_y() + runs_h() - counts_y(), 0x80ffffff)
    }
    // Each site by its own time, the most first.
    let ty = table_y()
    window::write("own", x0 - 60.0, ty, 100.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x7d8a98)
    window::write("all", x0 + 50.0, ty, 90.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x7d8a98)
    window::write("times", x0 + 150.0, ty, 70.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x7d8a98)
    window::write("each", x0 + 230.0, ty, 90.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x7d8a98)
    window::write("busy", x0 + 330.0, ty, 50.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x7d8a98)
    window::write("site", x0 + 560.0, ty, 200.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
    rect(panel() + 16.0, ty + 20.0, Window.width as f32 - panel() - 32.0, 1.0, 0x26303a)
    let first = ty + 24.0
    clip(panel(), first, Window.width as f32 - panel(), Window.height as f32 - first)
    let most = max(Tm.most, 0.001)
    let scroll = Tm.scroll
    let over = Tm.row
    for k: Tk {
      let y = first + k.order as f32 * took_h() - scroll
      if y > first - took_h() && y < Window.height as f32 {
        if k.order == over { rect(panel() + 16.0, y, Window.width as f32 - panel() - 32.0, took_h(), 0x26ffffff) }
        let ty2 = y + 3.0
        window::write(duration(k.own as f64), x0 - 60.0, ty2, 100.0, 0, 13.0, 0.0, 0.0, 2, 2, 0xe2ecf5)
        window::write(duration(k.all as f64), x0 + 50.0, ty2, 90.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x9fb0c0)
        window::write("{k.times}", x0 + 150.0, ty2, 70.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x9fb0c0)
        window::write(duration(k.all as f64 / max(k.times, 1) as f64), x0 + 230.0, ty2, 90.0, 0, 13.0, 0.0, 0.0,
                      2, 2, 0x9fb0c0)
        if len(k.busy) > 0 {
          window::write(k.busy + "%", x0 + 330.0, ty2, 50.0, 0, 13.0, 0.0, 0.0, 2, 2, 0x9fb0c0)
        }
        rect(x0 + 396.0, y + 5.0, max(1.0, k.own / most * 150.0), took_h() - 10.0, kind_mark(k.kind))
        var where_words = ""
        if len(k.place) > 0 { where_words = "  " + k.place }
        // (A loop's: on one thread, which of those of one line.)
        let one = find(k.label, " (one thread)", 0)
        if one >= 0 { where_words = where_words + slice(k.label, one, len(k.label)) }
        else {
          let mark = find(k.label, " #", 0)
          if mark >= 0 { where_words = where_words + slice(k.label, mark, len(k.label)) }
        }
        window::write(k.kind + " " + short(k.who) + where_words, x0 + 560.0, ty2, Window.width as f32 - x0 - 600.0,
                      0, 13.0, 0.0, 0.0, 2, 0, 0xc8d4e0)
      }
    }
    unclip()
  }
  // The list: what was traced, the archetypes with a line.
  rect(0.0, top(), panel(), Window.height as f32 - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, Window.height as f32 - top(), 0x26303a)
  if Tm.traced {
    var threads = " s on {Tm.threads} threads"
    if Tm.threads == 1 { threads = " s on one thread" }
    window::write("Traced " + fixed(Tm.seconds as f64, 2) + threads, 16.0, top() + 8.0,
                  panel() - 24.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    window::write("{Tm.took} sites timed, {len(TRun)} runs", 16.0, top() + 28.0, panel() - 24.0, 0, 13.0, 0.0,
                  0.0, 2, 0, 0x7d8a98)
    window::write("Archetypes, the most entities first", 16.0, time_list_y() - 24.0, panel() - 24.0, 0, 13.0, 0.0,
                  0.0, 2, 0, 0x7d8a98)
    var a = 0
    while a < len(ArchPk) {
      let rank = ArchPk[a].rank
      if rank >= 0 {
        let y = time_list_y() + rank as f32 * row_height()
        if Tm.arch == a { rect(0.0, y, panel() - 1.0, row_height(), 0x24405e) }
        rect(16.0, y + 7.0, 10.0, 10.0, ArchPk[a].colour)
        window::write(line_at(Map.labels, a), 34.0, y + 3.0, panel() - 100.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
        window::write("{ArchPk[a].peak}", panel() - 70.0, y + 3.0, 54.0, 0, 14.0, 0.0, 0.0, 2, 2, 0x9fb0c0)
      }
      a += 1
    }
  }
}

// The boxes laid out again, where asked or the window's size changed:
// the root's the whole of the view, each node's children squarified into
// it (Bruls, Huizing and van Wijk, 2000): rows of them along its shorter
// side, each row grown while its boxes get no further from square.
system mem_layout() {
  if Window.width != Mem.lw || Window.height != Mem.lh { Mem.dirty = true }
  if Mem.dirty && len(MemAt) > 0 {
    Mem.dirty = false
    Mem.lw = Window.width
    Mem.lh = Window.height
    var k = 0
    while k < len(MemAt) {
      MemAt[k].w = -1.0
      k += 1
    }
    let root = Mem.root
    MemAt[root].x = panel() + 16.0
    MemAt[root].y = mem_y()
    MemAt[root].w = Window.width as f32 - panel() - 32.0
    MemAt[root].h = Window.height as f32 - mem_y() - 16.0
    k = root
    while k < len(MemAt) {
      let n = MemAt[k].count
      if MemAt[k].w > 0.0 && n > 0 && MemAt[k].bytes > 0.0 {
        // (Inside its edge, and under its name where there is room.)
        let head = if k != root && MemAt[k].w > 60.0 && MemAt[k].h > 40.0 { mem_head() } else { 0.0 }
        let pad = if k == root { 0.0 } else { 2.0 }
        var x = MemAt[k].x + pad
        var y = MemAt[k].y + pad + head
        var w = MemAt[k].w - 2.0 * pad
        var h = MemAt[k].h - 2.0 * pad - head
        let first = MemAt[k].first
        let end = first + n
        var i = first
        if w > 1.0 && h > 1.0 {
          let scale = (w * h) as f64 / MemAt[k].bytes
          while i < end && w > 0.5 && h > 0.5 && MemAt[i].bytes > 0.0 {
            let side = min(w, h) as f64
            var j = i
            var sum = 0.0 as f64
            var least = 0.0 as f64
            var most = 0.0 as f64
            var worst = 0.0 as f64
            var growing = true
            while j < end && growing {
              let a = MemAt[j].bytes * scale
              if a <= 0.0 {
                growing = false
              } else {
                let s = sum + a
                let lo = if j == i { a } else { min(least, a) }
                let hi = if j == i { a } else { max(most, a) }
                let ratio = max(side * side * hi / (s * s), s * s / (side * side * lo))
                if j == i || ratio <= worst {
                  sum = s
                  least = lo
                  most = hi
                  worst = ratio
                  j += 1
                } else {
                  growing = false
                }
              }
            }
            var r = i
            if w >= h {
              // (A column at its left.)
              let t = (sum / h as f64) as f32
              var yy = y
              while r < j {
                let hh = (MemAt[r].bytes * scale / t as f64) as f32
                MemAt[r].x = x
                MemAt[r].y = yy
                MemAt[r].w = t
                MemAt[r].h = hh
                yy += hh
                r += 1
              }
              x += t
              w -= t
            } else {
              // (A row along its top.)
              let t = (sum / w as f64) as f32
              var xx = x
              while r < j {
                let ww = (MemAt[r].bytes * scale / t as f64) as f32
                MemAt[r].x = xx
                MemAt[r].y = y
                MemAt[r].w = ww
                MemAt[r].h = t
                xx += ww
                r += 1
              }
              y += t
              h -= t
            }
            i = j
          }
        }
      }
      k += 1
    }
  }
}

// What the pointer is on: the deepest box under it. A click goes in, one
// level; the secondary button or Backspace out.
system steer_memory() {
  Mem.over = -1
  Mem.words = ""
  let px = if Shot.px >= 0.0 { Shot.px } else { Mouse.x }
  let py = if Shot.px >= 0.0 { Shot.py } else { Mouse.y }
  Mem.tx = px + 16.0
  Mem.ty = py + 14.0
  var over = -1
  var k = Mem.root
  while k < len(MemAt) {
    if MemAt[k].w >= 1.0 && MemAt[k].h >= 1.0 && px >= MemAt[k].x && px < MemAt[k].x + MemAt[k].w &&
       py >= MemAt[k].y && py < MemAt[k].y + MemAt[k].h {
      if over < 0 || MemAt[k].depth > MemAt[over].depth { over = k }
    }
    k += 1
  }
  if over >= 0 {
    Mem.over = over
    // Its path, from the world down; and what it is of its parent.
    var path = ""
    var at = over
    var owner = -1
    while at >= 0 {
      let name = slice(Mem.names, MemAt[at].start, MemAt[at].end) as text[1024]
      if len(path) > 0 { path = name + "  /  " + path } else { path = name }
      if MemAt[at].rows > 0 && owner < 0 { owner = at }
      at = MemAt[at].parent
    }
    let bytes = MemAt[over].bytes
    var words = path + "\n" + size_text(bytes) + " (" + fixed(bytes, 0) + " bytes), " +
                fixed(100.0 * bytes / max(Mem.total, 1.0), 2) + "% of the world"
    let parent = MemAt[over].parent
    if parent > 0 {
      words = words + ", " + fixed(100.0 * bytes / max(MemAt[parent].bytes, 1.0), 1) + "% of " +
              slice(Mem.names, MemAt[parent].start, MemAt[parent].end)
    }
    if owner >= 0 {
      let rows = MemAt[owner].rows
      words = words + "\n" + fixed(bytes / rows as f64, 1) + " bytes a row, of {rows} rows"
    }
    words = words + "\nfrom byte " + fixed(MemAt[over].from, 0)
    if MemAt[over].count > 0 { words = words + " · {MemAt[over].count} parts" }
    Mem.words = words
  }
  if px > panel() && py > mem_y() && Mouse.clicks > 0 && over >= 0 {
    // (The root's child that the box is in.)
    var at = over
    while at >= 0 && MemAt[at].parent != Mem.root { at = MemAt[at].parent }
    if at >= 0 && MemAt[at].count > 0 {
      Mem.root = at
      Mem.dirty = true
    }
  }
  if (Mouse.secondary || key_pressed(259)) && Mem.root > 0 {
    Mem.root = MemAt[Mem.root].parent
    Mem.dirty = true
  }
  // A click on the path: out to that node.
  if Mouse.clicks > 0 && py >= top() + 8.0 && py < mem_y() - 8.0 && px > panel() {
    var at = Mem.root
    var x = panel() + 16.0
    var chosen = -1
    // (The path is drawn from the world down: its parts measured the same way.)
    var depth = MemAt[at].depth
    while depth >= 0 {
      var node = Mem.root
      while MemAt[node].depth > depth { node = MemAt[node].parent }
      let name = slice(Mem.names, MemAt[node].start, MemAt[node].end) as text[1024]
      let w = text_extent(name, 0, 14.0, 0.0, 2)
      if px >= x && px < x + w { chosen = node }
      x += w + 26.0
      depth -= 1
    }
    if chosen >= 0 {
      Mem.root = chosen
      Mem.dirty = true
    }
  }
}

system draw_memory() {
  if len(MemAt) == 0 {
    window::write("No memory map: ent map writes one with the map (ent-opt --ent-indexes --ent-memory-map).",
                  panel() + 24.0, top() + 24.0, Window.width as f32 - panel() - 48.0, 0, 16.0, 0.0, 0.0, 2,
                  0, 0xc8d4e0)
  } else {
    // The path to what is shown whole, from the world.
    var x = panel() + 16.0
    var depth = 0
    let shown = MemAt[Mem.root].depth
    while depth <= shown {
      var node = Mem.root
      while MemAt[node].depth > depth { node = MemAt[node].parent }
      let name = slice(Mem.names, MemAt[node].start, MemAt[node].end) as text[1024]
      let w = text_extent(name, 0, 14.0, 0.0, 2)
      window::write(name, x, top() + 12.0, w + 4.0, 0, 14.0, 0.0, 0.0, 2, 0,
                    if depth == shown { 0xe2ecf5 } else { 0x7fb6ea })
      if depth < shown { window::write("/", x + w + 8.0, top() + 12.0, 14.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x7d8a98) }
      x += w + 26.0
      depth += 1
    }
    window::write(size_text(MemAt[Mem.root].bytes), x, top() + 12.0, 200.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    // The boxes: those that hold others darker, with their name above
    // what they hold; the leaves in their kind's colour.
    var k = Mem.root
    while k < len(MemAt) {
      let bw = MemAt[k].w
      let bh = MemAt[k].h
      if bw >= 1.0 && bh >= 1.0 {
        let bx = MemAt[k].x
        let by = MemAt[k].y
        let colour = mem_colour(MemAt[k].kind)
        let name = slice(Mem.names, MemAt[k].start, MemAt[k].end) as text[1024]
        if MemAt[k].count > 0 {
          if k != Mem.root {
            rect(bx, by, bw, bh, mem_shade(colour, MemAt[k].depth - MemAt[Mem.root].depth))
            if bw > 60.0 && bh > 40.0 {
              clip(bx + 3.0, by + 1.0, bw - 6.0, mem_head())
              window::write(name + "  " + size_text(MemAt[k].bytes), bx + 4.0, by + 2.0, 2000.0, 0, 12.0, 0.0,
                            0.0, 2, 0, 0xe2ecf5)
              unclip()
            }
          }
        } else {
          var fill = colour
          if name == "padding" { fill = 0x3a434d }
          rect(bx, by, bw, bh, 0x101418)
          if bw > 2.0 && bh > 2.0 { rect(bx + 0.5, by + 0.5, bw - 1.0, bh - 1.0, fill) }
          if bw > 44.0 && bh > 16.0 {
            clip(bx + 2.0, by + 1.0, bw - 4.0, bh - 2.0)
            let ink = if name == "padding" { 0x9fb0c0 } else { 0x101418 }
            window::write(short(name), bx + 4.0, by + 2.0, 2000.0, 0, 12.0, 0.0, 0.0, 2, 0, ink)
            if bh > 30.0 {
              window::write(size_text(MemAt[k].bytes), bx + 4.0, by + 16.0, 2000.0, 0, 11.0, 0.0, 0.0, 2, 0,
                            if name == "padding" { 0x7d8a98 } else { 0x26303a })
            }
            unclip()
          }
        }
      }
      k += 1
    }
    let over = Mem.over
    if over >= 0 {
      let ox = MemAt[over].x
      let oy = MemAt[over].y
      let ow = MemAt[over].w
      let oh = MemAt[over].h
      rect(ox, oy, ow, 1.0, 0xffffff)
      rect(ox, oy + oh - 1.0, ow, 1.0, 0xffffff)
      rect(ox, oy, 1.0, oh, 0xffffff)
      rect(ox + ow - 1.0, oy, 1.0, oh, 0xffffff)
    }
  }
  // The list: the world's size, each kind of array.
  rect(0.0, top(), panel(), Window.height as f32 - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, Window.height as f32 - top(), 0x26303a)
  if len(MemAt) > 0 {
    window::write("The world: " + size_text(Mem.total), 16.0, top() + 8.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0,
                  0xe2ecf5)
    window::write(size_text(Mem.saved) + " of it saved with the world", 16.0, top() + 28.0, panel() - 24.0, 0,
                  13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
    window::write("Laid out once, for its whole life", 16.0, top() + 46.0, panel() - 24.0, 0, 13.0, 0.0, 0.0, 2, 0,
                  0x7d8a98)
    let first = MemAt[0].first
    var i = 0
    while i < MemAt[0].count {
      let k = first + i
      let y = top() + 80.0 + i as f32 * row_height()
      if Mem.root == k { rect(0.0, y, panel() - 1.0, row_height(), 0x24405e) }
      rect(16.0, y + 7.0, 10.0, 10.0, mem_colour(MemAt[k].kind))
      window::write(slice(Mem.names, MemAt[k].start, MemAt[k].end), 34.0, y + 3.0, 110.0, 0, 14.0, 0.0, 0.0, 2, 0,
                    0xd0d8e0)
      window::write(size_text(MemAt[k].bytes), panel() - 120.0, y + 3.0, 104.0, 0, 14.0, 0.0, 0.0, 2, 2,
                    0x9fb0c0)
      i += 1
    }
  }
}

// A click on a kind in the list: that, whole.
system list_memory() {
  if Mouse.clicks > 0 && Mouse.x < panel() && Mouse.y >= top() + 80.0 && len(MemAt) > 0 {
    let row = ((Mouse.y - top() - 80.0) / row_height()) as i32
    if row < MemAt[0].count {
      Mem.root = MemAt[0].first + row
      Mem.dirty = true
    }
  }
}

// The picture: the archetype asked for chosen, the wave drawn, saved.
// The lines of the schedule shown (All: every one), in order, one under
// the other.
system lay_out_schedule() {
  if Fz.dirty || Fz.chosen != Grid.sched {
    Fz.dirty = false
    Fz.chosen = Grid.sched
    Fz.names = ""
    for c: Sch in turn by c.row { Fz.names += c.name + "\n" }
    let chosen = Grid.sched
    for f: mut FL {
      let order = line_index(Fz.names, f.sname)
      f.key = (order + 1) * 1048576 + (f.position + 1) * 4 + fl_order(f.kind)
      let shown = order >= 0 && (chosen == -1 || order + 1 == chosen)
      f.y = if shown { 0.0 } else { -1.0 }
    }
    Fz.height = 0.0
    Fz.groups = 0
    Fz.alone = 0
    for f: mut FL in turn by f.key where f.y >= 0.0 {
      f.y = Fz.height
      Fz.height += fl_height(f.kind, len(f.why) > 0, f.count, f.queries)
      if f.kind == 2 && f.count > 1 { Fz.groups += 1 }
      if f.kind == 3 && (f.group < 0 || f.count < 2) { Fz.alone += 1 }
    }
    Fz.top = 0.0
  }
}

// Clicks in the list, the wheel; what the pointer is on.
system steer_schedule() {
  let mx = Mouse.x
  let my = Mouse.y
  let free = !Src.open || mx < source_x(Window.width as f32)
  if Mouse.clicks > 0 && mx < panel() && my > top() {
    let row = ((my - top() - 30.0) / row_height()) as i32
    if row == 0 { Grid.sched = -1 }
    for c: Sch in turn by c.row where c.row == row && row > 0 { Grid.sched = c.row }
  }
  let room = Window.height as f32 - top() - 32.0
  if mx > panel() && my > top() && Mouse.wheel_y != 0.0 && free {
    Fz.top = max(0.0, min(Fz.top - Mouse.wheel_y * 40.0, Fz.height - room))
  }
  Fz.words = ""
  Fz.over_pos = -1
  let px = if Shot.px >= 0.0 { Shot.px } else { mx }
  let py = if Shot.px >= 0.0 { Shot.py } else { my }
  if px > panel() && py > top() {
    let at = py - top() - 16.0 + Fz.top
    for f: FL in turn by f.key where f.y >= 0.0 && at >= f.y && at < f.y + fl_height(f.kind, len(f.why) > 0, f.count, f.queries) {
      if f.kind == 3 {
        Fz.over_pos = f.position
        Fz.over_sname = f.sname
      }
      if f.kind == 3 && f.group >= 0 && f.count > 1 {
        Fz.words = "{f.position + 1}. " + f.words + " (in " + f.sname + ")\nfused in group {f.group + 1}, with " + if f.count == 2 { "the run beside it" } else { "the {f.count - 1} runs beside it" }
      }
      if f.kind == 3 && f.group >= 0 && f.count < 2 {
        Fz.words = "{f.position + 1}. " + f.words + " (in " + f.sname + ")\ncould be fused, but runs alone"
        if len(f.why) > 0 { Fz.words = Fz.words + ": it would not join the run before, since " + f.why }
        else { Fz.words = Fz.words + ": neither run beside it can be fused" }
      }
      if f.kind == 3 && f.group < 0 {
        Fz.words = "{f.position + 1}. " + f.words + " (in " + f.sname + ")\nnot fused: " + f.why
      }
      if f.kind == 2 && f.count > 1 {
        Fz.words = "group {f.group + 1}: {f.count} runs, one loop over each of\n" + f.words
        if len(f.why) > 0 { Fz.words = Fz.words + "\na new group here, since the run would not join the one before:\n" + f.why }
      }
      if f.kind == 1 { Fz.words = "no group goes past this: " + f.words }
    }
    Fz.tx = px + 16.0
    Fz.ty = py + 14.0
  }
  // (A click on a run: its system's source.)
  if Mouse.clicks > 0 && free && Fz.over_pos >= 0 && mx > panel() {
    let sname = Fz.over_sname as text[512]
    let pos = Fz.over_pos
    for r: Rw in turn by r.index where r.schedule == sname && r.position == pos { Src.want = r.place }
  }
}

system draw_schedule() {
  let x0 = panel() + 28.0
  let w = Window.width as f32 - x0 - 28.0
  let y0 = top() + 16.0 - Fz.top
  let bottom = Window.height as f32
  clip(panel(), top(), Window.width as f32 - panel(), bottom - top())
  if Fz.height == 0.0 {
    window::write("No fusion in this map: make it again with this ent (ent map program.ent).", x0, top() + 24.0,
          w, 0, 15.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  for f: FL where f.y >= 0.0 {
    let y = y0 + f.y
    let h = fl_height(f.kind, len(f.why) > 0, f.count, f.queries)
    if y + h > top() && y < bottom {
      if f.kind == 0 {
        window::write(f.sname, x0, y + 14.0, w, 0, 17.0, 0.0, 0.0, 2, 0, 0xe2ecf5)
        rect(x0, y + 40.0, w, 1.0, 0x26303a)
      } else if f.kind == 1 {
        rect(x0 + 18.0, y + 13.0, 26.0, 1.0, 0x7a8896)
        window::write(f.words, x0 + 52.0, y + 5.0, w - 60.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x8a98a6)
      } else if f.kind == 2 && f.count > 1 {
        let colour = group_colour(f.group)
        rect(x0, y + 4.0, 6.0, h - 4.0, colour)
        rounded(x0 + 14.0, y + 4.0, w - 14.0, 22.0, 4.0, 4.0, 4.0, 4.0, 0x1a222b)
        var head = "fused: {f.count} runs, one loop over each of " + f.words
        if f.count == 1 { head = "nothing to fuse with: its own loop over " + f.words }
        if len(f.words) == 0 {
          head = if f.count == 1 { "nothing to fuse with, and no loop over entities" }
                 else { "fused: {f.count} runs, with no loop over entities" }
        }
        window::write(head, x0 + 24.0, y + 7.0, w - 34.0, 0, 13.0, 0.0, 0.0, 2, 0, colour)
        if len(f.why) > 0 {
          window::write("a new group, since " + f.why, x0 + 24.0, y + 28.0, w - 34.0, 0, 12.0, 0.0, 0.0, 2, 0,
                0xd9a05b)
        }
      } else if f.kind == 3 {
        let fused = f.group >= 0 && f.count > 1
        rect(x0, y, 6.0, h, if fused { group_colour(f.group) } else { 0x2a323b })
        let words = "{f.position + 1}. " + short(f.words)
        window::write(words, x0 + 24.0, y + 4.0, 360.0, 0, 14.0, 0.0, 0.0, 2, 0,
              if fused { 0xd0d8e0 } else { 0x9aa6b2 })
        if f.group >= 0 && !fused {
          window::write("could be fused; alone here" + if len(f.why) > 0 { ", since " + f.why } else { "" },
                x0 + 390.0, y + 5.0, w - 400.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
        }
        if f.queries > 0 {
          window::write(cores_words(f.queries, f.many, f.one, f.most, f.least), x0 + 44.0, y + 23.0, w - 54.0, 0,
                12.0, 0.0, 0.0, 2, 0, cores_colour(f.queries, f.many, f.most, f.least))
        }
        if f.group < 0 {
          window::write("not fused: " + f.why, x0 + 390.0, y + 5.0, w - 400.0, 0, 13.0, 0.0, 0.0, 2, 0, 0xd9a05b)
        }
      }
    }
  }
  unclip()
  // The list of schedules.
  rect(0.0, top(), panel(), Window.height as f32 - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, Window.height as f32 - top(), 0x26303a)
  window::write("Schedules", 16.0, top() + 8.0, panel() - 24.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
  let first = top() + 30.0
  if Grid.sched == -1 { rect(0.0, first, panel() - 1.0, row_height(), 0x24405e) }
  window::write("All", 16.0, first + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  for c: Sch where c.row > 0 {
    let y = first + c.row as f32 * row_height()
    if c.row == Grid.sched { rect(0.0, y, panel() - 1.0, row_height(), 0x24405e) }
    window::write(short(c.name) + "  ({c.runs})", 16.0, y + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  }
}

// The frame chosen: its sums, how deep its first thread goes.
system lay_out_cores() {
  if Co.dirty {
    Co.dirty = false
    let chosen = Co.frame
    Co.depth = 0
    Co.work = 0.0
    Co.parallel = 0.0
    Co.shares = 0
    for f: CFrame where f.index == chosen {
      Co.us = f.us
      Co.threads = f.threads
    }
    var t = 0
    while t < len(CBusy) {
      CBusy[t].us = 0.0
      t += 1
    }
    for s: CSlice in turn by s.from where s.frame == chosen && s.kind == 2 && s.thread < len(CBusy) {
      CBusy[s.thread].us += s.us
    }
    for s: CSlice where s.frame == chosen {
      if s.thread == 0 { Co.depth max= s.depth }
      if s.kind == 2 { Co.work += s.us }
      if s.kind == 1 { Co.parallel += s.us }
    }
    for h: CShare where h.frame == chosen { Co.shares += 1 }
  }
}

// Clicks in the list of frames; the slice under the pointer.
system steer_cores() {
  if Mouse.clicks > 0 && Mouse.x < panel() && Mouse.y > top() + 30.0 {
    let row = ((Mouse.y - top() - 30.0) / (row_height() * 2.0)) as i32
    if row >= 0 && row < Co.frames {
      Co.frame = row
      Co.dirty = true
    }
  }
  Co.words = ""
  Co.over_group = -1
  let px = if Shot.px >= 0.0 { Shot.px } else { Mouse.x }
  let py = if Shot.px >= 0.0 { Shot.py } else { Mouse.y }
  let x0 = cores_x0()
  let w = Window.width as f32 - x0 - 28.0
  let y0 = top() + 56.0
  let chosen = Co.frame
  let scale = w / max(Co.us, 1.0)
  let deepest = Co.depth
  if px > x0 && py > y0 && Co.us > 0.0 {
    let at = (px - x0) / scale
    for s: CSlice in turn by s.depth where s.frame == chosen && at >= s.from && at < s.from + s.us {
      let y = lane_y(y0, s.thread, s.depth, deepest)
      if py >= y && py < y + lane_h() {
        var what = if s.kind == 2 { "its share of the work of " } else if s.kind == 1 { "on {Co.threads} threads: " }
                   else if s.kind == 3 { "on one thread: " } else { "" }
        Co.words = what + s.name + "\nthread {s.thread} · " + us_words(s.us) + " · from " + us_words(s.from) +
                   " to " + us_words(s.from + s.us)
        Co.over_group = s.group
        if Mouse.clicks > 0 && (!Src.open || Mouse.x < source_x(Window.width as f32)) { Src.want = place_in(s.name) }
      }
    }
    Co.tx = px + 16.0
    Co.ty = py + 14.0
  }
  // (Of fused runs: which they are.)
  if Co.over_group >= 0 {
    let group = Co.over_group
    let schedule = Co.schedule as text[512]
    Co.words = Co.words + "\nfused group {group + 1}, one loop for the runs of"
    for f: FL in turn by f.position where f.kind == 3 && f.sname == schedule && f.group == group {
      Co.words += "\n  " + f.words
    }
  }
}

system draw_cores() {
  let x0 = cores_x0()
  let right = Window.width as f32 - 28.0
  let w = right - x0
  let y0 = top() + 56.0
  let chosen = Co.frame
  let deepest = Co.depth
  let scale = w / max(Co.us, 1.0)
  let bottom = Window.height as f32
  clip(panel(), top(), Window.width as f32 - panel(), bottom - top())
  if Co.frames == 0 {
    window::write("No threads in this map. Build the program with --parallel --trace, run it, then make the map " +
          "with ent map --trace: what each thread did in a few of its frames is shown here.", panel() + 28.0,
          top() + 24.0, w, 0, 15.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  if Co.frames > 0 {
    // The time across, every tenth of the frame.
    var k = 0
    while k <= 10 {
      let x = x0 + w * k as f32 / 10.0
      rect(x, y0 - 6.0, 1.0, lane_y(y0, Co.threads, 0, deepest) - y0 + 6.0, 0x1c242d)
      window::write(us_words(Co.us * k as f32 / 10.0), x - 40.0, y0 - 26.0, 80.0, 0, 11.0, 0.0, 0.0, 2, 1, 0x6a7886)
      k += 1
    }
    // The lanes: their ground and names; a thread's share of the time it
    // worked.
    var t = 0
    while t < Co.threads {
      let y = lane_y(y0, t, 0, deepest)
      let h = if t == 0 { (deepest + 1) as f32 * lane_h() } else { lane_h() }
      rect(x0, y, w, h - 2.0, if t % 2 == 0 { 0x121820 } else { 0x151c24 })
      let busy = if t < len(CBusy) { CBusy[t].us / max(Co.us, 1.0) } else { 0.0 }
      window::write("thread {t}", panel() + 16.0, y + 2.0, 70.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
      window::write(if busy > 0.0 { "{(busy * 100.0) as i32}%" } else { "idle" }, panel() + 76.0, y + 2.0, 44.0, 0,
            12.0, 0.0, 0.0, 2, 2, if busy > 0.0 { 0x56c26a } else { 0xd9a05b })
      t += 1
    }
    for s: CSlice where s.frame == chosen && s.kind == 2 {
      let y = lane_y(y0, s.thread, s.depth, deepest)
      rect(x0 + s.from * scale, y + 1.0, max(s.us * scale, 1.0), lane_h() - 4.0,
           slice_colour(s.kind, s.group, s.name))
    }
    for s: CSlice where s.frame == chosen && s.kind != 2 {
      let y = lane_y(y0, s.thread, s.depth, deepest)
      let sw = max(s.us * scale, 1.0)
      rect(x0 + s.from * scale, y + 1.0, sw, lane_h() - 4.0, slice_colour(s.kind, s.group, s.name))
      if sw > 46.0 {
        window::write(s.label, x0 + s.from * scale + 4.0, y + 2.0, sw - 8.0, 0, 11.0, 0.0, 0.0, 2, 0,
              if s.kind == 0 && s.group < 0 { 0xc0ccd8 } else { 0x0c1014 })
      }
    }
    // The loops over entities of the frame: how long each took, and how
    // much of its threads' time they worked in it.
    let ty = lane_y(y0, Co.threads, 0, deepest) + 28.0
    window::write("Loops over entities in this frame", panel() + 16.0, ty, 400.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
    window::write("took", x0 + 330.0, ty, 80.0, 0, 12.0, 0.0, 0.0, 2, 2, 0x6a7886)
    window::write("threads busy", x0 + 420.0, ty, 200.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x6a7886)
    for h: CShare where h.frame == chosen {
      let y = ty + 22.0 + h.order as f32 * 20.0
      if y < bottom {
        let parallel = !(find(h.name, "(one thread)", 0) >= 0)
        let share = if parallel { h.work / max(h.us * Co.threads as f32, 1.0) } else { 1.0 / Co.threads as f32 }
        rect(panel() + 16.0, y + 4.0, 8.0, 10.0, if h.group >= 0 { group_colour(h.group) } else { 0x56677a })
        window::write(h.label + (if h.times > 1 { " ×{h.times}" } else { "" }) +
              (if h.group >= 0 { " (fused group {h.group + 1})" } else { "" }), panel() + 32.0, y,
              x0 + 220.0 - panel() - 32.0, 0, 13.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
        window::write(us_words(h.us), x0 + 330.0, y, 80.0, 0, 13.0, 0.0, 0.0, 2, 2, 0xd0d8e0)
        rect(x0 + 420.0, y + 4.0, 200.0, 10.0, 0x1c242d)
        rect(x0 + 420.0, y + 4.0, 200.0 * min(share, 1.0), 10.0, if parallel { 0x56c26a } else { 0xb07a5a })
        window::write(if parallel { "{(share * 100.0) as i32}% of {Co.threads} threads" } else { "one thread" },
              x0 + 630.0, y, 260.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
        window::write(h.name, x0 + 780.0, y + 1.0, right - x0 - 780.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x6a7886)
      }
    }
  }
  unclip()
  // The frames.
  rect(0.0, top(), panel(), bottom - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, bottom - top(), 0x26303a)
  window::write("Frames of " + short(Co.schedule), 16.0, top() + 8.0, panel() - 24.0, 0, 13.0, 0.0, 0.0, 2, 0,
        0x7d8a98)
  for f: CFrame {
    let y = top() + 30.0 + f.index as f32 * row_height() * 2.0
    if f.index == Co.frame { rect(0.0, y, panel() - 1.0, row_height() * 2.0, 0x24405e) }
    window::write(us_words(f.us), 16.0, y + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
    window::write(f.why, 16.0, y + 22.0, panel() - 24.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x7d8a98)
  }
}

// A place asked for: its file, at its line.
system want_source() {
  if len(Src.want) > 0 {
    let place = Src.want as text[512]
    Src.want = ""
    var cut = len(place) - 1
    while cut > 0 && place[cut] != ':' { cut -= 1 }
    let name = slice(place, 0, cut)
    let line = int(slice(place, cut + 1, len(place)))
    Src.file = -1
    for f: SrcFile in turn by f.index where f.name == name {
      Src.file = f.index
      Src.path = f.path
    }
    Src.name = name
    Src.line = line
    Src.open = true
    Src.top = max(line as f32 - 12.0, 1.0)
    Src.note = if Src.file >= 0 { "" } else {
      "No source for " + place + " in this map: make it again with this ent (ent map program.ent)."
    }
    Src.lines = 0
    let file = Src.file
    for l: CodeLine where l.file == file { Src.lines max= l.line }
  }
}

// Its buttons, Escape, the wheel.
system steer_source() {
  let x0 = source_x(Window.width as f32)
  let right = Window.width as f32
  let mx = Mouse.x
  let my = Mouse.y
  Src.over = 0
  if my >= top() + 10.0 && my < top() + 36.0 {
    if mx >= right - 250.0 && mx < right - 160.0 { Src.over = 1 }
    if mx >= right - 150.0 && mx < right - 80.0 { Src.over = 2 }
    if mx >= right - 44.0 && mx < right - 12.0 { Src.over = 3 }
  }
  let path = Src.path as text[2048]
  let line = Src.line
  let url = url_path(path) + ":{line}:1"
  if Mouse.clicks > 0 && Src.over == 1 && Src.file >= 0 { open_url("vscode://file" + url) }
  if Mouse.clicks > 0 && Src.over == 2 && Src.file >= 0 { open_url("zed://file" + url) }
  if (Mouse.clicks > 0 && Src.over == 3) || key_pressed(256) { Src.open = false }
  let rows = (Window.height as f32 - top() - 90.0) / code_h()
  if mx > x0 && my > top() && Mouse.wheel_y != 0.0 {
    Src.top = max(1.0, min(Src.top - Mouse.wheel_y * 3.0, Src.lines as f32 - rows + 1.0))
  }
}

system draw_source() {
  let x0 = source_x(Window.width as f32)
  let right = Window.width as f32
  let bottom = Window.height as f32
  rect(x0 - 1.0, top(), 1.0, bottom - top(), 0x3a4652)
  rect(x0, top(), right - x0, bottom - top(), 0x1e1e1e)
  // The head: the file and line, where it is; the buttons.
  rect(x0, top(), right - x0, 46.0, 0x252526)
  window::write(Src.name + ":{Src.line}", x0 + 16.0, top() + 6.0, right - x0 - 280.0, 0, 15.0, 0.0, 0.0, 2, 0,
        0xe2ecf5)
  window::write(Src.path, x0 + 16.0, top() + 26.0, right - x0 - 280.0, 0, 11.0, 0.0, 0.0, 2, 0, 0x7d8a98)
  rounded(right - 250.0, top() + 10.0, 90.0, 26.0, 5.0, 5.0, 5.0, 5.0, if Src.over == 1 { 0x2f6fb0 } else { 0x264f78 })
  window::write("VS Code", right - 250.0, top() + 15.0, 90.0, 0, 13.0, 0.0, 0.0, 2, 1, 0xe2ecf5)
  rounded(right - 150.0, top() + 10.0, 70.0, 26.0, 5.0, 5.0, 5.0, 5.0, if Src.over == 2 { 0x4a4f8a } else { 0x383c6b })
  window::write("Zed", right - 150.0, top() + 15.0, 70.0, 0, 13.0, 0.0, 0.0, 2, 1, 0xe2ecf5)
  window::write("×", right - 44.0, top() + 10.0, 32.0, 0, 20.0, 0.0, 0.0, 2, 1,
        if Src.over == 3 { 0xffffff } else { 0x9fb0c0 })
  if len(Src.note) > 0 {
    window::write(Src.note, x0 + 16.0, top() + 64.0, right - x0 - 32.0, 0, 14.0, 0.0, 0.0, 0, 0, 0xd9a05b)
  }
  // The lines in the window; the one asked for marked.
  let y0 = top() + 54.0
  let first = Src.top as i32
  let rows = ((bottom - y0 - 34.0) / code_h()) as i32
  let file = Src.file
  let line = Src.line
  let font = Src.mono
  let size = code_size()
  let gutter = 52.0
  clip(x0, y0, right - x0, bottom - y0 - 34.0)
  for l: CodeLine where l.file == file && l.line >= first && l.line < first + rows {
    let y = y0 + (l.line - first) as f32 * code_h()
    if l.line == line {
      rect(x0, y - 1.0, right - x0, code_h(), 0x37373d)
      rect(x0, y - 1.0, 3.0, code_h(), 0xf0a050)
    }
    window::write("{l.line}", x0 + 4.0, y, gutter - 12.0, font, size, 0.0, 0.0, 2, 2,
          if l.line == line { 0xc6c6c6 } else { 0x6e7681 })
    code_line(l.text, l.spans, x0 + gutter, y, font, size)
  }
  unclip()
  // What the colours say.
  let ly = bottom - 28.0
  rect(x0, ly - 6.0, right - x0, 34.0, 0x252526)
  var lx = x0 + 16.0
  let names = "component\nunique\nsystem\nfn\nschedule\ntype\nfield\nkeyword"
  let kinds = "CUSFHTpk"
  var k = 0
  while k < len(kinds) {
    let word = line_at(names, k)
    rect(lx, ly + 4.0, 8.0, 8.0, code_colour(slice(kinds, k, k + 1)))
    window::write(word, lx + 12.0, ly, 120.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    lx += text_extent(word, 0, 12.0, 0.0, 2) + 28.0
    k += 1
  }
  window::write("Esc closes", right - 100.0, ly, 90.0, 0, 12.0, 0.0, 0.0, 2, 2, 0x6a7886)
}

system shot() {
  if len(Shot.file) > 0 && Map.loaded {
    Shot.frames += 1
    if Shot.frames == 2 && len(Shot.arch) > 0 {
      let wanted = Shot.arch as text[1024]
      for a: Arch where a.label == wanted {
        View.arch = a.index
        View.dirty = true
      }
    }
    if Shot.frames == 6 {
      screenshot(Shot.file as text[126])
      Shot.done = true
    }
  }
}

schedule frame() {
  begin()
  load_map()
  list_archetypes() run_if View.listed == 0 && Map.loaded
  list_schedules() run_if Grid.scheds == 0 && Map.loaded
  tabs()
  arrange()
  arrange_grid()
  steer() run_if View.mode == 0
  hover() run_if View.mode == 0
  steer_grid() run_if View.mode == 1
  hover_grid() run_if View.mode == 1
  count_values() run_if !Prov.counted && Map.loaded
  list_values()
  steer_provenance() run_if View.mode == 2
  lay_out_cards()
  draw_wave() run_if View.mode == 0
  draw_grid() run_if View.mode == 1
  draw_provenance() run_if View.mode == 2
  steer_time() run_if View.mode == 3
  hover_time() run_if View.mode == 3
  draw_time() run_if View.mode == 3
  list_memory() run_if View.mode == 4
  mem_layout() run_if View.mode == 4
  steer_memory() run_if View.mode == 4
  draw_memory() run_if View.mode == 4
  lay_out_schedule() run_if View.mode == 5 && Map.loaded
  steer_schedule() run_if View.mode == 5
  draw_schedule() run_if View.mode == 5
  lay_out_cores() run_if View.mode == 6 && Map.loaded
  steer_cores() run_if View.mode == 6
  draw_cores() run_if View.mode == 6
  draw_top()
  want_source() run_if Map.loaded
  steer_source() run_if Src.open && View.mode != 4
  draw_source() run_if Src.open && View.mode != 4
  present()
  shot()
}

main {
  loop { frame() } until Window.closed || Shot.done
}

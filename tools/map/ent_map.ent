// ent map: a program's world map in a window (tools/ent map program.ent
// makes the map, with the compiler's --ent-world-map, and opens it here).
//
//   ent_map program.map
//
// At the top, what the program's world is made of. At the left, its
// archetypes, those whose entities change state first. In the middle, the
// entities' lifecycle as a MatrixWave (Zhao et al., CHI 2015): a matrix for
// each run of `main`'s schedules that changes an entity's state, in the
// order they run; a cell is a change from the state of its row to that of
// its column (or, in every other matrix, which is turned, of its column to
// its row): each matrix's states that come out are the next one's that go
// in, along the axis they share, so the wave goes down and to the right as
// the schedules do. A state is an archetype with which of its optional
// components of the lens are present; "born" and "gone" are before a spawn
// and after a despawn.
//
// The other view, Systems × data: a row for each run of a system, a column
// for each component, unique and the like, a cell where the run reads or
// writes it; its stage and why it waits, at the pointer.
//
// And Provenance: a value (a component's field, a unique's...), the writes
// that give it one, each with the values it is made from and those it
// depends on, and the writes it goes into; a click on one shows that one.
//
// Click an archetype to see its entities (All: every one); the wheel
// zooms, dragging moves the wave; the pointer on a cell says which run,
// from what to what, and where in the program.
//
// With ENT_MAP_SHOT=picture.png it draws the wave once (of the archetype
// whose label ENT_MAP_ARCH is, where set; ENT_MAP_VIEW=data or provenance:
// those views, ENT_MAP_VALUE the value's words), saves its picture there and
// ends: for checks and pictures of it. ENT_MAP_POINT=x,y puts the pointer
// there in it (in the window's points).
import window
import console
import files
import text

// What the map says of the program as a whole.
unique Map {
  loaded: bool, program: text, lens: text, labels: text,
  archetypes: i32, systems: i32, components: i32, tags: i32, resources: i32,
  schedules: i32, queries: i32, states: i32, flows: i32, steps: i32,
  rows: i32, columns: i32, cells: i32, main_rows: i32,
  gpu: i32, opaque: i32, error: text
}
// An archetype: its number in the map, how it is told from the others,
// how many states its entities have; its row in the list (-1: not in it).
component Arch { index: i32, label: text, states: i32, row: i32 }
// A state: its number, archetype, name; its place on the axes (-1: not
// shown).
component St { index: i32, arch: i32, name: text, slot: i32 }
// A change of state: the step (the run) it is in, from and to which state
// (-1 born, -2 gone) and their archetypes (-1 for those), what it is and
// where; the matrix it is drawn in (-1: not shown).
component Fl {
  step: i32, from: i32, to: i32, from_arch: i32, to_arch: i32, kind: text,
  place: text, col: i32
}
// A step: its number, the run's system and schedule, which archetypes'
// entities it changes (",3,7,"); its matrix (-1: not shown).
component Stp { step: i32, system: text, schedule: text, archs: text, col: i32 }

// By number: a state's archetype and place, a step's matrix, how many
// states an archetype has.
buffer StateRow { arch: i32, slot: i32 } capacity 65536
buffer StepRow { seen: i32, col: i32 } capacity 65536
buffer ArchRow { states: i32 } capacity 65536

// What is shown: the archetype (-1 all), how big a cell is, where the wave
// is; how many states its axes have and how many matrices; and whether to
// work that out again.
unique View {
  mode: i32, arch: i32, cell: f32, ox: f32, oy: f32, n: i32, shown: i32, dirty: bool,
  listed: i32, dragging: bool
}
// What the pointer is on: a cell's words, or none.
// The picture asked for (ENT_MAP_SHOT), and the frames before it is taken.
unique Shot { file: text, arch: text, frames: i32, done: bool, px: f32, py: f32 }
unique Hover {
  words: text, x: f32, y: f32, k: i32, from: i32, to: i32, from_name: text, to_name: text,
  step_words: text
}

default_capacity 65536
capacity Arch 4096
capacity Stp 16384

world {
  Window.width = 1400
  Window.height = 900
  Window.min_width = 640
  Window.min_height = 420
  Window.title = "ent map"
  Window.background = 0x101418
  Window.fps = 60
  Window.resizable = true
  View.arch = -1
  View.cell = 14.0
  View.ox = 420.0
  View.oy = 150.0
  View.dirty = true
  Hover.k = -1
}

fn top() -> f32 { 96.0 }
fn panel() -> f32 { 260.0 }
fn row_height() -> f32 { 22.0 }
fn born() -> i32 { -1 }
fn gone() -> i32 { -2 }

// The n-th tab-separated field of a line (from 0); none where it has fewer.
fn part(line: text, n: i32) -> text {
  var at = 0
  var k = 0
  while k < n && at >= 0 {
    let tab = find(line, "\t", at)
    at = if tab < 0 { -1 } else { tab + 1 }
    k += 1
  }
  var out = ""
  if at >= 0 {
    let end = find(line, "\t", at)
    out = slice(line, at, if end < 0 { len(line) } else { end })
  }
  out
}
fn int(t: text) -> i32 { number(t) as i32 }
// The n-th line of a text (from 0).
fn line_at(t: text, n: i32) -> text {
  var at = 0
  var k = 0
  while k < n && at >= 0 {
    let nl = find(t, "\n", at)
    at = if nl < 0 { -1 } else { nl + 1 }
    k += 1
  }
  var out = ""
  if at >= 0 {
    let end = find(t, "\n", at)
    out = slice(t, at, if end < 0 { len(t) } else { end })
  }
  out
}
// A module's name taken off ("field.Focused": "Focused").
fn short(name: text) -> text {
  var at = len(name) - 1
  while at >= 0 && name[at] != '.' { at -= 1 }
  slice(name, at + 1, len(name))
}
// "field.Focused,field.Edited": " +Focused +Edited".
fn present_words(list: text) -> text {
  var out = ""
  var from = 0
  var i = 0
  while i <= len(list) {
    if i == len(list) || list[i] == ',' {
      if i > from { out = out + " +" + short(slice(list, from, i)) }
      from = i + 1
    }
    i += 1
  }
  out
}
fn in_view(arch: i32, chosen: i32) -> bool { chosen == -1 || arch == chosen }
// (Several changes in one run, one after the other: violet.)
fn kind_colour(kind: text) -> i32 {
  if find(kind, ", ", 0) >= 0 { 0xa77be0 }
  else if kind == "spawn" { 0x4f9de0 }
  else if kind == "despawn" { 0xe0564f }
  else if slice(kind, 0, 4) == "add " { 0x56c26a }
  else { 0xe0a03a }
}
// The axis place of a state: born and gone after the states.
fn axis(state: i32, slot: i32, n: i32) -> i32 {
  if state == -1 { n } else if state == -2 { n + 1 } else { slot }
}
// Where matrix k is (its top left), of m pixels a side: the even ones
// have the states that go in down their left, the odd ones (turned)
// along their top; each shares the axis of what comes out with the next.
fn matrix_x(k: i32, m: f32, gap: f32) -> f32 { (k / 2) as f32 * (m + gap) }
fn matrix_y(k: i32, m: f32, gap: f32) -> f32 { ((k + 1) / 2) as f32 * (m + gap) }
fn gap() -> f32 { 0.0 }

// ---- Systems × data -------------------------------------------------
// A row for each run of a system, in the order `main` runs the schedules;
// a column for each component, unique, relation, buffer, and the
// entities and ticks themselves, in the order of the first row that
// touches it; a cell where the row reads it (blue), writes it (orange) or
// both. At the left of a row its stage (runs of one stage commute) and a
// red dot where the system has effects outside the world, which keep it
// in its place among all others.

// A run: its row, schedule, place in it, system, stage, what it waits
// for and why, where it is, where it calls out, whether on the GPU, the
// first of its schedule; where it is shown (-1: not).
component Rw {
  index: i32, schedule: text, position: i32, system: text, stage: i32, waits: text,
  why: text, place: text, opaque: text, gpu: bool, first: bool, shown: i32, main: bool
}
// A column: its number, kind, name; where it is shown (-1: not).
component Cn { index: i32, kind: text, name: text, shown: i32 }
// A cell: row, column, 0 reads 1 writes 2 both, the parts read and written.
component Ce { row: i32, col: i32, how: i32, reads: text, writes: text }
// A schedule in the list: its name, how many runs, its row in the list.
component Sch { name: text, runs: i32, row: i32 }
buffer RowAt { shown: i32 } capacity 65536
buffer SchRuns { runs: i32 } capacity 4096
buffer ColAt { used: i32, shown: i32 } capacity 65536

// The grid: the schedule shown (-1 all), how big a cell is, where the grid
// is; how many rows and columns are shown; what the pointer is on and the
// words of it, where.
unique Grid {
  sched: i32, cell: f32, ox: f32, oy: f32, rows: i32, cols: i32, dirty: bool,
  dragging: bool, r: i32, c: i32, words: text, tx: f32, ty: f32, scheds: i32,
  name: text, at: i32
}

fn read_colour() -> i32 { 0x4f9de0 }
fn write_colour() -> i32 { 0xe0a03a }
fn opaque_colour() -> i32 { 0xe0564f }
fn kind_band(kind: text) -> i32 {
  if kind == "unique" { 0xa77be0 }
  else if kind == "world" { 0x3fb8a8 }
  else if kind == "relation" { 0xd0c050 }
  else if kind == "buffer" { 0xc07850 }
  else { 0x5a6878 }
}
fn label_room() -> f32 { 300.0 }
fn header_room() -> f32 { 150.0 }


// ---- Provenance -------------------------------------------------------
// A value (a field of a component, unique, relation or buffer, a
// component's presence, the entities; or where values come from that are
// none of those: outside, a constant) and the writes that give it one,
// each from which values and depending on which; and the writes it goes
// into. A chip is a value: clicked, it is the one shown.

// A value: its number, kind, name, field, short words; how many writes give
// it one and use it; its row in the list (-1: not in it).
component Val {
  index: i32, kind: text, name: text, field: text, label: text, writes: i32, uses: i32,
  row: i32
}
// A write: its number, system, where, how, the value it gives and that
// value's words and kind.
component Wr { index: i32, system: text, place: text, how: text, value: i32, label: text, kind: text }
// A source of a write: the write, the value, 0 made from it 1 depending on
// it, its number in the map; the value's words and kind; the chip, in its
// card.
component Fr {
  write: i32, value: i32, role: i32, order: i32, label: text, kind: text, x: f32, y: f32,
  w: f32, shown: bool
}
// By number: where a value's words are in Prov.names, its kind, how many
// writes give it one and use it; a write's value, its chips' cursor and
// lines, whether it has chips of what it depends on, whether it is made
// from or depends on the value shown; its card in "comes from" (y, height)
// and in "goes into" (-1: not there).
buffer ValAt { start: i32, end: i32, kind: i32, writes: i32, uses: i32 } capacity 65536
buffer WrAt {
  value: i32, cx: f32, lines: i32, when: i32, from_it: i32, on_it: i32, y: f32, h: f32, gy: f32
} capacity 65536
// The values shown before, to go back to.
buffer Back { value: i32 } capacity 4096

// The value shown (-1 none), what the list is narrowed to, how far the
// list and the cards are scrolled, the list's length; the words of every
// value; the heights of the two columns; whether to lay them out again;
// the value asked for by name (ENT_MAP_VALUE).
unique Prov {
  sel: i32, filter: text, list_top: f32, top: f32, listed: i32, names: text,
  from_h: f32, to_h: f32, dirty: bool, list_dirty: bool, counted: bool, value: text, go: i32
}

fn chip_h() -> f32 { 26.0 }
fn card_head() -> f32 { 30.0 }
fn card_width() -> f32 { 520.0 }
fn kind_number(kind: text) -> i32 {
  if kind == "component" { 0 } else if kind == "unique" { 1 } else if kind == "buffer" { 2 }
  else if kind == "relation" { 3 } else if kind == "world" { 4 } else if kind == "outside" { 5 }
  else { 6 }
}
fn kind_word(n: i32) -> text {
  if n == 0 { "component" } else if n == 1 { "unique" } else if n == 2 { "buffer" }
  else if n == 3 { "relation" } else if n == 4 { "world" } else if n == 5 { "outside" }
  else { "constant" }
}
fn value_colour(kind: text) -> i32 {
  if kind == "unique" { 0xa77be0 }
  else if kind == "world" { 0x3fb8a8 }
  else if kind == "relation" { 0xd0c050 }
  else if kind == "buffer" { 0xc07850 }
  else if kind == "outside" { 0xe0564f }
  else if kind == "constant" { 0x5a6878 }
  else { 0x4f9de0 }
}
// A value's short words: "Box.x", "Lit?", "Trail.rows", "outside: clipboard".
fn value_words(kind: text, name: text, field: text) -> text {
  if kind == "constant" { "a constant" }
  else if kind == "outside" { "outside: " + short(name) }
  else if kind == "world" { if len(field) > 0 { "entities." + field } else { "entities" } }
  else if field == "?" { short(name) + "?" }
  else { short(name) + "." + field }
}
// Its words at length.
fn value_title(kind: text, name: text, field: text) -> text {
  if kind == "constant" { "a constant of the program" }
  else if kind == "outside" { "what " + name + " gives: from outside the world" }
  else if kind == "world" { "the entities" + (if len(field) > 0 { " (their " + field + ")" } else { "" }) }
  else if field == "?" { "whether an entity has " + name }
  else { kind + " " + name + "." + field }
}

// The map read: every line a record (lib/Ent/Transforms/WorldMap.cpp).
system load_map() {
  if !Map.loaded {
    Map.loaded = true
    let path = argument(0)
    let all = read_text(path)
    if len(all) == 0 {
      Map.error = "no map in '" + path + "' (ent map program.ent makes one)"
    }
    // (Its name: the map's file's, without its folder and ".map".)
    var cut = len(path) - 1
    while cut >= 0 && path[cut] != '/' { cut -= 1 }
    let file = slice(path, cut + 1, len(path))
    Map.program = if len(file) > 4 && slice(file, len(file) - 4, len(file)) == ".map" {
      slice(file, 0, len(file) - 4) + ".ent"
    } else { file }
    var labels = ""
    var at = 0
    var step = -1
    var system_name = ""
    var schedule_name = ""
    var archs = ","
    var froms = 0
    while at < len(all) {
      var end = find(all, "\n", at)
      if end < 0 { end = len(all) }
      let line = slice(all, at, end)
      at = end + 1
      let kind = part(line, 0)
      if kind == "component" {
        if len(part(line, 2)) == 0 { Map.tags += 1 } else { Map.components += 1 }
      } else if kind == "resource" {
        Map.resources += 1
      } else if kind == "archetype" {
        let label = part(line, 7)
        labels = labels + label + "\n"
        spawn { Arch { index: int(part(line, 1)), label: label, states: 0, row: -1 } }
        ArchRow += { states: 0 }
        Map.archetypes += 1
      } else if kind == "system" {
        Map.systems += 1
        if part(line, 3) == "1" { Map.gpu += 1 }
        if len(part(line, 4)) > 0 { Map.opaque += 1 }
      } else if kind == "query" {
        Map.queries += 1
      } else if kind == "schedule" {
        Map.schedules += 1
      } else if kind == "row" {
        let schedule = part(line, 2)
        let first = schedule != schedule_name
        if first {
          schedule_name = schedule
          SchRuns += { runs: 0 }
          spawn { Sch { name: schedule, runs: 0, row: len(SchRuns) } }
        }
        SchRuns[len(SchRuns) - 1].runs += 1
        spawn {
          Rw { index: int(part(line, 1)), schedule: schedule, position: int(part(line, 3)),
               system: part(line, 4), stage: int(part(line, 5)), waits: part(line, 6),
               why: part(line, 7), place: part(line, 8), opaque: part(line, 9),
               gpu: part(line, 10) == "1", first: first, shown: -1, main: part(line, 11) == "1" }
        }
        RowAt += { shown: -1 }
        Map.rows += 1
        if part(line, 11) == "1" { Map.main_rows += 1 }
      } else if kind == "column" {
        spawn { Cn { index: int(part(line, 1)), kind: part(line, 2), name: part(line, 3), shown: -1 } }
        Map.columns += 1
      } else if kind == "cell" {
        let how = part(line, 3)
        spawn {
          Ce { row: int(part(line, 1)), col: int(part(line, 2)),
               how: if how == "r" { 0 } else if how == "w" { 1 } else { 2 },
               reads: part(line, 4), writes: part(line, 5) }
        }
        Map.cells += 1
      } else if kind == "value" {
        let vk = part(line, 2)
        let words = value_words(vk, part(line, 3), part(line, 4))
        ValAt += { start: len(Prov.names), end: len(Prov.names) + len(words), kind: kind_number(vk),
                   writes: 0, uses: 0 }
        Prov.names = Prov.names + words
        spawn {
          Val { index: int(part(line, 1)), kind: vk, name: part(line, 3), field: part(line, 4),
                label: words, writes: 0, uses: 0, row: -1 }
        }
      } else if kind == "write" {
        let v = int(part(line, 5))
        spawn {
          Wr { index: int(part(line, 1)), system: part(line, 2), place: part(line, 3),
               how: part(line, 4), value: v, label: slice(Prov.names, ValAt[v].start, ValAt[v].end),
               kind: kind_word(ValAt[v].kind) }
        }
        WrAt += { value: v, cx: 0.0, lines: 0, when: 0, from_it: 0, on_it: 0, y: -1.0, h: 0.0, gy: -1.0 }
        ValAt[v].writes += 1
      } else if kind == "from" {
        let v = int(part(line, 2))
        spawn {
          Fr { write: int(part(line, 1)), value: v, role: if part(line, 3) == "when" { 1 } else { 0 },
               order: froms, label: slice(Prov.names, ValAt[v].start, ValAt[v].end),
               kind: kind_word(ValAt[v].kind), x: 0.0, y: 0.0, w: 0.0, shown: false }
        }
        ValAt[v].uses += 1
        froms += 1
      } else if kind == "lens" {
        schedule_name = ""
        Map.lens = part(line, 1)
      } else if kind == "state" {
        let arch = int(part(line, 2))
        spawn {
          St { index: int(part(line, 1)), arch: arch,
               name: line_at(labels, arch) + present_words(part(line, 3)), slot: -1 }
        }
        StateRow += { arch: arch, slot: -1 }
        ArchRow[arch].states += 1
        Map.states += 1
      } else if kind == "flow" {
        let s = int(part(line, 1))
        if s != step {
          if step >= 0 {
            spawn { Stp { step: step, system: system_name, schedule: schedule_name, archs: archs, col: -1 } }
          }
          step = s
          system_name = part(line, 4)
          schedule_name = part(line, 2)
          archs = ","
        }
        let from = int(part(line, 5))
        let to = int(part(line, 6))
        let from_arch = if from >= 0 { StateRow[from].arch } else { -1 }
        let to_arch = if to >= 0 { StateRow[to].arch } else { -1 }
        if from_arch >= 0 && find(archs, ",{from_arch},", 0) < 0 { archs = archs + "{from_arch}," }
        if to_arch >= 0 && find(archs, ",{to_arch},", 0) < 0 { archs = archs + "{to_arch}," }
        spawn {
          Fl { step: s, from: from, to: to, from_arch: from_arch, to_arch: to_arch,
               kind: part(line, 7), place: part(line, 8), col: -1 }
        }
        Map.flows += 1
      }
    }
    if step >= 0 {
      spawn { Stp { step: step, system: system_name, schedule: schedule_name, archs: archs, col: -1 } }
    }
    Map.steps = step + 1
    Map.labels = labels
    Shot.file = environment_variable("ENT_MAP_SHOT")
    Shot.arch = environment_variable("ENT_MAP_ARCH")
    if environment_variable("ENT_MAP_VIEW") == "data" { View.mode = 1 }
    if environment_variable("ENT_MAP_VIEW") == "provenance" { View.mode = 2 }
    Prov.value = environment_variable("ENT_MAP_VALUE")
    Prov.sel = -1
    Prov.list_dirty = true
    Grid.sched = -1
    Grid.dirty = true
    // (And where the pointer is in the picture: ENT_MAP_POINT=x,y.)
    let point = environment_variable("ENT_MAP_POINT")
    let comma = find(point, ",", 0)
    Shot.px = if comma > 0 { number(slice(point, 0, comma)) as f32 } else { -1.0 }
    Shot.py = if comma > 0 { number(slice(point, comma + 1, len(point))) as f32 } else { -1.0 }
    StepRow = [{ seen: 0, col: -1 }; step + 1]
  }
}

// The archetypes in the list: those whose entities have states, in the
// map's order; All above them.
system list_archetypes() {
  for a: mut Arch { a.states = ArchRow[a.index].states }
  View.listed = 1
  for a: mut Arch in turn by a.index {
    if a.states > 0 {
      a.row = View.listed
      View.listed += 1
    }
  }
}

// What is shown worked out again: the states' places, the matrices.
system arrange() {
  if View.dirty {
    View.dirty = false
    View.n = 0
    for s: mut St in turn by s.index {
      if in_view(s.arch, View.arch) {
        s.slot = View.n
        View.n += 1
      } else {
        s.slot = -1
      }
      StateRow[s.index].slot = s.slot
    }
    View.shown = 0
    let chosen = View.arch
    for st: mut Stp in turn by st.step {
      if chosen == -1 || find(st.archs, ",{chosen},", 0) >= 0 {
        st.col = View.shown
        View.shown += 1
      } else {
        st.col = -1
      }
      StepRow[st.step].col = st.col
    }
    for f: mut Fl {
      let seen = in_view(f.from_arch, chosen) || in_view(f.to_arch, chosen)
      f.col = if seen { StepRow[f.step].col } else { -1 }
    }
    // (Cells as big as let the wave start in the window, its states'
    // names at its left; where they are few, no bigger than 28.)
    // (So that the first matrices of the wave, two across and two down,
    // are in the window.)
    let tall = (Window.height as f32 - top() - 90.0) / (2 * (View.n + 2)) as f32
    let wide = (Window.width as f32 - panel() - 320.0) / (2 * (View.n + 2)) as f32
    View.cell = max(3.0, min(28.0, (min(tall, wide)) as i32 as f32))
    View.ox = panel() + 280.0
    View.oy = top() + 50.0
  }
}

// Clicks in the list, the wheel, dragging.
system steer() {
  let mx = Mouse.x
  let my = Mouse.y
  if Mouse.clicks > 0 && mx < panel() && my > top() {
    let row = ((my - top() - 30.0) / row_height()) as i32
    if row == 0 {
      View.arch = -1
      View.dirty = true
    }
    for a: Arch where a.row == row && row > 0 {
      View.arch = a.index
      View.dirty = true
    }
  }
  if mx > panel() && my > top() {
    if Mouse.wheel_y != 0.0 {
      let was = View.cell
      let cell = min(48.0, max(3.0, if Mouse.wheel_y > 0.0 { was * 1.15 } else { was / 1.15 }))
      View.ox = mx - (mx - View.ox) * cell / was
      View.oy = my - (my - View.oy) * cell / was
      View.cell = cell
    }
    if Mouse.clicks > 0 { View.dragging = true }
  }
  if !Mouse.left { View.dragging = false }
  if View.dragging {
    View.ox += Mouse.dx
    View.oy += Mouse.dy
  }
}

// What the pointer is on.
system hover() {
  Hover.words = ""
  Hover.k = -1
  let cell = View.cell
  let n = View.n + 2
  let m = n as f32 * cell
  let px = if Shot.px >= 0.0 { Shot.px } else { Mouse.x }
  let py = if Shot.px >= 0.0 { Shot.py } else { Mouse.y }
  let mx = px - View.ox
  let my = py - View.oy
  if px > panel() && py > top() && !View.dragging {
    var k = 0
    var on = -1
    var a = -1
    var b = -1
    while k < View.shown {
      let x0 = matrix_x(k, m, gap())
      let y0 = matrix_y(k, m, gap())
      if mx >= x0 && mx < x0 + m && my >= y0 && my < y0 + m {
        on = k
        let cx = ((mx - x0) / cell) as i32
        let cy = ((my - y0) / cell) as i32
        // (Even: rows go in, columns come out; odd: the other way.)
        a = if k % 2 == 0 { cy } else { cx }
        b = if k % 2 == 0 { cx } else { cy }
      }
      k += 1
    }
    if on >= 0 {
      Hover.k = on
      Hover.from = a
      Hover.to = b
      Hover.x = px + 16.0
      Hover.y = py + 14.0
      let total = View.n
      for f: Fl in turn by f.step where f.col == on {
        if axis(f.from, StateRow[max(f.from, 0)].slot, total) == a &&
           axis(f.to, StateRow[max(f.to, 0)].slot, total) == b {
          Hover.words = Hover.words + f.kind + "  (" + f.place + ")\n"
        }
      }
      Hover.from_name = if a == total { "born" } else if a == total + 1 { "gone" } else { "?" }
      Hover.to_name = if b == total { "born" } else if b == total + 1 { "gone" } else { "?" }
      for s: St in turn by s.index where s.slot >= 0 {
        if s.slot == a { Hover.from_name = s.name }
        if s.slot == b { Hover.to_name = s.name }
      }
      for st: Stp in turn by st.step where st.col == on {
        Hover.step_words = "{st.step + 1}. " + st.system + " (in " + st.schedule + ")"
      }
    }
  }
}

// The lifecycle: the wave, and the archetypes at the left.
system draw_wave() {
  let cell = View.cell
  let n = View.n + 2
  let m = n as f32 * cell
  let ox = View.ox
  let oy = View.oy
  let total = View.n
  clip(panel(), top(), Window.width as f32 - panel(), Window.height as f32 - top())
  // The matrices: their ground, a line every state, born and gone apart,
  // the shared axes' states lit where the pointer is.
  for st: Stp where st.col >= 0 {
    let x0 = ox + matrix_x(st.col, m, gap())
    let y0 = oy + matrix_y(st.col, m, gap())
    rect(x0, y0, m, m, 0x171d24)
    let edge = total as f32 * cell
    rect(x0 + edge, y0, 2.0 * cell, m, 0x1c232b)
    rect(x0, y0 + edge, m, 2.0 * cell, 0x1c232b)
    if cell >= 7.0 {
      var i = 1
      while i < n {
        rect(x0 + i as f32 * cell, y0, 1.0, m, 0x222a33)
        rect(x0, y0 + i as f32 * cell, m, 1.0, 0x222a33)
        i += 1
      }
    }
    rect(x0, y0, m, 1.0, 0x3a4652)
    rect(x0, y0 + m - 1.0, m, 1.0, 0x3a4652)
    rect(x0, y0, 1.0, m, 0x3a4652)
    rect(x0 + m - 1.0, y0, 1.0, m, 0x3a4652)
    // (The run's name where the wave leaves room: above an even matrix,
    // left of an odd one.)
    let words = short(st.system)
    let size = 14.0
    if st.col % 2 == 0 {
      window::write("{st.step + 1}. " + words, x0 + 4.0, y0 - 20.0, 600.0, 0, size, 0.0, 0.0, 2, 0, 0xc8d4e0)
    } else {
      let w = text_extent("{st.step + 1}. " + words, 0, size, 0.0, 2)
      window::write("{st.step + 1}. " + words, x0 - w - 10.0, y0 + 4.0, w + 4.0, 0, size, 0.0, 0.0, 2, 0, 0xc8d4e0)
    }
  }
  // Where the pointer is: its row and column, along the matrix.
  if Hover.k >= 0 {
    let x0 = ox + matrix_x(Hover.k, m, gap())
    let y0 = oy + matrix_y(Hover.k, m, gap())
    let r = if Hover.k % 2 == 0 { Hover.from } else { Hover.to }
    let c = if Hover.k % 2 == 0 { Hover.to } else { Hover.from }
    rect(x0, y0 + r as f32 * cell, m, cell, 0x30ffffff)
    rect(x0 + c as f32 * cell, y0, cell, m, 0x30ffffff)
  }
  // The changes.
  let pad = if cell >= 6.0 { 1.0 } else { 0.0 }
  for f: Fl where f.col >= 0 {
    let a = axis(f.from, StateRow[max(f.from, 0)].slot, total)
    let b = axis(f.to, StateRow[max(f.to, 0)].slot, total)
    if a >= 0 && b >= 0 {
      let x0 = ox + matrix_x(f.col, m, gap())
      let y0 = oy + matrix_y(f.col, m, gap())
      let x = if f.col % 2 == 0 { x0 + b as f32 * cell } else { x0 + a as f32 * cell }
      let y = if f.col % 2 == 0 { y0 + a as f32 * cell } else { y0 + b as f32 * cell }
      rect(x + pad, y + pad, cell - 2.0 * pad, cell - 2.0 * pad, kind_colour(f.kind))
    }
  }
  // The states, down the left of the first matrix.
  if cell >= 9.0 {
    let size = min(14.0, cell - 1.0)
    for s: St where s.slot >= 0 {
      let w = text_extent(s.name, 0, size, 0.0, 2)
      window::write(s.name, ox - w - 8.0, oy + s.slot as f32 * cell + (cell - size) * 0.5, w + 4.0, 0, size,
            0.0, 0.0, 2, 0, 0x9fb0c0)
    }
    let w = text_extent("born", 0, size, 0.0, 2)
    window::write("born", ox - w - 8.0, oy + total as f32 * cell + (cell - size) * 0.5, w + 4.0, 0, size,
          0.0, 0.0, 2, 0, 0x4f9de0)
    let g = text_extent("gone", 0, size, 0.0, 2)
    window::write("gone", ox - g - 8.0, oy + (total + 1) as f32 * cell + (cell - size) * 0.5, g + 4.0, 0,
          size, 0.0, 0.0, 2, 0, 0xe0564f)
  }
  unclip()

  // The list of archetypes.
  rect(0.0, top(), panel(), Window.height as f32 - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, Window.height as f32 - top(), 0x26303a)
  window::write("Archetypes", 16.0, top() + 8.0, panel() - 24.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
  let first = top() + 30.0
  if View.arch == -1 { rect(0.0, first, panel() - 1.0, row_height(), 0x24405e) }
  window::write("All ({Map.states} states)", 16.0, first + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  for a: Arch where a.row > 0 {
    let y = first + a.row as f32 * row_height()
    if a.index == View.arch { rect(0.0, y, panel() - 1.0, row_height(), 0x24405e) }
    window::write(a.label + "  ({a.states})", 16.0, y + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  }

}


// A tab of the views.
proc tab(name: text, x: f32, on: bool) {
  rounded(x, 10.0, 122.0, 28.0, 6.0, 6.0, 6.0, 6.0, if on { 0x24405e } else { 0x1a2129 })
  window::write(name, x, 15.0, 122.0, 0, 14.0, 0.0, 0.0, 2, 1, if on { 0xe2ecf5 } else { 0x9fb0c0 })
}
system tabs() {
  if Mouse.clicks > 0 && Mouse.y >= 10.0 && Mouse.y < 38.0 {
    let x = Mouse.x - (Window.width as f32 - 460.0)
    if x >= 0.0 && x < 122.0 { View.mode = 0 }
    if x >= 130.0 && x < 252.0 { View.mode = 1 }
    if x >= 260.0 && x < 382.0 { View.mode = 2 }
  }
}

// The schedules in the list, in the rows' order (their row is from 1);
// All above them; how many runs each has.
system list_schedules() {
  for c: mut Sch { c.runs = SchRuns[c.row - 1].runs }
  Grid.scheds = len(SchRuns) + 1
}

// What is shown worked out again: rows of the schedule, the columns they
// touch.
system arrange_grid() {
  if Grid.dirty {
    Grid.dirty = false
    Grid.rows = 0
    let chosen = Grid.sched
    let name = Grid.name as text[1024]
    for r: mut Rw in turn by r.index {
      if (chosen == -1 && r.main) || (chosen != -1 && r.schedule == name) {
        r.shown = Grid.rows
        Grid.rows += 1
      } else {
        r.shown = -1
      }
      RowAt[r.index].shown = r.shown
    }
    ColAt = [{ used: 0, shown: -1 }; Map.columns]
    for c: Ce in turn by c.row {
      if RowAt[c.row].shown >= 0 { ColAt[c.col].used = 1 }
    }
    Grid.cols = 0
    for n: mut Cn in turn by n.index {
      if ColAt[n.index].used == 1 {
        n.shown = Grid.cols
        Grid.cols += 1
      } else {
        n.shown = -1
      }
      ColAt[n.index].shown = n.shown
    }
    // (All rows in the window where that leaves them big enough for their
    // names; else as big as that, and the rest a drag or the wheel away.)
    let tall = (Window.height as f32 - top() - header_room() - 40.0) / max(Grid.rows, 1) as f32
    Grid.cell = max(12.0, min(22.0, tall as i32 as f32))
    Grid.ox = panel() + label_room()
    Grid.oy = top() + header_room()
  }
}

// Clicks in the list, the wheel, dragging.
system steer_grid() {
  let mx = Mouse.x
  let my = Mouse.y
  if Mouse.clicks > 0 && mx < panel() && my > top() {
    let row = ((my - top() - 30.0) / row_height()) as i32
    if row == 0 {
      Grid.sched = -1
      Grid.dirty = true
    }
    for c: Sch in turn by c.row where c.row == row && row > 0 {
      Grid.sched = c.row
      Grid.name = c.name
      Grid.dirty = true
    }
  }
  if mx > panel() && my > top() {
    if Mouse.wheel_y != 0.0 {
      let was = Grid.cell
      let cell = min(40.0, max(3.0, if Mouse.wheel_y > 0.0 { was * 1.15 } else { was / 1.15 }))
      Grid.ox = mx - (mx - Grid.ox) * cell / was
      Grid.oy = my - (my - Grid.oy) * cell / was
      Grid.cell = cell
    }
    if Mouse.clicks > 0 { Grid.dragging = true }
  }
  if !Mouse.left { Grid.dragging = false }
  if Grid.dragging {
    Grid.ox += Mouse.dx
    Grid.oy += Mouse.dy
  }
}

// What the pointer is on: a row (its run, stage and why it waits), and
// where on a column, the cell (what of it is read and written).
system hover_grid() {
  Grid.words = ""
  Grid.r = -1
  Grid.c = -1
  let px = if Shot.px >= 0.0 { Shot.px } else { Mouse.x }
  let py = if Shot.px >= 0.0 { Shot.py } else { Mouse.y }
  if px > panel() && py > top() && !Grid.dragging {
    let cell = Grid.cell
    let r = ((py - Grid.oy) / cell) as i32
    let c = if px >= Grid.ox { ((px - Grid.ox) / cell) as i32 } else { -1 }
    if py >= Grid.oy && r < Grid.rows {
      Grid.r = r
      Grid.c = if c < Grid.cols { c } else { -1 }
      Grid.tx = px + 16.0
      Grid.ty = py + 14.0
      for w: Rw in turn by w.index where w.shown == r {
        Grid.words = w.system + "  (" + w.schedule + ", run {w.position + 1}, stage {w.stage + 1})" +
                     (if len(w.place) > 0 { "  " + w.place } else { "" }) + "\n"
        if len(w.waits) > 0 { Grid.words = Grid.words + "waits for " + w.waits + ": " + w.why + "\n" }
        if len(w.opaque) > 0 { Grid.words = Grid.words + "effects outside the world at " + w.opaque + "\n" }
        if w.gpu { Grid.words = Grid.words + "on the GPU\n" }
      }
      let column = Grid.c
      if column >= 0 {
        Grid.at = -1
        for n: Cn in turn by n.index where n.shown == column {
          Grid.words = Grid.words + n.kind + " " + n.name + "\n"
          Grid.at = n.index
        }
        let at = Grid.at
        for e: Ce in turn by e.row where e.col == at && RowAt[e.row].shown == r {
          if len(e.reads) > 0 { Grid.words = Grid.words + "reads " + e.reads + "\n" }
          if len(e.writes) > 0 { Grid.words = Grid.words + "writes " + e.writes + "\n" }
        }
      }
      Grid.words = slice(Grid.words, 0, len(Grid.words) - 1)
    }
  }
}

system draw_grid() {
  let cell = Grid.cell
  let ox = Grid.ox
  let oy = Grid.oy
  let w = Grid.cols as f32 * cell
  let h = Grid.rows as f32 * cell
  clip(panel(), top(), Window.width as f32 - panel(), Window.height as f32 - top())
  rect(ox, oy, w, h, 0x171d24)
  // (Lines between the schedules' rows; every row and column a line.)
  if cell >= 6.0 {
    var i = 1
    while i < Grid.cols {
      rect(ox + i as f32 * cell, oy, 1.0, h, 0x20272f)
      i += 1
    }
    i = 1
    while i < Grid.rows {
      rect(ox, oy + i as f32 * cell, w, 1.0, 0x20272f)
      i += 1
    }
  }
  // Where the pointer is: its row and column.
  if Grid.r >= 0 { rect(ox - label_room() + 8.0, oy + Grid.r as f32 * cell, w + label_room() - 8.0, cell, 0x26ffffff) }
  if Grid.c >= 0 { rect(ox + Grid.c as f32 * cell, oy - header_room() + 10.0, cell, h + header_room() - 10.0, 0x26ffffff) }
  // The cells.
  let pad = if cell >= 6.0 { 1.0 } else { 0.0 }
  for e: Ce {
    let r = RowAt[e.row].shown
    let c = ColAt[e.col].shown
    if r >= 0 && c >= 0 {
      let x = ox + c as f32 * cell + pad
      let y = oy + r as f32 * cell + pad
      let s = cell - 2.0 * pad
      if e.how == 0 { rect(x, y, s, s, read_colour()) }
      if e.how == 1 { rect(x, y, s, s, write_colour()) }
      if e.how == 2 {
        rect(x, y, s * 0.5, s, read_colour())
        rect(x + s * 0.5, y, s * 0.5, s, write_colour())
      }
    }
  }
  // The rows: the system, its stage, a dot where it calls out; a line
  // and the schedule's name where one begins.
  let size = min(14.0, cell - 1.0)
  for r: Rw where r.shown >= 0 {
    let y = oy + r.shown as f32 * cell
    if r.first {
      rect(ox - label_room() + 8.0, y, w + label_room() - 8.0, 1.0, 0x55657a)
      window::write(r.schedule, ox + w + 10.0, y + 1.0, 300.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
    }
    if cell >= 9.0 {
      let name = short(r.system)
      let tw = text_extent(name, 0, size, 0.0, 2)
      window::write(name, ox - tw - 44.0, y + (cell - size) * 0.5, tw + 4.0, 0, size, 0.0, 0.0, 2, 0,
                    0xc8d4e0)
      window::write("{r.stage + 1}", ox - 34.0, y + (cell - size) * 0.5, 22.0, 0, size, 0.0, 0.0, 2, 2,
                    0x7d8a98)
    }
    if len(r.opaque) > 0 { circle(ox - 6.0, y + cell * 0.5, max(2.0, cell * 0.22), opaque_colour()) }
  }
  // The columns: their names going up to the right, and their kind as a
  // band over them.
  for n: Cn where n.shown >= 0 {
    let x = ox + n.shown as f32 * cell
    rect(x + 1.0, oy - 6.0, cell - 2.0, 4.0, kind_band(n.kind))
    if cell >= 9.0 {
      label_turned(short(n.name), x + cell * 0.5 - size * 0.35, oy - 10.0, size, -45.0, 0xa8b6c4)
    }
  }
  unclip()
  // The list of schedules.
  rect(0.0, top(), panel(), Window.height as f32 - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, Window.height as f32 - top(), 0x26303a)
  window::write("Schedules", 16.0, top() + 8.0, panel() - 24.0, 0, 13.0, 0.0, 0.0, 2, 0, 0x7d8a98)
  let first = top() + 30.0
  if Grid.sched == -1 { rect(0.0, first, panel() - 1.0, row_height(), 0x24405e) }
  window::write("All main runs ({Map.main_rows})", 16.0, first + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  for c: Sch where c.row > 0 {
    let y = first + c.row as f32 * row_height()
    if c.row == Grid.sched { rect(0.0, y, panel() - 1.0, row_height(), 0x24405e) }
    window::write(short(c.name) + "  ({c.runs})", 16.0, y + 3.0, panel() - 24.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
  }
}


fn to_card_h() -> f32 { card_head() + chip_h() + 12.0 }
// Where the cards begin: of "comes from", of "goes into"; how far down.
fn from_x() -> f32 { panel() + 24.0 }
fn to_x() -> f32 { panel() + 48.0 + card_width() }
fn cards_y() -> f32 { top() + 100.0 }
fn list_y() -> f32 { top() + 56.0 }
fn over_back(mx: f32, my: f32) -> bool {
  mx > from_x() && mx < from_x() + 72.0 && my > top() + 14.0 && my < top() + 40.0
}

// ---- Provenance: what is shown --------------------------------------

// How many writes give each value one, and use it.
system count_values() {
  for v: mut Val {
    v.writes = ValAt[v.index].writes
    v.uses = ValAt[v.index].uses
  }
  Prov.counted = true
}

// The list: the values whose words have what is typed.
system list_values() {
  if Prov.list_dirty {
    Prov.list_dirty = false
    Prov.listed = 0
    let filter = lower(Prov.filter) as text[1024]
    for v: mut Val in turn by v.index {
      if (len(filter) == 0 || find(lower(v.label), filter, 0) >= 0) && v.kind != "constant" {
        v.row = Prov.listed
        Prov.listed += 1
      } else {
        v.row = -1
      }
    }
    Prov.list_top = 0.0
  }
}

// The cards laid out again: those of the writes that give the value shown
// one, with their chips; those of the writes it goes into.
system lay_out_cards() {
  if Prov.dirty {
    Prov.dirty = false
    Prov.top = 0.0
    let sel = Prov.sel
    let width = card_width()
    WrAt = [{ value: 0, cx: 0.0, lines: 0, when: 0, from_it: 0, on_it: 0, y: -1.0, h: 0.0, gy: -1.0 }; len(WrAt)]
    for w: Wr in turn by w.index { WrAt[w.index].value = w.value }
    // The chips: the values it is made from first, then those it depends on.
    for f: mut Fr in turn by f.order {
      f.shown = false
      if f.value == sel && f.role == 0 { WrAt[f.write].from_it = 1 }
      if f.value == sel && f.role == 1 { WrAt[f.write].on_it = 1 }
    }
    var role = 0
    while role < 2 {
      let r = role
      for f: mut Fr in turn by f.order where WrAt[f.write].value == sel && f.role == r {
        let w = text_extent(f.label, 0, 13.0, 0.0, 2) + 22.0
        let at = f.write
        // (Those it depends on on lines of their own, after "depending on".)
        if r == 1 && WrAt[at].when == 0 {
          WrAt[at].when = 1
          WrAt[at].lines += 1
          WrAt[at].cx = 104.0
        } else if WrAt[at].lines == 0 {
          WrAt[at].lines = 1
        } else if WrAt[at].cx + w > width - 28.0 {
          WrAt[at].lines += 1
          WrAt[at].cx = if r == 1 { 104.0 } else { 0.0 }
        }
        f.x = WrAt[at].cx
        f.y = (WrAt[at].lines - 1) as f32 * (chip_h() + 4.0)
        f.w = w
        f.shown = true
        WrAt[at].cx += w + 6.0
      }
      role += 1
    }
    Prov.from_h = 0.0
    Prov.to_h = 0.0
    for w: Wr in turn by w.index {
      if w.value == sel {
        WrAt[w.index].y = Prov.from_h
        WrAt[w.index].h = card_head() + max(WrAt[w.index].lines, 1) as f32 * (chip_h() + 4.0) + 10.0
        Prov.from_h += WrAt[w.index].h + 10.0
      }
      if WrAt[w.index].from_it + WrAt[w.index].on_it > 0 {
        WrAt[w.index].gy = Prov.to_h
        Prov.to_h += to_card_h() + 10.0
      }
    }
  }
}


// Typing narrows the list (Backspace takes a letter back, or with nothing
// typed goes back); clicks in the list, on a chip, on "back"; the wheel.
system steer_provenance() {
  Prov.go = -1
  var back = false
  // (The value asked for by name, for a picture: ENT_MAP_VALUE.)
  if len(Prov.value) > 0 && Prov.counted {
    let wanted = Prov.value as text[1024]
    for v: Val where v.label == wanted { Prov.go max= v.index }
    Prov.value = ""
  }
  var typed = 0
  while typed < Window.typed && typed < 256 {
    Prov.filter = Prov.filter + character(Typed[typed].code)
    Prov.list_dirty = true
    typed += 1
  }
  if key_pressed(259) {
    if len(Prov.filter) > 0 {
      Prov.filter = slice(Prov.filter, 0, len(Prov.filter) - 1)
      Prov.list_dirty = true
    } else {
      back = true
    }
  }
  let mx = Mouse.x
  let my = Mouse.y
  if Mouse.wheel_y != 0.0 {
    if mx < panel() {
      let most = max(0.0, Prov.listed as f32 * row_height() - (Window.height as f32 - list_y()))
      Prov.list_top = min(most, max(0.0, Prov.list_top - Mouse.wheel_y * 40.0))
    } else {
      let most = max(0.0, max(Prov.from_h, Prov.to_h) - (Window.height as f32 - cards_y() - 20.0))
      Prov.top = min(most, max(0.0, Prov.top - Mouse.wheel_y * 40.0))
    }
  }
  if Mouse.clicks > 0 && my > top() {
    if mx < panel() && my > list_y() {
      let row = ((my - list_y() + Prov.list_top) / row_height()) as i32
      for v: Val where v.row == row { Prov.go max= v.index }
    }
    if over_back(mx, my) { back = true }
    if my > cards_y() - 30.0 {
      let y0 = cards_y() - Prov.top
      // A chip of what a value comes from.
      for f: Fr where f.shown && f.kind != "constant" {
        let cx = from_x() + 14.0 + f.x
        let cy = y0 + WrAt[f.write].y + card_head() + f.y
        if mx >= cx && mx < cx + f.w && my >= cy && my < cy + chip_h() { Prov.go max= f.value }
      }
      // The value a write it goes into gives.
      if mx >= to_x() && mx < to_x() + card_width() {
        for w: Wr where WrAt[w.index].gy >= 0.0 {
          let cy = y0 + WrAt[w.index].gy + card_head()
          if my >= cy && my < cy + chip_h() { Prov.go max= w.value }
        }
      }
    }
  }
  let target = Prov.go
  if target >= 0 && target != Prov.sel {
    if Prov.sel >= 0 { Back += { value: Prov.sel } }
    Prov.sel = target
    Prov.dirty = true
  } else if back && len(Back) > 0 {
    Prov.sel = Back[len(Back) - 1].value
    Back = Back[..len(Back) - 1]
    Prov.dirty = true
  }
}

// A chip: a value's words, its kind's colour at the left.
proc chip(words: text, kind: text, x: f32, y: f32, w: f32, over: bool) {
  rounded(x, y, w, chip_h(), 5.0, 5.0, 5.0, 5.0, if over { 0x34495e } else { 0x232d38 })
  rect(x, y + 3.0, 4.0, chip_h() - 6.0, value_colour(kind))
  window::write(words, x + 12.0, y + 5.0, w - 14.0, 0, 13.0, 0.0, 0.0, 2, 0, 0xd8e2ec)
}

system draw_provenance() {
  let mx = Mouse.x
  let my = Mouse.y
  let sel = Prov.sel
  let x0 = from_x()
  let tx = to_x()
  let y0 = cards_y() - Prov.top
  let width = card_width()
  let bottom = Window.height as f32
  clip(panel(), cards_y() - 30.0, Window.width as f32 - panel(), bottom - cards_y() + 30.0)
  if sel >= 0 {
    window::write("COMES FROM", x0, y0 - 26.0, 400.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x7d8a98)
    window::write("GOES INTO", tx, y0 - 26.0, 400.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x7d8a98)
  }
  // "Comes from": a card for each write that gives it a value.
  for w: Wr where WrAt[w.index].y >= 0.0 {
    let y = y0 + WrAt[w.index].y
    let h = WrAt[w.index].h
    if y < bottom && y + h > top() {
      rounded(x0, y, width, h, 8.0, 8.0, 8.0, 8.0, 0x171d24)
      window::write(short(w.system) + "  ·  " + w.how, x0 + 14.0, y + 8.0, width - 200.0, 0, 14.0, 0.0, 0.0, 2, 0,
                    0xe2ecf5)
      window::write(w.place, x0 + width - 214.0, y + 9.0, 200.0, 0, 12.0, 0.0, 0.0, 2, 2, 0x7d8a98)
      if WrAt[w.index].lines == 0 {
        window::write("from nothing it reads", x0 + 14.0, y + card_head() + 5.0, width - 28.0, 0, 13.0, 0.0,
                      0.0, 2, 0, 0x6a7886)
      }
    }
  }
  for f: Fr where f.shown {
    let cx = x0 + 14.0 + f.x
    let cy = y0 + WrAt[f.write].y + card_head() + f.y
    if cy < bottom && cy + chip_h() > top() {
      let over = mx >= cx && mx < cx + f.w && my >= cy && my < cy + chip_h() && f.kind != "constant"
      chip(f.label, f.kind, cx, cy, f.w, over)
      if f.role == 1 && f.x == 104.0 {
        window::write("depending on", x0 + 14.0, cy + 6.0, 90.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x7d8a98)
      }
    }
  }
  // "Goes into": a card for each write made from it or depending on it.
  for w: Wr where WrAt[w.index].gy >= 0.0 {
    let y = y0 + WrAt[w.index].gy
    if y < bottom && y + to_card_h() > top() {
      rounded(tx, y, width, to_card_h(), 8.0, 8.0, 8.0, 8.0, 0x171d24)
      var head = short(w.system) + "  ·  " + w.how
      if WrAt[w.index].on_it == 1 {
        if WrAt[w.index].from_it == 1 { head = head + "  (from it, depending on it)" }
        else { head = head + "  (depending on it)" }
      }
      window::write(head, tx + 14.0, y + 8.0, width - 200.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xe2ecf5)
      window::write(w.place, tx + width - 214.0, y + 9.0, 200.0, 0, 12.0, 0.0, 0.0, 2, 2, 0x7d8a98)
      let cw = text_extent(w.label, 0, 13.0, 0.0, 2) + 22.0
      let cy = y + card_head()
      let over = mx >= tx && mx < tx + width && my >= cy && my < cy + chip_h()
      window::write("gives", tx + 14.0, cy + 6.0, 50.0, 0, 12.0, 0.0, 0.0, 2, 0, 0x7d8a98)
      chip(w.label, w.kind, tx + 60.0, cy, cw, over)
    }
  }
  unclip()
  // The value shown, at the top.
  rect(panel(), top(), Window.width as f32 - panel(), 70.0, 0x101418)
  if sel >= 0 {
    var bx = x0
    if len(Back) > 0 {
      rounded(bx, top() + 14.0, 72.0, 26.0, 6.0, 6.0, 6.0, 6.0, if over_back(mx, my) { 0x34495e } else { 0x1a2129 })
      window::write("< back", bx, top() + 19.0, 72.0, 0, 13.0, 0.0, 0.0, 2, 1, 0xc8d4e0)
      bx += 88.0
    }
    let left = bx
    for v: Val where v.index == sel {
      rect(left, top() + 17.0, 5.0, 20.0, value_colour(v.kind))
      window::write(value_title(v.kind, v.name, v.field), left + 16.0, top() + 14.0, 1000.0, 0, 18.0, 0.0, 0.0, 2, 0,
                    0xe2ecf5)
      window::write("{v.writes} writes give it a value · it goes into {v.uses}", left + 16.0, top() + 42.0, 900.0, 0,
                    13.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    }
  } else {
    window::write("Pick a value at the left (or type to find one): where it comes from, and where it goes.",
                  x0, top() + 20.0, 1000.0, 0, 16.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  // The list of values.
  rect(0.0, top(), panel(), bottom - top(), 0x141a20)
  rect(panel() - 1.0, top(), 1.0, bottom - top(), 0x26303a)
  rounded(12.0, top() + 12.0, panel() - 24.0, 30.0, 6.0, 6.0, 6.0, 6.0, 0x0c1014)
  window::write(if len(Prov.filter) > 0 { Prov.filter + "|" } else { "Type to find a value" }, 22.0, top() + 18.0,
                panel() - 40.0, 0, 14.0, 0.0, 0.0, 2, 0, if len(Prov.filter) > 0 { 0xe2ecf5 } else { 0x6a7886 })
  clip(0.0, list_y(), panel() - 1.0, bottom - list_y())
  for v: Val where v.row >= 0 {
    let y = list_y() + v.row as f32 * row_height() - Prov.list_top
    if y > list_y() - row_height() && y < bottom {
      if v.index == sel { rect(0.0, y, panel() - 1.0, row_height(), 0x24405e) }
      rect(10.0, y + 6.0, 4.0, 10.0, value_colour(v.kind))
      window::write(v.label, 22.0, y + 3.0, panel() - 90.0, 0, 14.0, 0.0, 0.0, 2, 0, 0xd0d8e0)
      window::write("{v.writes} · {v.uses}", panel() - 74.0, y + 4.0, 60.0, 0, 12.0, 0.0, 0.0, 2, 2, 0x6a7886)
    }
  }
  unclip()
}

// The top: the program, what its world has, the views, what the colours
// say; and the words of what the pointer is on.
system draw_top() {
  rect(0.0, 0.0, Window.width as f32, top(), 0x0c1014)
  rect(0.0, top() - 1.0, Window.width as f32, 1.0, 0x26303a)
  window::write("World map of " + Map.program, 16.0, 12.0, Window.width as f32 - 32.0, 0, 18.0, 0.0, 0.0, 2, 0, 0xe2ecf5)
  window::write("{Map.archetypes} archetypes · {Map.components} components, {Map.tags} tags · {Map.resources} uniques · " +
        "{Map.systems} systems ({Map.queries} queries; {Map.opaque} with effects outside the world, {Map.gpu} on the GPU) · " +
        "{Map.schedules} schedules", 16.0, 40.0, Window.width as f32 - 32.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  // The views, as tabs.
  tab("Lifecycle", Window.width as f32 - 460.0, View.mode == 0)
  tab("Systems × data", Window.width as f32 - 330.0, View.mode == 1)
  tab("Provenance", Window.width as f32 - 200.0, View.mode == 2)
  if View.mode == 1 {
    window::write("Systems × data: {Map.main_rows} runs of systems, {Map.columns} components, uniques and the like they touch, " +
          "{Map.cells} cells · a row's stage: runs of one stage touch nothing another writes", 16.0, 62.0,
          Window.width as f32 - 480.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    var x = Window.width as f32 - 470.0
    rect(x, 64.0, 12.0, 12.0, read_colour())
    window::write("reads", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    x += 80.0
    rect(x, 64.0, 12.0, 12.0, write_colour())
    window::write("writes", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    x += 80.0
    rect(x, 64.0, 6.0, 12.0, read_colour())
    rect(x + 6.0, 64.0, 6.0, 12.0, write_colour())
    window::write("both", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
    x += 70.0
    circle(x + 6.0, 70.0, 5.0, opaque_colour())
    window::write("effects outside the world", x + 16.0, 62.0, 220.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  if View.mode == 2 {
    window::write("Provenance: where each value comes from, within each system that writes it: " +
          "the values it is made from, and those that decide whether it is made", 16.0, 62.0,
          Window.width as f32 - 520.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  if View.mode == 0 {
  window::write("Lifecycle: {Map.states} states, {Map.flows} changes in {Map.steps} runs · states tell " +
        (if Map.lens == "*" { "every optional component" } else { Map.lens }), 16.0, 62.0,
        Window.width as f32 - 480.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  var x = Window.width as f32 - 540.0
  rect(x, 64.0, 12.0, 12.0, 0x4f9de0)
  window::write("spawn", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  x += 80.0
  rect(x, 64.0, 12.0, 12.0, 0x56c26a)
  window::write("add", x + 16.0, 62.0, 60.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  x += 70.0
  rect(x, 64.0, 12.0, 12.0, 0xe0a03a)
  window::write("remove", x + 16.0, 62.0, 70.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  x += 90.0
  rect(x, 64.0, 12.0, 12.0, 0xe0564f)
  window::write("despawn", x + 16.0, 62.0, 80.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  x += 100.0
  rect(x, 64.0, 12.0, 12.0, 0xa77be0)
  window::write("several", x + 16.0, 62.0, 80.0, 0, 14.0, 0.0, 0.0, 2, 0, 0x9fb0c0)
  }
  if len(Map.error) > 0 {
    window::write(Map.error, panel() + 24.0, top() + 24.0, 900.0, 0, 16.0, 0.0, 0.0, 2, 0, 0xe0564f)
  }

  // The words of the cell the pointer is on.
  if Hover.k >= 0 && View.mode == 0 {
    let all = (Hover.step_words + "\n" + Hover.from_name + "  ->  " + Hover.to_name + "\n" +
               (if len(Hover.words) > 0 { Hover.words } else { "no change\n" })) as text[4094]
    // (Without the line break at its end.)
    let words = slice(all, 0, len(all) - 1)
    let w = max(text_extent(words, 0, 14.0, 0.0, 1), 120.0) + 20.0
    let lines = text_lines(words, w, 0, 14.0, 0.0, 1)
    let h = lines as f32 * 18.0 + 14.0
    let x0 = min(Hover.x, Window.width as f32 - w - 8.0)
    let y0 = min(Hover.y, Window.height as f32 - h - 8.0)
    rounded(x0, y0, w, h, 6.0, 6.0, 6.0, 6.0, 0xf0222b35)
    window::write(words, x0 + 10.0, y0 + 7.0, w - 16.0, 0, 14.0, 0.0, 18.0, 1, 0, 0xe2ecf5)
  }
  if len(Grid.words) > 0 && View.mode == 1 {
    let words = Grid.words as text[4094]
    let w = max(text_extent(words, 0, 14.0, 0.0, 1), 120.0) + 20.0
    let lines = text_lines(words, w, 0, 14.0, 0.0, 1)
    let h = lines as f32 * 18.0 + 14.0
    let x0 = min(Grid.tx, Window.width as f32 - w - 8.0)
    let y0 = min(Grid.ty, Window.height as f32 - h - 8.0)
    rounded(x0, y0, w, h, 6.0, 6.0, 6.0, 6.0, 0xf0222b35)
    window::write(words, x0 + 10.0, y0 + 7.0, w - 16.0, 0, 14.0, 0.0, 18.0, 1, 0, 0xe2ecf5)
  }
}

// The picture: the archetype asked for chosen, the wave drawn, saved.
system shot() {
  if len(Shot.file) > 0 && Map.loaded {
    Shot.frames += 1
    if Shot.frames == 2 && len(Shot.arch) > 0 {
      let wanted = Shot.arch as text[1024]
      for a: Arch where a.label == wanted {
        View.arch = a.index
        View.dirty = true
      }
    }
    if Shot.frames == 6 {
      screenshot(Shot.file as text[126])
      Shot.done = true
    }
  }
}

schedule frame() {
  begin()
  load_map()
  list_archetypes() run_if View.listed == 0 && Map.loaded
  list_schedules() run_if Grid.scheds == 0 && Map.loaded
  tabs()
  arrange()
  arrange_grid()
  steer() run_if View.mode == 0
  hover() run_if View.mode == 0
  steer_grid() run_if View.mode == 1
  hover_grid() run_if View.mode == 1
  count_values() run_if !Prov.counted && Map.loaded
  list_values()
  steer_provenance() run_if View.mode == 2
  lay_out_cards()
  draw_wave() run_if View.mode == 0
  draw_grid() run_if View.mode == 1
  draw_provenance() run_if View.mode == 2
  draw_top()
  present()
  shot()
}

main {
  loop { frame() } until Window.closed || Shot.done
}

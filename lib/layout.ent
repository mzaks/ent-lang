// Layout: boxes inside boxes, each as wide and high as it is told, as its
// content needs, as there is room or as a share of the box it is in,
// placed in a row or a column there. A library: a program imports it,
// makes boxes, says which is inside which, and runs `layout` every frame,
// which works out what has changed since it last ran.
//
// The model is that of Clay (github.com/nicbarker/clay). A box is `Fixed`
// (as wide as `Box.w` says), `Fit` (as wide as what is in it), `Grow` (as
// wide as the room that is left, shared with the others that grow) or
// `Percent` (a share of the box it is in), within `Limits`; where the
// boxes in a row do not fit, those that can give way shrink, the largest
// first. A box has padding (`Stack.pad`, or `Pad` side by side), a gap
// between the boxes in it, and says where they stand (`Align`); it can
// keep a ratio of width to height (`Aspect`), float over another box
// (`Float`, `Over`), and its own content can have a size (`Natural`: a
// text, a picture), which lib/layout_window.ent measures, and draws.

// Where a box is and how big: what `layout` works out. Of a `Fixed` box
// it takes the width or height from here.
component Box { x: f32, y: f32, w: f32, h: f32 }

// How wide and how high a box is to be.
enum Sizing { Fixed, Fit, Grow, Percent }
component Size { w: Sizing, h: Sizing }
// For `Percent`: the share (0 to 1) of what the box it is in has inside
// its padding and gaps.
component Share { w: f32, h: f32 }
// The least and the most a box that is not `Fixed` may be; a most of 0 is
// none.
component Limits { min_w: f32, max_w: f32, min_h: f32, max_h: f32 }

// What a box does with the boxes inside it: one after another in a row,
// or below one another; `pad` between its edges and them, `gap` between
// them.
component Stack { row: bool, pad: f32, gap: f32 }
// The padding side by side, in place of `Stack.pad`.
component Pad { left: f32, right: f32, top: f32, bottom: f32 }

// Where the boxes inside a box stand in the room they leave: at the
// start (as without this), in the middle or at the end, from left to
// right and from top to bottom.
enum Place { Start, Middle, End }
component Align { x: Place, y: Place }

// A box whose height follows from its width: so many times as wide as
// high.
component Aspect { ratio: f32 }

// What a box's own content needs, apart from the boxes inside it: a text,
// a picture. `min_w` is the least it can be made (the longest word of a
// text that may go on in the next line); `h` may follow from the width
// the box got, and is then set between `layout_widths` and
// `layout_heights` (lib/layout_window.ent does, for texts).
component Natural { w: f32, min_w: f32, h: f32 }

// A box that floats over another (`Over`): in nobody's row, and with all
// that is inside it a layer above. So far from that one's corner, or
// from one point of it to one of its own (`Attach`): corners, the middles
// of the sides, the middle. If it grows it is as big as the box it floats
// over, and a share of it if that is how it is sized.
component Float { dx: f32, dy: f32 }
enum Point {
  TopLeft, MiddleLeft, BottomLeft, TopMiddle, Middle, BottomMiddle,
  TopRight, MiddleRight, BottomRight
}
component Attach { own: Point, under: Point }
// A box that is in a box but not in its row or column: it takes no room
// there, and is so far from where what is in that box starts (its corner
// inside the padding, moved as `Scroll` says). It is drawn where it comes
// among the others (by its `Slot`), in the same layer, and shows only
// where they do. As big as it comes to by itself: its `Box` says, or
// what is in it. (`next_x`, `next_y` are the layout's: where the box
// after it starts, which is where it would have.)
component Apart { dx: f32, dy: f32, next_x: f32, next_y: f32 }
// A layer of its own choosing, if that is higher than the one above the
// box it floats over.
component Raise { z: i32 }
// A box that floats and shows only where the box it floats over does:
// not outside the boxes that clip that one, nor outside that one itself
// where it clips.
tag Confined
// What is inside a box is laid out as if the box were this wide and
// high; for the box it is in, the box is as big as it is. (So a box can
// be shown on its way from one size to another with what is in it as it
// fits right then: lib/layout_window.ent does, for a `Transition`.)
component Inner { w: f32, h: f32 }
// So much more on every side than its box, for what draws it and for the
// pointer; the boxes inside it stay where they are.
component Expand { w: f32, h: f32 }

// The pointer, which a program sets (lib/layout_window.ent, from the
// mouse), and what `point` makes of it: the boxes it is over have
// `Hovered`, and `Pressed` while it is down. Of the boxes it is over,
// those in the topmost layer: what floats takes the pointer from what is
// under it, unless it has `Passthrough`. (Such a box has the pointer too,
// with what is under it, where nothing above it takes it.)
unique Pointer { x: f32, y: f32, down: bool }
unique PointerTop: i32
// And whether it went down or was let go since `point` last ran, or is
// as it was: a box that is `Hovered` when it is `ReleasedNow` was
// clicked.
enum Touch { PressedNow, Pressed, ReleasedNow, Released }
unique PointerTouch: Touch
unique PointerWas: bool
tag Hovered
tag Pressed
tag Passthrough

// Where a box comes among those in the same box: smaller first. Boxes
// without one, or with the same, are in the order they were made.
component Slot { at: i32 }

// The layer a box is in, which `layout` works out and a program draws
// by: 0, and for a box that floats, with all inside it, one more than
// the box it floats over. And how many boxes it is inside of, or over.
component Layer { z: i32, depth: i32 }

// A box that shows only what of the boxes inside it is within itself,
// from left to right, from top to bottom or both: they are as wide and
// high as they want, and it is not made bigger for them. `Scroll` moves
// them, so far to the right and down (to see what is further down, up:
// a negative `y`).
component Clip { x: bool, y: bool }
component Scroll { x: f32, y: f32 }

// What `layout` keeps for itself, and gives to every box. What a box
// comes to along one axis by its content and its own rules: the size, the
// least it can shrink to, the most, its share and its way of sizing.
// (`own`: the same size for the box itself. For the box it is in, a box
// that is `Apart` comes to nothing, and has a most of less than nothing,
// which says that it is not counted there.)
component FitW {
  fit: f32, min: f32, max: f32, share: f32, kind: Sizing, own: f32
}
component FitH {
  fit: f32, min: f32, max: f32, share: f32, kind: Sizing, own: f32
}
// And what it has for the boxes inside it: `used` by padding and gaps,
// the `room` inside the padding, how wide one of them can be across a
// column (`most`: the room, or more where the box clips), whether they
// grow (1) or shrink (2) to a `level`, what they come to along the
// row (`extent`), and how big the box is for them (`inner`: as big as it
// is, or as its `Inner` says).
component RoomW {
  used: f32, room: f32, most: f32, mode: i32, level: f32, extent: f32,
  inner: f32
}
component RoomH {
  used: f32, room: f32, most: f32, mode: i32, level: f32, extent: f32,
  inner: f32
}
// How wide and high what is in a box is in all, inside its padding: more
// than the room there, where the box clips. (By itself: nothing in
// `layout` goes by it.)
component Content { w: f32, h: f32 }
// (Sums over the boxes inside a box, while they are added up.)
component Sums {
  a: f32, b: f32, c: f32, d: f32, e: f32, n: i32, g: i32, m: i32
}
// The part of the window a box shows in: all of it, less what the boxes
// it is in clip away. What draws a box draws it within that, and the
// pointer is over it only there.
component Seen { x: f32, y: f32, w: f32, h: f32 }

// A box with nothing in it that takes the room that is left in a row:
// what comes after it is at the row's end.
prefab spacer() {
  Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
  Size { w: Sizing.Grow, h: Sizing.Fit },
  Stack { row: true, pad: 0.0, gap: 0.0 }
}

// From a box to the one it is in; the boxes in one box are in the order
// of their slots.
relation (Box)-[Inside]->(Box) tree ordered by Slot.at capacity 256
// From a box that floats to the one it floats over.
relation (Float)-[Over]->(Box) tree capacity 256

// The widths and the heights are worked out the same way, each along its
// own axis: these fns are the arithmetic of both. Along an axis is the
// way a box stacks what is in it (a row for the widths, a column for the
// heights), across it the other.

// What a box comes to by its content: what the boxes inside it come to
// and the least they can (`inside`, `inside_min`: added up along, with
// their gaps, the largest across), with padding, or its own content
// (`own`, `own_min`; 0 for none), if that is bigger; within its limits
// (`lo`, `hi`), or `size` if it is `Fixed`. Gives the size, the least it
// can shrink to and the most.
fn content_size(inside: f32, inside_min: f32, pads: f32, clips: bool,
                own: f32, own_min: f32, sizing: Sizing, size: f32, lo: f32,
                hi: f32) -> (f32, f32, f32) {
  var fit = pads + inside
  var least = pads + inside_min
  // (What a box clips can be any size without it: it need not make room.)
  if clips { least = pads }
  fit = max(fit, own + pads)
  least = max(least, own_min + pads)
  var most = hi
  if sizing == Sizing.Fixed {
    fit = size
    least = size
    most = size
  } else {
    fit = min(max(fit, lo), hi)
    least = min(max(least, lo), hi)
    if sizing == Sizing.Percent { fit = 0.0 }
  }
  (fit, least, most)
}

// A box that floats is as big as the box under it (`under`), or a share
// of it, where it grows or is a share; it is then that size. And one that
// is `Apart` comes to nothing for the box it is in (a most of less than
// nothing: not counted there). Gives the size, the least, the most, the
// share and the way of sizing, and (last) the size for the box itself.
fn float_or_apart(fit: f32, least: f32, most: f32, share: f32,
                  kind: Sizing, sizing: Sizing, floats: bool, under: f32,
                  apart: bool) -> (f32, f32, f32, f32, Sizing, f32) {
  var (f, l, m, k) = (fit, least, most, kind)
  if floats && (sizing == Sizing.Grow || sizing == Sizing.Percent) {
    f = if sizing == Sizing.Grow { under } else { under * share }
    l = f
    m = f
    k = Sizing.Fixed
  }
  if apart { (0.0, 0.0, -1.0, 0.0, Sizing.Fixed, f) }
  else { (f, l, m, share, k, f) }
}

// The size a box that fits or grows gets in the box it is in (one that
// is a share gets its share of what that one has inside its padding and
// gaps, one that is `Fixed` what it came to): along that one's row what
// its `level` says, where those there shrink (mode 2) or grow (mode 1),
// and across it no more than `most` (all of it, if it grows). (The
// callers ask for the kind first, so that what the others do not need is
// not read.)
fn flex_size(grows: bool, fit: f32, least: f32, most_own: f32, most: f32,
             along: bool, mode: i32, level: f32) -> f32 {
  if along {
    if mode == 2 { max(least, min(fit, level)) }
    else if mode == 1 && grows { min(most_own, max(fit, level)) }
    else { fit }
  } else {
    let w = if grows { min(most, most_own) } else { fit }
    max(least, min(w, most))
  }
}

// What a box inside comes to at a level, for the level that is closed in
// on: where they shrink, one that can give way down to it, none below its
// least; where they grow, one that grows up to it, none above its most.
// Nothing for the others.
fn level_reach(kind: Sizing, fit: f32, least: f32, most: f32, mode: i32,
               level: f32) -> f32 {
  if mode == 2 {
    if kind == Sizing.Fit || kind == Sizing.Grow {
      max(least, min(fit, level))
    } else { 0.0 }
  } else {
    if kind == Sizing.Grow { min(most, max(fit, level)) } else { 0.0 }
  }
}

// And whether the level leaves it as it is (what it then comes to, and 0)
// or it is at the level (0.0, 1): the level is then worked out from those.
fn level_pinned(kind: Sizing, fit: f32, least: f32, most: f32, mode: i32,
                level: f32) -> (f32, i32) {
  if mode == 2 {
    if kind == Sizing.Fit || kind == Sizing.Grow {
      if least >= level { (least, 0) }
      else if fit <= level { (fit, 0) }
      else { (0.0, 1) }
    } else { (0.0, 0) }
  } else {
    if kind == Sizing.Grow {
      if most <= level { (most, 0) }
      else if fit >= level { (fit, 0) }
      else { (0.0, 1) }
    } else { (0.0, 0) }
  }
}

// Whether those inside shrink (2) or grow (1) along, or neither (0), by
// the room that is `spare` along.
fn flex_mode(along: bool, spare: f32, give: i32, grows: i32,
             clips: bool) -> i32 {
  if !along { 0 }
  else if spare < -0.001 && give > 0 && !clips { 2 }
  else if spare > 0.001 && grows > 0 { 1 }
  else { 0 }
}

// How far into the room left over a box stands.
fn place_part(p: Place) -> f32 {
  if p == Place.Middle { 0.5 } else if p == Place.End { 1.0 } else { 0.0 }
}

// What of a box shows: what of the box it is in (or over) shows (`v...`),
// within that box (`b...`) along the axes where it clips.
fn clip_seen(vx: f32, vy: f32, vw: f32, vh: f32, bx: f32, by: f32, bw: f32,
             bh: f32, cx: bool, cy: bool) -> (f32, f32, f32, f32) {
  var x0 = vx
  var y0 = vy
  var x1 = vx + vw
  var y1 = vy + vh
  if cx {
    x0 = max(x0, bx)
    x1 = min(x1, bx + bw)
  }
  if cy {
    y0 = max(y0, by)
    y1 = min(y1, by + bh)
  }
  (x0, y0, max(0.0, x1 - x0), max(0.0, y1 - y0))
}

// Whether the pointer is over a box (`e...` more on every side) where it
// shows (`v...`).
fn pointer_over(px: f32, py: f32, bx: f32, by: f32, bw: f32, bh: f32,
                ew: f32, eh: f32, vx: f32, vy: f32, vw: f32,
                vh: f32) -> bool {
  px >= bx - ew && px < bx + bw + ew && py >= by - eh && py < by + bh + eh &&
  px >= vx && px < vx + vw && py >= vy && py < vy + vh
}

// The widths: what each box comes to by what is in it, from the innermost
// out; then what each gets, from the outermost in. Every `for` here is
// reactive: it runs for a box only where something it reads has changed.
system layout_widths() {
  // (Only the boxes that are new are given what `layout` keeps.)
  for e, b: Box without FitW on added Box {
    e.add(FitW { fit: 0.0, min: 0.0, max: 0.0, share: 0.0, kind: Sizing.Fit,
                 own: 0.0 })
    e.add(FitH { fit: 0.0, min: 0.0, max: 0.0, share: 0.0, kind: Sizing.Fit,
                 own: 0.0 })
    e.add(RoomW { used: 0.0, room: 0.0, most: 0.0, mode: 0, level: 0.0,
                  extent: 0.0, inner: 0.0 })
    e.add(RoomH { used: 0.0, room: 0.0, most: 0.0, mode: 0, level: 0.0,
                  extent: 0.0, inner: 0.0 })
    e.add(Content { w: 0.0, h: 0.0 })
    e.add(Sums { a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0, n: 0, g: 0, m: 0 })
    e.add(Seen { x: -1.0e9, y: -1.0e9, w: 2.0e9, h: 2.0e9 })
    e.add(Layer { z: 0, depth: 0 })
  }

  // (In rounds: a box that floats may be as wide as the one it floats
  // over, which is known when that one has got its width.)
  loop {
  // By its content: the boxes inside it added up along a row, the widest
  // of them in a column, with gaps and padding; or its own content, if
  // that is wider. Within its limits, and the least it can shrink to the
  // same way from theirs.
  let fitted =
  for (e, b: Box, s: Size, k: Stack, f: mut FitW, t: mut Sums,
       optional p: Pad, optional l: Limits, optional sh: Share,
       optional own: Natural, optional cl: Clip, optional ap: Apart),
      optional (e)-[Over]->(under: Box)
      bottom up Inside
      on changed s.w, changed k, changed p, changed l, changed sh,
         changed own, changed cl, changed ap, changed b.w, changed under.w,
         changed (: FitW)-[Inside]->(e) {
    t.a = 0.0
    t.b = 0.0
    t.c = 0.0
    t.d = 0.0
    t.n = 0
    for (child: FitW)-[Inside]->(e) {
      if child.max >= 0.0 { t.n += 1 }
      t.a += child.fit
      t.b += child.min
      t.c max= child.fit
      t.d max= child.min
    }
    var pads = 2.0 * k.pad
    if let left = p.left, let right = p.right { pads = left + right }
    var clips = false
    if let does = cl.x { clips = does }
    var mine = 0.0
    var mine_least = 0.0
    if let w = own.w, let m = own.min_w {
      mine = w
      mine_least = m
    }
    var lo = 0.0
    var hi = 1.0e30
    if let a = l.min_w, let z = l.max_w {
      lo = a
      if z > 0.0 { hi = z }
    }
    let gaps = if t.n > 1 { k.gap * (t.n - 1) as f32 } else { 0.0 }
    let (inside, inside_min) =
      if k.row { (t.a + gaps, t.b + gaps) } else { (t.c, t.d) }
    var (fit, least, most) =
      content_size(inside, inside_min, pads, clips, mine, mine_least, s.w,
                   b.w, lo, hi)
    var share = 0.0
    if let given = sh.w { share = given }
    var floats = false
    var over = 0.0
    if let size = under.w {
      floats = true
      over = size
    }
    var apart = false
    if let far = ap.dx { apart = true }
    let (f1, l1, m1, s1, k1, o1) =
      float_or_apart(fit, least, most, share, s.w, s.w, floats, over, apart)
    f.fit = f1
    f.min = l1
    f.max = m1
    f.share = s1
    f.kind = k1
    f.own = o1
  }

  // What it gets: the size it came to, or a share of the box it is in;
  // along that one's row what its level says, where the boxes there grow
  // into the room that is left or shrink to fit, and across it no more
  // than the room there is (all of it, if it grows). Then the same is
  // worked out for the boxes inside it, which come after it.
  let sized =
  for (e, b: mut Box, f: FitW, k: Stack, r: mut RoomW, t: mut Sums,
       all: mut Content, optional p: Pad, optional cl: Clip,
       optional in: Inner, optional ap: Apart),
      optional (e)-[Inside]->(ok: Stack, oroom: RoomW)
      top down Inside
      on changed f, changed k, changed p, changed cl, changed in.w,
         changed ok, changed oroom, changed (: FitW)-[Inside]->(e) {
    var w = f.fit
    if let inner = oroom.inner, let orow = ok.row, let used = oroom.used,
       let room = oroom.most, let mode = oroom.mode, let level = oroom.level {
      if f.kind == Sizing.Percent { w = (inner - used) * f.share }
      else if f.kind != Sizing.Fixed {
        w = flex_size(f.kind == Sizing.Grow, f.fit, f.min, f.max, room, orow,
                      mode, level)
      }
    }
    if let far = ap.dx { w = f.own }
    b.w = w
    // (From here on, as big as what is inside it is laid out for.)
    if let size = in.w { w = size }

    // For the boxes inside it. How many, how many grow, what those that
    // are not a share come to, the shares, and what those that can give
    // way come to.
    var pads = 2.0 * k.pad
    if let left = p.left, let right = p.right { pads = left + right }
    t.n = 0
    t.g = 0
    t.m = 0
    t.a = 0.0
    t.b = 0.0
    t.c = 0.0
    t.d = 0.0
    t.e = 0.0
    for (child: FitW)-[Inside]->(e) {
      if child.max >= 0.0 { t.n += 1 }
      if child.kind == Sizing.Percent { t.b += child.share } else {
        t.a += child.fit
        t.e max= child.fit
      }
      if child.kind == Sizing.Grow {
        t.g += 1
        t.d += child.fit
      }
      if child.kind == Sizing.Fit || child.kind == Sizing.Grow {
        t.m += 1
        t.c += child.fit
      }
    }
    let along = k.row
    let gaps = if t.n > 1 { k.gap * (t.n - 1) as f32 } else { 0.0 }
    let used = pads + (if along { gaps } else { 0.0 })
    var clips = false
    if let does = cl.x { clips = does }
    // (Across, a box inside can be as big as the room, or, where this one
    // clips, as the biggest of them wants.)
    let most = if clips { max(w - pads, t.e) } else { w - pads }
    let spare = w - pads - gaps - t.a - t.b * (w - used)
    let mode = flex_mode(along, spare, t.m, t.g, clips)
    var level = 0.0
    if mode > 0 {
      // Too much: those that can give way come down to a level, none below
      // the least it can be; or room left: those that grow come up to a
      // level, the smallest first, none above the most it may be. The
      // level is closed in on, and then worked out from which of them it
      // leaves as they are.
      let target = (if mode == 2 { t.c } else { t.d }) + spare
      var low = 0.0
      var high = if mode == 2 { t.c } else { target }
      for round in 0..40 {
        let mid = 0.5 * (low + high)
        t.a = 0.0
        if mode == 2 {
          for (child: FitW)-[Inside]->(e) {
            t.a += level_reach(child.kind, child.fit, child.min, child.max, 2,
                               mid)
          }
        } else {
          for (child: FitW)-[Inside]->(e) {
            t.a += level_reach(child.kind, child.fit, child.min, child.max, 1,
                               mid)
          }
        }
        if t.a > target { high = mid } else { low = mid }
      }
      level = 0.5 * (low + high)
      t.a = 0.0
      t.m = 0
      for (child: FitW)-[Inside]->(e) {
        let (kept, at) =
          level_pinned(child.kind, child.fit, child.min, child.max, mode, level)
        t.a += kept
        t.m += at
      }
      if t.m > 0 { level = (target - t.a) / t.m as f32 }
    }
    // What they come to along, for where the first one starts; or across,
    // the biggest of them: as each will be.
    t.a = 0.0
    if along {
      for (child: FitW)-[Inside]->(e) {
        let k = child.kind
        t.a += if k == Sizing.Percent { (w - used) * child.share }
               else if k == Sizing.Fixed { child.fit }
               else {
                 flex_size(k == Sizing.Grow, child.fit, child.min, child.max,
                           most, true, mode, level)
               }
      }
    } else {
      for (child: FitW)-[Inside]->(e) {
        let k = child.kind
        t.a max= if k == Sizing.Percent { (w - used) * child.share }
                 else if k == Sizing.Fixed { child.fit }
                 else {
                   flex_size(k == Sizing.Grow, child.fit, child.min,
                             child.max, most, false, 0, 0.0)
                 }
      }
    }
    r.used = used
    r.room = w - pads
    r.inner = w
    r.most = most
    r.mode = mode
    r.level = level
    r.extent = if along { t.a + gaps } else { 0.0 }
    all.w = if along { t.a + gaps } else { t.a }
  }
  } until fitted + sized == 0
}

// The heights, the same way, and then where each box is.
system layout_heights() {
  // By its content, as the widths: the boxes inside it added up along a
  // column, the highest of them in a row; or its own content, which may
  // have got its height from the width the box has now. A box that keeps
  // a ratio is as high as its width says, and stays so.
  loop {
  let fitted =
  for (e, b: Box, s: Size, k: Stack, f: mut FitH, t: mut Sums,
       optional p: Pad, optional l: Limits, optional sh: Share,
       optional own: Natural, optional keeps: Aspect, optional cl: Clip,
       optional ap: Apart),
      optional (e)-[Over]->(under: Box)
      bottom up Inside
      on changed s.h, changed k, changed p, changed l, changed sh,
         changed own, changed keeps, changed cl, changed ap, changed b,
         changed under.h,
         changed (: FitH)-[Inside]->(e) {
    t.a = 0.0
    t.b = 0.0
    t.c = 0.0
    t.d = 0.0
    t.n = 0
    for (child: FitH)-[Inside]->(e) {
      if child.max >= 0.0 { t.n += 1 }
      t.a += child.fit
      t.b += child.min
      t.c max= child.fit
      t.d max= child.min
    }
    var pads = 2.0 * k.pad
    if let top = p.top, let bottom = p.bottom { pads = top + bottom }
    var clips = false
    if let does = cl.y { clips = does }
    var mine = 0.0
    if let high = own.h { mine = high }
    let mine_least = mine
    var lo = 0.0
    var hi = 1.0e30
    if let a = l.min_h, let z = l.max_h {
      lo = a
      if z > 0.0 { hi = z }
    }
    let gaps = if t.n > 1 { k.gap * (t.n - 1) as f32 } else { 0.0 }
    let (inside, inside_min) =
      if !k.row { (t.a + gaps, t.b + gaps) } else { (t.c, t.d) }
    var (fit, least, most) =
      content_size(inside, inside_min, pads, clips, mine, mine_least, s.h,
                   b.h, lo, hi)
    var kind = s.h
    // (A box that keeps a ratio is as high as its width says.)
    if let ratio = keeps.ratio {
      if ratio > 0.0 {
        fit = b.w / ratio
        least = fit
        most = fit
        kind = Sizing.Fixed
      }
    }
    var share = 0.0
    if let given = sh.h { share = given }
    var floats = false
    var over = 0.0
    if let size = under.h {
      floats = true
      over = size
    }
    var apart = false
    if let far = ap.dx { apart = true }
    let (f1, l1, m1, s1, k1, o1) =
      float_or_apart(fit, least, most, share, kind, s.h, floats, over, apart)
    f.fit = f1
    f.min = l1
    f.max = m1
    f.share = s1
    f.kind = k1
    f.own = o1
  }

  // What it gets, as the widths, with columns for rows.
  let sized =
  for (e, b: mut Box, f: FitH, k: Stack, r: mut RoomH, t: mut Sums,
       all: mut Content, optional p: Pad, optional cl: Clip,
       optional in: Inner, optional ap: Apart),
      optional (e)-[Inside]->(ok: Stack, oroom: RoomH)
      top down Inside
      on changed f, changed k, changed p, changed cl, changed in.h,
         changed ok, changed oroom, changed (: FitH)-[Inside]->(e) {
    var h = f.fit
    if let inner = oroom.inner, let orow = ok.row, let used = oroom.used,
       let room = oroom.most, let mode = oroom.mode, let level = oroom.level {
      if f.kind == Sizing.Percent { h = (inner - used) * f.share }
      else if f.kind != Sizing.Fixed {
        h = flex_size(f.kind == Sizing.Grow, f.fit, f.min, f.max, room,
                      !orow, mode, level)
      }
    }
    if let far = ap.dy { h = f.own }
    b.h = h
    // (From here on, as big as what is inside it is laid out for.)
    if let size = in.h { h = size }

    // For the boxes inside it. How many, how many grow, what those that
    // are not a share come to, the shares, and what those that can give
    // way come to.
    var pads = 2.0 * k.pad
    if let top = p.top, let bottom = p.bottom { pads = top + bottom }
    t.n = 0
    t.g = 0
    t.m = 0
    t.a = 0.0
    t.b = 0.0
    t.c = 0.0
    t.d = 0.0
    t.e = 0.0
    for (child: FitH)-[Inside]->(e) {
      if child.max >= 0.0 { t.n += 1 }
      if child.kind == Sizing.Percent { t.b += child.share } else {
        t.a += child.fit
        t.e max= child.fit
      }
      if child.kind == Sizing.Grow {
        t.g += 1
        t.d += child.fit
      }
      if child.kind == Sizing.Fit || child.kind == Sizing.Grow {
        t.m += 1
        t.c += child.fit
      }
    }
    let along = !k.row
    let gaps = if t.n > 1 { k.gap * (t.n - 1) as f32 } else { 0.0 }
    let used = pads + (if along { gaps } else { 0.0 })
    var clips = false
    if let does = cl.y { clips = does }
    // (Across, a box inside can be as big as the room, or, where this one
    // clips, as the biggest of them wants.)
    let most = if clips { max(h - pads, t.e) } else { h - pads }
    let spare = h - pads - gaps - t.a - t.b * (h - used)
    let mode = flex_mode(along, spare, t.m, t.g, clips)
    var level = 0.0
    if mode > 0 {
      // Too much: those that can give way come down to a level, none below
      // the least it can be; or room left: those that grow come up to a
      // level, the smallest first, none above the most it may be. The
      // level is closed in on, and then worked out from which of them it
      // leaves as they are.
      let target = (if mode == 2 { t.c } else { t.d }) + spare
      var low = 0.0
      var high = if mode == 2 { t.c } else { target }
      for round in 0..40 {
        let mid = 0.5 * (low + high)
        t.a = 0.0
        if mode == 2 {
          for (child: FitH)-[Inside]->(e) {
            t.a += level_reach(child.kind, child.fit, child.min, child.max, 2,
                               mid)
          }
        } else {
          for (child: FitH)-[Inside]->(e) {
            t.a += level_reach(child.kind, child.fit, child.min, child.max, 1,
                               mid)
          }
        }
        if t.a > target { high = mid } else { low = mid }
      }
      level = 0.5 * (low + high)
      t.a = 0.0
      t.m = 0
      for (child: FitH)-[Inside]->(e) {
        let (kept, at) =
          level_pinned(child.kind, child.fit, child.min, child.max, mode, level)
        t.a += kept
        t.m += at
      }
      if t.m > 0 { level = (target - t.a) / t.m as f32 }
    }
    // What they come to along, for where the first one starts; or across,
    // the biggest of them: as each will be.
    t.a = 0.0
    if along {
      for (child: FitH)-[Inside]->(e) {
        let k = child.kind
        t.a += if k == Sizing.Percent { (h - used) * child.share }
               else if k == Sizing.Fixed { child.fit }
               else {
                 flex_size(k == Sizing.Grow, child.fit, child.min, child.max,
                           most, true, mode, level)
               }
      }
    } else {
      for (child: FitH)-[Inside]->(e) {
        let k = child.kind
        t.a max= if k == Sizing.Percent { (h - used) * child.share }
                 else if k == Sizing.Fixed { child.fit }
                 else {
                   flex_size(k == Sizing.Grow, child.fit, child.min,
                             child.max, most, false, 0, 0.0)
                 }
      }
    }
    r.used = used
    r.room = h - pads
    r.inner = h
    r.most = most
    r.mode = mode
    r.level = level
    r.extent = if along { t.a + gaps } else { 0.0 }
    all.h = if along { t.a + gaps } else { t.a }
  }
  } until fitted + sized == 0

  // Placing and floating take turns: a box that floats is put where the
  // box under it is, which must have been placed; and what is inside it
  // is placed from where it has been put, with what floats over that in
  // turn. Round after round until one has nothing new to react to: a
  // `for` gives how many boxes its body ran for, and both give none.
  loop {
    // A box starts where the one before it in the same box ends, and a
    // gap further (which that one says, in its `Layer`); the first inside the padding of the box they are in,
    // and further in by the room the boxes leave along the row or
    // column, half of it or all of it, where that box says so. Across it
    // stands at the padding, in the middle or at the end. It is in the
    // layer of the box it is in.
    let placed =
    for (b: mut Box, l: mut Layer)
            -[Inside]->(outer: Box, k: Stack, ol: Layer, rw: RoomW, rh: RoomH),
        optional (prev: Box)~[Inside]~>(b),
        optional (gone: Apart)~[Inside]~>(b),
        optional (b)-[Inside]->(how: Align),
        optional (b)-[Inside]->(pad: Pad),
        optional (b)-[Inside]->(moved: Scroll)
        without Apart top down Inside
        on changed b.w, changed b.h, changed outer, changed k, changed ol,
           changed rw, changed rh, changed prev, changed gone, changed how,
           changed pad, changed moved {
      var left = k.pad
      var top = k.pad
      if let pl = pad.left, let pt = pad.top {
        left = pl
        top = pt
      }
      var fx = 0.0
      var fy = 0.0
      if let ax = how.x, let ay = how.y {
        fx = place_part(ax)
        fy = place_part(ay)
      }
      var x = outer.x + left
      var y = outer.y + top
      if let mx = moved.x, let my = moved.y {
        x += mx
        y += my
      }
      if k.row {
        x += (rw.room - rw.extent) * fx
        y += (rh.room - b.h) * fy
      } else {
        x += (rw.room - b.w) * fx
        y += (rh.room - rh.extent) * fy
      }
      if let px = prev.x, let py = prev.y, let w = prev.w, let h = prev.h {
        if k.row { x = px + w + k.gap } else { y = py + h + k.gap }
      }
      // (After one that is not in the row: where that one says.)
      if let nx = gone.next_x, let ny = gone.next_y {
        if k.row { x = nx } else { y = ny }
      }
      b.x = x
      b.y = y
      l.z = ol.z
      l.depth = ol.depth + 1
    }
    // A box that is `Apart` is so far from where what is in the box
    // starts. The box after it starts where it would have.
    let apart =
    for (b: mut Box, l: mut Layer, ap: mut Apart)
            -[Inside]->(outer: Box, k: Stack, ol: Layer, rw: RoomW, rh: RoomH),
        optional (prev: Box)~[Inside]~>(b),
        optional (gone: Apart)~[Inside]~>(b),
        optional (b)-[Inside]->(how: Align),
        optional (b)-[Inside]->(pad: Pad),
        optional (b)-[Inside]->(moved: Scroll)
        top down Inside
        on changed ap.dx, changed ap.dy, changed outer, changed k,
           changed ol, changed rw, changed rh, changed prev, changed gone,
           changed how, changed pad, changed moved {
      var left = k.pad
      var top = k.pad
      if let pl = pad.left, let pt = pad.top {
        left = pl
        top = pt
      }
      var fx = 0.0
      var fy = 0.0
      if let ax = how.x, let ay = how.y {
        fx = place_part(ax)
        fy = place_part(ay)
      }
      var ox = outer.x + left
      var oy = outer.y + top
      if let mx = moved.x, let my = moved.y {
        ox += mx
        oy += my
      }
      // (Where the next in the row would be, as above.)
      var x = ox
      var y = oy
      if k.row { x += (rw.room - rw.extent) * fx } else {
        y += (rh.room - rh.extent) * fy
      }
      if let px = prev.x, let py = prev.y, let w = prev.w, let h = prev.h {
        if k.row { x = px + w + k.gap } else { y = py + h + k.gap }
      }
      if let nx = gone.next_x, let ny = gone.next_y {
        if k.row { x = nx } else { y = ny }
      }
      ap.next_x = x
      ap.next_y = y
      b.x = ox + ap.dx
      b.y = oy + ap.dy
      l.z = ol.z
      l.depth = ol.depth + 1
    }

    // A box that floats is so far from the corner of the one it floats
    // over, which has just been placed (or from the point of that one it
    // is attached to, to its own), and a layer above it, or in the layer
    // it asks for if that is higher.
    let floated =
    for (f: mut Box, o: Float, l: mut Layer, optional at: Attach,
         optional up: Raise)
            -[Over]->(under: Box, ul: Layer)
        top down Over
        on changed o, changed at, changed up, changed f.w, changed f.h,
           changed under, changed ul {
      var x = under.x + o.dx
      var y = under.y + o.dy
      if let mine = at.own, let theirs = at.under {
        let m = mine as i32
        let u = theirs as i32
        x += under.w * 0.5 * (u / 3) as f32 - f.w * 0.5 * (m / 3) as f32
        y += under.h * 0.5 * (u % 3) as f32 - f.h * 0.5 * (m % 3) as f32
      }
      f.x = x
      f.y = y
      var z = ul.z + 1
      if let asked = up.z { z = max(z, asked) }
      l.z = z
      l.depth = ul.depth + 1
    }
  } until placed + apart + floated == 0

  // What of each box shows: what of the box it is in shows, and of that
  // only what is within that box, where it clips. So too for a box that
  // floats and is `Confined`, with the box it floats over; any other
  // shows wherever it is. (In turns, as above: what floats has boxes
  // inside it, and those others that float over them.)
  for v: mut Seen, f: Float without Confined on removed Confined {
    v.x = -1.0e9
    v.y = -1.0e9
    v.w = 2.0e9
    v.h = 2.0e9
  }
  loop {
    let inside =
    for (v: mut Seen)-[Inside]->(ob: Box, ov: Seen),
        optional (v)-[Inside]->(oc: Clip)
        top down Inside on changed ob, changed ov, changed oc {
      var cx = false
      var cy = false
      if let x = oc.x, let y = oc.y {
        cx = x
        cy = y
      }
      let (x, y, w, h) =
        clip_seen(ov.x, ov.y, ov.w, ov.h, ob.x, ob.y, ob.w, ob.h, cx, cy)
      v.x = x
      v.y = y
      v.w = w
      v.h = h
    }
    let over =
    for (v: mut Seen)-[Over]->(ob: Box, ov: Seen),
        optional (v)-[Over]->(oc: Clip)
        with Confined top down Over
        on changed ob, changed ov, changed oc, added Confined {
      var cx = false
      var cy = false
      if let x = oc.x, let y = oc.y {
        cx = x
        cy = y
      }
      let (x, y, w, h) =
        clip_seen(ov.x, ov.y, ov.w, ov.h, ob.x, ob.y, ob.w, ob.h, cx, cy)
      v.x = x
      v.y = y
      v.w = w
      v.h = h
    }
  } until inside + over == 0
}

// Which boxes the pointer is over: after they have been placed. (Not a
// part of `layout`: it asks every box, every time, which a program
// without a pointer need not pay for.)
system point() {
  PointerTouch = if Pointer.down {
    if PointerWas { Touch.Pressed } else { Touch.PressedNow }
  } else {
    if PointerWas { Touch.ReleasedNow } else { Touch.Released }
  }
  PointerWas = Pointer.down
  PointerTop = -1
  for b: Box, l: Layer, v: Seen, optional more: Expand without Passthrough {
    var ew = 0.0
    var eh = 0.0
    if let w = more.w, let h = more.h {
      ew = w
      eh = h
    }
    if pointer_over(Pointer.x, Pointer.y, b.x, b.y, b.w, b.h, ew, eh, v.x,
                     v.y, v.w, v.h) {
      PointerTop max= l.z
    }
  }
  for e, b: Box, l: Layer, v: Seen, optional more: Expand {
    var ew = 0.0
    var eh = 0.0
    if let w = more.w, let h = more.h {
      ew = w
      eh = h
    }
    let over = pointer_over(Pointer.x, Pointer.y, b.x, b.y, b.w, b.h, ew, eh,
                             v.x, v.y, v.w, v.h) && l.z >= PointerTop
    if over != e.has(Hovered) {
      if over { e.add(Hovered) } else { e.remove(Hovered) }
    }
    let pressed = over && Pointer.down
    if pressed != e.has(Pressed) {
      if pressed { e.add(Pressed) } else { e.remove(Pressed) }
    }
  }
}

// All of it. (A program that has texts, whose heights follow from their
// widths, runs the two halves with the measuring between them: as
// lib/layout_window.ent does.)
schedule layout() {
  layout_widths()
  layout_heights()
}

// RUN: ent-translate --import-ent %s -split-input-file -verify-diagnostics

// `index Name of Component by field { .. }` (docs/syntax.md): what cannot be.

component Car { key: i64 } capacity 8
// expected-error @+1 {{unknown component 'Truck'}}
index Traffic of Truck by key

// -----

component Car { key: i64 } capacity 8
// expected-error @+1 {{expected 'by' and a field of 'Car'}}
index Traffic of Car key

// -----

component Car { x: bool } capacity 8
// expected-error @+1 {{an index is in order by a whole number or a fraction (f32, f64); 'x' is}}
index Traffic of Car by x

// -----

component Car { key: i64 } capacity 8
component Spot { x: f32 } capacity 8
// expected-error @+1 {{component 'Spot' has no field 'y'}}
index Traffic of Car by key { y: Spot.y }

// -----

component Car { key: i64 } capacity 8
// expected-error @+1 {{every row has 'who' already}}
index Traffic of Car by key { who: Car.key }

// -----

component Car { key: i64 } capacity 8
index Traffic of Car by key
system clear() {
  // expected-error @+1 {{'Traffic' is an index: the program keeps its rows in order, and they are only read}}
  Traffic = []
}

// -----

component Car { key: i64, x: f32 } capacity 8
index Traffic of Car by key { x: Car.x }
system nudge() {
  // expected-error @+1 {{'Traffic' is an index: the program keeps its rows in order, and they are only read}}
  Traffic[0].x = 1.0
}

// -----

component Car { key: i64 } capacity 8
index Traffic of Car by key
proc fill(rows: mut Traffic) { rows = [] }
system clear() {
  // expected-error @+1 {{'Traffic' is an index, whose rows are only read, and 'fill' changes the buffer it is given}}
  fill(Traffic)
}

// -----

component Car { key: i64 } capacity 8
index Traffic of Car by key
world {
  // expected-error @+1 {{'row_in_Traffic' is where an index keeps the entity's row: the index gives it}}
  spawn { Car { key: 1, row_in_Traffic: 0 } }
}

// -----

component Car { key: i64 } capacity 8
index Traffic of Car by key
fn first(rows: Traffic, e: entity) -> index of Traffic {
  // expected-error @+1 {{a fn or proc has no entities: where an entity is in 'Traffic' is asked in a system}}
  Traffic.row(e)
}

// -----

component Car { key: i64 }
// expected-error @+1 {{index 'Traffic' holds a row for each entity with 'Car': give that component a capacity}}
index Traffic of Car by key

// -----

component Dot { x: f64, n: u32 } capacity 8
// expected-error @+1 {{a grid is over places, f32, f64, i32 or i64; 'n' is}}
index Cells of Dot grid (x, n) cell 1.0

// -----

component Dot { x: f64, n: i32 } capacity 8
// expected-error @+1 {{a grid's places are of one type: 'n' is}}
index Cells of Dot grid (x, n) cell 1.0

// -----

component Dot { x: f64 } capacity 8
// expected-error @+1 {{a grid is of two places or of three}}
index Cells of Dot grid (x) cell 1.0

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{expected 'cell' and how wide a cell is at least}}
index Cells of Dot grid (x, y) wrap 10.0

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{'x' is in every row already: where the entity is in the grid}}
index Cells of Dot grid (x, y) cell 1.0 { x: Dot.x }

// -----

component Dot { x: f64, y: f64, key: i64 } capacity 8
index Order of Dot by key
system look() {
  for me, a: Dot {
    // expected-error @+1 {{'Order' is not an index of a grid}}
    for o, b: Dot near (a.x, a.y) within 1.0 in Order { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, a: Dot {
    // expected-error @+1 {{'Cells' is a grid of 2 places; the place is given 3}}
    for o, b: Dot near (a.x, a.y, a.x) within 1.0 in Cells { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, a: Dot {
    let other = me
    // expected-error @+1 {{'after' takes the entity the 'for' around visits, by its name}}
    for o, b: Dot near (a.x, a.y) within 1.0 in Cells after other { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
component Mark { x: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, m: Mark {
    // expected-error @+1 {{the 'for' around binds no 'Dot', by which 'me' has a row in 'Cells'}}
    for o, b: Dot near (m.x, m.x) within 1.0 in Cells after me { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, a: Dot {
    // expected-error @+1 {{expected 'and' and the highest corner: 'between (x0, y0) and (x1, y1) in Index'}}
    for o, b: Dot between (a.x, a.y) to (a.x, a.y) in Cells { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, a: Dot {
    // expected-error @+1 {{'Cells' is a grid of 2 places; the place is given 1}}
    for o, b: Dot between (a.x, a.y) and (a.x) in Cells { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, a: Dot {
    // expected-error @+1 {{'nearest' visits the nearest first, not by rows: no 'after'}}
    for o, b: Dot nearest 3 to (a.x, a.y) in Cells after me { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, a: Dot {
    // expected-error @+1 {{expected 'to' and the place: 'nearest k to (x, y) in Index'}}
    for o, b: Dot nearest 3 (a.x, a.y) in Cells { }
  }
}

// -----

component Ship { speed: f64 } capacity 8
// expected-error @+1 {{a hash index is by a whole number, an enum, an entity, a row number or a text; 'speed' is}}
index BySpeed of Ship by speed hash

// -----

component Ship { team: i32 } capacity 8
// expected-error @+1 {{a hash index has no order to keep the rows in: it is not 'clustered'}}
index ByTeam of Ship by team hash clustered

// -----

component Ship { team: i32 } capacity 8
index ByTeam of Ship by team hash
system look() {
  // expected-error @+1 {{'ByTeam' is a hash index: an entity by its key is 'ByTeam.get(key)'}}
  let r = ByTeam.find(3)
}

// -----

component Ship { team: i32 } capacity 8
index ByTeam of Ship by team
system look() {
  // expected-error @+1 {{'ByTeam.get' is of a hash index ('by key hash'); this one is in order: 'ByTeam.find(key)'}}
  let e = ByTeam.get(3)
}

// -----

component Ship { team: i32 } capacity 8
index ByTeam of Ship by team hash
system look() {
  // expected-error @+1 {{'ByTeam' is a hash index: it is read by 'ByTeam.get(key)' and by a 'for' whose 'where' asks 'x.key == value', not by its rows}}
  let k = ByTeam[0].key
}

// -----

component Ship { team: i32 } capacity 8
index ByTeam of Ship by team hash
system look() {
  // expected-error @+1 {{'ByTeam' is a hash index: it is read by 'ByTeam.get(key)' and by a 'for' whose 'where' asks 'x.key == value', not by its rows}}
  let n = len(ByTeam)
}

// -----

component Ship { team: i32 } capacity 8
index ByTeam of Ship by team hash
fn first(t: i32) -> entity {
  // expected-error @+1 {{'ByTeam.get' is asked of the world's index, in a system}}
  ByTeam.get(t)
}

// -----

// Of a relation: by a field of its edges, or by both ends.
component N { v: f32 } capacity 8
relation (N)-[Tie { w: f32, ok: bool }]->(N) capacity 8
// expected-error @+1 {{relation 'Tie' has no field 'x'}}
index Heavy of Tie by x

// -----

component N { v: f32 } capacity 8
relation (N)-[Tie { w: f32, ok: bool }]->(N) capacity 8
// expected-error @+1 {{an index of a relation is by a whole number or a fraction (f32, f64), or by 'source, target'; 'ok' is}}
index Heavy of Tie by ok

// -----

component N { v: f32 } capacity 8
relation (N)-[Tie { w: f32 }]->(N) capacity 8
// expected-error @+1 {{an index by the edges' other ends is by both: 'index Pairs of Tie by source, target'}}
index Pairs of Tie by target

// -----

component N { v: f32 } capacity 8
relation (N)-[Tie { w: f32 }]->(N) capacity 8
// expected-error @+1 {{an index of a relation keeps each entity's edges in order, and finds an edge to one entity by halving}}
index Pairs of Tie by source, target hash

// -----

// Edge loops in an order, and to a given entity.
component N { v: f32 } capacity 8
relation (N)-[Tie { w: f32, ok: bool }]->(N) capacity 8
system s() {
  for e, n: mut N {
    // expected-error @+1 {{the order is by a field of the edge: name it, '[s: Tie]', and say 'by s.field'}}
    for (e)-[Tie]->(v) by w { n.v += 1.0 }
  }
}

// -----

component N { v: f32 } capacity 8
relation (N)-[Tie { w: f32, ok: bool }]->(N) capacity 8
system s() {
  for e, n: mut N {
    // expected-error @+1 {{the order is by a whole number or a fraction (f32, f64); 'ok' is}}
    for (e)-[s: Tie]->(v) by s.ok { n.v += 1.0 }
  }
}

// -----

component N { v: f32 } capacity 8
relation (N)-[Tie { w: f32 }]->(N) capacity 8
system s() {
  for e, n: mut N {
    // expected-error @+1 {{'first' or 'last': one of them}}
    for (e)-[s: Tie]->(v) by s.w first 2 last 1 { n.v += 1.0 }
  }
}

// -----

component N { v: f32 } capacity 8
relation (N)-[Tree { w: f32 }]->(N) tree capacity 8
system s() {
  for e, n: mut N {
    // expected-error @+1 {{goes along the tree @Tree in an order: not along a tree yet}}
    for (c)-[t: Tree]->(e) by t.w { n.v += 1.0 }
  }
}

// -----

component Dot { x: f64 } capacity 8
// expected-error @+1 {{a Morton index is of two places or of three}}
index Tree of Dot morton (x)

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{a Morton index of 2 places has from 1 to 31 bits a side}}
index Tree of Dot morton (x, y) bits 32

// -----

component Dot { x: f64, y: f64, z: f64 } capacity 8
// expected-error @+1 {{a Morton index of 3 places has from 1 to 21 bits a side}}
index Tree of Dot morton (x, y, z) bits 22

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{a cell holds 1 entity or more before it is split}}
index Tree of Dot morton (x, y) leaf 0

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{'leaf' is said once}}
index Tree of Dot morton (x, y) leaf 8 bits 10 leaf 4

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{'bits' takes a whole number, as it is written: 'bits 16'}}
index Tree of Dot morton (x, y) bits 1.5

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{a Morton index's cells are split where the entities are many: no 'cell' ('bits' says how fine they go)}}
index Tree of Dot morton (x, y) cell 1.0

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{a Morton index's keys are worked out for every entity each time: it is not 'incremental'}}
index Tree of Dot morton (x, y) incremental

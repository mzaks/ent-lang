// RUN: ent-translate --import-ent %s -split-input-file -verify-diagnostics

// `index Name of Component by field { .. }` (docs/syntax.md): what cannot be.

component Car { key: i64 } capacity 8
// expected-error @+1 {{unknown component 'Truck'}}
index Traffic of Truck by key

// -----

component Car { key: i64 } capacity 8
// expected-error @+1 {{expected 'by' and a field of 'Car'}}
index Traffic of Car key

// -----

component Car { x: f32 } capacity 8
// expected-error @+1 {{an index is in order by a whole number; 'x' is an f32}}
index Traffic of Car by x

// -----

component Car { key: i64 } capacity 8
component Spot { x: f32 } capacity 8
// expected-error @+1 {{component 'Spot' has no field 'y'}}
index Traffic of Car by key { y: Spot.y }

// -----

component Car { key: i64 } capacity 8
// expected-error @+1 {{every row has 'who' already}}
index Traffic of Car by key { who: Car.key }

// -----

component Car { key: i64 } capacity 8
index Traffic of Car by key
system clear() {
  // expected-error @+1 {{'Traffic' is an index: the program keeps its rows in order, and they are only read}}
  Traffic = []
}

// -----

component Car { key: i64, x: f32 } capacity 8
index Traffic of Car by key { x: Car.x }
system nudge() {
  // expected-error @+1 {{'Traffic' is an index: the program keeps its rows in order, and they are only read}}
  Traffic[0].x = 1.0
}

// -----

component Car { key: i64 } capacity 8
index Traffic of Car by key
proc fill(rows: mut Traffic) { rows = [] }
system clear() {
  // expected-error @+1 {{'Traffic' is an index, whose rows are only read, and 'fill' changes the buffer it is given}}
  fill(Traffic)
}

// -----

component Car { key: i64 } capacity 8
index Traffic of Car by key
world {
  // expected-error @+1 {{'row_in_Traffic' is where an index keeps the entity's row: the index gives it}}
  spawn { Car { key: 1, row_in_Traffic: 0 } }
}

// -----

component Car { key: i64 } capacity 8
index Traffic of Car by key
fn first(rows: Traffic, e: entity) -> index of Traffic {
  // expected-error @+1 {{a fn or proc has no entities: where an entity is in 'Traffic' is asked in a system}}
  Traffic.row(e)
}

// -----

component Car { key: i64 }
// expected-error @+1 {{index 'Traffic' holds a row for each entity with 'Car': give that component a capacity}}
index Traffic of Car by key

// -----

component Dot { x: f64, n: u32 } capacity 8
// expected-error @+1 {{a grid is over places, f32, f64, i32 or i64; 'n' is}}
index Cells of Dot grid (x, n) cell 1.0

// -----

component Dot { x: f64, n: i32 } capacity 8
// expected-error @+1 {{a grid's places are of one type: 'n' is}}
index Cells of Dot grid (x, n) cell 1.0

// -----

component Dot { x: f64 } capacity 8
// expected-error @+1 {{a grid is of two places or of three}}
index Cells of Dot grid (x) cell 1.0

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{expected 'cell' and how wide a cell is at least}}
index Cells of Dot grid (x, y) wrap 10.0

// -----

component Dot { x: f64, y: f64 } capacity 8
// expected-error @+1 {{'x' is in every row already: where the entity is in the grid}}
index Cells of Dot grid (x, y) cell 1.0 { x: Dot.x }

// -----

component Dot { x: f64, y: f64, key: i64 } capacity 8
index Order of Dot by key
system look() {
  for me, a: Dot {
    // expected-error @+1 {{'Order' is not an index of a grid}}
    for o, b: Dot near (a.x, a.y) within 1.0 in Order { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, a: Dot {
    // expected-error @+1 {{'Cells' is a grid of 2 places; the place is given 3}}
    for o, b: Dot near (a.x, a.y, a.x) within 1.0 in Cells { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, a: Dot {
    let other = me
    // expected-error @+1 {{'after' takes the entity the 'for' around visits, by its name}}
    for o, b: Dot near (a.x, a.y) within 1.0 in Cells after other { }
  }
}

// -----

component Dot { x: f64, y: f64 } capacity 8
component Mark { x: f64 } capacity 8
index Cells of Dot grid (x, y) cell 1.0
system look() {
  for me, m: Mark {
    // expected-error @+1 {{the 'for' around binds no 'Dot', by which 'me' has a row in 'Cells'}}
    for o, b: Dot near (m.x, m.x) within 1.0 in Cells after me { }
  }
}

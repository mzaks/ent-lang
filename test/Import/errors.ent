// RUN: ent-translate --import-ent %s -split-input-file -verify-diagnostics

system s() {
  // expected-error @+1 {{unknown component 'Position'}}
  for p: Position {
  }
}

// -----

component Position { x: f32 }
system s() {
  for p: Position {
    // expected-error @+1 {{'p' is not 'mut': bind it as 'p: mut Position' to write it}}
    p.x = 1.0
  }
}

// -----

component Position { x: f32 }
system s() {
  for p: mut Position {
    let a = 1.0
    // expected-error @+1 {{'a' is a value and cannot be assigned; locals are immutable}}
    a = 2.0
  }
}

// -----

component Position { x: f32 }
unique Clock { frame: i64 }
system s() {
  for p: Position {
    // expected-error @+1 {{inside a 'for', a unique can only be accumulated into ('+=', '-=', 'min=', 'max='): every entity would write the same field}}
    Clock.frame = 1
  }
}

// -----

component Hull { hp: f32 }
component Target { who: entity }
system s() {
  for t: Target {
    // expected-error @+1 {{another entity's field can only be combined into ('+=', '-=', 'min=', 'max='): which write lands last would depend on the order}}
    Hull(t.who).hp = 0.0
  }
}

// -----

component Hull { hp: f32 }
component Target { who: entity }
system s() {
  for t: Target {
    // expected-error @+1 {{reading another entity's field may find nothing: use 'if let value = Hull(entity).field { ... }'}}
    let hp = Hull(t.who).hp
  }
}

// -----

component Position { x: f32, y: f32 }
system s() {
  // expected-error @+1 {{'Position' needs a value for 'y'}}
  spawn { Position { x: 1.0 } }
}

// -----

component Position { x: f32 }
system s() {
  for p: Position {
    // expected-error @+1 {{component 'Position' has no field 'z'}}
    let z = p.z
  }
}

// -----

component Position { x: f32 }
system s(n: i32) {
  for p: mut Position {
    // expected-error @+1 {{operands have different types}}
    p.x = p.x + n
  }
}

// -----

component Position { x: f32 }
tag Enemy
system s() {
  // expected-error @+1 {{names component @Enemy in more than one binding or filter}}
  for p: Position with Enemy without Enemy {
  }
}

// -----

// expected-error @+1 {{'proc' is not supported yet}}
proc nearest() {
}

// -----

component Position { x: f32 }
system s() {
  for e, p: Position {
    // expected-error @+1 {{a 'for' cannot be nested in another 'for'}}
    for q: Position {
    }
  }
}

// -----

component Position { x: f32 }
system s() {
  for p: mut Position {
    // expected-error @+1 {{expected an assignment ('=', '+=', '-=', '*=', '/=', 'min=', 'max='), found '1.0'}}
    p.x 1.0
  }
}

// -----

component Position { x: f32 }
schedule frame() {
  // expected-error @+1 {{unknown system 'move'; declare systems before the schedules that run them}}
  move()
}

// -----

component Position { x: f32 }
// The ent dialect's verifier speaks for what the parser lets through,
// pointing into the source.
system s() reads Position {
  // expected-error @+1 {{'ent.query' op binds @Position mutably but system @s does not declare it in 'writes'}}
  for p: mut Position {
    p.x = 1.0
  }
}

// -----

component Position { x: f32 }
tag Enemy
system s() {
  for p: Position {
    // expected-error @+1 {{'has' tests the entity a 'for' visits; 'p' is not that entity}}
    let h = p.has(Enemy)
  }
}

// -----

component Position { x: f32 }
system s() {
  // expected-error @+1 {{unknown component 'Enemy'}}
  for p: Position with any(Position, Enemy) {
  }
}

// -----

component Position { x: f32 }
system s() {
  for p: Position {
  }
}
unique Count: i64
schedule f() {
  // expected-error @+1 {{a 'run_if' condition must be a bool}}
  s() run_if Count
}

// -----

component Position { x: f32 }
relation Synapse { weight: f32 } capacity 4
system s() {
  for p: Position {
    // expected-error @+1 {{edges are visited from the entity a 'for' visits; name it: 'for e, ...'}}
    for w, t in e.out(Synapse) {
    }
  }
}

// -----

component Position { x: f32 }
relation Synapse { weight: f32 } capacity 4
system s() {
  for e, p: Position {
    for w, t in e.out(Synapse) {
      // expected-error @+1 {{'w' is not 'mut': bind it as 'for mut w, ...' to write it}}
      w.weight = 1.0
    }
  }
}

// -----

component Position { x: f32 }
relation Synapse { weight: f32 } capacity 4
system s() {
  for e, p: Position {
    // expected-error @+1 {{'Synapse' needs a value for 'weight'}}
    connect(e, e, Synapse)
  }
}

// -----

component Position { x: f32 }
system s() {
  for e, p: Position {
    // expected-error @+1 {{unknown relation 'Synapse'}}
    for w, t in e.out(Synapse) {
    }
  }
}

// -----

component Position { x: f32 }
// expected-error @+1 {{unknown component 'Neuron'}}
relation Synapse { weight: f32 } from Position to Neuron capacity 4

// -----

// expected-error @+1 {{an extern system has no body; it is implemented outside the program}}
extern system draw() {
}

// -----

// expected-error @+1 {{expected 'system', found 'schedule'}}
extern schedule frame() {
}

// -----

system s() {
}
main {
  // expected-error @+1 {{unknown schedule 's'; 'main' runs schedules, declared before it}}
  s()
}

// -----

unique Clock { frame: i64 }
schedule frame() {
}
main {
  // expected-error @+1 {{an 'until' condition must be a bool}}
  loop { frame() } until Clock.frame
}

// -----

schedule frame() {
}
main {
  frame()
}
// expected-error @+1 {{a program has one 'main'}}
main {
}

// -----

world {
}
// expected-error @+1 {{a module has one 'world'}}
world {
}

// -----

component Position { x: f32 }
system s() {
  for p: Position {
    // expected-error @+1 {{a counted 'for' inside a 'for' over entities is not supported yet}}
    for i in 0..2 {
    }
  }
}

// -----

system s(n: f32) {
  // expected-error @+1 {{a 'for' counts over integers}}
  for i in 0..n {
  }
}

// -----

system s(a: i32, b: i64) {
  // expected-error @+1 {{the bounds of a 'for' must have the same integer type}}
  for i in a..b {
  }
}

// -----

// expected-note @+1 {{see existing symbol definition here}}
world {
}
// expected-error @+1 {{redefinition of symbol named 'world_init'}}
schedule world_init() {
}

// -----

// expected-error @+1 {{expected '[' and the text's capacity, found '}'}}
component Label { name: text }

// -----

// expected-error @+1 {{a text holds 1 to 4094 bytes}}
component Label { name: text[5000] }

// -----

unique Title: text[4]
system s() {
  // expected-error @+1 {{this text has 5 bytes, but it is put into a text[4]}}
  Title = "fleet"
}

// -----

unique Title: text[8]
system s(n: i32) {
  // expected-error @+1 {{a text is joined with and compared to texts; a number is put into one with "{value}"}}
  Title = Title + n
}

// -----

unique Title: text[8]
unique Ordered: bool
system s() {
  // expected-error @+1 {{texts can be joined ('+') and compared with '==' and '!='}}
  Ordered = Title < "b"
}

// -----

unique Title: text[8]
system s() {
  // expected-error @+1 {{a text can be assigned ('=') or added to ('+=')}}
  Title -= "b"
}

// -----

unique Title: text[8]
system s() {
  // expected-error @+1 {{unknown escape '\q'; there are \n \t \r \0 \\ \" \' \{ \} and \xHH}}
  Title = "a\q"
}

// -----

unique Title: text[8]
system s() {
  // expected-error @+1 {{'{' starts a value that '}' ends; write '\{' for the character}}
  Title = "a{"
}

// -----

unique Title: text[8]
system s() {
  // expected-error @+1 {{this literal is not closed on its line}}
  Title = "abc
}

// -----

unique Count: i32
system s(n: i32) {
  // expected-error @+1 {{only a text can be indexed}}
  Count = n[0]
}

// -----

unique Byte: i8
system s() {
  // expected-error @+1 {{a character literal holds one byte; text is written in double quotes}}
  Byte = 'ab'
}

// -----

unique Title: text[8]
system s(e: entity) {
  // expected-error @+1 {{this value has no text form; numbers, bools and texts do}}
  Title = "{e}"
}

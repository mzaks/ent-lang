// RUN: ent-translate --import-ent %s -split-input-file -verify-diagnostics

system s() {
  // expected-error @+1 {{unknown component 'Position'}}
  for p: Position {
  }
}

// -----

component Position { x: f32 }
system s() {
  for p: Position {
    // expected-error @+1 {{'p' is not 'mut': bind it as 'p: mut Position' to write it}}
    p.x = 1.0
  }
}

// -----

component Position { x: f32 }
system s() {
  for p: mut Position {
    let a = 1.0
    // expected-error @+1 {{'a' is a value and cannot be assigned: declare it with 'var' instead of 'let'}}
    a = 2.0
  }
}

// -----

component Position { x: f32 }
unique Clock { frame: i64 }
system s() {
  for p: Position {
    // expected-error @+1 {{inside a 'for', a unique can only be accumulated into ('+=', '-=', 'min=', 'max='): every entity would write the same field}}
    Clock.frame = 1
  }
}

// -----

component Hull { hp: f32 }
component Target { who: entity }
system s() {
  for t: Target {
    // expected-error @+1 {{another entity's field can only be combined into ('+=', '-=', 'min=', 'max='): which write lands last would depend on the order}}
    Hull(t.who).hp = 0.0
  }
}

// -----

component Hull { hp: f32 }
component Target { who: entity }
system s() {
  for t: Target {
    // expected-error @+1 {{reading another entity's field may find nothing: use 'if let value = Hull(entity).field { ... }'}}
    let hp = Hull(t.who).hp
  }
}

// -----

component Position { x: f32, y: f32 }
system s() {
  // expected-error @+1 {{'Position' needs a value for 'y'}}
  spawn { Position { x: 1.0 } }
}

// -----

component Position { x: f32 }
system s() {
  for p: Position {
    // expected-error @+1 {{component 'Position' has no field 'z'}}
    let z = p.z
  }
}

// -----

component Position { x: f32 }
system s(n: i32) {
  for p: mut Position {
    // expected-error @+1 {{operands have different types}}
    p.x = p.x + n
  }
}

// -----

component Position { x: f32 }
tag Enemy
system s() {
  // expected-error @+1 {{names component @Enemy in more than one binding or filter}}
  for p: Position with Enemy without Enemy {
  }
}

// -----

// expected-error @+1 {{'proc' with a body is not supported yet; 'extern proc' declares one implemented in C}}
proc nearest() {
}

// -----

// expected-error @+1 {{an extern fn gives a value back ('-> type'); one that only acts is an 'extern proc'}}
extern fn beep()

// -----

// expected-error @+1 {{C cannot give a text back yet}}
extern proc name() -> text[8]

// -----

// expected-error @+1 {{an extern proc has no body; it is implemented in C}}
extern proc beep() {
}

// -----

extern proc put(value: i32)
system s() {
  // expected-error @+1 {{'put' takes 1 argument(s), not 2}}
  put(1, 2)
}

// -----

extern proc put(value: i32)
system s() {
  // expected-error @+1 {{'put' gives no value}}
  let x = put(1)
}

// -----

extern fn twice(value: i32) -> i32
system s() {
  // expected-error @+1 {{'twice' is a fn: it only gives a value, so calling it for nothing does nothing}}
  twice(1)
}

// -----

extern fn twice(value: i32) -> i32
system s() {
  // expected-error @+1 {{argument has a different type than the parameter}}
  let x = twice(1.5 as f32)
}

// -----

unique Exit: bool
extern proc done() -> bool
system s() {
}
schedule frame() {
  s()
}
main {
  // expected-error @+1 {{'done' can only be called in a system; conditions and 'main' read uniques a system has written}}
  loop { frame() } until done()
}

// -----

system s() {
  // expected-error @+1 {{unknown function 'nearest'; declare it before with 'fn', or one implemented in C with 'extern fn' or 'extern proc' (min, max and len are built in)}}
  let x = nearest(1)
}

// -----

component Position { x: f32 }
system s() {
  for e, p: Position {
    // expected-error @+1 {{a 'for' cannot be nested in another 'for'}}
    for q: Position {
    }
  }
}

// -----

component Position { x: f32 }
system s() {
  for p: mut Position {
    // expected-error @+1 {{expected an assignment ('=', '+=', '-=', '*=', '/=', 'min=', 'max='), found '1.0'}}
    p.x 1.0
  }
}

// -----

component Position { x: f32 }
schedule frame() {
  // expected-error @+1 {{unknown system 'move'; declare systems before the schedules that run them}}
  move()
}

// -----

component Position { x: f32 }
// The ent dialect's verifier speaks for what the parser lets through,
// pointing into the source.
system s() reads Position {
  // expected-error @+1 {{'ent.query' op binds @Position mutably but system @s does not declare it in 'writes'}}
  for p: mut Position {
    p.x = 1.0
  }
}

// -----

component Position { x: f32 }
tag Enemy
system s() {
  for p: Position {
    // expected-error @+1 {{'has' tests the entity a 'for' visits; 'p' is not that entity}}
    let h = p.has(Enemy)
  }
}

// -----

component Position { x: f32 }
system s() {
  // expected-error @+1 {{unknown component 'Enemy'}}
  for p: Position with any(Position, Enemy) {
  }
}

// -----

component Position { x: f32 }
system s() {
  for p: Position {
  }
}
unique Count: i64
schedule f() {
  // expected-error @+1 {{a 'run_if' condition must be a bool}}
  s() run_if Count
}

// -----

component Position { x: f32 }
relation Synapse { weight: f32 } capacity 4
system s() {
  for p: Position {
    // expected-error @+1 {{one end of the arrow is the entity the 'for' visits, by one of its names ('p'), and the other is the entity at the other end}}
    for (e)-[w: Synapse]->(t) {
    }
  }
}

// -----

component Position { x: f32 }
relation Synapse { weight: f32 } capacity 4
system s() {
  for e, p: Position {
    for (e)-[w: Synapse]->(t) {
      // expected-error @+1 {{'w' is not 'mut': bind it as '[mut w: Synapse]' to write it}}
      w.weight = 1.0
    }
  }
}

// -----

component Position { x: f32 }
relation Synapse { weight: f32 } capacity 4
system s() {
  for e, p: Position {
    // expected-error @+1 {{'Synapse' needs a value for 'weight'}}
    connect (e)-[Synapse]->(e)
  }
}

// -----

component Position { x: f32 }
system s() {
  for e, p: Position {
    // expected-error @+1 {{unknown relation 'Synapse'}}
    for (e)-[w: Synapse]->(t) {
    }
  }
}

// -----

component Position { x: f32 }
// expected-error @+1 {{unknown component 'Neuron'}}
relation (Position)-[Synapse { weight: f32 }]->(Neuron) capacity 4

// -----

// expected-error @+1 {{an extern system has no body; it is implemented outside the program}}
extern system draw() {
}

// -----

// expected-error @+1 {{expected 'fn', 'proc' or 'system' after 'extern', found 'schedule'}}
extern schedule frame() {
}

// -----

system s() {
}
main {
  // expected-error @+1 {{unknown schedule 's'; 'main' runs schedules, declared before it}}
  s()
}

// -----

unique Clock { frame: i64 }
schedule frame() {
}
main {
  // expected-error @+1 {{an 'until' condition must be a bool}}
  loop { frame() } until Clock.frame
}

// -----

schedule frame() {
}
main {
  frame()
}
// expected-error @+1 {{a program has one 'main'}}
main {
}

// -----

world {
}
// expected-error @+1 {{a module has one 'world'}}
world {
}

// -----

component Position { x: f32 }
system s() {
  for p: Position {
    // expected-error @+1 {{a counted 'for' inside a 'for' over entities is not supported yet}}
    for i in 0..2 {
    }
  }
}

// -----

system s(n: f32) {
  // expected-error @+1 {{a 'for' counts over integers}}
  for i in 0..n {
  }
}

// -----

system s(a: i32, b: i64) {
  // expected-error @+1 {{the bounds of a 'for' must have the same integer type}}
  for i in a..b {
  }
}

// -----

// expected-note @+1 {{see existing symbol definition here}}
world {
}
// expected-error @+1 {{redefinition of symbol named 'world_init'}}
schedule world_init() {
}

// -----

// expected-error @+1 {{expected '[' and the text's capacity, found '}'}}
component Label { name: text }

// -----

// expected-error @+1 {{a text holds 1 to 4094 bytes}}
component Label { name: text[5000] }

// -----

unique Title: text[4]
system s() {
  // expected-error @+1 {{this text has 5 bytes, but it is put into a text[4]}}
  Title = "fleet"
}

// -----

unique Title: text[8]
system s(n: i32) {
  // expected-error @+1 {{a text is joined with and compared to texts; a number is put into one with "{value}"}}
  Title = Title + n
}

// -----

unique Title: text[8]
unique Ordered: bool
system s() {
  // expected-error @+1 {{texts can be joined ('+') and compared with '==' and '!='}}
  Ordered = Title < "b"
}

// -----

unique Title: text[8]
system s() {
  // expected-error @+1 {{a text can be assigned ('=') or added to ('+=')}}
  Title -= "b"
}

// -----

unique Title: text[8]
system s() {
  // expected-error @+1 {{unknown escape '\q'; there are \n \t \r \0 \\ \" \' \{ \} and \xHH}}
  Title = "a\q"
}

// -----

unique Title: text[8]
system s() {
  // expected-error @+1 {{'{' starts a value that '}' ends; write '\{' for the character}}
  Title = "a{"
}

// -----

unique Title: text[8]
system s() {
  // expected-error @+1 {{this literal is not closed on its line}}
  Title = "abc
}

// -----

unique Count: i32
system s(n: i32) {
  // expected-error @+1 {{only a text can be indexed}}
  Count = n[0]
}

// -----

unique Byte: i8
system s() {
  // expected-error @+1 {{a character literal holds one byte; text is written in double quotes}}
  Byte = 'ab'
}

// -----

unique Title: text[8]
system s(e: entity) {
  // expected-error @+1 {{this value has no text form; numbers, bools and texts do}}
  Title = "{e}"
}

// -----

unique Bits { byte: i8, ratio: f32, all: i64 }
system s() {
  // expected-error @+1 {{this hex literal has more than the 8 bits of its type}}
  Bits.byte = 0x100
}

// -----

unique Bits { ratio: f32 }
system s() {
  // expected-error @+1 {{a hex literal is the bits of an integer; it cannot be a float}}
  Bits.ratio = 0x10
}

// -----

unique Bits { all: i64 }
system s() {
  // expected-error @+1 {{a hex literal has at most 16 digits (64 bits)}}
  Bits.all = 0x10000000000000000
}

// -----

// expected-error @+1 {{a fn gives a value back ('-> type')}}
fn nothing(x: i32) {
}

// -----

// expected-error @+1 {{a fn has a body ('{ value }'); 'extern fn' declares one implemented in C}}
fn twice(x: i32) -> i32
system s() {
}

// -----

unique Scale: i32
fn scaled(x: i32) -> i32 {
  // expected-error @+1 {{a fn computes from its parameters only; pass it what it needs of unique 'Scale'}}
  x * Scale
}

// -----

unique Clock { frame: i32 }
fn later(x: i32) -> i32 {
  // expected-error @+1 {{a fn computes from its parameters only; pass it what it needs of unique 'Clock'}}
  x + Clock.frame
}

// -----

extern proc seconds() -> f64
fn doubled() -> f64 {
  // expected-error @+1 {{'seconds' is a proc: it acts, and a fn only computes}}
  seconds() * 2.0
}

// -----

component Position { x: f32 }
fn make(x: f32) -> entity {
  // expected-error @+1 {{a fn only computes; a system spawns}}
  spawn { Position { x: x } }
}

// -----

fn ratio(a: i32, b: i32) -> f32 {
  // expected-error @+1 {{the fn's value has a different type than it gives back}}
  a / b
}

// -----

fn first(x: i32) -> i32 {
  // expected-error @+1 {{unknown function 'second'; declare it before with 'fn', or one implemented in C with 'extern fn' or 'extern proc' (min, max and len are built in)}}
  second(x)
}
fn second(x: i32) -> i32 { x }

// -----

// expected-error @+1 {{'max' is built in}}
fn max(a: i32, b: i32) -> i32 { a }

// -----

fn square(x: i32) -> i32 { x * x }
system s() {
  // expected-error @+1 {{'square' is a fn: it only gives a value, so calling it for nothing does nothing}}
  square(2)
}

// -----

unique Exit: bool
fn over(frame: i32) -> bool { frame > 3 }
system s() {
}
schedule frame() {
  // expected-error @+1 {{'over' can only be called in a system; conditions and 'main' read uniques a system has written}}
  s() run_if over(1)
}

// -----

fn sign(x: i32) -> i32 {
  // expected-error @+2 {{expected 'else', found '}'}}
  if x > 0 { 1 } else if x < 0 { -1 }
}

// -----

component Position { x: f32 }
system s() {
  var sum = 0.0
  for p: Position {
    // expected-error @+1 {{'sum' is a var from outside the 'for': every entity would assign it. Accumulate into a unique ('+=', '-=', 'min=', 'max=') instead}}
    sum += p.x
  }
}

// -----

component Node { v: i32 }
relation Link { w: i32 } capacity 8
system s() {
  for e, n: mut Node {
    var sum = 0
    for (e)-[l: Link]->(other) {
      // expected-error @+1 {{assigning a var from outside an edge loop is not supported yet}}
      sum += l.w
    }
    n.v = sum
  }
}

// -----

system s() {
  var n = 0
  // expected-error @+1 {{value has a different type than the target}}
  n = 1.5 as f32
}

// -----

system s() {
  // expected-error @+1 {{value has a different type than the var}}
  var n: i64 = 1.5 as f32
}

// -----

system s() {
  // expected-error @+2 {{expected '=': a var starts with a value, found '}'}}
  var n: i64
}

// -----

system s() {
  if true {
    var n = 0
  }
  // expected-error @+1 {{unknown name 'n'}}
  n = 1
}

// -----

fn pick(c: bool) -> i32 {
  // expected-error @+1 {{'var' is not supported here yet: a branch of an 'if' that gives a value is made of 'let's}}
  if c { var x = 1  x } else { 2 }
}

// -----

fn count(n: i32) -> i32 {
  var total = 0
  for i in 0..n { total += i }
  // expected-error @+1 {{a fn's body ends with the value it gives}}
}

// -----

// The last `if` is the value, so it gives one either way.
fn pick(c: bool) -> i32 {
  var x = 1
  // expected-error @+2 {{expected 'else', found '}'}}
  if c { x }
}

// -----

fn pick(c: bool) -> i32 {
  // expected-error @+2 {{expected '}' after the fn's value, found 'x'}}
  let x = 1
  x x
}

// -----

component Position { x: f32 }
fn sum() -> f32 {
  // expected-error @+1 {{a fn only computes: it counts ('for i in a..b'), and a system visits entities}}
  for p: Position {
  }
  0.0
}

// -----

unique Score: i32
fn bump(by: i32) -> i32 {
  // expected-error @+1 {{a fn only computes; it cannot write unique 'Score'. Give the value back and let a system write it}}
  if by > 0 { Score = by }
  by
}

// -----

component Hull { hp: i32 }
fn hp(of: entity) -> i32 {
  var found = 0
  // expected-error @+1 {{a fn only computes; 'if let' reads another entity's field, which a system does}}
  if let hp = Hull(of).hp { found = hp }
  found
}

// -----

extern proc beep()
fn loud(n: i32) -> i32 {
  // expected-error @+1 {{'beep' is a proc: it acts, and a fn only computes}}
  if n > 0 { beep() }
  n
}

// -----

fn fixed(n: i32) -> i32 {
  let m = n
  // expected-error @+1 {{'m' is a value and cannot be assigned: declare it with 'var' instead of 'let'}}
  m = 2
  m
}

// -----

fn pair(x: i32) -> (i32, i32) { (x, x) }
system s() {
  // expected-error @+1 {{'pair' gives 2 values; take them with 'let (a, b) = pair(...)'}}
  let p = pair(1)
}

// -----

fn pair(x: i32) -> (i32, i32) { (x, x) }
system s() {
  // expected-error @+1 {{expected 3 values, found 2}}
  let (a, b, c) = pair(1)
}

// -----

fn one(x: i32) -> i32 { x }
system s() {
  // expected-error @+1 {{expected 2 values: '(a, b)', or a fn that gives them}}
  let (a, b) = one(1)
}

// -----

fn pair(x: i32) -> (i32, f32) {
  // expected-error @+1 {{value #2 has a different type than expected}}
  (x, x)
}

// -----

fn pair(x: i32) -> (i32, i32) {
  // expected-error @+1 {{expected 2 values, found 3}}
  (x, x, x)
}

// -----

fn pair(x: i32) -> (i32, i32) {
  // expected-error @+1 {{expected 2 values: '(a, b)', or a fn that gives them}}
  x
}

// -----

system s() {
  // expected-error @+1 {{'(a, b)' is several values, which a fn gives back and 'let (a, b) = ...' takes apart; one value is expected here}}
  let p = (1, 2)
}

// -----

// expected-error @+1 {{C gives one value back; a fn with a body may give several}}
extern fn pair(x: i32) -> (i32, i32)

// -----

// expected-error @+1 {{one value is written without parentheses}}
fn one(x: i32) -> (i32) { x }

// -----

enum Way { Left, Right }
unique Facing: Way
system s() {
  // expected-error @+1 {{enum 'Way' has no case 'Up'}}
  Facing = Way.Up
}

// -----

enum Way { Left, Right }
enum Mode { Chase, Scatter }
unique Facing: Way
system s() {
  // expected-error @+1 {{value has a different type than the target}}
  Facing = Mode.Chase
}

// -----

enum Way { Left, Right }
unique Facing: Way
system s() {
  // expected-error @+1 {{an integer cannot be used here}}
  Facing = 1
}

// -----

enum Way { Left, Right }
unique Facing: Way
unique Ahead: bool
system s() {
  // expected-error @+1 {{enum values are compared with '==' and '!='; 'as i32' gives the number of a case}}
  Ahead = Facing < Way.Right
}

// -----

enum Way { Left, Right }
enum Mode { Chase, Scatter }
unique Facing: Way
unique Same: bool
system s() {
  // expected-error @+1 {{operands have different types}}
  Same = Facing == Mode.Chase
}

// -----

enum Way { Left, Right }
unique Facing: Way
unique Turn: f32
system s() {
  // expected-error @+1 {{an enum is cast to and from an integer, the number of its case}}
  Turn = Facing as f32
}

// -----

// expected-error @+1 {{enum 'Way' has the case 'Left' twice}}
enum Way { Left, Right, Left }

// -----

// expected-error @+1 {{an enum has at least one case}}
enum Nothing { }

// -----

// expected-error @+1 {{unknown type 'Way'; expected f32, f64, bool, i8, i16, i32, i64, index, entity, text[N] or an enum}}
component Ghost { way: Way }
enum Way { Left, Right }

// -----

component Body { x: f32 }
component Name { n: i32 }
default_capacity 8
system s() {
  // expected-error @+1 {{a component the entity may be without is only read: to change it, visit the entities that have it in a 'for' of their own}}
  for b: Body, optional n: mut Name {
  }
}

// -----

component Body { x: f32 }
component Name { n: i32 }
default_capacity 8
system s() {
  for b: mut Body, optional n: Name {
    // expected-error @+1 {{'n' is optional and may lead nowhere: read it with 'if let x = n.n { ... } else { ... }'}}
    b.x = n.n as f32
  }
}

// -----

component Body { x: f32 }
default_capacity 8
system s() {
  // expected-error @+4 {{a 'loop' ends with 'until' and what is to hold then: 'loop { ... } until done'}}
  loop {
    for b: mut Body { b.x += 1.0 }
  }
}

// -----

component Body { x: f32 }
default_capacity 8
system s() {
  for b: mut Body {
    // expected-error @+1 {{a 'loop' inside a 'for' over entities is not supported yet}}
    loop { b.x += 1.0 } until b.x > 3.0
  }
}

// -----

component Body { x: f32 }
default_capacity 8
system s(on: bool) {
  if on {
    // expected-error @+1 {{a 'for' over entities is at the top level of a system, or in a counted 'for' or a 'loop' there}}
    for b: mut Body { b.x += 1.0 }
  }
}

// -----

component Body { x: f32 }
default_capacity 8
system s() {
  for b: mut Body {
    // expected-error @+1 {{only a 'for' over entities gives a number, how many its body ran for: at the top level of a system, or in a loop there}}
    let n = for i in 0..3 { b.x += 1.0 }
  }
}

// -----

component Body { x: f32 }
default_capacity 8
fn count() -> i32 {
  // expected-error @+1 {{only a 'for' over entities gives a number, how many its body ran for: at the top level of a system, or in a loop there}}
  let n = for i in 0..3 { }
  n
}

// RUN: ent-translate --import-ent %s -I %S/../../devices -split-input-file -verify-diagnostics

// A var holds a text of any length, but not the one a 'mut' binding
// holds: that may be given another meanwhile.
import text
component Label { name: text }
system s() {
  for l: mut Label {
    // expected-error @+1 {{a var does not keep the text a unique or a 'mut' binding holds: that may be given another meanwhile. Keep a copy of a capacity ('as text[N]')}}
    var kept = l.name
  }
}

// -----

// Nor given it later; joined to it, it is (the join is a text of its own).
import text
component Label { name: text }
system s() {
  for l: mut Label {
    var kept = "<"
    kept += l.name
    kept = kept + l.name + ">"
    // expected-error @+1 {{a var does not keep the text a unique or a 'mut' binding holds: that may be given another meanwhile. Keep a copy of a capacity ('as text[N]')}}
    kept = l.name
  }
}

// -----

// Without the module `text`, a var of text says its capacity: a
// literal's own would cut what it is given later.
system s() {
  // expected-error @+1 {{a var of text says how many bytes it holds ('var line: text[N] = ...'), or 'import text' for one of any length}}
  var line = "a"
}

// -----

import text
component Label { name: text }
system s() {
  for l: mut Label {
    // expected-error @+1 {{a 'let' does not keep the text a unique or a 'mut' binding holds: that may be given another meanwhile. Keep a copy of a capacity ('as text[N]')}}
    let kept = l.name
    l.name = "another"
  }
}

// -----

import text
component Label { name: text }
tag Old
system s() {
  for e, l: Label {
    let kept = l.name
    // expected-error @+1 {{'kept' keeps a text of any length, and 'Label' has one that goes here: keep a copy of a capacity ('as text[N]')}}
    e.remove(Label)
  }
}

// -----

import text
component Label { name: text, n: i32 }
system s() {
  for l: mut Label {
    // expected-error @+1 {{texts can be joined ('+') and compared with '==' and '!='}}
    l.n = if l.name < "m" { 1 } else { 2 }
  }
}

// -----

import text
component Label { name: text }
system s() {
  for l: mut Label {
    // expected-error @+1 {{a text can be assigned ('=') or added to ('+=')}}
    l.name -= "more"
  }
}

// -----

// An edge's fields are plain values: a text in one has a capacity.
import text
// expected-error @+1 {{an edge does not hold a text of any length yet ('note'): give it a capacity ('text[N]')}}
relation Link { note: text } capacity 8

// -----

// A var's text to add to ('mut text') is given by the var's name.
import text
proc add(out: mut text) { out += "!" }
system s() {
  let fixed = "a"
  // expected-error @+1 {{'add' adds to the text of a var it is given here ('mut text'): name a 'var' of text}}
  add(fixed)
}

// -----

// Not the same var twice.
import text
proc both(a: mut text, b: mut text) { a += b }
system s() {
  var out = "a"
  // expected-error @+1 {{'out' is given twice to add to}}
  both(out, out)
}

// -----

// Of any length, and not to C.
import text
// expected-error @+1 {{a var's text is given to add to as one of any length ('mut text', with 'import text')}}
proc add(out: mut text[8]) { }

// -----

import text
// expected-error @+1 {{a var's text is given to add to ('mut text') to a fn or proc of the program, not to C}}
extern proc add(out: mut text)

// -----

// Not a var from outside a 'for' over entities.
import text
component Label { name: text }
proc add(out: mut text, t: text) { out += t }
system s() {
  var all = ""
  for l: Label {
    // expected-error @+1 {{'all' is a var from outside the 'for': every entity would add to it}}
    add(all, l.name)
  }
}

// -----

// Not through a value of a proc.
import text
component Doer { act: proc(i32) }
proc add(out: mut text) { out += "!" }
system s() {
  // expected-error @+1 {{'add' adds to a var's text it is given ('mut text'), which a call through a proc value cannot give it}}
  spawn { Doer { act: add } }
}

// RUN: ent-translate --import-ent %s -I %S/../../devices -split-input-file -verify-diagnostics

// A text of any length is held by a field, and seen where it is used: a
// var does not hold one.
import text
component Label { name: text }
system s() {
  for l: Label {
    // expected-error @+1 {{a var does not hold a text of any length; one of a capacity it does ('as text[N]')}}
    var kept = l.name
  }
}

// -----

import text
component Label { name: text }
system s() {
  for l: mut Label {
    // expected-error @+1 {{a 'let' does not keep the text a unique or a 'mut' binding holds: that may be given another meanwhile. Keep a copy of a capacity ('as text[N]')}}
    let kept = l.name
    l.name = "another"
  }
}

// -----

import text
component Label { name: text }
tag Old
system s() {
  for e, l: Label {
    let kept = l.name
    // expected-error @+1 {{'kept' keeps a text of any length, and 'Label' has one that goes here: keep a copy of a capacity ('as text[N]')}}
    e.remove(Label)
  }
}

// -----

import text
// expected-error @+1 {{a text of a capacity is not given back as a 'text': it is this fn's own, and gone when the fn has run; give back a 'text[N]'}}
fn name(i: i32) -> text { "number {i}" }

// -----

import text
component Label { name: text }
system s() {
  for l: mut Label {
    // expected-error @+1 {{a text of any length can only be assigned ('=')}}
    l.name += "more"
  }
}

// -----

import text
component Label { name: text, both: text[62] }
system s() {
  for l: mut Label {
    // expected-error @+1 {{a text of any length can be compared with '==' and '!='; to join it, cut it to a capacity first ('as text[N]')}}
    l.both = l.name + "more"
  }
}

// -----

import text
component Label { name: text, both: text[62] }
system s() {
  for l: mut Label {
    // expected-error @+1 {{a text of any length is not put into another text; cut it to a capacity first ('as text[N]')}}
    l.both = "is {l.name}"
  }
}

// RUN: ent-translate --import-ent %s | FileCheck %s
// The importer's output is valid ent IR that prints and parses again.
// RUN: ent-translate --import-ent %s | ent-opt | FileCheck %s

component Body { x: f32 }
component Orbit { distance: f32 }
component Tint { color: i32 }
default_capacity 8

// CHECK: ent.relation @Orbits () from @Orbit to @Body tree capacity 8
// CHECK: ent.relation @Owns (share: f32) tree capacity 4
relation (Orbit)-[Orbits]->(Body) tree capacity 8
relation Owns { share: f32 } tree capacity 4

// `up` after a binding's component: the nearest ancestor's that has it.
// `cascade`, after the filters: parents before their children.
// CHECK-LABEL: ent.system @place() {
// CHECK:   ent.query (%[[B:.*]]: !ent.ref<@Body, mut>, %[[O:.*]]: !ent.ref<@Orbit>, %[[C:.*]]: !ent.ref<@Body, parent @Orbits>) cascade @Orbits {
// CHECK:     %[[X:.*]] = ent.get %[[C]] "x" : <@Body, parent @Orbits> -> f32
// CHECK:     ent.set %[[B]] "x", %{{.*}} : <@Body, mut>, f32
system place() {
  for (b: mut Body, o: Orbit)-[Orbits]->(center: Body) top down Orbits {
    b.x = center.x + o.distance
  }
}

// An ancestor's component may be one the entity is filtered not to have.
// CHECK-LABEL: ent.system @inherit() {
// CHECK:   ent.query (%{{.*}}: !ent.ref<@Body>, %{{.*}}: !ent.ref<@Tint, up @Orbits>) without [@Tint] {
// CHECK:   ent.query (%{{.*}}: !ent.ref<@Body>) with [@Orbit] cascade @Owns {
// CHECK:     scf.if
system inherit() {
  for (b: Body)-[Orbits*]->(t: Tint) without Tint {
    let color = t.color
  }
  for b: Body with Orbit top down Owns where b.x > 0.0 {
    let x = b.x
  }
}

// `up` is a word only there: a field or a name may be called so.
// CHECK: ent.resource @Keys (up: i1)
unique Keys { up: bool }
system keys() {
  let up = Keys.up
}

// Children before their parents; `+=` through a `mut` binding up the tree
// combines into the ancestor.
// CHECK-LABEL: ent.system @gather() {
// CHECK:   ent.query (%[[N:.*]]: !ent.ref<@Body>, %[[D:.*]]: !ent.ref<@Body, mut, parent @Orbits>) cascade @Orbits leaves first {
// CHECK:     ent.combine %[[D]] "x" add %{{.*}} : <@Body, mut, parent @Orbits>, f32
// CHECK:     %[[NEG:.*]] = arith.subf %{{.*}}, %{{.*}} : f32
// CHECK:     ent.combine %[[D]] "x" add %[[NEG]] : <@Body, mut, parent @Orbits>, f32
system gather() {
  for (b: Body)-[Orbits]->(down: mut Body) bottom up Orbits {
    down.x += b.x
    down.x -= 1.0
  }
}
// CHECK-LABEL: ent.system @highest() {
// CHECK:     ent.combine %{{.*}} "x" max %{{.*}} : <@Body, mut, parent @Orbits>, f32
system highest() {
  for (b: Body)-[Orbits]->(down: mut Body) top down Orbits {
    down.x max= b.x
  }
}

// Reactive: where the entity's own events fired, or the ancestor's.
// CHECK-LABEL: ent.system @settle() {
// CHECK:   ent.query (%{{.*}}: !ent.ref<@Body, mut>, %{{.*}}: !ent.ref<@Orbit>, %{{.*}}: !ent.ref<@Body, parent @Orbits>) cascade @Orbits on [changed @Orbit, changed @Body "x" up @Orbits] {
system settle() {
  for (b: mut Body, o: Orbit)-[Orbits]->(center: Body) top down Orbits
      on changed Orbit, changed center.x {
    b.x = center.x + o.distance
  }
}

// A tree whose children are in an order; the sibling before; a binding
// that may lead nowhere, read with `if let`.
// CHECK: ent.relation @Row () from @Leaf2 to @Leaf2 tree ordered by @Leaf2 "at" capacity 8
// CHECK-LABEL: ent.system @line() {
// CHECK:   ent.query (%{{.*}}: !ent.ref<@Leaf2, mut>, %[[U:.*]]: !ent.ref<@Leaf2, parent @Row>, %[[P:.*]]: !ent.ref<@Leaf2, before @Row, optional>) cascade @Row {
// CHECK:     %[[THERE:.*]] = ent.bound %[[P]] : <@Leaf2, before @Row, optional>
// CHECK:     %[[V:.*]] = ent.get %[[P]] "v" : <@Leaf2, before @Row, optional> -> f32
// CHECK:     %[[THERE2:.*]] = ent.bound %[[P]]
// CHECK:     %[[BOTH:.*]] = arith.andi %[[THERE]], %[[THERE2]]
// CHECK:     scf.if %[[BOTH]] {
component Leaf2 { v: f32, at: i32 }
relation (Leaf2)-[Row]->(Leaf2) tree ordered by Leaf2.at capacity 8
system line() {
  for (l: mut Leaf2)-[Row]->(above: Leaf2),
      optional (prev: Leaf2)~[Row]~>(l)
      top down Row {
    if let v = prev.v, let at = prev.at {
      l.v = v + 1.0
    } else {
      l.v = above.v
    }
  }
}

// A tree whose entities are stored in its order.
// CHECK: ent.relation @Under () from @Leaf to @Leaf tree sorted capacity 8
component Leaf { v: f32 }
relation (Leaf)-[Under]->(Leaf) tree sorted capacity 8

// RUN: ent-translate --import-ent %s -split-input-file -verify-diagnostics

unique Bits { flags: i32, angle: u32, shade: u8 }
system s() {
  // expected-error @+1 {{one of these has a sign and the other has none: say which it is to be, with 'as'}}
  Bits.angle = Bits.angle + Bits.flags
}

// -----

unique Bits { flags: i32, angle: u32 }
system s() {
  // expected-error @+1 {{value has a different type than the target: it is an i32, and the target holds a u32}}
  Bits.angle = Bits.flags
}

// -----

unique Bits { shade: u8 }
system s() {
  // expected-error @+1 {{this number is more than a u8 holds}}
  Bits.shade = 256
}

// -----

// expected-error @+1 {{this number is more than a u8 holds}}
table shades: u8 = [1, 300]

// -----

// expected-error @+1 {{a u16 is not less than nought}}
table steps: u16 = [1, -3]

// -----

unique Level: f32
system s() {
  // expected-error @+1 {{'&' is of whole numbers: a float has no bits to say}}
  Level = Level & 3.0
}

// -----

unique Level: f32
system s() {
  // expected-error @+1 {{'<<' and '>>' shift the bits of a whole number}}
  Level = Level << 2
}

// -----

unique Bits: i32
unique Level: f32
system s() {
  // expected-error @+1 {{a shift is by a whole number of bits}}
  Bits = Bits >> Level
}

// -----

unique Level: f32
system s() {
  // expected-error @+1 {{'~' turns over the bits of a whole number}}
  Level = ~Level
}

// -----

component Box { n: u32 } capacity 4
component Slot { at: u32 } capacity 4
// expected-error @+1 {{the children are ordered by an integer, and 'Slot.at' is not one}}
relation (Box)-[Inside]->(Box) tree ordered by Slot.at capacity 4

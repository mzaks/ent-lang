// RUN: ent-translate --import-ent %s -split-input-file -verify-diagnostics

component Body { x: f32 }
relation (Body)-[Near]->(Body) capacity 8
system s() {
  // expected-error @+1 {{an arrow in the head of a 'for' follows a tree, and 'Near' is not declared one ('relation ... tree capacity N')}}
  for (b: Body)-[Near]->(p: Body) {
  }
}

// -----

component Body { x: f32 }
relation (Body)-[Near]->(Body) capacity 8
system s() {
  // expected-error @+1 {{'top down' follows a tree, and 'Near' is not declared one}}
  for b: Body top down Near {
  }
}

// -----

component Body { x: f32 }
system s() {
  // expected-error @+1 {{unknown relation 'Orbits'}}
  for (b: Body)-[Orbits]->(p: Body) {
  }
}

// -----

// The words that arrows took the place of say where to look.
component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
system s() {
  // expected-error @+1 {{another entity's component is bound with an arrow: 'for (b: Box)-[Relation]->(outer: Box)' for the parent's, '-[Relation*]->' for the nearest ancestor's that has it, '(prev: Box)~[Relation]~>(b)' for the sibling before's}}
  for b: Body, p: Body up Orbits {
  }
}

// -----

component Body { x: f32 }
// expected-error @+1 {{what a relation's ends have is said with an arrow: 'relation (Source)-[Orbits]->(Target) ...'}}
relation Orbits from Body to Body tree capacity 8

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
world {
  let a = spawn { Body { x: 0.0 } }
  // expected-error @+1 {{an edge is connected with an arrow: 'connect (source)-[Relation]->(target)'}}
  connect(a, a, Orbits)
}

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  for (b: Body)-[Orbits]->(p: mut Body) top down Orbits {
    // expected-error @+1 {{an ancestor's field can only be combined into ('+=', '-=', 'min=', 'max='): which write lands last would depend on the order}}
    p.x = b.x
  }
}

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  for (b: Body)-[Orbits]->(p: mut Body) {
    // expected-error @+1 {{combines into an ancestor up @Orbits in a query that does not cascade along it, which is not supported yet}}
    p.x += b.x
  }
}

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
system s() {
  // expected-error @+1 {{the order along a tree is 'top down Relation' (parents first) or 'bottom up Relation' (children first), with 'bfs' or 'dfs' before the relation where the order is to be exactly that}}
  for b: Body cascade Orbits {
  }
}

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  for (b: mut Body)-[Orbits]->(p: Body) top down Orbits {
    // expected-error @+1 {{'p' is an ancestor's 'Body' and not 'mut': bind it as '(p: mut Body)' to combine into it}}
    p.x = 1.0
  }
}

// -----

// Without the order, a body would read its parent's place before or after
// the parent moved.
component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{reads @Body "x" of an ancestor up @Orbits and changes it; which entities see the old value would depend on iteration order ('cascade @Orbits' visits ancestors first)}}
  for (b: mut Body)-[Orbits]->(p: Body) {
    // expected-note @+1 {{changed here}}
    b.x = p.x + 1.0
  }
}

// -----

// An arrow to the visited entity comes from its children.
component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{an arrow to the entity a 'for' visits comes from its children, of which there are many: they are visited in a loop in the body, 'for (child: C)-[Orbits]->(name) { ... }'}}
  for (b: Body)<-[Orbits]-(child: Body) {
  }
}

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{only 'changed' can be asked of another entity}}
  for (b: Body)-[Orbits]->(p: Body) top down Orbits on added p {
  }
}

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{another entity's event is asked by its binding ('changed outer.x'), a child's by a pattern ('changed (: C.f)-[R]->(name)')}}
  for (b: Body)-[Orbits]->(p: Body) top down Orbits on changed Body up Orbits {
  }
}

// -----

// What a depth adds up must not be seen by the same depth.
component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
unique Total: f32
system s() {
  for b: mut Body top down Orbits {
    // expected-note @+1 {{read or set here}}
    b.x = Total
    // expected-error @+1 {{in a cascading query combines into a field the query also reads or sets; what an entity sees of it would depend on the order within its depth}}
    Total += 1.0
  }
}

// -----

component Body { x: f32 }
// expected-error @+1 {{only a tree gives its entities an order: 'relation Near ... tree sorted capacity N'}}
relation (Body)-[Near]->(Body) sorted capacity 8

// -----

component Body { x: f32 }
// expected-error @+1 {{a sorted tree says what its ends have, so that the archetypes it sorts are known: 'relation (C)-[Orbits]->(D) tree sorted capacity N'}}
relation ()-[Orbits]->(Body) tree sorted capacity 8

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{the entities of 'Orbits' are in no order: 'relation ... tree ordered by C.f capacity N'}}
  for (b: Body), (p: Body)~[Orbits]~>(b) {
  }
}

// -----

component Body { x: f32, at: i32 }
relation (Body)-[Orbits]->(Body) tree ordered by Body.at capacity 8
default_capacity 8
system s() {
  for (b: mut Body), optional (p: Body)~[Orbits]~>(b) top down Orbits {
    // expected-error @+1 {{'p' is optional and may lead nowhere: read it with 'if let x = p.x { ... } else { ... }'}}
    b.x = p.x
  }
}

// -----

component Body { x: f32 }
default_capacity 8
system s() {
  // expected-error @+1 {{the entity a 'for' visits is there: only a pattern to another entity can be optional}}
  for optional (b: Body) {
  }
}

// -----

// What is read of a sibling that is yet to be visited is as the `for`
// found it: not what the `for` writes.
component Body { x: f32, at: i32 }
relation (Body)-[Orbits]->(Body) tree ordered by Body.at capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{reads @Body "x" of the sibling after in @Orbits and changes it; which entities see the old value would depend on iteration order}}
  for (b: mut Body)~[Orbits]~>(next: Body) top down Orbits {
    // expected-note @+1 {{changed here}}
    b.x = next.x
  }
}

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{arrows go on from the visited entity, up or to a sibling: '(name)-[R]->(mid: C)-[R]->(far: C)', '(name)-[R]->(mid: C)~[R]~>(next: C)'}}
  for (b: Body), (p: Body)<-[Orbits]-(b)-[Orbits]->(g: Body) {
  }
}

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{'*' leads to the nearest ancestor that has what its node binds, and this one binds nothing}}
  for (b: Body)-[Orbits*]->()-[Orbits]->(g: Body) {
  }
}

// -----

component Body { x: f32 }
relation ()-[Orbits]->() tree capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{'Orbits' does not say what the entity at this end has; bind a component of it to reach it by: '(p, c: C)'}}
  for (b: Body)-[Orbits]->(p) {
  }
}

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  for b: Body {
    for (child: Body)-[Orbits]->(b) {
      // expected-error @+1 {{'child' is not 'mut': bind it as '(child: mut Body)' to send a value to it}}
      child.x += 1.0
    }
  }
}

// -----

component Body { x: f32 }
default_capacity 8
// expected-error @+1 {{the children are ordered by an integer, and 'Body.x' is not one}}
relation (Body)-[Orbits]->(Body) tree ordered by Body.x capacity 8

// -----

component Body { x: f32 }
relation (Body)-[Orbits]->(Body) tree capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{the entities of 'Orbits' are in no order: 'relation ... tree ordered by C.f capacity N'}}
  for (b: Body)-[Orbits]->()~[Orbits]~>(aunt: Body) {
  }
}

// -----

// What is read of a sibling on the way may be of one yet to be visited.
component Body { x: f32, at: i32 }
relation (Body)-[Orbits]->(Body) tree ordered by Body.at capacity 8
default_capacity 8
system s() {
  // expected-error @+1 {{reads @Body "x"}}
  for (b: mut Body)-[Orbits]->()~[Orbits]~>(aunt: Body) top down Orbits {
    // expected-note @+1 {{changed here}}
    b.x = aunt.x
  }
}

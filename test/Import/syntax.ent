// RUN: ent-translate --import-ent %s | FileCheck %s
// The importer's output is valid ent IR that prints and parses again.
// RUN: ent-translate --import-ent %s | ent-opt | FileCheck %s

default_capacity 128

// CHECK: module attributes {ent.default_capacity = 128 : i64}
// CHECK: ent.component @Position (x: f32, y: f32) capacity 1000
component Position { x: f32, y: f32 } capacity 1000
// CHECK: ent.component @Health (hp: i32, alive: i1)
component Health { hp: i32, alive: bool }
// CHECK: ent.component @Target (who: !ent.entity)
component Target { who: entity }
// CHECK: ent.component @Enemy ()
tag Enemy
// CHECK: ent.resource @Clock (dt: f32, frame: i64)
unique Clock { dt: f32, frame: i64 }
// A unique with one value: its field is "value".
// CHECK: ent.resource @Score (value: i64)
unique Score: i64
// CHECK: ent.archetype @Unit (@Position, @Health, optional @Enemy) capacity 8
archetype Unit { Position, Health, optional Enemy } capacity 8

// Declared access is optional; with it, a contract.
// CHECK-LABEL: ent.system @step(%{{.*}}: f32) reads [@Health] writes [@Position, @Clock] {
system step(dt: f32) reads Health writes Position, Clock {
  // Literals take the type of the other operand; `+=` reads and writes.
  // CHECK:      ent.query (%[[P:.*]]: !ent.ref<@Position, mut>, %{{.*}}: !ent.ref<@Health>) {
  // CHECK:        %[[X:.*]] = ent.get %[[P]] "x"
  // CHECK-NEXT:   %[[TWO:.*]] = arith.constant 2.000000e+00 : f32
  // CHECK-NEXT:   %[[D:.*]] = arith.mulf %[[X]], %[[TWO]] : f32
  // CHECK-NEXT:   %[[OLD:.*]] = ent.get %[[P]] "y"
  // CHECK-NEXT:   %[[NEW:.*]] = arith.addf %[[OLD]], %[[D]] : f32
  // CHECK-NEXT:   ent.set %[[P]] "y", %[[NEW]]
  for p: mut Position, h: Health {
    p.y += p.x * 2
  }
  // Outside a for, a unique is read and written.
  // CHECK:      %[[ONE:.*]] = arith.constant 1 : i64
  // CHECK-NEXT: %[[F:.*]] = ent.read @Clock "frame" : i64
  // CHECK-NEXT: %[[N:.*]] = arith.addi %[[F]], %[[ONE]] : i64
  // CHECK-NEXT: ent.write @Clock "frame", %[[N]] : i64
  Clock.frame += 1
}

// `with` binds only to filter; `where` guards the body; an if-expression
// yields a value; `as` converts.
// CHECK-LABEL: ent.system @score() {
// CHECK:      ent.query (%[[H:.*]]: !ent.ref<@Health>) with [@Enemy] {
// CHECK:        %[[HP:.*]] = ent.get %[[H]] "hp"
// CHECK:        %[[LOW:.*]] = arith.cmpi slt, %[[HP]], %{{.*}} : i32
// CHECK-NEXT:   scf.if %[[LOW]] {
// CHECK:          %[[V:.*]] = scf.if %{{.*}} -> (i32) {
// CHECK:          %[[W:.*]] = arith.extsi %[[V]] : i32 to i64
// Inside a for, a unique is accumulated into.
// CHECK-NEXT:     ent.accumulate @Score "value" add %[[W]] : i64
system score() {
  for h: Health with Enemy where h.hp < 10 {
    let bonus = if h.alive { 10 } else { 1 }
    Score += bonus as i64
  }
}

// Another entity: read with `if let`, combined into with `-=`, `min=`.
// CHECK-LABEL: ent.system @hit(%{{.*}}: i32) {
// CHECK:        %[[WHO:.*]] = ent.get %{{.*}} "who"
// CHECK:        %[[HPV:.*]], %[[FOUND:.*]] = ent.lookup %[[WHO]] @Health "hp" : i32
// CHECK-NEXT:   scf.if %[[FOUND]] {
// CHECK:          %[[NEG:.*]] = arith.subi %{{.*}}, %{{.*}} : i32
// CHECK-NEXT:     ent.apply %{{.*}} @Health "hp" add %[[NEG]] : i32
system hit(d: i32) {
  for t: Target {
    if let hp = Health(t.who).hp {
      Health(t.who).hp -= min(hp, d)
    }
  }
}
// CHECK-LABEL: ent.system @cap() {
// CHECK:        ent.apply %{{.*}} @Health "hp" min %{{.*}} : i32
system cap() {
  for t: Target {
    Health(t.who).hp min= 100
  }
}

// Spawning lists components; the visited entity can be changed.
// CHECK-LABEL: ent.system @life() {
// CHECK:        %{{.*}} = ent.spawn (@Position, @Health)(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : f32, f32, i32, i1
// CHECK:        ent.add @Enemy()
// CHECK:        ent.remove @Enemy
// CHECK:        ent.despawn
system life() {
  for e, h: Health {
    if h.hp > 100 {
      spawn { Position { y: 1.0, x: 0.0 }, Health { hp: 1, alive: true } }
      e.add(Enemy)
    } else if h.hp < 0 {
      e.remove(Enemy)
      e.destroy()
    }
  }
}

// Reactive triggers, with an event log's capacity.
// CHECK-LABEL: ent.system @watch() {
// CHECK: ent.query (%{{.*}}: !ent.ref<@Position, mut>) on [changed @Health "hp" log 64, added @Enemy] {
system watch() {
  for p: mut Position on changed Health.hp log 64, added Enemy {
    p.x = 0.0
  }
}

// Filters: `with` (also `any(...)`), `without`; a for may bind nothing,
// with or without naming the entity. `e.has(C)` tests the visited entity.
// CHECK-LABEL: ent.system @filters() {
// CHECK:      ent.query (%{{.*}}: !ent.ref<@Position>) with [@Enemy] without [@Target] any [@Health, @Target2] {
// CHECK:      ent.query () with [@Enemy] {
// CHECK-NEXT:   %[[HAS:.*]] = ent.has @Target
// CHECK-NEXT:   scf.if %[[HAS]] {
// CHECK:      ent.query () without [@Enemy] {
component Target2 { who: entity }
system filters() {
  for p: Position with Enemy, any(Health, Target2) without Target {
    Score += 1
  }
  for e with Enemy {
    if e.has(Target) { e.destroy() }
  }
  for without Enemy {
    Score += 1
  }
}

// Relations: edges with data. Inside a `for`, `for [mut] s, other in
// e.out(R)` / `e.in(R)` visits the entity's edges; `s.disconnect()` drops
// one; `connect(a, b, R { ... })` adds one.
// CHECK: ent.relation @Synapse (weight: f32) capacity 64
// CHECK: ent.relation @Follows () capacity 16
relation Synapse { weight: f32 } capacity 64
relation Follows capacity 16
// The components the ends have, if the relation names them.
// CHECK: ent.relation @Aims (w: f32) from @Health to @Position capacity 8
// CHECK: ent.relation @Owns () to @Health capacity 8
relation Aims { w: f32 } from Health to Position capacity 8
relation Owns to Health capacity 8
// CHECK-LABEL: ent.system @wire() {
// CHECK:      ent.query (%{{.*}}: !ent.ref<@Health>) {
// CHECK:        ent.edges @Synapse out (%[[S:.*]]: !ent.ref<@Synapse>, %[[T:.*]]: !ent.entity) {
// CHECK:          %[[W:.*]] = ent.get %[[S]] "weight" : <@Synapse> -> f32
// CHECK:          ent.apply %[[T]] @Position "x" add %[[W]] : f32
// CHECK:        ent.edges @Follows in (%{{.*}}: !ent.ref<@Follows>, %[[P:.*]]: !ent.entity) {
// CHECK:          ent.apply %[[P]] @Position "x" add
// CHECK:        %[[A:.*]] = ent.entity
// CHECK-NEXT:   %[[B:.*]] = ent.entity
// CHECK:        ent.connect @Synapse %[[A]], %[[B]] (%{{.*}}) : f32
system wire() {
  for e, h: Health {
    for s, t in e.out(Synapse) {
      Position(t).x += s.weight
    }
  }
  for e, h: Health {
    for f, p in e.in(Follows) {
      Position(p).x += 1.0
    }
    connect(e, e, Synapse { weight: 0.5 })
  }
}
// CHECK-LABEL: ent.system @prune() {
// CHECK:        ent.edges @Synapse out (%[[S:.*]]: !ent.ref<@Synapse, mut>, %{{.*}}: !ent.entity) {
// CHECK:          ent.set %[[S]] "weight", %{{.*}} : <@Synapse, mut>, f32
// CHECK:          ent.disconnect
system prune() {
  for e, h: Health {
    for mut s, t in e.out(Synapse) {
      s.weight *= 0.5
      if s.weight < 0.01 { s.disconnect() }
    }
  }
}

// Schedules run systems; literals take the parameter's type.
// CHECK-LABEL: ent.schedule @frame(%{{.*}}: f32) {
// CHECK:      ent.run @step(%{{.*}}) : f32
// CHECK:      %[[C:.*]] = arith.constant 5 : i32
// CHECK-NEXT: ent.run @hit(%[[C]]) : i32
schedule frame(dt: f32) {
  step(dt)
  score()
  hit(5)
  cap()
  life()
  watch()
}

// run_if: on a schedule, a condition over uniques and the schedule's
// parameters in a block of its own; on a run, inside the schedule.
// CHECK-LABEL: ent.schedule @gated(%{{.*}}: f32) if {
// CHECK-NEXT: ^bb0(%[[DT:.*]]: f32):
// CHECK-NEXT:   %[[Z:.*]] = arith.constant 0.000000e+00 : f32
// CHECK-NEXT:   %[[POS:.*]] = arith.cmpf ogt, %[[DT]], %[[Z]] : f32
// CHECK-NEXT:   ent.yield %[[POS]] : i1
// CHECK-NEXT: } {
// CHECK-NEXT:   ent.run @step(%{{.*}}) : f32 if {
// CHECK-NEXT:     %[[F:.*]] = ent.read @Clock "frame" : i64
// CHECK:          %[[C:.*]] = arith.cmpi slt, %[[F]], %{{.*}} : i64
// CHECK-NEXT:     ent.yield %[[C]] : i1
// CHECK-NEXT:   }
// CHECK-NEXT:   ent.run @filters()
schedule gated(dt: f32) run_if dt > 0.0 {
  step(dt) run_if Clock.frame < 100
  filters()
}

// An extern system has no body; its contract is its access. `;` may end it.
// CHECK: ent.extern @draw(f32, i1) reads [@Position] writes [@Score]
extern system draw(dt: f32, on: bool) reads Position writes Score
// CHECK: ent.extern @beep()
extern system beep();
// CHECK: ent.extern @load() writes [@Unit]
extern system load() writes Unit

// CHECK-LABEL: ent.schedule @present(%{{.*}}: f32) {
// CHECK-NEXT:   %[[ON:.*]] = arith.constant true
// CHECK-NEXT:   ent.run @draw(%{{.*}}, %[[ON]]) : f32, i1
// CHECK-NEXT:   ent.run @beep()
schedule present(dt: f32) {
  draw(dt, true)
  beep()
}
schedule boot() { load() }

// The entry point: schedules in order, `loop` repeating until a condition
// that is evaluated after each round; arguments are expressions over
// uniques.
// CHECK-LABEL: ent.main {
// CHECK-NEXT:   ent.call @boot()
// CHECK-NEXT:   ent.loop {
// CHECK-NEXT:     %[[DT:.*]] = ent.read @Clock "dt" : f32
// CHECK-NEXT:     ent.call @present(%[[DT]]) : f32
// CHECK-NEXT:     ent.loop {
// CHECK-NEXT:       ent.call @boot()
// CHECK-NEXT:     }
// CHECK-NEXT:     %[[FRAME:.*]] = ent.read @Clock "frame" : i64
// CHECK-NEXT:     %[[LAST:.*]] = arith.constant 8 : i64
// CHECK-NEXT:     %[[DONE:.*]] = arith.cmpi sge, %[[FRAME]], %[[LAST]] : i64
// CHECK-NEXT:     ent.yield %[[DONE]] : i1
// CHECK-NEXT:   }
// CHECK-NEXT:   ent.call @boot()
// CHECK-NEXT: }
main {
  boot()
  loop {
    present(Clock.dt)
    loop { boot() }
  } until Clock.frame >= 8
  boot()
}

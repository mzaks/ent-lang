// RUN: ent-translate --import-ent %s | FileCheck %s
// RUN: ent-translate --import-ent %s | ent-opt | FileCheck %s
// RUN: ent-translate --import-ent %s | ent-translate --ent-to-c-extern-header \
// RUN:   | FileCheck %s --check-prefix=HEADER --allow-empty

// A fn may give several values. There is no tuple anywhere else: they are
// the results of the function and of its calls.
component Ghost { kind: i32, col: i32, row: i32 }
default_capacity 8
unique Total: i32

// HEADER-NOT: step
// CHECK:      ent.function @step(%[[C:.*]]: i32, %[[R:.*]]: i32, %[[W:.*]]: i32) -> (i32, i32) {
// CHECK:        %[[NC:.*]] = arith.addi %[[C]], %{{.*}} : i32
// CHECK:        %[[NR:.*]] = arith.addi %[[R]], %{{.*}} : i32
// CHECK-NEXT:   ent.yield %[[NC]], %[[NR]] : i32, i32
fn step(col: i32, row: i32, way: i32) -> (i32, i32) {
  let dx = if way == 0 { 1 } else if way == 2 { -1 } else { 0 }
  let dy = if way == 1 { 1 } else if way == 3 { -1 } else { 0 }
  (col + dx, row + dy)
}

// The branches of an `if` give them: as '(a, b)', where a literal takes the
// type the fn gives, or by calling a fn that gives the same.
// CHECK:      ent.function @target(%[[K:.*]]: i32, %[[S:.*]]: i1) -> (i64, f32) {
// CHECK-NEXT:   %[[T:.*]]:2 = scf.if %[[S]] -> (i64, f32) {
// CHECK:          %[[A:.*]] = arith.constant 26 : i64
// CHECK:          %[[B:.*]] = arith.constant 0.000000e+00 : f32
// CHECK-NEXT:     scf.yield %[[A]], %[[B]] : i64, f32
// CHECK-NEXT:   } else {
// CHECK:          %[[U:.*]]:2 = scf.if %{{.*}} -> (i64, f32) {
// CHECK:            %[[V:.*]]:2 = ent.invoke @target(%{{.*}}, %{{.*}}) : (i32, i1) -> (i64, f32)
// CHECK-NEXT:       scf.yield %[[V]]#0, %[[V]]#1 : i64, f32
// CHECK:          scf.yield %[[U]]#0, %[[U]]#1 : i64, f32
// CHECK-NEXT:   }
// CHECK-NEXT:   ent.yield %[[T]]#0, %[[T]]#1 : i64, f32
fn target(kind: i32, scatter: bool) -> (i64, f32) {
  if scatter {
    (26, 0)
  } else if kind == 1 {
    target(0, true)
  } else {
    let far = kind as i64 * 2
    (far, 1.5)
  }
}

// CHECK-LABEL: ent.system @move() {
system move() {
  // Taken apart by `let`, each value a local of its own type...
  // CHECK: %[[T:.*]]:2 = ent.invoke @target(%{{.*}}, %{{.*}}) : (i32, i1) -> (i64, f32)
  let (far, weight) = target(2, false)
  // ... or by `var`, each a var.
  // CHECK: %[[P:.*]]:2 = ent.invoke @step(%{{.*}}, %{{.*}}, %{{.*}}) : (i32, i32, i32) -> (i32, i32)
  // CHECK: %[[MORE:.*]] = arith.addi %[[P]]#0, %{{.*}} : i32
  var (col, row) = step(1, 1, 0)
  col += 10
  // Without a fn: the values say what they are.
  // CHECK: %[[L:.*]]:2 = scf.if %{{.*}} -> (f32, i32) {
  let (x, y) = if col > 5 { (1.5, 2) } else { (2.5, 3) }
  // CHECK: arith.trunci %[[T]]#0 : i64 to i32
  Total = far as i32 + col + row + y + (weight + x) as i32
  for g: mut Ghost {
    // CHECK: %[[N:.*]]:2 = ent.invoke @step(
    // CHECK: ent.set %{{.*}} "col", %[[N]]#0
    // CHECK: ent.set %{{.*}} "row", %[[N]]#1
    let (c, r) = step(g.col, g.row, g.kind)
    g.col = c
    g.row = r
  }
}

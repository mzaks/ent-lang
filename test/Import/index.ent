// RUN: ent-translate --import-ent %s | FileCheck %s
// RUN: ent-translate --import-ent %s | ent-opt --ent-indexes | FileCheck %s --check-prefix=RUNS

// An index (docs/syntax.md): a buffer the program keeps, a field of the
// first component where each entity's row is, and what the index declares
// for itself; --ent-indexes runs `Traffic_update` before what reads it
// where `Traffic_moved` (which entities it holds) or `Traffic_stale`
// (their keys or what it copies) has run after what changed it.

component Car { key: i64 } capacity 64
component Spot { x: f32 } capacity 64

// A spawn read before the index is declared is given the row too.
system early() { spawn { Car { key: 1 }, Spot { x: 1.0 } } }

index Traffic of Car by key { x: Spot.x }

system late() { spawn { Car { key: 2 }, Spot { x: 2.0 } } }
system move() { for s: mut Spot { s.x += 1.0 } }
system tune() { for c: mut Car { c.key += 1 } }
system look() { for e, c: Car { let r = Traffic.row(e) } }
system count() { let n = len(Traffic) }
system other() { for s: Spot { } }

schedule frame() {
  early()
  count()
  late()
  move()
  look()
  other()
  tune()
  count()
}

// CHECK: ent.component @Car (key: i64, row_in_Traffic: i32) capacity 64
// CHECK-LABEL: ent.system @early()
// CHECK: %[[ROW:.*]] = arith.constant 0 : i32
// CHECK: ent.spawn (@Car, @Spot)(%{{.*}}, %[[ROW]], %{{.*}}) : i64, i32, f32
// CHECK: ent.buffer @Traffic (key: i64, who: !ent.entity, x: f32) capacity 64 {ent.index = {copies = ["Spot", "x"], fresh = "Traffic_fresh", hidden = ["row_in_Traffic"], key = ["Car", "key"], moved = "Traffic_moved", of = ["Car", "Spot"], own = ["Traffic"], row = ["Car", "row_in_Traffic"], stale = "Traffic_stale", update = "Traffic_update"}{{.*}}ent.transient}
// CHECK-LABEL: ent.system @Traffic_update()
// CHECK: ent.read @Traffic_whole "value"
// CHECK: ent.query
// CHECK: ent.invoke proc @Traffic_settle
// CHECK: ent.query {{.*}} by @Car "key"
// CHECK: ent.append @Traffic
// CHECK: ent.invoke proc @Traffic_number
// CHECK-LABEL: ent.system @late()
// CHECK: ent.spawn (@Car, @Spot)(%{{.*}}, %{{.*}}, %{{.*}}) : i64, i32, f32
// CHECK-LABEL: ent.system @look()
// CHECK: ent.lookup %{{.*}} @Car "row_in_Traffic" : i32

// RUNS-LABEL: ent.schedule @frame()
// RUNS-NEXT: ent.run @early()
// RUNS-NEXT: ent.run @Traffic_moved()
// RUNS-NEXT: ent.run @Traffic_update() if
// RUNS: ent.run @count()
// RUNS-NEXT: ent.run @late()
// RUNS-NEXT: ent.run @Traffic_moved()
// RUNS-NEXT: ent.run @move()
// RUNS-NEXT: ent.run @Traffic_stale()
// RUNS-NEXT: ent.run @Traffic_update() if
// RUNS: ent.run @look()
// RUNS-NEXT: ent.run @other()
// RUNS-NEXT: ent.run @tune()
// RUNS-NEXT: ent.run @Traffic_stale()
// RUNS-NEXT: ent.run @Traffic_update() if
// RUNS: ent.run @count()
// RUNS-NEXT: }

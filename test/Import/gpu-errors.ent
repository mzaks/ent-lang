// RUN: ent-translate --import-ent %s -split-input-file -verify-diagnostics

// What keeps a `for` of a `gpu system` off the GPU (docs/gpu.md).

component Spot { x: f32, foe: entity }
gpu system push() {
  for s: Spot {
    // expected-error @+1 {{sends or accumulates a value that is not a whole number}}
    Spot(s.foe).x += 1.0
  }
}

// -----

component Spot { x: f32 }
unique Sum: f64
gpu system add() {
  for s: Spot {
    // expected-error @+1 {{sends or accumulates a value that is not a whole number}}
    Sum += s.x as f64
  }
}

// -----

component Spot { x: f32 }
gpu system near() {
  for s: mut Spot {
    var sum = 0.0
    // expected-error @+1 {{has a 'for' over other entities in its body}}
    for o: old Spot { sum += o.x }
    s.x = sum
  }
}

// -----

component Neuron { input: f32 }
relation Synapse { weight: f32 } capacity 16
gpu system prune() {
  for e, n: mut Neuron {
    for (e)-[s: Synapse]->(post) {
      // expected-error @+1 {{connects or disconnects edges: the relation is sorted again on the CPU}}
      if s.weight < 0.0 { s.disconnect() }
    }
  }
}

// -----

component Box { w: f32 }
relation (Box)-[Inside]->(Box) tree capacity 8
gpu system weigh() {
  for c: mut Box {
    // expected-error @+1 {{goes along a tree's edges}}
    for (inner: Box)-[Inside]->(c) { c.w += inner.w }
  }
}

// -----

component Hp { hp: i32 }
gpu system die() {
  for e, h: Hp {
    // expected-error @+1 {{changes which entities there are}}
    if h.hp < 0 { e.destroy() }
  }
}

// -----

component Hp { hp: i32 }
tag Close apart capacity 8
gpu system close() {
  for e, h: Hp {
    // expected-error @+1 {{moves the entity to another archetype (Close is stored 'apart')}}
    if h.hp < 0 { e.add(Close) }
  }
}

// -----

component Spot { x: f32 }
extern fn noise(x: f32) -> f32
gpu system wobble() {
  for s: mut Spot {
    // expected-error @+1 {{calls 'noise', an extern fn: its C runs on the CPU}}
    s.x = noise(s.x)
  }
}

// -----

component Spot { x: f32 }
extern fn noise(x: f32) -> f32
fn twice(x: f32) -> f32 { noise(x) * 2.0 }
gpu system wobble() {
  for s: mut Spot {
    // expected-error @+1 {{calls 'twice', which calls 'noise', an extern fn}}
    s.x = twice(s.x)
  }
}

// -----

component Spot { x: f32 }
extern proc put(x: f32)
gpu system say() {
  for s: Spot {
    // expected-error @+1 {{calls the proc 'put', which acts on the outside}}
    put(s.x)
  }
}

// -----

component Label { name: text[8], n: i32 }
gpu system name() {
  for l: mut Label {
    // expected-error @+1 {{works with a text}}
    if l.name == "a" { l.n = 1 }
  }
}

// -----

component Spot { x: f32 }
gpu system react() {
  // expected-error @+1 {{it reacts to events (`on`)}}
  for s: mut Spot on changed Spot.x {
    s.x = 0.0
  }
}

// -----

component Thing { born: i32 }
gpu system order() {
  // expected-error @+1 {{it visits its entities in the order of a field: on the GPU, its body only reads and gives each entity's rows to buffers}}
  for t: mut Thing by t.born {
    t.born = 0
  }
}

// -----

component Thing { born: i32 }
buffer Born { at: i32 } capacity 8
gpu system order() {
  // expected-error @+1 {{its body only reads and gives each entity's rows to buffers (each '+=' in the body itself, not under an 'if' or in a loop)}}
  for t: Thing by t.born {
    if t.born > 0 { Born += { at: t.born } }
  }
}

// -----

component Thing { born: i32 }
buffer Born { at: i32 } capacity 8
gpu system order() {
  // expected-error @+1 {{its entities take turns, one after another, in the order of a field}}
  for t: Thing in turn by t.born {
    Born += { at: t.born }
  }
}

// -----

component Box { w: f32 }
component Size { h: f32 }
relation (Box)-[Inside]->(Box) tree capacity 8
gpu system sizes() {
  // expected-error @+1 {{it reads another entity along a tree, further than its parent}}
  for (b: Box, s: mut Size)-[Inside*]->(outer: Box) {
    s.h = outer.w
  }
}

// -----

component Box { w: f32 }
component Room { n: i32, area: f32 }
relation (Box)-[In]->(Room) tree capacity 8
gpu system count() {
  for (b: Box)-[In]->(r: mut Room) bottom up In {
    // expected-error @+1 {{combines into a parent a value that is not a whole number}}
    r.area += b.w
  }
}

// -----

component Spot { x: f32 }
gpu system grow() {
  for s: mut Spot { s.x += 1.0 }
  // expected-error @+1 {{is in a 'gpu' system, outside its 'for's, where its code only reads and writes uniques}}
  spawn { Spot { x: 0.0 } }
}

// -----

component Spot { x: f32 }
buffer Marks { x: f32 } capacity 4
gpu system mark() {
  for s: mut Spot { s.x += 1.0 }
  // expected-error @+1 {{goes in a system of its own}}
  Marks += { x: 1.0 }
}

// -----

// expected-error @+1 {{only a system with a body can be 'gpu'}}
gpu extern system report()

// -----

component Spot { x: f32 }
set Hot
set Seen
gpu system mark() {
  for e, s: Spot { Hot += e }
  // expected-error @+1 {{goes in a system of its own}}
  Seen = Hot
}

// -----

component Spot { x: f32 }
set Hot
gpu system mark(e: entity) {
  for s: mut Spot { s.x += 1.0 }
  // expected-error @+1 {{goes in a system of its own}}
  Hot += e
}

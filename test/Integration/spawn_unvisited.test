// Spawns during a query are not visited by it, whichever archetype loop of
// the query comes later.
// RUN: mkdir -p %t.dir
// RUN: ecs-translate --ecs-to-c-header %S/Inputs/spawn_unvisited.mlir \
// RUN:     -o %t.dir/spawn_unvisited_world.h
// RUN: ecs-opt %S/Inputs/spawn_unvisited.mlir --ecs-lower-to-loops \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.ll
// RUN: clang -O2 -Wno-override-module %t.ll -I%t.dir \
// RUN:     %S/Inputs/spawn_unvisited_main.c -o %t.exe
// RUN: %t.exe | FileCheck %s

// The @A entity is visited once and spawns one @B, which is not visited.
// CHECK: A: 1 entities, visits 1; B: 1 entities, visits 0

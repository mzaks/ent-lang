// Doom's game in ent-lang (examples/doom): the three demos of the
// shareware WAD played to their ends, with their monsters. The last tic
// of each is the reference's: where the random numbers are, where the
// player is, which way it is turned, its health, how many things there
// are and the hash of them all (where each is, how it is turned, its
// health, its state and how long for); so is every tic before it, which
// examples/doom/check/trace.sh compares. Runs where the WAD is
// (examples/doom/reference/fetch.sh fetches it).
// REQUIRES: doom-wad
// RUN: rm -rf %t && mkdir -p %t && cp %doom-wad %t/doom1.wad
// RUN: sed 's/Tics = 300/Tics = 100000/' \
// RUN:     %S/../../examples/doom/check/trace_check.ent > %t/demo1.ent
// RUN: sed 's/DEMO1/DEMO2/; s/Tics = 300/Tics = 100000/' \
// RUN:     %S/../../examples/doom/check/trace_check.ent > %t/demo2.ent
// RUN: sed 's/DEMO1/DEMO3/; s/Tics = 300/Tics = 100000/' \
// RUN:     %S/../../examples/doom/check/trace_check.ent > %t/demo3.ent
// RUN: cd %t && %ent run -I %S/../../examples/doom %t/demo1.ent > %t/demo1.port
// RUN: cd %t && %ent run -I %S/../../examples/doom %t/demo2.ent > %t/demo2.port
// RUN: cd %t && %ent run -I %S/../../examples/doom %t/demo3.ent > %t/demo3.port
// RUN: tail -1 %t/demo1.port | FileCheck %s --check-prefix=ONE
// RUN: tail -1 %t/demo2.port | FileCheck %s --check-prefix=TWO
// RUN: tail -1 %t/demo3.port | FileCheck %s --check-prefix=THREE
// RUN: wc -l < %t/demo1.port | FileCheck %s --check-prefix=TICS

// ONE: 1 5 5025 181 87385351 84364146 5767168 2514731840 0 198 2015001010
// TWO: 1 3 3835 75 -9362093 -84944896 3145728 2688383391 0 280 4251420830
// THREE: 1 7 2133 207 -91417116 -164628508 7340032 2593932736 0 254 4196538785
// TICS: 5027

// The scenes of examples/traffic/town.ent (lights and a priority road
// where streets of two lanes each way cross, a roundabout, stops on every
// street, and a highway with an on-ramp), ten minutes each with more cars
// than the lights, the stops and the highway let through: none stands on
// the car ahead, no two on paths that cross, join or split, or in lanes
// side by side, come within 2.5 m of each other, the cars change lanes
// where there are lanes, and nothing locks up. The same on one core and on
// all of them.
// RUN: %ent run -I %S/../../examples/traffic %S/Inputs/traffic_town.ent 2>/dev/null > %t.one
// RUN: %ent run --parallel -I %S/../../examples/traffic %S/Inputs/traffic_town.ent 2>/dev/null > %t.all
// RUN: cmp %t.one %t.all
// RUN: FileCheck %s < %t.one

// CHECK: scene 0: {{[23][0-9][0-9]}} through, {{[1-9][0-9]+}} lane changes, 0 overlaps, 0 close
// CHECK: scene 1: {{[23][0-9][0-9]}} through, 0 lane changes, 0 overlaps, 0 close
// CHECK: scene 2: {{[12][0-9][0-9]}} through, {{[1-9][0-9]+}} lane changes, 0 overlaps, 0 close
// CHECK: scene 3: {{1[0-9][0-9]}} through, 0 lane changes, 0 overlaps, 0 close
// CHECK: scene 4: {{[45][0-9][0-9]}} through, {{[1-9][0-9]+}} lane changes, 0 overlaps, 0 close

// Extern fns and procs through the build driver: values go to C and come
// back, the world stays with the program. Procs are called in the order
// the systems say, also when the schedule is staged.
// RUN: %ent run %S/Inputs/functions.ent | FileCheck %s
// RUN: %ent run --parallel %S/Inputs/functions.ent | FileCheck %s
// The C is compiled against a header without the world.
// RUN: %ent build %S/Inputs/functions.ent -o %t.exe --keep %t.dir
// RUN: FileCheck %s --check-prefix=HEADER --input-file %t.dir/ent_extern.h

// HEADER-NOT: ent_world
// HEADER:     bool ent_longer(const ent_text14 *arg0, int32_t arg1);


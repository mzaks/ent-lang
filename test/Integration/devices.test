// The devices that come with the compiler (devices/), through the build
// driver (tools/ent): a program of .ent files only. The driver finds the
// modules, compiles their C against the declarations of what they
// implement, and runs it.
// RUN: %ent run %S/Inputs/devices.ent | FileCheck %s
// RUN: %ent run --parallel %S/Inputs/devices.ent | FileCheck %s
// RUN: %ent build %S/Inputs/devices.ent -o %t.exe --keep %t.dir
// RUN: %t.exe | FileCheck %s
// RUN: ls %t.dir | FileCheck %s --check-prefix=KEPT

// Lines come out in the order they were spawned, once each.
// CHECK:      start 0.0 step 0.0
// CHECK-NEXT: frame 1
// CHECK-NEXT:   with a second line
// CHECK-NEXT: frame 2
// CHECK-NEXT:   with a second line
// CHECK-NEXT: frame 3
// CHECK-NEXT:   with a second line
// CHECK-NEXT: early 0 backwards 0
// CHECK-NEXT: the end
// CHECK-NOT:  {{.}}

// For all the cores, the program says how long a thread without work
// waits before it sleeps (unless the environment says).
// RUN: %ent build --parallel %S/Inputs/devices.ent -o %t.par.exe --keep %t.par
// RUN: FileCheck %s --check-prefix=WAIT --input-file=%t.par/ent_folders.c
// WAIT: ent_threads_wait
// WAIT-NEXT: #ifdef __APPLE__
// WAIT-NEXT: setenv("KMP_BLOCKTIME", "0", 0)
// WAIT-NEXT: #else
// WAIT-NEXT: setenv("KMP_BLOCKTIME", "5", 0)

// A program with a window (devices/window.ent) does a frame's work and
// waits for the screen: its threads sleep at once.
// RUN: %ent build --parallel -I %S/../../examples %S/Inputs/window_resize.ent -o %t.win.exe --keep %t.win
// RUN: FileCheck %s --check-prefix=SLEEP --input-file=%t.win/ent_folders.c
// SLEEP: ent_threads_wait
// SLEEP-NEXT: #ifdef __APPLE__
// SLEEP-NEXT: setenv("KMP_BLOCKTIME", "0", 0)
// SLEEP-NEXT: #else
// SLEEP-NEXT: setenv("KMP_BLOCKTIME", "0", 0)

// KEPT-DAG: ent_world.h
// KEPT-DAG: ent_extern.h
// KEPT-DAG: devices.mlir

// The hello example.
// RUN: %ent run %S/../../examples/hello.ent | FileCheck %s --check-prefix=HELLO
// HELLO:      hello from frame 1
// HELLO:      hello from frame 5
// HELLO-NOT:  late

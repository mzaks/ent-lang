// examples/river.ent, the program bench/river measures, agrees with C
// that sums down the same tree, to the bit, in each shape of tree.
// RUN: mkdir -p %t.dir
// RUN: ent-translate --import-ent %S/../../examples/river.ent -o %t.mlir
// RUN: ent-translate --ent-to-c-header %t.mlir -o %t.dir/river_world.h
// RUN: ent-opt %t.mlir --ent-lower-to-loops --convert-scf-to-cf \
// RUN:     --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.ll
// RUN: clang -O2 -Wno-override-module -ffp-contract=off -DVARIANT=2 -DN=1024 \
// RUN:     %t.ll -I%t.dir %S/../../bench/river/river.c -o %t.ent
// With its tree sorted.
// RUN: sed 's/ tree capacity 1024$/ tree sorted capacity 1024/' \
// RUN:     %S/../../examples/river.ent > %t.sorted.ent
// RUN: grep -q "tree sorted capacity" %t.sorted.ent
// RUN: mkdir -p %t.sdir
// RUN: ent-translate --import-ent %t.sorted.ent -o %t.s.mlir
// RUN: ent-translate --ent-to-c-header %t.s.mlir -o %t.sdir/river_world.h
// RUN: ent-opt %t.s.mlir --ent-lower-to-loops --convert-scf-to-cf \
// RUN:     --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.s.ll
// RUN: clang -O2 -Wno-override-module -ffp-contract=off -DVARIANT=2 -DN=1024 \
// RUN:     %t.s.ll -I%t.sdir %S/../../bench/river/river.c -o %t.entsorted
// RUN: %t.entsorted 3 1 bushy | sed 's/.*depth/depth/' > %t.es.out
// RUN: %t.entsorted 3 1 deep | sed 's/.*depth/depth/' >> %t.es.out
// RUN: %t.entsorted 3 1 shuffled | sed 's/.*depth/depth/' >> %t.es.out
// And that with every depth of the tree in parallel.
// RUN: ent-opt %t.s.mlir \
// RUN:     "--ent-lower-to-loops=parallel-entities=1 parallel-min-entities=1 parallel-min-level=1" \
// RUN:     --convert-scf-to-openmp --canonicalize --ent-omp-nowait \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.sp.ll
// RUN: clang -O2 -Wno-override-module -ffp-contract=off -DVARIANT=2 -DN=1024 \
// RUN:     %t.sp.ll -I%t.sdir %S/../../bench/river/river.c %openmp -o %t.entpar
// RUN: %t.entpar 3 1 bushy | sed 's/.*depth/depth/' > %t.ep.out
// RUN: %t.entpar 3 1 deep | sed 's/.*depth/depth/' >> %t.ep.out
// RUN: %t.entpar 3 1 shuffled | sed 's/.*depth/depth/' >> %t.ep.out
// RUN: clang -O2 -ffp-contract=off -DVARIANT=0 -DN=1024 \
// RUN:     %S/../../bench/river/river.c -o %t.c
// RUN: clang -O2 -ffp-contract=off -DVARIANT=1 -DN=1024 \
// RUN:     %S/../../bench/river/river.c -o %t.sorted
// RUN: %t.ent 3 1 bushy | sed 's/.*depth/depth/' > %t.ent.out
// RUN: %t.ent 3 1 deep | sed 's/.*depth/depth/' >> %t.ent.out
// RUN: %t.ent 3 1 shuffled | sed 's/.*depth/depth/' >> %t.ent.out
// RUN: %t.c 3 1 bushy | sed 's/.*depth/depth/' > %t.c.out
// RUN: %t.c 3 1 deep | sed 's/.*depth/depth/' >> %t.c.out
// RUN: %t.c 3 1 shuffled | sed 's/.*depth/depth/' >> %t.c.out
// RUN: %t.sorted 3 1 bushy | sed 's/.*depth/depth/' > %t.sorted.out
// RUN: %t.sorted 3 1 deep | sed 's/.*depth/depth/' >> %t.sorted.out
// RUN: %t.sorted 3 1 shuffled | sed 's/.*depth/depth/' >> %t.sorted.out
// RUN: cmp %t.ent.out %t.c.out
// Nodes of two shapes, in two archetypes: unsorted to the bit, and sorted,
// where a node's inflows are added in another order, to five digits of
// the sum of all flows.
// RUN: printf 'component Still { level: f32 } capacity 1024\narchetype Pool { Node, Still } capacity 1024\n' \
// RUN:     > %t.two
// RUN: cat %S/../../examples/river.ent %t.two > %t.two.ent
// RUN: cat %t.sorted.ent %t.two > %t.twos.ent
// RUN: mkdir -p %t.2dir %t.2sdir
// RUN: ent-translate --import-ent %t.two.ent -o %t.2.mlir
// RUN: ent-translate --ent-to-c-header %t.2.mlir -o %t.2dir/river_world.h
// RUN: ent-opt %t.2.mlir --ent-lower-to-loops --convert-scf-to-cf \
// RUN:     --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.2.ll
// RUN: clang -O2 -Wno-override-module -ffp-contract=off -DVARIANT=2 -DN=1024 \
// RUN:     -DTWO %t.2.ll -I%t.2dir %S/../../bench/river/river.c -o %t.two.exe
// RUN: ent-translate --import-ent %t.twos.ent -o %t.2s.mlir
// RUN: ent-translate --ent-to-c-header %t.2s.mlir -o %t.2sdir/river_world.h
// RUN: ent-opt %t.2s.mlir --ent-lower-to-loops --convert-scf-to-cf \
// RUN:     --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.2s.ll
// RUN: clang -O2 -Wno-override-module -ffp-contract=off -DVARIANT=2 -DN=1024 \
// RUN:     -DTWO %t.2s.ll -I%t.2sdir %S/../../bench/river/river.c -o %t.twos.exe
// RUN: %t.two.exe 3 1 bushy | sed 's/.*depth/depth/' > %t.two.out
// RUN: %t.two.exe 3 1 deep | sed 's/.*depth/depth/' >> %t.two.out
// RUN: %t.two.exe 3 1 shuffled | sed 's/.*depth/depth/' >> %t.two.out
// RUN: cmp %t.ent.out %t.two.out
// RUN: %t.twos.exe 3 1 bushy | sed 's/.*total=\(......\).*/\1/' > %t.twos.out
// RUN: %t.twos.exe 3 1 deep | sed 's/.*total=\(......\).*/\1/' >> %t.twos.out
// RUN: %t.twos.exe 3 1 shuffled | sed 's/.*total=\(......\).*/\1/' >> %t.twos.out
// RUN: sed 's/.*total=\(......\).*/\1/' %t.ent.out > %t.totals.out
// RUN: cmp %t.totals.out %t.twos.out
// RUN: cmp %t.ent.out %t.sorted.out
// RUN: cmp %t.ent.out %t.es.out
// RUN: cmp %t.ent.out %t.ep.out
// RUN: FileCheck %s --input-file=%t.ent.out
// CHECK:      depth={{[0-9]+}} checksum={{[0-9a-f]+}} total={{[0-9.e+]+}}
// CHECK-NEXT: depth={{[0-9]+}} checksum={{[0-9a-f]+}} total={{[0-9.e+]+}}
// CHECK-NEXT: depth={{[0-9]+}} checksum={{[0-9a-f]+}} total={{[0-9.e+]+}}

// Indexes the program does not declare (docs/indexes.md, step 12): a
// remark at each `for` one would serve, naming its declaration, and one
// of a declared index nothing reads; with --infer-indexes they are made,
// the program saying the same as with them declared by hand.
// RUN: sed -e '/\/\/D$/d' %S/Inputs/infer_indexes.ent > %t.ent
// RUN: sed -e 's|//D$||' %S/Inputs/infer_indexes.ent > %t.declared.ent
// RUN: %ent run %t.declared.ent > %t.declared 2> %t.declared.err
// RUN: %ent run %t.ent > %t.plain 2> %t.err
// RUN: FileCheck %s --check-prefix=REMARK --input-file=%t.err
// RUN: %ent run %t.ent --infer-indexes > %t.inferred
// RUN: cmp %t.plain %t.inferred
// RUN: cmp %t.plain %t.declared
// RUN: FileCheck %s --input-file=%t.inferred
// RUN: FileCheck %s --check-prefix=UNREAD --input-file=%t.declared.err
// RUN: ent-translate --import-ent %t.ent -I %S/../../devices \
// RUN:   | ent-opt --ent-infer-indexes="out=%t.found remarks=0" -o /dev/null
// RUN: FileCheck %s --check-prefix=FOUND --input-file=%t.found
// RUN: ent-translate --import-ent %t.ent --inferred=%t.found -I %S/../../devices \
// RUN:   | ent-opt --ent-indexes | FileCheck %s --check-prefix=VIA

// Refined by a trace: a `for` whose loops took less than `worth` of the run
// gets no remark nor index; through the driver, --tune gives the times.
// RUN: rm -rf %t.dir && mkdir -p %t.dir && cp %t.ent %t.dir/ii.ent
// RUN: echo '{"run": 1000, "places": {"ii.ent:29:9": 600, "ii.ent:25:7": 5}}' > %t.times.json
// RUN: ent-translate --import-ent %t.dir/ii.ent --mlir-print-debuginfo -I %S/../../devices \
// RUN:   | ent-opt --ent-infer-indexes="out=%t.timed times=%t.times.json worth=0.1" \
// RUN:     --mlir-print-op-on-diagnostic=false -o /dev/null 2> %t.timed.err
// RUN: FileCheck %s --check-prefix=TIMED --input-file=%t.timed.err
// RUN: FileCheck %s --check-prefix=TIMED-FOUND --input-file=%t.timed
// RUN: cd %t.dir && env ENT_TRACE=%t.dir/trace.json %ent run ii.ent --trace > /dev/null 2>&1
// RUN: cd %t.dir && %ent build ii.ent --tune trace.json 2> %t.tuned.err
// RUN: FileCheck %s --check-prefix=TUNED --input-file=%t.tuned.err

// Sorted: `for ... by` a field more often than systems change it.
// RUN: %ent run %S/Inputs/infer_sorted.ent > %t.sorted 2> %t.sorted.err
// RUN: FileCheck %s --check-prefix=SORTED --input-file=%t.sorted.err
// RUN: %ent run %S/Inputs/infer_sorted.ent --infer-indexes > %t.sorted.inferred
// RUN: cmp %t.sorted %t.sorted.inferred
// RUN: echo 'index DotByKey of Dot by key' > %t.sorted.found
// RUN: ent-translate --import-ent %S/Inputs/infer_sorted.ent --inferred=%t.sorted.found \
// RUN:   -I %S/../../devices | ent-opt --ent-indexes | FileCheck %s --check-prefix=BYINDEX

// REMARK-DAG: index Unread is read by nothing: it is not made
// REMARK-DAG: :25:{{[0-9]+}}: remark: visits every entity to find those whose kind is of some values; an index would find them: 'index BugByKind of Bug by kind partition'
// REMARK-DAG: :26:{{[0-9]+}}: remark: visits every entity to find those whose kind is of some values; an index would find them: 'index BugByKind of Bug by kind partition'
// REMARK-DAG: :29:{{[0-9]+}}: remark: visits every entity to find those whose team is one value; an index would find them: 'index BugByTeam of Bug by team hash'
// UNREAD: index Unread is read by nothing: it is not made
// UNREAD-NOT: an index would find them
// UNREAD-NOT: see current operation
// FOUND: index BugByKind of Bug by kind partition
// FOUND-NEXT: index BugByTeam of Bug by team hash

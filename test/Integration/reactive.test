// Reactive queries end to end: health bars redrawn only for ships whose hp
// changed, alarms for shields going down, counts of shields coming back.
// Run as written, fused (reactive systems stay calls; the others fuse),
// with parallel stages, and with parallel entity loops forced on; then with
// Shield stored in separate archetypes, where the same events are moves.
// After the first run the queries walk their event logs, except where a
// log is too small or absent. All print the same.
// RUN: mkdir -p %t.dir %t.dir/tiny %t.dir/nolog
// RUN: ecs-translate --ecs-to-c-header %S/../../examples/reactive.mlir \
// RUN:     -o %t.dir/reactive_world.h

// RUN: ecs-opt %S/../../examples/reactive.mlir --ecs-lower-to-loops \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.seq.ll
// RUN: clang -O2 -Wno-override-module %t.seq.ll \
// RUN:     -I%t.dir %S/../../examples/host/reactive_main.c -o %t.seq
// RUN: %t.seq | FileCheck %s

// RUN: ecs-opt %S/../../examples/reactive.mlir \
// RUN:     --ecs-lower-to-loops=fuse-systems=1 --symbol-dce \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.fused.ll
// RUN: clang -O2 -Wno-override-module %t.fused.ll \
// RUN:     -I%t.dir %S/../../examples/host/reactive_main.c -o %t.fused
// RUN: %t.fused | FileCheck %s

// RUN: ecs-opt %S/../../examples/reactive.mlir --ecs-schedule \
// RUN:     --ecs-lower-to-loops=parallel-stages=1 --convert-scf-to-cf \
// RUN:     --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.stages.ll
// RUN: clang -O2 -Wno-override-module %t.stages.ll \
// RUN:     -I%t.dir %S/../../examples/host/reactive_main.c %openmp -o %t.stages
// RUN: %t.stages | FileCheck %s

// RUN: ecs-opt %S/../../examples/reactive.mlir \
// RUN:     "--ecs-lower-to-loops=parallel-entities=1 parallel-min-entities=1" \
// RUN:     --convert-scf-to-openmp --canonicalize --ecs-omp-nowait \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.par.ll
// RUN: clang -O2 -Wno-override-module %t.par.ll \
// RUN:     -I%t.dir %S/../../examples/host/reactive_main.c %openmp -o %t.par
// RUN: %t.par | FileCheck %s

// The same with logs of one entry, so every run but those without events
// finds its log overwritten and scans, and with no logs at all.
// RUN: sed -e 's/"hp"\]/"hp" log 1]/' \
// RUN:     -e 's/added @Shield\]/added @Shield log 1]/' \
// RUN:     -e 's/removed @Shield\]/removed @Shield log 1]/' \
// RUN:     %S/../../examples/reactive.mlir > %t.dir/tiny.mlir
// RUN: ecs-translate --ecs-to-c-header %t.dir/tiny.mlir \
// RUN:     -o %t.dir/tiny/reactive_world.h

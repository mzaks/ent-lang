// Cross-entity writes end to end: torpedoes deal damage to their target
// ship with ent.apply; hits on one ship in a frame add up, and a hit on a
// sunk ship is dropped even though a new ship took its slot. Run as
// written, fused (systems with applies stay calls), staged with parallel
// stages, and with parallel entity loops forced on (the query filling the
// apply buffers runs in parallel); all agree.
// RUN: mkdir -p %t.dir
// RUN: ent-translate --ent-to-c-header %S/../../examples/damage.mlir \
// RUN:     -o %t.dir/damage_world.h

// RUN: ent-opt %S/../../examples/damage.mlir --ent-lower-to-loops \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.seq.ll
// RUN: clang -O2 -Wno-override-module %t.seq.ll \
// RUN:     -I%t.dir %S/../../examples/host/damage_main.c -o %t.seq
// RUN: %t.seq | FileCheck %s

// RUN: ent-opt %S/../../examples/damage.mlir \
// RUN:     --ent-lower-to-loops=fuse-systems=1 --symbol-dce \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.fused.ll
// RUN: clang -O2 -Wno-override-module %t.fused.ll \
// RUN:     -I%t.dir %S/../../examples/host/damage_main.c -o %t.fused
// RUN: %t.fused | FileCheck %s

// RUN: ent-opt %S/../../examples/damage.mlir --ent-schedule \
// RUN:     --ent-lower-to-loops=parallel-stages=1 --convert-scf-to-cf \
// RUN:     --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.stages.ll
// RUN: clang -O2 -Wno-override-module %t.stages.ll \
// RUN:     -I%t.dir %S/../../examples/host/damage_main.c %openmp -o %t.stages
// RUN: %t.stages | FileCheck %s

// RUN: ent-opt %S/../../examples/damage.mlir \
// RUN:     "--ent-lower-to-loops=parallel-entities=1 parallel-min-entities=1" \
// RUN:     --convert-scf-to-openmp --canonicalize --ent-omp-nowait \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.par.ll
// RUN: clang -O2 -Wno-override-module %t.par.ll \
// RUN:     -I%t.dir %S/../../examples/host/damage_main.c %openmp -o %t.par
// RUN: %t.par | FileCheck %s

// Frame 0: three torpedoes hit ship 0 (100 - 40 - 40 - 10 = 10), one sinks
// ship 1 (30 - 50). The new ship takes ship 1's slot; in frame 1 the last
// torpedo, aimed at ship 1, hits nothing.
// CHECK: frame 0: ships 1 torpedoes 1
// CHECK-NEXT: new ship reuses a slot: yes
// CHECK-NEXT: frame 1: ships 2 torpedoes 0
// CHECK-NEXT: ship 0: hp 10.0000
// CHECK-NEXT: ship 1: gone
// CHECK-NEXT: ship 2: hp 100.0000

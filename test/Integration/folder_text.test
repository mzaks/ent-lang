// A folder's names as one text (devices/files.ent: `folder_text`): each
// followed by a line end, in the order of their bytes, a folder's with
// "/"; none for a folder that is empty or not there, which `is_folder`
// tells apart. `write_text` writes a text as a file, which `read_text`
// gives back byte for byte, and `rename_file` moves it. From where the
// program is started, in a folder `made` that only this test makes (the
// program is run from Inputs too, by parallel_same.test, and writes
// nothing there).
// RUN: rm -rf %t.d && mkdir -p %t.d/made/sub %t.d/empty
// RUN: touch %t.d/made/b.txt %t.d/made/a.txt %t.d/made/.hidden
// RUN: cd %t.d && %ent run %S/Inputs/folder_text.ent | FileCheck %s

// CHECK:      [a.txt
// CHECK-NEXT: b.txt
// CHECK-NEXT: sub/
// CHECK-NEXT: ]
// CHECK-NEXT: empty: [] true
// CHECK-NEXT: none: [] false
// CHECK-NEXT: folders: true true false
// CHECK-NEXT: written: true
// CHECK-NEXT: read back: true 12
// CHECK-NEXT: [w.txt
// CHECK-NEXT: ]
// CHECK-NEXT: not written: false
// CHECK-NEXT: renamed: true -1 true
// CHECK-NEXT: not renamed: false

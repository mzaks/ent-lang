// RUN: mkdir -p %t.dir
// RUN: ent-translate --ent-to-c-header %S/../../examples/integrate.mlir \
// RUN:     -o %t.dir/integrate_world.h

// Lower the toy simulation to LLVM, link it with its C host and run it:
// as written, staged with parallel stages, fused, and fused with parallel
// entity loops. All must agree.
// RUN: ent-opt %S/../../examples/integrate.mlir --ent-lower-to-loops \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.seq.ll
// RUN: clang -O2 -Wno-override-module %t.seq.ll \
// RUN:     -I%t.dir %S/../../examples/host/integrate_main.c -o %t.seq
// RUN: %t.seq | FileCheck %s

// RUN: ent-opt %S/../../examples/integrate.mlir --ent-schedule \
// RUN:     --ent-lower-to-loops=parallel-stages=1 --convert-scf-to-cf \
// RUN:     --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.par.ll
// RUN: FileCheck %s --check-prefix=OMP --input-file=%t.par.ll
// RUN: clang -O2 -Wno-override-module %t.par.ll \
// RUN:     -I%t.dir %S/../../examples/host/integrate_main.c %openmp -o %t.par
// RUN: %t.par | FileCheck %s

// RUN: ent-opt %S/../../examples/integrate.mlir \
// RUN:     --ent-lower-to-loops=fuse-systems=1 --symbol-dce \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.fused.ll
// RUN: clang -O2 -Wno-override-module %t.fused.ll \
// RUN:     -I%t.dir %S/../../examples/host/integrate_main.c -o %t.fused
// RUN: %t.fused | FileCheck %s

// RUN: ent-opt %S/../../examples/integrate.mlir \
// RUN:     "--ent-lower-to-loops=fuse-systems=1 parallel-entities=1" \
// RUN:     --symbol-dce --convert-scf-to-openmp --canonicalize \
// RUN:     --ent-omp-nowait --convert-scf-to-cf --convert-to-llvm \
// RUN:     --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.fusedpar.ll
// RUN: clang -O2 -Wno-override-module %t.fusedpar.ll \
// RUN:     -I%t.dir %S/../../examples/host/integrate_main.c %openmp -o %t.fusedpar
// RUN: %t.fusedpar | FileCheck %s

// The first stage (gravity, wind, decay) forks a parallel region.
// OMP: call void {{.*}}@__kmpc_fork_call

// Three frames of dt = 0.5 with g = 9.81: gravity lowers dy by 4.905 per
// frame before integrate moves the body.
// CHECK: body 0: pos (1.5000, 85.2850) vel (1.0000, -14.7150)
// CHECK: body 1: pos (7.0000, 41.2850) vel (-2.0000, -10.7150)
// Particles have no mass, so gravity skips them; wind raises dx by 1 per
// frame before integrate, and decay takes 0.5 s of lifetime per frame.
// CHECK: particle 0: pos (6.0000, 1.5000) vel (5.0000, 1.0000) life 8.5000
// CHECK: particle 1: pos (6.0000, 1.5000) vel (3.0000, -1.0000) life 0.5000
// Scenery has no velocity, so nothing moves it.
// CHECK: scenery 0: pos (7.0000, 7.0000)
// The single player only moves: 3 frames of (1, 1) * 0.5.
// CHECK: player: pos (1.5000, 1.5000)
// tick ran once per frame.
// CHECK: frame: 3

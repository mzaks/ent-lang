// SENDS: day 3: sum 2894930 hub 1498500 3000
//
// A fraction sent to another rank's entity stops the program.
// RUN: %ent run %S/Inputs/ranks_sendfloat.ent
// RUN: not %ent run %S/Inputs/ranks_sendfloat.ent --ranks 2 2>&1 | FileCheck %s --check-prefix=SENDFLOAT
// SENDFLOAT: reads or sends to an entity that rank {{[0-9]}} has
//
// RUN: %ent run %S/Inputs/ranks_turn.ent > %t.turn.one
// RUN: %ent run %S/Inputs/ranks_turn.ent --ranks 4 > %t.turn.four
// RUN: diff %t.turn.one %t.turn.four
//
// A colony reads a colony another rank may have.
// RUN: %ent run %S/Inputs/ranks_cross.ent > %t.cross.one
// RUN: %ent run %S/Inputs/ranks_cross.ent --ranks 3 > %t.cross.three
// RUN: diff %t.cross.one %t.cross.three
// RUN: FileCheck %s --check-prefix=CROSS --input-file=%t.cross.three
// CROSS: day 3: all
//
// A lookup of a distributed entity from a `for` over entities every rank
// has is not made yet: the program stops.
// RUN: %ent run %S/Inputs/ranks_lookout.ent
// RUN: not %ent run %S/Inputs/ranks_lookout.ent --ranks 2 2>&1 | FileCheck %s --check-prefix=LOOKOUT
// LOOKOUT: reads or sends to an entity that rank {{[0-9]}} has
//
// What a `for` over distributed entities cannot do yet is said when the
// program is built.
// RUN: not %ent build %S/Inputs/ranks_refused.ent --ranks 2 -o %t.refused 2>&1 | FileCheck %s --check-prefix=REFUSED
// REFUSED: accumulates a value that is not a whole number
// RUN: not %ent build %S/Inputs/ranks_extern.ent --ranks 2 -o %t.extern 2>&1 | FileCheck %s --check-prefix=EXTERN
// EXTERN: runs the extern system @world.save_world, which works on the whole world

// CHECK-NEXT: ghost 1,2 dir 1 best 1 seen 7
// CHECK-NEXT: other sees 5
// CHECK-NEXT: ghost 4,3 dir 2 best 9 seen 7
// CHECK-NEXT: ghost 1,3 dir 1 best 0 seen 7
// CHECK-NEXT: other sees 4
// CHECK-NEXT: ghost 3,3 dir 2 best 4 seen 7
// CHECK-NEXT: ghost 2,3 dir 0 best 1 seen 7
// CHECK-NEXT: other sees 3
// CHECK-NOT:  {{.}}

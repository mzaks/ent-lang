// REQUIRES: gpu
// Systems on the GPU (docs/gpu.md): a program prints the same built with
// --gpu as without, and with --parallel as well.
// RUN: %ent run %S/Inputs/gpu_mix.ent > %t.cpu
// RUN: %ent run %S/Inputs/gpu_mix.ent --gpu > %t.gpu
// RUN: %ent run %S/Inputs/gpu_mix.ent --gpu --parallel > %t.gpupar
// RUN: diff %t.cpu %t.gpu
// RUN: diff %t.cpu %t.gpupar
// RUN: FileCheck %s --check-prefix=MIX --input-file=%t.gpu
// MIX: frame 10 moved 10 total 1293685.463344 hot 540
// MIX: frame 20 moved 20 total 1281302.013828 hot 1512
// MIX: frame 30 moved 30 total 1226484.675752 hot 2592

// Whole numbers sent to other entities and accumulated into uniques, many
// at once into the same few: combined atomically on the GPU, the same.
// RUN: %ent run %S/Inputs/gpu_sends.ent > %t.sends.cpu
// RUN: %ent run %S/Inputs/gpu_sends.ent --gpu > %t.sends.gpu
// RUN: %ent run %S/Inputs/gpu_sends.ent --gpu --parallel > %t.sends.gpupar
// RUN: diff %t.sends.cpu %t.sends.gpu
// RUN: diff %t.sends.cpu %t.sends.gpupar
// RUN: FileCheck %s --check-prefix=SENDS --input-file=%t.sends.gpu
// SENDS: frame 20 hits 665841 strongest 995 weakest 1 total -840697920

// Along relations' edges from both ends, in the shape of the epidemic's
// `workplace`, and writing the edges' own field: the same.
// RUN: %ent run %S/Inputs/gpu_edges.ent > %t.edges.cpu
// RUN: %ent run %S/Inputs/gpu_edges.ent --gpu > %t.edges.gpu
// RUN: %ent run %S/Inputs/gpu_edges.ent --gpu --parallel > %t.edges.gpupar
// RUN: diff %t.edges.cpu %t.edges.gpu
// RUN: diff %t.edges.cpu %t.edges.gpupar
// RUN: FileCheck %s --check-prefix=EDGES --input-file=%t.edges.gpu
// EDGES: day 20 total -13746309414 used 29694911

// Sent and accumulated from loops of the body, to entities found in a
// buffer by a fn, in the shape of the epidemic's `chance`: the same.
// RUN: %ent run %S/Inputs/gpu_chance.ent > %t.chance.cpu
// RUN: %ent run %S/Inputs/gpu_chance.ent --gpu > %t.chance.gpu
// RUN: %ent run %S/Inputs/gpu_chance.ent --gpu --parallel > %t.chance.gpupar
// RUN: diff %t.chance.cpu %t.chance.gpu
// RUN: diff %t.chance.cpu %t.chance.gpupar
// RUN: FileCheck %s --check-prefix=CHANCE --input-file=%t.chance.gpu
// CHANCE: frame 20 hits 2255790 longest 4 total 1459851081

// Running sums, with the systems that have them on the GPU: two passes and
// the scan between them there, the same.
// RUN: sed -e 's/^system lay/gpu system lay/' %S/Inputs/running.ent > %t.running.ent
// RUN: %ent run %S/Inputs/running.ent > %t.running.cpu
// RUN: %ent run %t.running.ent --gpu > %t.running.gpu
// RUN: %ent run %t.running.ent --gpu --parallel > %t.running.gpupar
// RUN: diff %t.running.cpu %t.running.gpu
// RUN: diff %t.running.cpu %t.running.gpupar
// RUN: grep -c "^gpu system lay" %t.running.ent | FileCheck %s --check-prefix=RUNNING
// RUNNING: 3

// Windows of a buffer, taken and only read, on the GPU: the same, and
// windows that overlap stop the program there too.
// RUN: sed -e 's/^system grow()/gpu system grow()/' -e 's/^system sum()/gpu system sum()/' %S/Inputs/windows.ent > %t.windows.ent
// RUN: %ent build %t.windows.ent --gpu -o %t.windows.gpu
// RUN: %ent build %t.windows.ent --gpu --parallel -o %t.windows.gpupar
// RUN: not --crash %t.windows.gpu > %t.windows.gpu.out
// RUN: not --crash %t.windows.gpupar > %t.windows.gpupar.out
// RUN: FileCheck %s --check-prefix=WINDOWS --input-file=%t.windows.gpu.out
// RUN: FileCheck %s --check-prefix=WINDOWS --input-file=%t.windows.gpupar.out
// WINDOWS: day 1: bees 6022623 old 0 check 295054712
// WINDOWS: day 2: bees 6024744 old 11995 check 295417618
// WINDOWS-NOT: day 3

// Rows of a buffer given to a proc from a window, in the GPU's loop: the
// same.
// RUN: sed -e 's/^system grow()/gpu system grow()/' %S/Inputs/rows_param.ent > %t.rowsparam.ent
// RUN: %ent run %t.rowsparam.ent --gpu > %t.rowsparam.gpu
// RUN: %ent run %t.rowsparam.ent --gpu --parallel > %t.rowsparam.gpupar
// RUN: FileCheck %s --check-prefix=ROWSPARAM --input-file=%t.rowsparam.gpu
// RUN: FileCheck %s --check-prefix=ROWSPARAM --input-file=%t.rowsparam.gpupar
// ROWSPARAM: day 1: 8658706275
// ROWSPARAM: day 2: 27198004409
// ROWSPARAM: day 3: 35233480806

// Rows of buffers written from a `for`, on the GPU: the same, and two
// entities that write one row stop the program there too.
// RUN: sed -e 's/^system lay()/gpu system lay()/' %S/Inputs/buffer_rows.ent > %t.rows.ent
// RUN: %ent build %t.rows.ent --gpu -o %t.rows.gpu
// RUN: %ent build %t.rows.ent --gpu --parallel -o %t.rows.gpupar
// RUN: not --crash %t.rows.gpu > %t.rows.gpu.out
// RUN: not --crash %t.rows.gpupar > %t.rows.gpupar.out
// RUN: FileCheck %s --check-prefix=ROWS --input-file=%t.rows.gpu.out
// RUN: FileCheck %s --check-prefix=ROWS --input-file=%t.rows.gpupar.out
// ROWS: day 1: stubs 639985 rows 80000 check 1272241970273
// ROWS: day 2: stubs 870584 rows 80000 check 1730780109152
// ROWS-NOT: day 3
// RUN: grep -c "^gpu system lay" %t.rows.ent | FileCheck %s --check-prefix=ROWSGPU
// ROWSGPU: 1

// `math`'s fns on the GPU: written in ent from what IEEE 754 rounds
// exactly, the same bits as on the CPU.
// RUN: %ent run %S/Inputs/gpu_math.ent > %t.math.cpu
// RUN: %ent run %S/Inputs/gpu_math.ent --gpu > %t.math.gpu
// RUN: %ent run %S/Inputs/gpu_math.ent --gpu --parallel > %t.math.gpupar
// RUN: diff %t.math.cpu %t.math.gpu
// RUN: diff %t.math.cpu %t.math.gpupar
// RUN: FileCheck %s --check-prefix=MATH --input-file=%t.math.gpu
// MATH:      exp/log 2730369242159562985
// MATH-NEXT: pow 7739633407689454243
// MATH-NEXT: sin/cos 8859017031914014129
// MATH-NEXT: whole/root 11526708017173365729
// MATH-NEXT: f32 214698088967999
// MATH-NEXT: tan/atan/asin/log2/fmod 9233774169533248285

// Tables read in a `gpu system`, and in a fn it calls: the same rows.
// RUN: %ent run %S/Inputs/gpu_table.ent > %t.table.cpu
// RUN: %ent run %S/Inputs/gpu_table.ent --gpu > %t.table.gpu
// RUN: diff %t.table.cpu %t.table.gpu
// RUN: FileCheck %s --check-prefix=TABLE --input-file=%t.table.gpu
// TABLE: x 3787.75 p 5863 n 9987287989808968184

// A few rows of big columns written on the GPU come back as the words
// that changed, the same as whole and as on the CPU.
// RUN: %ent run %S/Inputs/gpu_rows.ent > %t.cells.cpu
// RUN: env ENT_GPU_REPORT=1 %ent run %S/Inputs/gpu_rows.ent --gpu > %t.cells.gpu 2> %t.cells.report
// RUN: env ENT_GPU_WHOLE=1 %ent run %S/Inputs/gpu_rows.ent --gpu > %t.cells.whole
// RUN: diff %t.cells.cpu %t.cells.gpu
// RUN: diff %t.cells.cpu %t.cells.whole
// RUN: FileCheck %s --check-prefix=PACKED --input-file=%t.cells.report
// PACKED: gpu to host: 3200000 bytes whole, 117782 words packed of 29200000

// A tree of one level on the GPU: a sum into each parent (`bottom up`,
// atomic), a read of it from each child; people move house on the CPU.
// RUN: %ent run %S/Inputs/gpu_tree.ent > %t.tree.cpu
// RUN: %ent run %S/Inputs/gpu_tree.ent --gpu > %t.tree.gpu
// RUN: %ent run %S/Inputs/gpu_tree.ent --gpu --parallel > %t.tree.gpupar
// RUN: diff %t.tree.cpu %t.tree.gpu
// RUN: diff %t.tree.cpu %t.tree.gpupar
// RUN: FileCheck %s --check-prefix=TREE --input-file=%t.tree.gpu
// TREE: frame 30 got 3350402912 sum 9985890 most 363755

// Edge loops on the GPU in a world of several archetypes.
// RUN: %ent run %S/Inputs/gpu_lookup.ent > %t.lookup.cpu
// RUN: %ent run %S/Inputs/gpu_lookup.ent --gpu --parallel > %t.lookup.gpupar
// RUN: diff %t.lookup.cpu %t.lookup.gpupar

// No kernel touches the CPU's world: with ENT_GPU_PROTECT it is out of
// reach while each kernel runs (with HMM such a kernel would not fault).
// RUN: env ENT_GPU_PROTECT=1 %ent run %S/Inputs/gpu_lookup.ent --gpu > %t.lookup.protected
// RUN: diff %t.lookup.cpu %t.lookup.protected
// RUN: env ENT_GPU_PROTECT=1 %ent run %S/Inputs/gpu_edges.ent --gpu > %t.edges.protected
// RUN: diff %t.edges.cpu %t.edges.protected
// RUN: env ENT_GPU_PROTECT=1 %ent run %S/Inputs/gpu_chance.ent --gpu > %t.chance.protected
// RUN: diff %t.chance.cpu %t.chance.protected
// RUN: env ENT_GPU_PROTECT=1 %ent run %S/Inputs/gpu_tree.ent --gpu > %t.tree.protected
// RUN: diff %t.tree.cpu %t.tree.protected
// RUN: env ENT_GPU_PROTECT=1 %ent run %S/Inputs/gpu_rows.ent --gpu > %t.cells.protected
// RUN: diff %t.cells.cpu %t.cells.protected

// The epidemic with its systems on the GPU builds: the lowering checks
// that no loop for the GPU uses the CPU's world (`workplace`'s lookups
// read the archetypes' counts from it).
// RUN: rm -rf %t.epidemic && mkdir -p %t.epidemic
// RUN: cp %S/../../examples/epidemic/city.ent %S/../../examples/epidemic/disease.ent %S/../../examples/epidemic/epidemic.ent %S/../../examples/epidemic/interventions.ent %S/../../examples/epidemic/parameters.ent %S/../../examples/epidemic/random.ent %t.epidemic/
// RUN: sed -E 's/^system (workplace|chance|lay|infect|household)\(/gpu system \1(/' %S/../../examples/epidemic/transmission.ent > %t.epidemic/transmission.ent
// RUN: %ent build --gpu %t.epidemic/epidemic.ent -o %t.epidemic/run

// A `gpu system` of an imported module: its kernel's name has no `.`.
// RUN: %ent run %S/Inputs/gpu_module.ent --gpu | FileCheck %s --check-prefix=MODULE
// MODULE: frame 10 sum 529470

// examples/integrate.ent with its C host (examples/host/integrate_main.c,
// as in integrate.test), the host built with ENT_GPU: it asks for the
// world back from the GPU before it reads it.
// RUN: mkdir -p %t.dir
// RUN: ent-translate --import-ent %S/../../examples/integrate.ent -o %t.mlir
// RUN: ent-translate --ent-to-c-header %t.mlir -o %t.dir/integrate_world.h
// RUN: ent-opt %t.mlir "--ent-lower-to-loops=fuse-systems=1 gpu=1" \
// RUN:     --symbol-dce --cse --ent-lower-views \
// RUN:     --convert-parallel-loops-to-gpu --gpu-kernel-outlining \
// RUN:     --ent-gpu-kernel-names \
// RUN:     --lower-affine --convert-scf-to-cf \
// RUN:     "--nvvm-attach-target=chip=%gpu-chip features=+ptx80" \
// RUN:     --convert-gpu-to-nvvm --reconcile-unrealized-casts \
// RUN:     --convert-to-llvm --gpu-to-llvm --reconcile-unrealized-casts \
// RUN:     --gpu-module-to-binary=format=isa \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.ll
// RUN: clang -O2 -Wno-override-module -c %t.ll -o %t.o
// RUN: %host-cc -O2 -DENT_GPU -I%cuda-include -I%t.dir \
// RUN:     %S/../../examples/host/integrate_main.c \
// RUN:     %S/../../devices/gpu.c %t.o -lcuda -o %t.exe
// RUN: %t.exe | FileCheck %s
// CHECK: body 0: pos (1.5000, 85.2850) vel (1.0000, -14.7150)
// CHECK: body 1: pos (7.0000, 41.2850) vel (-2.0000, -10.7150)
// CHECK: particle 0: pos (6.0000, 1.5000) vel (5.0000, 1.0000) life 8.5000
// CHECK: particle 1: pos (6.0000, 1.5000) vel (3.0000, -1.0000) life 0.5000
// CHECK: scenery 0: pos (7.0000, 7.0000)
// CHECK: player: pos (1.5000, 1.5000)
// CHECK: frame: 3

// A `for ... by` whose body only gives rows to buffers: its entities (of
// two archetypes, 301,000) listed, sorted and visited on the GPU, each
// entity's rows at its place in the order: the same rows in the same
// order, frame by frame as the keys change (many the same, some below
// nought).
// RUN: %ent run %S/Inputs/gpu_by.ent > %t.by.cpu
// RUN: %ent run %S/Inputs/gpu_by.ent --gpu > %t.by.gpu
// RUN: %ent run %S/Inputs/gpu_by.ent --gpu --parallel > %t.by.gpupar
// RUN: diff %t.by.cpu %t.by.gpu
// RUN: diff %t.by.cpu %t.by.gpupar
// RUN: FileCheck %s --check-prefix=BY --input-file=%t.by.gpu
// BY: frame 0 rows 602000 301000 hash 5544980611785813485 2835094989288384706 first -2500 last 2500
// BY: frame 2 rows 602000 301000 hash 8746012038621469105 2451871882340062265 first -10000 last 10000

// Rows given to buffers from `for`s of a `gpu` system (two archetypes,
// every entity and those under an `if`, two `for`s one after the other
// into one buffer): put in the order of the entities on the GPU, read
// there by the next system, the same as on the CPU.
// RUN: %ent run %S/Inputs/gpu_given.ent > %t.given.cpu
// RUN: %ent run %S/Inputs/gpu_given.ent --gpu > %t.given.gpu
// RUN: %ent run %S/Inputs/gpu_given.ent --gpu --parallel > %t.given.gpupar
// RUN: diff %t.given.cpu %t.given.gpu
// RUN: diff %t.given.cpu %t.given.gpupar
// RUN: FileCheck %s --check-prefix=GIVEN --input-file=%t.given.gpu
// GIVEN: frame 0 rows 201000 61506 hash 490018650532524284 10378687888565092654
// GIVEN: frame 2 rows 201000 61612 hash 4885933534860777026 6311147305899071910

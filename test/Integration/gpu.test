// RUN: sed -e 's/^system count()/gpu system count()/' -e 's/^system move()/gpu system move()/' %S/Inputs/morton_moving.ent > %t.mgpu.ent
// RUN: %ent run %S/Inputs/morton_moving.ent > %t.mgpu.cpu
// RUN: %ent build %t.mgpu.ent --gpu -o %t.mgpu
// RUN: %ent run %t.mgpu.ent --gpu --parallel > %t.mgpu.gpupar

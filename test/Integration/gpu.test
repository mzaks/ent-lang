// Windows of a buffer, taken and only read, on the GPU: the same, and
// windows that overlap stop the program there too.
// RUN: sed -e 's/^system grow()/gpu system grow()/' -e 's/^system sum()/gpu system sum()/' %S/Inputs/windows.ent > %t.windows.ent
// RUN: %ent build %t.windows.ent --gpu -o %t.windows.gpu
// RUN: %ent build %t.windows.ent --gpu --parallel -o %t.windows.gpupar
// RUN: not --crash %t.windows.gpu > %t.windows.gpu.out
// RUN: not --crash %t.windows.gpupar > %t.windows.gpupar.out

// `math`'s fns on the GPU: written in ent from what IEEE 754 rounds
// exactly, the same bits as on the CPU.
// RUN: %ent run %S/Inputs/gpu_math.ent > %t.math.cpu
// RUN: %ent run %S/Inputs/gpu_math.ent --gpu > %t.math.gpu
// RUN: %ent run %S/Inputs/gpu_math.ent --gpu --parallel > %t.math.gpupar

// K-d trees whose readers are all `gpu` systems, made on the GPU
// (`N_update_gpu`): a walk with the cells' masses, `near` and `nearest`,
// and leaves of none, the same as on the CPU frame by frame; and the
// Morton index's programs with a k-d tree in its place.
// RUN: %ent run %S/Inputs/kdtree_gpu.ent > %t.kd.cpu
// RUN: %ent build %S/Inputs/kdtree_gpu.ent --gpu -o %t.kd
// RUN: %t.kd | diff %t.kd.cpu -
// RUN: env ENT_GPU_PROTECT=1 %t.kd | diff %t.kd.cpu -
// RUN: %ent run %S/Inputs/kdtree_gpu.ent --gpu --parallel | diff %t.kd.cpu -
// RUN: nm %t.kd > %t.kd.nm
// RUN: FileCheck %s --check-prefix=KDGPU --input-file=%t.kd.nm
// RUN: not grep -q "_update$" %t.kd.nm
// RUN: FileCheck %s --check-prefix=KD --input-file=%t.kd.cpu
// KDGPU-DAG: Tree_update_gpu
// KDGPU-DAG: Flat_update_gpu
// KD: frame 0: leaf rows 3066158 far mass 2887343.474397 near 2106786 spots -19
// KD: frame 3: leaf rows 2874158 far mass 2998383.13915 near 2124106 spots -84
// RUN: sed -E -e 's/morton \(([^)]*)\)( bits [0-9]+)?/kdtree (\1)/' -e 's/^system count\(\)/gpu system count()/' -e 's/^system move\(\)/gpu system move()/' %S/Inputs/morton_moving.ent > %t.kdmove.ent
// RUN: %ent run %t.kdmove.ent > %t.kdmove.cpu
// RUN: %ent run %t.kdmove.ent --gpu | diff %t.kdmove.cpu -
// RUN: sed -E -e 's/morton \(([^)]*)\)( bits [0-9]+)?/kdtree (\1)/' %t.m3.ent > %t.kd3.ent
// RUN: sed -E -e 's/morton \(([^)]*)\)( bits [0-9]+)?/kdtree (\1)/' %t.mwhole.ent > %t.kdwhole.ent
// RUN: sed -E -e 's/morton \(([^)]*)\)( bits [0-9]+)?/kdtree (\1)/' %t.mwrap.ent > %t.kdwrap.ent
// RUN: %ent run %t.kd3.ent > %t.kd3.cpu
// RUN: %ent run %t.kd3.ent --gpu | diff %t.kd3.cpu -
// RUN: %ent run %t.kdwhole.ent > %t.kdwhole.cpu
// RUN: %ent run %t.kdwhole.ent --gpu | diff %t.kdwhole.cpu -
// RUN: %ent run %t.kdwrap.ent > %t.kdwrap.cpu
// RUN: %ent run %t.kdwrap.ent --gpu --parallel | diff %t.kdwrap.cpu -
// RUN: sed -E -e 's/morton \(([^)]*)\)( bits [0-9]+)?/kdtree (\1)/' %S/Inputs/gpu_nearest.ent > %t.kdnearest.ent
// RUN: %ent run %t.kdnearest.ent > %t.kdnearest.cpu
// RUN: %ent run %t.kdnearest.ent --gpu | diff %t.kdnearest.cpu -

// The k nearest of every dot in a grid and a Morton index, in a `gpu`
// system, k a unique's: each dot's list a part of an array made before
// the kernel, not of the GPU's heap; both indexes made on the GPU.
// RUN: %ent run %S/Inputs/gpu_nearest.ent > %t.nearest.cpu
// RUN: %ent build %S/Inputs/gpu_nearest.ent --gpu -o %t.nearest
// RUN: %t.nearest | diff %t.nearest.cpu -
// RUN: %ent run %S/Inputs/gpu_nearest.ent --gpu --parallel | diff %t.nearest.cpu -
// RUN: env ENT_GPU_PROTECT=1 %t.nearest | diff %t.nearest.cpu -
// RUN: FileCheck %s --check-prefix=NEAREST --input-file=%t.nearest.cpu
// RUN: strings %t.nearest | not grep -q "func_retval0) malloc"
// NEAREST: frame 0: 0 differ, sum 262073433
// NEAREST: frame 3: 0 differ, sum 261969676

// A `for ... by` on the GPU whose keys' range (0x100) has a lowest byte
// of nought: a pass for every byte up to its highest, in order.
// RUN: %ent run %S/Inputs/gpu_by_carry.ent > %t.carry.cpu
// RUN: %ent run %S/Inputs/gpu_by_carry.ent --gpu | diff %t.carry.cpu -
// RUN: FileCheck %s --check-prefix=CARRY --input-file=%t.carry.cpu
// CARRY: rows 3000 unsorted 0 sum 6761301124

// Windows a `gpu` system only writes, counted where they start and end:
// rows of their own on the first day, two windows over a row on the
// second, which stops the program, on the GPU as on the CPU.
// RUN: %ent build %S/Inputs/gpu_window_clash.ent -o %t.wclash.cpu
// RUN: %ent build %S/Inputs/gpu_window_clash.ent --gpu -o %t.wclash.gpu
// (Unbuffered: what the program says before it stops is kept.)
// RUN: not --crash stdbuf -o0 %t.wclash.cpu > %t.wclash.cpu.out
// RUN: not --crash stdbuf -o0 %t.wclash.gpu > %t.wclash.gpu.out
// RUN: diff %t.wclash.cpu.out %t.wclash.gpu.out
// RUN: FileCheck %s --check-prefix=WCLASH --input-file=%t.wclash.gpu.out
// WCLASH: day 0: 35986500500
// WCLASH-NEXT: window of the buffer @Marks
// WCLASH-NOT: day 1

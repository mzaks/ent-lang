// A `for` that writes a buffer through windows and also reads it by its
// name reads it as it was before the `for`, rows the windows take too:
// as a copy made first would give, for one core and for all of them.
// RUN: %ent build %S/Inputs/window_reads.ent -o %t.one
// RUN: %ent build %S/Inputs/window_reads.ent --parallel -o %t.all
// RUN: %t.one > %t.one.out
// RUN: %t.all > %t.all.out
// RUN: diff %t.one.out %t.all.out
// RUN: FileCheck %s --input-file=%t.one.out
// CHECK: day 1: check {{[0-9]+}} same true
// CHECK: day 2: check {{[0-9]+}} same true
// CHECK: day 3: check {{[0-9]+}} same true
// Windows that overlap still stop the program.
// RUN: sed -e 's/w: mut Cells\[h.start, h.size\]/w: mut Cells[h.start, h.size + 1]/' %S/Inputs/window_reads.ent > %t.over.ent
// RUN: %ent build %t.over.ent -o %t.over
// RUN: not --crash %t.over > %t.over.out
// RUN: FileCheck %s --check-prefix=OVER --allow-empty --input-file=%t.over.out
// OVER-NOT: day 1

// Relations end to end: missiles steer towards their target ship through
// ent.lookup; a despawned target makes the lookup report "not found". Run
// as written, fused (systems with lookups stay calls), staged with
// parallel stages, and with parallel entity loops forced on (the lookup
// query runs in parallel); all agree.
// RUN: mkdir -p %t.dir
// RUN: ent-translate --ent-to-c-header %S/../../examples/homing.mlir \
// RUN:     -o %t.dir/homing_world.h

// RUN: ent-opt %S/../../examples/homing.mlir --ent-lower-to-loops \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.seq.ll
// RUN: clang -O2 -Wno-override-module %t.seq.ll \
// RUN:     -I%t.dir %S/../../examples/host/homing_main.c -o %t.seq
// RUN: %t.seq | FileCheck %s

// RUN: ent-opt %S/../../examples/homing.mlir \
// RUN:     --ent-lower-to-loops=fuse-systems=1 --symbol-dce \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.fused.ll
// RUN: clang -O2 -Wno-override-module %t.fused.ll \
// RUN:     -I%t.dir %S/../../examples/host/homing_main.c -o %t.fused
// RUN: %t.fused | FileCheck %s

// RUN: ent-opt %S/../../examples/homing.mlir --ent-schedule \
// RUN:     --ent-lower-to-loops=parallel-stages=1 --convert-scf-to-cf \
// RUN:     --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.stages.ll
// RUN: clang -O2 -Wno-override-module %t.stages.ll \
// RUN:     -I%t.dir %S/../../examples/host/homing_main.c %openmp -o %t.stages
// RUN: %t.stages | FileCheck %s

// RUN: ent-opt %S/../../examples/homing.mlir \
// RUN:     "--ent-lower-to-loops=parallel-entities=1 parallel-min-entities=1" \
// RUN:     --convert-scf-to-openmp --canonicalize --ent-omp-nowait \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.par.ll
// RUN: clang -O2 -Wno-override-module %t.par.ll \
// RUN:     -I%t.dir %S/../../examples/host/homing_main.c %openmp -o %t.par
// RUN: %t.par | FileCheck %s

// The same program written in ent-lang (examples/homing.ent), imported,
// with its own header, prints the same.
// RUN: mkdir -p %t.ent
// RUN: ent-translate --import-ent %S/../../examples/homing.ent -o %t.ent.mlir
// RUN: ent-translate --ent-to-c-header %t.ent.mlir -o %t.ent/homing_world.h
// RUN: ent-opt %t.ent.mlir --ent-lower-to-loops --convert-scf-to-cf \
// RUN:     --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.ent.ll
// RUN: clang -O2 -Wno-override-module %t.ent.ll \
// RUN:     -I%t.ent %S/../../examples/host/homing_main.c -o %t.entexe
// RUN: %t.entexe | FileCheck %s

// dt = 0.5, gain 1. Ship 1 (15, +4) passes the edge at 20 in frame 3 and is
// despawned; in frame 4 missile 1's lookup fails and it keeps dx = 6.75.
// Missile 0 closes in on ship 0: dx 10, 5.5, 3.25, 2.125.
// CHECK: ships: 1
// CHECK-NEXT: ship 0: x 12.0000
// CHECK-NEXT: ship 1: gone
// CHECK-NEXT: missile 0: x 10.4375 dx 2.1250 target alive
// CHECK-NEXT: missile 1: x 19.0000 dx 6.7500 target gone

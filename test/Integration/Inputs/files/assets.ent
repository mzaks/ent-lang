// A module that has a file of its own next to it (files.test).

// Says the first line of a file, or that it is not there.
extern proc show(file: text[62])

// (The module's own file goes where a program with it is built.)
// By a name, which is the text that names it; and every file of a name
// with a `*` in it, as a list in the files' order (2 before 10).
asset own = "module_words.txt"
asset steps = "steps/step*.txt"
proc show_own() { show(own) }
proc show_steps() { for step in steps { show(step) } }

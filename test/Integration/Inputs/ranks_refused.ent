// On many ranks: a `for` over distributed cells that sets a unique with
// `=`, where the last row wins: refused when the program is built
// (ranks.test). (In `main`'s loop: before it, the setup, every rank goes
// through all.)
import console
component Cell { number: i32 } capacity 100
distribute Cell by number
unique Last: i32
system mark() { for c: Cell { Last = c.number } }
system report() { put("last {Last}") }
schedule frame() { mark()  report() }
world { for i in 0..10 { spawn { Cell { number: i } } } }
main { loop { frame() } until Last > 1 }

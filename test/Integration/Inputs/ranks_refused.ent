// On many ranks: a `for` over distributed cells that adds fractions into
// a unique, which the ranks' parts would add up in another order than
// one process: refused when the program is built (ranks.test).
import console
component Cell { number: i32, weight: f32 } capacity 100
distribute Cell by number
unique Total: f32
system weigh() {
  Total = 0.0
  for c: Cell { Total += c.weight }
}
system report() { put("total {Total}") }
schedule frame() { weigh()  report() }
world { for i in 0..10 { spawn { Cell { number: i, weight: 0.5 } } } }
main { frame() }

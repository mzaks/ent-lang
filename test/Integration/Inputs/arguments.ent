// The words a program is started with, a variable of its environment,
// and the status it ends with
// (arguments.test).
import console
import text

system go() {
  let n = argument_count()
  put("{n} words")
  for i in 0..n { put("[{argument(i)}]") }
  put("past the last: [{argument(n)}] [{argument(-1)}]")
  let word = environment_variable("ENT_TEST_WORD")
  let none = environment_variable("ENT_TEST_NONE")
  let no_name = environment_variable("")
  put("variable: [{word}] [{none}] [{no_name}]")
  put_error("to standard error")
  if n > 0 { exit_status(number(argument(0)) as i32) }
}

schedule run() { go() }
main { run() }

// A program a C host runs, with texts of any length (text_host.test).
import text

component Note { words: text, n: i32 }
unique Title: text
default_capacity 16

// Implemented by the host: prints the notes, each after `before`.
extern system report(before: text) reads Note, Title
// (A text of a capacity crosses both ways too: as a pointer to it.)
extern system stamp(mark: text[14], n: i32)

system add(name: text, n: i32) {
  spawn { Note { words: name + " " + "{n}", n: n } }
  Title = "last: " + name
}
system grow() {
  for n: mut Note { n.words += "!" }
}

schedule frame(name: text, n: i32) {
  add(name, n)
  grow()
  report("- " + name + ": ")
}
schedule mark(with: text[14], n: i32) {
  stamp(with, n + 1)
}

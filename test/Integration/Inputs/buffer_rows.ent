// Rows of buffers written from a `for` (docs/syntax.md), in the shape of
// the epidemic's `lay`: each entity writes its own row of `Order`, at
// the place a running sum gives it, and the rows of `Index` for its
// stubs at a multiple of 64, from a loop of its body, at the place a
// running sum of how many those are gives it (one made of the first).
// Built for one core, for all of them and with `lay` on the GPU
// (gpu.test), it prints the same; on the third day some entities also
// write the row after their own, and the program stops.
import console

component Stubs { meets: i32 } capacity 100000
buffer Order { who: entity, first: i32 } capacity 100000
buffer Index { row: i32 } capacity 100000
unique Laying { stubs: i32, rows: i32, slots: i32, clash: bool }
unique Check: i64
unique Days: i32

system lay() {
  Laying.stubs = 0
  Laying.rows = 0
  Laying.slots = 0
  for e, s: Stubs {
    let row = Laying.rows += 1
    let first = Laying.stubs += s.meets
    Order[row].who = e
    Order[row].first = first
    // (The stubs at a multiple of 64 among its own: their rows of Index
    // are those before them, from the running sum of how many each has.)
    let many = (first + s.meets + 63) / 64 - (first + 63) / 64
    let slot = Laying.slots += many
    for k in 0..many { Index[slot + k].row = row }
    // (On the third day some write the row after their own.)
    if Laying.clash && row % 1000 == 7 { Order[row + s.meets % 2].first = 0 }
  }
}
system finish() { Order[Laying.rows].first = Laying.stubs }
system check() {
  Check = 0
  for i in 0..Laying.rows + 1 { Check += Order[i].first as i64 * (i % 97 + 1) as i64 }
  for i in 0..(Laying.stubs + 63) / 64 { Check += Index[i].row as i64 * (i % 89 + 1) as i64 }
  spawn { Print { line: "day {Days}: stubs {Laying.stubs} rows {Laying.rows} check {Check}" } }
}
system grow() {
  for s: mut Stubs { s.meets = (s.meets * 13 + 7) % 23 }
}
system count() {
  Days += 1
  Laying.clash = Days == 3
}
schedule day() { count()  lay()  finish()  check()  write()  clear()  grow() }

world {
  for i in 0..80001 { Order += { who: none, first: 0 } }
  for i in 0..20000 { Index += { row: 0 } }
  for i in 0..80000 { spawn { Stubs { meets: i % 17 } } }
}

main {
  loop { day() } until Days == 3
}

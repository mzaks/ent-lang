// A small window laid out by examples/layout.ent and printed
// (layout.test): a side bar of a fixed width, and next to it a header as
// high as its two buttons need, a body with the room that is left, and
// in the body two columns that share its width.
import console
import layout

component Name { name: text[14] }
unique Frame: i32
default_capacity 64

world {
  let root = spawn {
    Box { x: 0.0, y: 0.0, w: 800.0, h: 600.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 10.0, gap: 10.0 }, Name { name: "root" }
  }
  let side = spawn {
    Box { x: 0.0, y: 0.0, w: 200.0, h: 0.0 },
    Size { w: Sizing.Fixed, h: Sizing.Grow },
    Stack { row: false, pad: 8.0, gap: 4.0 }, Name { name: "side" },
    Align { x: Place.Middle, y: Place.Start }
  }
  let rest = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Grow, h: Sizing.Grow },
    Stack { row: false, pad: 0.0, gap: 6.0 }, Name { name: "rest" }
  }
  connect (side)-[Inside]->(root)
  connect (rest)-[Inside]->(root)

  let header = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Grow, h: Sizing.Fit },
    Stack { row: true, pad: 5.0, gap: 3.0 }, Name { name: "header" }
  }
  let body = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Grow, h: Sizing.Grow },
    Stack { row: true, pad: 0.0, gap: 20.0 }, Name { name: "body" }
  }
  connect (header)-[Inside]->(rest)
  connect (body)-[Inside]->(rest)

  let ok = spawn {
    Box { x: 0.0, y: 0.0, w: 60.0, h: 20.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Name { name: "ok" },
    Slot { at: 0 }
  }
  let cancel = spawn {
    Box { x: 0.0, y: 0.0, w: 90.0, h: 30.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Name { name: "cancel" },
    Slot { at: 1 }
  }
  connect (ok)-[Inside]->(header)
  connect (cancel)-[Inside]->(header)

  let left = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Grow, h: Sizing.Grow },
    Stack { row: false, pad: 0.0, gap: 0.0 }, Name { name: "left" }
  }
  let right = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Grow, h: Sizing.Grow },
    Stack { row: false, pad: 0.0, gap: 0.0 }, Name { name: "right" }
  }
  connect (left)-[Inside]->(body)
  connect (right)-[Inside]->(body)

  // In the side bar, in the middle across it.
  let item = spawn {
    Box { x: 0.0, y: 0.0, w: 40.0, h: 20.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Name { name: "item" }
  }
  connect (item)-[Inside]->(side)

  let badge = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Fit, h: Sizing.Fit },
    Stack { row: true, pad: 3.0, gap: 0.0 }, Name { name: "badge" },
    Float { dx: 4.0, dy: 2.0 }
  }
  let dot = spawn {
    Box { x: 0.0, y: 0.0, w: 10.0, h: 8.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Name { name: "dot" }
  }
  connect (badge)-[Over]->(header)
  connect (dot)-[Inside]->(badge)
  let mark = spawn {
    Box { x: 0.0, y: 0.0, w: 4.0, h: 4.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Name { name: "mark" },
    Float { dx: 1.0, dy: 1.0 }
  }
  connect (mark)-[Over]->(dot)
  // And once more: a pin inside the mark, and a speck over the pin.
  let pin = spawn {
    Box { x: 0.0, y: 0.0, w: 2.0, h: 2.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Name { name: "pin" }
  }
  let speck = spawn {
    Box { x: 0.0, y: 0.0, w: 1.0, h: 1.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Name { name: "speck" },
    Float { dx: 1.0, dy: 1.0 }
  }
  connect (pin)-[Inside]->(mark)
  connect (speck)-[Over]->(pin)
}

// A badge floats over the header, 4 in and 2 down from its corner, with
// a dot inside it, and over the dot floats a mark; and the side bar puts
// what is in it in the middle.
//
// In the second frame the side bar is narrower, in the third the body's
// columns are below one another, and in the fourth the first button is
// given a later slot than the second.
system change() {
  Frame += 1
  for b: mut Box, n: Name where Frame == 2 && b.w == 200.0 { b.w = 100.0 }
  for k: mut Stack where Frame == 3 && k.gap == 20.0 { k.row = false }
  for s: mut Slot where Frame == 4 && s.at == 0 { s.at = 2 }
}

system show() {
  for b: Box, n: Name, l: Layer {
    put("{Frame}: {n.name} {b.x} {b.y} {b.w} {b.h} layer {l.z}")
  }
  flush()
}

schedule frame() { change()  layout()  show() }
main { loop { frame() } until Frame == 4 }

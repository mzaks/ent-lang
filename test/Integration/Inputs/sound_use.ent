// The sound device (devices/sound.ent): a tune of made-up tones, one that
// slides, and a file.
import sound
import clock
import console
world { FrameRate = 60.0 }
system tune() {
  if Time.frame == 1 {
    for i in 0..5 {
      spawn { Tone { pitch: 262.0 + i as f32 * 80.0, to: 0.0, seconds: 0.12, after: i as f32 * 0.15, volume: 0.2, wave: (i % 4) as Wave } }
    }
    spawn { Tone { pitch: 200.0, to: 900.0, seconds: 0.3, after: 0.9, volume: 0.2, wave: Wave.Square } }
    spawn { Sample { file: "hit.wav", volume: 1.0 } }
    spawn { Print { line: "playing" } }
  }
}
schedule frame() { tick() tune() play() write() clear() }
main { loop { frame() } until Time.now > 1.6 }

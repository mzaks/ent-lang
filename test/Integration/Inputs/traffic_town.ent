// The seven scenes of examples/traffic/town.ent, ten minutes each with 600
// cars an hour on every street (3,600 on the highway, 720 on its ramp),
// more than the lights, the stops and the highway let through: how many
// cars went through, how often one changed lanes, in how many steps a car
// stood on the car ahead, and in how many two cars on different roads
// came within 2.5 m of each other (where their paths cross, join or
// split, or in lanes side by side).
import console
import town

unique Close { n: i64 }

world {
  Sim.dt = 0.05
  Sim.seed = 7
  Sim.inflow = 600.0
}

system close() {
  for i in 0..len(Flow) {
    for j in i + 1..len(Flow) {
      let ri = Flow[i].road
      let rj = Flow[j].road
      if ri != rj {
        let ti = Flow[i].u / Roads[ri].length
        let tj = Flow[j].u / Roads[rj].length
        let dx = bez(Roads[ri].x0, Roads[ri].cx, Roads[ri].x1, ti) -
                 bez(Roads[rj].x0, Roads[rj].cx, Roads[rj].x1, tj)
        let dy = bez(Roads[ri].y0, Roads[ri].cy, Roads[ri].y1, ti) -
                 bez(Roads[rj].y0, Roads[rj].cy, Roads[rj].y1, tj)
        if dx * dx + dy * dy < 6.25 { Close.n += 1 }
      }
    }
  }
}

system report() {
  put("scene {Sim.scene}: {Sim.gone} through, {Sim.changes} lane changes, {Sim.overlaps} overlaps, {Close.n} close")
  Sim.scene += 1
  Sim.overlaps = 0
  Close.n = 0
}

// Then the lights again with 45 s of green for north and south and 10
// for east and west, and the on-ramp with drivers who are not polite at
// all: nobody lets anyone in.
system retune() {
  Sim.green_ns = 45.0
  Sim.green_ew = 10.0
  Sim.polite = 0.0
  Sim.scene = 0
}
system again() { Sim.scene = 4 }

schedule tell() { report() }
schedule tune() { retune() }
schedule ramp() { again() }

schedule tick() {
  lay()
  step()
  close()
}

main {
  loop {
    loop { tick() } until Sim.time >= 600.0
    tell()
  } until Sim.scene == 7
  tune()
  loop { tick() } until Sim.time >= 600.0
  tell()
  ramp()
  loop { tick() } until Sim.time >= 600.0
  tell()
}

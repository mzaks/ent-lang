// A buffer that keeps its first rows (`Name = Name[..n]`), in a system
// and in a proc that was given it `mut`; and rows alike after those it has
// (`Name += [{ .. }; n]`), in a proc too.
import console

buffer Rows { x: i32, y: f32 } capacity 8

proc halve(rows: mut Rows) {
  rows = rows[..len(rows) / 2]
}

proc more(rows: mut Rows, n: i32) {
  rows += [{ x: 7, y: 0.5 }; n]
}

proc show(rows: Rows, what: text[30]) {
  var line: text[126] = "{what}: {len(rows)} rows"
  for i in 0..len(rows) { line += " {rows[i].x}" }
  put(line + ", row 5 reads {rows[5].x} {rows[5].y}")
}

system run() {
  for i in 0..8 { Rows += { x: i, y: i as f32 } }
  show(Rows, "filled")
  Rows = Rows[..6]
  show(Rows, "kept 6")
  Rows = Rows[..10]
  show(Rows, "kept 10")
  halve(Rows)
  show(Rows, "halved")
  Rows += { x: 30, y: 30.0 }
  Rows += { x: 40, y: 40.0 }
  Rows += { x: 50, y: 50.0 }
  show(Rows, "appended")
  Rows = Rows[..-1]
  show(Rows, "kept -1")
  Rows += [{ x: 9, y: 9.0 }; 2]
  more(Rows, 3)
  Rows += [{ x: 1, y: 1.0 }; 0 - 4]
  show(Rows, "alike")
  flush()
}

schedule once() { run() }
main { once() }

// A `for` over entities in a counted `for`, which runs it so many times
// (test/Integration/for_rounds.test).
import console
component Cell { v: i32, layer: i32 }
component Echo { v: i32, heard: i32 }
default_capacity 64
unique Raised: i32

// A `loop` in a fn: how many steps from `n` to 1, halving what is even
// and taking three times and one more of what is odd.
fn steps(n: i32) -> i32 {
  var k = n
  var count = 0
  loop {
    k = if k % 2 == 0 { k / 2 } else { 3 * k + 1 }
    count += 1
  } until k == 1
  count
}
world {
  spawn { Cell { v: 1, layer: 2 }, Echo { v: 0, heard: 0 } }
  spawn { Cell { v: 2, layer: 0 }, Echo { v: 0, heard: 0 } }
  spawn { Cell { v: 3, layer: 1 }, Echo { v: 0, heard: 0 } }
}
system work() {
  // By layer: one loop over the entities for each.
  for z in 0..3 {
    for c: Cell where c.layer == z { put("layer {z}: {c.v}") }
  }
  // In rounds: what a round changes the next reacts to.
  for round in 0..4 {
    for c: mut Cell where c.v < 3 { c.v += 1 }
    for c: Cell, e: mut Echo on changed c.v {
      e.v = c.v
      e.heard += 1
    }
  }
  for c: Cell, e: Echo { put("{c.v} {e.v} heard {e.heard}") }
  // Until a round changes nothing: as many rounds as the cell that is
  // furthest from 6 needs, and one that finds nothing to do.
  var rounds = 0
  loop {
    Raised = 0
    for c: mut Cell where c.v < 6 {
      c.v += 1
      Raised += 1
    }
    rounds += 1
  } until Raised == 0
  for c: Cell where c.layer == 0 { put("{rounds} rounds, {steps(27)} steps") }
  // A `for` gives how many entities its body ran for: all three, then
  // the two that are in a layer above 0; and, reacting, the ones that
  // changed since it last ran, round after round until none has.
  let all = for c: mut Cell { c.v = 0 }
  var above = for c: Cell where c.layer > 0 { }
  put("{all} cells, {above} above")
  var turns = 0
  loop {
    let raised = for c: mut Cell where c.v < c.layer * 2 { c.v += 1 }
    let heard = for c: Cell, e: mut Echo on changed c.v { e.v = c.v }
    turns += 1
    put("turn {turns}: {raised} raised, {heard} heard")
  } until raised + heard == 0
}
schedule frame() { work() }
main { frame() }

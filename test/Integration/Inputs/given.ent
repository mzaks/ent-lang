// A proc that is given the entities of a component: it reads and sets
// them, goes through them, and spawns (given.test).
import console
component Thing { born: i32, hp: i32, foe: entity }
component Mark { n: i32 }
default_capacity 16
unique Born: i32
unique Round: i32

// The one with the most `hp` that is not `me`, and how many there are.
fn strongest(things: Thing, me: entity) -> (entity, i32) {
  var best = me
  var most = -1
  var count = 0
  for o, other in things where o != me {
    count += 1
    if other.hp > most {
      most = other.hp
      best = o
    }
  }
  (best, count)
}

// `me` hits its foe, and the foe remembers who did it; one that falls to
// nought or below is given all its strength back, and a new one is made.
proc hit(things: mut Thing, me: entity, damage: i32, born: i32) -> bool {
  let foe = things[me].foe
  things[foe].hp -= damage
  things[foe].foe = me
  var made = false
  if things[foe].hp <= 0 && foe != me {
    things[foe].hp = 10
  }
  // (Once: the first to hit that hard makes one.)
  if things[foe].hp == 10 && born == 4 {
    let it = spawn { Thing { born: born, hp: 3, foe: me } }
    things[it].hp += things[me].born
    made = true
  }
  made
}

// Passed on: a proc gives what it was given.
proc round(things: mut Thing, me: entity, born: i32) -> bool {
  let (foe, count) = strongest(things, me)
  things[me].foe = foe
  hit(things, me, 4 + count, born)
}

world {
  spawn { Thing { born: 1, hp: 10, foe: none } }
  spawn { Thing { born: 2, hp: 12, foe: none }, Mark { n: 1 } }
  spawn { Thing { born: 3, hp: 11, foe: none } }
  Born = 3
}

system fight() {
  Round += 1
  for e, t: mut Thing in turn by t.born {
    if round(Thing, e, Born + 1) { Born += 1 }
  }
  for t: Thing by t.born {
    var foe = 0
    if let born = Thing(t.foe).born { foe = born }
    put("{Round}: thing {t.born}: hp {t.hp}, after {foe}")
  }
}

schedule frame() { fight() }
main { frame() frame() frame() }

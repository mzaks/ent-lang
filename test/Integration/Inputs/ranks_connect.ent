// On many ranks: edges connected in a `for` over distributed entities
// before `main`'s loop (the setup, which every rank runs whole) are fine;
// in the loop, after the entities are placed, the program stops: not yet
// (ranks.test).
component Cell { number: i32 } capacity 100
relation (Cell)-[Next]->(Cell) capacity 400
distribute Cell by number
buffer Ids { who: entity } capacity 100
unique Days: i32
system link() {
  for e, c: Cell { connect (e)-[Next]->(Ids[(c.number + 1) % len(Ids)].who) }
}
system report() { Days += 1 }
schedule setup() { link() }
schedule day() { link()  report() }
world { for i in 0..100 { Ids += { who: spawn { Cell { number: i } } } } }
main {
  setup()
  loop { day() } until Days == 2
}

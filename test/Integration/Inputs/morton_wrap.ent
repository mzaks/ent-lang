// The same as morton.ent in a box of 10 that wraps on every side, the
// dots in a band across x's edge (test/Integration/morton.test).
import console
import wyhash
import math
component Dot { x: f64, y: f64, z: f64 } capacity 2048
component Seen { n: i64, h: u64, a: i64, b: u64, k: u64, l: u64, m: i64, q: i64 } capacity 2048
unique Check { near: i64, between: i64, nearest: i64, after: i64, pairs: i64 }

index Grid of Dot grid (x, y, z) cell 1.5 wrap 10.0
index Tree of Dot morton (x, y, z) leaf 3 wrap 10.0

world {
  for i in 0..1500 {
    let c = wyrand_unit(9, i as i64 * 4) * 3.0
    spawn { Dot { x: (wyrand_unit(9, i as i64 * 4 + 1) * c + 8.5) % 10.0, y: wyrand_unit(9, i as i64 * 4 + 2) * 10.0,
                  z: (wyrand_unit(9, i as i64 * 4 + 3) * c * 0.5) },
            Seen { n: 0, h: 0, a: 0, b: 0, k: 0, l: 0, m: 0, q: 0 } }
  }
}

fn mix(h: u64, e: entity) -> u64 { wyhash64(h, hash_of(e)) }

system count() {
  for me, a: Dot, s: mut Seen {
    var n: i64 = 0
    var h: u64 = 0
    for o, b: Dot near (a.x, a.y, a.z) within 1.2 in Grid where o != me { n += 1  h += hash_of(o) + bits_of(b.x) }
    for o, b: Dot near (a.x, a.y, a.z) within 1.2 in Tree where o != me { n -= 1  h -= hash_of(o) + bits_of(b.x) }
    s.n = n
    s.h = h
    var bn: i64 = 0
    var bh: u64 = 0
    for o, b: Dot between (a.x - 3.0, a.y - 0.5, a.z - 2.0) and (a.x + 1.0, a.y + 2.5, a.z + 0.5) in Grid { bn += 1  bh += hash_of(o) + bits_of(b.x) }
    for o, b: Dot between (a.x - 3.0, a.y - 0.5, a.z - 2.0) and (a.x + 1.0, a.y + 2.5, a.z + 0.5) in Tree { bn -= 1  bh -= hash_of(o) + bits_of(b.x) }
    s.a = bn
    s.b = bh
    var k1: u64 = 7
    for o, b: Dot nearest 5 to (a.x, a.y, a.z) in Grid where o != me { k1 = mix(k1, o) }
    var k2: u64 = 7
    for o, b: Dot nearest 5 to (a.x, a.y, a.z) in Tree where o != me { k2 = mix(k2, o) }
    s.k = k1 - k2
    var w1: u64 = 7
    for o, b: Dot nearest 12 to (a.x + 5.0, a.y, a.z) within 0.6 in Grid { w1 = mix(w1, o) }
    var w2: u64 = 7
    for o, b: Dot nearest 12 to (a.x + 5.0, a.y, a.z) within 0.6 in Tree { w2 = mix(w2, o) }
    s.l = w1 - w2
    var p: i64 = 0
    for o, b: Dot near (a.x, a.y, a.z) within 1.2 in Tree after me { p += 1 }
    s.m = p
    var q: i64 = 0
    for o, b: Dot near (a.x, a.y, a.z) within 1.2 in Tree where o != me { q += 1 }
    s.q = q
  }
}

system report() {
  for s: Seen {
    if s.n != 0 || s.h != 0 { Check.near += 1 }
    if s.a != 0 || s.b != 0 { Check.between += 1 }
    if s.k != 0 || s.l != 0 { Check.nearest += 1 }
    Check.pairs += s.q
    Check.after += s.m
  }
  put("near {Check.near} differ, between {Check.between}, nearest {Check.nearest}; pairs {Check.pairs}, after me {Check.after}")
}

schedule go() {
  count()
  report()
}
main { go() }

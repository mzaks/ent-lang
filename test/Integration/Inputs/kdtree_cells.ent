// The cells of a k-d tree as laid out (test/Integration/kdtree.test):
// each cell's children side by side at 2c + 1, the first holding half its
// rows (rounded down), below the second on the side its box is widest;
// every leaf at one level, of `leaf` rows at most; each cell's box its
// rows'. Of 3000 dots most near the middle, in three sides; and of whole
// numbers in two, with a leaf of one, no entities, and fewer than a leaf.
import console
import wyhash
component Dot { x: f64, y: f64, z: f64 } capacity 4096
component Spot { u: i32, v: i32 } capacity 64
unique Lost { rows: i32 }
component Probe { x: i32 } capacity 1
unique Near { sum: i32 }
index Tree of Dot kdtree (x, y, z) leaf 4
index Flat of Spot kdtree (u, v) leaf 1

world {
  spawn { Probe { x: 0 } }
  for i in 0..3000 {
    let r = wyrand_unit(7, i as i64 * 4)
    let s = r * r * r
    spawn { Dot { x: (wyrand_unit(7, i as i64 * 4 + 1) - 0.5) * s, y: (wyrand_unit(7, i as i64 * 4 + 2) - 0.5) * s,
                  z: (wyrand_unit(7, i as i64 * 4 + 3) - 0.5) * s } }
  }
}

system dots() {
  let n = len(Tree_cells)
  var bad = 0
  var leaves = 0
  var deepest = 0 - 1
  var shallowest = 1000
  for c in 0..n {
    if Tree_cells[c].child < 0 {
      leaves += 1
      deepest = max(deepest, Tree_cells[c].level)
      shallowest = min(shallowest, Tree_cells[c].level)
      if Tree_cells[c].count > 4 || Tree_cells[c].count < 1 { bad += 1 }
      for r in Tree_cells[c].first..Tree_cells[c].first + Tree_cells[c].count {
        if Tree[r].x < Tree_cells[c].lo0 || Tree[r].x > Tree_cells[c].hi0 { bad += 1 }
        if Tree[r].y < Tree_cells[c].lo1 || Tree[r].y > Tree_cells[c].hi1 { bad += 1 }
        if Tree[r].z < Tree_cells[c].lo2 || Tree[r].z > Tree_cells[c].hi2 { bad += 1 }
      }
    } else {
      let lc = Tree_cells[c].child
      if Tree_cells[c].child != 2 * c + 1 || Tree_cells[c].kids != 2 { bad += 1 }
      if Tree_cells[lc].count != Tree_cells[c].count / 2 || Tree_cells[lc].count + Tree_cells[lc + 1].count != Tree_cells[c].count { bad += 1 }
      if Tree_cells[lc].first != Tree_cells[c].first || Tree_cells[lc + 1].first != Tree_cells[c].first + Tree_cells[lc].count { bad += 1 }
      // (The widest side: the halves apart on it.)
      let w0 = Tree_cells[c].hi0 - Tree_cells[c].lo0
      let w1 = Tree_cells[c].hi1 - Tree_cells[c].lo1
      let w2 = Tree_cells[c].hi2 - Tree_cells[c].lo2
      if w0 >= w1 && w0 >= w2 {
        if Tree_cells[lc].hi0 > Tree_cells[lc + 1].lo0 { bad += 1 }
      } else if w1 >= w2 {
        if Tree_cells[lc].hi1 > Tree_cells[lc + 1].lo1 { bad += 1 }
      } else {
        if Tree_cells[lc].hi2 > Tree_cells[lc + 1].lo2 { bad += 1 }
      }
      if Tree_cells[c].lo0 != min(Tree_cells[lc].lo0, Tree_cells[lc + 1].lo0) || Tree_cells[c].hi2 != max(Tree_cells[lc].hi2, Tree_cells[lc + 1].hi2) { bad += 1 }
    }
  }
  var unsorted = 0
  for r in 1..len(Tree) { if Tree[r].key != Tree[r - 1].key + 1 { unsorted += 1 } }
  // Each entity's row is its own.
  for e, d: Dot { if Tree[Tree.row(e)].who != e { Lost.rows += 1 } }
  let lost = Lost.rows
  put("{len(Tree)} rows, {n} cells, {leaves} leaves at levels {shallowest} to {deepest}, {bad} bad, {unsorted} out of order, {lost} lost")
}

system flat() {
  var bad = 0
  var leaves = 0
  var empty = 0
  for c in 0..len(Flat_cells) {
    if Flat_cells[c].child < 0 {
      leaves += 1
      // (Every leaf at one level: of 7 rows, one of the 8 holds none.)
      if Flat_cells[c].count > 1 { bad += 1 }
      if Flat_cells[c].count == 0 { empty += 1 }
      let r = Flat_cells[c].first
      if Flat_cells[c].count == 1 && (Flat[r].u != Flat_cells[c].lo0 || Flat[r].u != Flat_cells[c].hi0 || Flat[r].v != Flat_cells[c].lo1) { bad += 1 }
    }
  }
  Near.sum = 0
  for p: Probe {
    for o, s: Spot nearest 3 to (p.x, p.x) in Flat { Near.sum += s.u * 10 + s.v }
  }
  let sum = Near.sum
  put("spots {len(Flat)}: {len(Flat_cells)} cells, {leaves} leaves ({empty} empty), {bad} bad, nearest 3 to the middle {sum}")
}

system one() { spawn { Spot { u: 3, v: 2 } } }
system six() {
  for i in 0..6 { spawn { Spot { u: (i * 37) % 11 - 5, v: (i * 13) % 7 } } }
}

schedule go() {
  dots()
  flat()
  one()
  flat()
  six()
  flat()
}
main { go() }

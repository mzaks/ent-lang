// Vars end to end: locals that are assigned, in loops, in branches and
// for every entity of a `for`, in a program of .ent files only.
import console

component Ghost { col: i32, row: i32, dir: i32 }
component Other { who: entity }
default_capacity 16
unique Maze: text[40]
unique Frame: i32
unique Total: i32

fn wall(maze: text[40], col: i32, row: i32) -> bool { maze[row * 8 + col] == '#' }
fn far(ax: i32, ay: i32, bx: i32, by: i32) -> i32 { (ax - bx) * (ax - bx) + (ay - by) * (ay - by) }

world {
  Maze = "########" + "#o..#..#" + "#.##.#.#" + "#......#" + "########"
  // Counting in a loop: carried from round to round.
  var free = 0
  var walls: i64 = 0
  var picture: text[30] = ""
  for i in 0..40 {
    if Maze[i] == '#' { walls += 1 } else { free += 1 }
    if i < 8 { picture += "+" }
  }
  var nested = 0
  for r in 0..3 {
    let start = nested
    for c in 0..4 { nested += r * c }
    if nested == start { nested += 100 }
  }
  Total = free
  let a = spawn { Ghost { col: 6, row: 3, dir: 2 } }
  spawn { Ghost { col: 1, row: 1, dir: 0 } }
  spawn { Other { who: a } }
  spawn { Print { line: "free {free} walls {walls} nested {nested} {picture}" } }
}

system chase() {
  Frame += 1
  var seen = 0
  if Frame > 0 { seen = 7 }
  for g: mut Ghost {
    var best = 100000
    var dir = (g.dir + 2) % 4
    let back = dir
    if back != 0 && !wall(Maze, g.col + 1, g.row) {
      let d = far(g.col + 1, g.row, 1, 3)
      if d < best { best = d  dir = 0 }
    }
    if back != 1 && !wall(Maze, g.col, g.row + 1) {
      let d = far(g.col, g.row + 1, 1, 3)
      if d < best { best = d  dir = 1 }
    }
    if back != 2 && !wall(Maze, g.col - 1, g.row) {
      let d = far(g.col - 1, g.row, 1, 3)
      if d < best { best = d  dir = 2 }
    }
    if back != 3 && !wall(Maze, g.col, g.row - 1) {
      let d = far(g.col, g.row - 1, 1, 3)
      if d < best { best = d  dir = 3 }
    }
    g.dir = dir
    if dir == 0 { g.col += 1 } else if dir == 2 { g.col -= 1 }
    else if dir == 1 { g.row += 1 } else { g.row -= 1 }
    spawn { Print { line: "ghost {g.col},{g.row} dir {dir} best {best} seen {seen}" } }
  }
  for o: Other {
    var found = -1
    if let col = Ghost(o.who).col { found = col } else { found = -2 }
    spawn { Print { line: "other sees {found}" } }
  }
}
schedule frame() { chase() write() clear() }
main { loop { frame() } until Frame == 3 }

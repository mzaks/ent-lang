  spawn { A { i: 62, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 63, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 64, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 65, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 66, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 67, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 68, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 69, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 70, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }

  spawn { A { i: 55, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 56, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 57, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }

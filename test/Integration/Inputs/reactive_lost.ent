// Two reactive `for`s read one event log of 64 entries, and more happens
// than it holds (reactive_lost.test).
import console

component A { i: i32, v: i32 }
component S1 { n: i32 }
component S2 { n: i32 }
default_capacity 128
unique Frame: i32
unique One: i32
unique Two: i32

world {
  spawn { A { i: 0, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 1, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 2, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }

  spawn { A { i: 19, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 20, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 21, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }

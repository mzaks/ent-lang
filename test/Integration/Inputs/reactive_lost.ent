  spawn { A { i: 78, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 79, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 80, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 81, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 82, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 83, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 84, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 85, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 86, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 87, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 88, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 89, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 90, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 91, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 92, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 93, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 94, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 95, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 96, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 97, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 98, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 99, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
}

system tick() { Frame += 1  One = 0  Two = 0 }
system q1() { for a: A, s: mut S1 on changed A.v log 64 { s.n += 1 } }
system w1() { for a: mut A where a.i < 5 { a.v += 1 } }
system q2() { for a: A, s: mut S2 on changed A.v log 64 { s.n += 1 } }
system w2() { for a: mut A where a.i >= 50 && a.i < 90 { a.v += 1 } }
system show() {
  for s: S1 { One += s.n }
  for s: S2 { Two += s.n }
  put("{Frame}: {One} {Two}")  flush() }

schedule frame() { tick()  q1()  w1()  q2()  w2()  show() }
main { loop { frame() } until Frame == 8 }

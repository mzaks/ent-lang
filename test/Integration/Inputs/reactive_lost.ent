  spawn { A { i: 30, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 31, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }
  spawn { A { i: 32, v: 0 }, S1 { n: 0 }, S2 { n: 0 } }

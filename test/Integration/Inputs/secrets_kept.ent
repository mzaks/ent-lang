// Secrets in the system's keyring (secrets.test, secrets_no_bus.test,
// secrets_keyring.test): kept, read, kept again, forgotten. Where there is
// no keyring, none are kept and none are read.
import console
import text
import secrets

system go() {
  let there = secrets_available()
  let kept = secret_put("org.ent-lang.test", "dev/api key", "s3cr3t é")
  let got = secret_get("org.ent-lang.test", "dev/api key")
  let other = secret_get("org.ent-lang.test", "dev/none")
  let again = secret_put("org.ent-lang.test", "dev/api key", "second")
  let got2 = secret_get("org.ent-lang.test", "dev/api key")
  let gone = secret_forget("org.ent-lang.test", "dev/api key")
  let got3 = secret_get("org.ent-lang.test", "dev/api key")
  put("available {there}")
  put("kept {kept} [{got}] other [{other}]")
  put("again {again} [{got2}] forgotten {gone} [{got3}]")
}
schedule run() { go() }
main { run() }

// A hash index of entities with a tag (test/Integration/hash_late.test):
// none have it when the index is first made, so it starts empty; then a
// few at a time get the tag, some lose it, some go, and new ones come,
// each frame, and `get` finds those with it and only them.
import console
tag Kept
component Item { key: i64 } capacity 4096
index ByKey of Item, Kept by key hash WAY
unique Bad: i64
unique Good: i64
unique Step: i64
world { for i in 0..1000 { spawn { Item { key: i } } } }
system look() {
  for e, it: Item {
    let found = ByKey.get(it.key)
    if e.has(Kept) {
      if found == e { Good += 1 } else { Bad += 1 }
    } else {
      if found == none { Good += 1 } else { Bad += 1 }
    }
  }
}
system change() {
  Step += 1
  let s = Step
  for e, it: Item {
    if it.key % 10 == s % 10 { e.add(Kept) }
    if it.key % 37 == s { e.remove(Kept) }
    if it.key % 101 == s { e.destroy() }
  }
  for i in 0..20 { spawn { Item { key: 1000 + s * 20 + i } } }
}
system say() { put("good {Good} bad {Bad}") }
schedule a() { look() change() }
schedule b() { look() say() }
main { a() a() a() a() a() a() a() a() a() a() a() a() b() }

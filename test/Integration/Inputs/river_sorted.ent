// Inputs/river.ent with its tree `sorted`, its nodes stored in the tree's
// order (in an archetype the program does not declare), through
// what puts them out of it: a node made by a system, one that goes, and
// one that changes where it flows.
import console

component Node { name: text[8], rain: i32, flow: i32, height: i32, top: i32 }
relation (Node)-[Flows]->(Node) tree sorted capacity 16
default_capacity 16
unique Frame: i32
unique Keep { river: entity, creek: entity, lake: entity }

world {
  // Upstream first: the rows start in the wrong order.
  let spring = spawn { Node { name: "spring", rain: 10000, flow: 0, height: 900, top: 0 } }
  let creek = spawn { Node { name: "creek", rain: 100, flow: 0, height: 500, top: 0 } }
  let brook = spawn { Node { name: "brook", rain: 1000, flow: 0, height: 300, top: 0 } }
  let lake = spawn { Node { name: "lake", rain: 5, flow: 0, height: 50, top: 0 } }
  let river = spawn { Node { name: "river", rain: 10, flow: 0, height: 20, top: 0 } }
  let sea = spawn { Node { name: "sea", rain: 1, flow: 0, height: 0, top: 0 } }
  connect (river)-[Flows]->(sea)
  connect (brook)-[Flows]->(river)
  connect (spring)-[Flows]->(brook)
  connect (creek)-[Flows]->(river)
  Keep.river = river
  Keep.creek = creek
  Keep.lake = lake
}

system change() {
  Frame += 1
  // A new node, flowing into the river.
  if Frame == 2 {
    let pond = spawn { Node { name: "pond", rain: 7, flow: 0, height: 60, top: 0 } }
    connect (pond)-[Flows]->(Keep.river)
  }
  // The brook goes, and the spring above it is on its own.
  let goes = if Frame == 3 { 300 } else { -1 }
  for e, n: Node where n.height == goes { e.destroy() }
  // The creek flows into the lake instead.
  if Frame == 4 { connect (Keep.creek)-[Flows]->(Keep.lake) }
}

system gather() {
  for n: mut Node {
    n.flow = n.rain
    n.top = n.height
  }
  for (n: Node)-[Flows]->(down: mut Node) bottom up Flows {
    down.flow += n.flow
    down.top max= n.top
  }
}

// Where the water came down: every node after the one it flows into.
system trace() {
  for (n: mut Node)-[Flows]->(down: Node) top down Flows {
    n.height = down.height + 1
  }
}

system show() {
  // In the order of rows: no node before the one it flows into.
  for n: Node { put("{Frame}: {n.name} {n.flow} from {n.top} at {n.height}") }
  for n: Node bottom up Flows { put("{Frame}: visit {n.name}") }
  flush()
}

schedule frame() { change()  gather()  show() }
system after() { Frame += 1 }
schedule last() { after()  trace()  show() }
main {
  loop { frame() } until Frame == 4
  last()
}

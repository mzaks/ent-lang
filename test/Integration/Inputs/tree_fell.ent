// A node of a tree is destroyed: its edge and the edges to it go with it,
// at once, so the node above no longer counts it and the node below has
// no parent. A new node that takes its slot starts without edges.
import console

component Node { name: text[8], value: i32, kids: i32, heard: i32, under: i32 }
default_capacity 16
relation Under from Node to Node tree capacity 16
unique Frame: i32
unique Top: entity

world {
  let top = spawn { Node { name: "top", value: 1, kids: 0, heard: 0, under: 0 } }
  let a = spawn { Node { name: "a", value: 10, kids: 0, heard: 0, under: 0 } }
  let b = spawn { Node { name: "b", value: 20, kids: 0, heard: 0, under: 0 } }
  let d = spawn { Node { name: "d", value: 40, kids: 0, heard: 0, under: 0 } }
  connect(a, top, Under)
  connect(b, top, Under)
  connect(d, a, Under)
  Top = top
}

system change() {
  Frame += 1
  // a goes: top loses a child, d its parent.
  let goes = if Frame == 2 { 10 } else { -1 }
  for e, n: Node where n.value == goes { e.destroy() }
  // A new node in a's slot, under top; d is not its child.
  if Frame == 3 {
    let fresh = spawn { Node { name: "fresh", value: 80, kids: 0, heard: 0, under: 0 } }
    connect(fresh, Top, Under)
  }
}

system look() {
  for e, n: mut Node {
    n.kids = 0
    n.heard = 0
    n.under = 0
    for s, child in e.in(Under) {
      n.kids += 1
      if let value = Node(child).value { n.heard += value }
    }
    for s, parent in e.out(Under) {
      if let value = Node(parent).value { n.under = value }
    }
  }
}

system show() {
  for n: Node { put("{Frame}: {n.name} kids {n.kids} heard {n.heard} under {n.under}") }
  for n: Node, above: Node up Under { put("{Frame}: {n.name} below {above.name}") }
  flush()
}

schedule frame() { change()  look()  show() }
main { loop { frame() } until Frame == 3 }

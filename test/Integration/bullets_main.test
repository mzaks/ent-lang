// examples/bullets_main.ent: the bullets example without a C host. `world`
// spawns the guns, `main` runs eight frames and then the extern system
// that prints; the output is that of bullets.test.
// RUN: mkdir -p %t.dir
// RUN: ent-translate --import-ent %S/../../examples/bullets_main.ent \
// RUN:     -o %t.mlir
// RUN: ent-translate --ent-to-c-header %t.mlir \
// RUN:     -o %t.dir/bullets_main_world.h

// RUN: ent-opt %t.mlir --ent-lower-to-loops \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.seq.ll
// RUN: clang -O2 -Wno-override-module %t.seq.ll -I%t.dir \
// RUN:     %S/../../examples/extern/bullets_report.c -o %t.seq
// RUN: %t.seq | FileCheck %s

// RUN: ent-opt %t.mlir --ent-lower-to-loops=fuse-systems=1 --symbol-dce \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.fused.ll
// RUN: clang -O2 -Wno-override-module %t.fused.ll -I%t.dir \
// RUN:     %S/../../examples/extern/bullets_report.c -o %t.fused
// RUN: %t.fused | FileCheck %s

// RUN: ent-opt %t.mlir \
// RUN:     "--ent-lower-to-loops=parallel-entities=1 parallel-min-entities=1" \
// RUN:     --convert-scf-to-openmp --canonicalize --ent-omp-nowait \
// RUN:     --convert-scf-to-cf --convert-to-llvm --reconcile-unrealized-casts \
// RUN:   | mlir-translate --mlir-to-llvmir -o %t.par.ll
// RUN: clang -O2 -Wno-override-module %t.par.ll -I%t.dir \
// RUN:     %S/../../examples/extern/bullets_report.c %openmp -o %t.par
// RUN: %t.par | FileCheck %s

// CHECK: gun 0: cooldown 1.0000
// CHECK-NEXT: gun 1: cooldown 0.5000
// CHECK-NEXT: bullets: 2
// CHECK-NEXT: bullet 0: x 107.5000 life 0.2500
// CHECK-NEXT: bullet 1: x 2.5000 life 0.7500

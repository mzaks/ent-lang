// The workloads of bench/devices in Rust (src/lib.rs, built by
// dev.build), as ent/dev.ent has them.

buffer Text { value: u8 } capacity 16777216
buffer Values { value: i64 } capacity 2097152
buffer Scratch { value: i64 } capacity 2097152
buffer Pixels { value: u8 } capacity 4194304
buffer Blurred { value: u8 } capacity 4194304

// splitmix64's finish.
extern fn mix(x: u64) -> u64
// The squares below n added up, by way of an array.
extern fn square_sum(n: i32) -> i64
// The lower median of 16 numbers mixed from `seed` (mix(seed * 16 + k)),
// by an insertion sort of an array on the stack.
extern fn median16(seed: u64) -> u64
// The whole numbers of comma-separated text into `into`: how many; -1 at
// a byte that is neither digit nor comma.
extern proc parse(text: Text, into: mut Values) -> i64
// The lower median of the values, by quickselect (Hoare's partition, the
// middle as pivot) on a copy in `scratch`.
extern proc median(values: Values, scratch: mut Scratch) -> i64
// A 3 by 3 box blur of a picture `width` wide; its edge as it is.
extern proc blur(from: Pixels, to: mut Blurred, width: i32)

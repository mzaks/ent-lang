// The k nearest neighbours of every point (3D), as PBBS's
// nearestNeighbors benchmark asks (github.com/cmuparlay/pbbsbench, its
// octTree the program to hold this against): on the points of
// `points.pts` (bench/points/cloud.ent), each point's `G.k` nearest other
// points, nearest first, by the index `Cells` and its `nearest k` (the grid;
// bench/points/run.py makes a Morton one too).
//
// Every run makes the index anew (as PBBS's makes its tree; a clustered
// index keeps the points in its order, so from the second run on they are
// in it already) and then asks every point. What it prints: the ms of
// each run, of it the making, and at the end the neighbours in
// `found.out`, which bench/points/check.cc holds against a scan.
// bench/points/run.py runs it.
import console
import cloud

index Cells of Point grid (x, y, z) cell G.cell

world {
  G.k = 10
  G.runs = 5
}

system ready() { Found = [{ id: 0 - 1, of: 0 - 1 }; G.n * G.k] }

system made() { G.made = now() - G.started + 0.0 * len(Cells) as f64 }

system knn() {
  let k = G.k
  for me, a: Point {
    let row = G.slots += k
    var j = 0
    for o, b: Point nearest k to (a.x, a.y, a.z) in Cells where o != me {
      Found[row + j].id = b.id
      Found[row + j].of = a.id
      j += 1
    }
  }
}

system report() {
  let t = now() - G.started
  put("knn {t * 1000.0} ms, made {G.made * 1000.0} ms")
  G.runs -= 1
}

schedule setup() {
  load()
  size_cells()
  ready()
}
schedule run() {
  start()
  Cells_moved()
  made()
  knn()
  report()
}
schedule finish() { save() }

main {
  setup()
  loop { run() } until G.runs <= 0
  finish()
}

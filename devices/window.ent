// The window: a place to draw, with the keys and the mouse. `begin` opens
// it (the first time), takes in what happened since the last frame and
// clears the picture; `present` shows what was drawn since. Systems run
// between the two draw by calling `rect`, `circle`, `sector`, `line`,
// `label` and `paragraph`:
//
//   import window
//   world { Window.width = 800  Window.height = 450  Window.fps = 60 }
//   system draw() { for p: Position { circle(p.x, p.y, 8.0, 0xff8800) } }
//   schedule frame() { begin()  draw()  present() }
//   main { loop { frame() } until Window.closed }
//
// What is drawn later lies on top. Coordinates are pixels from the top
// left corner; a colour is 0xRRGGBB, or 0xAARRGGBB for one that lets what
// is under it show through (AA from 01, nearly all of it, to ff, none).
//
// Implemented with raylib (devices/window.c, devices/window.link).

// `width`, `height` (800 by 450 if left 0) and `title` are read when the
// window opens, and whether the user can make it another size
// (`resizable`); `background` and `fps` every frame. `fps` is the frames
// per second to hold, which `present` waits for; 0 does not wait.
// From then on `width` and `height` are how big the window is, every
// frame: another size when the user has given it one (never less than
// `min_width` by `min_height`, where those are set), when the program
// has (`resize_window`), or when it fills the screen, which it does for
// as long as `fullscreen` says so (set it whenever; the window is as big
// as it was again after).
// Sizes and places are in points, which are as big on every screen: on
// one with small pixels a point is several of them (`scale` says how
// many across), and what is drawn is as big and as sharp as the screen
// can show it. `zoom` makes everything so many times as big again (0 or
// 1: as it is): the window then has fewer points to draw in, which
// `width` and `height` say, and the mouse is where it points in those.
// `closed` says that the user closed the window or pressed Escape. `dt`
// is the seconds the previous frame took, `frame` the number of `begin`s.
unique Window {
  width: i32, height: i32, title: text[62], background: i32, fps: i32,
  open: bool, closed: bool, dt: f32, frame: i64, resizable: bool,
  fullscreen: bool, min_width: i32, min_height: i32, scale: f32, zoom: f32
}

// Where the mouse is, and which of its buttons are down.
// (`wheel_x`, `wheel_y`: how far the wheel was turned since the frame
// before, in notches; up and to the left are positive.)
unique Mouse {
  x: f32, y: f32, left: bool, right: bool, wheel_x: f32, wheel_y: f32
}

// The keys most programs ask for: down or not.
unique Keys {
  left: bool, right: bool, up: bool, down: bool,
  space: bool, enter: bool
}

// Any other key: a letter or digit by its character ('A' as i32), the
// rest by raylib's key numbers.
extern proc key_down(key: i32) -> bool

// A filled rectangle, by its top left corner and its size.
extern proc rect(x: f32, y: f32, width: f32, height: f32, color: i32)
// A filled circle, by its centre.
extern proc circle(x: f32, y: f32, radius: f32, color: i32)
// A filled slice of a circle, from one angle to another: degrees, 0 to
// the right and growing clockwise (90 is down).
extern proc sector(x: f32, y: f32, radius: f32, from: f32, to: f32, color: i32)
extern proc line(x0: f32, y0: f32, x1: f32, y1: f32, color: i32)
// A line of text `size` pixels high, by its top left corner.
extern proc label(text: text[126], x: f32, y: f32, size: f32, color: i32)
// How wide `label` draws a text of that size, in pixels. The window must
// be open (after the first `begin`).
extern fn text_width(text: text[126], size: f32) -> f32
// A text that goes on in the next line where the next word would reach
// past `width`: lines `size` pixels high, a quarter of that between them.
extern proc paragraph(text: text[126], x: f32, y: f32, width: f32, size: f32,
                      color: i32)
// How wide the longest word of a text is: the least width `paragraph`
// can draw it in without a word reaching past it.
extern fn text_min_width(text: text[126], size: f32) -> f32
// How high `paragraph` draws a text of that size in that width.
extern fn text_height(text: text[126], size: f32, width: f32) -> f32
// Text set in lines, in a font: 0 is the window's own, others come from
// `font`. `spacing` is more room between the letters, `line` how far
// one line is below the one before (0: as far as the text is high).
// `breaks` says where a text goes on in the next line: 0 where the next
// word would reach past `width`, and at "\n"; 1 at "\n" only; 2
// nowhere. `align` puts each line at the left (0), in the middle (1) or
// at the right (2) of `width`.
extern proc write(text: text, x: f32, y: f32, width: f32, font: i32,
                  size: f32, spacing: f32, line: f32, breaks: i32, align: i32,
                  color: i32)
// How many lines `write` sets a text in.
extern fn text_lines(text: text, width: f32, font: i32, size: f32,
                     spacing: f32, breaks: i32) -> i32
// How wide a text is where it has all the room it wants, and the least
// width it can be set in: that of its longest word, line or all of it,
// as `breaks` says.
extern fn text_extent(text: text, font: i32, size: f32, spacing: f32,
                      breaks: i32) -> f32
extern fn text_least(text: text, font: i32, size: f32, spacing: f32,
                     breaks: i32) -> f32
// Reads a font from a file (.ttf, .otf) for texts `size` pixels high,
// and gives its number; 0, the window's own, if there is no such file.
// The window need not be open: `world` may ask. (It is read when it is
// first used; a file that is no font then gives the window's own.)
extern proc font(file: text[126], size: i32) -> i32
// A filled rectangle whose corners are rounded, each with its own
// radius: top left, top right, bottom left, bottom right.
extern proc rounded(x: f32, y: f32, width: f32, height: f32, top_left: f32,
                    top_right: f32, bottom_left: f32, bottom_right: f32,
                    color: i32)
// The edges of a rectangle, each so thick (0 for none), going round
// corners with those radii.
extern proc edges(x: f32, y: f32, width: f32, height: f32, left: f32,
                  right: f32, top: f32, bottom: f32, top_left: f32,
                  top_right: f32, bottom_left: f32, bottom_right: f32,
                  color: i32)
// A picture from a file (.png, .jpg, ...): `picture_load` gives its
// number, 0 if it cannot be read; `picture` draws it into a rectangle,
// its colours times `tint` (0xffffff: as they are); `picture_ratio` is
// its width over its height. The window need not be open for
// `picture_load` and `picture_ratio`: `world` may ask.
extern proc picture_load(file: text[126]) -> i32
extern proc picture(image: i32, x: f32, y: f32, width: f32, height: f32,
                    tint: i32)
extern fn picture_ratio(image: i32) -> f32
// A colour `part` of the way (0 to 1) from one to another.
extern fn blend(from: i32, to: i32, part: f32) -> i32
// A colour with all of it there (AA ff), and how much of a colour is
// there when `part` of it is laid on something: its AA's share of that.
extern fn solid(color: i32) -> i32
extern fn strength(color: i32, part: f32) -> f32
// What is drawn from here on has so much (0 to 1) of this colour laid on
// it, until another `shade`; a frame begins with none.
extern proc shade(color: i32, part: f32)
// And is so far to the right and down from where it says, until another
// `shift`.
extern proc shift(dx: f32, dy: f32)
// What is drawn from here on shows only within this rectangle, until
// `unclip` or the frame's end.
extern proc clip(x: f32, y: f32, width: f32, height: f32)
extern proc unclip()
// Saves the picture as it is now (a .png) in the directory the program
// runs in.
extern proc screenshot(file: text[126])

// The device's own: what `begin` and `present` are made of.
extern proc open_window(width: i32, height: i32, title: text[62],
                        resizable: bool)
extern proc window_width() -> i32
extern proc window_height() -> i32
// The window fills the screen, or is as it was: where that is not so yet.
extern proc fill_screen(on: bool)
extern proc window_limits(min_width: i32, min_height: i32)
extern proc window_scale() -> f32
// Another size for the window, from the program.
extern proc resize_window(width: i32, height: i32)
extern proc should_close() -> bool
extern proc frame_seconds() -> f32
extern proc begin_frame(background: i32, fps: i32, zoom: f32)
extern proc end_frame()
extern proc mouse_x() -> f32
extern proc mouse_y() -> f32
extern proc mouse_down(button: i32) -> bool
extern proc mouse_wheel_x() -> f32
extern proc mouse_wheel_y() -> f32

system begin() {
  if !Window.open {
    let width = if Window.width > 0 { Window.width } else { 800 }
    let height = if Window.height > 0 { Window.height } else { 450 }
    Window.width = width
    Window.height = height
    open_window(width, height, Window.title, Window.resizable)
    if Window.min_width > 0 || Window.min_height > 0 {
      window_limits(Window.min_width, Window.min_height)
    }
    Window.open = true
  }
  Window.scale = window_scale()
  fill_screen(Window.fullscreen)
  let zoom = if Window.zoom > 0.0 { Window.zoom } else { 1.0 }
  Window.width = (window_width() as f32 / zoom) as i32
  Window.height = (window_height() as f32 / zoom) as i32
  Window.closed = should_close()
  Window.dt = frame_seconds()
  Window.frame += 1
  Mouse.x = mouse_x() / zoom
  Mouse.y = mouse_y() / zoom
  Mouse.left = mouse_down(0)
  Mouse.right = mouse_down(1)
  Mouse.wheel_x = mouse_wheel_x()
  Mouse.wheel_y = mouse_wheel_y()
  Keys.right = key_down(262)
  Keys.left = key_down(263)
  Keys.down = key_down(264)
  Keys.up = key_down(265)
  Keys.space = key_down(32)
  Keys.enter = key_down(257)
  begin_frame(Window.background, Window.fps, zoom)
}

system present() {
  end_frame()
}

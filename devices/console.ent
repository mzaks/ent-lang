// The console: a program prints a line by spawning a `Print`; `write`
// puts the lines out and `clear` takes them away. Run both where the
// frame's output should appear:
//
//   import console
//   system greet() { spawn { Print { line: "hello" } } }
//   schedule frame() { greet()  write()  clear() }
//
// Lines spawned alike come out in the order they were spawned. An entity
// may carry more than its `Print`; such lines follow the plain ones, each
// shape's together.
//
// A line is as long as it is (a `text`, devices/text.ent: nothing is cut
// off). `put` and `flush` are implemented in devices/console.c.
import text

// At most this many lines of one shape between two `write`s.
component Print { line: text } capacity 1024

// Writes one line to standard output.
extern proc put(line: text)
// Hands what was written on to whoever reads it.
extern proc flush()
// Writes one line to standard error (where messages go that are not the
// program's output).
extern proc put_error(line: text)

// The words the program was started with, after its own name
// (`program a b`: 2, "a", "b"); none past the last. (A program on a web
// page has none.)
extern proc argument_count() -> i32
extern proc argument(n: i32) -> text

// The status the program ends with, once `main` is done (0 where none is
// given: all went well; a script or CI takes another as a failure).
extern proc exit_status(code: i32)

system write() {
  for p: Print { put(p.line) }
  flush()
}

system clear() {
  for e with Print { e.destroy() }
}

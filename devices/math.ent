// The bits of x as those of a normal float, or what to give for 0, an
// infinity, a number below 0 or not a number: a subnormal x as a normal
// one, its exponent below the least.
fn log_ends(x: f64) -> (bool, u64, f64) {
  let ix = bits_of(x)
  let top = ix >> 48
  if top - 0x0010 < 0x7fe0 { (false, ix, 0.0 as f64) }
  else if (ix << 1) == 0 { (true, ix, -infinity64()) }
  else if ix == 0x7ff0000000000000 { (true, ix, x) }
  else if (top & 0x8000) != 0 || (top & 0x7ff0) == 0x7ff0 { (true, ix, nan64()) }
  else { (false, bits_of(x * 4503599627370496.0) - 0x0340000000000000, 0.0 as f64) }
}

// The natural logarithm (Arm's log.c, optimized-routines, MIT; within
// 0.52 ulp): near 1, of r = x - 1 by a polynomial, r * r / 2 in two
// floats; else x is 2^k z, z from 0x1.6p-1 to 0x1.6p0 near the c of its
// row, and log(x) = k ln2 + log(c) + log(1 + r), r = z/c - 1 by fma.
fn log64(x: f64) -> f64 {
  let ix = bits_of(x)
  if ix - 0x3fee000000000000 < 0x0003090000000000 {
    if x == 1.0 { 0.0 }
    else {
      let r = x - 1.0
      let r2 = r * r
      let r3 = r * r2
      let y = r3 * (0.3333333333333352 + r * -0.24999999999998432 + r2 * 0.19999999999320328 +
                    r3 * (-0.16666666669929706 + r * 0.14285715076560868 + r2 * -0.12499997863982555 +
                          r3 * (0.11110712032936046 + r * -0.10000486757818193 +
                                r2 * 0.09181994006195467 + r3 * -0.08328363062289341)))
      let w = r * 134217728.0
      let rhi = r + w - w
      let rlo = r - rhi
      let w2 = rhi * rhi * -0.5
      let hi = r + w2
      let lo = r - hi + w2 + -0.5 * rlo * (rhi + r)
      y + lo + hi
    }
  } else {
    let (done, iy, given) = log_ends(x)
    if done { given }
    else {
      let tmp = iy - 0x3fe6000000000000
      let c = log_rows[((tmp >> 45) & 127) as i32]
      let z = float_of(iy - (tmp & 0xfff0000000000000))
      let kd = ((tmp as i64) >> 52) as f64
      let r = fma(z, c.invc, -1.0)
      let w = kd * 0.6931471805598903 + c.logc
      let hi = w + r
      let lo = w - hi + r + kd * 5.497923018708371e-14
      let r2 = r * r
      lo + r2 * -0.5000000000000001 +
        r * r2 * (0.33333333331825593 + r * -0.2499999999622955 +
                  r2 * (0.20000304511814496 + r * -0.16667054827627667)) + hi
    }
  }
}

// The logarithm to base 2 (Arm's log2.c; within 0.55 ulp): as log64,
// with 64 rows, and r/ln2 in two floats by fma.
fn log264(x: f64) -> f64 {
  let ix = bits_of(x)
  if ix - 0x3feea4af00000000 < 0x000210aa00000000 {
    if x == 1.0 { 0.0 }
    else {
      let r = x - 1.0
      let hi = r * 1.4426950407214463
      let lo = r * 1.6751713164886512e-10 + fma(r, 1.4426950407214463, -hi)
      let r2 = r * r
      let r4 = r2 * r2
      let p = r2 * (-0.7213475204444817 + r * 0.48089834696298744)
      let y = hi + p
      let lo2 = lo + (hi - y + p)
      let lo3 = lo2 + r4 * (-0.360673760222145 + r * 0.2885390081805197 +
                            r2 * (-0.24044917405728863 + r * 0.2060992861022954) +
                            r4 * (-0.18033596705327856 + r * 0.1603032746063156 +
                                  r2 * (-0.14483316576701266 + r * 0.13046826811283835)))
      y + lo3
    }
  } else {
    let (done, iy, given) = log_ends(x)
    if done { given }
    else {
      let tmp = iy - 0x3fe6000000000000
      let c = log2_rows[((tmp >> 46) & 63) as i32]
      let z = float_of(iy - (tmp & 0xfff0000000000000))
      let kd = ((tmp as i64) >> 52) as f64
      let r = fma(z, c.invc, -1.0)
      let t1 = r * 1.4426950407214463
      let t2 = r * 1.6751713164886512e-10 + fma(r, 1.4426950407214463, -t1)
      let t3 = kd + c.logc
      let hi = t3 + t1
      let lo = t3 - hi + t1 + t2
      let r2 = r * r
      let r4 = r2 * r2
      let p = -0.7213475204444882 + r * 0.4808983469629985 +
              r2 * (-0.36067375954075914 + r * 0.2885390073180969) +
              r4 * (-0.2404693555628422 + r * 0.2061202382173603)
      lo + r2 * p + hi
    }
  }
}



// log(x) as hi + lo, of the bits of x above 0, normal (Arm's log_inline,
// pow.c): x is 2^k z, z from 0x1.69555p-1 to 0x1.69555p0, near the c of
// its row i, and log(x) = k ln2 + log(c) + log(1 + r), r = z/c - 1 exact
// (by fma: 1/c has few bits), |r| below 1/128; ln2 and log(c) in two
// floats, and log(1 + r) - r + r * r / 2 a polynomial. Within 2^-68.
fn pow_log(ix: u64) -> (f64, f64) {
  let tmp = ix - 0x3fe6955500000000
  let i = ((tmp >> 45) & 127) as i32
  let k = (tmp as i64) >> 52
  let z = float_of(ix - (tmp & 0xfff0000000000000))
  let kd = k as f64
  let c = pow_log_rows[i]
  let r = fma(z, c.invc, -1.0)
  let t1 = kd * 0.6931471805598903 + c.logc
  let t2 = t1 + r
  let lo1 = kd * 5.497923018708371e-14 + c.logctail
  let lo2 = t1 - t2 + r
  let ar = -0.5 * r
  let ar2 = r * ar
  let ar3 = r * ar2
  let hi = t2 + ar2
  let lo3 = fma(ar, r, -ar2)
  let lo4 = t2 - hi + ar2
  let p = ar3 * (-0.6666666666666679 + r * 0.5000000000000007 +
                 ar2 * (0.7999999995323976 + r * -0.6666666663487739 +
                        ar2 * (-1.142909628459501 + r * 1.0000415263675542)))
  let lo = lo1 + lo2 + lo3 + lo4 + p
  let y = hi + lo
  (y, hi - y + lo)
}

// e to the power of x + xtail, |xtail| far below |x| (Arm's exp_inline):
// x is k ln2/128 + r, |r| at most ln2/256, and e^x = 2^(k/128) e^r, the
// first from the tables (as its bits, the k/128 a whole number of them
// added to the exponent, and a tail), the second a polynomial. Where
// 2^(k/128) is no float the exponent is shifted there and back.
fn pow_exp(x: f64, xtail: f64) -> f64 {
  let abstop = (bits_of(x) >> 52) & 0x7ff
  if abstop < 0x3c9 { 1.0 + x }
  else if abstop >= 0x409 { if x < 0.0 { 0.0 } else { infinity64() } }
  else {
    let z = 184.6649652337873 * x
    let shifted = z + 6755399441055744.0
    let ki = bits_of(shifted)
    let kd = shifted - 6755399441055744.0
    let r = x + kd * -0.005415212348111709 + kd * -1.2864023111638346e-14 + xtail
    let idx = (ki & 127) as i32
    let tail = float_of(exp_tail[idx])
    let sbits = exp_bits[idx] + (ki << 45)
    let r2 = r * r
    let tmp = tail + r + r2 * (0.49999999999996786 + r * 0.16666666666665886) +
              r2 * r2 * (0.0416666808410674 + r * 0.008333335853059549)
    if abstop < 0x408 { float_of(sbits) + float_of(sbits) * tmp }
    else if (ki & 0x80000000) == 0 {
      // (Above the largest float's half: 2^1009 later.)
      let scale = float_of(sbits - 0x3f10000000000000)
      (scale + scale * tmp) * float_of(0x7f00000000000000)
    } else {
      // (Below the least normal float: rounded to its last bit before
      // 2^-1022 makes it a subnormal one, so as not to round twice.)
      let below = sbits + 0x3fe0000000000000
      let scale = float_of(below)
      let y = scale + scale * tmp
      if abs64(y) < 1.0 {
        let one = if y < 0.0 { -1.0 as f64 } else { 1.0 }
        let lo = scale - y + scale * tmp
        let hi = one + y
        let rounded = (hi + ((one - hi + y) + lo)) - one
        (if rounded == 0.0 { float_of(below & 0x8000000000000000) } else { rounded }) *
          float_of(0x0010000000000000)
      } else { y * float_of(0x0010000000000000) }
    }
  }
}

// Whether a finite y is a whole number, and an odd one.
fn whole64(y: f64) -> bool { trunc64(y) == y }
fn odd64(y: f64) -> bool {
  whole64(y) && exponent64(y) < 53 && ((trunc64(y) as i64) & 1) == 1
}

// x to the power of y, as C's pow says for the ends (0, infinities, not a
// number, x below 0): else e to the power of y * log(|x|), the logarithm
// and the product in two floats (Arm's pow.c, optimized-routines; within
// 0.52 ulp).
fn pow64(x: f64, y: f64) -> f64 {
  let inf = infinity64()
  let nan = nan64()
  let ax = abs64(x)
  let ay = abs64(y)
  if y == 0.0 || x == 1.0 { 1.0 }
  else if x != x || y != y { nan }
  else if ay == inf {
    if ax == 1.0 { 1.0 }
    else if (ax < 1.0) == (y > 0.0) { 0.0 }
    else { inf }
  }
  else if x == 0.0 {
    let odd = odd64(y)
    if y < 0.0 { if odd { 1.0 / x } else { inf } }
    else { if odd { x } else { 0.0 } }
  }
  else if ax == inf {
    let odd = odd64(y)
    if y < 0.0 { if odd && x < 0.0 { -0.0 } else { 0.0 } }
    else { if odd && x < 0.0 { -inf } else { inf } }
  }
  else if x < 0.0 && !whole64(y) { nan }
  else {
    // (A subnormal x as a normal one, its exponent below the least.)
    let ix = if exponent64(ax) == -1023 { bits_of(ax * 4503599627370496.0) - 0x0340000000000000 }
             else { bits_of(ax) }
    let (hi, lo) = pow_log(ix)
    let ehi = y * hi
    let p = pow_exp(ehi, y * lo + fma(y, hi, -ehi))
    if x < 0.0 && odd64(y) { -p } else { p }
  }
}

// The words of 2/pi's fraction, 64 bits each, from its point (0 before
// it): for the reduction of large angles.
fn two_over_pi_word(i: u64) -> u64 {
  if i == 0 { 0 }
  else if i == 1 { 0xa2f9836e4e441529 }
  else if i == 2 { 0xfc2757d1f534ddc0 }
  else if i == 3 { 0xdb6295993c439041 }
  else if i == 4 { 0xfe5163abdebbc561 }
  else if i == 5 { 0xb7246e3a424dd2e0 }
  else if i == 6 { 0x06492eea09d1921c }
  else if i == 7 { 0xfe1deb1cb129a73e }
  else if i == 8 { 0xe88235f52ebb4484 }
  else if i == 9 { 0xe99c7026b45f7e41 }
  else if i == 10 { 0x3991d639835339f4 }
  else if i == 11 { 0x9c845f8bbdf9283b }
  else if i == 12 { 0x1ff897ffde05980f }
  else if i == 13 { 0xef2f118b5a0a6d1f }
  else if i == 14 { 0x6d367ecf27cb09b7 }
  else if i == 15 { 0x4f463f669e5fea2d }
  else if i == 16 { 0x7527bac7ebe5f17b }
  else if i == 17 { 0x3d0739f78a5292ea }
  else if i == 18 { 0x6bfb5fb11f8d5d08 }
  else { 0x56033046fc7b6bab }
}

// A large finite angle ax (above 2^19 * pi/2) as n quarter turns and
// hi + lo, from -pi/4 to pi/4: ax * 2/pi in whole numbers, from the 192
// bits of 2/pi that count for its exponent (Payne and Hanek, as Mojo's
// standard library does it).
fn quarters64_far(ax: f64) -> (i32, f64, f64) {
  let b = bits_of(ax)
  let m = (b & 0x000fffffffffffff) | 0x0010000000000000
  let at = (b >> 52) - 1013
  let q = at >> 6
  let r = at & 63
  let w0 = two_over_pi_word(q)
  let w1 = two_over_pi_word(q + 1)
  let w2 = two_over_pi_word(q + 2)
  let w3 = two_over_pi_word(q + 3)
  // (In two steps, so that r of 0 never shifts by 64.)
  let v0 = (w0 << r) | ((w1 >> 1) >> (63 - r))
  let v1 = (w1 << r) | ((w2 >> 1) >> (63 - r))
  let v2 = (w2 << r) | ((w3 >> 1) >> (63 - r))
  let (p2h, p2l) = mul_wide(m, v2)
  let (p1h, p1l) = mul_wide(m, v1)
  let r1 = p2h + p1l
  let r0 = p1h + m * v0 + (if r1 < p1l { 1 } else { 0 })
  let h = (r0 << 2) | (r1 >> 62)
  let l = (r1 << 2) | (p2l >> 62)
  // (The nearest quarter, and what is left of it, from -1/2 to 1/2, in
  // pieces of 53 bits that are floats exactly.)
  let n = (((r0 >> 62) + (h >> 63)) & 3) as i32
  let c0 = (h as i64) >> 11
  let c1 = (((h << 53) | (l >> 11)) >> 11) as i64
  let c2 = ((l << 42) >> 11) as i64
  let unit = 1.1102230246251565e-16 as f64
  let (f, fe) = two_sum64(c0 as f64 * unit, c1 as f64 * (unit * unit))
  let f_lo = fe + c2 as f64 * (unit * unit * unit)
  // (f + f_lo) * pi/2, as hi + lo.
  let (ph, pe) = two_prod64(f, 1.5707963267948966)
  let t = pe + (f * 6.123233995736766e-17 + f_lo * 1.5707963267948966)
  let hi = ph + t
  (n, hi, t - (hi - ph))
}

// A finite angle as n quarter turns and hi + lo, from about -pi/4 to
// pi/4: below 2^19 * pi/2 less n times pi/2 in three parts of 33 bits,
// each product exact and what each step leaves out kept (fdlibm's
// e_rem_pio2.c, with no step left out), else quarters64_far. Up to pi/4
// it is x as it is (-0 too).
fn quarters64(x: f64) -> (i32, f64, f64) {
  if bits_of(abs64(x)) <= 0x3fe921fb54442d18 { (0, x, 0.0 as f64) }
  else if abs64(x) > 823549.6653973004 {
    let (n, hi, lo) = quarters64_far(abs64(x))
    if x < 0.0 { ((4 - n) & 3, -hi, -lo) } else { (n, hi, lo) }
  } else {
    let k = floor64(x * 0.6366197723675814 + 0.5)
    let (r1, e1) = two_sum64(x - k * 1.5707963267341256, -(k * 6.077100506303966e-11))
    let (r2, e2) = two_sum64(r1, -(k * 2.0222662487111665e-21))
    let rest = (e1 + e2) - k * 8.4784276603689e-32
    let hi = r2 + rest
    (((k as i64) & 3) as i32, hi, rest - (hi - r2))
  }
}

// sin and cos of hi + lo, from -pi/4 to pi/4 (fdlibm's k_sin.c and
// k_cos.c).
fn sin64_near(x: f64, y: f64) -> f64 {
  let z = x * x
  let w = z * z
  let r = 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 +
          z * 2.75573137070700676789e-06) +
          z * w * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)
  let v = z * x
  x - ((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01)
}
fn cos64_near(x: f64, y: f64) -> f64 {
  let z = x * x
  let w = z * z
  let r = z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 +
          z * 2.48015872894767294178e-05)) +
          w * w * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 +
          z * -1.13596475577881948265e-11))
  let hz = 0.5 * z
  let one = 1.0 - hz
  one + (((1.0 - one) - hz) + (z * r - x * y))
}

// Of an angle in radians: not a number for an infinity.
fn sin64(x: f64) -> f64 {
  if x - x != 0.0 { nan64() }
  else {
    // (Both, and the one the quarter asks for chosen without a branch.)
    let (n, hi, lo) = quarters64(x)
    let r = if (n & 1) == 1 { cos64_near(hi, lo) } else { sin64_near(hi, lo) }
    if (n & 2) == 2 { -r } else { r }
  }
}
fn cos64(x: f64) -> f64 {
  if x - x != 0.0 { nan64() }
  else {
    let (n, hi, lo) = quarters64(x)
    let r = if (n & 1) == 1 { sin64_near(hi, lo) } else { cos64_near(hi, lo) }
    if ((n + 1) & 2) == 2 { -r } else { r }
  }
}

// tan of hi + lo, from -pi/4 to pi/4, or -1 over it when `odd` (fdlibm's
// k_tan.c): above 0.6744 by tan(pi/4 - x), from one near 0.
fn tan64_near(x0: f64, y0: f64, odd: bool) -> f64 {
  let big = bits_of(abs64(x0)) >= 0x3fe5942800000000
  let neg = x0 < 0.0
  let sx = if neg { -x0 } else { x0 }
  let sy = if neg { -y0 } else { y0 }
  let x = if big { (7.85398163397448278999e-01 - sx) + (3.06161699786838301793e-17 - sy) } else { x0 }
  let y = if big { 0.0 as f64 } else { y0 }
  let z = x * x
  let w = z * z
  let r0 = 1.33333333333201242699e-01 + w * (2.18694882948595424599e-02 +
           w * (3.59207910759131235356e-03 + w * (5.88041240820264096874e-04 +
           w * (7.81794442939557092300e-05 + w * -1.85586374855275456654e-05))))
  let v0 = z * (5.39682539762260521377e-02 + w * (8.86323982359930005737e-03 +
           w * (1.45620945432529025516e-03 + w * (2.46463134818469906812e-04 +
           w * (7.14072491382608190305e-05 + w * 2.59073051863633712884e-05)))))
  let s = z * x
  let r = (y + z * (s * (r0 + v0) + y)) + 3.33333333333334091986e-01 * s
  let wx = x + r
  if big {
    let v = if odd { -1.0 as f64 } else { 1.0 }
    let t = v - 2.0 * (x - (wx * wx / (wx + v) - r))
    if neg { -t } else { t }
  }
  else if !odd { wx }
  else {
    // (-1 / (x + r) to the last bit: of its high half, and what is left.)
    let zh = float_of(bits_of(wx) & 0xffffffff00000000)
    let vl = r - (zh - x)
    let a = -1.0 / wx
    let t = float_of(bits_of(a) & 0xffffffff00000000)
    t + a * ((1.0 + t * zh) + t * vl)
  }
}
fn tan64(x: f64) -> f64 {
  if x - x != 0.0 { nan64() }
  else if bits_of(abs64(x)) < 0x3e40000000000000 { x }
  else {
    let (n, hi, lo) = quarters64(x)
    tan64_near(hi, lo, (n & 1) == 1)
  }
}

// atan(x) - x, for x from -7/16 to 7/16, by a polynomial in x * x
// (fdlibm's s_atan.c), or a `short` one, as an f32 needs (s_atanf.c).
fn atan_rest(x: f64, short: bool) -> f64 {
  let z = x * x
  let w = z * z
  if short {
    x * (z * (0.333333283662796 + w * (0.14253635704517365 + w * 0.06168760731816292)) +
         w * (-0.19999158382415771 + w * -0.106480173766613))
  } else {
  let s1 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 +
           w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02 +
           w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))))
  let s2 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 +
           w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02 +
           w * -3.65315727442169155270e-02))))
  x * (s1 + s2)
  }
}
// The angle whose tan x is, from -pi/2 to pi/2: atan(c) + atan(t), c
// the nearest of 0, 1/2, 1, 3/2 and infinity to |x|, atan(c) as hi + lo,
// and t = (|x| - c) / (1 + c * |x|) (-1 / |x| for infinity), near 0.
// Which c is chosen without a branch: how large x is is anyone's guess.
fn atan_of(x: f64, short: bool) -> f64 {
  let ax = abs64(x)
  let b = bits_of(ax)
  if x != x { nan64() }
  else if b < 0x3e40000000000000 { x }
  else {
    let past = (if b >= 0x3fdc000000000000 { 1 } else { 0 }) +
               (if b >= 0x3fe6000000000000 { 1 } else { 0 }) +
               (if b >= 0x3ff3000000000000 { 1 } else { 0 })
    let far = b >= 0x4003800000000000
    let c = 0.5 * past as f64
    let hi = if far { 1.57079632679489655800e+00 as f64 }
             else if past == 3 { 9.82793723247329054082e-01 }
             else if past == 2 { 7.85398163397448278999e-01 }
             else if past == 1 { 4.63647609000806093515e-01 }
             else { 0.0 }
    let lo = if far { 6.12323399573676603587e-17 as f64 }
             else if past == 3 { 1.39033110312309984516e-17 }
             else if past == 2 { 3.06161699786838301793e-17 }
             else if past == 1 { 2.26987774529616870924e-17 }
             else { 0.0 }
    let t = (if far { -1.0 as f64 } else { ax - c }) / (if far { ax } else { 1.0 + c * ax })
    let z = hi - ((atan_rest(t, short) - lo) - t)
    if x < 0.0 { -z } else { z }
  }
}
fn atan64(x: f64) -> f64 { atan_of(x, false) }

// The angle of the point (x, y), from -pi to pi, as C's atan2 says for
// the ends (fdlibm's e_atan2.c): pi less the atan where x is below 0,
// with pi's low part.
fn atan2_of(y: f64, x: f64, short: bool) -> f64 {
  let pi = 3.1415926535897931160e+00 as f64
  let pi_lo = 1.2246467991473531772e-16 as f64
  let half = 1.5707963267948965580e+00 as f64
  let inf = infinity64()
  let ax = abs64(x)
  let ay = abs64(y)
  let xneg = (bits_of(x) >> 63) == 1
  let yneg = (bits_of(y) >> 63) == 1
  if x != x || y != y { nan64() }
  else if x == 1.0 { atan_of(y, short) }
  else if y == 0.0 { if !xneg { y } else if yneg { -pi } else { pi } }
  else if x == 0.0 || ay == inf {
    if ax == inf {
      let z = if xneg { 3.0 * 7.8539816339744827900e-01 as f64 } else { 7.8539816339744827900e-01 }
      if yneg { -z } else { z }
    }
    else if yneg { -half } else { half }
  }
  else if ax == inf {
    let z = if xneg { pi } else { 0.0 as f64 }
    if yneg { -z } else { z }
  }
  else {
    let k = ((bits_of(ay) >> 52) as i32) - ((bits_of(ax) >> 52) as i32)
    let z = if k > 60 { half + 0.5 * pi_lo }
            else if xneg && k < -60 { 0.0 as f64 }
            else { atan_of(ay / ax, short) }
    let w = if xneg && k <= 60 { pi - (z - pi_lo) } else { z }
    if yneg { -w } else { w }
  }
}
fn atan264(y: f64, x: f64) -> f64 { atan2_of(y, x, false) }

// asin(sqrt(t))/sqrt(t) - 1, as a rational function of t from 0 to 1/4
// (fdlibm's e_asin.c).
fn asin_ratio(t: f64) -> f64 {
  t * (1.66666666666666657415e-01 + t * (-3.25565818622400915405e-01 +
       t * (2.01212532134862925881e-01 + t * (-4.00555345006794114027e-02 +
       t * (7.91534994289814532176e-04 + t * 3.47933107596021167570e-05))))) /
    (1.0 + t * (-2.40339491173441421878e+00 + t * (2.02094576023350569471e+00 +
     t * (-6.88283971605453293030e-01 + t * 7.70381505559019352791e-02))))
}

// The angle whose sin x is, from -pi/2 to pi/2 (fdlibm's e_asin.c): below
// 1/2 of x, else pi/2 - 2 asin(sqrt((1 - |x|) / 2)), that root in two
// parts where it is not near 1.
fn asin64(x: f64) -> f64 {
  let ax = abs64(x)
  let b = bits_of(ax)
  if b >= 0x3ff0000000000000 {
    if ax == 1.0 { x * 1.57079632679489655800e+00 + x * 6.12323399573676603587e-17 }
    else { nan64() }
  }
  else if b < 0x3e50000000000000 { x }
  else if b < 0x3fe0000000000000 { x + x * asin_ratio(x * x) }
  else {
    let t = (1.0 - ax) * 0.5
    let s = sqrt(t)
    let r = asin_ratio(t)
    let a = if b >= 0x3fef333300000000 {
              1.57079632679489655800e+00 - (2.0 * (s + s * r) - 6.12323399573676603587e-17)
            } else {
              let w = float_of(bits_of(s) & 0xffffffff00000000)
              let c = (t - w * w) / (s + w)
              let p = 2.0 * s * r - (6.12323399573676603587e-17 - 2.0 * c)
              7.85398163397448278999e-01 - (p - (7.85398163397448278999e-01 - 2.0 * w))
            }
    if x < 0.0 { -a } else { a }
  }
}

// The angle whose cos x is, from 0 to pi (fdlibm's e_acos.c): below 1/2
// pi/2 - asin(x), else 2 asin(sqrt((1 - |x|) / 2)) (from pi where x is
// below 0), that root in two parts where x is above 0.
fn acos64(x: f64) -> f64 {
  let ax = abs64(x)
  let b = bits_of(ax)
  let pio2_hi = 1.57079632679489655800e+00 as f64
  let pio2_lo = 6.12323399573676603587e-17 as f64
  if b >= 0x3ff0000000000000 {
    if x == 1.0 { 0.0 }
    else if x == -1.0 { 3.14159265358979311600e+00 + 2.0 * pio2_lo }
    else { nan64() }
  }
  else if b < 0x3c60000100000000 { pio2_hi + pio2_lo }
  else if b < 0x3fe0000000000000 { pio2_hi - (x - (pio2_lo - x * asin_ratio(x * x))) }
  else if x < 0.0 {
    let z = (1.0 + x) * 0.5
    let s = sqrt(z)
    3.14159265358979311600e+00 - 2.0 * (s + (asin_ratio(z) * s - pio2_lo))
  } else {
    let z = (1.0 - x) * 0.5
    let s = sqrt(z)
    let df = float_of(bits_of(s) & 0xffffffff00000000)
    let c = (z - df * df) / (s + df)
    2.0 * (df + (asin_ratio(z) * s + c))
  }
}

// log2(c) for the 16 c near which a fraction from 0x1.66p-1 to 0x1.66p0
// falls, and 1/c (Arm's powf_log2_data.c).
table powf_log2_rows { invc: f64, logc: f64 } = [
  { invc: 1.398907162146528, logc: -0.48430022186289673 },
  { invc: 1.3403141896637998, logc: -0.42257122959194704 },
  { invc: 1.286432210124115, logc: -0.3633754347673556 },
  { invc: 1.2367150214269895, logc: -0.30651309567405577 },
  { invc: 1.1906977166711752, logc: -0.25180720160537634 },
  { invc: 1.1479821020556429, logc: -0.19910014943794563 },
  { invc: 1.1082251448272158, logc: -0.14825100623281615 },
  { invc: 1.0711297413057381, logc: -0.09913323807318392 },
  { invc: 1.036437278977283, logc: -0.051632812977629436 },
  { invc: 1.0, logc: 0.0 },
  { invc: 0.9492859795739057, logc: 0.07508531937943004 },
  { invc: 0.8951049428609004, logc: 0.15987125980713107 },
  { invc: 0.8476821620351103, logc: 0.2384046664317681 },
  { invc: 0.8050314851692001, logc: 0.31288288605863257 },
  { invc: 0.7664671008843108, logc: 0.38370422656453185 },
  { invc: 0.731428603316328, logc: 0.451211048935815 }
]
// 2^(i/32) as its bits less i/32 in the exponent (Arm's exp2f_data.c).
table exp2f_bits: u64 = [0x3ff0000000000000, 0x3fefd9b0d3158574, 0x3fefb5586cf9890f, 0x3fef9301d0125b51, 0x3fef72b83c7d517b, 0x3fef54873168b9aa, 0x3fef387a6e756238, 0x3fef1e9df51fdee1, 0x3fef06fe0a31b715, 0x3feef1a7373aa9cb, 0x3feedea64c123422, 0x3feece086061892d, 0x3feebfdad5362a27, 0x3feeb42b569d4f82, 0x3feeab07dd485429, 0x3feea47eb03a5585, 0x3feea09e667f3bcd, 0x3fee9f75e8ec5f74, 0x3feea11473eb0187, 0x3feea589994cce13, 0x3feeace5422aa0db, 0x3feeb737b0cdc5e5, 0x3feec49182a3f090, 0x3feed503b23e255d, 0x3feee89f995ad3ad, 0x3feeff76f2fb5e47, 0x3fef199bdd85529c, 0x3fef3720dcef9069, 0x3fef5818dcfba487, 0x3fef7c97337b9b5f, 0x3fefa4afa2a490da, 0x3fefd0765b6e4540]

// log2 of the bits of an f32 above 0 (a subnormal's with its exponent
// below the least; Arm's powf.c): x is 2^k z, z near the c of its row,
// and log2(x) = k + log2(c) + log2(1 + r), r = z/c - 1, a polynomial.
// Within 2^-32.
fn powf_log2(ix: u32) -> f64 {
  let tmp = ix - 0x3f330000
  let i = ((tmp >> 19) & 15) as i32
  let top = tmp & 0xff800000
  let k = ((top as i32) >> 23) as f64
  let c = powf_log2_rows[i]
  let r = (float_of(ix - top) as f64) * c.invc - 1.0
  let r2 = r * r
  let y = 0.288457581109214 * r + -0.36092606229713164
  let p = 0.480898481472577 * r + -0.7213474675006291
  let q = p * r2 + (1.4426950408774342 * r + (c.logc + k))
  y * (r2 * r2) + q
}
// 2 to the power of x, |x| below 126: 2^(k/32) from the table, the k/32
// a whole number of them added to the exponent, times 2^r, |r| at most
// 1/64, a polynomial. Within 2^-33.
fn powf_exp2(x: f64) -> f64 {
  let shifted = x + 211106232532992.0
  let ki = bits_of(shifted)
  let r = x - (shifted - 211106232532992.0)
  let s = float_of(exp2f_bits[(ki & 31) as i32] + (ki << 47))
  let z = 0.05550361559341535 * r + 0.2402284522445722
  ((z * (r * r)) + (0.6931471806916203 * r + 1.0)) * s
}

// The f32 ones: worked out in f64 with polynomials as short as an f32
// needs, error below 2^-34 (FreeBSD's msun: k_sinf.c, k_cosf.c,
// e_rem_pio2f.c, s_atanf.c, k_logf.h), and rounded once. Not a number
// of theirs has the bits 0x7fc00000.
fn nan32() -> f32 { float_of(0x7fc00000 as u32) }
fn infinity32() -> f32 { float_of(0x7f800000 as u32) }
fn to32(x: f64) -> f32 { if x != x { nan32() } else { x as f32 } }

// An f32 angle (in an f64) as n quarter turns and the rest, from about
// -pi/4 to pi/4: below 2^28 * pi/2 less n times pi/2 in 25 bits (so n
// times it is exact) and the next 53 (0 times, x as it is), else
// quarters64_far.
fn quarters32(x: f64) -> (i32, f64) {
  let ax = abs64(x)
  if ax < 421657440.0 {
    // (To the nearest whole number: what adding 1.5 * 2^52 leaves.)
    let k = (x * 0.6366197723675814 + 6755399441055744.0) - 6755399441055744.0
    (((k as i64) & 3) as i32, (x - k * 1.5707963109016418) - k * 1.5893254773528196e-08)
  } else {
    let (n, hi, lo) = quarters64_far(ax)
    if x < 0.0 { ((4 - n) & 3, -(hi + lo)) } else { (n, hi + lo) }
  }
}

// sin and cos of x from -pi/4 to pi/4 (and tan their quotient).
fn sin32_near(x: f64) -> f64 {
  let z = x * x
  let w = z * z
  let r = -0.00019839334836096632 + z * 2.718311493989822e-06
  let s = z * x
  (x + s * (-0.16666666641626524 + z * 0.008333329385889463)) + s * w * r
}
fn cos32_near(x: f64) -> f64 {
  let z = x * x
  let w = z * z
  let r = -0.001388676377460993 + z * 2.439044879627741e-05
  ((1.0 + z * -0.499999997251031) + w * 0.04166662332373906) + (w * z) * r
}

// log(1 + f), for 1 + f from sqrt(2)/2 to sqrt(2), as an f32 needs.
fn log32_1p(f: f64) -> f64 {
  let s = f / (2.0 + f)
  let z = s * s
  let w = z * z
  let r = z * (0.6666666269302368 + w * 0.2849878668785095) +
          w * (0.40000972151756287 + w * 0.24279078841209412)
  let hfsq = 0.5 * f * f
  f - (hfsq - s * (hfsq + r))
}

// Square root, powers and logarithms. `pow(x, y)` is x to the power of y,
// `exp(x)` e to the power of x, `log` the natural logarithm. (`sqrt` of
// an f32 or an f64 is built in.)
// (pow of x above the least normal f32 and finite, and a y neither 0
// nor infinite, where |y * log2(x)| is below 126: 2 to the power of that,
// in f64 (Arm's powf.c, within 0.82 ulp); the rest as pow64 says.)
fn pow(x: f32, y: f32) -> f32 {
  let ix = bits_of(x)
  if ix - 0x00800000 >= 0x7f000000 || (bits_of(y) << 1) - 1 >= 0xfeffffff {
    to32(pow64(x as f64, y as f64))
  } else {
    let ylogx = (y as f64) * powf_log2(ix)
    if abs64(ylogx) >= 126.0 { to32(pow64(x as f64, y as f64)) }
    else { powf_exp2(ylogx) as f32 }
  }
}
fn exp(x: f32) -> f32 { to32(exp64(x as f64)) }
fn log(x: f32) -> f32 {
  if x != x || x < 0.0 { nan32() }
  else if x == 0.0 { -infinity32() }
  else if x == infinity32() { x }
  else {
    let (k, f) = log64_parts(x as f64)
    (k * 0.6931471805599453 + log32_1p(f)) as f32
  }
}
fn log2(x: f32) -> f32 {
  if x != x || x < 0.0 { nan32() }
  else if x == 0.0 { -infinity32() }
  else if x == infinity32() { x }
  else {
    let (k, f) = log64_parts(x as f64)
    (k + log32_1p(f) * 1.4426950408889634) as f32
  }
}

// Angles. `atan2(y, x)` is the angle of the point (x, y), from -pi to pi.
fn sin(x: f32) -> f32 {
  let d = x as f64
  if d - d != 0.0 { nan32() }
  else if bits_of(abs(x)) < 0x39800000 { x }
  else {
    // (Both, and the one the quarter asks for chosen without a branch.)
    let (n, y) = quarters32(d)
    let r = if (n & 1) == 1 { cos32_near(y) } else { sin32_near(y) }
    (if (n & 2) == 2 { -r } else { r }) as f32
  }
}
fn cos(x: f32) -> f32 {
  let d = x as f64
  if d - d != 0.0 { nan32() }
  else {
    let (n, y) = quarters32(d)
    let r = if (n & 1) == 1 { sin32_near(y) } else { cos32_near(y) }
    (if ((n + 1) & 2) == 2 { -r } else { r }) as f32
  }
}
fn tan(x: f32) -> f32 {
  let d = x as f64
  if d - d != 0.0 { nan32() }
  else if bits_of(abs(x)) < 0x39800000 { x }
  else {
    let (n, y) = quarters32(d)
    let sy = sin32_near(y)
    let cy = cos32_near(y)
    let odd = (n & 1) == 1
    ((if odd { -cy } else { sy }) / (if odd { sy } else { cy })) as f32
  }
}
// (asin and acos: as asin64 and acos64, but for the root's second part,
// which an f32 needs not; the polynomial is the f64 one, as a shorter
// one, e_asinf.c's, leaves one in 600 a bit off.)
fn asin(x: f32) -> f32 {
  let d = x as f64
  let ad = abs64(d)
  if !(ad <= 1.0) { nan32() }
  else if bits_of(abs(x)) < 0x39800000 { x }
  else if ad < 0.5 { (d + d * asin_ratio(d * d)) as f32 }
  else {
    let t = (1.0 - ad) * 0.5
    let s = sqrt(t)
    let a = 1.5707963267948966 - 2.0 * (s + s * asin_ratio(t))
    (if x < 0.0 { -a } else { a }) as f32
  }
}
fn acos(x: f32) -> f32 {
  let d = x as f64
  let ad = abs64(d)
  if !(ad <= 1.0) { nan32() }
  else if ad < 0.5 { (1.5707963267948966 - (d + d * asin_ratio(d * d))) as f32 }
  else {
    let z = (1.0 - ad) * 0.5
    let s = sqrt(z)
    let a = 2.0 * (s + s * asin_ratio(z))
    (if x < 0.0 { 3.141592653589793 - a } else { a }) as f32
  }
}
fn atan(x: f32) -> f32 { to32(atan_of(x as f64, true)) }
fn atan2(y: f32, x: f32) -> f32 { to32(atan2_of(y as f64, x as f64, true)) }

fn floor(x: f32) -> f32 { floor64(x as f64) as f32 }
fn ceil(x: f32) -> f32 { ceil64(x as f64) as f32 }
fn round(x: f32) -> f32 { round64(x as f64) as f32 }
fn trunc(x: f32) -> f32 { trunc64(x as f64) as f32 }
// What is left of x after taking y away as often as it fits, with x's
// sign (`%` does the same).
fn fmod(x: f32, y: f32) -> f32 { to32(fmod64(x as f64, y as f64)) }


fn pi() -> f32 { 3.14159265358979 }
fn pi64() -> f64 { 3.14159265358979 }
// A whole turn.
fn tau() -> f32 { 6.28318530717959 }
fn tau64() -> f64 { 6.28318530717959 }
fn radians(degrees: f32) -> f32 { degrees * 0.0174532925199433 }
fn degrees(radians: f32) -> f32 { radians * 57.2957795130823 }

// -1, 0 or 1, as x is below, at or above 0.
fn sign(x: f32) -> f32 { if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 } }
fn sign64(x: f64) -> f64 { if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 } }
fn isign(x: i32) -> i32 { if x > 0 { 1 } else if x < 0 { -1 } else { 0 } }

// x, but not below `low` and not above `high`.
fn clamp(x: f32, low: f32, high: f32) -> f32 { min(max(x, low), high) }
fn clamp64(x: f64, low: f64, high: f64) -> f64 { min(max(x, low), high) }
fn iclamp(x: i32, low: i32, high: i32) -> i32 { min(max(x, low), high) }

// From a (at t = 0) to b (at t = 1), and beyond.
fn lerp(a: f32, b: f32, t: f32) -> f32 { a + (b - a) * t }
fn lerp64(a: f64, b: f64, t: f64) -> f64 { a + (b - a) * t }

// What follows the point: x less its floor, from 0 up to 1.
fn fract(x: f32) -> f32 { x - floor(x) }

// How long the arrow (x, y) is, and how far two points are apart.
fn length(x: f32, y: f32) -> f32 { sqrt(x * x + y * y) }
fn distance(ax: f32, ay: f32, bx: f32, by: f32) -> f32 {
  length(bx - ax, by - ay)
}

// x times itself `n` times; 1 if n is 0 or less.
fn ipow(x: i32, n: i32) -> i32 {
  var result = 1
  for i in 0..n { result *= x }
  result
}

// Typical math: `import math`.
//
//   import math
//   system orbit() {
//     for p: mut Position, o: Orbit {
//       p.x = o.cx + cos(o.angle) * o.radius
//       p.y = o.cy + sin(o.angle) * o.radius
//     }
//   }
//
// Everything is a fn: it computes, and may be called anywhere a fn may,
// also in a `for` that runs on all cores. A name without a suffix is for
// f32, the language's everyday float; with `64` for f64 (`sin64`), with an
// `i` in front for i32 (`iabs`). Angles are radians.
//
// Roots, powers, logarithms, angles, the whole numbers of a float and
// what is left of a division are written here, from the operations IEEE 754 rounds exactly
// (`+ - * /`, the built-in `sqrt`) and the bits of floats (`bits_of`,
// `float_of`): every machine, and the GPU (docs/gpu.md), gives the same
// results to the bit. They follow Sun's fdlibm (by way of FreeBSD's msun
// and Mojo's standard library), within an ulp of the true value; `pow64`
// within a few where the result is near the ends of the range. The f32
// ones are the f64 ones, rounded once. What is left of the machine's math
// library (asin, acos) is implemented in devices/math.c, and runs on the
// CPU only.

// Without its sign.
fn abs(x: f32) -> f32 { max(x, -x) }
fn abs64(x: f64) -> f64 { max(x, -x) }
fn iabs(x: i32) -> i32 { max(x, -x) }

// What a float is made of: its exponent field, and its fraction bits.
fn exponent64(x: f64) -> i32 { ((bits_of(x) >> 52) & 0x7ff) as i32 - 1023 }
fn infinity64() -> f64 { float_of(0x7ff0000000000000) }
// Not a number, with the same bits wherever it comes from here (IEEE 754
// leaves those of `0.0 / 0.0` to the machine).
fn nan64() -> f64 { float_of(0x7ff8000000000000) }

// To a whole number, still a float: towards 0, down, up, and to the
// nearest (halves away from 0). `x as i32` then makes it an integer.
fn trunc64(x: f64) -> f64 {
  let b = bits_of(x)
  let e = exponent64(x)
  if e >= 52 { x }
  else if e < 0 { float_of(b & 0x8000000000000000) }
  else { float_of(b & ~(0x000fffffffffffff >> (e as u64))) }
}
fn floor64(x: f64) -> f64 {
  let t = trunc64(x)
  if t > x { t - 1.0 } else { t }
}
fn ceil64(x: f64) -> f64 {
  let t = trunc64(x)
  if t < x { t + 1.0 } else { t }
}
fn round64(x: f64) -> f64 {
  let b = bits_of(x)
  let e = exponent64(x)
  let sign = b & 0x8000000000000000
  if e >= 52 { x }
  else if e == -1 { float_of(sign | 0x3ff0000000000000) }
  else if e < 0 { float_of(sign) }
  else {
    let half = 0x0008000000000000 as u64 >> (e as u64)
    let below = 0x000fffffffffffff as u64 >> (e as u64)
    float_of((b + half) & ~below)
  }
}

fn sqrt64(x: f64) -> f64 { if x < 0.0 { nan64() } else { sqrt(x) } }

// x times 2 to the power of k, for k from -2044 to 2046: in two steps of
// which only the second rounds.
fn scale64(x: f64, k: i32) -> f64 {
  let k1 = k >> 1
  x * float_of(((k1 + 1023) as u64) << 52) *
    float_of(((k - k1 + 1023) as u64) << 52)
}

// A finite x above 0 as m times 2 to the power of e - 52, m a whole
// number of 53 bits (below the least normal float, too).
fn fraction64(x: f64) -> (u64, i32) {
  let tiny = exponent64(x) == -1023
  let y = if tiny { x * 18014398509481984.0 } else { x }
  ((bits_of(y) & 0x000fffffffffffff) | 0x0010000000000000,
   exponent64(y) - (if tiny { 54 } else { 0 }))
}

// What is left of m times 2 to the power of `shift` after taking n away
// as often as it fits, m and n of 53 bits: long division, a bit at a
// time.
fn remainder_bits(m: u64, n: u64, shift: i32) -> u64 {
  var r = m
  for i in 0..shift {
    if r >= n { r = r - n }
    r = r << 1
  }
  if r >= n { r - n } else { r }
}

// What is left of x after taking y away as often as it fits, with x's
// sign: exactly, from the whole numbers of their fractions (as musl does
// it).
fn fmod64(x: f64, y: f64) -> f64 {
  let ax = abs64(x)
  let ay = abs64(y)
  if x != x || y != y || ay == 0.0 || ax == infinity64() { nan64() }
  else if ax < ay { x }
  else {
    let (mx, ex) = fraction64(ax)
    let (my, ey) = fraction64(ay)
    let r = scale64(remainder_bits(mx, my, ex - ey) as f64, ey - 52)
    if x < 0.0 { -r } else { r }
  }
}

// a + b as the float nearest and what that leaves out, exactly; a * b
// likewise (Veltkamp's split: the halves multiply exactly), for products
// far from overflowing.
fn two_sum64(a: f64, b: f64) -> (f64, f64) {
  let s = a + b
  let bb = s - a
  (s, (a - (s - bb)) + (b - bb))
}
fn split64(a: f64) -> (f64, f64) {
  let c = 134217729.0 * a
  let hi = c - (c - a)
  (hi, a - hi)
}
fn two_prod64(a: f64, b: f64) -> (f64, f64) {
  let p = a * b
  let (ah, al) = split64(a)
  let (bh, bl) = split64(b)
  (p, ((ah * bh - p) + ah * bl + al * bh) + al * bl)
}

// e to the power of hi - lo, for |hi - lo| at most ln 2 / 2 (fdlibm's
// e_exp.c).
fn exp64_near(hi: f64, lo: f64) -> f64 {
  let r = hi - lo
  let t = r * r
  let c = r - t * (1.66666666666666019037e-01 + t * (-2.77777777770155933842e-03 +
          t * (6.61375632143793436117e-05 + t * (-1.65339022054652515390e-06 +
          t * 4.13813679705723846039e-08))))
  1.0 - ((lo - (r * c) / (2.0 - c)) - hi)
}

// e to the power of hi + lo: hi less k times ln 2 (k * ln2's high part is
// exact, and so the difference), then the rest by exp64_near.
fn exp64_of(hi: f64, lo: f64) -> f64 {
  if hi != hi { hi }
  else if hi > 709.782712893383973096 { infinity64() }
  else if hi < -745.13321910194110842 { 0.0 }
  else {
    let k = floor64(hi * 1.4426950408889634 + 0.5)
    let r = hi - k * 6.93147180369123816490e-01
    scale64(exp64_near(r, k * 1.90821492927058770002e-10 - lo), k as i32)
  }
}
fn exp64(x: f64) -> f64 { exp64_of(x, 0.0) }

// x as 2 to the power of k times 1 + f, with 1 + f from sqrt(2)/2 to
// sqrt(2), for x above 0 (below the least normal float, too).
fn log64_parts(x: f64) -> (f64, f64) {
  let tiny = exponent64(x) == -1023
  let y = if tiny { x * 18014398509481984.0 } else { x }
  let b = bits_of(y)
  var k = exponent64(y) - (if tiny { 54 } else { 0 })
  var m = float_of((b & 0x000fffffffffffff) | 0x3ff0000000000000)
  if m > 1.4142135623730951 {
    m = m * 0.5
    k += 1
  }
  (k as f64, m - 1.0)
}

// log(1 + f) - f + f * f / 2, for 1 + f from sqrt(2)/2 to sqrt(2): of
// s = f / (2 + f), by a polynomial in s * s (fdlibm's k_log.h).
fn log64_kernel(s: f64) -> f64 {
  let z = s * s
  let w = z * z
  w * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 +
       w * 1.531383769920937332e-01)) +
    z * (6.666666666666735130e-01 + w * (2.857142874366239149e-01 +
         w * (1.818357216161805012e-01 + w * 1.479819860511658591e-01)))
}

// The natural logarithm (fdlibm's e_log.c).
fn log64(x: f64) -> f64 {
  if x != x { x }
  else if x < 0.0 { nan64() }
  else if x == 0.0 { -infinity64() }
  else if x == infinity64() { x }
  else {
    let (k, f) = log64_parts(x)
    let s = f / (2.0 + f)
    let hfsq = 0.5 * f * f
    k * 6.93147180369123816490e-01 -
      ((hfsq - (s * (hfsq + log64_kernel(s)) + k * 1.90821492927058770002e-10)) - f)
  }
}

// The logarithm to base 2 (fdlibm's e_log2.c): k exactly, and log(1 + f)
// times 1/ln 2 with f - f * f / 2 in two floats, so near sqrt(2) and its
// half the sum with k loses nothing.
fn log264(x: f64) -> f64 {
  if x != x { x }
  else if x < 0.0 { nan64() }
  else if x == 0.0 { -infinity64() }
  else if x == infinity64() { x }
  else {
    let (k, f) = log64_parts(x)
    let s = f / (2.0 + f)
    let hfsq = 0.5 * f * f
    let r = s * (hfsq + log64_kernel(s))
    let hi = float_of(bits_of(f - hfsq) & 0xffffffff00000000)
    let lo = ((f - hi) - hfsq) + r
    let val_hi = hi * 1.44269504072144627571e+00
    let val_lo = (lo + hi) * 1.67517131648865118353e-10 + lo * 1.44269504072144627571e+00
    let w = k + val_hi
    (val_lo + ((k - w) + val_hi)) + w
  }
}

// The natural logarithm of x above 0 and finite, as hi + lo: log(1 + f)
// is 2s + s * R(s * s), with s carried in two floats.
fn log64_two(x: f64) -> (f64, f64) {
  let (k, f) = log64_parts(x)
  let (dh, dl) = two_sum64(2.0, f)
  let sh = f / dh
  let (p, pe) = two_prod64(sh, dh)
  let sl = (((f - p) - pe) - sh * dl) / dh
  let (a, ae) = two_sum64(k * 6.93147180369123816490e-01, 2.0 * sh)
  let lo = ae + (k * 1.90821492927058770002e-10 + (2.0 * sl + sh * log64_kernel(sh)))
  two_sum64(a, lo)
}

// Whether a finite y is a whole number, and an odd one.
fn whole64(y: f64) -> bool { trunc64(y) == y }
fn odd64(y: f64) -> bool {
  whole64(y) && exponent64(y) < 53 && ((trunc64(y) as i64) & 1) == 1
}

// x to the power of y, as C's pow says for the ends (0, infinities, not a
// number, x below 0): else e to the power of y * log(x), that product in
// two floats.
fn pow64(x: f64, y: f64) -> f64 {
  let inf = infinity64()
  let nan = nan64()
  let ax = abs64(x)
  let ay = abs64(y)
  if y == 0.0 || x == 1.0 { 1.0 }
  else if x != x || y != y { nan }
  else if ay == inf {
    if ax == 1.0 { 1.0 }
    else if (ax < 1.0) == (y > 0.0) { 0.0 }
    else { inf }
  }
  else if x == 0.0 {
    let odd = odd64(y)
    if y < 0.0 { if odd { 1.0 / x } else { inf } }
    else { if odd { x } else { 0.0 } }
  }
  else if ax == inf {
    let odd = odd64(y)
    if y < 0.0 { if odd && x < 0.0 { -0.0 } else { 0.0 } }
    else { if odd && x < 0.0 { -inf } else { inf } }
  }
  else if x < 0.0 && !whole64(y) { nan }
  else {
    let (lh, ll) = log64_two(ax)
    let rough = y * lh
    let p = if rough > 710.0 { inf }
            else if rough < -746.0 { 0.0 }
            else {
              let (ph, pe) = two_prod64(y, lh)
              let (eh, el) = two_sum64(ph, pe + y * ll)
              exp64_of(eh, el)
            }
    if x < 0.0 && odd64(y) { -p } else { p }
  }
}

// The words of 2/pi's fraction, 64 bits each, from its point (0 before
// it): for the reduction of large angles.
fn two_over_pi_word(i: u64) -> u64 {
  if i == 0 { 0 }
  else if i == 1 { 0xa2f9836e4e441529 }
  else if i == 2 { 0xfc2757d1f534ddc0 }
  else if i == 3 { 0xdb6295993c439041 }
  else if i == 4 { 0xfe5163abdebbc561 }
  else if i == 5 { 0xb7246e3a424dd2e0 }
  else if i == 6 { 0x06492eea09d1921c }
  else if i == 7 { 0xfe1deb1cb129a73e }
  else if i == 8 { 0xe88235f52ebb4484 }
  else if i == 9 { 0xe99c7026b45f7e41 }
  else if i == 10 { 0x3991d639835339f4 }
  else if i == 11 { 0x9c845f8bbdf9283b }
  else if i == 12 { 0x1ff897ffde05980f }
  else if i == 13 { 0xef2f118b5a0a6d1f }
  else if i == 14 { 0x6d367ecf27cb09b7 }
  else if i == 15 { 0x4f463f669e5fea2d }
  else if i == 16 { 0x7527bac7ebe5f17b }
  else if i == 17 { 0x3d0739f78a5292ea }
  else if i == 18 { 0x6bfb5fb11f8d5d08 }
  else { 0x56033046fc7b6bab }
}

// A large finite angle ax (above 2^19 * pi/2) as n quarter turns and
// hi + lo, from -pi/4 to pi/4: ax * 2/pi in whole numbers, from the 192
// bits of 2/pi that count for its exponent (Payne and Hanek, as Mojo's
// standard library does it).
fn quarters64_far(ax: f64) -> (i32, f64, f64) {
  let b = bits_of(ax)
  let m = (b & 0x000fffffffffffff) | 0x0010000000000000
  let at = (b >> 52) - 1013
  let q = at >> 6
  let r = at & 63
  let w0 = two_over_pi_word(q)
  let w1 = two_over_pi_word(q + 1)
  let w2 = two_over_pi_word(q + 2)
  let w3 = two_over_pi_word(q + 3)
  // (In two steps, so that r of 0 never shifts by 64.)
  let v0 = (w0 << r) | ((w1 >> 1) >> (63 - r))
  let v1 = (w1 << r) | ((w2 >> 1) >> (63 - r))
  let v2 = (w2 << r) | ((w3 >> 1) >> (63 - r))
  let (p2h, p2l) = mul_wide(m, v2)
  let (p1h, p1l) = mul_wide(m, v1)
  let r1 = p2h + p1l
  let r0 = p1h + m * v0 + (if r1 < p1l { 1 } else { 0 })
  let h = (r0 << 2) | (r1 >> 62)
  let l = (r1 << 2) | (p2l >> 62)
  // (The nearest quarter, and what is left of it, from -1/2 to 1/2, in
  // pieces of 53 bits that are floats exactly.)
  let n = (((r0 >> 62) + (h >> 63)) & 3) as i32
  let c0 = (h as i64) >> 11
  let c1 = (((h << 53) | (l >> 11)) >> 11) as i64
  let c2 = ((l << 42) >> 11) as i64
  let unit = 1.1102230246251565e-16 as f64
  let (f, fe) = two_sum64(c0 as f64 * unit, c1 as f64 * (unit * unit))
  let f_lo = fe + c2 as f64 * (unit * unit * unit)
  // (f + f_lo) * pi/2, as hi + lo.
  let (ph, pe) = two_prod64(f, 1.5707963267948966)
  let t = pe + (f * 6.123233995736766e-17 + f_lo * 1.5707963267948966)
  let hi = ph + t
  (n, hi, t - (hi - ph))
}

// A finite angle as n quarter turns and hi + lo, from about -pi/4 to
// pi/4: below 2^19 * pi/2 less n times pi/2 in three parts of 33 bits,
// each product exact and what each step leaves out kept (fdlibm's
// e_rem_pio2.c, with no step left out), else quarters64_far. Up to pi/4
// it is x as it is (-0 too).
fn quarters64(x: f64) -> (i32, f64, f64) {
  if bits_of(abs64(x)) <= 0x3fe921fb54442d18 { (0, x, 0.0 as f64) }
  else if abs64(x) > 823549.6653973004 {
    let (n, hi, lo) = quarters64_far(abs64(x))
    if x < 0.0 { ((4 - n) & 3, -hi, -lo) } else { (n, hi, lo) }
  } else {
    let k = floor64(x * 0.6366197723675814 + 0.5)
    let (r1, e1) = two_sum64(x - k * 1.5707963267341256, -(k * 6.077100506303966e-11))
    let (r2, e2) = two_sum64(r1, -(k * 2.0222662487111665e-21))
    let rest = (e1 + e2) - k * 8.4784276603689e-32
    let hi = r2 + rest
    (((k as i64) & 3) as i32, hi, rest - (hi - r2))
  }
}

// sin and cos of hi + lo, from -pi/4 to pi/4 (fdlibm's k_sin.c and
// k_cos.c).
fn sin64_near(x: f64, y: f64) -> f64 {
  let z = x * x
  let w = z * z
  let r = 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 +
          z * 2.75573137070700676789e-06) +
          z * w * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)
  let v = z * x
  x - ((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01)
}
fn cos64_near(x: f64, y: f64) -> f64 {
  let z = x * x
  let w = z * z
  let r = z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 +
          z * 2.48015872894767294178e-05)) +
          w * w * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 +
          z * -1.13596475577881948265e-11))
  let hz = 0.5 * z
  let one = 1.0 - hz
  one + (((1.0 - one) - hz) + (z * r - x * y))
}

// Of an angle in radians: not a number for an infinity.
fn sin64(x: f64) -> f64 {
  if x - x != 0.0 { nan64() }
  else {
    let (n, hi, lo) = quarters64(x)
    if n == 0 { sin64_near(hi, lo) }
    else if n == 1 { cos64_near(hi, lo) }
    else if n == 2 { -sin64_near(hi, lo) }
    else { -cos64_near(hi, lo) }
  }
}
fn cos64(x: f64) -> f64 {
  if x - x != 0.0 { nan64() }
  else {
    let (n, hi, lo) = quarters64(x)
    if n == 0 { cos64_near(hi, lo) }
    else if n == 1 { -sin64_near(hi, lo) }
    else if n == 2 { -cos64_near(hi, lo) }
    else { sin64_near(hi, lo) }
  }
}

// tan of hi + lo, from -pi/4 to pi/4, or -1 over it when `odd` (fdlibm's
// k_tan.c): above 0.6744 by tan(pi/4 - x), from one near 0.
fn tan64_near(x0: f64, y0: f64, odd: bool) -> f64 {
  let big = bits_of(abs64(x0)) >= 0x3fe5942800000000
  let neg = x0 < 0.0
  let sx = if neg { -x0 } else { x0 }
  let sy = if neg { -y0 } else { y0 }
  let x = if big { (7.85398163397448278999e-01 - sx) + (3.06161699786838301793e-17 - sy) } else { x0 }
  let y = if big { 0.0 as f64 } else { y0 }
  let z = x * x
  let w = z * z
  let r0 = 1.33333333333201242699e-01 + w * (2.18694882948595424599e-02 +
           w * (3.59207910759131235356e-03 + w * (5.88041240820264096874e-04 +
           w * (7.81794442939557092300e-05 + w * -1.85586374855275456654e-05))))
  let v0 = z * (5.39682539762260521377e-02 + w * (8.86323982359930005737e-03 +
           w * (1.45620945432529025516e-03 + w * (2.46463134818469906812e-04 +
           w * (7.14072491382608190305e-05 + w * 2.59073051863633712884e-05)))))
  let s = z * x
  let r = (y + z * (s * (r0 + v0) + y)) + 3.33333333333334091986e-01 * s
  let wx = x + r
  if big {
    let v = if odd { -1.0 as f64 } else { 1.0 }
    let t = v - 2.0 * (x - (wx * wx / (wx + v) - r))
    if neg { -t } else { t }
  }
  else if !odd { wx }
  else {
    // (-1 / (x + r) to the last bit: of its high half, and what is left.)
    let zh = float_of(bits_of(wx) & 0xffffffff00000000)
    let vl = r - (zh - x)
    let a = -1.0 / wx
    let t = float_of(bits_of(a) & 0xffffffff00000000)
    t + a * ((1.0 + t * zh) + t * vl)
  }
}
fn tan64(x: f64) -> f64 {
  if x - x != 0.0 { nan64() }
  else if bits_of(abs64(x)) < 0x3e40000000000000 { x }
  else {
    let (n, hi, lo) = quarters64(x)
    tan64_near(hi, lo, (n & 1) == 1)
  }
}

// atan(x) - x, for x from -7/16 to 7/16, by a polynomial in x * x
// (fdlibm's s_atan.c).
fn atan64_rest(x: f64) -> f64 {
  let z = x * x
  let w = z * z
  let s1 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 +
           w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02 +
           w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))))
  let s2 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 +
           w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02 +
           w * -3.65315727442169155270e-02))))
  x * (s1 + s2)
}
// atan(c) + atan(t), atan(c) given as hi + lo.
fn atan64_from(hi: f64, lo: f64, t: f64) -> f64 { hi - ((atan64_rest(t) - lo) - t) }

// The angle whose tan x is, from -pi/2 to pi/2: of x, or of x near 1/2,
// 1, 3/2 or infinity as the atan of that and of a t near 0.
fn atan64(x: f64) -> f64 {
  let ax = abs64(x)
  let b = bits_of(ax)
  if x != x { nan64() }
  else if b < 0x3e40000000000000 { x }
  else if b < 0x3fdc000000000000 { x - atan64_rest(x) }
  else {
    let z = if b >= 0x4410000000000000 { 1.57079632679489655800e+00 as f64 }
            else if b < 0x3fe6000000000000 {
              atan64_from(4.63647609000806093515e-01, 2.26987774529616870924e-17,
                          (2.0 * ax - 1.0) / (2.0 + ax))
            }
            else if b < 0x3ff3000000000000 {
              atan64_from(7.85398163397448278999e-01, 3.06161699786838301793e-17,
                          (ax - 1.0) / (ax + 1.0))
            }
            else if b < 0x4003800000000000 {
              atan64_from(9.82793723247329054082e-01, 1.39033110312309984516e-17,
                          (ax - 1.5) / (1.0 + 1.5 * ax))
            }
            else {
              atan64_from(1.57079632679489655800e+00, 6.12323399573676603587e-17, -1.0 / ax)
            }
    if x < 0.0 { -z } else { z }
  }
}

// The angle of the point (x, y), from -pi to pi, as C's atan2 says for
// the ends (fdlibm's e_atan2.c): pi less the atan where x is below 0,
// with pi's low part.
fn atan264(y: f64, x: f64) -> f64 {
  let pi = 3.1415926535897931160e+00 as f64
  let pi_lo = 1.2246467991473531772e-16 as f64
  let half = 1.5707963267948965580e+00 as f64
  let inf = infinity64()
  let ax = abs64(x)
  let ay = abs64(y)
  let xneg = (bits_of(x) >> 63) == 1
  let yneg = (bits_of(y) >> 63) == 1
  if x != x || y != y { nan64() }
  else if x == 1.0 { atan64(y) }
  else if y == 0.0 { if !xneg { y } else if yneg { -pi } else { pi } }
  else if x == 0.0 || ay == inf {
    if ax == inf {
      let z = if xneg { 3.0 * 7.8539816339744827900e-01 as f64 } else { 7.8539816339744827900e-01 }
      if yneg { -z } else { z }
    }
    else if yneg { -half } else { half }
  }
  else if ax == inf {
    let z = if xneg { pi } else { 0.0 as f64 }
    if yneg { -z } else { z }
  }
  else {
    let k = ((bits_of(ay) >> 52) as i32) - ((bits_of(ax) >> 52) as i32)
    let z = if k > 60 { half + 0.5 * pi_lo }
            else if xneg && k < -60 { 0.0 as f64 }
            else { atan64(ay / ax) }
    let w = if xneg && k <= 60 { pi - (z - pi_lo) } else { z }
    if yneg { -w } else { w }
  }
}

// Square root, powers and logarithms. `pow(x, y)` is x to the power of y,
// `exp(x)` e to the power of x, `log` the natural logarithm. (`sqrt` of
// an f32 or an f64 is built in.)
fn pow(x: f32, y: f32) -> f32 { pow64(x as f64, y as f64) as f32 }
fn exp(x: f32) -> f32 { exp64(x as f64) as f32 }
fn log(x: f32) -> f32 { log64(x as f64) as f32 }
fn log2(x: f32) -> f32 { log264(x as f64) as f32 }

// Angles. `atan2(y, x)` is the angle of the point (x, y), from -pi to pi.
fn sin(x: f32) -> f32 { sin64(x as f64) as f32 }
fn cos(x: f32) -> f32 { cos64(x as f64) as f32 }
fn tan(x: f32) -> f32 { tan64(x as f64) as f32 }
extern fn asin(x: f32) -> f32
extern fn acos(x: f32) -> f32
fn atan(x: f32) -> f32 { atan64(x as f64) as f32 }
fn atan2(y: f32, x: f32) -> f32 { atan264(y as f64, x as f64) as f32 }

fn floor(x: f32) -> f32 { floor64(x as f64) as f32 }
fn ceil(x: f32) -> f32 { ceil64(x as f64) as f32 }
fn round(x: f32) -> f32 { round64(x as f64) as f32 }
fn trunc(x: f32) -> f32 { trunc64(x as f64) as f32 }
// What is left of x after taking y away as often as it fits, with x's
// sign (`%` does the same).
fn fmod(x: f32, y: f32) -> f32 { fmod64(x as f64, y as f64) as f32 }

extern fn asin64(x: f64) -> f64
extern fn acos64(x: f64) -> f64

fn pi() -> f32 { 3.14159265358979 }
fn pi64() -> f64 { 3.14159265358979 }
// A whole turn.
fn tau() -> f32 { 6.28318530717959 }
fn tau64() -> f64 { 6.28318530717959 }
fn radians(degrees: f32) -> f32 { degrees * 0.0174532925199433 }
fn degrees(radians: f32) -> f32 { radians * 57.2957795130823 }

// -1, 0 or 1, as x is below, at or above 0.
fn sign(x: f32) -> f32 { if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 } }
fn sign64(x: f64) -> f64 { if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 } }
fn isign(x: i32) -> i32 { if x > 0 { 1 } else if x < 0 { -1 } else { 0 } }

// x, but not below `low` and not above `high`.
fn clamp(x: f32, low: f32, high: f32) -> f32 { min(max(x, low), high) }
fn clamp64(x: f64, low: f64, high: f64) -> f64 { min(max(x, low), high) }
fn iclamp(x: i32, low: i32, high: i32) -> i32 { min(max(x, low), high) }

// From a (at t = 0) to b (at t = 1), and beyond.
fn lerp(a: f32, b: f32, t: f32) -> f32 { a + (b - a) * t }
fn lerp64(a: f64, b: f64, t: f64) -> f64 { a + (b - a) * t }

// What follows the point: x less its floor, from 0 up to 1.
fn fract(x: f32) -> f32 { x - floor(x) }

// How long the arrow (x, y) is, and how far two points are apart.
fn length(x: f32, y: f32) -> f32 { sqrt(x * x + y * y) }
fn distance(ax: f32, ay: f32, bx: f32, by: f32) -> f32 {
  length(bx - ax, by - ay)
}

// x times itself `n` times; 1 if n is 0 or less.
fn ipow(x: i32, n: i32) -> i32 {
  var result = 1
  for i in 0..n { result *= x }
  result
}

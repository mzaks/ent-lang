// The city: its people in households, and whom each of them meets at
// work or at school, as OpenABM-Covid19 builds them.
//
//   import city
//   capacity Person 100000
//   capacity Household 100000
//   capacity LivesIn 100000
//   capacity WorksWith 1100000
//   schedule setup() { panel()  households()  settle()  census()  employ()  wire() }
//
// (And `capacity Order`, as many as there are people, and `capacity
// Index`, an eighth of that, for transmission.ent, which pairs those who
// meet by chance anew each day.)
//
// - Households are taken from a panel of 10,000 that were asked (the
//   reference's file, `City.panel`), four at a time, and kept where they
//   bring the city's ages and the sizes of its households nearer to the
//   country's, until there are people enough.
// - Everybody is in one of five networks by their age (two of schools,
//   one of work, two of the old), and some of the working age are in
//   those of the young and the old in place of their own: the staff.
// - A network is a ring of its members in an order drawn at random, each
//   tied to the next so many; about one tie in five then leaves one of
//   its ends for somebody anywhere on the ring (Watts and Strogatz, with
//   the turns the reference's code gives each tie: see `tie`). On a day,
//   half of the ties are met along (transmission.ent).
// - Everybody also meets a number of people by chance each day, a number
//   of their own (`Chance`): few for most, many for some.
import files
import math
import random
import parameters
import disease

// A household: its number, how many live in it, and what its ill
// members give off in a day (transmission.ent).
component Household { id: i32, members: i32, pressure: f32 }

// How much infection a person can still take before they are infected:
// drawn once, and less for those whose age takes it easily.
component Hazard { left: f32 }
// How much a person gives off, against others: drawn once.
component Spread { multiplier: f32 }
// Which network they are in, and how many they are tied to in it.
component Work { network: u8, ties: i32 }
// What they give off today along one tie.
component Infectious { rate: f32 }
// How many people they meet by chance on a day, anywhere: drawn once,
// some many and most few.
component Chance { meets: i32 }

relation (Person)-[LivesIn]->(Household) tree capacity 16
// A tie in a network. It is one edge, met along from either end; `key`
// numbers the ties, for the draw of the days it is met on.
relation (Person)-[WorksWith { key: i32 }]->(Person) capacity 16

const HOUSES = 5
const HAZARD = 6
const SPREAD = 7
const NETWORK = 8
const RING = 9
const TIES = 10
const CHANCE = 12

// The panel's file, how far the households taken from it are from the
// country's (the squares of the differences of the shares, added up:
// the ages twice), and how many households, people in each network by
// their age, and ties there are.
unique City {
  panel: text[126], fit: f64, households: i32, ties: i32,
  primary: i32, secondary: i32, working: i32, retired: i32, elderly: i32
}

// The panel: for each household nine rows, how many it has of each age.
buffer Panel { count: u8 } capacity 90000
// The households taken, each by its number in the panel.
buffer Taken { row: i32 } capacity 16
// The sums the taking goes by: the ages (0 to 8) and the sizes (9 to 14)
// of what was taken, and of what was taken with four more (15 to 29).
buffer Sums { value: f64 } capacity 30
// The members of one network, in the order of their numbers.
buffer Ring { who: entity } capacity 16

world {
  City.panel = "baseline_household_demographics.csv"
}

// The panel read from its file: a line of names, then a line for each
// household, nine numbers with commas between.
proc read_panel(bytes: Bytes, panel: mut Panel) {
  panel = []
  var at = 0
  while at < len(bytes) && bytes[at].value != 10 { at += 1 }
  var number = 0
  var digits = 0
  for i in at..len(bytes) {
    let byte = bytes[i].value as i32
    if byte >= 48 && byte <= 57 {
      number = number * 10 + byte - 48
      digits += 1
    } else if digits > 0 {
      panel += { count: number as u8 }
      number = 0
      digits = 0
    }
  }
  if digits > 0 { panel += { count: number as u8 } }
}

system panel() {
  let size = read_file(City.panel, Bytes)
  if size > 0 { read_panel(Bytes, Panel) }
  Bytes = []
}

fn members(panel: Panel, row: i32) -> i32 {
  var all = 0
  for age in 0..9 { all += panel[row * 9 + age].count as i32 }
  all
}

// How far the shares of the sums from `from` on (nine of ages, six of
// sizes) are from the country's.
fn misfit(sums: Sums, ages: Ages, sizes: Sizes, from: i32) -> f64 {
  var people = 0.0 as f64
  var houses = 0.0 as f64
  var all_ages = 0.0 as f64
  var all_sizes = 0.0 as f64
  for age in 0..9 {
    people += sums[from + age].value
    all_ages += ages[age].share as f64
  }
  for size in 0..6 {
    houses += sums[from + 9 + size].value
    all_sizes += sizes[size].share as f64
  }
  var error = 0.0 as f64
  for age in 0..9 {
    let d = sums[from + age].value / people - ages[age].share as f64 / all_ages
    error += 2.0 * d * d
  }
  for size in 0..6 {
    let d = sums[from + 9 + size].value / houses -
            sizes[size].share as f64 / all_sizes
    error += d * d
  }
  error
}

// Households for so many people, and how far they are from the
// country's in the end.
proc take(panel: Panel, taken: mut Taken, sums: mut Sums, ages: Ages,
          sizes: Sizes, seed: i64, people: i32) -> f64 {
  let count = len(panel) / 9
  let k = key(seed, 0, 0, HOUSES)
  taken = []
  sums = [{ value: 0.0 }; 30]
  var draws = 0
  var housed = 0
  // The first four as they come.
  for i in 0..4 {
    let row = below(k, draws, count)
    draws += 1
    taken += { row: row }
    for age in 0..9 { sums[age].value += panel[row * 9 + age].count as f64 }
    sums[9 + members(panel, row) - 1].value += 1.0
    housed += members(panel, row)
  }
  var last = misfit(sums, ages, sizes, 0)
  var acceptance = last * 0.00001
  while housed < people && count > 0 {
    for i in 0..15 { sums[15 + i].value = sums[i].value }
    let first = draws
    for i in 0..4 {
      let row = below(k, first + i, count)
      for age in 0..9 { sums[15 + age].value += panel[row * 9 + age].count as f64 }
      sums[24 + members(panel, row) - 1].value += 1.0
    }
    draws += 4
    let error = misfit(sums, ages, sizes, 15)
    // Kept where they are no worse than the best so far by more than is
    // let pass, which then becomes less; else more is let pass.
    if error < last + acceptance {
      for i in 0..4 {
        let row = below(k, first + i, count)
        taken += { row: row }
        housed += members(panel, row)
      }
      for i in 0..15 { sums[i].value = sums[15 + i].value }
      acceptance = acceptance * 0.99
      last = min(error, last)
    } else {
      acceptance = acceptance * 1.0001
    }
  }
  misfit(sums, ages, sizes, 0)
}

system households() {
  City.fit = take(Panel, Taken, Sums, Ages, Sizes, Run.seed, Run.people)
}

// The people of the households taken, the oldest of each first, until
// there are `Run.people`.
system settle() {
  var id = 0
  var house = 0
  for h in 0..len(Taken) {
    if id < Run.people {
      let row = Taken[h].row
      let home = spawn { Household { id: house, members: 0, pressure: 0.0 } }
      house += 1
      for back in 0..9 {
        let age = 8 - back
        for i in 0..Panel[row * 9 + age].count as i32 {
          if id < Run.people {
            let draw = uniform(key(Run.seed, id, 0, HAZARD), 0)
            let who = spawn {
              Person { id: id },
              Age { group: age as u8 },
              Disease { stage: Stage.Susceptible, since: 0,
                        next: Stage.Susceptible, at: -1, path: Path.None,
                        infected: 0 },
              Hazard { left: (-log64(draw) / Ages[age].susceptible as f64) as f32 },
              Spread { multiplier: gamma(key(Run.seed, id, 0, SPREAD), 1.0,
                                         Model.spread as f64) as f32 },
              Work { network: own_network[age] as u8, ties: 0 },
              Infectious { rate: 0.0 },
              Chance { meets: negative_binomial(key(Run.seed, id, 0, CHANCE),
                                                Ages[age].chance as f64,
                                                Ages[age].chance_deviation as f64) }
            }
            connect (who)-[LivesIn]->(home)
            id += 1
          }
        }
      }
    }
  }
  City.households = house
  for (p: Person)-[LivesIn]->(h: mut Household) bottom up LivesIn {
    h.members += 1
  }
}

fn one_if(is: bool) -> i32 { if is { 1 } else { 0 } }

// How many people are of each network's own age.
system census() {
  City.primary = 0
  City.secondary = 0
  City.working = 0
  City.retired = 0
  City.elderly = 0
  for a: Age {
    let network = own_network[a.group]
    City.primary += one_if(network == 0)
    City.secondary += one_if(network == 1)
    City.working += one_if(network == 2)
    City.retired += one_if(network == 3)
    City.elderly += one_if(network == 4)
  }
}

// The network of somebody of working age, by a number between 0 and 1:
// one of the young or the old as often as it needs staff, else work.
fn staffed(u: f64, primary: i32, secondary: i32, working: i32, retired: i32,
           elderly: i32, young: f32, old: f32) -> u8 {
  let a = primary as f64 * young as f64 / working as f64
  let b = a + secondary as f64 * young as f64 / working as f64
  let c = b + retired as f64 * old as f64 / working as f64
  let d = c + elderly as f64 * old as f64 / working as f64
  if u < a { 0 } else if u < b { 1 } else if u < c { 3 } else if u < d { 4 } else { 2 }
}

system employ() {
  for p: Person, a: Age, w: mut Work where age_kind[a.group] == 1 {
    w.network = staffed(uniform(key(Run.seed, p.id, 0, NETWORK), 0), City.primary,
                        City.secondary, City.working, City.retired, City.elderly,
                        Model.staff_young, Model.staff_old)
  }
}

// To how many after it on the ring each member of a network of so many
// is tied: half of twice what is met in a day (of which half are met),
// and no more than the ring allows.
fn reach(meets: f32, daily: f32, members: i32) -> i32 {
  let half = (meets as f64 / daily as f64 / 2.0) as i32
  if 2 * half >= members - 1 { max(0, (members - 1) / 2) } else { half }
}

// A place of a ring that is neither `from` nor within reach of it.
fn elsewhere(k: u64, n: i32, from: i32, members: i32, reach: i32) -> i32 {
  (from + reach + 1 + below(k, n, members - 2 * reach - 1)) % members
}

// The two ends of the tie from place `i` of a ring to the place `step`
// after it, as the reference comes to them. It goes through the places
// in their order, and each lets go of a tie of its own one time in ten:
// the tie then leads from it to a place anywhere else. So a tie has two
// turns, its lower place's first; and one that was moved to a place
// that is yet to come has a turn there too, and so on.
fn tie(k: u64, i: i32, step: i32, members: i32, reach: i32, rewire: f32)
    -> (i32, i32) {
  let other = (i + step) % members
  let first = min(i, other)
  let second = max(i, other)
  var kept = first
  var to = second
  if members > 2 * reach + 1 {
    var moved = false
    if uniform(k, 0) < rewire as f64 {
      to = elsewhere(k, 1, first, members, reach)
      moved = true
    } else if uniform(k, 2) < rewire as f64 {
      kept = second
      to = elsewhere(k, 1, second, members, reach)
      moved = true
    }
    var n = 3
    while moved && to > kept {
      moved = uniform(k, n) < rewire as f64
      if moved {
        kept = to
        to = elsewhere(k, n + 1, kept, members, reach)
      }
      n += 2
    }
  }
  (kept, to)
}

// The ties of the five networks.
system wire() {
  var ties = 0
  for network in 0..5 {
    Ring = []
    for e, w: Work where w.network as i32 == network { Ring += { who: e } }
    let members = len(Ring)
    let far = reach(Networks[network].meets, Model.daily, members)
    let order = key(Run.seed, network, 0, RING)
    for i in 0..members {
      for step in 1..far + 1 {
        let (from, to) = tie(key(Run.seed, ties, 0, TIES), i, step, members, far,
                             Model.rewire)
        connect (Ring[permute(order, from, members)].who)-[WorksWith { key: ties }]->
                (Ring[permute(order, to, members)].who)
        ties += 1
      }
    }
  }
  City.ties = ties
  Ring = []
  for p: Person, w: mut Work { w.ties = 0 }
  for p: Person {
    for (p)-[WorksWith]->(o: mut Work) { o.ties += 1 }
    for (o: mut Work)-[WorksWith]->(p) { o.ties += 1 }
  }
}

// The epidemic of epidemic.ent, and for each day a number made of
// everything about everybody: who they are, the stage of their illness
// with its days, what hazard they have left and what they give off.
// check/same.py holds the lines of a build for one core against those of
// a build for all of them: any person a day apart shows.
import console
import random
import parameters
import disease
import city
import transmission
import interventions

capacity Person 100000
capacity Household 100000
capacity LivesIn 100000
capacity WorksWith 1100000
capacity Taken 100000
capacity Ring 100000
capacity Order 800008
capacity Index 100000
capacity Housemate 200000
capacity ToldBy 800000

unique Sum: i64

world {
  Run.people = 100000
  Model.file = "parameters.csv"
}

// A person's state as one number. (Floats by their millionths: what
// differs in a float's last bits also shows a day or two on, as who is
// infected when. The hazard left is a whole number, as it is.)
fn state(id: i32, stage: Stage, path: Path, since: i32, at: i32, infected: i32,
         next: Stage, left: i64, rate: f32, in_hospital: bool) -> i64 {
  var h = mix(id as i64 as u64)
  h = mix(h ^ (stage as i32 as i64 as u64) ^ ((path as i32 as i64 as u64) << 8) ^
          ((next as i32 as i64 as u64) << 16))
  h = mix(h ^ (since as i64 as u64) ^ ((at as i64 as u64) << 20) ^
          ((infected as i64 as u64) << 40))
  h = mix(h ^ (left as u64))
  h = mix(h ^ ((rate as f64 * 1000000000.0) as i64 as u64))
  if in_hospital { h = mix(h + 1) }
  h as i64
}

// What is done about a person, as one number.
fn measures_of(id: i32, home: i32, since: i32, until: i32, positive: bool, take: i32,
               result: i32, found: bool) -> i64 {
  var h = mix((id as i64 as u64) ^ 0x9e3779b97f4a7c15)
  h = mix(h ^ (home as i64 as u64) ^ ((since as i64 as u64) << 20) ^
          ((until as i64 as u64) << 40))
  h = mix(h ^ (take as i64 as u64) ^ ((result as i64 as u64) << 20))
  if positive { h = mix(h + 1) }
  if found { h = mix(h + 2) }
  h as i64
}

system sum() {
  Sum = 0
  for e, p: Person, d: Disease, z: Hazard, i: Infectious, q: Quarantine, s: Source,
      t: Test {
    Sum += state(p.id, d.stage, d.path, d.since, d.at, d.infected, d.next, z.left,
                 i.rate, e.has(Hospitalised)) +
           measures_of(p.id, q.until, s.since, s.until, s.positive, t.take, t.result,
                       t.found)
  }
}

system line() {
  put("{Clock.day} {Sum} {Run.people - Tally.susceptible}")
}

schedule setup() {
  parameters()
  measures()
  panel()
  households()
  settle()
  apps()
  census()
  employ()
  wire()
  rows()
  curve()
  rate()
  share()
  seed()
  tally()
  sum()
  line()
}

schedule day() {
  tick()
  policy()
  remember()
  infectiousness()
  pair()
  household()
  workplace()
  chance()
  infect()
  progress()
  symptoms()
  tests()
  trace()
  told()
  tally()
  sum()
  line()
}

main {
  setup()
  loop { day() } until Clock.day == Run.days || Tally.infected == 0
}

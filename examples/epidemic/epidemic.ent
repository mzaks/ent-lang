// A city's epidemic, a line for each day: the day, how many were
// infected so far, and how many people are in each stage of the illness
// (the first line names them, as the reference names its own).
//
//   examples/epidemic/reference/fetch.sh        once: the reference's files
//   cd build/epidemic/run
//   ../../../tools/ent run --parallel ../../../examples/epidemic/epidemic.ent
//
// 100,000 people in households and at work or at school (city.ent), ten
// of them infected on day 0, who pass it on at home, at work and to whom
// they meet by chance (transmission.ent): 200 days, or until nobody is
// ill. The households
// are taken from the reference's panel, a file that is looked for where
// the program is started. The numbers are the reference's baseline, or
// what a file "parameters.csv" there says, as the reference reads them:
// the seed, how many people (up to 100,000), how many days, and the rest
// (parameters.ent).
import console
import parameters
import disease
import city
import transmission
import interventions

capacity Person 100000
capacity Household 100000
capacity LivesIn 100000
capacity WorksWith 2200000
capacity Taken 100000
capacity Ring 100000
capacity Order 800008
capacity Index 100000
capacity Housemate 200000
capacity ToldBy 800000

// On many ranks (`tools/ent run --ranks 4`, docs/ranks.md): people by the
// number of their household, households by theirs, so that each household
// lives with its people and goes up its tree on its own rank.
distribute Home by house
distribute Household by id

world {
  Run.people = 100000
  Model.file = "parameters.csv"
}

// The reference's names for its own columns of these, and its counts:
// everybody infected so far, those a test found, those kept at home, the
// day's results of tests, and those with symptoms mild or severe as one. (A line the console takes has 126 bytes: those
// names just fit, with those in intensive care and those getting better
// in hospital left out.)
system heading() {
  put("time,total_infected,total_case,n_presymptom,n_asymptom,n_quarantine,n_tests,n_symptoms,n_hospital,n_death,n_recovered")
}

// Without the panel of households there is nobody: said, where a run of
// nobody would follow.
system housed() {
  if len(Panel) == 0 {
    put("# no households: the file {City.panel} is not where the program was started.")
    put("# examples/epidemic/reference/fetch.sh fetches it into build/epidemic/run: start the program there.")
  }
}

system report() {
  put("{Clock.day},{Run.people - Tally.susceptible},{Kept.found},{Tally.presymptomatic},{Tally.asymptomatic},{Kept.home},{Kept.results},{Tally.mild + Tally.severe},{Tally.hospitalised},{Tally.dead},{Tally.recovered}")
}

schedule setup() {
  parameters()
  measures()
  panel()
  households()
  settle()
  housed()
  apps()
  census()
  employ()
  wire()
  rows()
  curve()
  rate()
  share()
  seed()
  tally()
  heading()
  report()
}

schedule day() {
  tick()
  policy()
  remember()
  infectiousness()
  today()
  lay()
  pair()
  household()
  workplace()
  chance()
  infect()
  moves() run_if Run.log
  progress()
  symptoms()
  tests()
  trace() run_if Measures.telling
  told() run_if Measures.telling
  tally()
  counts()
  report()
}

main {
  setup()
  loop { day() } until Clock.day == Run.days || Tally.infected == 0
}

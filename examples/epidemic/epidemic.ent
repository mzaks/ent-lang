// A city's epidemic, a line for each day: the day, who became infected
// on it, and how many people are in each stage of the illness (the
// first line names them).
//
//   examples/epidemic/reference/fetch.sh        once: the reference's files
//   cd build/epidemic/run
//   ../../../tools/ent run --parallel ../../../examples/epidemic/epidemic.ent
//
// 100,000 people in households and at work or at school (city.ent), ten
// of them infected on day 0, who pass it on at home, at work and to whom
// they meet by chance (transmission.ent): 200 days, or until nobody is
// ill. The households
// are taken from the reference's panel, a file that is looked for where
// the program is started.
import console
import disease
import city
import transmission

capacity Person 100000
capacity Household 100000
capacity LivesIn 100000
capacity WorksWith 1100000
capacity Taken 100000
capacity Ring 100000
capacity Stubs 500000
capacity Met 250000

unique Days: i32

world {
  Run.seed = 1
  Run.people = 100000
  Run.seeded = 10
  Days = 200
}

system heading() {
  put("day,new_infections,susceptible,presymptomatic,asymptomatic,mild,severe,hospitalised,critical,recovering,recovered,dead")
}

system report() {
  put("{Clock.day},{Tally.new_infections},{Tally.susceptible},{Tally.presymptomatic},{Tally.asymptomatic},{Tally.mild},{Tally.severe},{Tally.hospitalised},{Tally.critical},{Tally.recovering},{Tally.recovered},{Tally.dead}")
}

schedule setup() {
  panel()
  households()
  settle()
  census()
  employ()
  wire()
  curve()
  rate()
  share()
  seed()
  tally()
  heading()
  report()
}

schedule day() {
  tick()
  infectiousness()
  pair()
  household()
  workplace()
  chance()
  infect()
  progress()
  tally()
  report()
}

main {
  setup()
  loop { day() } until Clock.day == Days || Tally.infected == 0
}

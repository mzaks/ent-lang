// The people of a city and the illness one of them goes through, as
// OpenABM-Covid19 has it: from infection without symptoms or to mild or
// severe ones, from severe ones to hospital, from there to intensive
// care, and to recovery or death. Which way a person goes is drawn by
// their age where the ways part, and how long each step takes when it
// starts (by the numbers of parameters.ent).
//
//   import disease
//   capacity Person 100000
//   world { Run.seed = 1  Run.people = 100000  Run.seeded = 10 }
//   schedule setup() { populate()  seed() }
//   schedule day() { tick()  moves()  progress()  tally() }
//
// Nobody infects anybody yet: those `seed` infects are all there are.
import math
import random
import parameters

// Where a person is. `Recovering` is in hospital still, out of intensive
// care.
enum Stage {
  Susceptible, Presymptomatic, Asymptomatic, Mild, Severe, Hospitalised,
  Critical, Recovering, Recovered, Dead
}

// How the illness shows, drawn when it starts.
enum Path { None, Asymptomatic, Mild, Severe }

// What a draw is for (see random.ent).
const AGE = 1
const SEED = 2
const START = 3
const STEP = 4

// A person: which one (from 0 on, in the order they were made), how old,
// and where their illness is. `since` is the day the stage began, `next`
// the stage that follows and `at` the day it does (-1: none follows),
// `infected` the day they were infected; for the susceptible all of that
// is nought.
component Person { id: i32 }
component Age { group: u8 }
component Disease {
  stage: Stage, since: i32, next: Stage, at: i32, path: Path, infected: i32
}
// In hospital: from the day they are taken in to the day they leave it,
// recovered or dead.
tag Hospitalised
// Ill and among people: from the day they are infected to the day they
// recover, die or are taken to hospital. Only these pass the illness on.
// (With `apart` after it, they are stored in an archetype of their own,
// and a `for` over them goes over just these: bench/epidemic.)
tag Ill

unique Clock { day: i32 }

// The day's numbers: who became infected on it, and how many are in each
// stage; `infected` is those who are neither susceptible, recovered nor
// dead.
unique Tally {
  new_infections: i32, infected: i32, susceptible: i32, presymptomatic: i32,
  asymptomatic: i32, mild: i32, severe: i32, hospitalised: i32, critical: i32,
  recovering: i32, recovered: i32, dead: i32
}

// With `Run.log`, the steps taken on a day: who of which age left which
// stage for which, after how many days in it. `progress` empties it
// before it gives it the day's.
buffer Moves { id: i32, age: u8, from: Stage, to: Stage, days: i32 } capacity 16

// The age of a person by a number between 0 and 1.
fn age_of(ages: Ages, u: f64) -> u8 {
  var all = 0.0 as f64
  for i in 0..len(ages) { all += ages[i].share as f64 }
  var group = 0
  var below = 0.0 as f64
  for i in 0..len(ages) {
    below += ages[i].share as f64
    if u * all >= below && i < len(ages) - 1 { group = i + 1 }
  }
  group as u8
}

// How an illness shows, by the person's age and a number between 0 and 1.
fn path_of(ages: Ages, age: u8, u: f64) -> Path {
  if u < ages[age].asymptomatic as f64 { Path.Asymptomatic }
  else if u < (ages[age].asymptomatic + ages[age].mild) as f64 { Path.Mild }
  else { Path.Severe }
}

// The stage an illness starts in.
fn first_stage(path: Path) -> Stage {
  if path == Path.Asymptomatic { Stage.Asymptomatic } else { Stage.Presymptomatic }
}

// The stage after this one, by the person's age and a number between 0
// and 1 (the stage itself where none follows).
fn next_stage(ages: Ages, stage: Stage, path: Path, age: u8, u: f64) -> Stage {
  if stage == Stage.Presymptomatic {
    if path == Path.Mild { Stage.Mild } else { Stage.Severe }
  }
  else if stage == Stage.Asymptomatic || stage == Stage.Mild { Stage.Recovered }
  else if stage == Stage.Severe {
    if u < ages[age].hospital as f64 { Stage.Hospitalised } else { Stage.Recovered }
  }
  else if stage == Stage.Hospitalised {
    if u < (ages[age].critical * ages[age].icu) as f64 { Stage.Critical }
    else if u < ages[age].critical as f64 { Stage.Dead }
    else { Stage.Recovered }
  }
  else if stage == Stage.Critical {
    if u < ages[age].die as f64 { Stage.Dead } else { Stage.Recovering }
  }
  else if stage == Stage.Recovering { Stage.Recovered }
  else { stage }
}

// What the wait from one stage to the next is for.
fn between(from: Stage, to: Stage) -> Delay {
  if from == Stage.Presymptomatic { Delay.Symptoms }
  else if from == Stage.Asymptomatic { Delay.AsymptomaticRecovery }
  else if from == Stage.Mild { Delay.Recovery }
  else if from == Stage.Severe {
    if to == Stage.Hospitalised { Delay.Hospital } else { Delay.Recovery }
  }
  else if from == Stage.Hospitalised {
    if to == Stage.Recovered { Delay.HospitalRecovery } else { Delay.Critical }
  }
  else if from == Stage.Critical {
    if to == Stage.Dead { Delay.Death } else { Delay.IcuLeave }
  }
  else { Delay.HospitalRecovery }
}

// The days from one stage to the next (the occasion's number 0 is taken:
// see `next_stage`'s).
fn wait(delays: Delays, from: Stage, to: Stage, key: u64) -> i32 {
  let mean = delays[between(from, to) as i32].mean as f64
  let deviation = delays[between(from, to) as i32].deviation as f64
  if deviation > 0.0 { days(key, mean, deviation) }
  else {
    let whole = floor64(mean)
    let more = if uniform(key, 1) < mean - whole { 1 } else { 0 }
    whole as i32 + more
  }
}

// The day a stage that began on `day` ends: -1 where nothing follows it.
fn due(delays: Delays, stage: Stage, next: Stage, day: i32, key: u64) -> i32 {
  if next == stage { -1 } else { day + wait(delays, stage, next, key) }
}

// An illness that starts on `day`: how it shows, the stage it starts in,
// the one that follows and the day it does.
fn fall_ill(ages: Ages, delays: Delays, seed: i64, id: i32, age: u8, day: i32)
    -> (Path, Stage, Stage, i32) {
  let k = key(seed, id, day, START)
  let path = path_of(ages, age, uniform(k, 0))
  let stage = first_stage(path)
  let next = next_stage(ages, stage, path, age, 0.0)
  (path, stage, next, due(delays, stage, next, day, k))
}

// The people, each of an age drawn by the country's shares.
system populate() {
  for id in 0..Run.people {
    let k = key(Run.seed, id, 0, AGE)
    spawn {
      Person { id: id },
      Age { group: age_of(Ages, uniform(k, 0)) },
      Disease { stage: Stage.Susceptible, since: 0, next: Stage.Susceptible,
                at: -1, path: Path.None, infected: 0 }
    }
  }
}

// Infects `Run.seeded` people, picked at random, on the day it is: those
// who come first in an order of all of them that the seed says.
system seed() {
  let order = key(Run.seed, 0, 0, SEED)
  for e, p: Person, a: Age, d: mut Disease
      where d.stage == Stage.Susceptible &&
            permute(order, p.id, Run.people) < Run.seeded {
    e.add(Ill)
    let (path, stage, next, at) = fall_ill(Ages, Delays, Run.seed, p.id, a.group, Clock.day)
    d.path = path
    d.stage = stage
    d.since = Clock.day
    d.infected = Clock.day
    d.next = next
    d.at = at
  }
}

// A new day, with none of its moves yet (`moves` writes them).
system tick() {
  Clock.day += 1
  Moves = []
}

// The steps `progress` is about to take, written to `Moves` where the
// run asks for them (`Run.log`): apart from it, so that `progress` may
// run on the GPU, whose systems give a buffer no rows.
system moves() {
  if Run.log {
    for p: Person, a: Age, d: Disease where d.at == Clock.day {
      Moves += { id: p.id, age: a.group, from: d.stage, to: d.next,
                 days: Clock.day - d.since }
    }
  }
}

// Everybody whose stage ends today goes on to the next, and draws what
// follows that and when.
system progress() {
  for e, p: Person, a: Age, d: mut Disease where d.at == Clock.day {
    let stage = d.next
    let k = key(Run.seed, p.id, Clock.day, STEP)
    let next = next_stage(Ages, stage, d.path, a.group, uniform(k, 0))
    d.stage = stage
    d.since = Clock.day
    d.next = next
    d.at = due(Delays, stage, next, Clock.day, k)
    if stage == Stage.Hospitalised { e.add(Hospitalised) }
    if (stage == Stage.Recovered || stage == Stage.Dead) && e.has(Hospitalised) {
      e.remove(Hospitalised)
    }
    if (stage == Stage.Recovered || stage == Stage.Dead ||
        stage == Stage.Hospitalised) && e.has(Ill) {
      e.remove(Ill)
    }
  }
}

fn one(is: bool) -> i32 { if is { 1 } else { 0 } }

system tally() {
  Tally.new_infections = 0
  Tally.infected = 0
  Tally.susceptible = 0
  Tally.presymptomatic = 0
  Tally.asymptomatic = 0
  Tally.mild = 0
  Tally.severe = 0
  Tally.hospitalised = 0
  Tally.critical = 0
  Tally.recovering = 0
  Tally.recovered = 0
  Tally.dead = 0
  for d: Disease {
    let s = d.stage
    let ill = s != Stage.Susceptible && s != Stage.Recovered && s != Stage.Dead
    Tally.new_infections += one(d.path != Path.None && d.infected == Clock.day)
    Tally.infected += one(ill)
    Tally.susceptible += one(s == Stage.Susceptible)
    Tally.presymptomatic += one(s == Stage.Presymptomatic)
    Tally.asymptomatic += one(s == Stage.Asymptomatic)
    Tally.mild += one(s == Stage.Mild)
    Tally.severe += one(s == Stage.Severe)
    Tally.hospitalised += one(s == Stage.Hospitalised)
    Tally.critical += one(s == Stage.Critical)
    Tally.recovering += one(s == Stage.Recovering)
    Tally.recovered += one(s == Stage.Recovered)
    Tally.dead += one(s == Stage.Dead)
  }
}

// How the illness is passed on, as OpenABM-Covid19 does it: everybody
// has an amount of infection they can take (`Hazard`), everyone they
// meet who is ill takes some of it away, and who has none left is
// infected.
//
//   schedule setup() { .. the city ..  rows()  curve()  rate()  share() }
//   schedule day() {
//     tick()  policy()  infectiousness()  today()  lay()  pair()  household()
//     workplace()
//     chance()  infect()  moves()  progress()  tally()
//   }
//
// What an ill person gives off along one meeting depends on how many
// days ago they were infected (`Curve`), on how their illness shows, on
// themselves (`Spread`) and on where the two meet: at home it counts
// twice. Nobody in hospital meets anybody, and neither do the dead.
//
// Who meets whom by chance is new each day: everybody who is up has as
// many stubs as they meet people (`Chance`), one after another in the
// order of the people; the stubs are put in another order that the day
// says, and each two that come to lie next to each other in it are a
// meeting. Nothing of that is kept or even made: where a stub comes in
// the day's order, and which stub lies at a place of it, is worked out
// (random.ent), so whom an ill person meets is found from their stubs
// alone, and a day costs by how many are ill.
//
// In a lockdown (`Policy`, from `Model.lockdown_from` to before
// `Model.lockdown_to`) fewer ties are met along at work and at school,
// people meet fewer by chance, and a meeting at home counts for more.
import math
import random
import parameters
import disease
import city

const MEETS = 11
const PAIRS = 13
const LOCKED = 14

// How many days' stubs can be kept; `Pairing.kept` are (who met whom by
// chance is worked out again from them, for those who are told about
// somebody they met: interventions.ent says how many it needs).
const KEPT = 8

// Where each person's stubs start, in the order of the people, for each
// of the last days: the day's rows are those from `Laid[day % kept].order`
// on, as many as `Laid[day % kept].rows`, a person's row their number (the
// last person's stubs go up to the day's `stubs`). Whose a stub is, is
// found by it.
buffer Order { who: entity, first: i32 } capacity 16
// The row of a day's `Order` that has every 64th stub: where to start
// looking for the row of a stub, which is then at most 63 stubs further.
// (A day's rows start at `Laid[day % kept].index`.)
buffer Index { row: i32 } capacity 16
// Each of the last days: where its rows are, how many stubs it has and
// how many bits their order goes by.
buffer Laid { day: i32, order: i32, index: i32, rows: i32, stubs: i32, bits: i32 } capacity 8
// Today's order of the stubs: how many there are, where today's rows
// are, and the numbers the order is worked out by, each way.
unique Pairing {
  kept: i32, rows: i32, stubs: i32, bits: i32, order: i32, index: i32, a: u64, b: u64, c: u64,
  d: u64, back_a: u64, back_b: u64, back_c: u64
}

world {
  Pairing.kept = 1
}

// Whether there is a lockdown today.
unique Policy { lockdown: bool }

// For each day after the infection, the part of it all that is given
// off on that day (200 days, which come to 1).
buffer Curve { part: f32 } capacity 200

// How many a person meets on a day, by what a meeting counts (at home
// twice), on average over everybody; and what is given off along one
// meeting in all: `Model.rate` shared among them. (`homes`, `chances`: the
// meetings at home alone and those by chance, of everybody together.)
unique Rate { homes: f64, chances: f64, meetings: f32, each: f32 }

system curve() {
  Curve = []
  var below = 0.0 as f64
  for day in 0..200 {
    let now = gamma_below((day + 1) as f64, Model.peak as f64, Model.width as f64)
    Curve += { part: (now - below) as f32 }
    below = now
  }
  for day in 0..200 { Curve[day].part = (Curve[day].part as f64 / below) as f32 }
}

// A household of n has n - 1 meetings for each of its members, a tie at
// work is met along on half the days, by both its ends.
system rate() {
  Rate.homes = 0.0
  for h: Household {
    Rate.homes += (h.members * (h.members - 1)) as f64
  }
  Rate.chances = 0.0
  for c: Chance { Rate.chances += c.meets as f64 }
}
system share() {
  let work = 2.0 * City.ties as f64 * Model.daily as f64
  Rate.meetings = ((Rate.homes * Model.at_home as f64 + work * Model.at_work as f64 +
                    Rate.chances * Model.by_chance as f64) / Run.people as f64) as f32
  Rate.each = Model.rate / Rate.meetings
}

// How much of what the severely ill give off somebody in this stage
// does; nothing from a hospital, and nothing before or after the illness.
fn strength(stage: Stage, path: Path, mild: f32, asymptomatic: f32) -> f32 {
  if stage == Stage.Asymptomatic { asymptomatic }
  else if stage == Stage.Mild { mild }
  else if stage == Stage.Presymptomatic {
    if path == Path.Mild { mild } else { 1.0 }
  }
  else if stage == Stage.Severe { 1.0 }
  else { 0.0 }
}

fn part(curve: Curve, days: i32) -> f32 { curve[days - 1].part }

system policy() {
  Policy.lockdown = Clock.day >= Model.lockdown_from && Clock.day < Model.lockdown_to
}

system infectiousness() {
  for d: Disease, s: Spread, i: mut Infectious {
    i.rate = strength(d.stage, d.path, Model.mild, Model.asymptomatic) *
             part(Curve, Clock.day - d.infected) * s.multiplier * Rate.each
  }
}

// At home everybody meets everybody: what the ill of a household give
// off is added up, and each of the others loses that. (Whoever is ill
// already has no use for their hazard, so their own share does not
// matter.)
system household() {
  for h: mut Household { h.pressure = 0 }
  for (i: Infectious)-[LivesIn]->(h: mut Household) bottom up LivesIn {
    h.pressure += hazard(i.rate as f64)
  }
  let counts = Model.at_home * if Policy.lockdown { Model.lockdown_home } else { 1.0 }
  for (z: mut Hazard, d: Disease)-[LivesIn]->(h: Household)
      where d.stage == Stage.Susceptible && h.pressure > 0 {
    z.left -= (h.pressure as f64 * counts as f64) as i64
  }
}

// Whether the tie with this number is met along today (`today`: the
// day's own number, `key` of the seed and the day).
fn met(today: u64, tie: i32, daily: f32) -> bool {
  uniform(today, tie) < daily as f64
}

// The part of a network's ties that is met along today.
fn open(networks: Networks, network: u8, daily: f32, lockdown: bool) -> f32 {
  if lockdown { daily * networks[network].lockdown } else { daily }
}

// At work and at school: along each tie that is met today. (A tie is an
// edge from each of its ends, and both ends are of one network.) Nobody
// who is kept at home goes there.
system workplace() {
  let today = key(Run.seed, 0, Clock.day, MEETS)
  for p: Person, i: Infectious, n: Work, q: Quarantine with Ill
      where i.rate > 0.0 && q.until < Clock.day {
    let daily = open(Networks, n.network, Model.daily, Policy.lockdown)
    // (Whether they met first, from the tie alone: the other end is
    // looked at only for the ties met, half of them, and it is far.)
    for (p)-[w: WorksWith]->(o) {
      if met(today, w.key, daily) {
        if let until = Quarantine(o).until {
          if until < Clock.day { Hazard(o).left -= hazard((i.rate * Model.at_work) as f64) }
        }
      }
    }
  }
}

// How many a person meets by chance on a day of a lockdown that leaves
// such a part of the meetings: the whole number below that part of
// their own number or the one above, the same for all of the lockdown
// (which `since` says).
fn locked(meets: i32, left: f32, seed: i64, id: i32, since: i32) -> i32 {
  let part = meets as f64 * left as f64
  // (`floor64` of what is not below nought, here also on the GPU.)
  let whole = (part as i64) as f64
  whole as i32 + if uniform(key(seed, id, since, LOCKED), 0) < part - whole { 1 } else { 0 }
}

// The rows for the days' stubs, once: for each day kept, a row for each
// person and one more, and a row for every 64th stub.
system rows() {
  Order = []
  Index = []
  Laid = []
  let kept = min(KEPT, max(1, Pairing.kept))
  Pairing.kept = kept
  for slot in 0..kept {
    Laid += { day: -1, order: slot * Run.people, index: slot * (Run.people / 8),
              rows: 0, stubs: 0, bits: 0 }
  }
  for i in 0..kept * Run.people { Order += { who: none, first: 0 } }
  for i in 0..kept * (Run.people / 8) { Index += { row: 0 } }
}

// Where today's rows are (`Pairing.order`, `Pairing.index`), before the
// people lay their stubs there; and none laid yet (`Laying`).
unique Laying { rows: i32, stubs: i32, slots: i32 }

system today() {
  let slot = Clock.day % Pairing.kept
  Pairing.order = Laid[slot].order
  Pairing.index = Laid[slot].index
  Laying.rows = 0
  Laying.stubs = 0
  Laying.slots = 0
}

// Where everybody's stubs start, in the order of the people, and how
// many stubs there are: those of everybody who is up and not kept at
// home. Where one's stubs start is how many those before have (a
// running sum, `Laying.stubs`), and their row their place among the
// people (`Laying.rows`), which is their number. Of their stubs, those
// at a multiple of 64 give `Index` their row: how many those are before
// theirs is a running sum too (`Laying.slots`), so each person writes
// rows of its own.
system lay() {
  for e, c: mut Chance, d: Disease, p: Person, h: Quarantine {
    var meets = 0
    if d.stage != Stage.Dead && d.stage != Stage.Hospitalised &&
       d.stage != Stage.Critical && d.stage != Stage.Recovering &&
       h.until < Clock.day {
      meets = if Policy.lockdown {
                locked(c.meets, Model.lockdown_chance, Run.seed, p.id, Model.lockdown_from)
              } else { c.meets }
    }
    let row = Laying.rows += 1
    let first = Laying.stubs += meets
    Order[Pairing.order + row].who = e
    Order[Pairing.order + row].first = first
    c.first = first
    c.today = meets
    let many = (first + meets + 63) / 64 - (first + 63) / 64
    let slot = Laying.slots += many
    for k in 0..many { Index[Pairing.index + slot + k].row = row }
  }
}

// Today's stubs, and the order that pairs them. (The row after the last
// person starts where the stubs end.)
system pair() {
  let slot = Clock.day % Pairing.kept
  let stubs = Laying.stubs
  let order = key(Run.seed, 0, Clock.day, PAIRS)
  Laid[slot].day = Clock.day
  Laid[slot].rows = Laying.rows
  Laid[slot].stubs = stubs
  Laid[slot].bits = bits_for(stubs)
  Pairing.rows = Laying.rows
  Pairing.stubs = stubs
  Pairing.bits = bits_for(stubs)
  Pairing.a = odd(order)
  Pairing.b = odd(order + 1)
  Pairing.c = odd(order + 2)
  Pairing.d = mix(order + 3)
  Pairing.back_a = inverse(odd(order))
  Pairing.back_b = inverse(odd(order + 1))
  Pairing.back_c = inverse(odd(order + 2))
}

// The row of a day's `order` whose stubs the stub `at` is one of: the
// last that starts at it or before, looked for from the row of the 64th
// stub at or before it. (So a stub's row costs one read of the index,
// which is small, and one of a few rows next to each other: with ten
// million people most of the time goes to reading what is far apart.
// The last of the `rows` has the stubs up to the end.)
fn owner(order: Order, index: Index, order_at: i32, index_at: i32, rows: i32,
         at: i32) -> i32 {
  var row = index[index_at + at / 64].row
  while row + 1 < rows && order[order_at + row + 1].first <= at { row += 1 }
  row
}

// Whom the stub `stub` of a day's meets, by the numbers of that day's
// order: none if it comes to lie alone.
fn met_by(order: Order, index: Index, order_at: i32, index_at: i32, stub: i32,
          rows: i32, stubs: i32, bits: i32, a: u64, b: u64, c: u64, d: u64,
          back_a: u64, back_b: u64, back_c: u64) -> entity {
  let other = found(stub, stubs, bits, back_a, back_b, back_c, d) ^ 1
  if other < stubs {
    order[order_at + owner(order, index, order_at, index_at, rows,
                           place(other, stubs, bits, a, b, c, d))].who
  } else { none }
}

// By chance: for each stub of everybody who gives something off, the
// stub next to it in today's order (the one before it if it comes at an
// odd place of the order, else the one after), and whose that is. (Two
// stubs of one person are no meeting, and the last of an odd number of
// stubs has none.) What is sent from the loop over one's stubs lands
// when everybody has sent, in the order of the people and of their
// stubs, on however many threads.
system chance() {
  for me, i: Infectious, c: Chance with Ill where i.rate > 0.0 {
    for stub in c.first..c.first + c.today {
      let who = met_by(Order, Index, Pairing.order, Pairing.index, stub, Pairing.rows,
                       Pairing.stubs, Pairing.bits, Pairing.a, Pairing.b, Pairing.c,
                       Pairing.d, Pairing.back_a, Pairing.back_b, Pairing.back_c)
      if who != none && who != me {
        Hazard(who).left -= hazard((i.rate * Model.by_chance) as f64)
      }
    }
  }
}

// Whoever has no hazard left falls ill today.
system infect() {
  for e, p: Person, a: Age, z: Hazard, d: mut Disease
      where d.stage == Stage.Susceptible && z.left < 0 {
    e.add(Ill)
    let (path, stage, next, at) = fall_ill(Ages, Delays, Run.seed, p.id, a.group, Clock.day)
    d.path = path
    d.stage = stage
    d.since = Clock.day
    d.infected = Clock.day
    d.next = next
    d.at = at
  }
}

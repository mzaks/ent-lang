// How the illness is passed on, as OpenABM-Covid19 does it: everybody
// has an amount of infection they can take (`Hazard`), everyone they
// meet who is ill takes some of it away, and who has none left is
// infected.
//
//   schedule setup() { .. the city ..  curve()  rate()  share() }
//   schedule day() {
//     tick()  policy()  infectiousness()  pair()  household()  workplace()
//     chance()  infect()  progress()  tally()
//   }
//
// What an ill person gives off along one meeting depends on how many
// days ago they were infected (`Curve`), on how their illness shows, on
// themselves (`Spread`) and on where the two meet: at home it counts
// twice. Nobody in hospital meets anybody, and neither do the dead.
//
// Who meets whom by chance is new each day: everybody who is up has as
// many stubs as they meet people (`Chance`), the stubs are put in an
// order that the day says, and each two that come to lie next to each
// other are a meeting, an edge of `Met` for that day.
//
// In a lockdown (`Policy`, from `Model.lockdown_from` to before
// `Model.lockdown_to`) fewer ties are met along at work and at school,
// people meet fewer by chance, and a meeting at home counts for more.
import math
import random
import parameters
import disease
import city

const MEETS = 11
const PAIRS = 13
const LOCKED = 14

// A meeting by chance, today's.
relation (Person)-[Met]->(Person) capacity 16
// A row for each person each time they meet somebody by chance today.
buffer Stubs { who: entity } capacity 16

// Whether there is a lockdown today.
unique Policy { lockdown: bool }

// For each day after the infection, the part of it all that is given
// off on that day (200 days, which come to 1).
buffer Curve { part: f32 } capacity 200

// How many a person meets on a day, by what a meeting counts (at home
// twice), on average over everybody; and what is given off along one
// meeting in all: `Model.rate` shared among them. (`homes`, `chances`: the
// meetings at home alone and those by chance, of everybody together.)
unique Rate { homes: f64, chances: f64, meetings: f32, each: f32 }

system curve() {
  Curve = []
  var below = 0.0 as f64
  for day in 0..200 {
    let now = gamma_below((day + 1) as f64, Model.peak as f64, Model.width as f64)
    Curve += { part: (now - below) as f32 }
    below = now
  }
  for day in 0..200 { Curve[day].part = (Curve[day].part as f64 / below) as f32 }
}

// A household of n has n - 1 meetings for each of its members, a tie at
// work is met along on half the days, by both its ends.
system rate() {
  Rate.homes = 0.0
  for h: Household {
    Rate.homes += (h.members * (h.members - 1)) as f64
  }
  Rate.chances = 0.0
  for c: Chance { Rate.chances += c.meets as f64 }
}
system share() {
  let work = 2.0 * City.ties as f64 * Model.daily as f64
  Rate.meetings = ((Rate.homes * Model.at_home as f64 + work * Model.at_work as f64 +
                    Rate.chances * Model.by_chance as f64) / Run.people as f64) as f32
  Rate.each = Model.rate / Rate.meetings
}

// How much of what the severely ill give off somebody in this stage
// does; nothing from a hospital, and nothing before or after the illness.
fn strength(stage: Stage, path: Path, mild: f32, asymptomatic: f32) -> f32 {
  if stage == Stage.Asymptomatic { asymptomatic }
  else if stage == Stage.Mild { mild }
  else if stage == Stage.Presymptomatic {
    if path == Path.Mild { mild } else { 1.0 }
  }
  else if stage == Stage.Severe { 1.0 }
  else { 0.0 }
}

fn part(curve: Curve, days: i32) -> f32 { curve[days - 1].part }

system policy() {
  Policy.lockdown = Clock.day >= Model.lockdown_from && Clock.day < Model.lockdown_to
}

system infectiousness() {
  for d: Disease, s: Spread, i: mut Infectious {
    i.rate = strength(d.stage, d.path, Model.mild, Model.asymptomatic) *
             part(Curve, Clock.day - d.infected) * s.multiplier * Rate.each
  }
}

// At home everybody meets everybody: what the ill of a household give
// off is added up, and each of the others loses that. (Whoever is ill
// already has no use for their hazard, so their own share does not
// matter.)
system household() {
  for h: mut Household { h.pressure = 0.0 }
  for (i: Infectious)-[LivesIn]->(h: mut Household) bottom up LivesIn {
    h.pressure += i.rate
  }
  let counts = Model.at_home * if Policy.lockdown { Model.lockdown_home } else { 1.0 }
  for (z: mut Hazard, d: Disease)-[LivesIn]->(h: Household)
      where d.stage == Stage.Susceptible && h.pressure > 0.0 {
    z.left -= h.pressure * counts
  }
}

// Whether the tie with this number is met along today.
fn met(seed: i64, tie: i32, day: i32, daily: f32) -> bool {
  uniform(key(seed, tie, day, MEETS), 0) < daily as f64
}

// The part of a network's ties that is met along today.
fn open(networks: Networks, network: u8, daily: f32, lockdown: bool) -> f32 {
  if lockdown { daily * networks[network].lockdown } else { daily }
}

// At work and at school: along each tie that is met today, from either
// end. (Both ends of a tie are of one network.)
system workplace() {
  for p: Person, i: Infectious, n: Work where i.rate > 0.0 {
    let daily = open(Networks, n.network, Model.daily, Policy.lockdown)
    for (p)-[w: WorksWith]->(o: mut Hazard) {
      if met(Run.seed, w.key, Clock.day, daily) { o.left -= i.rate * Model.at_work }
    }
    for (o: mut Hazard)-[w: WorksWith]->(p) {
      if met(Run.seed, w.key, Clock.day, daily) { o.left -= i.rate * Model.at_work }
    }
  }
}

// How many a person meets by chance on a day of a lockdown that leaves
// such a part of the meetings: the whole number below that part of
// their own number or the one above, the same for all of the lockdown
// (which `since` says).
fn locked(meets: i32, left: f32, seed: i64, id: i32, since: i32) -> i32 {
  let part = meets as f64 * left as f64
  let whole = floor64(part)
  whole as i32 + if uniform(key(seed, id, since, LOCKED), 0) < part - whole { 1 } else { 0 }
}

// The stubs of everybody who is up, one after another in the order of
// the people.
proc lay(chances: Chance, diseases: Disease, people: Person, stubs: mut Stubs,
         lockdown: bool, left: f32, seed: i64, since: i32) {
  stubs = []
  for e, c in chances {
    let stage = diseases[e].stage
    if stage != Stage.Dead && stage != Stage.Hospitalised &&
       stage != Stage.Critical && stage != Stage.Recovering {
      let meets = if lockdown { locked(c.meets, left, seed, people[e].id, since) }
                  else { c.meets }
      for i in 0..meets { stubs += { who: e } }
    }
  }
}

// Yesterday's meetings by chance are over, and today's are drawn: the
// stubs in an order of the day's, two and two. (Two stubs of one person
// are no meeting.)
system pair() {
  for p: Person {
    for (p)-[mut m: Met]->() { m.disconnect() }
  }
  lay(Chance, Disease, Person, Stubs, Policy.lockdown, Model.lockdown_chance,
      Run.seed, Model.lockdown_from)
  let stubs = len(Stubs)
  let bits = bits_for(stubs)
  let order = key(Run.seed, 0, Clock.day, PAIRS)
  for i in 0..stubs / 2 {
    let one = Stubs[permute_in(order, 2 * i, stubs, bits)].who
    let other = Stubs[permute_in(order, 2 * i + 1, stubs, bits)].who
    if one != other { connect (one)-[Met]->(other) }
  }
}

// By chance: along each of today's meetings, from either end.
system chance() {
  for p: Person, i: Infectious where i.rate > 0.0 {
    for (p)-[Met]->(o: mut Hazard) { o.left -= i.rate * Model.by_chance }
    for (o: mut Hazard)-[Met]->(p) { o.left -= i.rate * Model.by_chance }
  }
}

// Whoever has no hazard left falls ill today.
system infect() {
  for p: Person, a: Age, z: Hazard, d: mut Disease
      where d.stage == Stage.Susceptible && z.left < 0.0 {
    let (path, stage, next, at) = fall_ill(Ages, Delays, Run.seed, p.id, a.group, Clock.day)
    d.path = path
    d.stage = stage
    d.since = Clock.day
    d.infected = Clock.day
    d.next = next
    d.at = at
  }
}

// Towers: a tower defence game. Foes walk a road across the board; you
// build towers beside it that shoot them, with the gold their falls pay.
// Ten waves, twenty lives.
//
//   tools/ent run -I examples examples/towers.ent
//
// Click a tower in the bar below, then a field beside the road. Space
// calls the next wave early, F fills the screen, enter starts over (and,
// after a map is held, the next of the two maps).
//
// - An arrow tower hits the foe in its reach that is furthest along.
// - A cannon lobs a shell at it, which hurts every foe near where it lands.
// - A frost tower shoots nothing: foes in its reach walk at half their pace.
//
// What it is made of: the bars are boxes of the layout library, the board
// is drawn into the box between them (after the boxes, before what floats
// over them); each map's road is a table of points, and the road of the
// map that is played a table that a fn gives; the towers and the foes are
// tables with a row for each kind; foes, towers and shells are entities. A tower looks at the foes with a `for` inside its own `for`,
// and what it does to the one it picks it sends to it; a shell that
// lands sends to every foe near it from inside such a `for`; a foe looks
// at the frost towers the same way.
import window
import sound
import math
import layout
import layout_window
import text

enum State { Playing, Won, Lost }
enum Kind { Arrow, Cannon, Frost }
enum Breed { Grunt, Runner, Brute }
enum Tally { Gold, Lives, Wave }

// A foe: where it is on the board (in fields, from the top left one's
// corner), which stretch of the road it is on and how far along the road
// that makes it, what it has left, and how long it is still cold.
component Foe { breed: Breed, reward: i32 }
component At { x: f32, y: f32 }
component Walk { leg: i32, far: f32 }
component Health { hp: f32, full: f32 }
component Chill { left: f32 }

// A tower on its field; what it aims at, and for how long its shot shows.
component Tower { kind: Kind, cool: f32 }
component Site { col: i32, row: i32 }
component Aim { found: bool, tx: f32, ty: f32, flash: f32 }

// A cannon's shell on its way, and the blast that shows where it landed.
component Shell { x: f32, y: f32, tx: f32, ty: f32, harm: f32 }
component Blast { x: f32, y: f32, r: f32, left: f32 }

// The boxes of the bars.
tag Root
tag BoardBox
// A label of the bar above: which of the things you have it counts.
component Counter { what: Tally }
component Button { does: i32 }

unique Game {
  state: State, map: i32, wave: i32, left: i32, gap: f32, rest: f32,
  chosen: Kind, alive: i32
}
unique Gold: i32
unique Lives: i32
// The box the board is drawn into, and the board in it: its corner and
// how big a field is.
unique Area { x: f32, y: f32, w: f32, h: f32 }
unique Grid { x: f32, y: f32, cell: f32 }
// The field under the pointer, if it is on the board.
unique Hover { col: i32, row: i32, on: bool }
// What the labels say now; what a button was asked to do this frame; the
// keys as they were.
unique Said { gold: i32, lives: i32, wave: i32, map: i32 }
unique Did: i32
unique Was { go: bool, f: bool, again: bool }
default_capacity 512

fn cols() -> i32 { 20 }
fn rows() -> i32 { 12 }
fn waves() -> i32 { 10 }

// The roads, one for each map: from point to point, each in the middle
// of a field (the first and the last are off the board). A map's road is
// a table, and `road` gives the one of a map: a table as a value.
table west_road { x: f32, y: f32 } = [
  { x: -1.0, y: 2.0 }, { x: 4.0, y: 2.0 }, { x: 4.0, y: 8.0 },
  { x: 9.0, y: 8.0 }, { x: 9.0, y: 3.0 }, { x: 15.0, y: 3.0 },
  { x: 15.0, y: 9.0 }, { x: 20.0, y: 9.0 }
]
table north_road { x: f32, y: f32 } = [
  { x: 10.0, y: -1.0 }, { x: 10.0, y: 2.0 }, { x: 3.0, y: 2.0 },
  { x: 3.0, y: 6.0 }, { x: 13.0, y: 6.0 }, { x: 13.0, y: 10.0 },
  { x: 6.0, y: 10.0 }, { x: 6.0, y: 12.0 }
]
fn maps() -> i32 { 2 }
fn road(map: i32) -> rows { x: f32, y: f32 } {
  if map == 0 { west_road } else { north_road }
}
fn on_road(way: rows { x: f32, y: f32 }, col: i32, row: i32) -> bool {
  var on = false
  let last = len(way) - 1
  for i in 0..last {
    if col as f32 >= min(way[i].x, way[i + 1].x) &&
       col as f32 <= max(way[i].x, way[i + 1].x) &&
       row as f32 >= min(way[i].y, way[i + 1].y) &&
       row as f32 <= max(way[i].y, way[i + 1].y) {
      on = true
    }
  }
  on
}
fn apart(ax: f32, ay: f32, bx: f32, by: f32) -> f32 {
  (ax - bx) * (ax - bx) + (ay - by) * (ay - by)
}

// The towers, by their kind: what one costs, how far it reaches (in
// fields), how long it rests between shots, and how much a shot hurts.
table towers[Kind] {
  name: text[14], cost: i32, reach: f32, pause: f32, harm: f32, tint: i32
} = [
  Arrow:  { name: "arrow", cost: 40, reach: 3.2, pause: 0.45, harm: 9.0,
            tint: 0xd9a441 },
  Cannon: { name: "cannon", cost: 70, reach: 2.6, pause: 1.4, harm: 16.0,
            tint: 0xc8553d },
  Frost:  { name: "frost", cost: 60, reach: 2.2, pause: 0.0, harm: 0.0,
            tint: 0x5fb4e8 }
]
fn cost(kind: Kind) -> i32 { towers[kind].cost }
fn reach(kind: Kind) -> f32 { towers[kind].reach }

// The foes, by their breed: what one has at first (more with every
// wave), how many fields it walks in a second, what its fall pays, and
// how it looks.
table breeds[Breed] {
  life: f32, pace: f32, bounty: i32, hue: i32, girth: f32
} = [
  Grunt:  { life: 26.0, pace: 1.5, bounty: 5, hue: 0x8fbf5a, girth: 0.28 },
  Runner: { life: 15.0, pace: 2.6, bounty: 4, hue: 0xe6d15a, girth: 0.22 },
  Brute:  { life: 90.0, pace: 0.9, bounty: 12, hue: 0xa66bd6, girth: 0.38 }
]
// Which comes when in a wave, and how many there are in it.
fn breed_of(wave: i32, i: i32) -> Breed {
  if wave >= 4 && i % 5 == 4 { Breed.Brute }
  else if wave >= 2 && i % 3 == 1 { Breed.Runner }
  else { Breed.Grunt }
}
fn crowd(wave: i32) -> i32 { 8 + 2 * wave }
fn life(breed: Breed, wave: i32) -> f32 {
  breeds[breed].life * (1.0 + 0.42 * (wave - 1) as f32)
}

// The labels of the bar above, by what each counts: its colour.
table tallies[Tally]: i32 = [ Gold: 0xf0c85a, Lives: 0xf07a6a, Wave: 0xb8c4d2 ]

// A button of the bar below: what it says, in a colour, and what it does.
prefab button(says: text, colour: i32, does: i32) {
  caption(says, 18.0, colour),
  Pad { left: 16.0, right: 16.0, top: 9.0, bottom: 9.0 },
  Fill { colour: 0x2a3442 },
  Round { top_left: 6.0, top_right: 6.0, bottom_left: 6.0, bottom_right: 6.0 },
  Border { left: 2.0, right: 2.0, top: 2.0, bottom: 2.0, between: 0.0,
           colour: 0x2a3442 },
  Button { does: does }
}

world {
  Window.width = 1100
  Window.height = 760
  Window.min_width = 640
  Window.min_height = 480
  Window.title = "ent-lang: towers"
  Window.background = 0x12161c
  Window.fps = 60
  Window.resizable = true
  Gold = 120
  Lives = 20
  Game.state = State.Playing
  Game.rest = 4.0
  Said.gold = -1
  Said.lives = -1
  Said.wave = -1
  Hover.col = -1

  // The window: a bar of what you have, the board, a bar of what you can
  // build.
  let root = spawn {
    Box { x: 0.0, y: 0.0, w: 1100.0, h: 760.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: false, pad: 12.0, gap: 10.0 }, Fill { colour: 0x12161c },
    Root
  }
  let top = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 44.0 },
    Size { w: Sizing.Grow, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 28.0 },
    Pad { left: 16.0, right: 16.0, top: 0.0, bottom: 0.0 },
    Align { x: Place.Start, y: Place.Middle }, Fill { colour: 0x1d242e },
    Round { top_left: 8.0, top_right: 8.0, bottom_left: 8.0,
            bottom_right: 8.0 }
  }
  connect (top)-[Inside]->(root)
  for what in Tally {
    let label = spawn { caption("", 22.0, tallies[what]), Counter { what: what } }
    connect (label)-[Inside]->(top)
  }
  let board = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Grow, h: Sizing.Grow },
    Stack { row: true, pad: 0.0, gap: 0.0 }, BoardBox
  }
  connect (board)-[Inside]->(root)
  let bar = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 60.0 },
    Size { w: Sizing.Grow, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 12.0 },
    Pad { left: 12.0, right: 12.0, top: 0.0, bottom: 0.0 },
    Align { x: Place.Start, y: Place.Middle }, Fill { colour: 0x1d242e },
    Round { top_left: 8.0, top_right: 8.0, bottom_left: 8.0,
            bottom_right: 8.0 }
  }
  connect (bar)-[Inside]->(root)
  // A button for each tower, room, and one for the next wave.
  for kind in Kind {
    let one = spawn { button("{towers[kind].name}  {towers[kind].cost}",
                             towers[kind].tint, kind as i32) }
    connect (one)-[Inside]->(bar)
  }
  let room = spawn { spacer() }
  connect (room)-[Inside]->(bar)
  let next = spawn { button("next wave  (space)", 0xd8e0ea, 4) }
  connect (next)-[Inside]->(bar)
}

// The boxes as the game is: as big as the window, the labels saying what
// there is, the chosen tower's button framed.
system bars() {
  for b: mut Box with Root
      where b.w != Window.width as f32 || b.h != Window.height as f32 {
    b.w = Window.width as f32
    b.h = Window.height as f32
  }
  if Said.gold != Gold {
    for t: mut Text, c: Counter where c.what == Tally.Gold {
      t.text = "gold {Gold}"
    }
    Said.gold = Gold
  }
  if Said.lives != Lives {
    for t: mut Text, c: Counter where c.what == Tally.Lives {
      t.text = "lives {max(Lives, 0)}"
    }
    Said.lives = Lives
  }
  if Said.wave != Game.wave || Said.map != Game.map {
    for t: mut Text, c: Counter where c.what == Tally.Wave {
      t.text = "map {Game.map + 1}, wave {Game.wave} of {waves()}"
    }
    Said.wave = Game.wave
    Said.map = Game.map
  }
  for e, k: Button, f: mut Fill, d: mut Border {
    let fill = if e.has(Hovered) { 0x364354 } else { 0x2a3442 }
    let frame = if k.does < 3 && k.does == Game.chosen as i32 { 0xe8eef6 }
                else { fill }
    if f.colour != fill { f.colour = fill }
    if d.colour != frame { d.colour = frame }
  }
  // Where the board is: fields as big as fit, in the middle of its box.
  for b: Box with BoardBox {
    Area.x = b.x
    Area.y = b.y
    Area.w = b.w
    Area.h = b.h
  }
  // (With room around them for the board's frame.)
  let cell = max(4.0, floor(min((Area.w - 12.0) / cols() as f32,
                                (Area.h - 12.0) / rows() as f32)))
  Grid.cell = cell
  Grid.x = floor(Area.x + (Area.w - cell * cols() as f32) * 0.5)
  Grid.y = floor(Area.y + (Area.h - cell * rows() as f32) * 0.5)
}

system input() {
  let f = key_down('F' as i32)
  if f && !Was.f { Window.fullscreen = !Window.fullscreen }
  Was.f = f

  // The buttons: a tower to build, or the next wave now.
  Did = -1
  for k: Button with Hovered where PointerTouch == Touch.PressedNow {
    Did max= k.does
  }
  if Did >= 0 && Did < 3 { Game.chosen = Did as Kind }
  let go = Keys.space
  if (Did == 4 || (go && !Was.go)) && Game.state == State.Playing &&
     Game.left == 0 && Game.alive == 0 {
    Game.rest = 0.0
  }
  Was.go = go

  // The field under the pointer; a click on a free one beside the road
  // builds the chosen tower there, if there is gold for it.
  let col = floor((Pointer.x - Grid.x) / Grid.cell) as i32
  let row = floor((Pointer.y - Grid.y) / Grid.cell) as i32
  let over = for with BoardBox, Hovered { }
  Hover.on = over > 0 && col >= 0 && col < cols() && row >= 0 && row < rows()
  Hover.col = col
  Hover.row = row
  if Hover.on && PointerTouch == Touch.PressedNow &&
     Game.state == State.Playing && !on_road(road(Game.map), col, row) &&
     Gold >= cost(Game.chosen) {
    let taken = for s: Site where s.col == col && s.row == row { }
    if taken == 0 {
      spawn {
        Tower { kind: Game.chosen, cool: 0.0 }, Site { col: col, row: row },
        Aim { found: false, tx: 0.0, ty: 0.0, flash: 0.0 }
      }
      Gold = Gold - cost(Game.chosen)
      spawn { Tone { pitch: 330.0, to: 495.0, seconds: 0.08, after: 0.0,
                     volume: 0.25, wave: Wave.Triangle } }
    }
  }

  // Enter: from the start; on the next map after one that was held, and
  // on the first again after the last.
  let again = Keys.enter
  if again && !Was.again {
    if Game.state == State.Won { Game.map = (Game.map + 1) % maps() }
    for e with Foe { e.destroy() }
    for e with Tower { e.destroy() }
    for e with Shell { e.destroy() }
    for e with Blast { e.destroy() }
    Gold = 120
    Lives = 20
    Game.state = State.Playing
    Game.wave = 0
    Game.left = 0
    Game.rest = 4.0
    Game.alive = 0
  }
  Was.again = again
}

// The waves: one foe after another onto the road; when a wave is gone,
// the next one after a rest, and after the last one the game is won.
system marshal() {
  let dt = min(Window.dt, 0.05)
  let alive = for with Foe { }
  Game.alive = alive
  if Lives <= 0 {
    Game.state = State.Lost
  } else if Game.left > 0 {
    Game.gap -= dt
    if Game.gap <= 0.0 {
      let breed = breed_of(Game.wave, crowd(Game.wave) - Game.left)
      let hp = life(breed, Game.wave)
      spawn {
        Foe { breed: breed, reward: breeds[breed].bounty },
        At { x: road(Game.map)[0].x, y: road(Game.map)[0].y },
        Walk { leg: 0, far: 0.0 },
        Health { hp: hp, full: hp }, Chill { left: 0.0 }
      }
      Game.left -= 1
      Game.gap = max(0.35, 0.8 - 0.04 * Game.wave as f32)
    }
  } else if alive == 0 {
    if Game.wave >= waves() {
      Game.state = State.Won
    } else {
      Game.rest -= dt
      if Game.rest <= 0.0 {
        Game.wave += 1
        Game.left = crowd(Game.wave)
        Game.gap = 0.0
        Game.rest = 5.0
        spawn { Tone { pitch: 220.0, to: 440.0, seconds: 0.25, after: 0.0,
                       volume: 0.3, wave: Wave.Square } }
      }
    }
  }
}

// A foe walks to the next point of the road, at half its pace while it
// is cold; one that gets to the end costs a life.
system walk() {
  let dt = min(Window.dt, 0.05)
  let way = road(Game.map)
  for e, f: Foe, a: mut At, w: mut Walk, c: Chill {
    var step = breeds[f.breed].pace * dt
    if c.left > 0.0 { step = step * 0.5 }
    let tx = way[w.leg + 1].x
    let ty = way[w.leg + 1].y
    let away = sqrt(apart(a.x, a.y, tx, ty))
    if away <= step {
      a.x = tx
      a.y = ty
      w.leg += 1
      w.far = w.leg as f32 * 100.0
      if w.leg >= len(way) - 1 {
        Lives -= 1
        e.destroy()
      }
    } else {
      a.x += (tx - a.x) / away * step
      a.y += (ty - a.y) / away * step
      w.far = w.leg as f32 * 100.0 + 50.0 - away
    }
  }
}

// A foe in a frost tower's reach is cold for a while.
system frost() {
  let dt = min(Window.dt, 0.05)
  for a: At, c: mut Chill {
    var cold = false
    for t: Tower, s: Site
        where t.kind == Kind.Frost &&
              apart(a.x, a.y, s.col as f32, s.row as f32) <=
                  reach(Kind.Frost) * reach(Kind.Frost) {
      cold = true
    }
    if cold { c.left = 0.6 } else if c.left > 0.0 { c.left = max(0.0, c.left - dt) }
  }
}

// A tower that shoots aims at the foe in its reach that is furthest
// along the road, and when it is ready an arrow hits that one, or a
// shell sets out for where it is.
system shoot() {
  let dt = min(Window.dt, 0.05)
  for t: mut Tower, s: Site, a: mut Aim where t.kind != Kind.Frost {
    if t.cool > 0.0 { t.cool = max(0.0, t.cool - dt) }
    if a.flash > 0.0 { a.flash = max(0.0, a.flash - dt) }
    let x = s.col as f32
    let y = s.row as f32
    let far = reach(t.kind) * reach(t.kind)
    var first = -1.0
    var target: entity = none
    var found = false
    var tx = 0.0
    var ty = 0.0
    for e, p: At, w: Walk
        where w.far > first && apart(p.x, p.y, x, y) <= far {
      first = w.far
      target = e
      found = true
      tx = p.x
      ty = p.y
    }
    if a.found != found { a.found = found }
    if found {
      a.tx = tx
      a.ty = ty
      if t.cool <= 0.0 {
        t.cool = towers[t.kind].pause
        if t.kind == Kind.Arrow {
          a.flash = 0.09
          Health(target).hp -= towers[t.kind].harm
          spawn { Tone { pitch: 880.0, to: 660.0, seconds: 0.04, after: 0.0,
                         volume: 0.12, wave: Wave.Square } }
        } else {
          spawn { Shell { x: x, y: y, tx: tx, ty: ty,
                          harm: towers[t.kind].harm } }
          spawn { Tone { pitch: 150.0, to: 70.0, seconds: 0.12, after: 0.0,
                         volume: 0.3, wave: Wave.Noise } }
        }
      }
    }
  }
}

// A shell flies to where it was sent and bursts there: every foe near
// that place is hurt.
system shells() {
  let dt = min(Window.dt, 0.05)
  for e, s: mut Shell {
    let away = sqrt(apart(s.x, s.y, s.tx, s.ty))
    let step = 9.0 * dt
    if away <= step {
      for foe, a: At where apart(a.x, a.y, s.tx, s.ty) <= 1.2 * 1.2 {
        Health(foe).hp -= s.harm
      }
      spawn { Blast { x: s.tx, y: s.ty, r: 1.2, left: 0.25 } }
      e.destroy()
    } else {
      s.x += (s.tx - s.x) / away * step
      s.y += (s.ty - s.y) / away * step
    }
  }
}

// A blast shows for a moment; a foe with nothing left falls, and pays.
system falls() {
  let dt = min(Window.dt, 0.05)
  for e, b: mut Blast {
    b.left -= dt
    if b.left <= 0.0 { e.destroy() }
  }
  for e, f: Foe, h: Health where h.hp <= 0.0 {
    Gold += f.reward
    e.destroy()
  }
}

// The board, into its box: after the boxes are drawn, before what floats
// over them.
system draw_board() {
  clip(Area.x, Area.y, Area.w, Area.h)
  let cell = Grid.cell
  let gx = Grid.x
  let gy = Grid.y
  let wide = cell * cols() as f32
  let high = cell * rows() as f32
  let way = road(Game.map)
  // Grass, a little lighter in every other field, and the road.
  rounded(gx - 5.0, gy - 5.0, wide + 10.0, high + 10.0, 8.0, 8.0, 8.0, 8.0,
          0x2a3442)
  for r in 0..rows() {
    for c in 0..cols() {
      let colour = if on_road(way, c, r) { 0x8a7a5c }
                   else if (r + c) % 2 == 0 { 0x2f5d3a } else { 0x2b5536 }
      rect(gx + c as f32 * cell, gy + r as f32 * cell, cell, cell, colour)
    }
  }

  // Where the chosen tower would stand and reach, under the pointer.
  if Hover.on && Game.state == State.Playing {
    let free = !on_road(way, Hover.col, Hover.row) &&
               Gold >= cost(Game.chosen)
    let x = gx + (Hover.col as f32 + 0.5) * cell
    let y = gy + (Hover.row as f32 + 0.5) * cell
    circle(x, y, reach(Game.chosen) * cell,
           if free { 0x30ffffff } else { 0x30f05040 })
    rect(gx + Hover.col as f32 * cell, gy + Hover.row as f32 * cell, cell,
         cell, if free { 0x50ffffff } else { 0x50f05040 })
  }

  // The towers: a base, and a barrel that points at what it aims at.
  for t: Tower, s: Site, a: Aim {
    let x = gx + (s.col as f32 + 0.5) * cell
    let y = gy + (s.row as f32 + 0.5) * cell
    let half = cell * 0.4
    rounded(x - half, y - half, 2.0 * half, 2.0 * half, cell * 0.14,
            cell * 0.14, cell * 0.14, cell * 0.14, 0x3a4656)
    circle(x, y, cell * 0.27, towers[t.kind].tint)
    if t.kind == Kind.Frost {
      circle(x, y, reach(Kind.Frost) * cell, 0x145fb4e8)
      circle(x, y, cell * 0.12, 0xe8f6ff)
    } else if a.found {
      let tx = gx + (a.tx + 0.5) * cell
      let ty = gy + (a.ty + 0.5) * cell
      let away = max(1.0, sqrt(apart(x, y, tx, ty)))
      let bx = x + (tx - x) / away * cell * 0.42
      let by = y + (ty - y) / away * cell * 0.42
      line(x, y, bx, by, 0x1a1f26)
      line(x + 1.0, y, bx + 1.0, by, 0x1a1f26)
      line(x, y + 1.0, bx, by + 1.0, 0x1a1f26)
      if a.flash > 0.0 { line(bx, by, tx, ty, 0xfff2b0) }
    }
  }

  // The foes: bluish while cold, each with what it has left above it.
  for f: Foe, a: At, h: Health, c: Chill {
    let x = gx + (a.x + 0.5) * cell
    let y = gy + (a.y + 0.5) * cell
    let r = breeds[f.breed].girth * cell
    let hue = breeds[f.breed].hue
    circle(x, y, r + 2.0, 0x1a1f26)
    circle(x, y, r, if c.left > 0.0 { blend(hue, 0x9fd8ff, 0.6) } else { hue })
    let part = max(0.0, h.hp / h.full)
    rect(x - r, y - r - 7.0, 2.0 * r, 4.0, 0x1a1f26)
    rect(x - r, y - r - 7.0, 2.0 * r * part, 4.0, 0x6fe07a)
  }

  for s: Shell {
    circle(gx + (s.x + 0.5) * cell, gy + (s.y + 0.5) * cell, cell * 0.11,
           0x1a1f26)
  }
  for b: Blast {
    let grown = 1.0 - b.left / 0.25
    circle(gx + (b.x + 0.5) * cell, gy + (b.y + 0.5) * cell,
           b.r * cell * (0.4 + 0.6 * grown), 0x70ffb060)
  }

  // What happens next, or how it ended.
  if Game.state == State.Playing && Game.left == 0 && Game.alive == 0 &&
     Game.wave < waves() {
    let soon = "wave {Game.wave + 1} in {ceil(max(Game.rest, 0.0)) as i32}"
    label(soon, gx + (wide - text_width(soon, 22.0)) * 0.5, gy + 10.0, 22.0,
          0xe8eef6)
  }
  if Game.state != State.Playing {
    var title: text[30] = "the road is held"
    if Game.state == State.Lost { title = "they got through" }
    var hint: text[30] = "enter to start over"
    if Game.state == State.Won && Game.map + 1 < maps() {
      hint = "enter for the next map"
    }
    let big = max(26.0, cell * 0.9)
    let box = max(text_width(title, big), text_width(hint, 18.0)) + 56.0
    let tall = big + 18.0 + 46.0
    rounded(gx + (wide - box) * 0.5, gy + (high - tall) * 0.5, box, tall,
            10.0, 10.0, 10.0, 10.0, 0xd012161c)
    label(title, gx + (wide - text_width(title, big)) * 0.5,
          gy + (high - tall) * 0.5 + 16.0, big, 0xf0f4f8)
    label(hint, gx + (wide - text_width(hint, 18.0)) * 0.5,
          gy + (high - tall) * 0.5 + 28.0 + big, 18.0, 0x9aa6b4)
  }
  unclip()
}

schedule frame() {
  begin()
  bars()
  ui_base()
  input()
  marshal()
  walk() run_if Game.state == State.Playing
  frost() run_if Game.state == State.Playing
  shoot() run_if Game.state == State.Playing
  shells() run_if Game.state == State.Playing
  falls() run_if Game.state == State.Playing
  draw_board()
  ui_top()
  play()
  present()
}

main {
  loop { frame() } until Window.closed
}

//
// The game: in a window, with its menus. Started where the game is (its
// `data`, `themes` and `levels`: build/pushover/upstream after
// reference/build.sh and reference/pictures.sh):
//
//   cd build/pushover/upstream && ent run ../../../examples/pushover/pushover.ent
//
// In a menu the arrow keys choose and Enter takes; Escape goes back. In
// a level the arrow keys walk and climb, the space bar takes a domino
// and puts it down, and with up held among the dominoes it pushes;
// Escape asks what now, F1 helps.
import window
import sound
import files
import level
import dominoes
import ant
import pictures
import draw
import sets
import menu

// The sheet of a theme that was read (one for each theme met so far).
component Sheet { name: text[30], picture: i32 } capacity 32

world {
  Window.width = 800
  Window.height = 600
  Window.title = "Pushover"
  Window.fps = 60
  Window.background = 0x000000
  Window.resizable = true
  Window.escape = true
  Config.sounds = true
  Config.music = true
  Menu.mode = Mode.Main
  Menu.fresh = true
  Menu.set = -1
  Play.entry = none
}

// The files of the sounds, by their numbers (soundsys.cpp); and each
// theme's picture and music, named by the level that has the theme.
asset "data/*.ogg"
asset "themes/*.png"
asset "themes/*.ogg"
table sound_files: text[40] = [
  "data/01_StandardFalling.ogg", "data/02_StopperHit.ogg",
  "data/03_Splitter.ogg", "data/04_Exploder.ogg", "data/05_Delay.ogg",
  "data/06_TumblerFalling.ogg", "data/07_BridgerFalling.ogg",
  "data/06_TumblerFalling.ogg", "data/09_TriggerFalling.ogg",
  "data/0A_Ascender.ogg", "data/0B_Falling.ogg", "data/0C_Landing.ogg",
  "data/0D_PickUpDomino.ogg", "data/0E_Tapping.ogg",
  "data/0F_Schrugging.ogg", "data/10_DoorClose.ogg", "data/11_DoorOpen.ogg",
  "data/13_Victory.ogg"
]

// The picture is 800 by 600 whatever the window is: as big as fits, in
// its middle. And the keys of the game, and whether a tick is due (18 a
// second, while a level is played).
system input() {
  Window.fullscreen = Config.fullscreen
  let zoom = if Window.zoom > 0.0 { Window.zoom } else { 1.0 }
  let wide = Window.width as f32 * zoom
  let high = Window.height as f32 * zoom
  let fits = max(0.25, min(wide / 800.0, high / 600.0))
  Window.zoom = fits
  shift((wide / fits - 800.0) / 2.0, (high / fits - 600.0) / 2.0)
  var keys = 0
  if Menu.mode == Mode.Play {
    if Keys.left { keys |= KEY_LEFT }
    if Keys.up { keys |= KEY_UP }
    if Keys.right { keys |= KEY_RIGHT }
    if Keys.down { keys |= KEY_DOWN }
    if Keys.space { keys |= KEY_ACTION }
  }
  Game.keys = keys
  let playing = (Menu.mode == Mode.Play || Menu.mode == Mode.FailDelay) &&
                Play.level && !Play.load
  if playing { Play.since += Window.dt }
  Play.due = playing && Play.since >= 1.0 / 18.0
  if Play.due {
    Play.since -= 1.0 / 18.0
    // (After a long frame the game does not hurry to catch up.)
    if Play.since > 1.0 / 18.0 { Play.since = 0.0 }
  }
}

// Which file the level is that was chosen.
system choose() {
  if let path = Entry(Play.entry).path { Level.file = path }
}

// After the level was read: the theme's sheet is found, or read; its
// music is played.
system open_level() {
  Play.load = false
  Play.level = Level.ok
  Play.since = 0.0
  Play.delay = 0
  Art.theme = 0
  for s: Sheet where s.name == Level.theme { Art.theme = s.picture }
  if Art.theme == 0 {
    Art.theme = picture_load("themes/" + Level.theme + ".png")
    spawn { Sheet { name: Level.theme, picture: Art.theme } }
  }
  Music.file = ""
  if Config.music { Music.file = "themes/" + Level.theme + ".ogg" }
  Music.volume = 0.5
  if !Level.ok {
    Menu.mode = Mode.Levels
    Menu.fresh = true
  }
}

// After a tick: its sounds are heard, and once nothing moves any more
// what the level came to is taken up (the end of main.cpp's loop): one
// that is solved is marked so; one that is lost goes on for two seconds.
system follow() {
  if Config.sounds {
    for i in 0..len(Sounds) {
      spawn { Sample { file: sound_files[Sounds[i].id], volume: 1.0 } }
    }
  }
  let result = Game.result
  if Menu.mode == Mode.FailDelay {
    if Play.delay > 0 {
      Play.delay -= 1
    } else {
      Menu.mode = Mode.Failed
      Menu.fresh = true
    }
  } else if Level.idle > 3 && result != UNDECIDED {
    if result == SOLVED || result == SOLVED_LATE {
      let mark = if result == SOLVED { 2 } else { 1 }
      for e, level: mut Entry where e == Play.entry { level.solved max= mark }
      Sets.save = true
      Menu.mode = if result == SOLVED { Mode.Solved } else { Mode.Timeout }
      Menu.fresh = true
    } else {
      Play.delay = 36
      Menu.mode = Mode.FailDelay
    }
  }
}

fn two(number: i32) -> text[8] {
  if number < 10 { "0{number}" } else { "{number}" }
}

// The level as `picture_level` listed it, and the time left.
system paint() {
  for i in 0..len(Blits) {
    let sheet = Blits[i].sheet
    let image = if sheet == SHEET_DOMINOES { Art.dominoes }
                else if sheet == SHEET_ANT { Art.ant } else { Art.theme }
    picture_part(image, Blits[i].from_x as f32, Blits[i].from_y as f32,
                 Blits[i].w as f32, Blits[i].h as f32, Blits[i].x as f32,
                 Blits[i].y as f32, Blits[i].w as f32, Blits[i].h as f32,
                 0xffffff)
  }
  // (The time that is over is counted up, in red.)
  let late = Level.time < 0
  let seconds = if late { -(Level.time / 18) + 1 } else { Level.time / 18 }
  let time = two(seconds / 60) + ":" + two(seconds % 60)
  write(time, 22.0, 562.0, 100.0, Fonts.big, 32.0, 0.0, 0.0, 2, 0, 0x000000)
  write(time, 20.0, 560.0, 100.0, Fonts.big, 32.0, 0.0, 0.0, 2, 0,
        if late { 0xff0000 } else { COLOUR_HELP })
  let help = "F1: Help"
  let wide = text_extent(help, Fonts.small, 18.0, 0.0, 2)
  write(help, 791.0 - wide, 573.0, 200.0, Fonts.small, 18.0, 0.0, 0.0, 2, 0,
        0x000000)
  write(help, 790.0 - wide, 572.0, 200.0, Fonts.small, 18.0, 0.0, 0.0, 2, 0,
        COLOUR_HELP)
}

schedule setup() {
  open_art()
  load_sets()
}

schedule frame() {
  begin()
  input()
  window_keys()
  use_keys()
  take_line() run_if Menu.done
  choose() run_if Play.load
  load_level() run_if Play.load
  load_theme() run_if Play.load
  enter() run_if Play.load
  open_level() run_if Play.load
  // (A tick, as ant.ent's `tick` has it: a schedule run in another takes
  // no condition, so its steps are given theirs.)
  hush() run_if Play.due
  doors() run_if Play.due
  act_ant() run_if Play.due
  topple() run_if Play.due
  decide_level() run_if Play.due
  follow() run_if Play.due
  tally() run_if Sets.save
  write_solved() run_if Sets.save
  make_window() run_if Menu.fresh
  picture_level() run_if Play.level
  paint() run_if Play.level
  paint_window()
  play()
  present()
}

main {
  setup()
  loop { frame() } until Window.closed || Menu.mode == Mode.Exit
}

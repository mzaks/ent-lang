// The turn of the domino of a place (callStateFunction).
proc act(cells: mut Cells, dominoes: mut Domino, sounds: mut Sounds, x: i32,
         y: i32) {
  let me = who(cells, x, y)
  let extra = dominoes[me].extra
  let action = actions[dominoes[me].state * 22 + dominoes[me].kind as i32]
  if action == 1 { flat(cells, dominoes, sounds, x, y, -1) }
  else if action == 2 { nearly_left(cells, dominoes, x, y) }
  else if action == 3 { meet(cells, dominoes, sounds, x, y, -1) }
  else if action == 4 { fall(cells, dominoes, x, y) }
  else if action == 5 { explode(cells, dominoes, x, y) }
  else if action == 6 { tumble(cells, dominoes, sounds, x, y, -1) }
  else if action == 7 { bridge(cells, dominoes, sounds, x, y, -1) }
  else if action == 8 { remove_domino(cells, dominoes, x, y) }
  else if action == 10 { ceiling(cells, dominoes, sounds, x, y, -1) }
  else if action == 12 { split(cells, dominoes, sounds, x, y) }
  else if action == 14 { stand(cells, dominoes, sounds, x, y) }
  else if action == 15 {
    // A stopper, splitter or exploder: it stands, unless it falls
    // (DTA_F).
    if extra == FALLING { stand(cells, dominoes, sounds, x, y) }
  } else if action == 16 {
    // A delay counts down (DTA_G).
    if extra <= 1 || extra == FALLING { stand(cells, dominoes, sounds, x, y) }
    else { dominoes[me].extra = extra - 1 }
  } else if action == 17 { rise(cells, dominoes, sounds, x, y) }
  else if action == 18 { meet(cells, dominoes, sounds, x, y, 1) }
  else if action == 19 { nearly_right(cells, dominoes, x, y) }
  else if action == 20 { flat(cells, dominoes, sounds, x, y, 1) }
  else if action == 21 { tumble(cells, dominoes, sounds, x, y, 1) }
  else if action == 22 { bridge(cells, dominoes, sounds, x, y, 1) }
  else if action == 24 { ceiling(cells, dominoes, sounds, x, y, 1) }
  else if action == 25 { count(cells, dominoes, sounds, x, y) }
}

// Whether every trigger lies flat (true where there is none).
fn trigger_fallen(dominoes: Domino) -> bool {
  var fallen = true
  for e, other in dominoes
      where other.kind == Kind.Trigger && other.state != ST_LEFT &&
            other.state != ST_RIGHT {
    fallen = false
  }
  fallen
}

// Whether a trigger was toppled and does not lie flat.
fn trigger_not_flat(dominoes: Domino) -> bool {
  var askew = false
  for e, other in dominoes
      where other.kind == Kind.Trigger && other.state != ST_UPRIGHT &&
            other.state != ST_LEFT && other.state != ST_RIGHT {
    askew = true
  }
  askew
}

// Whether there is a pile.
fn rubble(dominoes: Domino) -> bool {
  var any = false
  for e, other in dominoes where other.kind as i32 >= K_CRASH0 { any = true }
  any
}

// Whether a domino that is to fall still stands upright.
fn some_standing(dominoes: Domino) -> bool {
  var any = false
  for e, other in dominoes
      where other.kind != Kind.Empty && other.kind != Kind.Stopper &&
            other.state == ST_UPRIGHT {
    any = true
  }
  any
}

// Whether a domino has fallen far enough to count as fallen
// (dominosFalln, of one domino): a tumbler lies on something or leans
// against it; any other lies, or leans on a stopper with something
// holding it there.
fn fallen(cells: Cells, dominoes: Domino, cell: i32, trigger: bool) -> bool {
  let x = cell % WIDE
  let y = cell / WIDE
  let it = cells[cell].who
  let kind = dominoes[it].kind
  let state = dominoes[it].state
  if kind == Kind.Empty || kind == Kind.Stopper { true }
  else if kind == Kind.Splitter { !(state > ST_LEFT + 1 && state <= ST_UPRIGHT) }
  else if kind == Kind.Trigger { !(state == ST_UPRIGHT && !trigger) }
  else if kind == Kind.Tumbler {
    !(state >= ST_LEFT + 2 && state <= ST_RIGHT - 2) &&
    !(state <= ST_LEFT + 1 && empty(cells, dominoes, x - 1, y) &&
      (empty(cells, dominoes, x - 2, y) ||
       state_at(cells, dominoes, x - 2, y) < ST_RIGHT - 1)) &&
    !(state >= ST_RIGHT - 1 && empty(cells, dominoes, x + 1, y) &&
      (empty(cells, dominoes, x + 2, y) ||
       state_at(cells, dominoes, x + 2, y) > ST_LEFT + 1))
  } else {
    state != ST_UPRIGHT && !(state > ST_LEFT + 2 && state < ST_RIGHT - 2) &&
    !(state == ST_LEFT + 2 &&
      (kind_at(cells, dominoes, x - 1, y) != Kind.Stopper ||
       empty(cells, dominoes, x + 1, y) ||
       (dir_at(cells, dominoes, x + 1, y) != -1 &&
        kind_at(cells, dominoes, x + 1, y) != Kind.Splitter))) &&
    !(state == ST_RIGHT - 2 &&
      (kind_at(cells, dominoes, x + 1, y) != Kind.Stopper ||
       empty(cells, dominoes, x - 1, y) ||
       (dir_at(cells, dominoes, x - 1, y) != 1 &&
        kind_at(cells, dominoes, x - 1, y) != Kind.Splitter)))
  }
}

// Whether all the dominoes have fallen far enough (dominosFalln).
fn all_fallen(cells: Cells, dominoes: Domino) -> bool {
  let trigger = trigger_fallen(dominoes)
  var all = true
  for cell in 0..500 {
    if !fallen(cells, dominoes, cell, trigger) { all = false }
  }
  all
}

// The doors open and shut, a step a tick (performDoors).
system doors() {
  if Doors[0].open_entry {
    if Doors[0].entry == 0 { sound(Sounds, SE_DOOR_OPEN) }
    if Doors[0].entry != 3 { Doors[0].entry += 1 }
  } else {
    if Doors[0].entry == 3 { sound(Sounds, SE_DOOR_CLOSE) }
    if Doors[0].entry != 0 { Doors[0].entry -= 1 }
  }
  if Doors[0].open_exit {
    if Doors[0].exit == 0 { sound(Sounds, SE_DOOR_OPEN) }
    if Doors[0].exit != 3 { Doors[0].exit += 1 }
  } else {
    if Doors[0].exit == 3 { sound(Sounds, SE_DOOR_CLOSE) }
    if Doors[0].exit != 0 { Doors[0].exit -= 1 }
  }
}

// Whether every trigger lay flat before the dominoes took their turns.
unique Before: bool

// A tick of the dominoes (performDominos): each in its turn, place by
// place. One that is no more is taken away when its turn comes.
system topple() {
  Before = trigger_fallen(Domino)
  Level.idle += 1
  for e, d: mut Domino in turn by d.cell {
    if d.kind != Kind.Empty && d.state != 0 {
      let state = d.state
      let extra = d.extra
      let drop = d.drop
      act(Cells, Domino, Sounds, d.cell % WIDE, d.cell / WIDE)
      // (A tumbler that goes to and fro is not something going on.)
      if (state != d.state || extra != d.extra || drop != d.drop) &&
         d.kind != Kind.Tumbler {
        Level.idle = 0
      }
    }
    if d.kind == Kind.Empty {
      if Cells[d.cell].who == e { Cells[d.cell].who = none }
      e.destroy()
    }
  }
  Level.time -= 1
}

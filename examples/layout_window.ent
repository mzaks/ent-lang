// examples/layout.ent in a window: what a box looks like and says, the
// measuring of texts, which only what draws them can do, and the
// drawing. A program imports this, makes boxes, and runs `ui` between the
// window's `begin` and `present`:
//
//   import layout_window
//   schedule frame() { begin()  ...  ui()  present() }
//
// (examples/layout_demo.ent is one.)
import window
import layout

// A box that is filled with a colour.
component Fill { colour: i32 }

// A box that says something: a line of text `size` pixels high. Its box
// is at least as big as the text and its padding (where it is not
// `Fixed`), and the text stands in it where the box's own `Align` says.
component Text { text: text[126], size: f32, colour: i32 }
// A text that goes on in the next line where its box ends: the box can
// be as narrow as the longest word, and is as high as the lines come to.
tag Wrap

// How big each text is: when it is new or says something else.
system measure() {
  for e, t: Text without Natural on added Text {
    e.add(Natural { w: 0.0, min_w: 0.0, h: 0.0 })
  }
  for e, t: Text, n: mut Natural on changed t, added Natural {
    let w = text_width(t.text, t.size)
    n.w = w
    n.min_w = if e.has(Wrap) { text_min_width(t.text, t.size) } else { w }
    n.h = t.size
  }
}

// A text that goes on in the next line is as high as its lines come to in
// the width `layout_widths` gave its box.
system wrap() {
  for b: Box, t: Text, k: Stack, n: mut Natural, optional p: Pad with Wrap
      on changed b.w, changed t, changed k, changed p {
    var pads = 2.0 * k.pad
    if let left = p.left, let right = p.right { pads = left + right }
    let h = text_height(t.text, t.size, b.w - pads)
    n.h = h
  }
}

// A box is drawn after the one it is in, and so on top of it, and all
// that is in a box before the next box: depth first. What floats is a
// layer above, drawn after all of the layer below.
system draw() {
  for z in 0..8 {
    for e, b: Box, l: Layer, optional f: Fill, optional t: Text,
        optional k: Stack, optional p: Pad, optional how: Align
        top down dfs Inside where l.z == z {
      if let colour = f.colour { rect(b.x, b.y, b.w, b.h, colour) }
      if let said = t.text, let size = t.size, let ink = t.colour {
        var left = 0.0
        var right = 0.0
        var top = 0.0
        var bottom = 0.0
        if let pad = k.pad {
          left = pad
          right = pad
          top = pad
          bottom = pad
        }
        if let pl = p.left, let pr = p.right, let pt = p.top,
           let pb = p.bottom {
          left = pl
          right = pr
          top = pt
          bottom = pb
        }
        let room_w = b.w - left - right
        let room_h = b.h - top - bottom
        if e.has(Wrap) {
          let high = text_height(said, size, room_w)
          var fy = 0.0
          if let ay = how.y {
            if ay == Place.Middle { fy = 0.5 }
            if ay == Place.End { fy = 1.0 }
          }
          paragraph(said, b.x + left, b.y + top + (room_h - high) * fy,
                    room_w, size, ink)
        } else {
          var fx = 0.0
          var fy = 0.0
          if let ax = how.x, let ay = how.y {
            if ax == Place.Middle { fx = 0.5 }
            if ax == Place.End { fx = 1.0 }
            if ay == Place.Middle { fy = 0.5 }
            if ay == Place.End { fy = 1.0 }
          }
          let wide = text_width(said, size)
          label(said, b.x + left + (room_w - wide) * fx,
                b.y + top + (room_h - size) * fy, size, ink)
        }
      }
    }
  }
}

// The whole of it, between the window's `begin` and `present`.
schedule ui() {
  measure()
  layout_widths()
  wrap()
  layout_heights()
  draw()
}

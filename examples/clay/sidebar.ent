  // ScrollBar: 12 wide at the content's right, as much of its height as
  // it shows of what is in it, and as far down as that is scrolled.
  let bar = spawn {
    Box { x: 0.0, y: 0.0, w: 12.0, h: 0.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Fill { colour: 0x967878a0 },
    Round { top_left: 6.0, top_right: 6.0, bottom_left: 6.0,
            bottom_right: 6.0 },
    Float { dx: 0.0, dy: 0.0 },
    Attach { own: Point.TopRight, under: Point.TopRight }, Raise { z: 1 },
    Bar
  }

system interact() {
  // The window's box is as big as the window.
  for b: mut Box with Root
      where b.w != Window.width as f32 || b.h != Window.height as f32 {
    b.w = Window.width as f32
    b.h = Window.height as f32
  }

  // The buttons are orange under the pointer; the first row of pictures
  // lets what is under it show.
  for e, f: mut Fill with HeaderButton {
    let colour = if e.has(Hovered) { 0xe18a32 } else { 0x6fada2 }
    if f.colour != colour { f.colour = colour }
  }
  for e, f: mut Fill with Photos {
    let colour = if e.has(Hovered) { 0x78b4b4dc } else { 0xb4b4dc }
    if f.colour != colour { f.colour = colour }
  }

  // The bar: the pointer that goes down on it takes it along, and the
  // content as many times as far as it is higher than what shows of it.
  OnBar = 0
  for e with Bar, Hovered { OnBar += 1 }
  if !Pointer.down { Grab.on = false }
  View.h = 0.0
  View.room = 0.0
  View.all = 0.0
  View.y = 0.0
  for s: Scroll, b: Box, rh: RoomH, all: Content with Main {
    View.h max= b.h
    View.room max= rh.room
    View.all max= all.h
    View.y min= s.y
  }
  if Pointer.down && !Grab.on && OnBar > 0 {
    Grab.on = true
    Grab.from = Pointer.y
    Grab.was = View.y
  } else if Grab.on && View.all > 0.0 && View.room > 0.0 {
    View.y = Grab.was + (Grab.from - Pointer.y) * View.all / View.room
    for s: mut Scroll with Main where s.y != View.y { s.y = View.y }
  }
  for e, f: mut Float, b: mut Box, c: mut Fill with Bar {
    let part = if View.all > View.room { View.room / View.all } else { 1.0 }
    let h = part * View.h
    let dy = if View.all > 0.0 { 0.0 - View.y / View.all * View.h } else { 0.0 }
    if b.h != h { b.h = h }
    if f.dy != dy { f.dy = dy }
    let colour = if e.has(Hovered) { 0x9664648c } else { 0x967878a0 }
    if c.colour != colour { c.colour = colour }
  }
}

schedule frame() {
  begin()
  interact()
  ui()
  present()
}

main {
  loop { frame() } until Window.closed
}

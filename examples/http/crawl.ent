// The crawler: the business on top of the pipeline (http-SPEC.md, §4.2
// and §5.2). A page that answered becomes the asks for the pages it
// links to, so the pipeline feeds itself. It knows nothing of sockets.
//
// Breadth first, by depth: the links of a page are followed once every
// ask less deep is settled (`Level`), so a page's depth is the fewest
// links to it from the seed, whichever answers first; a redirect is as
// deep as the ask redirected. Two asks for one URL are one, the older,
// with the lesser depth.
import text
import console
import files
import urls
import robots
import pipeline

// Links from the seed to here.
component Depth { d: i32 }
// The host it goes to.
component At { host: entity }
// A host it may go to; its number among them; how many asks to it are
// out (or let go and not sent yet); how many of its asks were given a
// turn, and how many of them let go (be_polite).
component Host { name: text, number: i64, busy: i32, turns: i64, let_go: i64 }
// An ask's place among its host's, in the order they were made; and the
// same with its host's number above it, by which `ByTurn` finds it.
component Turn { n: i64, key: i64 }
// A host's robots.txt (§8.2, K11): the ask for it; whether it is known
// (answered, or failed for good); its rules for the crawler (as
// robots.ent's robots_rules gives them: none, where it was not a 200);
// the seconds between asks it wants, and when the next may go.
component Robots { ask: entity, known: bool, rules: text, delay: f64, next: f64 }
// The ask for a host's robots.txt, which nothing holds back. (One a
// host: so few that their archetype need not be as big as the asks'.)
tag RobotsAsk capacity 1024
// An ask robots.txt does not let the crawler send.
tag Disallowed
// A page links to a page.
relation (Ask)-[Links]->(Ask) capacity 4194304
// The page whose link made this ask: the edge is connected once the ask
// is known to be no duplicate, to the ask it is one of where it is (so
// nothing reads `Links` before the report, which sorts it, once: a
// relation only `for`s along its edges read is sorted before them).
component LinkedFrom { page: entity }
// How it ended, for the report: the status, or why there was none.
component Ending { word: text }

// What the crawl is to do (crawl.conf): the first URL, how deep, how
// many asks out to a host at once. (The hosts it may go to, `allow`, are
// a Host each.)
unique Rules { seed: text, max_depth: i32, per_host: i32 }
// How deep the links followed are so far.
unique Level: i32
// Asks not settled; none at the end.
unique Open: i32

index HostByName of Host by name hash

// The value of `key` in a file of `key value` lines.
fn setting(conf: text, key: text) -> text {
  let at = find("\n" + conf, "\n" + key + " ", 0)
  if at < 0 { "" }
  else {
    let from = at + len(key) + 1
    slice(conf, from, or_end(find(conf, "\n", from), len(conf)))
  }
}

fn is_html(headers: text) -> bool {
  find(lower(headers), "content-type: text/html", 0) >= 0
}

system setup() {
  let conf = read_text("crawl.conf")
  Rules.seed = setting(conf, "seed")
  Rules.max_depth = number(setting(conf, "max_depth")) as i32
  Rules.per_host = number(setting(conf, "per_host")) as i32
  Net.timeout = number(setting(conf, "timeout_ms")) as f64 / 1000.0
  Net.slow_after = number(setting(conf, "slow_ms")) as f64 / 1000.0
  Net.retries = number(setting(conf, "retries")) as i32
  Net.redirects = number(setting(conf, "redirects")) as i32
  Net.backoff = number(setting(conf, "backoff_ms")) as f64 / 1000.0
  let allow = setting(conf, "allow")
  let seed = normalise(setting(conf, "seed"))
  let scheme = slice(seed, 0, scheme_end(seed))
  var at = 0
  var hosts = 0
  while at < len(allow) {
    let end = or_end(find(allow, " ", at), len(allow))
    if end > at {
      let name = slice(allow, at, end)
      let robots = spawn { Ask { method: Method.Get, url: scheme + "://" + name + "/robots.txt",
                                 headers: "", body: "", origin: none, hops: 0, tries: 0,
                                 next_at: 0.0, serial: 0 },
                           Twin { of: none }, Depth { d: 0 }, RobotsAsk }
      hosts += 1
      spawn { Host { name: name, number: hosts, busy: 0, turns: 0, let_go: 0 },
              Robots { ask: robots, known: false, rules: "", delay: 0.0, next: 0.0 } }
    }
    at = end + 1
  }
  spawn { Ask { method: Method.Get, url: seed, headers: "", body: "", origin: none,
                hops: 0, tries: 0, next_at: 0.0, serial: 0 },
          Twin { of: none },
          Depth { d: 0 } }
}

// A redirect's ask is as deep as the one redirected. (In two steps: a
// query that gives entities a Depth does not read the Depth of others.)
component Inherited { d: i32 }
system inherit_depth() {
  for me, a: Ask, t: Twin without Depth, Inherited on added Twin {
    if t.of == none {
      if let d = Depth(a.origin).d { me.add(Inherited { d: d }) }
    }
  }
}
system take_depth() {
  for me, i: Inherited without Depth on added Inherited { me.add(Depth { d: i.d }) }
}

// Each ask to its host, once the host's robots.txt is known (held back
// till then); one to a host it may not go to is dropped, one robots.txt
// does not allow is held for good. Looked at as it comes, and again
// (`Recheck`) where it waited for a robots.txt and one came.
tag ForRobots
tag Recheck
system place() {
  for me, a: Ask, t: Twin without At on added Twin, added Recheck {
   if me.has(Recheck) { me.remove(Recheck) }
   if t.of == none {
    let host = HostByName.get(host_of(a.url))
    if host == none {
      me.destroy()
    } else if me.has(RobotsAsk) {
      me.add(At { host: host })
    } else if let known = Robots(host).known, let rules = Robots(host).rules {
      if !known {
        if !me.has(Held) { me.add(Held) }
        me.add(ForRobots)
      } else {
        me.add(At { host: host })
        if robots_allow(rules, path_of(a.url)) {
          if me.has(Held) { me.remove(Held) }
        } else {
          me.add(Disallowed)
          me.add(Handled)
          if !me.has(Held) { me.add(Held) }
        }
      }
    }
   }
  }
}

// A host's robots.txt once it is answered for good (after `retry`: an
// answer still there is not to be tried again) or has failed for good:
// its rules where it answered 200, none else.
unique KnownHosts: i64
system read_robots() {
  for r: mut Robots where !r.known {
    if let status = Got(r.ask).status, let body = Got(r.ask).body {
      if status == 200 {
        let (rules, delay) = robots_rules(body, "ent-crawl")
        r.rules = rules
        r.delay = delay
      }
      r.known = true
    } else {
      if let kind = Failed(r.ask).kind { r.known = true }
    }
  }
  // (Where one came: the asks that waited for it looked at again.)
  let known = for r: Robots where r.known { }
  if known as i64 > KnownHosts {
    KnownHosts = known as i64
    for me with ForRobots {
      me.remove(ForRobots)
      me.add(Recheck)
    }
  }
}

// At most `per_host` asks out to a host at once; the others held back,
// the oldest let go first. Each ask, as it is given its host (`place`
// gives `At` once it may go, with `Held` where it may not), takes the
// next turn at its host and waits (`take_turns`); each frame a host lets
// go as many more turns as it has room for, those asks found by their
// turn (`ByTurn`): a queue for each host, so no frame looks at the asks
// that still wait.
fn turn_key(host: i64, n: i64) -> i64 { host * 4294967296 + n }
system take_turns() {
  for me, a: Ask, at: At without Sent, Held, Turn in turn by a.serial on added At {
    if let n = Host(at.host).turns, let number = Host(at.host).number {
      Host(at.host).turns = n + 1
      me.add(Turn { n: n, key: turn_key(number, n) })
      me.add(Held)
    }
  }
}
index ByTurn of Turn by key hash unique
// The asks whose turn came this frame. (As many as may go at once: the
// mock, which holds none back, says more.)
buffer LetGo { who: entity } capacity 65536
system be_polite() {
  for h: mut Host { h.busy = 0 }
  for a: Ask, at: At with Going { Host(at.host).busy += 1 }
  LetGo = []
  // (By number: in a `for` by a field, rows given to a buffer are there
  // at once, so a host may give several.)
  for h: mut Host by h.number {
    let more = h.let_go + (Rules.per_host - h.busy) as i64
    if more > h.let_go {
      let to = if more < h.turns { more } else { h.turns }
      var n = h.let_go
      while n < to {
        let ask = ByTurn.get(turn_key(h.number, n))
        if ask != none { LetGo += { who: ask } }
        n += 1
      }
      h.let_go = to
    }
  }
  for me with Held in LetGo { me.remove(Held) }
}

// An ask to a host with a `Crawl-delay` goes no sooner than that after
// the one before it went: of those due, the oldest goes once the host's
// time has come, and the host's next time is then; the others wait for
// it (`next_at`, which the device's send keeps). (Part of politeness:
// optional.)
system pace() {
  for me, a: mut Ask, at: At with Going without Sent in turn by a.serial {
    if let delay = Robots(at.host).delay, let next = Robots(at.host).next {
      if delay > 0.0 {
        if a.next_at <= Now && next <= Now {
          Robots(at.host).next max= Now + delay
        } else if a.next_at < next {
          a.next_at = next
        }
      }
    }
  }
}

// A page: an answer of 200 with HTML, which may have links to follow.
// (Said once, as it comes: not looked at again each frame it waits for
// the level.) One as deep as may be is settled there.
tag Html
system classify() {
  for me, g: Got, optional d: Depth on added Got {
    if g.status == 200 && is_html(g.headers) {
      me.add(Html)
      if let deep = d.d { if deep >= Rules.max_depth { me.add(Handled) } }
    }
  }
}

// The links of a page, once every ask less deep is settled: an ask for
// each URL not asked for yet, an edge to each.
system extract_links() {
  for me, a: Ask, g: Got, d: Depth with Html without Handled
      where d.d <= Level && d.d < Rules.max_depth {
    let page = uncommented(g.body, 0)
    let low = lower(page)
    let (base, skip) = base_of(a.url, page, low)
    var at = 0
    while at >= 0 {
      let (target, here) = next_link(base, page, low, at, skip)
      if len(target) > 0 && HostByName.get(host_of(target)) != none {
        // (Only an ask known to be no duplicate: one made this frame may
        // yet be one, and a new ask for its URL is merged with it.)
        let known = Kept.get(target)
        if known == none {
          spawn { Ask { method: Method.Get, url: target, headers: "",
                        body: "", origin: me, hops: 0, tries: 0,
                        next_at: 0.0, serial: 0 },
                  Twin { of: none }, Depth { d: d.d + 1 },
                  LinkedFrom { page: me } }
        } else {
          Depth(known).d min= d.d + 1
          connect (me)-[Links]->(known)
        }
      }
      at = if here < 0 { -1 } else { here + 1 }
    }
    me.add(Handled)
  }
}

// Every other answer is settled as it comes: given up, an error, a
// redirect (followed by then), what is not HTML. (A page as deep as may
// be by classify, or here where its depth came after it.)
system settle() {
  for me, g: Got without Handled, Html on added Got {
    if !retryable(g.status) { me.add(Handled) }
  }
  for me, d: Depth with Html without Handled on added Depth {
    if d.d >= Rules.max_depth { me.add(Handled) }
  }
  for me with GaveUp without Handled on added GaveUp { me.add(Handled) }
}

// A duplicate's depth and the link that made it go to the ask it is one
// of; an ask that is none is linked to from its page.
system merge() {
  for me, a: Ask, t: Twin, optional d: Depth, optional l: LinkedFrom
      on changed t.of {
    if t.of != none {
      if let deep = d.d {
        Depth(t.of).d min= deep
      } else {
        if let deep = Depth(a.origin).d { Depth(t.of).d min= deep }
      }
      if let page = l.page { connect (page)-[Links]->(t.of) }
    }
  }
  for me, t: Twin, l: LinkedFrom with Known on added Known {
    if t.of == none {
      connect (l.page)-[Links]->(me)
      me.remove(LinkedFrom)
    }
  }
}

// One level deeper once every ask at this one is settled; how many asks
// are open.
system advance_level() {
  let open = for a: Ask, t: Twin, d: Depth without Handled where d.d <= Level && t.of == none { }
  let unplaced = for a: Ask, t: Twin without Depth where t.of == none { }
  let left = for a: Ask, t: Twin without Handled where t.of == none { }
  if open + unplaced == 0 && left > 0 { Level += 1 }
  Open = left
}

// How each ask ended.
system conclude() {
  for me, a: Ask, t: Twin, optional g: Got, optional f: Failed where t.of == none {
    if me.has(Disallowed) {
      me.add(Ending { word: "disallowed" })
    } else if let status = g.status {
      me.add(Ending { word: "{status}" })
    } else {
      if let kind = f.kind {
        if kind == Failure.Timeout { me.add(Ending { word: "timeout" }) }
        else { me.add(Ending { word: "failed" }) }
      } else {
        me.add(Ending { word: "open" })
      }
    }
  }
}

// The report, a line each, in no order (check/crawl.py sorts them).
system report() {
  for me, a: Ask, e: Ending, optional g: Got {
    if e.word == "disallowed" { put("disallowed {a.url}") }
    else { put("fetched {a.url} {e.word} {a.tries + 1}") }
    if let status = g.status, let location = g.location {
      if status >= 300 && status < 400 && len(location) > 0 {
        put("redirect {a.url} {resolve(a.url, location)}")
      }
    }
    if me.has(RedirectLimit) { put("redirect-limit {a.url}") }
    if me.has(Slow) { put("slow {a.url}") }
    for (me)-[Links]->(to) {
      if let url = Ask(to).url, let word = Ending(to).word {
        if !starts(word, "2") && !starts(word, "3") && word != "disallowed" {
          put("broken {url} {word} from {a.url}")
        }
      }
    }
  }
}

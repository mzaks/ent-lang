// URLs and links as the crawler reads them (http-SPEC.md, §7.3): where a
// link on a page goes, and where on a page its links are. Fns only, in
// ent-lang on the text module's `find`, `slice` and `lower`; texts are
// built by joining, a loop over them by a fn calling itself.
import text

// The earlier of two places where either may be -1 (not found).
fn earliest(a: i32, b: i32) -> i32 {
  if a < 0 { b } else if b < 0 { a } else if a < b { a } else { b }
}

// The place, or `end` where it is -1.
fn or_end(at: i32, end: i32) -> i32 { if at < 0 { end } else { at } }

fn starts(t: text, prefix: text) -> bool {
  len(t) >= len(prefix) && slice(t, 0, len(prefix)) == prefix
}

fn ends(t: text, suffix: text) -> bool {
  len(t) >= len(suffix) && slice(t, len(t) - len(suffix), len(t)) == suffix
}

// `t` up to the first `what` in it (all of it where there is none).
fn before(t: text, what: text) -> text { slice(t, 0, or_end(find(t, what, 0), len(t))) }

// Where the last '/' of `t` is; -1 where it has none.
fn last_slash(t: text) -> i32 {
  var at = -1
  for i in 0..len(t) {
    if t[i] == '/' { at = i }
  }
  at
}

// Where the scheme of `t` ends, at its ':': a letter, then letters,
// digits, '+', '-' or '.'. -1 where it has none.
fn scheme_end(t: text) -> i32 {
  var end = -1
  var going = true
  for i in 0..len(t) {
    if going {
      let c = t[i]
      let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
      let other = (c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.'
      if c == ':' && i > 0 {
        end = i
        going = false
      } else if !(letter || (i > 0 && other)) {
        going = false
      }
    }
  }
  end
}

// `t` with every `what` in it, from byte `from` on, given as `by`.
fn replace_from(t: text, what: text, by: text, from: i32) -> text {
  let at = find(t, what, from)
  if at < 0 { slice(t, from, len(t)) }
  else { slice(t, from, at) + by + replace_from(t, what, by, at + len(what)) }
}

// A path without `.` and `..` segments (RFC 3986, 5.2.4): `out` is what
// is made so far (no '/' at its end), `at` where the next segment of
// `path` starts (after a '/').
fn dots(path: text, at: i32, out: text) -> text {
  let next = find(path, "/", at)
  let segment = slice(path, at, or_end(next, len(path)))
  let made = if segment == ".." { slice(out, 0, last_slash(out)) }
             else if segment == "." { out }
             else { out + "/" + segment }
  if next >= 0 { dots(path, next + 1, made) }
  else if segment == "." || segment == ".." { made + "/" }
  else { made }
}

fn without_dots(path: text) -> text {
  if len(path) == 0 { "/" } else { dots(path, 1, "") }
}

// An absolute URL as the crawler keeps it: scheme and host in lower
// case, without the scheme's own port, the path without dot segments
// (`/` where it is empty), no fragment.
fn normalise(url: text) -> text {
  let colon = scheme_end(url)
  let scheme = lower(slice(url, 0, colon))
  let rest = slice(url, colon + 3, len(url))
  let host_end = or_end(earliest(earliest(find(rest, "/", 0), find(rest, "?", 0)),
                                 find(rest, "#", 0)), len(rest))
  let named = lower(slice(rest, 0, host_end))
  let host = if scheme == "http" && ends(named, ":80") { slice(named, 0, len(named) - 3) }
             else if scheme == "https" && ends(named, ":443") { slice(named, 0, len(named) - 4) }
             else { named }
  let tail = before(slice(rest, host_end, len(rest)), "#")
  let q = find(tail, "?", 0)
  let path = slice(tail, 0, or_end(q, len(tail)))
  let query = if q < 0 { "" } else { slice(tail, q, len(tail)) }
  scheme + "://" + host + without_dots(path) + query
}

// Scheme and host of an absolute URL: all before its path.
fn origin(url: text) -> text {
  let from = scheme_end(url) + 3
  slice(url, 0, or_end(earliest(find(url, "/", from), find(url, "?", from)), len(url)))
}

// The host of an absolute URL (as `normalise` makes it).
fn host_of(url: text) -> text {
  let o = origin(url)
  slice(o, scheme_end(url) + 3, len(o))
}

// Where a link `link` on the page at `base` (an absolute URL) goes, or
// none (no bytes) where it is not to be followed: only a fragment,
// another scheme than http or https.
fn resolve(base: text, link: text) -> text {
  let r = replace_from(link, "&amp;", "&", 0)
  let colon = scheme_end(r)
  let scheme = if colon < 0 { "" } else { lower(slice(r, 0, colon)) }
  if len(r) == 0 || r[0] == '#' { "" }
  else if colon >= 0 { if scheme == "http" || scheme == "https" { normalise(r) } else { "" } }
  else if starts(r, "//") { normalise(slice(base, 0, scheme_end(base) + 1) + r) }
  else if r[0] == '/' { normalise(origin(base) + r) }
  else if r[0] == '?' { normalise(before(before(base, "#"), "?") + r) }
  else {
    let page = before(before(base, "#"), "?")
    normalise(slice(page, 0, last_slash(page) + 1) + r)
  }
}

// The page without its comments, `<!-- .. -->`, from byte `from` on.
fn uncommented(page: text, from: i32) -> text {
  let open = find(page, "<!--", from)
  if open < 0 { slice(page, from, len(page)) }
  else {
    let close = find(page, "-->", open + 4)
    if close < 0 { slice(page, from, open) }
    else { slice(page, from, open) + uncommented(page, close + 3) }
  }
}

fn space(c: i8) -> bool { c == ' ' || c == '\n' || c == '\t' || c == '\r' }

// Where the value of the next `href=` or `src=` from byte `from` on
// starts, in `low` (a page in lower case): an attribute after a space,
// not part of a longer name (`data-href=`). -1 where there is none.
fn next_value(low: text, from: i32) -> i32 {
  let h = find(low, "href=", from)
  let s = find(low, "src=", from)
  let at = earliest(h, s)
  if at < 0 { -1 }
  else if at > 0 && space(low[at - 1]) { if at == h { at + 5 } else { at + 4 } }
  else { next_value(low, at + 1) }
}

// Where a value that is not quoted, from byte `at` on, ends: at a space
// or '>', or the end.
fn unquoted_end(page: text, at: i32) -> i32 {
  var end = len(page)
  var going = true
  for i in at..len(page) {
    if going && (space(page[i]) || page[i] == '>') {
      end = i
      going = false
    }
  }
  end
}

// Where the value starting at `at` starts and ends: inside its quotes,
// or, not quoted, up to a space or '>'.
fn value_span(page: text, at: i32) -> (i32, i32) {
  let q = page[at]
  if q == '"' { (at + 1, or_end(find(page, "\"", at + 1), len(page))) }
  else if q == '\'' { (at + 1, or_end(find(page, "'", at + 1), len(page))) }
  else { (at, unquoted_end(page, at)) }
}

// The base links on `page` (at the URL `url`, without comments, `low` in
// lower case) go by: its `<base href>`, else its own URL. Then where the
// base's own href is, which is no link (-1 where it has none).
fn base_of(url: text, page: text, low: text) -> (text, i32) {
  let tag = find(low, "<base", 0)
  let at = if tag < 0 { -1 } else { next_value(low, tag) }
  if at < 0 { (url, -1) }
  else {
    let (from, to) = value_span(page, at)
    let base = resolve(url, slice(page, from, to))
    if len(base) == 0 { (url, at) } else { (base, at) }
  }
}

// The next link on a page from byte `from` on: where it goes (none where
// it is not to be followed) and where its value starts, -1 where there
// are no more. `base` and `skip` are base_of's; `page` without comments,
// `low` in lower case.
fn next_link(base: text, page: text, low: text, from: i32, skip: i32) -> (text, i32) {
  let at = next_value(low, from)
  if at < 0 { ("", -1) }
  else if at == skip { next_link(base, page, low, at + 1, skip) }
  else {
    let (start, end) = value_span(page, at)
    (resolve(base, slice(page, start, end)), at)
  }
}

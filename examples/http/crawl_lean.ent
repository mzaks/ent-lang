// K7 (http-SPEC.md §8.2): crawl_mock.ent without the systems the talk
// says can be taken away without touching the others: politeness,
// slow-request warnings, logging, history, clean-up. Nothing else is
// changed, and the report is the same, less the `slow` lines.
import console
import text
import pipeline
import crawl
import mock

// As many asks as there may be in a crawl, about: 2^26. What it does not
// use costs it nothing, in memory or in time; with ENT_WORLD_DIR set it
// is kept in a file, and so may be larger than memory (docs/ranks.md).
default_capacity 67108864
// (The mock holds no ask back by host: many are going at once, a third
// of the pages at 10^5.)
capacity Going 33554432

schedule start() { load_site() setup() }

schedule frame() {
  inherit_depth()
  take_depth()
  place()
  drop_stale()
  ready()
  mock_send()
  answer()
  fill()
  time_out()
  retry()
  read_robots()
  follow_redirect()
  classify()
  settle()
  read_links()
  due_pages()
  extract_links()
  number_asks()
  drop_duplicates()
  merge()
  forget_duplicates()
  advance_level()
  advance()
}

schedule finish() { conclude() report() stalled() }

main {
  start()
  loop { frame() } until Open == 0 || Frames >= 1000000
  finish()
}

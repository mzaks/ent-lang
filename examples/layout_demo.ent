// A window laid out by examples/layout.ent and drawn by
// examples/layout_window.ent: a bar at the side, and next to it a header,
// three cards and a footer. Every box says how big it is to be (so many
// pixels, what is inside it, the room there is, or a share of it) and
// which box it is in; where it ends up is worked out every frame.
//
//   tools/ent run -I examples examples/layout_demo.ent
//
// Hold the right mouse button to drag the side bar's edge; hold Space to
// put the cards below one another, which they do in a quarter of a
// second; turn the wheel over the side bar to move its entries, or drag
// them, and let go. The text in a card goes on in the next line where the
// card ends. The entries and the buttons light up under the mouse, and
// fade again. A note floats at the mouse, over everything else, with a
// mark that floats over its text; the pointer goes through them. A card
// goes dark while it is pressed, and goes when it is clicked. The dial
// in the header is drawn by this program, where the layout puts it. Enter
// sends the last card away; I shows the inspector, and O hides it. Drag
// the window's edge to give it another size, or press F to have it fill
// the screen and F again to have it back: the boxes are laid out for the
// window as it is. Escape or closing the window ends the program.
import window
import layout
import layout_window

tag SideBar
tag Cards
tag Note
tag Root
// (Whether F was down the frame before: it is the going down that counts.)
unique WasF: bool
tag Dial
tag Card
// A box that is another colour while the pointer is over it.
component Shade { idle: i32, over: i32 }
default_capacity 256

// A box the program draws itself: a dial, as far round as `data` says
// (of 360), in the box the layout gives it.
proc dial(x: f32, y: f32, w: f32, h: f32, data: i32) {
  let r = min(w, h) * 0.5
  circle(x + w * 0.5, y + h * 0.5, r, 0x2a3640)
  sector(x + w * 0.5, y + h * 0.5, r - 3.0, -90.0, data as f32 - 90.0,
         0x3a7bd5)
  circle(x + w * 0.5, y + h * 0.5, r * 0.45, 0x1c242c)
}

world {
  Window.width = 900
  Window.height = 600
  Window.title = "ent-lang: layout"
  Window.background = 0x101418
  Window.fps = 60
  Window.resizable = true

  // The window: the side bar and the rest, next to each other.
  let root = spawn {
    Box { x: 0.0, y: 0.0, w: 900.0, h: 600.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 12.0, gap: 12.0 }, Fill { colour: 0x101418 },
    Root
  }
  let side = spawn {
    Box { x: 0.0, y: 0.0, w: 180.0, h: 0.0 },
    Size { w: Sizing.Fixed, h: Sizing.Grow },
    Stack { row: false, pad: 10.0, gap: 8.0 }, Fill { colour: 0x1c242c },
    SideBar, Clip { x: true, y: true }, Scroll { x: 0.0, y: 0.0 }, Drag,
    Round { top_left: 10.0, top_right: 10.0, bottom_left: 10.0,
            bottom_right: 10.0 },
    Border { left: 0.0, right: 0.0, top: 0.0, bottom: 0.0, between: 1.0,
             colour: 0x3a4650 }
  }
  let rest = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Grow, h: Sizing.Grow },
    Stack { row: false, pad: 0.0, gap: 12.0 }
  }
  connect (side)-[Inside]->(root)
  connect (rest)-[Inside]->(root)

  // The side bar's entries: as wide as the bar, 34 pixels high, what
  // each says 10 in from its edge and in the middle of its height. More
  // of them than the bar is high: it clips them, and the wheel moves
  // them.
  for i in 0..24 {
    let entry = spawn {
      Box { x: 0.0, y: 0.0, w: 0.0, h: 34.0 },
      Size { w: Sizing.Grow, h: Sizing.Fixed },
      Stack { row: true, pad: 0.0, gap: 0.0 },
      Pad { left: 10.0, right: 10.0, top: 0.0, bottom: 0.0 },
      Align { x: Place.Start, y: Place.Middle },
      Fill { colour: 0x2a3640 }, Shade { idle: 0x2a3640, over: 0x3a7bd5 },
      Transition { seconds: 0.3, ease: ease_out, x: false, y: false,
                   w: false, h: false, fill: true, overlay: true,
                   round: false, border_colour: false,
                   border_width: false, touch: false },
      Text { text: "entry {i + 1}", size: 16.0, colour: 0xd0d8e0 }
    }
    connect (entry)-[Inside]->(side)
    // On every fourth a dot at its right end, which shows only where the
    // entry does: not outside the bar.
    if i % 4 == 3 {
      let dot = spawn {
        Box { x: 0.0, y: 0.0, w: 10.0, h: 10.0 },
        Size { w: Sizing.Fixed, h: Sizing.Fixed },
        Stack { row: true, pad: 0.0, gap: 0.0 }, Fill { colour: 0xe0a030 },
        Round { top_left: 5.0, top_right: 5.0, bottom_left: 5.0,
                bottom_right: 5.0 },
        Float { dx: -10.0, dy: 0.0 },
        Attach { own: Point.MiddleRight, under: Point.MiddleRight },
        Confined, Passthrough
      }
      connect (dot)-[Over]->(entry)
    }
  }

  // A header with its buttons in the middle of its height and at its
  // right end, the cards with the room that is left, a footer.
  let header = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 56.0 },
    Size { w: Sizing.Grow, h: Sizing.Fixed },
    Stack { row: true, pad: 8.0, gap: 8.0 }, Fill { colour: 0x1c242c },
    Align { x: Place.End, y: Place.Middle }
  }
  let cards = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Grow, h: Sizing.Grow },
    Stack { row: true, pad: 0.0, gap: 12.0 }, Cards
  }
  let footer = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Grow, h: Sizing.Fit },
    Stack { row: true, pad: 6.0, gap: 6.0 }, Fill { colour: 0x1c242c },
    Text { text: "right button: side bar   space: stack the cards   enter: a card goes   I, O: inspector", size: 14.0,
           colour: 0x808890 }
  }
  connect (header)-[Inside]->(rest)
  connect (cards)-[Inside]->(rest)
  connect (footer)-[Inside]->(rest)

  // A dial before the buttons, which the program draws.
  let turns = spawn {
    Box { x: 0.0, y: 0.0, w: 36.0, h: 36.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Custom { draw: dial, data: 0 },
    Dial
  }
  connect (turns)-[Inside]->(header)
  // Buttons as big as what they say, and 12 more on either side.
  for i in 0..4 {
    let button = spawn {
      Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
      Size { w: Sizing.Fit, h: Sizing.Fit },
      Stack { row: true, pad: 0.0, gap: 0.0 },
      Pad { left: 12.0, right: 12.0, top: 7.0, bottom: 7.0 },
      Fill { colour: 0x3a7bd5 }, Shade { idle: 0x3a7bd5, over: 0x70c0ff },
      Transition { seconds: 0.2, ease: ease_out, x: false, y: false,
                   w: false, h: false, fill: true, overlay: true,
                   round: false, border_colour: false,
                   border_width: false, touch: false },
      Round { top_left: 8.0, top_right: 8.0, bottom_left: 8.0,
              bottom_right: 8.0 },
      Text { text: if i == 0 { "open" } else if i == 1 { "save as" }
                   else if i == 2 { "undo" } else { "preferences" },
             size: 16.0, colour: 0xffffff }
    }
    connect (button)-[Inside]->(header)
    // On the last one a dot, its middle on the button's top right
    // corner.
    if i == 3 {
      let dot = spawn {
        Box { x: 0.0, y: 0.0, w: 10.0, h: 10.0 },
        Size { w: Sizing.Fixed, h: Sizing.Fixed },
        Stack { row: true, pad: 0.0, gap: 0.0 }, Fill { colour: 0xe05040 },
        Float { dx: 0.0, dy: 0.0 },
        Attach { own: Point.Middle, under: Point.TopRight }, Passthrough
      }
      connect (dot)-[Over]->(button)
    }
  }

  // A note that floats over the window, where the mouse is: as big as
  // the line in it.
  let note = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Fit, h: Sizing.Fit },
    Stack { row: true, pad: 4.0, gap: 0.0 }, Fill { colour: 0xf0e0a0 },
    Float { dx: 0.0, dy: 0.0 }, Note, Passthrough
  }
  let line = spawn {
    Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
    Size { w: Sizing.Fit, h: Sizing.Fit },
    Stack { row: true, pad: 2.0, gap: 0.0 },
    Text { text: "a note that floats", size: 14.0, colour: 0x202020 },
    Passthrough
  }
  connect (note)-[Over]->(root)
  connect (line)-[Inside]->(note)
  // And a mark at the corner of that line: over a box that is inside one
  // that floats.
  let mark = spawn {
    Box { x: 0.0, y: 0.0, w: 8.0, h: 8.0 },
    Size { w: Sizing.Fixed, h: Sizing.Fixed },
    Stack { row: true, pad: 0.0, gap: 0.0 }, Fill { colour: 0xd04030 },
    Float { dx: -6.0, dy: -6.0 }, Passthrough
  }
  connect (mark)-[Over]->(line)

  // Three cards share the width, the middle one never more than 260
  // wide; in each, a picture that is twice as wide as high above a text,
  // which is as high as its lines come to in the width of the card. A
  // card comes up from 60 below, out of the colour of the window, and
  // goes to where it is to be in a quarter of a second or a little
  // more, whenever that is somewhere else.
  for i in 0..3 {
    let card = spawn {
      Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
      Size { w: Sizing.Grow, h: Sizing.Grow },
      Stack { row: false, pad: 10.0, gap: 6.0 }, Fill { colour: 0x242e38 },
      Round { top_left: 12.0, top_right: 12.0, bottom_left: 0.0,
              bottom_right: 0.0 },
      Border { left: 1.0, right: 1.0, top: 3.0, bottom: 1.0, between: 0.0,
               colour: 0x3a7bd5 },
      Limits { min_w: 120.0, max_w: if i == 1 { 260.0 } else { 0.0 },
               min_h: 0.0, max_h: 0.0 },
      Transition { seconds: 0.25 + 0.15 * i as f32, ease: ease_in_out, x: true, y: true,
                   w: true, h: true, fill: true, overlay: true,
                   round: false, border_colour: false,
                   border_width: false, touch: false },
      Enter { dx: 0.0, dy: 60.0, dw: 0.0, dh: 0.0, colour: 0x101418,
              always: true },
      Leave { dx: 0.0, dy: 80.0, dw: 0.0, dh: 0.0, colour: 0x101418,
              order: Exit.Under, follows: false }, Card
    }
    connect (card)-[Inside]->(cards)
    let picture = spawn {
      Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
      Size { w: Sizing.Grow, h: Sizing.Fit },
      Stack { row: true, pad: 0.0, gap: 0.0 }, Aspect { ratio: 2.0 },
      Fill { colour: 0x805030 + i * 0x203040 }
    }
    connect (picture)-[Inside]->(card)
    let text = spawn {
      Box { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
      Size { w: Sizing.Grow, h: Sizing.Fit },
      Stack { row: true, pad: 0.0, gap: 0.0 },
      Text { text: if i == 0 { "A card is as wide as its share of the room, and its text breaks where the card ends." }
                   else if i == 1 { "This one is never more than 260 wide; the others take what is left." }
                   else { "Short.\nTwo lines." },
             size: 16.0, colour: 0xa0b0c0 },
      TextStyle { font: 0, spacing: if i == 1 { 1.0 } else { 0.0 },
                  line: if i == 1 { 22.0 } else { 0.0 },
                  align: if i == 1 { Place.Middle } else { Place.Start },
                  breaks: Breaks.Words }
    }
    connect (text)-[Inside]->(card)
    // And a bar that is half as wide as the card, at its bottom.
    let bar = spawn {
      Box { x: 0.0, y: 0.0, w: 0.0, h: 6.0 },
      Size { w: Sizing.Percent, h: Sizing.Fixed },
      Stack { row: true, pad: 0.0, gap: 0.0 }, Share { w: 0.5, h: 0.0 },
      Fill { colour: 0x3a7bd5 }
    }
    connect (bar)-[Inside]->(card)
  }
}

system interact() {
  // The window's box is as big as the window: another size when the
  // user gives the window one, or when it fills the screen. Everything
  // in it follows from that.
  for b: mut Box with Root
      where b.w != Window.width as f32 || b.h != Window.height as f32 {
    b.w = Window.width as f32
    b.h = Window.height as f32
  }
  let f = key_down('F' as i32)
  if f && !WasF { Window.fullscreen = !Window.fullscreen }
  WasF = f
  for b: mut Box with SideBar where Mouse.right {
    b.w = max(80.0, min(Mouse.x - 12.0, 500.0))
  }
  for k: mut Stack with Cards where k.row == Keys.space {
    k.row = !Keys.space
  }
  // What the pointer is over is lit.
  for e, f: mut Fill, s: Shade {
    f.colour = if e.has(Hovered) { s.over } else { s.idle }
  }
  // The dial goes round, once in six seconds.
  for c: mut Custom with Dial { c.data = (Window.frame % 360) as i32 }
  // A card that is pressed has black laid on it, a third of it.
  for e with Card {
    if e.has(Pressed) != e.has(Overlay) {
      if e.has(Pressed) { e.add(Overlay { colour: 0x55000000 }) }
      else { e.remove(Overlay) }
    }
  }
  // A card that is clicked goes: the others take its room at once, on
  // their way while it is on its.
  for e with Card, Hovered without Gone
      where PointerTouch == Touch.ReleasedNow {
    e.add(Gone)
  }
  // The last card goes.
  for e, b: Box with Card without Gone where Keys.enter && b.x > 600.0 {
    e.add(Gone)
  }
  if key_down('I' as i32) { Inspector.on = true }
  if key_down('O' as i32) { Inspector.on = false }
  // The note, a little off the mouse.
  for o: mut Float with Note
      where o.dx != Mouse.x + 14.0 || o.dy != Mouse.y + 10.0 {
    o.dx = Mouse.x + 14.0
    o.dy = Mouse.y + 10.0
  }
}

schedule frame() {
  begin()
  interact()
  ui()
  present()
}

main {
  loop { frame() } until Window.closed
}

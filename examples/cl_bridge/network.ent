// A simulated "dish": adapting leaky integrate-and-fire neurons on a square, wired
// at random by distance, about one in five inhibitory, with fast and slow
// synaptic currents, short-term depression, trace-based STDP with soft
// bounds and synaptic scaling on the excitatory synapses, background noise,
// and 64 electrodes on an 8 x 8 grid over the same square that record
// spikes and stimulate; a stim excites the neurons whose axons pass near
// the electrode. A simplified model, not a validated model of a biological
// culture: its defaults are fitted to a dozen statistics of recordings of
// cortical cultures (culture/, README.md), nothing more.
//
// The host (bridge.c, or run.ent for the program on its own) sets the
// parameters in `Dish` and runs `create`, then `step` once a millisecond
// of the dish's time: 25 frames at 25 kHz. Each step leaves its spikes on
// the electrodes: an electrode's `count` is how many of the neurons it
// hears (within `hear_reach` of it) fired in that step (a C host reads the
// column; a buffer it could only be handed through an extern proc). A stim
// adds to an electrode's `stim`, which each neuron whose axon passes near
// it takes in, scaled by the distance from the axon, as many steps later
// as a spike takes from there along the axon to the neuron.
//
// Everything is drawn from the seed: where the neurons are, which are
// inhibitory, the synapses, the noise of every neuron at every step (by
// the seed, the step and the neuron's number, so it replays the same). The
// seed says which culture; the parameters which cell line.
//
// `fired` and `trace` are values, not tags (examples/snn.ent says why).

import math

// Of the parameters, the time constants are in steps (milliseconds);
// lengths in units of the square's side.
unique Dish {
  seed: i64,
  neurons: i32,
  inhibitory: f32,   // the share of inhibitory neurons
  tau: f32,          // the membrane's time constant
  thr: f32,          // the threshold; the potential rests at 0, resets to 0
  refractory: f32,   // steps after a spike the neuron does not integrate
  adapt_inc: f32,    // what a spike adds to the neuron's adaptation, which is taken off its potential
  tau_adapt: f32,    // the adaptation's time constant
  density: f32,      // the chance of a synapse between two neurons at no distance
  reach: f32,        // the distance over which that chance falls by e
  reach_cut: f32,    // no synapse is longer than this many reaches
  w_exc: f32,        // an excitatory synapse's weight at the start
  w_inh: f32,        // an inhibitory synapse's weight (fixed)
  w_max: f32,        // an excitatory weight is kept in [0, w_max]
  stdp: bool,        // whether the excitatory weights learn
  a_plus: f32,       // a spike after a presynaptic one strengthens by a_plus * trace * (w_max - w)
  a_minus: f32,      // one before it weakens by a_minus * trace * w
  tau_plus: f32,     // the presynaptic trace's time constant
  tau_minus: f32,    // the postsynaptic trace's
  noise_rate: f32,   // the chance of a kick of noise, a neuron a step
  noise_amp: f32,    // its size
  stim_gain: f32,    // a stim's current into a neuron its axon passes through the electrode, per unit of stim
  stim_reach: f32,   // the distance (electrode to axon) over which that falls by e
  axon: f32,         // the length of a neuron's axon, straight from it in a direction drawn
  conduct: f32,      // how fast a spike runs along an axon (lengths a step): a stim reaches the soma that much later
  depress: f32,      // short-term depression: the share of a neuron's synaptic resources a spike uses (0: none)
  tau_recover: f32,  // the time constant of their recovery
  hear_reach: f32,   // an electrode hears the neurons this near it (of those whose electrode it is)
  tau_syn: f32,      // what came in along the synapses fades with this time constant (0: at once)
  fast: f32,         // and as much again times this acts at once (fast synapses beside the slow)
  home_rate: f32,    // homeostasis: the rate (Hz) a neuron scales its excitatory synapses towards
  tau_home: f32,     // the time constant of the rate it holds against that
  home_gain: f32,    // how fast it scales them (0: not at all), with STDP
  tick: i32,         // the steps run
  spikes: i64,       // the spikes so far
  check: u64         // the checksum, after `checksum`
}

// Per step, worked out from Dish when the dish is made.
unique Decay { v: f32, plus: f32, minus: f32, adapt: f32, recover: f32, syn: f32, home: f32 }

component Neuron {
  v: f32, input: f32, fired: f32,
  sign: f32,         // 1 excitatory, -1 inhibitory
  out: f32,          // what a synapse from it carries: fired times sign
  trace: f32,        // the presynaptic trace (STDP)
  post: f32,         // the postsynaptic trace (STDP)
  rest: f32,         // steps of refractoriness left
  adapt: f32,        // the adaptation: what each spike leaves, fading
  rate: f32,         // its firing rate (spikes a step), averaged over tau_home
  syn: f32,          // the synaptic current: what came in, fading with tau_syn
  ready: f32,        // its synaptic resources, from 0 to 1: what a spike of it carries
  heard: f32,        // 1 where its electrode hears it, else 0
  number: i32, channel: i32, pad: entity
}
// Where a neuron is: x and y from 0 to 1.
component Spot { x: f32, y: f32 } capacity 65536
// Where a neuron's synapses are listed in Wires, while the dish is made.
component Out { first: i32, count: i32 }
// The four electrodes nearest a neuron's axon and how much of their stims
// it takes (a stim excites the neurons whose axons pass near it, not only
// those beside it).
component Takes {
  a: entity, b: entity, c: entity, d: entity,
  ga: f32, gb: f32, gc: f32, gd: f32,
  da: f32, db: f32, dc: f32, dd: f32,  // the steps from each to the soma
  pending: f32,                        // what is on its way to the soma
  due: f32                             // the steps until it is there
}
component Electrode { channel: i32, x: f32, y: f32, stim: f32, count: i32 }
archetype Cell { Neuron, Spot, Out, Takes } capacity 65536
archetype Pad { Electrode } capacity 64

// plastic: 1 where the source is excitatory (the weight learns), else 0.
relation (Neuron)-[Synapse { weight: f32, plastic: f32 }]->(Neuron) capacity 8388608

buffer Pads { who: entity } capacity 64
buffer Wires { to: entity } capacity 8388608
unique Wired { rows: i32 }

// The neurons by where they are, for wiring each to those near it.
index Near of Spot grid (x, y) cell Dish.reach * Dish.reach_cut {
  number: Neuron.number
}

world {
  Dish.seed = 1
  Dish.neurons = 1024
  Dish.inhibitory = 0.2
  Dish.tau = 20.0
  Dish.thr = 1.0
  Dish.refractory = 2.0
  Dish.adapt_inc = 0.0682
  Dish.tau_adapt = 66.8
  Dish.density = 0.3
  Dish.reach = 0.2
  Dish.reach_cut = 8.0
  Dish.w_exc = 0.00194
  Dish.w_inh = 0.0295
  Dish.w_max = 0.00605
  Dish.stdp = true
  Dish.a_plus = 0.002
  Dish.a_minus = 0.002
  Dish.tau_plus = 20.0
  Dish.tau_minus = 20.0
  Dish.noise_rate = 0.00532
  Dish.noise_amp = 0.51
  Dish.stim_gain = 8.16
  Dish.stim_reach = 0.0646
  Dish.axon = 0.274
  Dish.conduct = 0.0552
  Dish.depress = 0.231
  Dish.tau_recover = 1070.0
  Dish.hear_reach = 0.03
  Dish.tau_syn = 270.0
  Dish.fast = 47.8
  Dish.home_rate = 1.33
  Dish.tau_home = 60000.0
  Dish.home_gain = 0.0859
}

// SplitMix64's mix: whole-number multiplies that keep the low bits, so a
// loop that draws with it can work on several neurons at once (wyhash's
// 128-bit multiply cannot; devices/wyhash.ent).
fn mix(x: u64) -> u64 {
  var z = x + 0x9e3779b97f4a7c15
  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
  z = (z ^ (z >> 27)) * 0x94d049bb133111eb
  z ^ (z >> 31)
}

// The n-th number of a key, from 0 to below 1.
fn draw(key: u64, n: i64) -> f32 {
  ((mix(key + (n as u64) * 0xd1342543de82ef95) >> 40) as f32) / 16777216.0
}

system make() {
  let key = mix(Dish.seed as u64)
  let axons = mix(key ^ 0xa705)
  Decay.v = exp(-1.0 / Dish.tau)
  Decay.plus = exp(-1.0 / Dish.tau_plus)
  Decay.minus = exp(-1.0 / Dish.tau_minus)
  Decay.adapt = exp(-1.0 / Dish.tau_adapt)
  Decay.recover = 1.0 - exp(-1.0 / Dish.tau_recover)
  Decay.home = exp(-1.0 / Dish.tau_home)
  Decay.syn = if Dish.tau_syn > 0.0 { exp(-1.0 / Dish.tau_syn) } else { 0.0 }
  Pads = []
  for c in 0..64 {
    let x = ((c % 8) as f32 + 0.5) / 8.0
    let y = ((c / 8) as f32 + 0.5) / 8.0
    let p = spawn { Electrode { channel: c, x: x, y: y, stim: 0.0, count: 0 } }
    Pads += { who: p }
  }
  for i in 0..Dish.neurons {
    let x = draw(key, (i * 3) as i64)
    let y = draw(key, (i * 3 + 1) as i64)
    let inhibitory = draw(key, (i * 3 + 2) as i64) < Dish.inhibitory
    let col = min((x * 8.0) as i32, 7)
    let row = min((y * 8.0) as i32, 7)
    let c = row * 8 + col
    let dx = x - ((col as f32) + 0.5) / 8.0
    let dy = y - ((row as f32) + 0.5) / 8.0
    let d = sqrt(dx * dx + dy * dy)
    // The axon, and the four electrodes nearest it, nearest first.
    let angle = 6.2831855 * draw(axons, i as i64)
    let ax = Dish.axon * cos(angle)
    let ay = Dish.axon * sin(angle)
    var d0 = 9.0
    var d1 = 9.0
    var d2 = 9.0
    var d3 = 9.0
    var c0 = 0
    var l0 = 0.0
    var c1 = 0
    var l1 = 0.0
    var c2 = 0
    var l2 = 0.0
    var c3 = 0
    var l3 = 0.0
    for e in 0..64 {
      let ex = ((e % 8) as f32 + 0.5) / 8.0 - x
      let ey = ((e / 8) as f32 + 0.5) / 8.0 - y
      let along = if Dish.axon > 0.0 { clamp((ex * ax + ey * ay) / (Dish.axon * Dish.axon), 0.0, 1.0) } else { 0.0 }
      let fx = ex - along * ax
      let fy = ey - along * ay
      let de = sqrt(fx * fx + fy * fy)
      let le = along * Dish.axon
      if de < d0 {
        d3 = d2
        c3 = c2
        l3 = l2
        d2 = d1
        c2 = c1
        l2 = l1
        d1 = d0
        c1 = c0
        l1 = l0
        d0 = de
        c0 = e
        l0 = le
      } else if de < d1 {
        d3 = d2
        c3 = c2
        l3 = l2
        d2 = d1
        c2 = c1
        l2 = l1
        d1 = de
        c1 = e
        l1 = le
      } else if de < d2 {
        d3 = d2
        c3 = c2
        l3 = l2
        d2 = de
        c2 = e
        l2 = le
      } else if de < d3 {
        d3 = de
        c3 = e
        l3 = le
      }
    }
    spawn {
      Neuron { v: 0.0, input: 0.0, fired: 0.0, sign: if inhibitory { -1.0 } else { 1.0 }, out: 0.0,
               trace: 0.0, post: 0.0, rest: 0.0, adapt: 0.0, rate: Dish.home_rate / 1000.0, syn: 0.0, ready: 1.0,
               heard: if d <= Dish.hear_reach { 1.0 } else { 0.0 },
               number: i, channel: c, pad: Pads[c].who },
      Spot { x: x, y: y },
      Out { first: 0, count: 0 },
      Takes { a: Pads[c0].who, b: Pads[c1].who, c: Pads[c2].who, d: Pads[c3].who,
              ga: exp(-d0 / Dish.stim_reach), gb: exp(-d1 / Dish.stim_reach),
              gc: exp(-d2 / Dish.stim_reach), gd: exp(-d3 / Dish.stim_reach),
              da: floor(l0 / Dish.conduct), db: floor(l1 / Dish.conduct),
              dc: floor(l2 / Dish.conduct), dd: floor(l3 / Dish.conduct),
              pending: 0.0, due: 0.0 }
    }
  }
  Dish.tick = 0
  Dish.spikes = 0
}

// Synapses: from i to j with the chance density * e^(-distance / reach),
// none longer than reach_cut reaches; each neuron's found among those
// near it (the grid Near), not among all. The draw of a pair is by the
// numbers of both, so they are the synapses a loop over all pairs gives,
// and a neuron reads its own in the order of their sources. (A `for`
// through the grid only reads: each neuron counts its synapses, has its
// part of Wires by a running sum, lists their targets there, and is
// connected to them after.)
fn wired(wiring: u64, density: f32, reach: f32, i: i32, j: i32, dx: f32, dy: f32) -> bool {
  // (The chance is never more than density: a draw that is not below it
  // needs no exp.)
  let u = draw(wiring, (i as i64) * 65536 + (j as i64))
  if u >= density { false } else { u < density * exp(-sqrt(dx * dx + dy * dy) / reach) }
}

system count_wires() {
  let cut = Dish.reach * Dish.reach_cut
  let wiring = mix(mix(Dish.seed as u64) ^ 0x5157)
  for me, n: Neuron, p: Spot, w: mut Out {
    var k: i32 = 0
    for o, q: Spot, m: Neuron near (p.x, p.y) within cut in Near where o != me {
      if wired(wiring, Dish.density, Dish.reach, n.number, m.number, p.x - q.x, p.y - q.y) { k += 1 }
    }
    w.count = k
  }
}

system place_wires() {
  Wired.rows = 0
  for w: mut Out {
    let first = Wired.rows += w.count
    w.first = first
  }
  Wires = [{ to: none }; Wired.rows]
}

system fill_wires() {
  let cut = Dish.reach * Dish.reach_cut
  let wiring = mix(mix(Dish.seed as u64) ^ 0x5157)
  for me, n: Neuron, p: Spot, w: Out, list: mut Wires[w.first, w.count] {
    var k: i32 = 0
    for o, q: Spot, m: Neuron near (p.x, p.y) within cut in Near where o != me {
      if wired(wiring, Dish.density, Dish.reach, n.number, m.number, p.x - q.x, p.y - q.y) {
        list[k].to = o
        k += 1
      }
    }
  }
}

system wire() {
  for me, n: Neuron, w: Out, list: Wires[w.first, w.count] {
    for k in 0..w.count {
      if n.sign < 0.0 {
        connect (me)-[Synapse { weight: Dish.w_inh, plastic: 0.0 }]->(list[k].to)
      } else {
        connect (me)-[Synapse { weight: Dish.w_exc, plastic: 1.0 }]->(list[k].to)
      }
    }
  }
  Wires = []
}

// What came in along the synapses (the spikes of the step before), the
// noise of this step, and the stim of the neuron's electrode.
gpu system gather() {
  let key = mix(mix(Dish.seed as u64) ^ (Dish.tick as u64))
  for e, n: mut Neuron, t: mut Takes {
    var sum = 0.0
    for (pre)-[s: Synapse]->(e) {
      if let o = Neuron(pre).out { sum += s.weight * o }
    }
    let kick = if draw(key, n.number as i64) < Dish.noise_rate { Dish.noise_amp } else { 0.0 }
    // A stim runs along the axon to the soma: what is there by now, and
    // what a stim of this step sends (the last stim's delay for all of it).
    var stim = 0.0
    if t.due > 0.0 {
      t.due -= 1.0
      if t.due <= 0.0 {
        stim = t.pending
        t.pending = 0.0
      }
    }
    if let s = Electrode(t.a).stim {
      if s != 0.0 {
        t.pending += s * t.ga
        t.due = t.da
      }
    }
    if let s = Electrode(t.b).stim {
      if s != 0.0 {
        t.pending += s * t.gb
        t.due = t.db
      }
    }
    if let s = Electrode(t.c).stim {
      if s != 0.0 {
        t.pending += s * t.gc
        t.due = t.dc
      }
    }
    if let s = Electrode(t.d).stim {
      if s != 0.0 {
        t.pending += s * t.gd
        t.due = t.dd
      }
    }
    if t.due <= 0.0 {
      stim += t.pending
      t.pending = 0.0
    }
    // (With tau_syn 0, what came in this step alone.)
    n.syn = Decay.syn * n.syn + sum
    n.input = n.syn + Dish.fast * sum + kick + stim * Dish.stim_gain
  }
}

gpu system integrate() {
  for n: mut Neuron {
    var v = Decay.v * n.v + n.input - n.adapt
    var fired = 0.0
    if n.rest > 0.0 {
      n.rest -= 1.0
      v = 0.0
    } else if v >= Dish.thr {
      fired = 1.0
      v = 0.0
      n.rest = Dish.refractory
      if n.heard > 0.0 { Electrode(n.pad).count += 1 }
      Dish.spikes += 1
    }
    n.v = v
    n.fired = fired
    n.adapt = Decay.adapt * n.adapt + Dish.adapt_inc * fired
    // (What it carries is what is ready; a spike uses `depress` of it,
    // which recovers.)
    n.out = n.sign * fired * n.ready
    n.ready = n.ready + (1.0 - n.ready) * Decay.recover - Dish.depress * n.ready * fired
    n.trace = Decay.plus * n.trace + fired
    n.rate = Decay.home * n.rate + (1.0 - Decay.home) * fired
    n.post = Decay.minus * n.post + fired
  }
}

// Trace STDP with soft bounds (van Rossum, Bi and Turrigiano 2000), pull
// form: each neuron changes only the synapses into it. A spike of the
// neuron strengthens each excitatory synapse by a_plus times the source's
// trace times what is left to w_max; a spike of the source weakens it by
// a_minus times the neuron's own trace times the weight. So the weights
// settle where the two balance (w_max / 2 where they are alike and as
// often), not at 0 or w_max, which in a dish that bursts, where both come
// about as often, additive STDP went to one or the other. And synaptic
// scaling (Turrigiano): each excitatory synapse into a neuron grows by
// home_gain times the neuron's rate short of home_rate, times its weight
// (shrinks, where the rate is above): STDP alone, even with soft bounds,
// set the calibrated dish alight or quiet (examples/cl_bridge/culture).
gpu system stdp() {
  for e, n: Neuron {
    let scale = Dish.home_gain * (Dish.home_rate / 1000.0 - n.rate)
    for (pre)-[mut s: Synapse]->(e) {
      if let t = Neuron(pre).trace, let f = Neuron(pre).fired {
        let dw = Dish.a_plus * t * n.fired * (Dish.w_max - s.weight)
            - Dish.a_minus * n.post * f * s.weight + scale * s.weight
        s.weight = min(max(s.weight + s.plastic * dw, 0.0), Dish.w_max)
      }
    }
  }
}

// Each step starts with no spikes on the electrodes.
gpu system begin() {
  for p: mut Electrode { p.count = 0 }
}

gpu system done() {
  for p: mut Electrode { p.stim = 0.0 }
  Dish.tick += 1
}

// A number of all potentials and weights: each neuron's v and its
// synapses' weights mixed with its number, summed (so in any order).
unique Hashes { sum: u64, synapses: i64 }

system zero() {
  Hashes.sum = 0
  Hashes.synapses = 0
}

system sum_up() {
  for e, n: Neuron {
    var h = mix((n.number as u64) ^ (bits_of(n.v) as u64))
    var count = 0
    for (pre)-[s: Synapse]->(e) {
      h = mix(h ^ (bits_of(s.weight) as u64))
      count += 1
    }
    Hashes.synapses += count
    Hashes.sum += h
  }
  Dish.check = Hashes.sum
}

schedule create() {
  make()
  count_wires()
  place_wires()
  fill_wires()
  wire()
}

schedule step() {
  begin()
  gather()
  integrate()
  stdp() run_if Dish.stdp
  done()
}

schedule checksum() {
  zero()
  sum_up()
}

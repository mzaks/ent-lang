// Atoms that pull and push each other by the Lennard-Jones potential, in
// a box that wraps on every side, as LAMMPS's "LJ melt" has them: an fcc
// lattice of `4 cells^3` atoms at a density, given velocities at random
// for a temperature, and moved by velocity Verlet (in LJ units: mass,
// σ and ε 1).
//
// As LAMMPS does, every atom keeps a list of the atoms within `cut` and
// a `skin` of it, made every `every` steps through the grid index
// `Cells`. Every step each atom goes through its list and takes the
// force of the pairs within the cut. And as LAMMPS does, the atoms are
// put back in the box only where the lists are made: between, a pair
// that was apart within the box stays so (no atom moves half the skin),
// and is seen as it is; only a pair whose other atom was seen across the
// side of the box, in a list of its own (`Crossing`), is seen as the
// image of the other nearest. With `half`, its list has only the
// atoms after it in the index (`after me`), each pair once, and it gives
// the other the opposite force (to its `Pull`, combined in the order of the
// atoms that give it, so the sums are the same however many threads
// there are); else every atom has all of its own, each pair twice, and
// gives nothing. Half the pairs, on one core; on many threads giving to
// others costs more than the pairs.
//
//   U(r) = 4 (r^-12 - r^-6)        for r within `cut`, else nothing
//
// What LAMMPS says of a step comes of `sums()`: the temperature (of
// 3N - 3 degrees of freedom), the potential energy an atom, the total
// energy an atom and the pressure.

import wyhash

unique Melt { seed: u64, density: f64, cells: i64, temperature: f64,
              cut: f64, skin: f64, every: i64, half: bool, dt: f64,
              size: f64, atoms: i64, step: i64 }

// The sums of a step: momentum, twice the kinetic energy, the potential
// energy, the virial, and the pairs within the cut (each twice, of full
// lists).
unique Sums { px: f64, py: f64, pz: f64, vv: f64, pe: f64, w: f64, pairs: i64 }

component Atom { x: f64, y: f64, z: f64, number: i64 } capacity 32768
component Velocity { vx: f64, vy: f64, vz: f64 } capacity 32768
// The force on an atom of the pairs in its list, their potential energy
// and virial, and how many of them are within the cut; and the force it
// is given by the atoms whose lists it is in.
component Force { fx: f64, fy: f64, fz: f64, e: f64, w: f64, pairs: i64 }
          capacity 32768
component Pull { fx: f64, fy: f64, fz: f64 } capacity 32768
// Where its list starts in `Pairs`, and how long it is; and those of
// its pairs across the side of the box, in `Crossing`.
component List { first: i32, count: i32 } capacity 32768
component Across { first: i32, count: i32 } capacity 32768

// The lists, one after another.
buffer Pairs { other: entity } capacity 4194304
buffer Crossing { other: entity } capacity 1048576
unique Lists { rows: i32, crossing: i32 }

index Cells of Atom grid (x, y, z) cell Melt.cut + Melt.skin wrap Melt.size {
  number: Atom.number
}

// Where `x` is seen from `p` in the box: its image nearest it.
fn image(x: f64, p: f64, size: f64) -> f64 {
  let d = x - p
  let shift = if d > size * 0.5 { size } else if d < 0.0 - size * 0.5 { 0.0 - size } else { 0.0 }
  x - shift
}

// v^(1/3), by Newton's steps from 1 (the same steps in check/melt.c).
fn cube_root(v: f64) -> f64 {
  var y: f64 = 1.0
  for i in 0..60 { y = y - (y * y * y - v) / (3.0 * y * y) }
  y
}

// The lattice: `cells` unit cells on each side, four atoms in each, and
// every atom a velocity at random, each part from -0.5 to 0.5.
system lattice() {
  let a = cube_root(4.0 / Melt.density)
  let k = Melt.cells
  Melt.size = a * k as f64
  let key = wyhash64(Melt.seed, 1)
  for i in 0..k {
    for j in 0..k {
      for l in 0..k {
        for b in 0..4 {
          var bx: f64 = 0.0
          var by: f64 = 0.0
          var bz: f64 = 0.0
          if b == 1 || b == 2 { bx = 0.5 }
          if b == 1 || b == 3 { by = 0.5 }
          if b == 2 || b == 3 { bz = 0.5 }
          let n = Melt.atoms
          spawn { Atom { x: (i as f64 + bx) * a, y: (j as f64 + by) * a,
                         z: (l as f64 + bz) * a, number: n },
                  Velocity { vx: wyrand_unit(key, 3 * n) - 0.5,
                             vy: wyrand_unit(key, 3 * n + 1) - 0.5,
                             vz: wyrand_unit(key, 3 * n + 2) - 0.5 },
                  Force { fx: 0.0, fy: 0.0, fz: 0.0, e: 0.0, w: 0.0, pairs: 0 },
                  Pull { fx: 0.0, fy: 0.0, fz: 0.0 }, List { first: 0, count: 0 },
                  Across { first: 0, count: 0 } }
          Melt.atoms += 1
        }
      }
    }
  }
}

// No momentum: the mean velocity taken away.
system momentum() {
  Sums.px = 0.0
  Sums.py = 0.0
  Sums.pz = 0.0
  for v: Velocity {
    Sums.px += v.vx
    Sums.py += v.vy
    Sums.pz += v.vz
  }
}

system still() {
  let n = Melt.atoms as f64
  let mx = Sums.px / n
  let my = Sums.py / n
  let mz = Sums.pz / n
  for v: mut Velocity {
    v.vx -= mx
    v.vy -= my
    v.vz -= mz
  }
}

// The temperature asked for: every velocity scaled by one number.
system squares() {
  Sums.vv = 0.0
  for v: Velocity { Sums.vv += v.vx * v.vx + v.vy * v.vy + v.vz * v.vz }
}

system scale() {
  let dof = (3 * Melt.atoms - 3) as f64
  let by = sqrt(Melt.temperature / (Sums.vv / dof))
  for v: mut Velocity {
    v.vx *= by
    v.vy *= by
    v.vz *= by
  }
}

// The atoms back in the box, before the lists are made.
system wrap() {
  let size = Melt.size
  for a: mut Atom {
    if a.x >= size { a.x -= size }
    if a.x < 0.0 { a.x += size }
    if a.y >= size { a.y -= size }
    if a.y < 0.0 { a.y += size }
    if a.z >= size { a.z -= size }
    if a.z < 0.0 { a.z += size }
  }
}

// Whether a place an atom is seen at is across the side of the box (or
// on it): the image of an atom in it, not the atom.
fn across(x: f64, y: f64, z: f64, size: f64) -> bool {
  x <= 0.0 || x >= size || y <= 0.0 || y >= size || z <= 0.0 || z >= size
}

// The lists: each atom's count of the atoms within the cut and the skin
// (of a half list: those after it in the index, so each pair once), of
// those seen within the box and of those across its side; where each
// list starts; and each list filled, in the order the index finds them.
system count_pairs() {
  let reach = Melt.cut + Melt.skin
  let size = Melt.size
  for me, a: Atom, l: mut List, x: mut Across {
    var n: i32 = 0
    var c: i32 = 0
    if Melt.half {
      for o, b: Atom near (a.x, a.y, a.z) within reach in Cells after me {
        if across(b.x, b.y, b.z, size) { c += 1 } else { n += 1 }
      }
    } else {
      for o, b: Atom near (a.x, a.y, a.z) within reach in Cells
          where o != me {
        if across(b.x, b.y, b.z, size) { c += 1 } else { n += 1 }
      }
    }
    l.count = n
    x.count = c
  }
}

system place_pairs() {
  Lists.rows = 0
  Lists.crossing = 0
  for l: mut List, x: mut Across {
    let first = Lists.rows += l.count
    l.first = first
    let start = Lists.crossing += x.count
    x.first = start
  }
  Pairs = [{ other: none }; Lists.rows]
  Crossing = [{ other: none }; Lists.crossing]
}

system fill_pairs() {
  let reach = Melt.cut + Melt.skin
  let size = Melt.size
  for me, a: Atom, l: List, x: Across, w: mut Pairs[l.first, l.count],
      c: mut Crossing[x.first, x.count] {
    var k: i32 = 0
    var j: i32 = 0
    if Melt.half {
      for o, b: Atom near (a.x, a.y, a.z) within reach in Cells after me {
        if across(b.x, b.y, b.z, size) {
          c[j].other = o
          j += 1
        } else {
          w[k].other = o
          k += 1
        }
      }
    } else {
      for o, b: Atom near (a.x, a.y, a.z) within reach in Cells
          where o != me {
        if across(b.x, b.y, b.z, size) {
          c[j].other = o
          j += 1
        } else {
          w[k].other = o
          k += 1
        }
      }
    }
  }
}

// Every atom's force of the pairs in its lists within the cut, as seen
// from it: the other where it is, then of those across the side of the
// box, the image of the other nearest it; and the opposite given to the
// other.
system forces_half() {
  let cut2 = Melt.cut * Melt.cut
  let size = Melt.size
  for p: mut Pull {
    p.fx = 0.0
    p.fy = 0.0
    p.fz = 0.0
  }
  for a: Atom, l: List, x: Across, list: Pairs[l.first, l.count],
      across: Crossing[x.first, x.count], f: mut Force {
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    var fz: f64 = 0.0
    var e: f64 = 0.0
    var w: f64 = 0.0
    var pairs: i64 = 0
    for k in 0..len(list) {
      let o = list[k].other
      if let bx = Atom(o).x, let by = Atom(o).y, let bz = Atom(o).z {
        let dx = bx - a.x
        let dy = by - a.y
        let dz = bz - a.z
        let r2 = dx * dx + dy * dy + dz * dz
        if r2 <= cut2 {
          let r2i = 1.0 / r2
          let r6i = r2i * r2i * r2i
          let pair = 48.0 * r6i * (r6i - 0.5) * r2i
          fx -= dx * pair
          fy -= dy * pair
          fz -= dz * pair
          Pull(o).fx += dx * pair
          Pull(o).fy += dy * pair
          Pull(o).fz += dz * pair
          e += 4.0 * r6i * (r6i - 1.0)
          w += pair * r2
          pairs += 1
        }
      }
    }
    for k in 0..len(across) {
      let o = across[k].other
      if let bx = Atom(o).x, let by = Atom(o).y, let bz = Atom(o).z {
        let dx = image(bx, a.x, size) - a.x
        let dy = image(by, a.y, size) - a.y
        let dz = image(bz, a.z, size) - a.z
        let r2 = dx * dx + dy * dy + dz * dz
        if r2 <= cut2 {
          let r2i = 1.0 / r2
          let r6i = r2i * r2i * r2i
          let pair = 48.0 * r6i * (r6i - 0.5) * r2i
          fx -= dx * pair
          fy -= dy * pair
          fz -= dz * pair
          Pull(o).fx += dx * pair
          Pull(o).fy += dy * pair
          Pull(o).fz += dz * pair
          e += 4.0 * r6i * (r6i - 1.0)
          w += pair * r2
          pairs += 1
        }
      }
    }
    f.fx = fx
    f.fy = fy
    f.fz = fz
    f.e = e
    f.w = w
    f.pairs = pairs
  }
}

// The same of full lists: an atom's own force alone, and a half of the
// energy and virial of each pair (whose other atom has the other half).
system forces_full() {
  let cut2 = Melt.cut * Melt.cut
  let size = Melt.size
  for a: Atom, l: List, x: Across, list: Pairs[l.first, l.count],
      across: Crossing[x.first, x.count], f: mut Force {
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    var fz: f64 = 0.0
    var e: f64 = 0.0
    var w: f64 = 0.0
    var pairs: i64 = 0
    for k in 0..len(list) {
      let o = list[k].other
      if let bx = Atom(o).x, let by = Atom(o).y, let bz = Atom(o).z {
        let dx = bx - a.x
        let dy = by - a.y
        let dz = bz - a.z
        let r2 = dx * dx + dy * dy + dz * dz
        if r2 <= cut2 {
          let r2i = 1.0 / r2
          let r6i = r2i * r2i * r2i
          let pair = 48.0 * r6i * (r6i - 0.5) * r2i
          fx -= dx * pair
          fy -= dy * pair
          fz -= dz * pair
          e += 2.0 * r6i * (r6i - 1.0)
          w += 0.5 * pair * r2
          pairs += 1
        }
      }
    }
    for k in 0..len(across) {
      let o = across[k].other
      if let bx = Atom(o).x, let by = Atom(o).y, let bz = Atom(o).z {
        let dx = image(bx, a.x, size) - a.x
        let dy = image(by, a.y, size) - a.y
        let dz = image(bz, a.z, size) - a.z
        let r2 = dx * dx + dy * dy + dz * dz
        if r2 <= cut2 {
          let r2i = 1.0 / r2
          let r6i = r2i * r2i * r2i
          let pair = 48.0 * r6i * (r6i - 0.5) * r2i
          fx -= dx * pair
          fy -= dy * pair
          fz -= dz * pair
          e += 2.0 * r6i * (r6i - 1.0)
          w += 0.5 * pair * r2
          pairs += 1
        }
      }
    }
    f.fx = fx
    f.fy = fy
    f.fz = fz
    f.e = e
    f.w = w
    f.pairs = pairs
  }
}

// Half a step's kick, and a step's drift (out of the box, maybe, until
// the atoms are put back in it).
system kick_drift() {
  let dt = Melt.dt
  for a: mut Atom, v: mut Velocity, f: Force, p: Pull {
    v.vx += 0.5 * dt * (f.fx + p.fx)
    v.vy += 0.5 * dt * (f.fy + p.fy)
    v.vz += 0.5 * dt * (f.fz + p.fz)
    a.x += dt * v.vx
    a.y += dt * v.vy
    a.z += dt * v.vz
  }
}

system kick() {
  let dt = Melt.dt
  for v: mut Velocity, f: Force, p: Pull {
    v.vx += 0.5 * dt * (f.fx + p.fx)
    v.vy += 0.5 * dt * (f.fy + p.fy)
    v.vz += 0.5 * dt * (f.fz + p.fz)
  }
  Melt.step += 1
}

system sums() {
  Sums.vv = 0.0
  Sums.pe = 0.0
  Sums.w = 0.0
  Sums.pairs = 0
  for v: Velocity, f: Force {
    Sums.vv += v.vx * v.vx + v.vy * v.vy + v.vz * v.vz
    Sums.pe += f.e
    Sums.w += f.w
    Sums.pairs += f.pairs
  }
}

// Temperature, potential and total energy an atom, pressure.
fn temperature(vv: f64, atoms: i64) -> f64 { vv / (3 * atoms - 3) as f64 }
fn pressure(vv: f64, w: f64, size: f64) -> f64 {
  (vv + w) / (3.0 * size * size * size)
}
// The total energy as if the potential were shifted to 0 at the cut,
// which velocity Verlet keeps (a pair that crosses the cut changes the
// energy above by U(cut)).
fn shifted(total: f64, pairs: i64, half: bool, atoms: i64, cut: f64) -> f64 {
  let c2i = 1.0 / (cut * cut)
  let c6i = c2i * c2i * c2i
  let each = if half { 1.0 as f64 } else { 0.5 as f64 }
  total - each * pairs as f64 * 4.0 * c6i * (c6i - 1.0) / atoms as f64
}

schedule setup() {
  lattice()
  momentum()
  still()
  squares()
  scale()
  count_pairs()
  place_pairs()
  fill_pairs()
  forces_half() run_if Melt.half
  forces_full() run_if !Melt.half
  sums()
}

// A step; where the step it comes to is one of every `every`, the atoms
// put back in the box and the lists made again first.
schedule step() {
  kick_drift()
  wrap() run_if (Melt.step + 1) % Melt.every == 0
  count_pairs() run_if (Melt.step + 1) % Melt.every == 0
  place_pairs() run_if (Melt.step + 1) % Melt.every == 0
  fill_pairs() run_if (Melt.step + 1) % Melt.every == 0
  forces_half() run_if Melt.half
  forces_full() run_if !Melt.half
  kick()
}

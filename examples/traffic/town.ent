// Streets that meet, and cars that find their way through, in one of five
// scenes (`Sim.scene`):
//
//   0. Traffic lights where streets of two lanes each way cross: north
//      and south go, then east and west; a car that turns left waits for
//      a gap in the cars that come the other way.
//   1. A roundabout: the cars that go in give way to the cars in it.
//   2. A priority road, two lanes each way: east and west go first, and
//      north and south wait for a gap of five seconds in it.
//   3. A stop at every street: each car stops, and the first to stop goes
//      first.
//   4. A highway of two lanes and an on-ramp: the cars from the ramp drive
//      on a lane of their own beside the highway, which ends, and change
//      into the highway where there is a gap before it does.
//
// junctions.ent shows them in a window; test/Integration/traffic_town.test
// runs them without one.
//
// A street is made of roads of one lane: a curve (from one point to
// another, bent toward a third) on which a car is somewhere from its
// start. A car drives a route, roads one after another, by the
// intelligent driver model (Treiber, Hennecke and Helbing, 2000) behind
// the car ahead on it, which may be on the next road or the one after;
// where two roads join, behind a car that goes onto the same road from
// the other and is nearer to where they meet, and where a road splits,
// behind a car that went the other way and is not yet clear of it.
// Where a road ends at a junction the car asks whether it may go on: the
// light, the stop, room on the road after the junction, and the paths
// through the junction that its own crosses or joins, which are worked
// out from where the curves go. It gives way where a car on such a path
// would come within its gap of time, or is on it, and stops at the line
// until it may go.
//
// The lanes of a street are roads side by side. A car changes to the
// lane beside it by MOBIL (Kesting, Treiber and Helbing, 2007), as in
// lanes.ent: where it would speed up there by more than it does here,
// counting what the car that would be behind it loses at a fifth of its
// worth, with a little for keeping right, and only where that car need not
// brake harder than 4 m/s². A route is a road for each lane it may take,
// so a car changes only to a lane from which a route goes on to where it
// goes: a car that turns left does not go into the lane for turning
// right. A lane that ends (`-2` after it in a route) is one to leave:
// there a car changes wherever it safely can, and stops at the end where
// it cannot.
import math
import wyhash

const PI: f32 = 3.14159265
const HALF: f32 = 1.8
const FAR: f32 = 118.0
const LIMIT: f32 = 13.9
const HIGHWAY: f32 = 33.3
const ASPHALT: i32 = 0x3a3f46

const LIGHTS: i32 = 0
const ROUNDABOUT: i32 = 1
const PRIORITY: i32 = 2
const STOP: i32 = 3
const RAMP: i32 = 4
const EXIT: i32 = 5
const ROUND2: i32 = 6

// The step (seconds), the time and the steps so far; the seed of the
// draws and how many cars came and went; the scene to lay (`built` is the
// one laid, plus 1: 0 for none yet), and the cars an hour that come in on
// each street (on the highway six times as many, on the ramp 1.2 times).
// `overlaps`: in how many steps a car stood no further behind the car
// ahead than nought (none, it is to be hoped); `changes`: how often a car
// changed lanes.
unique Sim { dt: f32, time: f32, steps: i64, seed: u64, born: i64, gone: i64, scene: i32,
             built: i32, inflow: f32, overlaps: i64, changes: i64 }

// A road: a lane on a curve from (x0, y0) to (x1, y1) bent toward (cx,
// cy), how long it is and how fast one may go on it. At its end: the
// group of the light (none: -1), and whether every car stops there.
buffer Roads { x0: f32, y0: f32, cx: f32, cy: f32, x1: f32, y1: f32, length: f32,
               limit: f32, light: i32, stop: bool } capacity 64

// How a road lies among the others, a row each: the lanes beside it on
// the left and on the right (none: -1); the rows of `Conflicts` of the
// paths that a car going onto it gives way to; the rows of `Feeds` of the
// roads that lead onto it, and of `Splits` of those that go on from it;
// whether it is a lane that ends; the rows of `Crossings` of the roads
// that cross it whose cars give way to its own; and whether its cars,
// which cross other lanes on it, go first where it joins another road
// (that they may not stand across those lanes).
buffer Ties { left: i32, right: i32, first: i32, conflicts: i32, feed: i32, feeds: i32,
              split: i32, splits: i32, ends: bool, cross: i32, crosses: i32,
              bold: bool } capacity 64

// What is on a road every step, a row each: how many cars (and those let
// go onto it), how soon the first comes to its end (seconds) and how near
// one is to it (metres), how soon one comes onto it, how much room is
// free at its start (to the back of its last car), since when one has
// stood at its line (-1: none), and whether the car nearest its end goes
// on (it was let go, or it does not wait).
buffer Load { cars: i32, soonest: f32, nearest: f32, coming: f32, room: f32, since: f32,
              going: bool } capacity 64

// The roads through a crossing, while it is laid: from which street's
// road in, turning which way (1 right, 2 straight on, 3 left), and onto
// which road out.
buffer Turns { road: i32, arm: i32, turn: i32, from: i32, to: i32 } capacity 32

// What a car going onto a road gives way to: no car on `guard` (none:
// -1) that is not yet `upto` metres along it, and as `kind` says: 0 nothing more, 1 no car coming onto `guard`
// within `gap` seconds (where there is no guard: to the end of `road`,
// nor within 8 m of it), 2 no car that stopped at the end of `road`
// before it, 3 fewer cars than `gap` on the 8 roads from `road` on (a
// lane of a ring, which a car does not go into where it is full).
buffer Conflicts { road: i32, guard: i32, kind: i32, gap: f32, upto: f32 } capacity 512

// A road that crosses another (`road`), and how far along that it first
// comes within 3 m of it: a car on that road, or coming onto it, stops
// short of there while a car that was let go onto the other is on it.
buffer Crossings { road: i32, other: i32, at: f32 } capacity 64

// The roads that lead onto a road, from its row `feed` on; those that go
// on from it, from its row `split` on.
buffer Feeds { from: i32 } capacity 128
buffer Splits { to: i32 } capacity 128

// The routes: the roads of each, one after the other, then -1 where the
// last leaves the world at its end, -2 where its lane ends; and with
// each road, how many lanes a car on it there still has to change to go
// on to where the route goes (worked out when the routes are laid). Those to
// each place the cars go to lie together, from `first` on: a row of
// `Dests` for each.
buffer Paths { road: i32, need: i32 } capacity 512
buffer Dests { first: i32, count: i32 } capacity 8
// Where cars come in: the first road of so many lanes side by side, how
// many come there for every one of `Sim.inflow`, when the next comes
// (seconds), and how many came that found no room yet.
buffer Entries { road: i32, lanes: i32, share: f32, next: f32, due: i32 } capacity 8
// Where they go from there, and how often.
buffer Choices { entry: i32, dest: i32, weight: f32 } capacity 32
// What is painted: 0 a disc under the roads (x0, y0, r), 1 a broad line
// on them, 2 a dashed one, 3 a thin one.
buffer Paint { kind: i32, x0: f32, y0: f32, x1: f32, y1: f32, r: f32, color: i32 } capacity 256

// A car: its road and where on it, the row of `Paths` of its road (its
// route goes on in the rows after), where it goes, how long it is, and
// its key: the road in the high bits and where, in millimetres, in the
// low.
component Car { road: i32, pos: i32, dest: i32, length: f32, key: i64 } capacity 4096
component Spot { u: f32 } capacity 4096
component Speed { v: f32 } capacity 4096
component Accel { a: f32 } capacity 4096
// How fast it would go, against what the road allows, and at most.
component Driver { wish: f32, top: f32 } capacity 4096
// At the end of its road: whether it has been let go on, since when it
// stood at the line (-1: not), and whether it waits there; and when it
// last changed lanes.
component Gate { pass: bool, stopped: f32, held: bool, changed: f32 } capacity 4096
// How far to the right of its lane it is drawn (to the left where below
// nought), from where it changed lanes, which goes to nought.
component Shift { side: f32 } capacity 4096

// All cars by road and place.
index Flow of Car by key { u: Spot.u, v: Speed.v, length: Car.length, road: Car.road,
                           pos: Car.pos }

fn key(road: i32, u: f32) -> i64 { (road as i64) << 32 | (u * 1000.0) as i64 }

fn bez(a: f32, c: f32, b: f32, t: f32) -> f32 {
  let s = 1.0 - t
  s * s * a + 2.0 * s * t * c + t * t * b
}

fn bez_d(a: f32, c: f32, b: f32, t: f32) -> f32 { 2.0 * (1.0 - t) * (c - a) + 2.0 * t * (b - c) }

fn curve_length(x0: f32, y0: f32, cx: f32, cy: f32, x1: f32, y1: f32) -> f32 {
  var sum = 0.0
  var px = x0
  var py = y0
  for k in 1..33 {
    let t = k as f32 / 32.0
    let x = bez(x0, cx, x1, t)
    let y = bez(y0, cy, y1, t)
    sum += sqrt((x - px) * (x - px) + (y - py) * (y - py))
    px = x
    py = y
  }
  sum
}

// Where the line through p along u meets the line through q along w; half
// way between p and q where they do not.
fn meet(px: f32, py: f32, ux: f32, uy: f32, qx: f32, qy: f32, wx: f32, wy: f32) -> (f32, f32) {
  let den = ux * wy - uy * wx
  if den * den < 0.0001 { ((px + qx) * 0.5, (py + qy) * 0.5) } else {
    let s = ((qx - px) * wy - (qy - py) * wx) / den
    (px + s * ux, py + s * uy)
  }
}

fn segments_cross(ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32, dx: f32,
                  dy: f32) -> bool {
  let d1 = (dx - cx) * (ay - cy) - (dy - cy) * (ax - cx)
  let d2 = (dx - cx) * (by - cy) - (dy - cy) * (bx - cx)
  let d3 = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)
  let d4 = (bx - ax) * (dy - ay) - (by - ay) * (dx - ax)
  d1 * d2 < 0.0 && d3 * d4 < 0.0
}

// Whether two curves cross, by eight pieces of each.
fn curves_cross(ax0: f32, ay0: f32, acx: f32, acy: f32, ax1: f32, ay1: f32, bx0: f32,
                by0: f32, bcx: f32, bcy: f32, bx1: f32, by1: f32) -> bool {
  var hit = false
  for i in 0..8 {
    let s0 = i as f32 / 8.0
    let s1 = (i + 1) as f32 / 8.0
    for j in 0..8 {
      let t0 = j as f32 / 8.0
      let t1 = (j + 1) as f32 / 8.0
      if segments_cross(bez(ax0, acx, ax1, s0), bez(ay0, acy, ay1, s0),
                        bez(ax0, acx, ax1, s1), bez(ay0, acy, ay1, s1),
                        bez(bx0, bcx, bx1, t0), bez(by0, bcy, by1, t0),
                        bez(bx0, bcx, bx1, t1), bez(by0, bcy, by1, t1)) {
        hit = true
      }
    }
  }
  hit
}

// How far along the first curve (0 to 1) the second first comes within
// `clear` of it, by 32 points of each; -1 where it does not.
fn near_at(ax0: f32, ay0: f32, acx: f32, acy: f32, ax1: f32, ay1: f32, bx0: f32, by0: f32,
           bcx: f32, bcy: f32, bx1: f32, by1: f32, clear: f32) -> f32 {
  var at = -1.0
  for i in 0..33 {
    let s = i as f32 / 32.0
    let x = bez(ax0, acx, ax1, s)
    let y = bez(ay0, acy, ay1, s)
    for j in 0..33 {
      let t = j as f32 / 32.0
      let dx = bez(bx0, bcx, bx1, t) - x
      let dy = bez(by0, bcy, by1, t) - y
      if at < 0.0 && dx * dx + dy * dy < clear * clear { at = s }
    }
  }
  at
}

// And how far along it the second last comes within `clear` of it; 0
// where it does not.
fn near_last(ax0: f32, ay0: f32, acx: f32, acy: f32, ax1: f32, ay1: f32, bx0: f32, by0: f32,
             bcx: f32, bcy: f32, bx1: f32, by1: f32, clear: f32) -> f32 {
  var at = 0.0
  for i in 0..33 {
    let s = i as f32 / 32.0
    let x = bez(ax0, acx, ax1, s)
    let y = bez(ay0, acy, ay1, s)
    for j in 0..33 {
      let t = j as f32 / 32.0
      let dx = bez(bx0, bcx, bx1, t) - x
      let dy = bez(by0, bcy, by1, t) - y
      if dx * dx + dy * dy < clear * clear { at = s }
    }
  }
  at
}

// The intelligent driver model: how hard a car that goes `v` and would
// go `v0` speeds up `gap` behind one that goes `ahead` (T 1.2 s, s0 2 m,
// a 1.5 m/s², b 2 m/s²; no harder than 9 m/s² down).
fn idm(v0: f32, v: f32, ahead: f32, gap: f32) -> f32 {
  let r = v / v0
  let r2 = r * r
  let want = 2.0 + max(0.0, v * 1.2 + v * (v - ahead) / (2.0 * sqrt(3.0)))
  let q = want / max(gap, 0.1)
  max(-9.0, 1.5 * (1.0 - r2 * r2 - q * q))
}

// How far ahead of a car at `u` on `road` the car ahead is (to its back)
// and how fast it goes: the first after it on the road, or on the roads
// of its route after it (from row `pos` of `Paths` on), as far as 250 m;
// 1000 m and standing where there is none.
fn ahead(order: Flow, roads: Roads, paths: Paths, road: i32, pos: i32, u: f32) -> (f32, f32) {
  var gap = 1000.0
  var lv = 0.0
  var found = false
  let r = order.find(key(road, u) + 1)
  if r < len(order) && order[r].road == road {
    gap = order[r].u - order[r].length - u
    lv = order[r].v
    found = true
  }
  var dist = roads[road].length - u
  for k in 1..6 {
    if !found && dist < 250.0 {
      let next = paths[pos + k].road
      if next < 0 { found = true } else {
        let f = order.find((next as i64) << 32)
        if f < len(order) && order[f].road == next {
          gap = dist + order[f].u - order[f].length
          lv = order[f].v
          found = true
        } else { dist += roads[next].length }
      }
    }
  }
  (gap, lv)
}

// The car that would be behind a car `length` long at `u` on road `t`:
// whether there is one within 250 m, its row and how far it is behind,
// to its front. The last before it on the road, or the last on a road
// that leads onto it on its way there.
fn behind(order: Flow, roads: Roads, paths: Paths, ties: Ties, feeds: Feeds, t: i32, u: f32,
          length: f32) -> (bool, index of Flow, f32) {
  let r = order.find(key(t, u) + 1) - 1
  let on = r >= 0 && order[r].road == t
  var best = r
  var back = if on { u - length - order[r].u } else { 250.0 }
  var found = on
  if !on {
    let feed = ties[t].feed
    for q in feed..feed + ties[t].feeds {
      let f = feeds[q].from
      let l = order.find(((f + 1) as i64) << 32) - 1
      if l >= 0 && order[l].road == f && paths[order[l].pos + 1].road == t {
        let b = u - length + roads[f].length - order[l].u
        if b < back {
          best = l
          back = b
          found = true
        }
      }
    }
  }
  (found, best, back)
}

// The light of a group: 2 green, 1 yellow, 0 red. North and south (group
// 0) have 20 s of green, then 3 of yellow and 2 of red everywhere; then
// east and west (group 1) the same.
fn light_state(group: i32, time: f32) -> i32 {
  let cycle = 50.0
  let t = time - ((time / cycle) as i32) as f32 * cycle
  var x = t - (if group == 0 { 0.0 } else { 25.0 })
  if x < 0.0 { x += cycle }
  if x < 20.0 { 2 } else if x < 23.0 { 1 } else { 0 }
}

// Another scene: no cars, no roads.
system clear() {
  for e, c: Car { e.destroy() }
  Roads = []
  Ties = []
  Turns = []
  Conflicts = []
  Paths = []
  Dests = []
  Entries = []
  Choices = []
  Paint = []
  Feeds = []
  Splits = []
  Crossings = []
  Load = []
  Sim.time = 0.0
  Sim.gone = 0
  Sim.changes = 0
}

// Four streets that meet at a crossing, with two lanes each way (one at
// the stops): for each the roads in and the roads out, the outermost
// lane first, and from the roads in roads through the crossing to the
// other streets' roads out: from the outer lane to the right, from each
// lane straight on to the same lane, and from the inner lane to the left.
// Then which of those cross or join, and which gives way to which: under
// the lights the one that turns left to the cars that come the other way;
// on the priority road north and south to east and west, and the one that
// turns left to those that come the other way; at the stops the one that
// stopped later.
system cross() {
  let scene = Sim.scene
  let n = if scene == STOP { 1 } else { 2 }
  let lane = 2.0 * HALF
  let mouth = lane * n as f32 + 6.0
  let wide = lane * n as f32
  Paint += { kind: 0, x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0, r: mouth + 1.0 + 1.5 * n as f32,
             color: ASPHALT }
  for k in 0..4 {
    let th = 0.0 - PI * 0.5 - k as f32 * PI * 0.5
    let dx = cos(th)
    let dy = sin(th)
    let light = if scene == LIGHTS { k % 2 } else { -1 }
    // In on the right of the way in, (dy, -dx); out on the right of the
    // way out, (-dy, dx).
    for i in 0..n {
      let off = HALF + lane * (n - 1 - i) as f32
      let x0 = dx * FAR + dy * off
      let y0 = dy * FAR - dx * off
      let x1 = dx * mouth + dy * off
      let y1 = dy * mouth - dx * off
      Roads += { x0: x0, y0: y0, cx: (x0 + x1) * 0.5, cy: (y0 + y1) * 0.5, x1: x1, y1: y1,
                 length: FAR - mouth, limit: LIMIT, light: light, stop: scene == STOP }
    }
    for i in 0..n {
      let off = HALF + lane * (n - 1 - i) as f32
      let x0 = dx * mouth - dy * off
      let y0 = dy * mouth + dx * off
      let x1 = dx * FAR - dy * off
      let y1 = dy * FAR + dx * off
      Roads += { x0: x0, y0: y0, cx: (x0 + x1) * 0.5, cy: (y0 + y1) * 0.5, x1: x1, y1: y1,
                 length: FAR - mouth, limit: LIMIT, light: -1, stop: false }
    }
    // The middle of the street, the lines between its lanes, and the line
    // where the cars in wait.
    Paint += { kind: if n == 1 { 2 } else { 3 }, x0: dx * mouth, y0: dy * mouth,
               x1: dx * FAR, y1: dy * FAR, r: 0.0, color: 0xd8d8d0 }
    for m in 1..n {
      let off = lane * m as f32
      Paint += { kind: 2, x0: dx * mouth + dy * off, y0: dy * mouth - dx * off,
                 x1: dx * FAR + dy * off, y1: dy * FAR - dx * off, r: 0.0, color: 0xd8d8d0 }
      Paint += { kind: 2, x0: dx * mouth - dy * off, y0: dy * mouth + dx * off,
                 x1: dx * FAR - dy * off, y1: dy * FAR + dx * off, r: 0.0, color: 0xd8d8d0 }
    }
    if !(scene == PRIORITY && k % 2 == 1) {
      Paint += { kind: if scene == PRIORITY { 2 } else { 1 }, x0: dx * mouth, y0: dy * mouth,
                 x1: dx * mouth + dy * wide, y1: dy * mouth - dx * wide, r: 0.0,
                 color: 0xffffff }
    }
  }
  for a in 0..4 {
    for turn in 1..4 {
      let b = (a + turn) % 4
      for i in 0..n {
        if turn == 2 || (turn == 1 && i == 0) || (turn == 3 && i == n - 1) {
          let from = a * 2 * n + i
          let to = b * 2 * n + n + i
          let px = Roads[from].x1
          let py = Roads[from].y1
          let qx = Roads[to].x0
          let qy = Roads[to].y0
          let (cx, cy) = meet(px, py, px - Roads[from].x0, py - Roads[from].y0, qx, qy,
                              Roads[to].x1 - qx, Roads[to].y1 - qy)
          let limit = if turn == 1 { 5.5 } else if turn == 2 { LIMIT } else { 7.5 }
          Turns += { road: len(Roads), arm: a, turn: turn, from: from, to: to }
          Roads += { x0: px, y0: py, cx: cx, cy: cy, x1: qx, y1: qy,
                     length: curve_length(px, py, cx, cy, qx, qy), limit: limit, light: -1,
                     stop: false }
        }
      }
    }
  }
  Ties = [{ left: -1, right: -1, first: 0, conflicts: 0, feed: 0, feeds: 0, split: 0,
            splits: 0, ends: false, cross: 0, crosses: 0, bold: false }; len(Roads)]
  for r in 0..8 * n {
    let i = r % n
    if i + 1 < n { Ties[r].left = r + 1 }
    if i > 0 { Ties[r].right = r - 1 }
  }
  for x in 0..len(Turns) {
    let c = Turns[x].road
    let ca = Turns[x].arm
    let ct = Turns[x].turn
    Ties[c].first = len(Conflicts)
    for y in 0..len(Turns) {
      let l = Turns[y].road
      let la = Turns[y].arm
      let lt = Turns[y].turn
      if la != ca && (Turns[x].to == Turns[y].to ||
                      curves_cross(Roads[c].x0, Roads[c].y0, Roads[c].cx, Roads[c].cy,
                                   Roads[c].x1, Roads[c].y1, Roads[l].x0, Roads[l].y0,
                                   Roads[l].cx, Roads[l].cy, Roads[l].x1, Roads[l].y1)) {
        let turns_across = ct == 3 && lt != 3
        var kind = 0
        var gap = 0.0
        if scene == LIGHTS {
          if (la - ca + 4) % 4 == 2 && turns_across { kind = 1  gap = 4.0 }
        } else if scene == PRIORITY {
          let rc = ca % 2
          let rl = la % 2
          if rc < rl { kind = 1  gap = 5.0 }
          else if rc == rl && turns_across { kind = 1  gap = 4.0 }
        } else { kind = 2 }
        Conflicts += { road: Turns[y].from, guard: l, kind: kind, gap: gap, upto: 1000000.0 }
      }
    }
    Ties[c].conflicts = len(Conflicts) - Ties[c].first
  }
  for b in 0..4 {
    let first = len(Paths)
    for x in 0..len(Turns) {
      if (Turns[x].arm + Turns[x].turn) % 4 == b {
        Paths += { road: Turns[x].from, need: 0 }
        Paths += { road: Turns[x].road, need: 0 }
        Paths += { road: Turns[x].to, need: 0 }
        Paths += { road: -1, need: 0 }
      }
    }
    Dests += { first: first, count: len(Paths) - first }
  }
  for a in 0..4 {
    Entries += { road: a * 2 * n, lanes: n, share: 1.0, next: 0.0, due: 0 }
    for turn in 1..4 {
      Choices += { entry: a, dest: (a + turn) % 4, weight: if turn == 2 { 0.5 } else { 0.25 } }
    }
  }
}

// Four streets and a ring that the cars go round anticlockwise, of one
// lane (scene 1) or two (scene 6), with as many lanes each way on the
// streets, laid out as at a crossing. The inner lane of the ring is 20 m
// from the middle (to the middle of the lane), the outer ones 3.6 m more
// each. A street's roads in end 9 m off the ring, at the line, and short
// roads go on from each into its lane of the ring 18 degrees after the
// street; from each lane of the ring a road out leaves it 18 degrees
// before the street, onto that lane of the street. Each lane of the ring
// is 8 roads: from where the roads out leave it to where the roads in
// join it, past the street, and on to the next street.
//
// A car turning right comes in on the outer lane, one turning left on the
// inner; one going straight on either. Going in, a car gives way to the
// cars that come round to where it joins in its lane of the ring and in
// those outside it, which it crosses, within 3 seconds, and does not go
// in where its lane holds a car every 12 m already; going out from an
// inner lane, to those in the lanes outside it that go on past the
// street, within 4 (it crosses their lane some way on).
system round() {
  let n = if Sim.scene == ROUND2 { 2 } else { 1 }
  let lane = 2.0 * HALF
  let side = PI / 10.0
  let inner = 20.0
  let near = inner + lane * (n - 1) as f32 + 9.0
  let cin = 8 * n
  let cout = 12 * n
  let arcs = 16 * n
  Paint += { kind: 0, x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0, r: inner - 2.3, color: 0x2c4a33 }
  for m in 1..n {
    Paint += { kind: 4, x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0, r: inner + lane * (m as f32 - 0.5),
               color: 0xd8d8d0 }
  }
  // Roads 0 to 8n - 1: the streets' roads in and out, as at a crossing.
  for k in 0..4 {
    let th = 0.0 - PI * 0.5 - k as f32 * PI * 0.5
    let dx = cos(th)
    let dy = sin(th)
    for i in 0..n {
      let off = HALF + lane * (n - 1 - i) as f32
      let x0 = dx * FAR + dy * off
      let y0 = dy * FAR - dx * off
      let x1 = dx * near + dy * off
      let y1 = dy * near - dx * off
      Roads += { x0: x0, y0: y0, cx: (x0 + x1) * 0.5, cy: (y0 + y1) * 0.5, x1: x1, y1: y1,
                 length: FAR - near, limit: LIMIT, light: -1, stop: false }
    }
    for i in 0..n {
      let off = HALF + lane * (n - 1 - i) as f32
      let x0 = dx * near - dy * off
      let y0 = dy * near + dx * off
      let x1 = dx * FAR - dy * off
      let y1 = dy * FAR + dx * off
      Roads += { x0: x0, y0: y0, cx: (x0 + x1) * 0.5, cy: (y0 + y1) * 0.5, x1: x1, y1: y1,
                 length: FAR - near, limit: LIMIT, light: -1, stop: false }
    }
    Paint += { kind: if n == 1 { 2 } else { 3 }, x0: dx * near, y0: dy * near, x1: dx * FAR,
               y1: dy * FAR, r: 0.0, color: 0xd8d8d0 }
    for m in 1..n {
      let off = lane * m as f32
      Paint += { kind: 2, x0: dx * near + dy * off, y0: dy * near - dx * off,
                 x1: dx * FAR + dy * off, y1: dy * FAR - dx * off, r: 0.0, color: 0xd8d8d0 }
      Paint += { kind: 2, x0: dx * near - dy * off, y0: dy * near + dx * off,
                 x1: dx * FAR - dy * off, y1: dy * FAR + dx * off, r: 0.0, color: 0xd8d8d0 }
    }
    let wide = lane * n as f32
    Paint += { kind: 2, x0: dx * near, y0: dy * near, x1: dx * near + dy * wide,
               y1: dy * near - dx * wide, r: 0.0, color: 0xffffff }
  }
  // Roads 8n on: into the ring (street k, lane i: 8n + nk + i), out of it
  // (12n + nk + i), and the ring's (16n + 8i + 2k past street k, + 1 on
  // from it).
  for k in 0..4 {
    let th = 0.0 - PI * 0.5 - k as f32 * PI * 0.5
    for i in 0..n {
      let ring = inner + lane * (n - 1 - i) as f32
      let from = 2 * n * k + i
      let mx = cos(th - side) * ring
      let my = sin(th - side) * ring
      let (cx, cy) = meet(Roads[from].x1, Roads[from].y1, Roads[from].x1 - Roads[from].x0,
                          Roads[from].y1 - Roads[from].y0, mx, my, sin(th - side),
                          0.0 - cos(th - side))
      Roads += { x0: Roads[from].x1, y0: Roads[from].y1, cx: cx, cy: cy, x1: mx, y1: my,
                 length: curve_length(Roads[from].x1, Roads[from].y1, cx, cy, mx, my),
                 limit: 7.0, light: -1, stop: false }
    }
  }
  for k in 0..4 {
    let th = 0.0 - PI * 0.5 - k as f32 * PI * 0.5
    for i in 0..n {
      let ring = inner + lane * (n - 1 - i) as f32
      let dx = cos(th + side) * ring
      let dy = sin(th + side) * ring
      let o = 2 * n * k + n + i
      let (cx, cy) = meet(dx, dy, sin(th + side), 0.0 - cos(th + side), Roads[o].x0,
                          Roads[o].y0, Roads[o].x1 - Roads[o].x0, Roads[o].y1 - Roads[o].y0)
      Roads += { x0: dx, y0: dy, cx: cx, cy: cy, x1: Roads[o].x0, y1: Roads[o].y0,
                 length: curve_length(dx, dy, cx, cy, Roads[o].x0, Roads[o].y0), limit: 8.0,
                 light: -1, stop: false }
    }
  }
  for i in 0..n {
    let ring = inner + lane * (n - 1 - i) as f32
    for k in 0..8 {
      let th = 0.0 - PI * 0.5 - (k / 2) as f32 * PI * 0.5
      let from = if k % 2 == 0 { th + side } else { th - side }
      let to = if k % 2 == 0 { th - side } else { th - PI * 0.5 + side }
      let mid = (from + to) * 0.5
      let reach = ring / cos((from - to) * 0.5)
      let x0 = cos(from) * ring
      let y0 = sin(from) * ring
      let x1 = cos(to) * ring
      let y1 = sin(to) * ring
      let cx = cos(mid) * reach
      let cy = sin(mid) * reach
      Roads += { x0: x0, y0: y0, cx: cx, cy: cy, x1: x1, y1: y1,
                 length: curve_length(x0, y0, cx, cy, x1, y1), limit: 8.0, light: -1,
                 stop: false }
    }
  }
  Ties = [{ left: -1, right: -1, first: 0, conflicts: 0, feed: 0, feeds: 0, split: 0,
            splits: 0, ends: false, cross: 0, crosses: 0, bold: false }; len(Roads)]
  for r in 0..8 * n {
    let i = r % n
    if i + 1 < n { Ties[r].left = r + 1 }
    if i > 0 { Ties[r].right = r - 1 }
  }
  for k in 0..4 {
    for i in 0..n {
      let into = cin + n * k + i
      Ties[into].first = len(Conflicts)
      for j in 0..i + 1 {
        Conflicts += { road: arcs + 8 * j + 2 * k, guard: -1, kind: 1, gap: 3.0,
                       upto: 1000000.0 }
      }
      // Nor into its lane of the ring where that holds a car every 12 m.
      let ring = inner + lane * (n - 1 - i) as f32
      Conflicts += { road: arcs + 8 * i, guard: -1, kind: 3, gap: 2.0 * PI * ring / 12.0,
                     upto: 1000000.0 }
      Ties[into].conflicts = len(Conflicts) - Ties[into].first
      let out = cout + n * k + i
      Ties[out].first = len(Conflicts)
      for j in 0..i {
        // (Not for a car on the lane outside that is already past where
        // the two come within 3 m of each other.)
        let past = arcs + 8 * j + 2 * k
        let upto = near_last(Roads[past].x0, Roads[past].y0, Roads[past].cx, Roads[past].cy,
                             Roads[past].x1, Roads[past].y1, Roads[out].x0, Roads[out].y0,
                             Roads[out].cx, Roads[out].cy, Roads[out].x1, Roads[out].y1, 3.0)
        Conflicts += { road: past, guard: past, kind: 1, gap: 4.0,
                       upto: upto * Roads[past].length }
      }
      Ties[out].conflicts = len(Conflicts) - Ties[out].first
    }
  }
  // Where the roads in and out of the inner lanes cross the lanes outside
  // them (and from where they come near), whose cars stop for one there.
  for k in 0..4 {
    for i in 1..n {
      Ties[cin + n * k + i].bold = true
      Ties[cout + n * k + i].bold = true
    }
  }
  for r in arcs..arcs + 8 * n {
    Ties[r].cross = len(Crossings)
    for x in cin..arcs {
      let crosses = curves_cross(Roads[r].x0, Roads[r].y0, Roads[r].cx, Roads[r].cy,
                                 Roads[r].x1, Roads[r].y1, Roads[x].x0, Roads[x].y0,
                                 Roads[x].cx, Roads[x].cy, Roads[x].x1, Roads[x].y1)
      let at = near_at(Roads[r].x0, Roads[r].y0, Roads[r].cx, Roads[r].cy, Roads[r].x1,
                       Roads[r].y1, Roads[x].x0, Roads[x].y0, Roads[x].cx, Roads[x].cy,
                       Roads[x].x1, Roads[x].y1, 3.0)
      if crosses { Crossings += { road: r, other: x, at: at * Roads[r].length } }
    }
    Ties[r].crosses = len(Crossings) - Ties[r].cross
  }
  for b in 0..4 {
    let first = len(Paths)
    for turn in 1..4 {
      let a = (b - turn + 4) % 4
      for i in 0..n {
        if turn == 2 || (turn == 1 && i == 0) || (turn == 3 && i == n - 1) {
          let ring = arcs + 8 * i
          Paths += { road: 2 * n * a + i, need: 0 }
          Paths += { road: cin + n * a + i, need: 0 }
          Paths += { road: ring + 2 * a + 1, need: 0 }
          for j in 1..turn {
            let s = (a + j) % 4
            Paths += { road: ring + 2 * s, need: 0 }
            Paths += { road: ring + 2 * s + 1, need: 0 }
          }
          Paths += { road: cout + n * b + i, need: 0 }
          Paths += { road: 2 * n * b + n + i, need: 0 }
          Paths += { road: -1, need: 0 }
        }
      }
    }
    Dests += { first: first, count: len(Paths) - first }
  }
  for a in 0..4 {
    Entries += { road: 2 * n * a, lanes: n, share: 1.0, next: 0.0, due: 0 }
    for turn in 1..4 {
      Choices += { entry: a, dest: (a + turn) % 4, weight: if turn == 2 { 0.5 } else { 0.25 } }
    }
  }
}

// A highway of two lanes to the east, 460 m, and an on-ramp from the
// south-west. The highway is three stretches: 160 m of two lanes (roads 0
// and 1, the outer first); 170 m where a third lane lies on the outside
// (road 2), which the ramp (road 7) leads onto, and which ends (roads 3
// and 4 the highway's lanes); and 130 m of two lanes again (5 and 6).
system ramp() {
  let lane = 2.0 * HALF
  let west = -230.0
  let join = -70.0
  let end = 100.0
  let east = 230.0
  for i in 0..2 {
    let y = HALF - lane * i as f32
    Roads += { x0: west, y0: y, cx: (west + join) * 0.5, cy: y, x1: join, y1: y,
               length: join - west, limit: HIGHWAY, light: -1, stop: false }
  }
  for i in 0..3 {
    let y = HALF + lane - lane * i as f32
    Roads += { x0: join, y0: y, cx: (join + end) * 0.5, cy: y, x1: end, y1: y,
               length: end - join, limit: HIGHWAY, light: -1, stop: false }
  }
  for i in 0..2 {
    let y = HALF - lane * i as f32
    Roads += { x0: end, y0: y, cx: (end + east) * 0.5, cy: y, x1: east, y1: y,
               length: east - end, limit: HIGHWAY, light: -1, stop: false }
  }
  let rx = join - 130.0
  let ry = 45.0
  let cx = join - 50.0
  let cy = HALF + lane
  Roads += { x0: rx, y0: ry, cx: cx, cy: cy, x1: join, y1: cy,
             length: curve_length(rx, ry, cx, cy, join, cy), limit: 22.0, light: -1,
             stop: false }
  Ties = [{ left: -1, right: -1, first: 0, conflicts: 0, feed: 0, feeds: 0, split: 0,
            splits: 0, ends: false, cross: 0, crosses: 0, bold: false }; len(Roads)]
  Ties[0].left = 1
  Ties[1].right = 0
  Ties[2].left = 3
  Ties[3].left = 4
  Ties[3].right = 2
  Ties[4].right = 3
  Ties[5].left = 6
  Ties[6].right = 5
  // The lines between the lanes, and the edge of the highway's own lanes
  // beside the lane from the ramp.
  Paint += { kind: 2, x0: west, y0: 0.0, x1: east, y1: 0.0, r: 0.0, color: 0xd8d8d0 }
  Paint += { kind: 2, x0: join, y0: lane, x1: end, y1: lane, r: 0.0, color: 0xd8d8d0 }
  Paint += { kind: 3, x0: west, y0: lane, x1: join, y1: lane, r: 0.0, color: 0xd8d8d0 }
  Paint += { kind: 3, x0: end, y0: lane, x1: east, y1: lane, r: 0.0, color: 0xd8d8d0 }
  Paths += { road: 0, need: 0 }
  Paths += { road: 3, need: 0 }
  Paths += { road: 5, need: 0 }
  Paths += { road: -1, need: 0 }
  Paths += { road: 1, need: 0 }
  Paths += { road: 4, need: 0 }
  Paths += { road: 6, need: 0 }
  Paths += { road: -1, need: 0 }
  Paths += { road: 7, need: 0 }
  Paths += { road: 2, need: 0 }
  Paths += { road: -2, need: 0 }
  Dests += { first: 0, count: len(Paths) }
  Entries += { road: 0, lanes: 2, share: 6.0, next: 0.0, due: 0 }
  Entries += { road: 7, lanes: 1, share: 1.2, next: 0.0, due: 0 }
  Choices += { entry: 0, dest: 0, weight: 1.0 }
  Choices += { entry: 1, dest: 0, weight: 1.0 }
}

// A highway of two lanes to the east, 460 m, and an off-ramp to the
// south-east: 200 m of two lanes (roads 0 and 1, the outer first); 150 m
// where a third lane lies on the outside (road 2) for the cars that
// leave, which goes on into the ramp (road 7), beside the highway's lanes
// (3 and 4); and 110 m of two lanes again (5 and 6). A quarter of the cars
// leave: they change to the outer lane on the way, and from it into the
// lane of the ramp before the highway's own lanes take them past it.
system exit() {
  let lane = 2.0 * HALF
  let west = -230.0
  let split = -30.0
  let end = 120.0
  let east = 230.0
  for i in 0..2 {
    let y = HALF - lane * i as f32
    Roads += { x0: west, y0: y, cx: (west + split) * 0.5, cy: y, x1: split, y1: y,
               length: split - west, limit: HIGHWAY, light: -1, stop: false }
  }
  for i in 0..3 {
    let y = HALF + lane - lane * i as f32
    Roads += { x0: split, y0: y, cx: (split + end) * 0.5, cy: y, x1: end, y1: y,
               length: end - split, limit: HIGHWAY, light: -1, stop: false }
  }
  for i in 0..2 {
    let y = HALF - lane * i as f32
    Roads += { x0: end, y0: y, cx: (end + east) * 0.5, cy: y, x1: east, y1: y,
               length: east - end, limit: HIGHWAY, light: -1, stop: false }
  }
  let cy = HALF + lane
  let cx = end + 50.0
  let rx = end + 110.0
  let ry = 45.0
  Roads += { x0: end, y0: cy, cx: cx, cy: cy, x1: rx, y1: ry,
             length: curve_length(end, cy, cx, cy, rx, ry), limit: 22.0, light: -1,
             stop: false }
  Ties = [{ left: -1, right: -1, first: 0, conflicts: 0, feed: 0, feeds: 0, split: 0,
            splits: 0, ends: false, cross: 0, crosses: 0, bold: false }; len(Roads)]
  Ties[0].left = 1
  Ties[1].right = 0
  Ties[2].left = 3
  Ties[3].left = 4
  Ties[3].right = 2
  Ties[4].right = 3
  Ties[5].left = 6
  Ties[6].right = 5
  Paint += { kind: 2, x0: west, y0: 0.0, x1: east, y1: 0.0, r: 0.0, color: 0xd8d8d0 }
  Paint += { kind: 2, x0: split, y0: lane, x1: end, y1: lane, r: 0.0, color: 0xd8d8d0 }
  Paint += { kind: 3, x0: west, y0: lane, x1: split, y1: lane, r: 0.0, color: 0xd8d8d0 }
  Paint += { kind: 3, x0: end, y0: lane, x1: east, y1: lane, r: 0.0, color: 0xd8d8d0 }
  // On along the highway.
  Paths += { road: 0, need: 0 }
  Paths += { road: 3, need: 0 }
  Paths += { road: 5, need: 0 }
  Paths += { road: -1, need: 0 }
  Paths += { road: 1, need: 0 }
  Paths += { road: 4, need: 0 }
  Paths += { road: 6, need: 0 }
  Paths += { road: -1, need: 0 }
  Dests += { first: 0, count: len(Paths) }
  // Off: from the lane of the ramp; in the highway's lanes they have to
  // leave (their routes end with them).
  let first = len(Paths)
  Paths += { road: 2, need: 0 }
  Paths += { road: 7, need: 0 }
  Paths += { road: -1, need: 0 }
  Paths += { road: 0, need: 0 }
  Paths += { road: 3, need: 0 }
  Paths += { road: -2, need: 0 }
  Paths += { road: 1, need: 0 }
  Paths += { road: 4, need: 0 }
  Paths += { road: -2, need: 0 }
  Dests += { first: first, count: len(Paths) - first }
  Entries += { road: 0, lanes: 2, share: 6.0, next: 0.0, due: 0 }
  Choices += { entry: 0, dest: 0, weight: 0.75 }
  Choices += { entry: 0, dest: 1, weight: 0.25 }
}

// Which roads lead onto each and go on from it, from the routes.
system feeds() {
  for j in 0..len(Roads) {
    let first = len(Feeds)
    Ties[j].feed = first
    for p in 1..len(Paths) {
      let f = Paths[p - 1].road
      if Paths[p].road == j && f >= 0 {
        var known = false
        for q in first..len(Feeds) {
          if Feeds[q].from == f { known = true }
        }
        if !known { Feeds += { from: f } }
      }
    }
    Ties[j].feeds = len(Feeds) - first
    let split = len(Splits)
    Ties[j].split = split
    for p in 1..len(Paths) {
      let t = Paths[p].road
      if Paths[p - 1].road == j && t >= 0 {
        var known = false
        for q in split..len(Splits) {
          if Splits[q].to == t { known = true }
        }
        if !known { Splits += { to: t } }
      }
    }
    Ties[j].splits = len(Splits) - split
  }
  // How many lanes a car has to change: none on a route that goes on to
  // its end, many on one whose lane ends; then, again and again, no more
  // than on the road after it on its route, or one more than in the lane
  // beside it on a route to the same place.
  for p in 0..len(Paths) {
    var end = 0
    var on = true
    for q in p..len(Paths) {
      if on && Paths[q].road < 0 {
        end = Paths[q].road
        on = false
      }
    }
    Paths[p].need = if end == -2 { 99 } else { 0 }
  }
  for round in 0..4 {
    for d in 0..len(Dests) {
      let first = Dests[d].first
      for p in first..first + Dests[d].count {
        let r = Paths[p].road
        if r >= 0 {
          var need = Paths[p].need
          if Paths[p + 1].road >= 0 { need = min(need, Paths[p + 1].need) }
          for q in first..first + Dests[d].count {
            let other = Paths[q].road
            if other >= 0 && (other == Ties[r].left || other == Ties[r].right) {
              need = min(need, Paths[q].need + 1)
            }
          }
          Paths[p].need = need
        }
      }
    }
  }
  // A lane ends where no route goes on from it.
  for j in 0..len(Roads) {
    var stops = false
    var goes = false
    for p in 0..len(Paths) - 1 {
      if Paths[p].road == j {
        if Paths[p + 1].road == -2 { stops = true } else { goes = true }
      }
    }
    Ties[j].ends = stops && !goes
  }
  Sim.built = Sim.scene + 1
}

// What is on every road (`Load`). How soon and how near a car comes to
// a road's end counts the cars on it and on the roads before it on their
// way, within 120 m, and those waiting at a line too: the light may turn
// green for them as well.
system survey() {
  Load = [{ cars: 0, soonest: 1000000.0, nearest: 1000000.0, coming: 1000000.0,
            room: 1000000.0, since: -1.0, going: false }; len(Roads)]
  for k in 0..len(Flow) {
    let r = Flow[k].road
    let pos = Flow[k].pos
    Load[r].cars += 1
    if let held = Gate(Flow[k].who).held, let pass = Gate(Flow[k].who).pass,
       let stopped = Gate(Flow[k].who).stopped {
      if k + 1 == len(Flow) || Flow[k + 1].road != r { Load[r].going = pass || !held }
      if k == 0 || Flow[k - 1].road != r {
        Load[r].room = min(Load[r].room, Flow[k].u - Flow[k].length)
      }
      // One that was let go on is on its way: the road it goes onto is
      // taken already.
      let next = Paths[pos + 1].road
      if pass && next >= 0 {
        Load[next].cars += 1
        Load[next].room = min(Load[next].room, -1.0)
      }
      if stopped >= 0.0 && !pass && (Load[r].since < 0.0 || stopped < Load[r].since) {
        Load[r].since = stopped
      }
      let v = max(Flow[k].v, 1.0)
      var dist = Roads[r].length - Flow[k].u
      var road = r
      var on = true
      for j in 0..3 {
        if on && dist < 120.0 {
          Load[road].soonest = min(Load[road].soonest, dist / v)
          Load[road].nearest = min(Load[road].nearest, dist)
          let after = Paths[pos + 1 + j].road
          if after < 0 { on = false } else {
            Load[after].coming = min(Load[after].coming, dist / v)
            road = after
            dist += Roads[road].length
          }
        }
      }
    }
  }
}

// How hard every car speeds up: behind the car ahead, slowing for a road
// on that is slower, and where its road ends at a junction, stopping at
// the line unless it may go on; where its lane ends, stopping at its end.
system think() {
  let time = Sim.time
  for c: Car, at: Spot, s: Speed, d: Driver, acc: mut Accel, g: mut Gate {
    let length = Roads[c.road].length
    let v0 = min(d.wish * Roads[c.road].limit, d.top)
    let (gap, lv) = ahead(Flow, Roads, Paths, c.road, c.pos, at.u)
    var a = idm(v0, s.v, lv, gap)
    if gap <= 0.0 { Sim.overlaps += 1 }
    let rem = length - at.u
    let next = Paths[c.pos + 1].road
    // Just past where the road before split, a car that went the other
    // way and is not yet 3 m clear of it is still ahead in its lane.
    let before = if c.pos > 0 { Paths[c.pos - 1].road } else { -1 }
    if before >= 0 && at.u < 10.0 {
      let split = Ties[before].split
      for q in split..split + Ties[before].splits {
        let t = Splits[q].to
        if t != c.road {
          let f = Flow.find((t as i64) << 32)
          if f < len(Flow) && Flow[f].road == t && Flow[f].u > at.u &&
             Flow[f].u - Flow[f].length < 3.0 {
            a = min(a, idm(v0, s.v, Flow[f].v, Flow[f].u - Flow[f].length - at.u))
          }
        }
      }
    }
    // Beside a lane that ends, it lets in the car that stands at its end,
    // where that is ahead of it: braking for it as for the car ahead, but
    // no harder than 3 m/s². (One car each, as at a zip.)
    let side = Ties[c.road].right
    if side >= 0 && Ties[side].ends {
      let f = Flow.find(((side + 1) as i64) << 32) - 1
      if f >= 0 && Flow[f].road == side && Flow[f].v < 3.0 &&
         Roads[side].length - Flow[f].u < 30.0 {
        let room = Flow[f].u - Flow[f].length - at.u
        if room > 0.0 && room < 80.0 {
          a = min(a, max(-3.0, idm(v0, s.v, 0.0, room)))
        }
      }
    }
    // Short of where a road that crosses its own (or the next on its way)
    // comes near, while a car that was let go is on that road: its own
    // cars give way to it.
    let cross = Ties[c.road].cross
    for q in cross..cross + Ties[c.road].crosses {
      let near = Crossings[q].at - at.u
      if near > 0.0 && near < 40.0 && Load[Crossings[q].other].cars > 0 {
        a = min(a, idm(v0, s.v, 0.0, near - 2.0))
      }
    }
    if next >= 0 {
      let cross = Ties[next].cross
      for q in cross..cross + Ties[next].crosses {
        let near = rem + Crossings[q].at
        if near < 40.0 && Load[Crossings[q].other].cars > 0 {
          a = min(a, idm(v0, s.v, 0.0, near - 2.0))
        }
      }
    }
    var held = false
    if next == -2 {
      // The lane ends: braking evenly to stand 4 m before its end, and
      // standing there.
      let even = s.v * s.v / (2.0 * max(rem - 4.0, 0.5))
      if even > 1.0 { a = min(a, 0.0 - even) }
      if rem < 15.0 { a = min(a, idm(v0, s.v, 0.0, rem)) }
    }
    if next >= 0 {
      let slower = Roads[next].limit
      if slower < s.v && rem < 60.0 {
        a = min(a, (slower * slower - s.v * s.v) / (2.0 * max(rem, 1.0)))
      }
      // And so where its own road splits.
      let split = Ties[c.road].split
      for q in split..split + Ties[c.road].splits {
        let t = Splits[q].to
        if t != next && rem < 30.0 {
          let f = Flow.find((t as i64) << 32)
          if f < len(Flow) && Flow[f].road == t && Flow[f].u - Flow[f].length < 3.0 {
            a = min(a, idm(v0, s.v, Flow[f].v, rem + Flow[f].u - Flow[f].length))
          }
        }
      }
      // A car let go onto the same road from another, nearer to where
      // the two join, goes first; one that crosses lanes to get there
      // unless the other is 8 m nearer.
      let feed = Ties[next].feed
      for q in feed..feed + Ties[next].feeds {
        let f = Feeds[q].from
        if f != c.road && rem < 60.0 {
          let fr = Flow.find(((f + 1) as i64) << 32) - 1
          if fr >= 0 && Flow[fr].road == f && Paths[Flow[fr].pos + 1].road == next {
            let near = Roads[f].length - Flow[fr].u
            let first = if Ties[f].bold == Ties[c.road].bold { near < rem } else if Ties[f].bold {
              near < rem + 8.0
            } else { near + 8.0 < rem }
            if Load[f].going && first {
              a = min(a, idm(v0, s.v, Flow[fr].v, rem - near - Flow[fr].length))
            }
          }
        }
      }
      let light = Roads[c.road].light
      let stop = Roads[c.road].stop
      if !g.pass && rem < 80.0 && (light >= 0 || stop || Ties[next].conflicts > 0) {
        var ok = true
        if light >= 0 {
          let state = light_state(light, time)
          // On yellow a car goes on where it could not stop gently.
          if state == 0 || (state == 1 && rem > s.v * s.v / 6.0 + 1.0) { ok = false }
        }
        if stop && g.stopped < 0.0 { ok = false }
        // Nor into the junction where there is no room for it on the road
        // after: it would stand in the way of the others.
        let beyond = Paths[c.pos + 2].road
        if beyond >= 0 && Load[beyond].room < c.length + 3.0 { ok = false }
        let first = Ties[next].first
        for q in first..first + Ties[next].conflicts {
          let guard = Conflicts[q].guard
          if guard >= 0 && Load[guard].cars > 0 && Load[guard].room < Conflicts[q].upto {
            ok = false
          }
          let road = Conflicts[q].road
          let kind = Conflicts[q].kind
          if kind == 1 {
            if guard >= 0 {
              if Load[guard].coming < Conflicts[q].gap { ok = false }
            } else if Load[road].soonest < Conflicts[q].gap || Load[road].nearest < 8.0 {
              ok = false
            }
          }
          if kind == 3 {
            var cars = 0
            for r in road..road + 8 { cars += Load[r].cars }
            if cars as f32 >= Conflicts[q].gap { ok = false }
          }
          if kind == 2 {
            let since = Load[road].since
            if since >= 0.0 && (g.stopped < 0.0 || since < g.stopped ||
                                (since == g.stopped && road < c.road)) {
              ok = false
            }
          }
        }
        if ok && rem < 3.0 + s.v * 1.5 { g.pass = true }
        if !ok {
          held = true
          a = min(a, idm(v0, s.v, 0.0, rem + 0.5))
          if stop && g.stopped < 0.0 && s.v < 0.5 && rem < 4.0 { g.stopped = time }
        }
      }
    }
    g.held = held
    acc.a = a
  }
}

// Which cars change lanes, by MOBIL: to the left in even steps and to the
// right in odd ones, so that no two go into a lane from both sides at
// once; not within 3 s of the last change, nor in the last 25 m before
// a line. A car that has lanes to change goes to a lane where it has
// fewer wherever it safely can; one that has none only to a lane where it
// still has none.
system change() {
  let time = Sim.time
  let even = Sim.steps % 2 == 0
  for c: mut Car, at: Spot, s: Speed, d: Driver, acc: Accel, g: mut Gate, sh: mut Shift {
    let t = if even { Ties[c.road].left } else { Ties[c.road].right }
    let rem = Roads[c.road].length - at.u
    let need = Paths[c.pos].need
    if t >= 0 && time - g.changed > 3.0 && !g.pass && (rem > 25.0 || need > 0) {
      // The route on from there to where it goes with fewest changes.
      var q = -1
      let first = Dests[c.dest].first
      for p in first..first + Dests[c.dest].count {
        if Paths[p].road == t && (q < 0 || Paths[p].need < Paths[q].need) { q = p }
      }
      let must = q >= 0 && Paths[q].need < need
      if q >= 0 && (must || Paths[q].need == 0 && need == 0) {
        let v0 = min(d.wish * Roads[t].limit, d.top)
        let (gap, lv) = ahead(Flow, Roads, Paths, t, q, at.u)
        let mine = idm(v0, s.v, lv, gap)
        var gain = mine - acc.a
        // The car that would be behind it there, on that road or the one
        // before, need not brake harder than 4 m/s²; than up to 8 where the
        // car has to leave its lane and that is running out.
        let hard = if must { 4.0 + 4.0 * min(1.0, at.u / Roads[c.road].length) } else { 4.0 }
        // And so itself, behind the car ahead there.
        var safe = gap > 1.0 && mine > 0.0 - hard
        let (there, fr, back) = behind(Flow, Roads, Paths, Ties, Feeds, t, at.u, c.length)
        if there {
          if let now = Accel(Flow[fr].who).a, let wish = Driver(Flow[fr].who).wish,
             let top = Driver(Flow[fr].who).top {
            let then = idm(min(wish * Roads[Flow[fr].road].limit, top), Flow[fr].v, s.v, back)
            safe = safe && back > 1.0 && then > 0.0 - hard
            gain += 0.2 * (then - now)
          }
        }
        // A little for keeping right, and more for keeping out of the way
        // of the cars in a lane beside that ends.
        let right = Ties[c.road].right
        let room = right >= 0 && Ties[right].ends && t == Ties[c.road].left
        let bias = if room { 0.3 } else if t == right { 0.1 } else { -0.1 }
        if must { gain += 10.0 }
        if safe && gain + bias > 0.2 {
          sh.side = if t == Ties[c.road].left { 2.0 * HALF } else { -2.0 * HALF }
          c.road = t
          c.pos = q
          c.key = key(t, at.u)
          g.changed = time
          Sim.changes += 1
        }
      }
    }
  }
}

// Every car moves on, onto the next road of its route where it passed the
// end of one; at the end of the last it is gone.
system drive() {
  let dt = Sim.dt
  for e, c: mut Car, at: mut Spot, s: mut Speed, acc: Accel, g: mut Gate, sh: mut Shift {
    let v = s.v
    let a = acc.a
    let next = v + a * dt
    var dx = 0.0
    if next < 0.0 {
      dx = 0.0 - 0.5 * v * v / a
      s.v = 0.0
    } else {
      dx = v * dt + 0.5 * a * dt * dt
      s.v = next
    }
    // Into its new lane at 2.5 m a second.
    let fade = 2.5 * dt
    sh.side = if sh.side > fade { sh.side - fade } else if sh.side < 0.0 - fade {
      sh.side + fade
    } else { 0.0 }
    var u = at.u + dx
    var road = c.road
    var pos = c.pos
    var gone = false
    for k in 0..3 {
      if !gone && u >= Roads[road].length {
        let after = Paths[pos + 1].road
        if after == -1 { gone = true } else if after == -2 {
          u = Roads[road].length - 0.01
          s.v = 0.0
        } else {
          u -= Roads[road].length
          road = after
          pos += 1
          g.pass = false
          g.stopped = -1.0
          g.held = false
        }
      }
    }
    if gone {
      e.destroy()
      Sim.gone += 1
    } else {
      c.road = road
      c.pos = pos
      at.u = u
      c.key = key(road, u)
    }
  }
}

// Cars come in on every street, a few seconds apart at random, as many an
// hour as `Sim.inflow` times the street's share; one that finds no room at
// the street's start waits for it. It goes where a draw by the weights
// says, in the lane with most room of those its routes start in (and with
// fewest lanes to change: one is worth 200 m of room).
system arrive() {
  let time = Sim.time
  let trucks = if Sim.scene == RAMP || Sim.scene == EXIT { 0.12 } else { 0.0 }
  for i in 0..len(Entries) {
    if time >= Entries[i].next {
      let mean = 3600.0 / (Sim.inflow * Entries[i].share)
      let draw = wyrand_unit(Sim.seed, Sim.born * 8 + i as i64) as f32
      Entries[i].next = time + mean * (0.3 + 1.4 * draw)
      Entries[i].due += 1
    }
    if Entries[i].due > 0 {
      let pick = wyrand_unit(Sim.seed + 1, Sim.born) as f32
      var sum = 0.0
      var dest = -1
      var last = 0
      for k in 0..len(Choices) {
        if Choices[k].entry == i {
          last = Choices[k].dest
          if dest < 0 {
            sum += Choices[k].weight
            if pick < sum { dest = Choices[k].dest }
          }
        }
      }
      if dest < 0 { dest = last }
      var pos = -1
      var room = 0.0
      var lead = 0.0
      var best = -1000000.0
      for l in 0..Entries[i].lanes {
        let r = Entries[i].road + l
        var q = -1
        let first = Dests[dest].first
        for p in first..first + Dests[dest].count {
          if q < 0 && Paths[p].road == r && (p == 0 || Paths[p - 1].road < 0) { q = p }
        }
        let f = Flow.find((r as i64) << 32)
        let there = f < len(Flow) && Flow[f].road == r
        let free = if there { Flow[f].u - Flow[f].length } else { 1000.0 }
        if q >= 0 && free - 200.0 * Paths[q].need as f32 > best {
          best = free - 200.0 * Paths[q].need as f32
          pos = q
          room = free
          lead = if there { Flow[f].v } else { -1.0 }
        }
      }
      if pos >= 0 && room > 10.0 {
        let r = Paths[pos].road
        let other = wyrand_unit(Sim.seed + 2, Sim.born) as f32
        let truck = other < trucks
        let length = if truck { 12.0 } else if other < 0.12 { 6.5 } else { 4.5 }
        let top = if truck { 25.0 } else { 50.0 }
        let wish = 0.85 + 0.3 * wyrand_unit(Sim.seed + 3, Sim.born) as f32
        let v = if lead >= 0.0 && room < 60.0 { lead } else { 0.8 * min(wish * Roads[r].limit, top) }
        spawn { Car { road: r, pos: pos, dest: dest, length: length, key: key(r, 0.0) },
                Spot { u: 0.0 }, Speed { v: v }, Accel { a: 0.0 },
                Driver { wish: wish, top: top },
                Gate { pass: false, stopped: -1.0, held: false, changed: time },
                Shift { side: 0.0 } }
        Sim.born += 1
        Entries[i].due -= 1
      }
    }
  }
}

system tick() {
  Sim.time += Sim.dt
  Sim.steps += 1
}

// A new scene, where `Sim.scene` is not the one laid.
schedule lay() {
  clear() run_if Sim.built != Sim.scene + 1
  cross() run_if Sim.built != Sim.scene + 1 &&
                 (Sim.scene == LIGHTS || Sim.scene == PRIORITY || Sim.scene == STOP)
  round() run_if Sim.built != Sim.scene + 1 &&
                 (Sim.scene == ROUNDABOUT || Sim.scene == ROUND2)
  ramp() run_if Sim.built != Sim.scene + 1 && Sim.scene == RAMP
  exit() run_if Sim.built != Sim.scene + 1 && Sim.scene == EXIT
  feeds() run_if Sim.built != Sim.scene + 1
}

schedule step() {
  survey()
  think()
  change()
  drive()
  arrive()
  tick()
}

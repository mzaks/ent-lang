// entsat's local search: probSAT (Balint and Schoening) over the clauses
// the search starts with, before the search.
//
//   schedule start() { read()  prepare()  setup()  watch()  walk() }
//
// Every variable has its phase, the value the search would give it (or,
// with `random`, one at random); then, as long as a clause is
// false, one of the false ones is picked at random and one of its
// variables flipped: the variable that would make `b` other clauses false
// (its break) with a weight of cb to the power of -b, cb by the clauses'
// mean length as Kissat's walker has it. Where no clause is false the
// values are a model and the answer is SAT; otherwise, after `limit`
// flips, the values with the fewest false clauses become the phases the
// search decides with.
//
// What is true or false at level 0 (the units) stays: a clause with a
// literal true there is left out, a literal false there is left out of
// its clause. The numbers drawn are the same each run (`seed`).
import clock
import console
import dimacs
import math
import sat

// The clauses walked: where their literals are in `Wlit`, how many, how
// many of them are true (`holds`), and where the clause is in `Wfalse`
// (-1 where it is not false).
buffer Wclause { start: i32, size: i32, holds: i32, pos: i32 } capacity 16
buffer Wlit { lit: i32 } capacity 16

// Per literal the clauses walked that have it: `Whead[l]` says where in
// `Wocc` and how many.
buffer Whead { start: i32, size: i32 } capacity 16
buffer Wocc { clause: i32 } capacity 16

// The clauses that are false, in no order.
buffer Wfalse { clause: i32 } capacity 16

// Per variable its value and its value where the fewest clauses were
// false; per break the weight of a variable that has it; per literal of
// the clause picked its weight. The variables flipped since the fewest
// were false: given their values where fewer are false again, so that
// the values are not copied each time (as Kissat keeps them), and all of
// them copied where more than there are variables were flipped.
buffer Wvar { value: bool, best: bool } capacity 16
buffer Wflipped { var: i32 } capacity 16
buffer Wweight { w: f64 } capacity 64
buffer Wpick { w: f64 } capacity 16

// `limit`: how many flips at most (0: no walk). `seed`: of the numbers
// drawn. `cb`: the base of the weights (0: by the clauses' length).
// `random`: the values to start with at random, not the phases. What it did: the flips, the fewest clauses false, whether the
// values became a model, how long it took.
unique Walk {
  limit: i64, seed: u64, cb: f64, random: bool,
  clauses: i32, flips: i64, best: i32, found: bool, seconds: f64
}

world {
  Walk.limit = 0
  Walk.seed = 1
  Walk.cb = 0.0
  Walk.random = false
}

// The next number drawn, of the state given (SplitMix64).
fn stir(x: u64) -> u64 {
  var z = x
  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
  z = (z ^ (z >> 27)) * 0x94d049bb133111eb
  z ^ (z >> 31)
}

// Of a number drawn, a whole number from 0 to below `count`, and one
// above 0 and below 1.
fn below(bits: u64, count: i32) -> i32 {
  let (hi, lo) = mul_wide(bits, count as i64 as u64)
  hi as i32
}
fn fraction(bits: u64) -> f64 { ((bits >> 11) as f64 + 0.5) / 9007199254740992.0 }

// Kissat's cb for clauses of `size` literals on average: between the
// values it has for 0, 3, 4, 5, 6 and 7, and 7's above.
fn base(size: f64) -> f64 {
  if size <= 3.0 { 2.0 + (2.5 - 2.0) * size / 3.0 }
  else if size <= 4.0 { 2.5 + (2.85 - 2.5) * (size - 3.0) }
  else if size <= 5.0 { 2.85 + (3.7 - 2.85) * (size - 4.0) }
  else if size <= 6.0 { 3.7 + (5.1 - 3.7) * (size - 5.0) }
  else if size <= 7.0 { 5.1 + (7.4 - 5.1) * (size - 6.0) }
  else { 7.4 }
}

system walk() {
  Walk.flips = 0
  Walk.found = false
  Walk.clauses = 0
  let n = Problem.vars
  let go = Walk.limit > 0 && Search.status == Status.Running
  let started = wait_until(0.0)
  Wclause = []
  Wlit = []
  Wfalse = []
  Whead = [{ start: 0, size: 0 }; if go { 2 * n } else { 0 }]
  // (The clauses not learned, without what level 0 settles; `empty`
  // where one has no literal left, which propagation will find.)
  var empty = false
  var longest = 0
  var top: index of Arena = 0
  let end = if go { len(Arena) } else { 0 }
  while top < end {
    let size = Arena[top].w
    if Arena[top + 1].w & 1 == 0 {
      var satisfied = false
      for k in 0..size {
        if Values[Arena[top + 2 + k].w].v == 1 { satisfied = true }
      }
      if !satisfied {
        let start = len(Wlit)
        for k in 0..size {
          let l = Arena[top + 2 + k].w
          if Values[l].v == 0 {
            Wlit += { lit: l }
            Whead[l].size += 1
          }
        }
        let kept = len(Wlit) - start
        if kept == 0 { empty = true }
        longest = max(longest, kept)
        Wclause += { start: start, size: kept, holds: 0, pos: -1 }
      }
    }
    top += 2 + size
  }
  let m = len(Wclause)
  Walk.clauses = m
  // (The lists of the literals, one after another.)
  var at = 0
  for l in 0..len(Whead) {
    Whead[l].start = at
    at += Whead[l].size
    Whead[l].size = 0
  }
  Wocc = [{ clause: 0 }; at]
  for c in 0..m {
    let s = Wclause[c].start
    for k in 0..Wclause[c].size {
      let l = Wlit[s + k].lit
      Wocc[Whead[l].start + Whead[l].size].clause = c
      Whead[l].size += 1
    }
  }
  // (The weights, by break; and the values to start with.)
  let cb = if Walk.cb > 0.0 { Walk.cb }
           else { base(if m > 0 { len(Wlit) as f64 / m as f64 } else { 0.0 }) }
  Wweight = [{ w: 0.0 }; 64]
  for b in 0..64 { Wweight[b].w = pow64(cb, -(b as f64)) }
  Wpick = [{ w: 0.0 }; longest + 1]
  Wvar = [{ value: false, best: false }; if go { n } else { 0 }]
  var state = Walk.seed * 0x9e3779b97f4a7c15
  for v in 0..len(Wvar) {
    state += 0x9e3779b97f4a7c15
    let value = if Values[2 * v].v != 0 { Values[2 * v].v == 1 }
                else if Walk.random { stir(state) >> 63 == 1 }
                else { Vars[v].phase }
    Wvar[v].value = value
    Wvar[v].best = value
  }
  for c in 0..m {
    let s = Wclause[c].start
    var count = 0
    for k in 0..Wclause[c].size {
      let l = Wlit[s + k].lit
      if Wvar[l >> 1].value == (l & 1 == 0) { count += 1 }
    }
    Wclause[c].holds = count
    if count == 0 {
      Wclause[c].pos = len(Wfalse)
      Wfalse += { clause: c }
    }
  }
  var best = len(Wfalse)
  Wflipped = []
  var whole = false
  var flips: i64 = 0
  let limit = if empty { 0 } else { Walk.limit }
  var going = true
  while len(Wfalse) > 0 && flips < limit && going {
    state += 0x9e3779b97f4a7c15
    let c = Wfalse[below(stir(state), len(Wfalse))].clause
    let s = Wclause[c].start
    let size = Wclause[c].size
    // (Each literal's weight by its variable's break: the clauses where
    // the variable's true literal is the one true.)
    var sum: f64 = 0.0
    for k in 0..size {
      let l = Wlit[s + k].lit
      let t = l ^ 1
      var breaks = 0
      let h = Whead[t].start
      for i in h..h + Whead[t].size {
        if Wclause[Wocc[i].clause].holds == 1 { breaks += 1 }
      }
      let w = Wweight[min(breaks, 63)].w
      Wpick[k].w = w
      sum += w
    }
    state += 0x9e3779b97f4a7c15
    var r = fraction(stir(state)) * sum
    var k = 0
    while k < size - 1 && r > Wpick[k].w {
      r -= Wpick[k].w
      k += 1
    }
    // (The flip: its literal true, its negation false.)
    let l = Wlit[s + k].lit
    let v = l >> 1
    Wvar[v].value = l & 1 == 0
    if !whole {
      if len(Wflipped) < n { Wflipped += { var: v } } else { whole = true }
    }
    let h = Whead[l].start
    for i in h..h + Whead[l].size {
      let d = Wocc[i].clause
      Wclause[d].holds += 1
      if Wclause[d].holds == 1 {
        // (No longer false: the last false one in its place.)
        let p = Wclause[d].pos
        let last = Wfalse[len(Wfalse) - 1].clause
        Wfalse[p].clause = last
        Wclause[last].pos = p
        Wfalse = Wfalse[..len(Wfalse) - 1]
        Wclause[d].pos = -1
      }
    }
    let g = Whead[l ^ 1].start
    for i in g..g + Whead[l ^ 1].size {
      let d = Wocc[i].clause
      Wclause[d].holds -= 1
      if Wclause[d].holds == 0 {
        Wclause[d].pos = len(Wfalse)
        Wfalse += { clause: d }
      }
    }
    flips += 1
    // (Within the time the search has, as it checks it.)
    if flips & 65535 == 0 && Options.seconds > 0.0 &&
       wait_until(0.0) - Search.started > Options.seconds {
      going = false
      Search.status = Status.Unknown
    }
    if len(Wfalse) < best {
      best = len(Wfalse)
      if whole {
        for u in 0..n { Wvar[u].best = Wvar[u].value }
      } else {
        for f in 0..len(Wflipped) { Wvar[Wflipped[f].var].best = Wvar[Wflipped[f].var].value }
      }
      Wflipped = []
      whole = false
    }
  }
  Walk.flips = flips
  Walk.best = best
  Walk.found = go && !empty && len(Wfalse) == 0
  Walk.seconds = wait_until(0.0) - started
  if go {
    put("c walked {flips} flips over {m} clauses, fewest false {best}, {Walk.seconds} seconds")
  }
  if Walk.found {
    // (A model: every variable its value, level 0's as it was.)
    for v in 0..n {
      if Values[2 * v].v == 0 {
        let positive = Wvar[v].value
        Values[2 * v].v = if positive { 1 } else { -1 }
        Values[2 * v + 1].v = if positive { -1 } else { 1 }
      }
    }
    Search.status = Status.Sat
  } else if go {
    for v in 0..n { Vars[v].phase = Wvar[v].best }
  }
}

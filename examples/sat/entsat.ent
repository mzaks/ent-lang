// entsat: solves the problem in "problem.cnf" where it is started (DIMACS
// CNF), prints the answer as SAT competitions do, and writes a DRAT
// proof to "proof.drat" (binary; empty where the answer is SAT).
//
//   tools/ent build examples/sat/entsat.ent -o build/sat/entsat
//   cd somewhere && cp problem.cnf . && .../build/sat/entsat
//
// (Room for 4 million variables, 32 million literals read and a quarter
// of a billion words of clauses.)
import console
import files
import dimacs
import sat

capacity Bytes 268435456
capacity Clauses 33554432
capacity Values 8388608
capacity Lists 8388608
capacity Watch 134217728
capacity Seen 8388608
capacity Vars 4194304
capacity Trail 4194304
capacity Levels 4194305
capacity Learnt 4194305
capacity Clear 4194305
capacity Stack 4194305
capacity Bumped 4194305
capacity Arena 268435456

schedule start() { read() setup() watch() }
schedule done() { finish() }

main {
  start()
  loop { round() } until Search.status != Status.Running
  done()
}

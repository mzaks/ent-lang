// Way 0, direct (spec section 6.2): Newton–Raphson on the whole circuit.
// Every device puts its companion (devices.ent) into the matrix of
// modified nodal analysis, and every source its part, as entries: a row,
// a column and a value, with a column of -1 for the right-hand side. The
// C side (direct.c) adds them up and solves them with KLU, SuiteSparse's
// sparse LU. The unknowns are the voltages of the nodes but ground, by
// their numbers less one, then the currents through the voltage sources
// from a to b, by their branches (so a voltage source between two nodes
// that are not ground is no trouble here), and then the memristors'
// states, by their numbers: each Newton step solves for all at once, as
// ngspice does with a model's internal node (spec 7.3).
//
//   schedule step() { companions()  stamp()  solved()  taken() }
//   (from `started()`, until Direct.settled or Direct.failed)
import circuit
import sources
import devices
import math

buffer Entries { row: i32, col: i32, value: f64 } capacity 16
buffer Solution { value: f64 } capacity 16

// `size`: the unknowns. `status`: what the solve gave (0: solved; see
// direct.c). `rounds`: Newton's steps at this time point. `settled`: the
// last step moved no node more than the tolerance.
unique Direct { size: i32, status: i32, rounds: i32, settled: bool, failed: bool }

extern proc solve_entries(entries: Entries, size: i32, into: mut Solution) -> i32

system started() {
  Direct.size = Circuit.nodes - 1 + Circuit.branches + Circuit.memristors
  Direct.rounds = 0
  Direct.settled = false
  Direct.failed = false
}

system stamp() {
  Entries = []
  // (GMIN from every node to ground.)
  for p: Place where p.index > 0 {
    Entries += { row: p.index - 1, col: p.index - 1, value: GMIN }
  }
  // A companion: g between its nodes, and i0 out of a and into b.
  for t: Two, c: Companion {
    if let a = Place(t.a).index {
      if let b = Place(t.b).index {
        if a > 0 {
          Entries += { row: a - 1, col: a - 1, value: c.g }
          Entries += { row: a - 1, col: -1, value: -c.i0 }
        }
        if b > 0 {
          Entries += { row: b - 1, col: b - 1, value: c.g }
          Entries += { row: b - 1, col: -1, value: c.i0 }
        }
        if a > 0 && b > 0 {
          Entries += { row: a - 1, col: b - 1, value: -c.g }
          Entries += { row: b - 1, col: a - 1, value: -c.g }
        }
      }
    }
  }
  // A memristor's current also grows with its state (gw), and its state's
  // equation, made straight, is a row of its own.
  for t: Two, m: Memristor {
    if let a = Place(t.a).index {
      if let b = Place(t.b).index {
        if let va = Node(t.a).v {
          if let vb = Node(t.b).v {
            let x = Circuit.nodes - 1 + Circuit.branches + m.index
            if a > 0 {
              Entries += { row: a - 1, col: x, value: m.gw }
              Entries += { row: a - 1, col: -1, value: m.gw * m.w }
              Entries += { row: x, col: a - 1, value: m.jv }
            }
            if b > 0 {
              Entries += { row: b - 1, col: x, value: -m.gw }
              Entries += { row: b - 1, col: -1, value: -m.gw * m.w }
              Entries += { row: x, col: b - 1, value: -m.jv }
            }
            Entries += { row: x, col: x, value: m.jw }
            Entries += { row: x, col: -1, value: -m.f + m.jv * (va - vb) + m.jw * m.w }
          }
        }
      }
    }
  }
  for t: Two, s: Source {
    let value = level(s.wave, s.p0, s.p1, s.p2, s.p3, s.p4, s.p5, s.p6, s.first, s.count,
                      Points, Time.t)
    if let a = Place(t.a).index {
      if let b = Place(t.b).index {
        if s.voltage {
          // (Its current is an unknown, and va - vb is its value.)
          let m = Circuit.nodes - 1 + s.branch
          if a > 0 {
            Entries += { row: a - 1, col: m, value: 1.0 }
            Entries += { row: m, col: a - 1, value: 1.0 }
          }
          if b > 0 {
            Entries += { row: b - 1, col: m, value: -1.0 }
            Entries += { row: m, col: b - 1, value: -1.0 }
          }
          Entries += { row: m, col: -1, value: value }
        } else {
          // (Out of a, through the source, into b.)
          if a > 0 { Entries += { row: a - 1, col: -1, value: -value } }
          if b > 0 { Entries += { row: b - 1, col: -1, value: value } }
        }
      }
    }
  }
}

system solved() {
  Direct.status = solve_entries(Entries, Direct.size, Solution)
  Direct.failed = Direct.status != 0
  Direct.rounds += 1
}

// The nodes take their voltages and the memristors their states, and
// whether one moved by more than the tolerance says whether Newton goes
// on.
unique Moved { nodes: i32 }

system taken() {
  Moved.nodes = 0
  for n: mut Node, p: Place where p.index > 0 && !Direct.failed {
    let v = Solution[p.index - 1].value
    if abs64(v - n.v) > Time.reltol * max(abs64(v), abs64(n.v)) + Time.vntol {
      Moved.nodes += 1
    }
    n.v = v
  }
  for m: mut Memristor where !Direct.failed {
    let w = Solution[Circuit.nodes - 1 + Circuit.branches + m.index].value
    if abs64(w - m.w) > Time.reltol * max(abs64(w), abs64(m.w)) + Time.vntol {
      Moved.nodes += 1
    }
    m.w = w
  }
  // (With no memristor the circuit is linear: the matrix does not hang on
  // the voltages, a second step would solve the same again, and on a
  // power grid of 850,000 nodes it takes half a minute.)
  Direct.settled = !Direct.failed && (Moved.nodes == 0 || Circuit.memristors == 0)
}

// The currents through the devices from a to b, for the probes.
system direct_currents() {
  for t: Two, c: Companion, d: mut Device {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v { d.i = current(c.g, c.i0, va, vb) }
    }
  }
  for s: Source, d: mut Device where s.voltage {
    d.i = Solution[Circuit.nodes - 1 + s.branch].value
  }
  for t: Two, s: Source, d: mut Device where !s.voltage {
    d.i = level(s.wave, s.p0, s.p1, s.p2, s.p3, s.p4, s.p5, s.p6, s.first, s.count,
                Points, Time.t)
  }
}

// Solves the circuit in the file "circuit.net" where the program is
// started (examples/analog/prepare.py makes one of a SPICE netlist) and
// writes what its probes show to "waves.txt": a line for each time point,
// the time and then each probe's value, as printf("%.17g") writes them.
//
//   examples/analog/prepare.py rc_step
//   cd build/analog/circuits/rc_step
//   ../../../../tools/ent run -I ../../../../examples/analog ../../../../examples/analog/simulate.ent
//
// The operating point first, at time 0 (capacitors open, as SPICE does
// it: a capacitor's IC= is not used); then, where the circuit has a
// `tran`, a time point every step up to its stop, by backward Euler
// (milestone M2: the step stays the same). A time point that does not
// settle ends the run, said: nothing is taken that was not solved.
//
// "run.txt", where there is one, says which way (0: direct, 1: relaxation
// by Gauss–Jacobi, 2: relaxation by events), then a seed, whether the
// waves are written (1) or not (0), reltol, vntol, abstol, the most
// rounds a time point may take, the time the operating point is taken at
// where there is no `tran`, and the step (0: the circuit's own); what it
// leaves out stays as SPICE has it (way 0, 1e-3, 1e-6 V, 1e-12 A; 100,000
// rounds; time 0; the circuit's step).
//
// What it did goes to the console: the way, the time points, whether all
// settled, the rounds in all and the most at one point, and how many steps
// the nodes took.
import files
import console
import decimal
import math
import circuit
import sources
import devices
import direct
import relax

capacity Bytes 268435456
capacity Node 2200000
capacity Two 3300000
capacity Touches 6600000
capacity Lines 3300000
capacity Numbers 12000000
capacity Nodes 2200000
capacity Devices 3300000
capacity Points 1000000
capacity Probes 100000
capacity Entries 24000000
capacity Solution 2300000

// `way`, `shown` and `most` as "run.txt" says, and the step it gives (0:
// the circuit's). `refused`: what keeps the way from this circuit, said
// and nothing solved. `point`: the time point now, from 0; `points`: how
// many there are. `failed`: a time point did not settle. `written`: some
// of the waves are in their file. The rounds and node steps in all, and
// the most rounds at one point.
unique Run {
  way: i32, shown: bool, most: i32, step: f64, refused: bool, point: i32, points: i32,
  failed: bool, written: bool, rounds: i64, most_rounds: i32, updates: i64, memristors: i32
}

world {
  Circuit.file = "circuit.net"
  Time.reltol = 0.001
  Time.vntol = 0.000001
  Time.abstol = 1e-12
  Run.most = 100000
  Run.shown = true
  Time.t = 0.0
}

system plan() {
  let size = read_file("run.txt", Bytes)
  if size > 0 {
    var at = 0
    var k = 0
    while k < 9 && at < len(Bytes) {
      let (value, next) = read_real(Bytes, at)
      if next > at {
        if k == 0 { Run.way = value as i32 }
        if k == 2 { Run.shown = value != 0.0 }
        if k == 3 { Time.reltol = value }
        if k == 4 { Time.vntol = value }
        if k == 5 { Time.abstol = value }
        if k == 6 { Run.most = value as i32 }
        if k == 7 { Time.t = value }
        if k == 8 { Run.step = value }
        at = next
      } else { at = len(Bytes) }
      k += 1
    }
  }
  Bytes = []
}

system said() {
  Run.refused = true
  if !Circuit.read {
    put("no circuit: the file {Circuit.file} is not where the program was started")
  } else if Circuit.wrong > 0 {
    put("the circuit's line {Circuit.wrong} makes no sense")
  } else if Circuit.clashing > 0 {
    put("{Circuit.clashing} nodes are held by two sources at once")
  } else if Run.way != 0 && Circuit.floating > 0 {
    put("way {Run.way} does not do a voltage source between two nodes that are not ground ({Circuit.floating} of them): way 0 does")
  } else {
    Run.refused = false
  }
  for m: Memristor { Run.memristors += 1 }
  // (The time points: the operating point, and one a step up to the stop.)
  Run.point = 0
  Run.points = 1
  Time.h = 0.0
  if Circuit.tran {
    Time.t = 0.0
    if Run.step <= 0.0 { Run.step = Circuit.step }
    Run.points = 1 + (Circuit.stop / Run.step + 0.5) as i32
  }
  Bytes = []
}

// The time point's line: the time, then the probes; written out when
// there are many.
system written() {
  if Run.shown && !Run.refused && !Run.failed {
    write_real(Bytes, Time.t)
    for k in 0..len(Probes) {
      Bytes += { value: 32 }
      var value = 0.0 as f64
      if Probes[k].voltage {
        if let v = Node(Nodes[Probes[k].index].who).v { value = v }
      } else {
        if let i = Device(Devices[Probes[k].index].who).i { value = i }
      }
      write_real(Bytes, value)
    }
    Bytes += { value: 10 }
    if len(Bytes) > 16000000 || Run.point + 1 >= Run.points {
      write_bytes("waves.txt", Bytes, 0, len(Bytes), Run.written)
      Run.written = true
      Bytes = []
    }
  }
}

// Whether the time point settled, and the counts.
system counted() {
  let rounds = if Run.way == 0 { Direct.rounds } else { Relax.round }
  Run.rounds += rounds as i64
  Run.most_rounds = max(Run.most_rounds, rounds)
  if Run.way != 0 { Run.updates += Relax.updates }
  let settled = if Run.way == 0 { Direct.settled } else { Relax.unsettled == 0 }
  if !settled && !Run.refused {
    Run.failed = true
    if Run.way == 0 && Direct.failed {
      put("way 0: the solve failed ({Direct.status}) at time point {Run.point}")
    } else {
      put("way {Run.way}: time point {Run.point} did not settle in {rounds} rounds")
    }
  }
}

// On to the next time point.
system advanced() {
  Run.point += 1
  Time.t = Run.point as f64 * Run.step
  Time.h = Run.step
}

system told_how() {
  if !Run.refused {
    put("way {Run.way}: {Run.point} time points, settled {!Run.failed}, {Run.rounds} rounds, at most {Run.most_rounds} at one, {Run.updates} node steps")
    if Run.memristors > 0 && Circuit.tran {
      put("(the states of its {Run.memristors} memristors are held as they start: they move from milestone M3 on)")
    }
  }
}

schedule setup() { plan() netlist() build() said() }
// A time point: begun, rounds until settled, ended.
schedule begun() {
  started() run_if Run.way == 0
  relax_started() run_if Run.way != 0
  held() run_if Run.way != 0
  companions()
  gathered() run_if Run.way == 2
  told() run_if Run.way == 2
  started_events() run_if Run.way == 2
}
schedule rounded() {
  stamp() run_if Run.way == 0
  solved() run_if Run.way == 0
  taken() run_if Run.way == 0
  gathered() run_if Run.way == 1
  told() run_if Run.way == 1
  stepped() run_if Run.way == 1
  moved() run_if Run.way == 2
  retold() run_if Run.way == 2
  judged() run_if Run.way != 0
}
schedule ended() {
  counted()
  direct_currents() run_if Run.way == 0
  gathered() run_if Run.way != 0
  told() run_if Run.way != 0
  relaxed_currents() run_if Run.way != 0
  written()
  accepted()
  advanced()
}
schedule done() { told_how() }

main {
  setup()
  loop {
    begun()
    loop { rounded() } until Run.refused ||
      (Run.way == 0 && (Direct.settled || Direct.failed || Direct.rounds >= 50)) ||
      (Run.way != 0 && (Relax.unsettled == 0 || Relax.round >= Run.most))
    ended()
  } until Run.refused || Run.failed || Run.point >= Run.points
  done()
}

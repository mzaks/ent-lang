// Solves the circuit in the file "circuit.net" where the program is
// started (examples/analog/prepare.py makes one of a SPICE netlist) and
// writes what its probes show to "waves.txt": a line for each time point,
// the time and then each probe's value, as printf("%.17g") writes them.
//
//   examples/analog/prepare.py rc_step
//   cd build/analog/circuits/rc_step
//   ../../../../tools/ent run -I ../../../../examples/analog ../../../../examples/analog/simulate.ent
//
// The operating point first, at time 0 (capacitors open, as SPICE does
// it: a capacitor's IC= is not used); then, where the circuit has a
// `tran`, time points up to its stop, by the trapezoidal rule with steps
// chosen by the error they leave (steps.ent, milestone M4). Only time
// points that settled and whose error is within the tolerance are taken
// and written; the others are tried again with a shorter step.
//
// "run.txt", where there is one, says which way (0: direct, 1: relaxation
// by Gauss–Jacobi, 2: relaxation by events), then a seed, whether the
// waves are written (1) or not (0), reltol, vntol, abstol, the most
// rounds a time point may take, the time the operating point is taken at
// where there is no `tran`, a fixed step (0: steps chosen by their error),
// and for a fixed step its rule (0: backward Euler, 1: trapezoidal); what
// it leaves out stays as SPICE has it (way 0, 1e-3, 1e-6 V, 1e-12 A;
// 100,000 rounds; time 0; steps chosen).
//
// What it did goes to the console: the way, the time points taken and
// those tried again, whether the run got to its end, the rounds in all
// and the most at one point, and how many steps the nodes took.
import files
import console
import decimal
import math
import circuit
import sources
import devices
import direct
import relax
import steps
import multirate
import game

capacity Bytes 268435456
capacity Node 2200000
capacity Two 3300000
capacity Touches 6600000
capacity Lines 3300000
capacity Numbers 16000000
capacity Nodes 2200000
capacity Devices 3300000
capacity Points 1000000
capacity Probes 2200000
capacity Initial 2200000
capacity Entries 24000000
capacity Solution 2300000
capacity Port 6600000
capacity Out 16000000
capacity Pts 16000000
capacity Base 2200000
capacity NodeCol 2200000
capacity LineCol 3300000
capacity GameNumbers 16000000
capacity GameTiles 2200000
capacity GameEdges 3300000
capacity GameCells 3300000
capacity GameWays 2200000

// `way`, `shown` and `most` as "run.txt" says, and the fixed step it
// gives and its rule (`step` 0: steps chosen). `refused`: what keeps the
// way from this circuit, said and nothing solved. `failed`: the run ended
// before its stop. `written`: some of the waves are in their file. The
// rounds and node steps in all, and the most rounds at one time point.
unique Run {
  way: i32, shown: bool, most: i32, step: f64, method: i32, refused: bool, failed: bool,
  written: bool, rounds: i64, most_rounds: i32, updates: i64, three: bool
}

world {
  Circuit.file = "circuit.net"
  Time.reltol = 0.001
  Time.vntol = 0.000001
  Time.abstol = 1e-12
  Run.most = 100000
  Run.shown = true
  Time.t = 0.0
  Multi.ratio = 16.0
}

system plan() {
  let size = read_file("run.txt", Bytes)
  if size > 0 {
    var at = 0
    var k = 0
    while k < 11 && at < len(Bytes) {
      let (value, next) = read_real(Bytes, at)
      if next > at {
        if k == 0 {
          // (Way 3 takes way 1's operating point.)
          Run.way = if value as i32 == 3 { 1 } else { value as i32 }
          Run.three = value as i32 == 3
        }
        if k == 2 { Run.shown = value != 0.0 }
        if k == 3 { Time.reltol = value }
        if k == 4 { Time.vntol = value }
        if k == 5 { Time.abstol = value }
        if k == 6 { Run.most = value as i32 }
        if k == 7 { Time.t = value }
        if k == 8 { Run.step = value }
        if k == 9 { Run.method = value as i32 }
        if k == 10 { Multi.ratio = value }
        at = next
      } else { at = len(Bytes) }
      k += 1
    }
  }
  Bytes = []
}

system said() {
  Run.refused = true
  if !Circuit.read {
    put("no circuit: the file {Circuit.file} is not where the program was started")
  } else if Circuit.wrong > 0 {
    put("the circuit's line {Circuit.wrong} makes no sense")
  } else if Circuit.clashing > 0 {
    put("{Circuit.clashing} nodes are held by two sources at once")
  } else if Run.way != 0 && Circuit.floating > 0 {
    put("way {Run.way} does not do a voltage source between two nodes that are not ground ({Circuit.floating} of them): way 0 does")
  } else {
    Run.refused = false
  }
  // (The operating point first; then steps, chosen or fixed.)
  Time.h = 0.0
  if Circuit.tran { Time.t = 0.0 }
  Step.adaptive = Run.step <= 0.0
  Step.trap = Run.method == 1
  if !Step.adaptive {
    Step.h = Run.step
    Step.first = Run.step
  }
  Bytes = []
}

// The time point's line: the time, then the probes; written out when
// there are many.
system written() {
  if Run.shown && !Run.refused && !Run.failed {
    write_real(Bytes, Time.t)
    for k in 0..len(Probes) {
      Bytes += { value: 32 }
      var value = 0.0 as f64
      if Probes[k].voltage {
        if let v = Node(Nodes[Probes[k].index].who).v { value = v }
      } else {
        if let i = Device(Devices[Probes[k].index].who).i { value = i }
      }
      write_real(Bytes, value)
    }
    Bytes += { value: 10 }
    if len(Bytes) > 16000000 {
      write_bytes("waves.txt", Bytes, 0, len(Bytes), Run.written)
      Run.written = true
      Bytes = []
    }
  }
}

// The waves not yet in their file, into it.
system flushed() {
  if Run.shown && !Run.refused && len(Bytes) > 0 {
    write_bytes("waves.txt", Bytes, 0, len(Bytes), Run.written)
    Run.written = true
    Bytes = []
  }
}

// Whether the time point settled, and the counts. A fixed step that does
// not settle ends the run (a chosen one is tried again, shorter).
system counted() {
  let rounds = if Run.way == 0 { Direct.rounds } else { Relax.round }
  Run.rounds += rounds as i64
  Run.most_rounds = max(Run.most_rounds, rounds)
  if Run.way != 0 { Run.updates += Relax.updates }
  Step.settled = if Run.way == 0 { Direct.settled }
                 else { Relax.unsettled == 0 && Relax.negative == 0 && Relax.cells == 0 }
  if Run.way != 0 && Relax.negative > 0 && Time.h <= 0.0 && !Run.refused {
    put("way {Run.way} does not do a node whose conductance is not above 0 ({Relax.negative} at the operating point): way 0 does")
    Run.refused = true
  }
  if !Step.settled && !Run.refused && (!Step.adaptive || Time.h <= 0.0) {
    Run.failed = true
    if Run.way == 0 && Direct.failed {
      put("way 0: the solve failed ({Direct.status}) at {Time.t} s")
    } else {
      put("way {Run.way}: the time point at {Time.t} s did not settle in {rounds} rounds")
    }
  }
}

system told_how() {
  if !Run.refused {
    let ended = !Circuit.tran || Step.t1 >= Circuit.stop - 1e-9 * Circuit.step
    put("way {Run.way}: {Step.points} time points, {Step.rejected} tried again, settled {ended && !Run.failed}, {Run.rounds} rounds, at most {Run.most_rounds} at one, {Run.updates} node steps")
  }
}

schedule setup() { plan() netlist() build() planned_steps() said() }
// A time point: begun, rounds until settled, ended.
schedule begun() {
  started() run_if Run.way == 0
  relax_started() run_if Run.way != 0
  held() run_if Run.way != 0
  companions()
  gathered() run_if Run.way == 2
  told() run_if Run.way == 2
  pivots() run_if Run.way == 2
  started_events() run_if Run.way == 2
}
schedule rounded() {
  companions() run_if Run.way != 2
  stamp() run_if Run.way == 0
  solved() run_if Run.way == 0
  taken() run_if Run.way == 0
  gathered() run_if Run.way == 1
  told() run_if Run.way == 1
  pivots() run_if Run.way == 1
  stepped() run_if Run.way == 1
  states() run_if Run.way == 1
  alone() run_if Run.way == 1
  moved() run_if Run.way == 2
  retold() run_if Run.way == 2
  states_told() run_if Run.way == 2
  alone_told() run_if Run.way == 2
  told_states() run_if Run.way == 2
  cells_failed() run_if Run.way != 0
  judged() run_if Run.way != 0
}
schedule ended() {
  counted()
  judged_step()
  decided()
  direct_currents() run_if Run.way == 0 && Step.taken
  gathered() run_if Run.way != 0 && Step.taken
  told() run_if Run.way != 0 && Step.taken
  relaxed_currents() run_if Run.way != 0 && Step.taken
  memristor_currents() run_if Step.taken
  written() run_if Step.taken
  accepted() run_if Step.taken
  restored() run_if !Step.taken
  stepped_on()
  cornered() run_if Step.taken
  next_step()
}
// Way 3 (multirate.ent).
system mr_way() { Run.way = 3 }

// The waves: the batch's points onto the grid's lines, and the lines every
// node is past written out.
system mr_lines() {
  Multi.low = Multi.end + 2
  for c: Clock { Multi.low min= c.t }
  if Run.shown && !Run.refused {
    let p = len(Probes)
    let kept = KEPT as i64
    let grid = Multi.grid
    let first = Multi.line
    for me, nd: Node, c: Clock in turn by c.col where c.took {
      var line = (c.tprev / grid + 1) * grid
      while line <= c.t {
        let slot = ((line / grid) % kept) as i32
        if line - first >= kept * grid { Multi.lost += 1 }
        else {
          if c.col >= 0 { Out[slot * p + c.col].v = between(c.tprev, c.vprev, c.t, nd.v, line) }
          for (me)-[q: Port]->(d) {
            if q.col >= 0 { Out[slot * p + q.col].v = between(c.tprev, q.ip, c.t, q.ic, line) }
          }
        }
        line += grid
      }
    }
    while Multi.line <= Multi.low && Multi.line <= Multi.end {
      let slot = ((Multi.line / grid) % kept) as i32
      write_real(Bytes, (Multi.line as f64) * Multi.unit)
      for k in 0..p {
        Bytes += { value: 32 }
        write_real(Bytes, Out[slot * p + k].v)
      }
      Bytes += { value: 10 }
      Multi.line += grid
      if len(Bytes) > 16000000 {
        write_bytes("waves.txt", Bytes, 0, len(Bytes), Run.written)
        Run.written = true
        Bytes = []
      }
    }
  }
}

system mr_told() {
  if !Run.refused && !Multi.refused {
    put("way 3: {Multi.batches} batches, {Multi.tried} node steps tried, {Multi.steps} taken, {Multi.rejected} tried again, {Multi.failed} not settled, {Multi.rounds} rounds, {Multi.evals} device evaluations, settled {Multi.done && !Run.failed}" +
        (if Multi.lost > 0 { ", {Multi.lost} points past the lines kept" } else { "" }))
  }
}

// Way 3, after the operating point: batch by batch.
schedule mr_setup() {
  mr_way() run_if Run.three && Circuit.tran && !Run.refused && !Run.failed
  mr_clocked() run_if Run.three && Circuit.tran && !Run.refused && !Run.failed
  mr_ported() run_if Run.three && Circuit.tran && !Run.refused && !Run.failed
  mr_started() run_if Run.three && Circuit.tran && !Run.refused && !Run.failed
  mr_seen() run_if Run.three && Circuit.tran && !Run.refused && !Run.failed
  game_read() run_if Run.way == 3 && !Multi.refused
}
schedule mr_ticked() {
  mr_chosen() run_if Run.way == 3
  mr_marked() run_if Run.way == 3
  mr_primed() run_if Run.way == 3
}
schedule mr_round() {
  mr_swept() run_if Run.way == 3
  mr_guessed() run_if Run.way == 3
}
schedule mr_ended() {
  mr_closed() run_if Run.way == 3
  mr_seen() run_if Run.way == 3
  mr_capped() run_if Run.way == 3
  mr_seen() run_if Run.way == 3
  mr_lines() run_if Run.way == 3
  game_played() run_if Run.way == 3 && Game.on && Multi.low >= Game.next
}
schedule done() {
  flushed()
  told_how() run_if Run.way != 3
  mr_told() run_if Run.way == 3
}

main {
  setup()
  loop {
    begun()
    loop { rounded() } until Run.refused ||
      (Run.way == 0 && (Direct.settled || Direct.failed || Direct.rounds >= 50)) ||
      (Run.way != 0 && (Relax.unsettled == 0 || Relax.round >= Run.most || Relax.alone >= 50 ||
                        Relax.negative > 0 || Relax.cells > 0))
    ended()
  } until Run.refused || Run.failed || Step.done || (Run.three && Step.points >= 1)
  mr_setup()
  loop {
    mr_ticked()
    loop { mr_round() } until Run.way != 3 || Multi.unsettled == 0 || Multi.round >= 60
    mr_ended()
  } until Run.way != 3 || Multi.done || Multi.refused || Run.refused || Run.failed
  done()
}

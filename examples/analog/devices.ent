// What each kind of device does at a time point, shared by every way of
// solving one (spec section 6.1): each device that is no source makes
// itself straight for the voltages its nodes have now, its `Companion`:
// the current through it from a to b is g * (va - vb) + i0 near them.
// Way 0 puts that into its matrix, ways 1 and 2 add it up at the nodes.
//
//   schedule ... { companions() ... }
//
// Every node also has `GMIN` to ground, as SPICE gives it, in every way,
// so that each has a conductance to something. At the operating point a
// capacitor is open (a conductance of 0); at a time point h after the
// last it is backward Euler's companion: i = C/h * (v - v_prev), a
// conductance C/h and a current -q_prev/h (milestone M2). A memristor,
// of whichever model, is made straight at its voltage and state, and its
// state's equation beside (milestone M3).
//
//   accepted()   after a time point: what the capacitors and nodes had
import circuit
import math

const GMIN: f64 = 1e-12
// What holds a node of `.ic` at its voltage in the operating point (SPICE3's).
const HOLD: f64 = 1e10

// The time the sources are taken at, and the step to it from the last
// time point (0 at the operating point); and the tolerances a time point
// is solved to (spec 7.1): a node has settled where it moves by no more
// than reltol of its voltage and vntol, and the current into it is no
// more than reltol of the largest of its devices' and abstol.
// `trap`: this step goes by the trapezoidal rule, not backward Euler.
unique Time { t: f64, h: f64, trap: bool, reltol: f64, vntol: f64, abstol: f64 }

// What a memristor of each model does at the voltage v across it and the
// state w, made straight for a Newton step (spec 7.3), from its model's
// .va file in models/: its current i from a to b, how that grows with v
// (`g`) and with w (`gw`); and backward Euler's equation for its state over
// a step h, w - w_prev - h * rate(v, w) = 0: what that comes to (`f`) and
// how it grows with w (`jw`) and with v (`jv`). At the operating point
// (h = 0) the state is held: f = w - w_prev.
fn held_state(w: f64, w_prev: f64, h: f64, trap: bool, rate_prev: f64, rate: f64, rate_w: f64,
              rate_v: f64) -> (f64, f64, f64) {
  if h <= 0.0 { (w - w_prev, 1.0 as f64, 0.0 as f64) }
  else if trap {
    (w - w_prev - h / 2.0 * (rate + rate_prev), 1.0 - h / 2.0 * rate_w, -h / 2.0 * rate_v)
  } else { (w - w_prev - h * rate, 1.0 - h * rate_w, -h * rate_v) }
}

fn sinh64(x: f64) -> f64 { (exp64(x) - exp64(-x)) / 2.0 }
fn cosh64(x: f64) -> f64 { (exp64(x) + exp64(-x)) / 2.0 }

// The resistance of a Biolek memristor in the state w (0: all Roff, 1:
// all Ron).
fn biolek_resistance(ron: f64, roff: f64, w: f64) -> f64 { ron * w + roff * (1.0 - w) }

// Biolek (models/biolek.va): rate = uv * Ron / D^2 * i * (1 - (w - s)^(2p)),
// s 1 where the current is below 0, else 0; the window's step at i = 0 is
// taken as not growing with v.
fn biolek_equation(ron: f64, roff: f64, d: f64, uv: f64, p: f64, w: f64, w_prev: f64,
                   v: f64, h: f64,
    trap: bool, rate_prev: f64) -> (f64, f64, f64, f64, f64, f64, f64) {
  let r = biolek_resistance(ron, roff, w)
  let i = v / r
  let gw = -v * (ron - roff) / (r * r)
  let s = if i < 0.0 { 1.0 as f64 } else { 0.0 as f64 }
  let window = 1.0 - pow64(w - s, 2.0 * p)
  let slope = -2.0 * p * pow64(w - s, 2.0 * p - 1.0)
  let k = uv * ron / (d * d)
  let (f, jw, jv) = held_state(w, w_prev, h, trap, rate_prev, k * i * window, k * (gw * window + i * slope),
                               k * window / r)
  (i, 1.0 / r, gw, f, jw, jv, k * i * window)
}

// VTEAM (models/vteam.va): a straight resistance from Ron at w_on to Roff
// at w_off; the state moves only past the thresholds.
fn vteam_equation(ron: f64, roff: f64, k_off: f64, k_on: f64, alpha_off: f64, alpha_on: f64,
                  v_off: f64, v_on: f64, w_on: f64, w_off: f64, a_on: f64, a_off: f64,
                  w_c: f64, w: f64, w_prev: f64, v: f64, h: f64,
    trap: bool, rate_prev: f64) -> (f64, f64, f64, f64, f64, f64, f64) {
  let r = ron + (roff - ron) * (w - w_on) / (w_off - w_on)
  let i = v / r
  let gw = -v / (r * r) * (roff - ron) / (w_off - w_on)
  var rate = 0.0 as f64
  var rate_v = 0.0 as f64
  var rate_w = 0.0 as f64
  if v > v_off {
    let base = v / v_off - 1.0
    let near = exp64((w - a_off) / w_c)
    let window = exp64(-near)
    rate = k_off * pow64(base, alpha_off) * window
    rate_v = k_off * alpha_off * pow64(base, alpha_off - 1.0) / v_off * window
    rate_w = rate * (-near / w_c)
  } else if v < v_on {
    let base = v / v_on - 1.0
    let near = exp64(-(w - a_on) / w_c)
    let window = exp64(-near)
    rate = k_on * pow64(base, alpha_on) * window
    rate_v = k_on * alpha_on * pow64(base, alpha_on - 1.0) / v_on * window
    rate_w = rate * (near / w_c)
  }
  let (f, jw, jv) = held_state(w, w_prev, h, trap, rate_prev, rate, rate_w, rate_v)
  (i, 1.0 / r, gw, f, jw, jv, rate)
}

// Yakopcic (models/yakopcic.va): a current of sinh, a drive past the
// thresholds and a window that slows the state near its ends.
fn yakopcic_equation(a1: f64, a2: f64, b: f64, ap: f64, an: f64, vp: f64, vn: f64, xp: f64,
                     xn: f64, alphap: f64, alphan: f64, eta: f64, w: f64, w_prev: f64, v: f64,
                     h: f64,
    trap: bool, rate_prev: f64) -> (f64, f64, f64, f64, f64, f64, f64) {
  let a = if v >= 0.0 { a1 } else { a2 }
  let i = a * w * sinh64(b * v)
  let g = a * w * b * cosh64(b * v)
  let gw = a * sinh64(b * v)
  var drive = 0.0 as f64
  var drive_v = 0.0 as f64
  if v > vp {
    drive = ap * (exp64(v) - exp64(vp))
    drive_v = ap * exp64(v)
  } else if v < -vn {
    drive = -an * (exp64(-v) - exp64(vn))
    drive_v = an * exp64(-v)
  }
  var window = 1.0 as f64
  var window_w = 0.0 as f64
  if eta * v > 0.0 && w >= xp {
    let fall = exp64(-alphap * (w - xp))
    window = fall * ((xp - w) / (1.0 - xp) + 1.0)
    window_w = -alphap * window - fall / (1.0 - xp)
  } else if eta * v <= 0.0 && w <= 1.0 - xn {
    let rise = exp64(alphan * (w + xn - 1.0))
    window = rise * w / (1.0 - xn)
    window_w = alphan * window + rise / (1.0 - xn)
  }
  let (f, jw, jv) = held_state(w, w_prev, h, trap, rate_prev, eta * drive * window, eta * drive * window_w,
                               eta * drive_v * window)
  (i, g, gw, f, jw, jv, eta * drive * window)
}

// The IHP RRAM cell (models/rram.va): the enhanced Stanford-PKU model, its
// state the filament's gap over its largest, held in [zmin, 1] by the
// window over `delta`.
fn rram_equation(i0: f64, u0: f64, g0: f64, gmax: f64, v0: f64, ea: f64, da: f64, dox: f64,
                 t0: f64, rth: f64, gamma0: f64, gammar: f64, beta: f64, alpha: f64, gbar: f64,
                 uth: f64, emin: f64, ewidth: f64, ug: f64, ug0: f64, uhat: f64, zeta: f64, wl: f64,
                 eth: f64, dth: f64, rmax: f64, delta: f64, w: f64, w_prev: f64, v: f64, h: f64,
    trap: bool, rate_prev: f64) -> (f64, f64, f64, f64, f64, f64, f64) {
  let kq = (1.602176634e-19 as f64) / (1.38e-23 as f64)
  let e = exp64(-w * gmax / g0)
  let i = i0 * e * sinh64(v / u0)
  let g = i0 * e * cosh64(v / u0) / u0
  let gw = -gmax / g0 * i
  // The temperature, and how it grows with v and w.
  let temp = t0 + rth * v * i
  let temp_v = rth * (i + v * g)
  let temp_w = rth * v * gw
  let up = v >= 0.0
  let speed = if up { v0 } else { v0 / pow64(zeta, (ug - ug0) / uhat) }
  // (The rate's gap taken within [zmin, 1], as in rram.va: past 1.2
  // gamma is below 0, and the rate and the window with it would be 0.)
  let zmin = (wl / (eth * ug) + dth) / gmax
  let inside = w >= zmin && w <= 1.0
  let ratio = min(max(w, zmin), 1.0) * gmax / gbar
  let gam0 = (if up { gamma0 } else { gammar }) - beta * pow64(ratio, alpha)
  let gam0_w = if inside { -beta * alpha * pow64(ratio, alpha - 1.0) * gmax / gbar } else { 0.0 as f64 }
  // (The step in the field, a logistic over ewidth.)
  let sv = if v > 0.0 { 1.0 as f64 } else if v < 0.0 { -1.0 as f64 } else { 0.0 as f64 }
  let s = 1.0 / (1.0 + exp64(min(-(gam0 * abs64(v) / dox - emin) / ewidth, 700.0)))
  let s_a = s * (1.0 - s) / (dox * ewidth)
  let gam = gam0 * s
  let gam_w = gam0_w * s + gam0 * s_a * gam0_w * abs64(v)
  let gam_v = gam0 * s_a * gam0 * sv
  let drive = v - sv * uth
  let c = da / dox * kq
  let x = gam * c * drive / temp
  let act = exp64(-ea * kq / temp)
  let k = -speed / gmax
  let free = k * act * sinh64(x)
  // (How that grows with the temperature: through the activation and x.)
  let free_t = k * (act * ea * kq / (temp * temp) * sinh64(x) - act * cosh64(x) * x / temp)
  let free_v = k * act * cosh64(x) * (gam + gam_v * drive) * c / temp + free_t * temp_v
  let free_w = k * act * cosh64(x) * gam_w * c * drive / temp + free_t * temp_w
  // Capped smoothly at rmax.
  let den = 1.0 + abs64(free) / rmax
  let raw = free / den
  let raw_v = free_v / (den * den)
  let raw_w = free_w / (den * den)
  var window = 1.0 as f64
  var window_w = 0.0 as f64
  // (Past an end, the straight line that continues the window turns the
  // state back.)
  if raw < 0.0 {
    if w >= zmin {
      let ex = exp64(-(w - zmin) / delta)
      window = 1.0 - ex
      window_w = ex / delta
    } else {
      window = (w - zmin) / delta
      window_w = 1.0 / delta
    }
  } else {
    if w <= 1.0 {
      let ex = exp64(-(1.0 - w) / delta)
      window = 1.0 - ex
      window_w = -ex / delta
    } else {
      window = (1.0 - w) / delta
      window_w = -1.0 / delta
    }
  }
  let rate = raw * window
  let (f, jw, jv) = held_state(w, w_prev, h, trap, rate_prev, rate, raw_w * window + raw * window_w,
                               raw_v * window)
  (i, g, gw, f, jw, jv, rate)
}

// tanh, and a step over `width` about 0 (the Heaviside steps of
// models/growth.va and prune.va: 3 y^2 - 2 y^3, y from 0 to 1 across it)
// with how it grows with its argument.
fn tanh64(x: f64) -> f64 {
  let e = exp64(-2.0 * abs64(x))
  if x >= 0.0 { (1.0 - e) / (1.0 + e) } else { (e - 1.0) / (1.0 + e) }
}
fn step64(x: f64, width: f64) -> f64 {
  let y = min(max(x / width + 0.5, 0.0), 1.0)
  y * y * (3.0 - 2.0 * y)
}
fn step64_x(x: f64, width: f64) -> f64 {
  let y = min(max(x / width + 0.5, 0.0), 1.0)
  6.0 * y * (1.0 - y) / width
}

// The ion channels of a Morris-Lecar oscillator (models/ml.va).
fn ml_equation(gl: f64, el: f64, gna: f64, ena: f64, una1: f64, una2: f64, gk: f64, ek: f64,
               uk1: f64, uk2: f64, fk: f64, w: f64, w_prev: f64, v: f64, h: f64,
    trap: bool, rate_prev: f64) -> (f64, f64, f64, f64, f64, f64, f64) {
  let tn = tanh64((v - una1) / una2)
  let gn = gna / 2.0 * (1.0 + tn)
  let i = gl * (v - el) + gn * (v - ena) + w * gk * (v - ek)
  let g = gl + gn + gna / 2.0 * (1.0 - tn * tn) / una2 * (v - ena) + w * gk
  let gw = gk * (v - ek)
  let x = (v - uk1) / (2.0 * uk2)
  let speed = fk * cosh64(x)
  let tk = tanh64((v - uk1) / uk2)
  let open = (1.0 + tk) / 2.0
  let rate = speed * (open - w)
  let rate_v = fk * sinh64(x) / (2.0 * uk2) * (open - w) + speed * (1.0 - tk * tk) / (2.0 * uk2)
  let (f, jw, jv) = held_state(w, w_prev, h, trap, rate_prev, rate, -speed, rate_v)
  (i, g, gw, f, jw, jv, rate)
}

// A synapse (models/synapse.va).
fn synapse_equation(gs1: f64, gs0: f64, us1: f64, us2: f64, fs: f64, w: f64, w_prev: f64,
                    v: f64, h: f64, trap: bool, rate_prev: f64) -> (f64, f64, f64, f64, f64, f64, f64) {
  let g = gs1 * w + gs0
  let ts = tanh64((v - us1) / us2)
  let rate = fs * ((1.0 + ts) / 2.0 - w)
  let (f, jw, jv) = held_state(w, w_prev, h, trap, rate_prev, rate, -fs, fs * (1.0 - ts * ts) / (2.0 * us2))
  (g * v, g, gs1 * v, f, jw, jv, rate)
}

// The memristor of a memsensor (models/growth.va).
fn growth_equation(m0: f64, m1: f64, s: f64, sr: f64, uplus: f64, uminus: f64, width: f64,
                   delta: f64, w: f64, w_prev: f64, v: f64, h: f64,
    trap: bool, rate_prev: f64) -> (f64, f64, f64, f64, f64, f64, f64) {
  let m = m1 + w * (m0 - m1)
  let raw = s * (step64(v - uplus, width) - step64(uminus - v, width)) - sr
  let raw_v = s * (step64_x(v - uplus, width) + step64_x(uminus - v, width))
  var window = 1.0 as f64
  var window_w = 0.0 as f64
  if raw < 0.0 {
    if w >= 0.0 {
      let ex = exp64(-w / delta)
      window = 1.0 - ex
      window_w = ex / delta
    } else {
      window = w / delta
      window_w = 1.0 / delta
    }
  } else {
    if w <= 1.0 {
      let ex = exp64(-(1.0 - w) / delta)
      window = 1.0 - ex
      window_w = -ex / delta
    } else {
      window = (1.0 - w) / delta
      window_w = -1.0 / delta
    }
  }
  let rate = raw * window
  let (f, jw, jv) = held_state(w, w_prev, h, trap, rate_prev, rate, raw * window_w, raw_v * window)
  (v / m, 1.0 / m, -v * (m0 - m1) / (m * m), f, jw, jv, rate)
}

// The pruning-cue sensor of a memsensor (models/prune.va): its state moves
// with the voltages vc and vd of its control nodes, not the voltage v
// across it, so `jv` is how its equation grows with vc; with vd it grows
// by `prune_jd`.
fn prune_equation(rp0: f64, rp1: f64, eta1: f64, eta2: f64, factor: f64, factor2: f64,
                  alpha: f64, beta: f64, uth: f64, width: f64, w: f64, w_prev: f64, v: f64,
                  vc: f64, vd: f64, h: f64,
    trap: bool, rate_prev: f64) -> (f64, f64, f64, f64, f64, f64, f64) {
  let tp = tanh64((w - eta1) / eta2)
  let r = rp0 + rp1 * (1.0 + tp)
  let r_w = rp1 * (1.0 - tp * tp) / eta2
  let rate = alpha * (factor * step64(vc - uth, width) + factor2 * step64(vd - uth, width)) -
             beta * w
  let (f, jw, jv) = held_state(w, w_prev, h, trap, rate_prev, rate, -beta,
                               alpha * factor * step64_x(vc - uth, width))
  (v / r, 1.0 / r, -v / (r * r) * r_w, f, jw, jv, rate)
}
fn prune_jd(factor2: f64, alpha: f64, uth: f64, width: f64, vd: f64, h: f64, trap: bool) -> f64 {
  let (f, jw, jd) = held_state(0.0, 0.0, h, trap, 0.0, 0.0, 0.0,
                               alpha * factor2 * step64_x(vd - uth, width))
  jd
}

// The current from a to b through a device so made, and through a source
// of `level` that is no voltage source.
fn current(g: f64, i0: f64, va: f64, vb: f64) -> f64 { g * (va - vb) + i0 }

system companions() {
  for r: Resistor, c: mut Companion {
    c.g = r.g
    c.i0 = 0.0
  }
  // (Backward Euler: i = C/h (v - v_prev); trapezoidal: i = 2C/h (v -
  // v_prev) - i_prev.)
  for k: Capacitor, c: mut Companion {
    if Time.h <= 0.0 {
      c.g = 0.0
      c.i0 = 0.0
    } else if Time.trap {
      c.g = 2.0 * k.c / Time.h
      c.i0 = -2.0 * k.q_prev / Time.h - k.i_prev
    } else {
      c.g = k.c / Time.h
      c.i0 = -k.q_prev / Time.h
    }
  }
  // A memristor, of each model: made straight at the voltage across it
  // and its state.
  for t: Two, m: mut Memristor, k: Biolek, c: mut Companion {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = biolek_equation(k.ron, k.roff, k.d, k.uv, k.p, m.w, m.w_prev, va - vb,
                                                    Time.h, Time.trap, m.rate_prev)
        m.i = i
        m.g = g
        m.gw = gw
        m.f = f
        m.jw = jw
        m.jv = jv
        c.g = g
        c.i0 = i - g * (va - vb)
      }
    }
  }
  for t: Two, m: mut Memristor, k: Vteam, c: mut Companion {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = vteam_equation(k.ron, k.roff, k.k_off, k.k_on, k.alpha_off,
                                                   k.alpha_on, k.v_off, k.v_on, k.w_on, k.w_off,
                                                   k.a_on, k.a_off, k.w_c, m.w, m.w_prev, va - vb,
                                                   Time.h, Time.trap, m.rate_prev)
        m.i = i
        m.g = g
        m.gw = gw
        m.f = f
        m.jw = jw
        m.jv = jv
        c.g = g
        c.i0 = i - g * (va - vb)
      }
    }
  }
  for t: Two, m: mut Memristor, k: Yakopcic, c: mut Companion {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = yakopcic_equation(k.a1, k.a2, k.b, k.ap, k.an, k.vp, k.vn, k.xp,
                                                      k.xn, k.alphap, k.alphan, k.eta, m.w, m.w_prev,
                                                      va - vb, Time.h, Time.trap, m.rate_prev)
        m.i = i
        m.g = g
        m.gw = gw
        m.f = f
        m.jw = jw
        m.jv = jv
        c.g = g
        c.i0 = i - g * (va - vb)
      }
    }
  }
  for t: Two, m: mut Memristor, k: Rram, c: mut Companion {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = rram_equation(k.i0, k.u0, k.g0, k.gmax, k.v0, k.ea, k.da, k.dox, k.t0, k.rth,
                                                 k.gamma0, k.gammar, k.beta, k.alpha, k.gbar, k.uth, k.emin, k.ewidth,
                                                 k.ug, k.ug0, k.uhat, k.zeta, k.wl, k.eth, k.dth, k.rmax, k.delta,
                                                 m.w, m.w_prev, va - vb, Time.h, Time.trap, m.rate_prev)
        m.i = i
        m.g = g
        m.gw = gw
        m.f = f
        m.jw = jw
        m.jv = jv
        c.g = g
        c.i0 = i - g * (va - vb)
      }
    }
  }
  for t: Two, m: mut Memristor, k: Ml, c: mut Companion {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = ml_equation(k.gl, k.el, k.gna, k.ena, k.una1, k.una2, k.gk, k.ek, k.uk1, k.uk2, k.fk,
                                                 m.w, m.w_prev, va - vb, Time.h, Time.trap, m.rate_prev)
        m.i = i
        m.g = g
        m.gw = gw
        m.f = f
        m.jw = jw
        m.jv = jv
        c.g = g
        c.i0 = i - g * (va - vb)
      }
    }
  }
  for t: Two, m: mut Memristor, k: Synapse, c: mut Companion {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = synapse_equation(k.gs1, k.gs0, k.us1, k.us2, k.fs,
                                                 m.w, m.w_prev, va - vb, Time.h, Time.trap, m.rate_prev)
        m.i = i
        m.g = g
        m.gw = gw
        m.f = f
        m.jw = jw
        m.jv = jv
        c.g = g
        c.i0 = i - g * (va - vb)
      }
    }
  }
  for t: Two, m: mut Memristor, k: Growth, c: mut Companion {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = growth_equation(k.m0, k.m1, k.s, k.sr, k.uplus, k.uminus, k.width, k.delta,
                                                 m.w, m.w_prev, va - vb, Time.h, Time.trap, m.rate_prev)
        m.i = i
        m.g = g
        m.gw = gw
        m.f = f
        m.jw = jw
        m.jv = jv
        c.g = g
        c.i0 = i - g * (va - vb)
      }
    }
  }
  // (The pruning-cue sensor: its state by its control nodes' voltages.)
  for t: Two, m: mut Memristor, k: Prune, e: mut Sensing, c: mut Companion {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        if let vc = Node(e.c).v {
          if let vd = Node(e.d).v {
            let (i, g, gw, f, jw, jv, rate) = prune_equation(k.rp0, k.rp1, k.eta1, k.eta2,
                                                      k.factor, k.factor2, k.alpha, k.beta, k.uth,
                                                      k.width, m.w, m.w_prev, va - vb, vc, vd,
                                                      Time.h, Time.trap, m.rate_prev)
            m.i = i
            m.g = g
            m.gw = gw
            m.f = f
            m.jw = jw
            m.jv = jv
            e.jd = prune_jd(k.factor2, k.alpha, k.uth, k.width, vd, Time.h, Time.trap)
            c.g = g
            c.i0 = i - g * (va - vb)
          }
        }
      }
    }
  }
}

// The current through every memristor from a to b, at its nodes' voltages
// and its state now, for the probes; and how fast its state moves there.
system memristor_currents() {
  for t: Two, m: mut Memristor, k: Biolek, d: mut Device {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = biolek_equation(k.ron, k.roff, k.d, k.uv, k.p, m.w,
                                                    m.w_prev, va - vb, 0.0, false, 0.0)
        d.i = i
        m.rate = rate
      }
    }
  }
  for t: Two, m: mut Memristor, k: Vteam, d: mut Device {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = vteam_equation(k.ron, k.roff, k.k_off, k.k_on, k.alpha_off,
                                                   k.alpha_on, k.v_off, k.v_on, k.w_on, k.w_off,
                                                   k.a_on, k.a_off, k.w_c, m.w, m.w_prev, va - vb, 0.0, false, 0.0)
        d.i = i
        m.rate = rate
      }
    }
  }
  for t: Two, m: mut Memristor, k: Yakopcic, d: mut Device {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = yakopcic_equation(k.a1, k.a2, k.b, k.ap, k.an, k.vp, k.vn, k.xp,
                                                      k.xn, k.alphap, k.alphan, k.eta, m.w, m.w_prev,
                                                      va - vb, 0.0, false, 0.0)
        d.i = i
        m.rate = rate
      }
    }
  }
  for t: Two, m: mut Memristor, k: Rram, d: mut Device {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = rram_equation(k.i0, k.u0, k.g0, k.gmax, k.v0, k.ea, k.da, k.dox, k.t0, k.rth,
                                                 k.gamma0, k.gammar, k.beta, k.alpha, k.gbar, k.uth, k.emin, k.ewidth,
                                                 k.ug, k.ug0, k.uhat, k.zeta, k.wl, k.eth, k.dth, k.rmax, k.delta,
                                                 m.w, m.w_prev, va - vb, 0.0, false, 0.0)
        d.i = i
        m.rate = rate
      }
    }
  }
  for t: Two, m: mut Memristor, k: Ml, d: mut Device {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = ml_equation(k.gl, k.el, k.gna, k.ena, k.una1, k.una2, k.gk, k.ek, k.uk1, k.uk2, k.fk,
                                                 m.w, m.w_prev, va - vb, 0.0, false, 0.0)
        d.i = i
        m.rate = rate
      }
    }
  }
  for t: Two, m: mut Memristor, k: Synapse, d: mut Device {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = synapse_equation(k.gs1, k.gs0, k.us1, k.us2, k.fs,
                                                 m.w, m.w_prev, va - vb, 0.0, false, 0.0)
        d.i = i
        m.rate = rate
      }
    }
  }
  for t: Two, m: mut Memristor, k: Growth, d: mut Device {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        let (i, g, gw, f, jw, jv, rate) = growth_equation(k.m0, k.m1, k.s, k.sr, k.uplus, k.uminus, k.width, k.delta,
                                                 m.w, m.w_prev, va - vb, 0.0, false, 0.0)
        d.i = i
        m.rate = rate
      }
    }
  }
  for t: Two, m: mut Memristor, k: Prune, e: Sensing, d: mut Device {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        if let vc = Node(e.c).v {
          if let vd = Node(e.d).v {
            let (i, g, gw, f, jw, jv, rate) = prune_equation(k.rp0, k.rp1, k.eta1, k.eta2,
                                                      k.factor, k.factor2, k.alpha, k.beta, k.uth,
                                                      k.width, m.w, m.w_prev, va - vb, vc, vd, 0.0,
                                                      false, 0.0)
            d.i = i
            m.rate = rate
          }
        }
      }
    }
  }
}

// A time point is taken: its voltages, charges and states are the ones
// the next step starts from.
system accepted() {
  for n: mut Node { n.v_prev = n.v }
  for m: mut Memristor {
    m.w3 = m.w2
    m.w2 = m.w_prev
    m.w_prev = m.w
    m.rate_prev = m.rate
  }
  for t: Two, k: mut Capacitor, c: Companion {
    if let va = Node(t.a).v {
      if let vb = Node(t.b).v {
        k.v3 = k.v2
        k.v2 = k.q_prev / k.c
        k.q_prev = k.c * (va - vb)
        k.i_prev = current(c.g, c.i0, va, vb)
      }
    }
  }
}

// A time point is not taken: the next try starts from the last one.
system restored() {
  for n: mut Node { n.v = n.v_prev }
  for m: mut Memristor { m.w = m.w_prev }
}

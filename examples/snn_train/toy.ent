// e-prop on a task made up for it, which needs no download (toy_data.ent):
// A then B or B then A, told apart in a quiet window at the end.
//
//   tools/ent run examples/snn_train/toy.ent
//
// A line for each epoch: the loss and how many of the training samples
// were right as the network learned them, then how many of the test
// samples, which it does not learn from. At the end a checksum of the
// weights (the same on one core and on all, and the same as
// check/toy.c's: test/Integration/snn_train.test).
import console
import network
import learn
import train
import toy_data

schedule start() {
  setup()
}

schedule finish() {
  checksum()
}

schedule sample() {
  label()
  rest()
}

schedule step() {
  window()
  encode()
  propagate()
  traces()
  integrate()
  read_out()
  soft_max()
  error()
  broadcast() run_if Clock.training
  learn() run_if Clock.training
  learn_out() run_if Clock.training
  tick()
}

schedule boundary() run_if Clock.step == Run.steps {
  score()
  forget() run_if Clock.training
  due()
  apply()
  next()
  report() run_if Clock.reported
  sample()
}

main {
  start()
  sample()
  loop {
    step()
    boundary()
  } until Clock.epoch == Run.epochs
  finish()
}

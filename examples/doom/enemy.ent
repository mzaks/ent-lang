//
// The player moved (p_user.c, and what of p_map.c, p_maputl.c and
// What the things of a level do in a tic, each in its turn (p_tick.c:
// P_RunThinkers; p_mobj.c: P_MobjThinker, P_SetMobjState), and of what
// monsters do (p_enemy.c, p_sight.c): they look for the player, and
// walk after the player once they have seen it. (Not yet: that they
// attack, and are hurt.)
//
// The things take their turns in the order they were made in, the
// player's among them: one that comes after another finds that one where
// its turn left it. The procs here and in play.ent are given the things
// (`things: mut Mobj`) and the one whose turn it is (`me`), and read and
// set them where they are.
import files
import wad
import fixed
import tables
import angles
import random
import info
import level
import data
import render
import things
import demo
import items
import play

const MELEERANGE = 64 * FRACUNIT
// Some of the sounds a monster makes on seeing the player are one of
// several, drawn (sounds.h).
const SFX_POSIT1 = 36
const SFX_POSIT3 = 38
const SFX_BGSIT1 = 39
const SFX_BGSIT2 = 40

// How far a thing gets in a step each of the eight ways, for a speed of
// one.
table xspeed: i32 = [65536, 47000, 0, -47000, -65536, -47000, 0, 47000]
table yspeed: i32 = [0, 47000, 65536, 47000, 0, -47000, -65536, -47000]
// The way back of each (and of none, none), and the four ways between:
// north-west, north-east, south-west, south-east.
table opposite: i32 = [4, 5, 6, 7, 0, 1, 2, 3, 8]
table diags: i32 = [3, 1, 5, 7]

// A line of sight, one row: from where, how far, to where; the height
// of the eye, and how steeply it can still look up and down.
buffer Sight {
  x: i32, y: i32, dx: i32, dy: i32, t2x: i32, t2y: i32, zstart: i32,
  top: i32, bottom: i32
} capacity 1

// Which side of a line a point is on: 0 its front, 1 its back, 2 on it
// (P_DivlineSide, with what it gets wrong of a line that goes across).
fn divline_side(x: i32, y: i32, nx: i32, ny: i32, ndx: i32, ndy: i32) -> i32 {
  if ndx == 0 {
    if x == nx { 2 } else if x <= nx { (ndy > 0) as i32 } else { (ndy < 0) as i32 }
  } else if ndy == 0 {
    if x == ny { 2 } else if y <= ny { (ndx < 0) as i32 } else { (ndx > 0) as i32 }
  } else {
    let left = (ndy >> FRACBITS) * ((x - nx) >> FRACBITS)
    let right = ((y - ny) >> FRACBITS) * (ndx >> FRACBITS)
    if right < left { 0 } else if left == right { 2 } else { 1 }
  }
}

// Whether the line of sight gets through a subsector: no wall of it is
// in the way, and no opening too low or too high (P_CrossSubsector).
proc cross_subsector(lines: mut Lines, sectors: Sectors,
                     subsectors: Subsectors, segs: Segs, sight: mut Sight,
                     validcount: i32, num: i32) -> bool {
  var through = true
  let first = subsectors[num].firstline
  for i in 0..subsectors[num].numlines {
    let line = segs[first + i].line
    if through && lines[line].validcount != validcount {
      lines[line].validcount = validcount
      let s1 = divline_side(lines[line].x1, lines[line].y1, sight[0].x,
                            sight[0].y, sight[0].dx, sight[0].dy)
      let s2 = divline_side(lines[line].x2, lines[line].y2, sight[0].x,
                            sight[0].y, sight[0].dx, sight[0].dy)
      if s1 != s2 {
        let dx = lines[line].x2 - lines[line].x1
        let dy = lines[line].y2 - lines[line].y1
        let t1 = divline_side(sight[0].x, sight[0].y, lines[line].x1,
                              lines[line].y1, dx, dy)
        let t2 = divline_side(sight[0].t2x, sight[0].t2y, lines[line].x1,
                              lines[line].y1, dx, dy)
        if t1 != t2 {
          if lines[line].backsector < 0 || lines[line].flags & ML_TWOSIDED == 0 {
            through = false
          } else {
            let front = segs[first + i].front
            let back = segs[first + i].back
            let ffloor = sectors[front].floorheight
            let bfloor = sectors[back].floorheight
            let fceiling = sectors[front].ceilingheight
            let bceiling = sectors[back].ceilingheight
            if ffloor != bfloor || fceiling != bceiling {
              let opentop = min(fceiling, bceiling)
              let openbottom = max(ffloor, bfloor)
              if openbottom >= opentop {
                through = false
              } else {
                // (P_InterceptVector2.)
                let den = fixed_mul(dy >> 8, sight[0].dx) -
                          fixed_mul(dx >> 8, sight[0].dy)
                let frac = if den == 0 {
                  0
                } else {
                  fixed_div(fixed_mul((lines[line].x1 - sight[0].x) >> 8, dy) +
                                fixed_mul((sight[0].y - lines[line].y1) >> 8, dx),
                            den)
                }
                if ffloor != bfloor {
                  sight[0].bottom max= fixed_div(openbottom - sight[0].zstart, frac)
                }
                if fceiling != bceiling {
                  sight[0].top min= fixed_div(opentop - sight[0].zstart, frac)
                }
                if sight[0].top <= sight[0].bottom { through = false }
              }
            }
          }
        }
      }
    }
  }
  through
}

// And through what is under a node: the side it starts on, and the
// other if it ends there (P_CrossBSPNode).
proc cross_bsp_node(lines: mut Lines, sectors: Sectors,
                    subsectors: Subsectors, segs: Segs, nodes: Nodes,
                    sight: mut Sight, validcount: i32, bspnum: i32) -> bool {
  if bspnum & NF_SUBSECTOR != 0 {
    cross_subsector(lines, sectors, subsectors, segs, sight, validcount,
                    bspnum & ~NF_SUBSECTOR)
  } else {
    let on = divline_side(sight[0].x, sight[0].y, nodes[bspnum].x,
                          nodes[bspnum].y, nodes[bspnum].dx, nodes[bspnum].dy)
    let side = if on == 2 { 0 } else { on }
    let near = if side == 0 { nodes[bspnum].child0 } else { nodes[bspnum].child1 }
    let far = if side == 0 { nodes[bspnum].child1 } else { nodes[bspnum].child0 }
    if !cross_bsp_node(lines, sectors, subsectors, segs, nodes, sight,
                       validcount, near) {
      false
    } else if side == divline_side(sight[0].t2x, sight[0].t2y, nodes[bspnum].x,
                                   nodes[bspnum].y, nodes[bspnum].dx,
                                   nodes[bspnum].dy) {
      true
    } else {
      cross_bsp_node(lines, sectors, subsectors, segs, nodes, sight,
                     validcount, far)
    }
  }
}

// Whether a thing sees another: from three quarters up the one to
// anywhere between the feet and the head of the other. `reject`: where
// the level says which sectors see nothing of which (P_CheckSight).
proc check_sight(lines: mut Lines, sectors: Sectors, subsectors: Subsectors,
                 segs: Segs, nodes: Nodes, bytes: Bytes, tm: mut Tm,
                 sight: mut Sight, reject: i32, x1: i32, y1: i32, z1: i32,
                 height1: i32, sub1: i32, x2: i32, y2: i32, z2: i32,
                 height2: i32, sub2: i32) -> bool {
  let pnum = subsectors[sub1].sector * len(sectors) + subsectors[sub2].sector
  var sees = false
  if byte_at(bytes, reject + (pnum >> 3)) & (1 << (pnum & 7)) == 0 {
    tm[0].validcount += 1
    let zstart = z1 + height1 - (height1 >> 2)
    sight = [{
      x: x1, y: y1, dx: x2 - x1, dy: y2 - y1, t2x: x2, t2y: y2,
      zstart: zstart, top: z2 + height2 - zstart, bottom: z2 - zstart
    }; 1]
    sees = cross_bsp_node(lines, sectors, subsectors, segs, nodes, sight,
                          tm[0].validcount, len(nodes) - 1)
  }
  sees
}

// What a tic's procs are told of the level and the game, one row: where
// the level says which sectors see nothing of which, the skill, the flat
// that is the sky, and the tic.
buffer Env { reject: i32, skill: i32, sky: i32, leveltime: i32 } capacity 1

// The things a blast may reach, in the blockmap's order (see
// `radius_attack`).
buffer Blast { id: i32, bx: i32, by: i32, linked: i32 } capacity 2048

const MISSILERANGE = 32 * 64 * FRACUNIT
const BASETHRESHOLD = 100
// Where a thing is made: on the floor, or under the ceiling, of where
// it is.
const ONFLOORZ = -2147483647 - 1
const ONCEILINGZ = 2147483647
const SFX_PODTH1 = 59
const SFX_PODTH3 = 61
const SFX_BGDTH1 = 62
const SFX_BGDTH2 = 63

// A number drawn and another taken from it (P_SubRandom).
proc sub_random(rnd: mut Rnd) -> i32 {
  let r = p_random(rnd)
  r - p_random(rnd)
}

// The thing with that number, or none.
fn thing_by_id(things: Mobj, id: i32) -> entity {
  var found: entity = none
  for o, other in things where other.id == id { found = o }
  found
}

// Whether a thing sees another (P_CheckSight of two things).
proc sees(lines: mut Lines, sectors: Sectors, subsectors: Subsectors,
          segs: Segs, nodes: Nodes, bytes: Bytes, tm: mut Tm,
          sight: mut Sight, env: Env, things: Mobj, me: entity,
          it: entity) -> bool {
  check_sight(lines, sectors, subsectors, segs, nodes, bytes, tm, sight,
              env[0].reject, things[me].x, things[me].y, things[me].z,
              things[me].height, things[me].subsector, things[it].x,
              things[it].y, things[it].z, things[it].height,
              things[it].subsector)
}

// Whether a thing sees the player, who is then the one it is after: in
// front of it, or near enough behind it, or (`allaround`) anywhere
// (P_LookForPlayers, in a game for one: the three who are not there are
// looked for too, which takes its turns).
proc look_for_players(lines: mut Lines, sectors: Sectors,
                      subsectors: Subsectors, segs: Segs, nodes: Nodes,
                      bytes: Bytes, tm: mut Tm, sight: mut Sight, env: Env,
                      things: mut Mobj, me: entity, player: entity,
                      allaround: bool) -> bool {
  var c = 0
  let stop = (things[me].lastlook - 1) & 3
  var found = false
  var going = true
  let here = there(things, player)
  while going {
    if things[me].lastlook != 0 || !here {
      // (Not in the game.)
      things[me].lastlook = (things[me].lastlook + 1) & 3
      // (Nobody is: round once, and no more.)
      if !here {
        c += 1
        if c > 4 { going = false }
      }
    } else if c == 2 || things[me].lastlook == stop {
      going = false
    } else {
      c += 1
      var seen = things[player].health > 0
      if seen {
        seen = sees(lines, sectors, subsectors, segs, nodes, bytes, tm, sight,
                    env, things, me, player)
      }
      if seen && !allaround {
        let an = point_to_angle(things[player].x - things[me].x,
                                things[player].y - things[me].y) -
                 things[me].angle
        // (Behind its back, and not near.)
        if an > ANG90 && an < ANG270 &&
           aprox_distance(things[player].x - things[me].x,
                          things[player].y - things[me].y) > MELEERANGE {
          seen = false
        }
      }
      if seen {
        things[me].target = player
        found = true
        going = false
      } else {
        things[me].lastlook = (things[me].lastlook + 1) & 3
      }
    }
  }
  found
}

// A thing goes into a state and does what the state does (below, after
// all that a state may do).
proc set_state(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
               segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
               Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
               touched: mut Touched, triggered: mut Triggered, intercepts: mut
               Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv,
               powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me:
               entity, first: i32)

// A thing is made (P_SpawnMobj): of that kind, there, in the first state
// of its kind. It comes last of the things, and has its turn in the tic
// it was made in.
proc spawn_mobj(things: mut Mobj, sectors: Sectors, subsectors: Subsectors,
                nodes: Nodes, tm: mut Tm, rnd: mut Rnd, env: Env, x: i32,
                y: i32, z: i32, type: i32) -> entity {
  tm[0].links += 1
  let lastlook = p_random(rnd) % 4
  let state = mobjinfo[type].spawnstate
  let subsector = point_in_subsector(nodes, x, y)
  let sector = subsectors[subsector].sector
  let floorz = sectors[sector].floorheight
  let ceilingz = sectors[sector].ceilingheight
  let height = mobjinfo[type].height
  spawn {
    Mobj {
      x: x, y: y,
      z: if z == ONFLOORZ {
        floorz
      } else if z == ONCEILINGZ {
        ceilingz - height
      } else {
        z
      },
      angle: 0, type: type, state: state, tics: states[state].tics,
      sprite: states[state].sprite, frame: states[state].frame,
      flags: mobjinfo[type].flags, health: mobjinfo[type].spawnhealth,
      radius: mobjinfo[type].radius, height: height,
      reactiontime: if env[0].skill == 4 { 0 } else { mobjinfo[type].reactiontime },
      lastlook: lastlook, subsector: subsector, floorz: floorz,
      ceilingz: ceilingz, linked: tm[0].links, id: tm[0].links, momx: 0,
      momy: 0, momz: 0, movedir: DI_EAST, movecount: 0, threshold: 0,
      target: none, gone: false
    }
  }
}

// What a shot leaves on a wall (P_SpawnPuff), and in what it hits
// (P_SpawnBlood): a little up or down, and for a little shorter or
// longer.
proc spawn_puff(lines: mut Lines, sectors: mut Sectors, subsectors:
                Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                spechit: mut Spechit, touched: mut Touched, triggered: mut
                Triggered, intercepts: mut Intercepts, sight: mut Sight, rnd:
                mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast, things: mut
                Mobj, player: entity, x: i32, y: i32, z: i32, punch: bool) {
  let up = sub_random(rnd) << 10
  let th = spawn_mobj(things, sectors, subsectors, nodes, tm, rnd, env, x, y,
                      z + up, MT_PUFF)
  things[th].momz = FRACUNIT
  things[th].tics = max(things[th].tics - (p_random(rnd) & 3), 1)
  // (A fist makes no spark on the wall.)
  if punch { set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, th, S_PUFF3) }
}
proc spawn_blood(lines: mut Lines, sectors: mut Sectors, subsectors:
                 Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                 Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                 spechit: mut Spechit, touched: mut Touched, triggered: mut
                 Triggered, intercepts: mut Intercepts, sight: mut Sight, rnd:
                 mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast, things: mut
                 Mobj, player: entity, x: i32, y: i32, z: i32, damage: i32) {
  let up = sub_random(rnd) << 10
  let th = spawn_mobj(things, sectors, subsectors, nodes, tm, rnd, env, x, y,
                      z + up, MT_BLOOD)
  things[th].momz = FRACUNIT * 2
  things[th].tics = max(things[th].tics - (p_random(rnd) & 3), 1)
  if damage <= 12 && damage >= 9 {
    set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, th, S_BLOOD2)
  } else if damage < 9 {
    set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, th, S_BLOOD3)
  }
}

// A thing dies (P_KillMobj): it is no more to be shot, lies low, and
// goes into the states of its dying; some leave what they carried.
proc kill_mobj(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
               segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
               Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
               touched: mut Touched, triggered: mut Triggered, intercepts: mut
               Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv,
               powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity,
               source: entity, target: entity) {
  let type = things[target].type
  things[target].flags &= ~(MF_SHOOTABLE | MF_FLOAT | MF_SKULLFLY)
  if type != MT_SKULL { things[target].flags &= ~MF_NOGRAVITY }
  things[target].flags |= MF_CORPSE | MF_DROPOFF
  things[target].height >>= 2
  // (The player's: nothing stands in its place.)
  if type == MT_PLAYER { things[target].flags &= ~MF_SOLID }
  if things[target].health < -mobjinfo[type].spawnhealth &&
     mobjinfo[type].xdeathstate != 0 {
    set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, target, mobjinfo[type].xdeathstate)
  } else {
    set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, target, mobjinfo[type].deathstate)
  }
  things[target].tics = max(things[target].tics - (p_random(rnd) & 3), 1)
  let item = if type == MT_WOLFSS || type == MT_POSSESSED {
    MT_CLIP
  } else if type == MT_SHOTGUY {
    MT_SHOTGUN
  } else if type == MT_CHAINGUY {
    MT_CHAINGUN
  } else {
    -1
  }
  if item >= 0 {
    let mo = spawn_mobj(things, sectors, subsectors, nodes, tm, rnd, env,
                        things[target].x, things[target].y, ONFLOORZ, item)
    things[mo].flags |= MF_DROPPED
  }
}

// A thing is hurt (P_DamageMobj) by another (`inflictor`: what hit it;
// `source`: who is to blame, whom it goes after; either may be none): it
// is pushed away, the player's armour takes its part, and it dies, or
// flinches, and wakes.
proc damage_mobj(lines: mut Lines, sectors: mut Sectors, subsectors:
                 Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                 Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                 spechit: mut Spechit, touched: mut Touched, triggered: mut
                 Triggered, intercepts: mut Intercepts, sight: mut Sight, rnd:
                 mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast, things: mut
                 Mobj, player: entity, target: entity, inflictor: entity,
                 source: entity, harm: i32) {
  if things[target].flags & MF_SHOOTABLE != 0 && things[target].health > 0 {
    let type = things[target].type
    let isplayer = type == MT_PLAYER
    var damage = harm
    if things[target].flags & MF_SKULLFLY != 0 {
      things[target].momx = 0
      things[target].momy = 0
      things[target].momz = 0
    }
    if isplayer && env[0].skill == 0 { damage >>= 1 }
    // (Not by a chainsaw, which pulls.)
    if inflictor != none && things[target].flags & MF_NOCLIP == 0 &&
       (source == none || things[source].type != MT_PLAYER ||
        inv[0].readyweapon != WP_CHAINSAW) {
      var ang = point_to_angle(things[target].x - things[inflictor].x,
                               things[target].y - things[inflictor].y)
      var thrust = damage * (FRACUNIT >> 3) * 100 / mobjinfo[type].mass
      // (Now and then it falls forwards off a ledge.)
      if damage < 40 && damage > things[target].health &&
         things[target].z - things[inflictor].z > 64 * FRACUNIT {
        if p_random(rnd) & 1 != 0 {
          ang += ANG180
          thrust *= 4
        }
      }
      let fine = (ang >> ANGLETOFINESHIFT) as i32
      things[target].momx += fixed_mul(thrust, finecosine(fine))
      things[target].momy += fixed_mul(thrust, finesine[fine])
    }
    var hurts = true
    if isplayer {
      // (Not to death where the level ends by it.)
      let sector = subsectors[things[target].subsector].sector
      if sectors[sector].special == 11 && damage >= things[target].health {
        damage = things[target].health - 1
      }
      if damage < 1000 && powers[PW_INVULNERABILITY].tics != 0 {
        hurts = false
      } else if inv[0].armortype != 0 {
        var saved = if inv[0].armortype == 1 { damage / 3 } else { damage / 2 }
        if inv[0].armorpoints <= saved {
          saved = inv[0].armorpoints
          inv[0].armortype = 0
        }
        inv[0].armorpoints -= saved
        damage -= saved
      }
    }
    if hurts {
      // (The player knows who did it, and turns to it when dead.)
      if isplayer { inv[0].attacker = things[source].id }
      things[target].health -= damage
      if things[target].health <= 0 {
        kill_mobj(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, source, target)
      } else {
        if p_random(rnd) < mobjinfo[type].painchance &&
           things[target].flags & MF_SKULLFLY == 0 {
          // (It fights back.)
          things[target].flags |= MF_JUSTHIT
          set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, target, mobjinfo[type].painstate)
        }
        things[target].reactiontime = 0
        if (things[target].threshold == 0 || type == MT_VILE) && source != none &&
           source != target && things[source].type != MT_VILE {
          // It is after who did it, for a while.
          things[target].target = source
          things[target].threshold = BASETHRESHOLD
          if things[target].state == mobjinfo[type].spawnstate &&
             mobjinfo[type].seestate != S_NULL {
            set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, target, mobjinfo[type].seestate)
          }
        }
      }
    }
  }
}

// The things in some squares of the blockmap, into `Blast` in the
// blockmap's order.
proc gather_blast(things: Mobj, bmap: Bmap, blast: mut Blast, across: bool,
                  xl: i32, xh: i32, yl: i32, yh: i32) {
  blast = []
  for other in things where !other.gone && other.flags & MF_NOBLOCKMAP == 0 {
    let bx = (other.x - bmap[0].orgx) >> MAPBLOCKSHIFT
    let by = (other.y - bmap[0].orgy) >> MAPBLOCKSHIFT
    if bx >= xl && bx <= xh && by >= yl && by <= yh {
      // (Row by row, in a row square by square, in a square the one put
      // there last first; or with `across`, column by column.)
      blast += { id: other.id, bx: bx, by: by, linked: other.linked }
      var at = len(blast) - 1
      var settled = false
      while at > 0 && !settled {
        let pby = blast[at - 1].by
        let pbx = blast[at - 1].bx
        let later = if across {
          pbx > bx || (pbx == bx && pby > by)
        } else {
          pby > by || (pby == by && pbx > bx)
        }
        if later || (pby == by && pbx == bx && blast[at - 1].linked < other.linked) {
          blast[at].id = blast[at - 1].id
          blast[at].bx = blast[at - 1].bx
          blast[at].by = blast[at - 1].by
          blast[at].linked = blast[at - 1].linked
          at -= 1
        } else {
          settled = true
        }
      }
      blast[at].id = other.id
      blast[at].bx = bx
      blast[at].by = by
      blast[at].linked = other.linked
    }
  }
}

// A thing that walks over a teleporter's line from its front comes out
// where the level has put a mark in a sector of the line's tag, turned
// as the mark is, with smoke where it was and where it is; the player
// stands still a while, and kills what is in the way, which stops a
// monster (EV_Teleport, P_TeleportMove, PIT_StompThing).
proc teleport(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
              segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
              Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
              touched: mut Touched, triggered: mut Triggered, intercepts: mut
              Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv,
              powers: Powers, env: Env, blast: mut Blast, things: mut Mobj,
              player: entity, me: entity, line: i32, side: i32) -> bool {
  var went = false
  if things[me].flags & MF_MISSILE == 0 && side == 0 {
    // The first mark, of the things in their order, in the first sector
    // of the tag.
    var mark: entity = none
    for i in 0..len(sectors) {
      if mark == none && sectors[i].tag == lines[line].tag {
        var first = 0x7fffffff
        for o, other in things
            where other.type == MT_TELEPORTMAN && !other.gone &&
                  subsectors[other.subsector].sector == i {
          if other.id < first {
            first = other.id
            mark = o
          }
        }
      }
    }
    if mark != none {
      let isplayer = things[me].type == MT_PLAYER
      let x = things[mark].x
      let y = things[mark].y
      let radius = things[me].radius
      // What is where it comes out.
      gather_blast(things, bmap, blast, true,
                   (x - radius - bmap[0].orgx - MAXRADIUS) >> MAPBLOCKSHIFT,
                   (x + radius - bmap[0].orgx + MAXRADIUS) >> MAPBLOCKSHIFT,
                   (y - radius - bmap[0].orgy - MAXRADIUS) >> MAPBLOCKSHIFT,
                   (y + radius - bmap[0].orgy + MAXRADIUS) >> MAPBLOCKSHIFT)
      tm[0].validcount += 1
      spechit = []
      var free = true
      for k in 0..len(blast) {
        let it = thing_by_id(things, blast[k].id)
        if free && it != me && things[it].flags & MF_SHOOTABLE != 0 &&
           abs(things[it].x - x) < things[it].radius + radius &&
           abs(things[it].y - y) < things[it].radius + radius {
          if isplayer {
            damage_mobj(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, it, me, me, 10000)
          } else {
            free = false
          }
        }
      }
      if free {
        let oldx = things[me].x
        let oldy = things[me].y
        let oldz = things[me].z
        let subsector = point_in_subsector(nodes, x, y)
        let sector = subsectors[subsector].sector
        things[me].floorz = sectors[sector].floorheight
        things[me].ceilingz = sectors[sector].ceilingheight
        things[me].x = x
        things[me].y = y
        things[me].subsector = subsector
        tm[0].links += 1
        things[me].linked = tm[0].links
        things[me].z = things[me].floorz
        let here = spawn_mobj(things, sectors, subsectors, nodes, tm, rnd, env,
                              oldx, oldy, oldz, MT_TFOG)
        let an = (things[mark].angle >> ANGLETOFINESHIFT) as i32
        let there = spawn_mobj(things, sectors, subsectors, nodes, tm, rnd, env,
                               x + 20 * finecosine(an), y + 20 * finesine[an],
                               things[me].z, MT_TFOG)
        if isplayer { things[me].reactiontime = 18 }
        things[me].angle = things[mark].angle
        things[me].momx = 0
        things[me].momy = 0
        things[me].momz = 0
        went = true
      }
    }
  }
  went
}

// Moves the thing whose turn it is to (x, y) if it can be there and gets there:
// it fits, and the step up is not too high (P_TryMove).
proc try_move(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
              segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
              Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
              touched: mut Touched, triggered: mut Triggered, intercepts: mut
              Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv,
              powers: Powers, env: Env, blast: mut Blast, things: mut Mobj,
              player: entity, me: entity, x: i32, y: i32) -> bool {
  let flags = things[me].flags
  var moved = false
  gather_near(things, me, bmap, near, order)
  if check_position(lines, sectors, subsectors, nodes, bytes, bmap, near, order,
                    tm, spechit, touched, x, y, things[me].z, things[me].radius, flags,
                    things[me].type == MT_PLAYER, things[me].height,
                    if there(things, things[me].target) {
                      things[things[me].target].type
                    } else {
                      -1
                    },
                    things[things[me].target].id) {
    let height = things[me].height
    let z = things[me].z
    if flags & MF_NOCLIP != 0 ||
       (tm[0].ceilingz - tm[0].floorz >= height &&
        (flags & MF_TELEPORT != 0 ||
         (tm[0].ceilingz - z >= height && tm[0].floorz - z <= MAXSTEP)) &&
        (flags & (MF_DROPOFF | MF_FLOAT) != 0 ||
         tm[0].floorz - tm[0].dropoffz <= MAXSTEP)) {
      let oldx = things[me].x
      let oldy = things[me].y
      things[me].floorz = tm[0].floorz
      things[me].ceilingz = tm[0].ceilingz
      things[me].x = x
      things[me].y = y
      things[me].subsector = point_in_subsector(nodes, x, y)
      tm[0].links += 1
      things[me].linked = tm[0].links
      // The special lines it came across, the last found first: they
      // do what they do when the player has moved.
      if flags & (MF_TELEPORT | MF_NOCLIP) == 0 {
        for back in 0..len(spechit) {
          let ld = spechit[len(spechit) - 1 - back].line
          let oldside = point_on_line_side(lines, ld, oldx, oldy)
          // (Of what a monster walks over, a few do something; of what
          // a shot flies over, nothing: P_CrossSpecialLine.)
          let special = lines[ld].special
          let type = things[me].type
          let does = (things[me].type == MT_PLAYER) ||
                     ((special == 39 || special == 97 || special == 125 ||
                       special == 126 || special == 4 || special == 10 ||
                       special == 88) &&
                      type != MT_ROCKET && type != MT_PLASMA && type != MT_BFG &&
                      type != MT_TROOPSHOT && type != MT_HEADSHOT &&
                      type != MT_BRUISERSHOT)
          if point_on_line_side(lines, ld, things[me].x, things[me].y) != oldside &&
             special != 0 && does {
            if special == 39 || special == 97 || special == 125 || special == 126 {
              // A teleporter, at once (the first two for all, the others
              // for monsters): the thing goes on from where it comes
              // out. One that works once has then worked.
              let isplayer = things[me].type == MT_PLAYER
              if special == 39 || special == 97 || !isplayer {
                let went = teleport(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, ld, oldside)
                if special == 39 || special == 125 { lines[ld].special = 0 }
              }
            } else {
              triggered += { line: ld, used: false, side: oldside,
                             player: (things[me].type == MT_PLAYER), shot: false }
            }
          }
        }
      }
      moved = true
    }
  }
  moved
}

// The player's thing could not go where it was going: it goes as far as
// it can, and along the line that stopped it with what is left of its
// way (P_SlideMove, P_HitSlideLine).
proc slide_move(lines: mut Lines, sectors: mut Sectors, subsectors:
                Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                spechit: mut Spechit, touched: mut Touched, triggered: mut
                Triggered, intercepts: mut Intercepts, sight: mut Sight, rnd:
                mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut
                Blast, things: mut Mobj, player: entity, me: entity) {
  var hitcount = 0
  var done = false
  while !done {
    hitcount += 1
    // (Not for ever: the third time it steps one way, then the other.)
    var stairstep = hitcount == 3
    if !stairstep {
      let radius = things[me].radius
      let x = things[me].x
      let y = things[me].y
      let momx = things[me].momx
      let momy = things[me].momy
      // Its three corners that lead.
      let leadx = if momx > 0 { x + radius } else { x - radius }
      let trailx = if momx > 0 { x - radius } else { x + radius }
      let leady = if momy > 0 { y + radius } else { y - radius }
      let traily = if momy > 0 { y - radius } else { y + radius }
      tm[0].bestslidefrac = FRACUNIT + 1
      slide_traverse(lines, sectors, bytes, bmap, tm, intercepts, things, me, leadx,
                     leady, leadx + momx, leady + momy)
      slide_traverse(lines, sectors, bytes, bmap, tm, intercepts, things, me, trailx,
                     leady, trailx + momx, leady + momy)
      slide_traverse(lines, sectors, bytes, bmap, tm, intercepts, things, me, leadx,
                     traily, leadx + momx, traily + momy)
      if tm[0].bestslidefrac == FRACUNIT + 1 {
        // (Nothing was hit: one of the things, then.)
        stairstep = true
      } else {
        // Up to the wall, a little short of it.
        var frac = tm[0].bestslidefrac - 0x800
        var went = true
        if frac > 0 {
          went = try_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, x + fixed_mul(momx, frac),
                          y + fixed_mul(momy, frac))
          if !went { stairstep = true }
        }
        if went {
          // What is left of the way, along the wall.
          frac = min(FRACUNIT - (frac + 0x800), FRACUNIT)
          if frac <= 0 {
            done = true
          } else {
            let li = tm[0].bestslideline
            var tmxmove = fixed_mul(momx, frac)
            var tmymove = fixed_mul(momy, frac)
            if lines[li].slopetype == ST_HORIZONTAL {
              tmymove = 0
            } else if lines[li].slopetype == ST_VERTICAL {
              tmxmove = 0
            } else {
              let side = point_on_line_side(lines, li, things[me].x, things[me].y)
              let lineangle = point_to_angle(lines[li].dx, lines[li].dy) +
                              if side == 1 { ANG180 } else { 0 }
              let delta = point_to_angle(tmxmove, tmymove) - lineangle
              let deltaangle = if delta > ANG180 { delta + ANG180 } else { delta }
              let newlen = fixed_mul(
                  aprox_distance(tmxmove, tmymove),
                  finecosine((deltaangle >> ANGLETOFINESHIFT) as i32))
              tmxmove = fixed_mul(newlen, finecosine((lineangle >> ANGLETOFINESHIFT) as i32))
              tmymove = fixed_mul(newlen, finesine[lineangle >> ANGLETOFINESHIFT])
            }
            things[me].momx = tmxmove
            things[me].momy = tmymove
            done = try_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, things[me].x + tmxmove,
                            things[me].y + tmymove)
          }
        }
      }
    }
    if stairstep {
      if !try_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, things[me].x, things[me].y + things[me].momy) {
        let other = try_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me,
                             things[me].x + things[me].momx, things[me].y)
      }
      done = true
    }
  }
}

// A missile bursts (P_ExplodeMissile).
proc explode_missile(lines: mut Lines, sectors: mut Sectors, subsectors:
                     Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                     Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                     spechit: mut Spechit, touched: mut Touched, triggered:
                     mut Triggered, intercepts: mut Intercepts, sight: mut
                     Sight, rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me: entity) {
  things[me].momx = 0
  things[me].momy = 0
  things[me].momz = 0
  set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, mobjinfo[things[me].type].deathstate)
  things[me].tics = max(things[me].tics - (p_random(rnd) & 3), 1)
  things[me].flags &= ~MF_MISSILE
}

// A missile could not go on: what it ran into is hurt, and it bursts;
// into the sky it is gone without a trace (of P_XYMovement and
// PIT_CheckThing).
proc missile_stopped(lines: mut Lines, sectors: mut Sectors, subsectors:
                     Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                     Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                     spechit: mut Spechit, touched: mut Touched, triggered:
                     mut Triggered, intercepts: mut Intercepts, sight: mut
                     Sight, rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me: entity) {
  if tm[0].hit != 0 {
    let it = thing_by_id(things, tm[0].hit)
    let damage = (p_random(rnd) % 8 + 1) * mobjinfo[things[me].type].damage
    damage_mobj(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, it, me, things[me].target, damage)
  }
  let line = tm[0].ceilingline
  if line >= 0 && lines[line].backsector >= 0 &&
     sectors[lines[line].backsector].ceilingpic == env[0].sky {
    things[me].gone = true
  } else {
    explode_missile(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
  }
}

// A missile that was just made starts a little way on, and bursts at
// once if there is no room (P_CheckMissileSpawn).
proc check_missile_spawn(lines: mut Lines, sectors: mut Sectors, subsectors:
                     Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                     Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                     spechit: mut Spechit, touched: mut Touched, triggered:
                     mut Triggered, intercepts: mut Intercepts, sight: mut
                     Sight, rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, th: entity) {
  things[th].tics = max(things[th].tics - (p_random(rnd) & 3), 1)
  things[th].x += things[th].momx >> 1
  things[th].y += things[th].momy >> 1
  things[th].z += things[th].momz >> 1
  let me = th
  if !try_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, things[th].x, things[th].y) {
    missile_stopped(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, th)
  }
}

// A missile is shot from a thing at another (P_SpawnMissile,
// P_CheckMissileSpawn): it starts a little way on, and bursts at once
// if there is no room.
proc spawn_missile(lines: mut Lines, sectors: mut Sectors, subsectors:
                   Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                   Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                   spechit: mut Spechit, touched: mut Touched, triggered: mut
                   Triggered, intercepts: mut Intercepts, sight: mut Sight,
                   rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast,
                   things: mut Mobj, player: entity, source: entity, dest:
                   entity, type: i32) {
  let th = spawn_mobj(things, sectors, subsectors, nodes, tm, rnd, env,
                      things[source].x, things[source].y,
                      things[source].z + 4 * 8 * FRACUNIT, type)
  things[th].target = source
  var an = point_to_angle(things[dest].x - things[source].x,
                          things[dest].y - things[source].y)
  if things[dest].flags & MF_SHADOW != 0 { an += (sub_random(rnd) << 20) as u32 }
  things[th].angle = an
  let fine = (an >> ANGLETOFINESHIFT) as i32
  let speed = mobjinfo[type].speed
  things[th].momx = fixed_mul(speed, finecosine(fine))
  things[th].momy = fixed_mul(speed, finesine[fine])
  let dist = max(aprox_distance(things[dest].x - things[source].x,
                                things[dest].y - things[source].y) / speed, 1)
  things[th].momz = (things[dest].z - things[source].z) / dist
  check_missile_spawn(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, th)
}

// What hurts all around a thing does so (P_RadiusAttack): everything
// that can be hurt, sees the place and is near enough, the more the
// nearer, in the order the blockmap has them in.
proc radius_attack(lines: mut Lines, sectors: mut Sectors, subsectors:
                   Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                   Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                   spechit: mut Spechit, touched: mut Touched, triggered: mut
                   Triggered, intercepts: mut Intercepts, sight: mut Sight,
                   rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast,
                   things: mut Mobj, player: entity, spot:
                   entity, source: entity, damage: i32) {
  // (As the reference reckons it, by which the widest thing's half is
  // lost: it overflows.)
  let dist = (damage + MAXRADIUS) << FRACBITS
  gather_blast(things, bmap, blast, false,
               (things[spot].x - dist - bmap[0].orgx) >> MAPBLOCKSHIFT,
               (things[spot].x + dist - bmap[0].orgx) >> MAPBLOCKSHIFT,
               (things[spot].y - dist - bmap[0].orgy) >> MAPBLOCKSHIFT,
               (things[spot].y + dist - bmap[0].orgy) >> MAPBLOCKSHIFT)
  for k in 0..len(blast) {
    let it = thing_by_id(things, blast[k].id)
    if things[it].flags & MF_SHOOTABLE != 0 && things[it].type != MT_CYBORG &&
       things[it].type != MT_SPIDER {
      let dx = abs(things[it].x - things[spot].x)
      let dy = abs(things[it].y - things[spot].y)
      let away = max((max(dx, dy) - things[it].radius) >> FRACBITS, 0)
      if away < damage {
        if sees(lines, sectors, subsectors, segs, nodes, bytes, tm, sight, env,
                things, it, spot) {
          damage_mobj(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, it, spot, source, damage - away)
        }
      }
    }
  }
}

// A thing moved as fast as it goes (P_XYMovement): the player slides
// along what is in the way, a missile bursts on it, anything else
// stops; on the floor it is slowed down.
proc thing_xy(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
              segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
              Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
              touched: mut Touched, triggered: mut Triggered, intercepts: mut
              Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv,
              powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me:
              entity, pl: mut Pl) {
  let isplayer = things[me].type == MT_PLAYER
  things[me].momx = min(max(things[me].momx, -MAXMOVE), MAXMOVE)
  things[me].momy = min(max(things[me].momy, -MAXMOVE), MAXMOVE)
  var xmove = things[me].momx
  var ymove = things[me].momy
  loop {
    // (A long way in two halves.)
    var ptryx = things[me].x + xmove
    var ptryy = things[me].y + ymove
    if xmove > MAXMOVE / 2 || ymove > MAXMOVE / 2 {
      ptryx = things[me].x + xmove / 2
      ptryy = things[me].y + ymove / 2
      xmove >>= 1
      ymove >>= 1
    } else {
      xmove = 0
      ymove = 0
    }
    if !try_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, ptryx, ptryy) {
      if isplayer {
        slide_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
      } else if things[me].flags & MF_MISSILE != 0 {
        missile_stopped(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
        // (Burst, it goes the rest of its way as what is left of it;
        // gone, no further.)
        if things[me].gone {
          xmove = 0
          ymove = 0
        }
      } else {
        things[me].momx = 0
        things[me].momy = 0
      }
    }
  } until xmove == 0 && ymove == 0
  // On the floor it slows down, and stops when it is slow and no key
  // moves it. (What is dead slides on off a ledge.)
  let sliding = things[me].flags & MF_CORPSE != 0 &&
                (things[me].momx > FRACUNIT / 4 || things[me].momx < -FRACUNIT / 4 ||
                 things[me].momy > FRACUNIT / 4 || things[me].momy < -FRACUNIT / 4) &&
                things[me].floorz !=
                    sectors[subsectors[things[me].subsector].sector].floorheight
  if !things[me].gone && things[me].flags & (MF_MISSILE | MF_SKULLFLY) == 0 &&
     things[me].z <= things[me].floorz && !sliding {
    if things[me].momx > -STOPSPEED && things[me].momx < STOPSPEED &&
       things[me].momy > -STOPSPEED && things[me].momy < STOPSPEED &&
       (!isplayer || (pl[0].forwardmove == 0 && pl[0].sidemove == 0)) {
      if isplayer && (things[me].state - S_PLAY_RUN1) as u32 < 4 {
        set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, S_PLAY)
      }
      things[me].momx = 0
      things[me].momy = 0
    } else {
      things[me].momx = fixed_mul(things[me].momx, FRICTION)
      things[me].momy = fixed_mul(things[me].momy, FRICTION)
    }
  }
}

// And brought to the floor, or held under the ceiling; a missile bursts
// on either (P_ZMovement).
proc thing_z(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
             segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
             Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
             touched: mut Touched, triggered: mut Triggered, intercepts: mut
             Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv, powers:
             Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me: entity,
             pl: mut Pl) {
  let isplayer = things[me].type == MT_PLAYER
  // (Up a step: the eye follows smoothly.)
  if isplayer && things[me].z < things[me].floorz {
    pl[0].viewheight -= things[me].floorz - things[me].z
    pl[0].deltaviewheight = (VIEWHEIGHT - pl[0].viewheight) >> 3
  }
  things[me].z += things[me].momz
  var burst = false
  if things[me].z <= things[me].floorz {
    if things[me].momz < 0 {
      // (Landed hard: the eye dips.)
      if isplayer && things[me].momz < -GRAVITY * 8 {
        pl[0].deltaviewheight = things[me].momz >> 3
      }
      things[me].momz = 0
    }
    things[me].z = things[me].floorz
    if things[me].flags & MF_MISSILE != 0 && things[me].flags & MF_NOCLIP == 0 {
      burst = true
    }
  } else if things[me].flags & MF_NOGRAVITY == 0 {
    if things[me].momz == 0 {
      things[me].momz = -GRAVITY * 2
    } else {
      things[me].momz -= GRAVITY
    }
  }
  if !burst && things[me].z + things[me].height > things[me].ceilingz {
    if things[me].momz > 0 { things[me].momz = 0 }
    things[me].z = things[me].ceilingz - things[me].height
    if things[me].flags & MF_MISSILE != 0 && things[me].flags & MF_NOCLIP == 0 {
      burst = true
    }
  }
  if burst { explode_missile(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me) }
}

// Where a shot from a thing along `angle` would go to hit something:
// how steeply, and what (P_AimLineAttack, PTR_AimTraverse); 0 and none
// if there is nothing to hit.
proc aim_line_attack(things: Mobj, me: entity, lines: mut Lines,
                     sectors: Sectors, bytes: Bytes, bmap: Bmap, tm: mut Tm,
                     intercepts: mut Intercepts, angle: u32,
                     distance: i32) -> (i32, entity) {
  let fine = (angle >> ANGLETOFINESHIFT) as i32
  let shootz = things[me].z + (things[me].height >> 1) + 8 * FRACUNIT
  path_lines(things, true, lines, bytes, bmap, tm, intercepts, things[me].x,
             things[me].y,
             things[me].x + (distance >> FRACBITS) * finecosine(fine),
             things[me].y + (distance >> FRACBITS) * finesine[fine])
  var topslope = 100 * FRACUNIT / 160
  var bottomslope = -100 * FRACUNIT / 160
  var aimslope = 0
  var linetarget: entity = none
  var left = len(intercepts)
  var going = true
  while going && left > 0 {
    left -= 1
    var frac = 0x7fffffff
    var nearest = 0
    for s in 0..len(intercepts) {
      if intercepts[s].frac < frac {
        frac = intercepts[s].frac
        nearest = s
      }
    }
    if frac > FRACUNIT {
      going = false
    } else {
      intercepts[nearest].frac = 0x7fffffff
      let dist = fixed_mul(distance, frac)
      if intercepts[nearest].thing == 0 {
        let li = intercepts[nearest].line
        if lines[li].flags & ML_TWOSIDED == 0 {
          going = false
        } else {
          let opentop = open_top(lines, sectors, li)
          let openbottom = open_bottom(lines, sectors, li)
          if openbottom >= opentop {
            going = false
          } else {
            let front = lines[li].frontsector
            let back = lines[li].backsector
            if sectors[front].floorheight != sectors[back].floorheight {
              bottomslope max= fixed_div(openbottom - shootz, dist)
            }
            if sectors[front].ceilingheight != sectors[back].ceilingheight {
              topslope min= fixed_div(opentop - shootz, dist)
            }
            if topslope <= bottomslope { going = false }
          }
        }
      } else {
        let th = thing_by_id(things, intercepts[nearest].thing)
        if th != me && things[th].flags & MF_SHOOTABLE != 0 {
          let thingtop = fixed_div(things[th].z + things[th].height - shootz, dist)
          let thingbottom = fixed_div(things[th].z - shootz, dist)
          // (Not over it, and not under it.)
          if thingtop >= bottomslope && thingbottom <= topslope {
            aimslope = (min(thingtop, topslope) + max(thingbottom, bottomslope)) / 2
            linetarget = th
            going = false
          }
        }
      }
    }
  }
  (if linetarget != none { aimslope } else { 0 }, linetarget)
}

// A shot from a thing along `angle`, as steeply as `slope`: the first
// wall or thing in its way is hit, and a thing hurt by so much
// (P_LineAttack, PTR_ShootTraverse).
proc line_attack(lines: mut Lines, sectors: mut Sectors, subsectors:
                 Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                 Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                 spechit: mut Spechit, touched: mut Touched, triggered: mut
                 Triggered, intercepts: mut Intercepts, sight: mut Sight, rnd:
                 mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast, things: mut
                 Mobj, player: entity, me: entity, angle: u32, distance: i32,
                 slope: i32, damage: i32) {
  let fine = (angle >> ANGLETOFINESHIFT) as i32
  let shootz = things[me].z + (things[me].height >> 1) + 8 * FRACUNIT
  let tracex = things[me].x
  let tracey = things[me].y
  let x2 = tracex + (distance >> FRACBITS) * finecosine(fine)
  let y2 = tracey + (distance >> FRACBITS) * finesine[fine]
  path_lines(things, true, lines, bytes, bmap, tm, intercepts, tracex, tracey,
             x2, y2)
  // (The path as it was gone along: from off the edge of a square.)
  let orgx = bmap[0].orgx
  let orgy = bmap[0].orgy
  let tx = if (tracex - orgx) & (MAPBLOCKSIZE - 1) == 0 { tracex + FRACUNIT } else { tracex }
  let ty = if (tracey - orgy) & (MAPBLOCKSIZE - 1) == 0 { tracey + FRACUNIT } else { tracey }
  let tdx = x2 - tx
  let tdy = y2 - ty
  var left = len(intercepts)
  var going = true
  while going && left > 0 {
    left -= 1
    var frac = 0x7fffffff
    var nearest = 0
    for s in 0..len(intercepts) {
      if intercepts[s].frac < frac {
        frac = intercepts[s].frac
        nearest = s
      }
    }
    if frac > FRACUNIT {
      going = false
    } else {
      intercepts[nearest].frac = 0x7fffffff
      let dist = fixed_mul(distance, frac)
      if intercepts[nearest].thing == 0 {
        let li = intercepts[nearest].line
        // (A line that a shot sets off, of which a monster's shot only
        // opens doors: P_ShootSpecialLine.)
        let special = lines[li].special
        if special == 46 || (me == player && (special == 24 || special == 47)) {
          triggered += { line: li, used: false, side: 0, player: me == player,
                         shot: true }
        }
        var hit = lines[li].flags & ML_TWOSIDED == 0
        if !hit {
          let front = lines[li].frontsector
          let back = lines[li].backsector
          if sectors[front].floorheight != sectors[back].floorheight &&
             fixed_div(open_bottom(lines, sectors, li) - shootz, dist) > slope {
            hit = true
          }
          if sectors[front].ceilingheight != sectors[back].ceilingheight &&
             fixed_div(open_top(lines, sectors, li) - shootz, dist) < slope {
            hit = true
          }
        }
        if hit {
          // A little before the wall; nothing where it is the sky.
          let at = frac - fixed_div(4 * FRACUNIT, distance)
          let z = shootz + fixed_mul(slope, fixed_mul(at, distance))
          let front = lines[li].frontsector
          let back = lines[li].backsector
          var sky = false
          if sectors[front].ceilingpic == env[0].sky {
            if z > sectors[front].ceilingheight { sky = true }
            if back >= 0 && sectors[back].ceilingpic == env[0].sky { sky = true }
          }
          if !sky {
            spawn_puff(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, tx + fixed_mul(tdx, at), ty + fixed_mul(tdy, at), z,
                       distance == MELEERANGE)
          }
          going = false
        }
      } else {
        let th = thing_by_id(things, intercepts[nearest].thing)
        if th != me && things[th].flags & MF_SHOOTABLE != 0 &&
           fixed_div(things[th].z + things[th].height - shootz, dist) >= slope &&
           fixed_div(things[th].z - shootz, dist) <= slope {
          let at = frac - fixed_div(10 * FRACUNIT, distance)
          let x = tx + fixed_mul(tdx, at)
          let y = ty + fixed_mul(tdy, at)
          let z = shootz + fixed_mul(slope, fixed_mul(at, distance))
          if things[th].flags & MF_NOBLOOD != 0 {
            spawn_puff(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, x, y, z, distance == MELEERANGE)
          } else {
            spawn_blood(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, x, y, z, damage)
          }
          if damage != 0 { damage_mobj(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, th, me, me, damage) }
          going = false
        }
      }
    }
  }
}

// A thing turns to the one it is after (A_FaceTarget); not quite, if
// that one is hard to see.
proc face_target(things: mut Mobj, me: entity, rnd: mut Rnd) {
  let target = things[me].target
  if there(things, target) {
    things[me].flags &= ~MF_AMBUSH
    things[me].angle = point_to_angle(things[target].x - things[me].x,
                                      things[target].y - things[me].y)
    if things[target].flags & MF_SHADOW != 0 {
      things[me].angle += (sub_random(rnd) << 21) as u32
    }
  }
}

// It shoots at the one it is after: so many times, each a little off
// (A_PosAttack: once; A_SPosAttack: three times; A_CPosAttack: once).
proc shoot(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
           segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut Near,
           order: mut Nearorder, tm: mut Tm, spechit: mut Spechit, touched:
           mut Touched, triggered: mut Triggered, intercepts: mut Intercepts,
           sight: mut Sight, rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me: entity, shots: i32) {
  if there(things, things[me].target) {
    face_target(things, me, rnd)
    let bangle = things[me].angle
    let (slope, aimed) = aim_line_attack(things, me, lines, sectors, bytes,
                                         bmap, tm, intercepts, bangle,
                                         MISSILERANGE)
    for i in 0..shots {
      let angle = bangle + (sub_random(rnd) << 20) as u32
      let damage = (p_random(rnd) % 5 + 1) * 3
      line_attack(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, angle, MISSILERANGE, slope, damage)
    }
  }
}

// Whether it is near enough the one it is after to hit it, and sees it
// (P_CheckMeleeRange).
proc in_melee_range(lines: mut Lines, sectors: Sectors, subsectors: Subsectors,
                    segs: Segs, nodes: Nodes, bytes: Bytes, tm: mut Tm,
                    sight: mut Sight, env: Env, things: Mobj,
                    me: entity) -> bool {
  let target = things[me].target
  var near = there(things, target) &&
             aprox_distance(things[target].x - things[me].x,
                            things[target].y - things[me].y) <
                 MELEERANGE - 20 * FRACUNIT + mobjinfo[things[target].type].radius
  if near {
    near = sees(lines, sectors, subsectors, segs, nodes, bytes, tm, sight, env,
                things, me, target)
  }
  near
}

// It bites (A_SargAttack).
proc bite(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
          segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut Near,
          order: mut Nearorder, tm: mut Tm, spechit: mut Spechit, touched: mut
          Touched, triggered: mut Triggered, intercepts: mut Intercepts,
          sight: mut Sight, rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me: entity) {
  if there(things, things[me].target) {
    face_target(things, me, rnd)
    if in_melee_range(lines, sectors, subsectors, segs, nodes, bytes, tm,
                      sight, env, things, me) {
      let damage = (p_random(rnd) % 10 + 1) * 4
      damage_mobj(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, things[me].target, me, me, damage)
    }
  }
}

// A monster that waits looks for the player, or has heard it; the state
// it goes on in when it has, or -1 (A_Look).
proc a_look(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
            segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
            Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
            touched: mut Touched, triggered: mut Triggered, intercepts: mut
            Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv, powers:
            Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me: entity) -> i32 {
  things[me].threshold = 0
  var found = false
  // What made a noise where it is: after it, if it is not one that waits
  // to see.
  let sector = subsectors[things[me].subsector].sector
  if sectors[sector].soundtarget != 0 && there(things, player) &&
     things[player].flags & MF_SHOOTABLE != 0 {
    things[me].target = player
    found = true
    if things[me].flags & MF_AMBUSH != 0 {
      found = sees(lines, sectors, subsectors, segs, nodes, bytes, tm, sight,
                   env, things, me, player)
    }
  }
  if !found {
    found = look_for_players(lines, sectors, subsectors, segs, nodes, bytes,
                             tm, sight, env, things, me, player, false)
  }
  var next = -1
  if found {
    // (Which of the sounds it makes is drawn.)
    let sound = mobjinfo[things[me].type].seesound
    if sound >= SFX_POSIT1 && sound <= SFX_POSIT3 {
      let which = p_random(rnd) % 3
    }
    if sound == SFX_BGSIT1 || sound == SFX_BGSIT2 {
      let which = p_random(rnd) % 2
    }
    next = mobjinfo[things[me].type].seestate
  }
  next
}

// A step the way the thing walks, if it can take it; if a door is in
// the way that it can open, it opens it (P_Move).
proc p_move(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
            segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
            Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
            touched: mut Touched, triggered: mut Triggered, intercepts: mut
            Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv, powers:
            Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me: entity) -> bool {
  let dir = things[me].movedir
  var moved = false
  if dir != DI_NODIR {
    let speed = mobjinfo[things[me].type].speed
    if try_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, things[me].x + speed * xspeed[dir],
                things[me].y + speed * yspeed[dir]) {
      things[me].flags &= ~MF_INFLOAT
      if things[me].flags & MF_FLOAT == 0 { things[me].z = things[me].floorz }
      moved = true
    } else if len(spechit) != 0 {
      // (What floats and could get over it by rising is not there yet.)
      // The lines it is at, the last found first: a door that is opened
      // by hand, and is no secret, it uses (P_UseSpecialLine).
      things[me].movedir = DI_NODIR
      for back in 0..len(spechit) {
        let ld = spechit[len(spechit) - 1 - back].line
        let special = lines[ld].special
        if lines[ld].flags & ML_SECRET == 0 &&
           (special == 1 || special == 32 || special == 33 || special == 34) {
          triggered += { line: ld, used: true, side: 0, player: false, shot: false }
          moved = true
        }
      }
    }
  }
  moved
}

// The same, and for how many steps it goes on that way is drawn
// (P_TryWalk).
proc try_walk(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
              segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
              Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
              touched: mut Touched, triggered: mut Triggered, intercepts: mut
              Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv,
              powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me:
              entity) -> bool {
  let walked = p_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
  if walked { things[me].movecount = p_random(rnd) & 15 }
  walked
}

// Another way to walk, towards the thing it is after if it can: straight
// at it, or one of the two ways that lead nearer, or as it went, or any
// way but back, or back (P_NewChaseDir).
proc new_chase_dir(lines: mut Lines, sectors: mut Sectors, subsectors:
                   Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap:
                   Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                   spechit: mut Spechit, touched: mut Touched, triggered: mut
                   Triggered, intercepts: mut Intercepts, sight: mut Sight,
                   rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env, blast: mut Blast,
                   things: mut Mobj, player: entity, me: entity) {
  let target = things[me].target
  let olddir = things[me].movedir
  let turnaround = opposite[olddir]
  let deltax = things[target].x - things[me].x
  let deltay = things[target].y - things[me].y
  var d1 = if deltax > 10 * FRACUNIT {
    DI_EAST
  } else if deltax < -10 * FRACUNIT {
    DI_WEST
  } else {
    DI_NODIR
  }
  var d2 = if deltay < -10 * FRACUNIT {
    DI_SOUTH
  } else if deltay > 10 * FRACUNIT {
    DI_NORTH
  } else {
    DI_NODIR
  }
  var done = false
  if d1 != DI_NODIR && d2 != DI_NODIR {
    things[me].movedir = diags[(((deltay < 0) as i32) << 1) + ((deltax > 0) as i32)]
    if things[me].movedir != turnaround { done = try_walk(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me) }
  }
  if !done {
    // (The other of the two first, now and then, or if it is the longer
    // way.)
    let swap = p_random(rnd) > 200 || abs(deltay) > abs(deltax)
    if swap {
      let tdir = d1
      d1 = d2
      d2 = tdir
    }
    if d1 == turnaround { d1 = DI_NODIR }
    if d2 == turnaround { d2 = DI_NODIR }
    if d1 != DI_NODIR {
      things[me].movedir = d1
      done = try_walk(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
    }
  }
  if !done && d2 != DI_NODIR {
    things[me].movedir = d2
    done = try_walk(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
  }
  if !done && olddir != DI_NODIR {
    things[me].movedir = olddir
    done = try_walk(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
  }
  if !done {
    // Any way, round the one way or the other.
    let forwards = p_random(rnd) & 1 != 0
    for step in 0..8 {
      let tdir = if forwards { step } else { DI_SOUTHEAST - step }
      if !done && tdir != turnaround {
        things[me].movedir = tdir
        done = try_walk(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
      }
    }
  }
  if !done && turnaround != DI_NODIR {
    things[me].movedir = turnaround
    done = try_walk(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
  }
  if !done { things[me].movedir = DI_NODIR }
}

// A monster that has seen the player goes after it, and attacks when it
// can; the state it goes on in, or -1 for the one after its own
// (A_Chase).
proc a_chase(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
             segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
             Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
             touched: mut Touched, triggered: mut Triggered, intercepts: mut
             Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv, powers:
             Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me: entity) -> i32 {
  let type = things[me].type
  let target = things[me].target
  if things[me].reactiontime != 0 { things[me].reactiontime -= 1 }
  if things[me].threshold != 0 {
    if !there(things, target) || things[target].health <= 0 {
      things[me].threshold = 0
    } else {
      things[me].threshold -= 1
    }
  }
  // It turns towards the way it walks, an eighth at a time.
  if things[me].movedir < 8 {
    things[me].angle &= 0xe0000000
    let delta = (things[me].angle - ((things[me].movedir as u32) << 29)) as i32
    if delta > 0 {
      things[me].angle -= ANG90 / 2
    } else if delta < 0 {
      things[me].angle += ANG90 / 2
    }
  }
  var next = -1
  if !there(things, target) || things[target].flags & MF_SHOOTABLE == 0 {
    // Nothing to be after: it looks for the player, or waits again.
    if !look_for_players(lines, sectors, subsectors, segs, nodes, bytes, tm,
                         sight, env, things, me, player, true) {
      next = mobjinfo[type].spawnstate
    }
  } else if things[me].flags & MF_JUSTATTACKED != 0 {
    // (Not twice in a row.)
    things[me].flags &= ~MF_JUSTATTACKED
    new_chase_dir(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
  } else {
    // Near enough to hit.
    if mobjinfo[type].meleestate != 0 &&
       in_melee_range(lines, sectors, subsectors, segs, nodes, bytes, tm,
                      sight, env, things, me) {
      next = mobjinfo[type].meleestate
    }
    // Or to shoot, which it does the sooner the nearer it is
    // (P_CheckMissileRange).
    if next < 0 && mobjinfo[type].missilestate != 0 && things[me].movecount == 0 {
      var shoots = false
      if sees(lines, sectors, subsectors, segs, nodes, bytes, tm, sight, env,
              things, me, target) {
        if things[me].flags & MF_JUSTHIT != 0 {
          // (Hit: it shoots back at once.)
          things[me].flags &= ~MF_JUSTHIT
          shoots = true
        } else if things[me].reactiontime == 0 {
          var dist = aprox_distance(things[me].x - things[target].x,
                                    things[me].y - things[target].y) -
                     64 * FRACUNIT
          if mobjinfo[type].meleestate == 0 { dist -= 128 * FRACUNIT }
          dist >>= FRACBITS
          var far = false
          if type == MT_VILE && dist > 14 * 64 { far = true }
          if type == MT_UNDEAD {
            if dist < 196 { far = true }
            dist >>= 1
          }
          if type == MT_CYBORG || type == MT_SPIDER || type == MT_SKULL { dist >>= 1 }
          dist = min(dist, 200)
          if type == MT_CYBORG { dist = min(dist, 160) }
          if !far { shoots = p_random(rnd) >= dist }
        }
      }
      if shoots {
        next = mobjinfo[type].missilestate
        things[me].flags |= MF_JUSTATTACKED
      }
    }
    if next < 0 {
      // It walks on, or another way if it cannot.
      things[me].movecount -= 1
      var on = things[me].movecount >= 0
      if on { on = p_move(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me) }
      if !on { new_chase_dir(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me) }
      // (Now and then it makes a sound.)
      if mobjinfo[type].activesound != 0 {
        let sounds = p_random(rnd) < 3
      }
    }
  }
  next
}

// A thing goes into a state, and does what the state does; one that
// lasts no time goes straight on to the one after, and what it does may
// be to go into another (P_SetMobjState). Into no state: the thing is no
// more.
proc set_state(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
               segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
               Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
               touched: mut Touched, triggered: mut Triggered, intercepts: mut
               Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv,
               powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me:
               entity, first: i32) {
  var state = first
  var going = true
  while going {
    if state == S_NULL {
      things[me].state = S_NULL
      things[me].gone = true
      going = false
    } else {
      things[me].state = state
      things[me].tics = states[state].tics
      things[me].sprite = states[state].sprite
      things[me].frame = states[state].frame
      let action = states[state].action
      var asked = -1
      if action == A_Look {
        asked = a_look(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
      } else if action == A_Chase {
        asked = a_chase(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
      } else if action == A_FaceTarget {
        face_target(things, me, rnd)
      } else if action == A_PosAttack || action == A_CPosAttack {
        shoot(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, 1)
      } else if action == A_SPosAttack {
        shoot(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, 3)
      } else if action == A_SargAttack {
        bite(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me)
      } else if action == A_TroopAttack {
        // It claws what is near, or throws fire (A_TroopAttack).
        let target = things[me].target
        if there(things, target) {
          face_target(things, me, rnd)
          if in_melee_range(lines, sectors, subsectors, segs, nodes, bytes, tm,
                            sight, env, things, me) {
            let damage = (p_random(rnd) % 8 + 1) * 3
            damage_mobj(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, target, me, me, damage)
          } else {
            spawn_missile(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, target, MT_TROOPSHOT)
          }
        }
      } else if action == A_Explode {
        radius_attack(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, things[me].target, 128)
      } else if action == A_Scream {
        // (Which of the sounds it makes is drawn.)
        let sound = mobjinfo[things[me].type].deathsound
        if sound >= SFX_PODTH1 && sound <= SFX_PODTH3 {
          let which = p_random(rnd) % 3
        }
        if sound == SFX_BGDTH1 || sound == SFX_BGDTH2 {
          let which = p_random(rnd) % 2
        }
      } else if action == A_Fall {
        // (What lies dead is walked over.)
        things[me].flags &= ~MF_SOLID
      }
      if asked >= 0 {
        state = asked
      } else {
        state = states[state].nextstate
        going = things[me].tics == 0
      }
    }
  }
}

// A tic of a thing (P_MobjThinker): it moves as fast as it goes, comes
// to the floor, and its state lasts a tic less.
proc thing_tic(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
               segs: Segs, nodes: Nodes, bytes: Bytes, bmap: Bmap, near: mut
               Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
               touched: mut Touched, triggered: mut Triggered, intercepts: mut
               Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv,
               powers: Powers, env: Env, blast: mut Blast, things: mut Mobj, player: entity, me:
               entity, pl: mut Pl) {
  if things[me].momx != 0 || things[me].momy != 0 {
    thing_xy(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, pl)
  }
  if !things[me].gone &&
     (things[me].z != things[me].floorz || things[me].momz != 0) {
    thing_z(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, pl)
  }
  if !things[me].gone && things[me].tics != -1 {
    things[me].tics -= 1
    if things[me].tics == 0 {
      set_state(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, things, player, me, states[things[me].state].nextstate)
    }
  }
}

// What the player's thing touched is picked up, in the order it was
// touched in, if the player has a use for it, and is then no more.
proc pick_up(things: mut Mobj, me: entity, touched: Touched, inv: mut Inv,
             ammo: mut Ammo, powers: mut Powers, skill: i32) {
  for k in 0..len(touched) {
    touch_special(things, me, thing_by_id(things, touched[k].id), inv, ammo,
                  powers, touched[k].z, skill)
  }
}


const MSG_GOTPLASMA = 35
const MSG_GOTSHOTGUN = 36
const MSG_GOTSHOTGUN2 = 37
const MSG_PD_BLUEK = 38
const MSG_PD_REDK = 39
const MSG_PD_YELLOWK = 40

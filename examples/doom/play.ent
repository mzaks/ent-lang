// The player moved (p_user.c, and what of p_map.c, p_maputl.c and
// p_mobj.c moves a thing): a tic's keys make the player's thing faster,
// it is moved as far as the walls and the other things let it, sliding
// along what stops it, and stands on the floor it comes to.
//
// The procs are given the things (`things: mut Mobj`) and the one that
// is moved (`me`); what of the player is no thing's is the row of `Pl`;
// the things near enough to be in the way are rows of `Near`, in the
// order the blockmap has them in.
import files
import wad
import fixed
import tables
import angles
import info
import level
import render
import things
import demo
import items

// What the player takes to the next level of itself: its health.
unique Kept { health: i32 }

const VIEWHEIGHT = 41 * FRACUNIT
const MAXBOB = 0x100000
const GRAVITY = FRACUNIT
const MAXMOVE = 30 * FRACUNIT
const STOPSPEED = 0x1000
const FRICTION = 0xe800
// How high a step a thing takes.
const MAXSTEP = 24 * FRACUNIT

// What of the player is not its thing, one row: where the eye is and
// how it bobs, whether the use key was down, and the tic's keys; whether
// the fire key was down, how many shots in a row, how much lighter a
// shot makes everything, and whether the player is dead.
buffer Pl {
  viewz: i32, viewheight: i32, deltaviewheight: i32, bob: i32, usedown: bool,
  forwardmove: i32, sidemove: i32, angleturn: i32, buttons: i32,
  attackdown: bool, refire: i32, extralight: i32, dead: bool
} capacity 1

// What checking a place leaves behind, one row (the tm.. of p_map.c):
// the floor and ceiling there, the lowest floor it touches, the line
// that made the ceiling (-1: none); the number of the looking-through
// (see `Lines`); what sliding found; how many times a thing was put
// somewhere; the thing a missile ran into (`hit`, its `id`; 0: none);
// and what a path that crossed too much wrote over the slope of the
// player's shots (`overslope`, if `overset`: see `path_lines`).
buffer Tm {
  floorz: i32, ceilingz: i32, dropoffz: i32, ceilingline: i32,
  validcount: i32, bestslidefrac: i32, bestslideline: i32, links: i32,
  hit: i32, overslope: i32, overset: bool
} capacity 1

// The lines with something special that a place that was checked
// touches, and the lines a path crosses with how far along it.
buffer Spechit { line: i32 } capacity 64
// The things that can be picked up which a place that was checked
// touches (by their `id`), with how high the player was then.
buffer Touched { id: i32, z: i32 } capacity 1024
// The lines the player set off this tic, in their order: used (and from
// which side: 0 its front), or walked over (and the side come from).
// (`player`: by the player, not by a monster, which sets off less.)
// (`shot`: by a shot that hit it. `boss`: no line, but the last of the
// barons dead, which lowers the floors with the tag 666.)
// (Where the listener was and looked then, for the sound of what the
// line starts; `now`: where it is.)
buffer Triggered {
  line: i32, used: bool, side: i32, player: bool, shot: bool, boss: bool,
  now: bool, lx: i32, ly: i32, langle: u32
} capacity 256
// (`thing`: the `id` of a thing a shot's path crosses; 0 for a line.)
buffer Intercepts { frac: i32, line: i32, thing: i32 } capacity 2048

// How far from the player a thing is taken into `Near`: more than a
// tic's way and the widest two things.
const NEARREACH = 256 * FRACUNIT

// Which side of a line a point is on: 0 its front, 1 its back
// (P_PointOnLineSide).
fn point_on_line_side(lines: Lines, line: i32, x: i32, y: i32) -> i32 {
  let ldx = lines[line].dx
  let ldy = lines[line].dy
  if ldx == 0 {
    if x <= lines[line].x1 { (ldy > 0) as i32 } else { (ldy < 0) as i32 }
  } else if ldy == 0 {
    if y <= lines[line].y1 { (ldx < 0) as i32 } else { (ldx > 0) as i32 }
  } else {
    let left = fixed_mul(ldy >> FRACBITS, x - lines[line].x1)
    let right = fixed_mul(y - lines[line].y1, ldx >> FRACBITS)
    if right < left { 0 } else { 1 }
  }
}

// Which side of a line a box is on, or -1 if the line goes through it
// (P_BoxOnLineSide).
fn box_on_line_side(lines: Lines, line: i32, top: i32, bottom: i32, left: i32,
                    right: i32) -> i32 {
  let slope = lines[line].slopetype
  let p1 = if slope == ST_HORIZONTAL {
    (top > lines[line].y1) as i32 ^ (lines[line].dx < 0) as i32
  } else if slope == ST_VERTICAL {
    (right < lines[line].x1) as i32 ^ (lines[line].dy < 0) as i32
  } else if slope == ST_POSITIVE {
    point_on_line_side(lines, line, left, top)
  } else {
    point_on_line_side(lines, line, right, top)
  }
  let p2 = if slope == ST_HORIZONTAL {
    (bottom > lines[line].y1) as i32 ^ (lines[line].dx < 0) as i32
  } else if slope == ST_VERTICAL {
    (left < lines[line].x1) as i32 ^ (lines[line].dy < 0) as i32
  } else if slope == ST_POSITIVE {
    point_on_line_side(lines, line, right, bottom)
  } else {
    point_on_line_side(lines, line, left, bottom)
  }
  if p1 == p2 { p1 } else { -1 }
}

// Which side of a path a point is on, the path from (lx, ly), (ldx, ldy)
// on (P_PointOnDivlineSide).
fn point_on_divline_side(x: i32, y: i32, lx: i32, ly: i32, ldx: i32,
                         ldy: i32) -> i32 {
  if ldx == 0 {
    if x <= lx { (ldy > 0) as i32 } else { (ldy < 0) as i32 }
  } else if ldy == 0 {
    if y <= ly { (ldx < 0) as i32 } else { (ldx > 0) as i32 }
  } else {
    let dx = x - lx
    let dy = y - ly
    if (ldy ^ ldx ^ dx ^ dy) & 0x80000000 != 0 {
      if (ldy ^ dx) & 0x80000000 != 0 { 1 } else { 0 }
    } else {
      let left = fixed_mul(ldy >> 8, dx >> 8)
      let right = fixed_mul(dy >> 8, ldx >> 8)
      if right < left { 0 } else { 1 }
    }
  }
}

// How far along the path v2 the line v1 crosses it, 1.0 being its end
// (P_InterceptVector).
fn intercept_vector(v2x: i32, v2y: i32, v2dx: i32, v2dy: i32, v1x: i32,
                    v1y: i32, v1dx: i32, v1dy: i32) -> i32 {
  let den = fixed_mul(v1dy >> 8, v2dx) - fixed_mul(v1dx >> 8, v2dy)
  if den == 0 {
    0
  } else {
    fixed_div(fixed_mul((v1x - v2x) >> 8, v1dy) +
                  fixed_mul((v2y - v1y) >> 8, v1dx),
              den)
  }
}

// The opening of a line with two sides: the lower ceiling, the higher
// floor and the lower floor of its two sectors (P_LineOpening).
fn open_top(lines: Lines, sectors: Sectors, line: i32) -> i32 {
  min(sectors[lines[line].frontsector].ceilingheight,
      sectors[lines[line].backsector].ceilingheight)
}
fn open_bottom(lines: Lines, sectors: Sectors, line: i32) -> i32 {
  max(sectors[lines[line].frontsector].floorheight,
      sectors[lines[line].backsector].floorheight)
}
fn low_floor(lines: Lines, sectors: Sectors, line: i32) -> i32 {
  min(sectors[lines[line].frontsector].floorheight,
      sectors[lines[line].backsector].floorheight)
}

// The floor and the ceiling a thing of that width has at (x, y): those
// of the sector it is in, made narrower by every opening it reaches
// into; a wall it is in ends the looking (the lines' half of
// P_CheckPosition, for things that are where they are).
fn heights_at(lines: Lines, sectors: Sectors, subsectors: Subsectors,
              nodes: Nodes, bytes: Bytes, bmap: Bmap, x: i32, y: i32,
              radius: i32, flags: i32, monster: bool) -> (i32, i32) {
  let top = y + radius
  let bottom = y - radius
  let right = x + radius
  let left = x - radius
  let sector = subsectors[point_in_subsector(nodes, x, y)].sector
  var floorz = sectors[sector].floorheight
  var ceilingz = sectors[sector].ceilingheight
  var ok = flags & MF_NOCLIP == 0
  let xl = (left - bmap[0].orgx) >> MAPBLOCKSHIFT
  let xh = (right - bmap[0].orgx) >> MAPBLOCKSHIFT
  let yl = (bottom - bmap[0].orgy) >> MAPBLOCKSHIFT
  let yh = (top - bmap[0].orgy) >> MAPBLOCKSHIFT
  for bx in xl..xh + 1 {
    for by in yl..yh + 1 {
      if ok && bx >= 0 && by >= 0 && bx < bmap[0].width && by < bmap[0].height {
        var list = bmap[0].at +
            short_at(bytes, bmap[0].at + (4 + by * bmap[0].width + bx) * 2) * 2
        while ok && short_at(bytes, list) != -1 {
          let l = short_at(bytes, list)
          list += 2
          if right <= lines[l].left || left >= lines[l].right ||
             top <= lines[l].bottom || bottom >= lines[l].top {
            // (Not near it.)
          } else if box_on_line_side(lines, l, top, bottom, left, right) != -1 {
            // (All on one side of it.)
          } else if lines[l].backsector < 0 || lines[l].flags & ML_BLOCKING != 0 ||
                    (monster && lines[l].flags & ML_BLOCKMONSTERS != 0) {
            ok = false
          } else {
            ceilingz min= open_top(lines, sectors, l)
            floorz max= open_bottom(lines, sectors, l)
          }
        }
      }
    }
  }
  (floorz, ceilingz)
}

// The things near enough to one to be in its way, into `Near`, and
// `Nearorder`: their rows in the order the blockmap has them in, square
// by square, in a square the one put there last first.
proc gather_near(things: Mobj, me: entity, bmap: Bmap, near: mut Near,
                 order: mut Nearorder) {
  near = []
  order = []
  let x = things[me].x
  let y = things[me].y
  let xl = (x - NEARREACH - bmap[0].orgx) >> MAPBLOCKSHIFT
  let xh = (x + NEARREACH - bmap[0].orgx) >> MAPBLOCKSHIFT
  let yl = (y - NEARREACH - bmap[0].orgy) >> MAPBLOCKSHIFT
  let yh = (y + NEARREACH - bmap[0].orgy) >> MAPBLOCKSHIFT
  for o, other in things where o != me && !other.gone && other.block >= 0 {
    // (By the square it is found in, which is where it is unless the
    // blockmap was written over.)
    let bx = block_x(bmap, other.block)
    let by = block_y(bmap, other.block)
    if bx >= xl && bx <= xh && by >= yl && by <= yh && bx >= 0 {
      near += {
        id: other.id, x: other.x, y: other.y, z: other.z, radius: other.radius,
        height: other.height, flags: other.flags, type: other.type,
        sprite: other.sprite, bx: bx, by: by, linked: other.linked, gone: false
      }
    }
  }
  for i in 0..len(near) {
    order += { index: i }
    var at = i
    var settled = false
    while at > 0 && !settled {
      let before = order[at - 1].index
      if near[before].bx > near[i].bx ||
         (near[before].bx == near[i].bx &&
          (near[before].by > near[i].by ||
           (near[before].by == near[i].by && near[before].linked < near[i].linked))) {
        order[at].index = before
        at -= 1
      } else {
        settled = true
      }
    }
    order[at].index = i
  }
}

// Whether the player's thing can be at (x, y): no wall and no solid
// thing is in its way there. Leaves in `Tm` the floor and ceiling it
// would have, and in `Spechit` the special lines it touches
// (P_CheckPosition, PIT_CheckThing, PIT_CheckLine).
proc check_position(lines: mut Lines, sectors: Sectors,
                    subsectors: Subsectors, nodes: Nodes, bytes: Bytes,
                    bmap: Bmap, near: Near, order: Nearorder, tm: mut Tm,
                    spechit: mut Spechit, touched: mut Touched, x: i32,
                    y: i32, z: i32, radius: i32, flags: i32,
                    player: bool, height: i32, shooter: i32,
                    shooterid: i32) -> bool {
  let top = y + radius
  let bottom = y - radius
  let right = x + radius
  let left = x - radius
  let sector = subsectors[point_in_subsector(nodes, x, y)].sector
  tm[0].ceilingline = -1
  tm[0].floorz = sectors[sector].floorheight
  tm[0].dropoffz = sectors[sector].floorheight
  tm[0].ceilingz = sectors[sector].ceilingheight
  tm[0].validcount += 1
  tm[0].hit = 0
  spechit = []
  let validcount = tm[0].validcount
  let orgx = bmap[0].orgx
  let orgy = bmap[0].orgy
  var ok = true
  if flags & MF_NOCLIP == 0 {
    // The things in the squares around, each as wide as the widest.
    let txl = (left - orgx - MAXRADIUS) >> MAPBLOCKSHIFT
    let txh = (right - orgx + MAXRADIUS) >> MAPBLOCKSHIFT
    let tyl = (bottom - orgy - MAXRADIUS) >> MAPBLOCKSHIFT
    let tyh = (top - orgy + MAXRADIUS) >> MAPBLOCKSHIFT
    for k in 0..len(order) {
      let n = order[k].index
      if ok && !near[n].gone && near[n].bx >= txl && near[n].bx <= txh &&
         near[n].by >= tyl && near[n].by <= tyh &&
         near[n].flags & (MF_SOLID | MF_SPECIAL | MF_SHOOTABLE) != 0 {
        let blockdist = near[n].radius + radius
        if abs(near[n].x - x) < blockdist && abs(near[n].y - y) < blockdist {
          if flags & MF_MISSILE != 0 {
            // A missile: over it or under it, or into it. Not into the
            // one that shot it, and it only stops at one of that one's
            // kind; what cannot be hurt stops it if it is solid, and
            // anything else is hit (`tm.hit`).
            if z > near[n].z + near[n].height || z + height < near[n].z {
              // (Past it.)
            } else if shooter >= 0 && near[n].id == shooterid &&
                      (shooter == near[n].type ||
                       (shooter == MT_KNIGHT && near[n].type == MT_BRUISER) ||
                       (shooter == MT_BRUISER && near[n].type == MT_KNIGHT)) {
              // (Past the one that shot it.)
            } else if shooter >= 0 && near[n].type != MT_PLAYER &&
                      (shooter == near[n].type ||
                       (shooter == MT_KNIGHT && near[n].type == MT_BRUISER) ||
                       (shooter == MT_BRUISER && near[n].type == MT_KNIGHT)) {
              ok = false
            } else if near[n].flags & MF_SHOOTABLE == 0 {
              if near[n].flags & MF_SOLID != 0 { ok = false }
            } else {
              tm[0].hit = near[n].id
              ok = false
            }
          } else {
            // What can be picked up is touched (and picked up after the
            // player has moved, in this order); what is solid stops.
            if near[n].flags & MF_SPECIAL != 0 && flags & MF_PICKUP != 0 {
              touched += { id: near[n].id, z: z }
            }
            if near[n].flags & MF_SOLID != 0 { ok = false }
          }
        }
      }
    }
    // The lines in the squares it is in.
    let xl = (left - orgx) >> MAPBLOCKSHIFT
    let xh = (right - orgx) >> MAPBLOCKSHIFT
    let yl = (bottom - orgy) >> MAPBLOCKSHIFT
    let yh = (top - orgy) >> MAPBLOCKSHIFT
    for bx in xl..xh + 1 {
      for by in yl..yh + 1 {
        if ok && bx >= 0 && by >= 0 && bx < bmap[0].width && by < bmap[0].height {
          var list = bmap[0].at +
              short_at(bytes, bmap[0].at + (4 + by * bmap[0].width + bx) * 2) * 2
          while ok && short_at(bytes, list) != -1 {
            let l = short_at(bytes, list)
            list += 2
            if lines[l].validcount != validcount {
              lines[l].validcount = validcount
              if right <= lines[l].left || left >= lines[l].right ||
                 top <= lines[l].bottom || bottom >= lines[l].top {
                // (Not near it.)
              } else if box_on_line_side(lines, l, top, bottom, left, right) != -1 {
                // (All on one side of it.)
              } else if lines[l].backsector < 0 ||
                        (flags & MF_MISSILE == 0 &&
                         (lines[l].flags & ML_BLOCKING != 0 ||
                          (!player && lines[l].flags & ML_BLOCKMONSTERS != 0))) {
                // A wall, or a line that stops what walks, or monsters.
                ok = false
              } else {
                // An opening: the place is as high as it lets it be.
                let opentop = open_top(lines, sectors, l)
                if opentop < tm[0].ceilingz {
                  tm[0].ceilingz = opentop
                  tm[0].ceilingline = l
                }
                tm[0].floorz max= open_bottom(lines, sectors, l)
                tm[0].dropoffz min= low_floor(lines, sectors, l)
                if lines[l].special != 0 { spechit += { line: l } }
              }
            }
          }
        }
      }
    }
  }
  ok
}

// The lines a path from (x1, y1) to (x2, y2) crosses, into `Intercepts`
// with how far along it each is (P_PathTraverse with PT_ADDLINES,
// PIT_AddLineIntercepts).
// A line or a thing that a path crosses is noted. The reference has
// room for 128 of them and notes more all the same, over what lies
// after: where the blockmap starts, how wide and how high it is, and the
// slope of the player's shots are then what was noted there
// (InterceptsOverrun). Some levels are played so.
proc add_intercept(intercepts: mut Intercepts, bmap: mut Bmap, tm: mut Tm,
                   frac: i32, line: i32, thing: i32) {
  let n = len(intercepts)
  intercepts += { frac: frac, line: line, thing: thing }
  if n > 128 {
    let isaline = (thing == 0) as i32
    if n == 142 {
      tm[0].overslope = isaline
      tm[0].overset = true
    }
    if n == 147 { bmap[0].width = isaline }
    if n == 148 {
      bmap[0].orgx = frac
      bmap[0].orgy = isaline
    }
    if n == 149 { bmap[0].height = frac }
  }
}

// With `addthings`, the things in the squares it goes through too, each
// by the diagonal of its square that lies across the path
// (PIT_AddThingIntercepts).
proc path_lines(things: Mobj, addthings: bool, lines: mut Lines, bytes: Bytes,
                bmap: mut Bmap, tm: mut Tm, intercepts: mut Intercepts,
                x1in: i32, y1in: i32, x2in: i32, y2in: i32) {
  tm[0].validcount += 1
  let validcount = tm[0].validcount
  intercepts = []
  let orgx = bmap[0].orgx
  let orgy = bmap[0].orgy
  // (Not from exactly on the edge of a square.)
  let tx = if (x1in - orgx) & (MAPBLOCKSIZE - 1) == 0 { x1in + FRACUNIT } else { x1in }
  let ty = if (y1in - orgy) & (MAPBLOCKSIZE - 1) == 0 { y1in + FRACUNIT } else { y1in }
  let tdx = x2in - tx
  let tdy = y2in - ty
  let x1 = tx - orgx
  let y1 = ty - orgy
  let x2 = x2in - orgx
  let y2 = y2in - orgy
  let xt1 = x1 >> MAPBLOCKSHIFT
  let yt1 = y1 >> MAPBLOCKSHIFT
  let xt2 = x2 >> MAPBLOCKSHIFT
  let yt2 = y2 >> MAPBLOCKSHIFT
  // From square to square along the path.
  let mapxstep = if xt2 > xt1 { 1 } else if xt2 < xt1 { -1 } else { 0 }
  let ystep = if xt2 != xt1 { fixed_div(y2 - y1, abs(x2 - x1)) } else { 256 * FRACUNIT }
  let xpartial = if xt2 > xt1 {
    FRACUNIT - ((x1 >> MAPBTOFRAC) & (FRACUNIT - 1))
  } else if xt2 < xt1 {
    (x1 >> MAPBTOFRAC) & (FRACUNIT - 1)
  } else {
    FRACUNIT
  }
  var yintercept = (y1 >> MAPBTOFRAC) + fixed_mul(xpartial, ystep)
  let mapystep = if yt2 > yt1 { 1 } else if yt2 < yt1 { -1 } else { 0 }
  let xstep = if yt2 != yt1 { fixed_div(x2 - x1, abs(y2 - y1)) } else { 256 * FRACUNIT }
  let ypartial = if yt2 > yt1 {
    FRACUNIT - ((y1 >> MAPBTOFRAC) & (FRACUNIT - 1))
  } else if yt2 < yt1 {
    (y1 >> MAPBTOFRAC) & (FRACUNIT - 1)
  } else {
    FRACUNIT
  }
  var xintercept = (x1 >> MAPBTOFRAC) + fixed_mul(ypartial, xstep)
  var mapx = xt1
  var mapy = yt1
  var there = false
  let long = tdx > FRACUNIT * 16 || tdy > FRACUNIT * 16 ||
             tdx < -FRACUNIT * 16 || tdy < -FRACUNIT * 16
  for count in 0..64 {
    if !there {
      if mapx >= 0 && mapy >= 0 && mapx < bmap[0].width && mapy < bmap[0].height {
        var list = bmap[0].at +
            short_at(bytes, bmap[0].at + (4 + mapy * bmap[0].width + mapx) * 2) * 2
        while short_at(bytes, list) != -1 {
          let l = short_at(bytes, list)
          list += 2
          if lines[l].validcount != validcount {
            lines[l].validcount = validcount
            // Its ends on two sides of the path, or the path's ends on
            // two sides of it: by the first where the path is long.
            let s1 = if long {
              point_on_divline_side(lines[l].x1, lines[l].y1, tx, ty, tdx, tdy)
            } else {
              point_on_line_side(lines, l, tx, ty)
            }
            let s2 = if long {
              point_on_divline_side(lines[l].x2, lines[l].y2, tx, ty, tdx, tdy)
            } else {
              point_on_line_side(lines, l, tx + tdx, ty + tdy)
            }
            if s1 != s2 {
              let frac = intercept_vector(tx, ty, tdx, tdy, lines[l].x1,
                                          lines[l].y1, lines[l].dx, lines[l].dy)
              if frac >= 0 { add_intercept(intercepts, bmap, tm, frac, l, 0) }
            }
          }
        }
        if addthings {
          let positive = tdx ^ tdy > 0
          let here = if mapx >= 0 && mapy >= 0 && mapx < bmap[0].width &&
                        mapy < bmap[0].height {
            mapy * bmap[0].width + mapx
          } else {
            -2
          }
          for other in things where !other.gone && other.block == here {
            let ax = other.x - other.radius
            let ay = if positive { other.y + other.radius } else { other.y - other.radius }
            let bx = other.x + other.radius
            let by = if positive { other.y - other.radius } else { other.y + other.radius }
            if point_on_divline_side(ax, ay, tx, ty, tdx, tdy) !=
               point_on_divline_side(bx, by, tx, ty, tdx, tdy) {
              let frac = intercept_vector(tx, ty, tdx, tdy, ax, ay, bx - ax, by - ay)
              if frac >= 0 { add_intercept(intercepts, bmap, tm, frac, 0, other.id) }
            }
          }
        }
      }
      if mapx == xt2 && mapy == yt2 {
        there = true
      } else if yintercept >> FRACBITS == mapy {
        yintercept += ystep
        mapx += mapxstep
      } else if xintercept >> FRACBITS == mapx {
        xintercept += xstep
        mapy += mapystep
      }
    }
  }
}

// The nearest line on a path that stops the player's thing, into `Tm`
// if it is nearer than what was found (P_TraverseIntercepts with
// PTR_SlideTraverse).
proc slide_traverse(lines: mut Lines, sectors: Sectors, bytes: Bytes,
                    bmap: mut Bmap, tm: mut Tm, intercepts: mut Intercepts,
                    things: Mobj, me: entity, x1: i32, y1: i32, x2: i32, y2: i32) {
  path_lines(things, false, lines, bytes, bmap, tm, intercepts, x1, y1, x2, y2)
  var left = len(intercepts)
  var going = true
  while going && left > 0 {
    left -= 1
    // The nearest that is left.
    var dist = 0x7fffffff
    var nearest = 0
    for s in 0..len(intercepts) {
      if intercepts[s].frac < dist {
        dist = intercepts[s].frac
        nearest = s
      }
    }
    if dist > FRACUNIT {
      going = false
    } else {
      let li = intercepts[nearest].line
      // A wall stops it, from its front; an opening if the thing does
      // not fit or the step is too high.
      let blocking = if lines[li].flags & ML_TWOSIDED == 0 {
        point_on_line_side(lines, li, things[me].x, things[me].y) == 0
      } else {
        open_top(lines, sectors, li) - open_bottom(lines, sectors, li) < things[me].height ||
        open_top(lines, sectors, li) - things[me].z < things[me].height ||
        open_bottom(lines, sectors, li) - things[me].z > MAXSTEP
      }
      if blocking {
        if dist < tm[0].bestslidefrac {
          tm[0].bestslidefrac = dist
          tm[0].bestslideline = li
        }
        going = false
      } else {
        intercepts[nearest].frac = 0x7fffffff
      }
    }
  }
}

// What the player does in a tic before anything moves (P_PlayerThink as
// far as it is): turned and made faster by the keys, and the eye where
// that puts it.
proc player_think(things: mut Mobj, me: entity, pl: mut Pl, leveltime: i32) {
  // P_MovePlayer.
  if things[me].reactiontime != 0 {
    things[me].reactiontime -= 1
  } else {
    things[me].angle += (pl[0].angleturn << FRACBITS) as u32
    let onground = things[me].z <= things[me].floorz
    let fine = (things[me].angle >> ANGLETOFINESHIFT) as i32
    if pl[0].forwardmove != 0 && onground {
      things[me].momx += fixed_mul(pl[0].forwardmove * 2048, finecosine(fine))
      things[me].momy += fixed_mul(pl[0].forwardmove * 2048, finesine[fine])
    }
    let side = ((things[me].angle - ANG90) >> ANGLETOFINESHIFT) as i32
    if pl[0].sidemove != 0 && onground {
      things[me].momx += fixed_mul(pl[0].sidemove * 2048, finecosine(side))
      things[me].momy += fixed_mul(pl[0].sidemove * 2048, finesine[side])
    }
    if (pl[0].forwardmove != 0 || pl[0].sidemove != 0) && things[me].state == S_PLAY {
      things[me].state = S_PLAY_RUN1
      things[me].tics = states[S_PLAY_RUN1].tics
    }
  }
  // P_CalcHeight: the eye bobs with how fast the player goes.
  pl[0].bob = min((fixed_mul(things[me].momx, things[me].momx) +
                   fixed_mul(things[me].momy, things[me].momy)) >> 2, MAXBOB)
  if things[me].z > things[me].floorz {
    pl[0].viewz = things[me].z + pl[0].viewheight
  } else {
    let bob = fixed_mul(pl[0].bob / 2,
                        finesine[(FINEANGLES / 20 * leveltime) & FINEMASK])
    pl[0].viewheight += pl[0].deltaviewheight
    if pl[0].viewheight > VIEWHEIGHT {
      pl[0].viewheight = VIEWHEIGHT
      pl[0].deltaviewheight = 0
    }
    if pl[0].viewheight < VIEWHEIGHT / 2 {
      pl[0].viewheight = VIEWHEIGHT / 2
      if pl[0].deltaviewheight <= 0 { pl[0].deltaviewheight = 1 }
    }
    if pl[0].deltaviewheight != 0 {
      pl[0].deltaviewheight += FRACUNIT / 4
      if pl[0].deltaviewheight == 0 { pl[0].deltaviewheight = 1 }
    }
    pl[0].viewz = min(things[me].z + pl[0].viewheight + bob,
                      things[me].ceilingz - 4 * FRACUNIT)
  }
}

// What the player and the checking of places start with, after
// `spawn_things`.
// (`fresh`: a new game, or the level again after a death: with the
// pistol and fifty bullets. Else the player comes from the level before
// with what it had, but the keys and the powers.)
system start_player(fresh: bool) {
  Pl = [{
    viewz: Spawned.playerz + VIEWHEIGHT, viewheight: VIEWHEIGHT,
    // (The keys count as down, so that nothing is done at once.)
    deltaviewheight: 0, bob: 0, usedown: true, forwardmove: 0, sidemove: 0,
    angleturn: 0, buttons: 0, attackdown: true, refire: 0, extralight: 0,
    dead: false
  }; 1]
  Tm = [{
    floorz: 0, ceilingz: 0, dropoffz: 0, ceilingline: -1, validcount: 1,
    bestslidefrac: 0, bestslideline: 0, links: Spawned.links, hit: 0,
    overslope: 0, overset: false
  }; 1]
  if fresh {
    // G_PlayerReborn: a pistol, fifty bullets and two fists.
    Inv = [{
      armorpoints: 0, armortype: 0, weapons: 1 << WP_FIST | 1 << WP_PISTOL,
      cards: 0, backpack: false, readyweapon: WP_PISTOL,
      pendingweapon: WP_NOCHANGE, itemcount: 0, bonuscount: 0, attacker: 0,
      damagecount: 0
    }; 1]
    Ammo = []
    Ammo += { count: 50, most: 200 }
    Ammo += { count: 0, most: 50 }
    Ammo += { count: 0, most: 300 }
    Ammo += { count: 0, most: 50 }
  } else {
    // (G_PlayerFinishLevel.)
    Inv[0].cards = 0
    Inv[0].pendingweapon = WP_NOCHANGE
    Inv[0].bonuscount = 0
    Inv[0].damagecount = 0
    Inv[0].attacker = 0
    for m: mut Mobj where m.type == MT_PLAYER { m.health = Kept.health }
  }
  Powers = [{ tics: 0 }; 6]
}

// The player's tic starts: the demo's keys for it, and what the player
// does before anything moves (P_PlayerThink).
system think_player() {
  Pl[0].forwardmove = Ticcmds[Demo.tic].forwardmove
  Pl[0].sidemove = Ticcmds[Demo.tic].sidemove
  Pl[0].angleturn = Ticcmds[Demo.tic].angleturn
  Pl[0].buttons = Ticcmds[Demo.tic].buttons
  Demo.tic += 1
  Demo.over = Demo.tic >= len(Ticcmds)
  for e, m: mut Mobj in turn by m.id where m.type == MT_PLAYER {
    // (Dead, it does no more of this: see `player_sector`.)
    // (Sawing, it is pulled on whatever the keys say.)
    if m.flags & MF_JUSTATTACKED != 0 {
      Pl[0].angleturn = 0
      Pl[0].forwardmove = 0xc800 / 512
      Pl[0].sidemove = 0
      m.flags &= ~MF_JUSTATTACKED
    }
    if m.health <= 0 { Pl[0].dead = true }
    if !Pl[0].dead { player_think(Mobj, e, Pl, Clock.leveltime) }
    m.sprite = states[m.state].sprite
    m.frame = states[m.state].frame
  }
}

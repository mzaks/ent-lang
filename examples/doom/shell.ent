  { prompt: 6, line: "(press y to quit to dos.)" },
  { prompt: 7, line: "ya know, next time you come in here" },
  { prompt: 7, line: "i'm gonna toast ya." },
  { prompt: 7, line: "" },
  { prompt: 7, line: "(press y to quit to dos.)" },
  { prompt: 8, line: "go ahead and leave. see if i care." },
  { prompt: 8, line: "" },
  { prompt: 8, line: "(press y to quit to dos.)" },
  { prompt: 9, line: "are you sure you want to end the game?" },
  { prompt: 9, line: "" },
  { prompt: 9, line: "press y or n." },
  { prompt: 10, line: "this is the shareware version of doom." },
  { prompt: 10, line: "" },
  { prompt: 10, line: "you need to order the entire trilogy." },

//
// What is around the game (d_main.c's pages, m_menu.c): the title, the
// WAD's three demos played one after another with a picture between
// them, and over any of it the menu, from which a new game is started.
//
// A game is saved as the world it is (the module `world`), in one of six
// places that the player names; the names are in a file of their own.
//
// The mouse moves the skull too, as it does in the game: far enough up
// or down is a line up or down, to a side sets a line lower or higher,
// the left button chooses and the right one goes back.
//
// The Pause key (or P) stops the player's game and lets it go on; F11
// shows the picture lighter, in four steps and then as it is again.
// The menu opens by any key while no game of the player's is going on,
// and by the Esc key always, which shuts it too; the player's own game
// stands still while it is open.
import files
import wad
import window
import video
import random
import level
import things
import demo
import play
import tick
import sounds
import screen
import render
import items
import world

// `game`: the player's own game is going on; `demo`: a demo is played.
// `page`: where the round of title, demos and pictures is (0 the title,
// 1 the first demo, 2 a picture, 3 the second demo, 4 a picture, 5 the
// third demo), `pagetic`: how long the picture stays. `turn`: the next
// page is due. `start`: a new game was asked for, of `skill`; `wanted`:
// a demo is to be started; `fresh`: one of the two, now. `quit`: the
// program is to end. `resize`: the view is of another size or detail
// now. `lighter`: the picture is to be shown lighter or darker now.
transient unique Shell {
  game: bool, demo: bool, page: i32, pagetic: i32, turn: bool, start: bool,
  skill: i32, wanted: bool, fresh: bool, quit: bool, resize: bool,
  lighter: bool
}

// Whether the map is shown, and whether Tab was down the tic before.
transient unique Shown { map: bool, tab: bool }

// The menus (m_menu.c): how many lines each has, which one Backspace
// goes back to (0: none), where its first line is drawn, and where its
// lines start in `menu_lines`. The first is no menu.
const MENU_MAIN = 1
const MENU_EPISODE = 2
const MENU_SKILL = 3
const MENU_OPTIONS = 4
const MENU_READ1 = 5
const MENU_READ2 = 6
const MENU_SOUND = 7
const MENU_LOAD = 8
const MENU_SAVE = 9
table menus { lines: i32, back: i32, x: i32, y: i32, first: i32 } = [
  { lines: 0, back: 0, x: 0, y: 0, first: 0 },
  { lines: 6, back: 0, x: 97, y: 64, first: 0 },
  { lines: 3, back: 1, x: 48, y: 63, first: 6 },
  { lines: 5, back: 2, x: 48, y: 63, first: 9 },
  { lines: 8, back: 1, x: 60, y: 37, first: 14 },
  { lines: 1, back: 1, x: 280, y: 185, first: 22 },
  { lines: 1, back: 5, x: 330, y: 175, first: 23 },
  { lines: 4, back: 4, x: 80, y: 64, first: 24 },
  { lines: 6, back: 1, x: 80, y: 54, first: 28 },
  { lines: 6, back: 1, x: 80, y: 54, first: 34 }
]
// A line of a menu: what it is (1: something to choose, 2: something to
// set lower or higher with the left and right keys, -1: nothing, the
// room under such a one), its picture's lump, and the letter that

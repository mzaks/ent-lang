table menu_lines { kind: i32, name: text[8], letter: i32 } = [
  { kind: 1, name: "M_NGAME", letter: 78 },
  { kind: 1, name: "M_OPTION", letter: 79 },
  { kind: 1, name: "M_LOADG", letter: 76 },
  { kind: 1, name: "M_SAVEG", letter: 83 },
  { kind: 1, name: "M_RDTHIS", letter: 82 },
  { kind: 1, name: "M_QUITG", letter: 81 },
  { kind: 1, name: "M_EPI1", letter: 75 },
  { kind: 1, name: "M_EPI2", letter: 84 },
  { kind: 1, name: "M_EPI3", letter: 73 },
  { kind: 1, name: "M_JKILL", letter: 73 },
  { kind: 1, name: "M_ROUGH", letter: 72 },
  { kind: 1, name: "M_HURT", letter: 72 },
  { kind: 1, name: "M_ULTRA", letter: 85 },
  { kind: 1, name: "M_NMARE", letter: 78 },
  { kind: 1, name: "M_ENDGAM", letter: 69 },
  { kind: 1, name: "M_MESSG", letter: 77 },
  { kind: 1, name: "M_DETAIL", letter: 71 },
  { kind: 2, name: "M_SCRNSZ", letter: 83 },
  { kind: -1, name: "", letter: 0 },
  { kind: 2, name: "M_MSENS", letter: 77 },
  { kind: -1, name: "", letter: 0 },
  { kind: 1, name: "M_SVOL", letter: 83 },
  { kind: 1, name: "", letter: 0 },
  { kind: 1, name: "", letter: 0 },
  { kind: 2, name: "M_SFXVOL", letter: 83 },
  { kind: -1, name: "", letter: 0 },
  { kind: 2, name: "M_MUSVOL", letter: 77 },
  { kind: -1, name: "", letter: 0 },
  { kind: 1, name: "", letter: 49 },
  { kind: 1, name: "", letter: 50 },
  { kind: 1, name: "", letter: 51 },
  { kind: 1, name: "", letter: 52 },
  { kind: 1, name: "", letter: 53 },
  { kind: 1, name: "", letter: 54 },
  { kind: 1, name: "", letter: 49 },
  { kind: 1, name: "", letter: 50 },
  { kind: 1, name: "", letter: 51 },
  { kind: 1, name: "", letter: 52 },
  { kind: 1, name: "", letter: 53 },
  { kind: 1, name: "", letter: 54 }
]

// What the player is asked or told in the middle of the screen
// (M_StartMessage), line under line: the eight ways of asking whether
// to leave, of which the tic decides one; whether to end the game; and
// what cannot be done.
const PROMPT_QUIT = 1
const PROMPT_ENDGAME = 9
const PROMPT_SHAREWARE = 10
const PROMPT_SAVEDEAD = 11
const PROMPT_NOSPOT = 12
const PROMPT_QUICKSAVE = 13
const PROMPT_QUICKLOAD = 14
const PROMPT_NIGHTMARE = 15
table prompt_lines { prompt: i32, line: text[48] } = [
  { prompt: 1, line: "are you sure you want to" },
  { prompt: 1, line: "quit this great game?" },
  { prompt: 1, line: "" },
  { prompt: 1, line: "(press y to quit to dos.)" },
  { prompt: 2, line: "please don't leave, there's more" },
  { prompt: 2, line: "demons to toast!" },
  { prompt: 2, line: "" },
  { prompt: 2, line: "(press y to quit to dos.)" },
  { prompt: 3, line: "let's beat it -- this is turning" },
  { prompt: 3, line: "into a bloodbath!" },

// The sound the game leaves with, by the tic (quitsounds).
table quit_sounds: i32 = [57, 26, 27, 31, 35, 36, 38, 52]

// The menu: whether it is open (`on`), which one and which of its lines
// the skull is at, which of the skull's two pictures is shown and for
// how long still; what is asked in the middle of the screen (`prompt`,
// 0: nothing) and whether only y, n, the space bar and Esc answer it
// (`answer`), and whether the menu was open when it was asked and is
// gone back to after (`under`); how fast the mouse turns (`mouse`, 0 to 9); and for how
// many tics still the game waits before it ends (`leaving`).
// How far the mouse has moved in the menu (`mx`, `my`) and where it was
// when it last moved the skull (`lastx`, `lasty`); the tic until which
// it does nothing (`wait`), and its buttons the tic before (`held`).
transient unique Menu {
  on: bool, which: i32, item: i32, skull: i32, count: i32, prompt: i32,
  answer: bool, mouse: i32, leaving: i32, tic: i32, mx: i32, my: i32,
  lastx: i32, lasty: i32, wait: i32, held: i32, under: bool
}
// The line the skull was at when each menu was left, and which keys
// were down the tic before: the eleven of `menu_keys`, the eleven from
// F1 on, and the letters.
transient buffer Laston { item: i32 } capacity 10
transient buffer Keyheld { down: bool } capacity 64

// Saving and loading (M_SaveGame, M_LoadGame, G_DoSaveGame): `save`,
// `load`: the world is to be written or read this tic, in the place
// `which`; `loaded`: it was read. `room`: where in `Bytes` the names'
// file is read and written. `quick`: the place for saving in a hurry
// (-1: none yet, -2: the next one that is saved in). `typing`: a name is
// being typed for the place `which`, and has `at` letters.
transient unique Slot {
  save: bool, load: bool, which: i32, loaded: bool, room: i32, quick: i32,
  typing: bool, at: i32
}
// The names of the six places, 24 bytes each (the first nought: nothing
// is saved there), and after them the name that is typed over.
const SLOTS = 6
const SLOTNAME = 24
transient buffer Slotnames { c: u8 } capacity 168
const LINEHEIGHT = 16
const SKULLXOFF = -32

world {
  Shell.page = -1
  Shell.turn = true
  Menu.count = 10
  Menu.which = MENU_MAIN
  Menu.mouse = 5
  Slot.quick = -1
  Volume.sfx = 8
  Volume.music = 8
  // (The Esc key is the menu's.)
  Window.escape = true
}

// Whether a key went down this tic.
proc struck(held: mut Keyheld, slot: i32, down: bool) -> bool {
  let was = held[slot].down
  held[slot].down = down
  down && !was
}

// How many letters the name of a place has.
fn name_length(names: Slotnames, slot: i32) -> i32 {
  var n = 0
  while n < SLOTNAME && names[slot * SLOTNAME + n].c != 0 { n += 1 }
  n
}

// How wide a place's name is in the game's letters.
fn name_width(bytes: Bytes, font: Hufont, names: Slotnames, slot: i32) -> i32 {
  var width = 0
  for i in 0..name_length(names, slot) {
    let c = names[slot * SLOTNAME + i].c as i32
    width += if c >= HU_FONTSTART && c <= HU_FONTEND {
      short_at(bytes, font[c - HU_FONTSTART].at)
    } else {
      4
    }
  }
  width
}

// The names of the places are read from their file (M_ReadSaveStrings).
proc read_names(bytes: mut Bytes, names: mut Slotnames, room: i32) {
  let got = read_bytes("doomsav.txt", bytes, room, SLOTS * SLOTNAME)
  for i in 0..SLOTS * SLOTNAME {
    names[i].c = if i < got { bytes[room + i].value } else { 0 }
  }
}

// And written.
proc write_names(bytes: mut Bytes, names: Slotnames, room: i32) {
  for i in 0..SLOTS * SLOTNAME { bytes[room + i].value = names[i].c }
  let written = write_bytes("doomsav.txt", bytes, room, SLOTS * SLOTNAME, false)
}

// How far the mouse moved, as the game counts it (I_ReadMouse): what is
// over ten counts twice.
fn mouse_step(moved: f32) -> i32 {
  let by = moved as i32
  let far = max(by, 0 - by)
  let counted = if far > 10 { (far - 10) * 2 + 10 } else { far }
  if by < 0 { 0 - counted } else { counted }
}

// The keys and what they do to the menu (M_Responder, M_Ticker). Once a
// tic, before everything else.
system menu_keys() {
  if len(Laston) == 0 {
    Laston = [{ item: 0 }; 10]
    Laston[MENU_SKILL].item = 2
    Keyheld = [{ down: false }; 64]
    Slotnames = [{ c: 0 }; 168]
    Slot.room = len(Bytes)
    for i in 0..SLOTS * SLOTNAME { Bytes += { value: 0 } }
  }
  Menu.tic += 1
  // (The mouse is the game's while the player's own goes on.)
  Window.grab = Shell.game && !Menu.on && !Pause.on
  Shell.resize = false
  Shell.lighter = false
  Slot.save = false
  Slot.load = false
  Slot.loaded = false
  let was = Menu.on
  // The key of this tic, if one went down: the first of these.
  // The mouse in the menu (of M_Responder): a key of its own making,
  // the last of these that it comes to, and then a wait.
  let stepx = mouse_step(Mouse.dx)
  let stepy = 0 - mouse_step(Mouse.dy)
  let buttons = (if Mouse.left { 1 } else { 0 }) | (if Mouse.right { 2 } else { 0 })
  var moused = 0
  if Menu.on && Menu.tic > Menu.wait &&
     (stepx != 0 || stepy != 0 || buttons != Menu.held) {
    Menu.my += stepy
    if Menu.my < Menu.lasty - 30 {
      moused = 1
      Menu.lasty -= 30
      Menu.my = Menu.lasty
    } else if Menu.my > Menu.lasty + 30 {
      moused = 2
      Menu.lasty += 30
      Menu.my = Menu.lasty
    }
    Menu.mx += stepx
    if Menu.mx < Menu.lastx - 30 {
      moused = 3
      Menu.lastx -= 30
      Menu.mx = Menu.lastx
    } else if Menu.mx > Menu.lastx + 30 {
      moused = 4
      Menu.lastx += 30
      Menu.mx = Menu.lastx
    }
    if moused != 0 { Menu.wait = Menu.tic + 5 }
    if buttons & 1 != 0 {
      moused = 5
      Menu.wait = Menu.tic + 15
    }
    if buttons & 2 != 0 {
      moused = 6
      Menu.wait = Menu.tic + 15
    }
  }
  let pausekey = struck(Keyheld, 60, key_down(284)) || struck(Keyheld, 61, key_down('P' as i32))
  // (A button that goes down opens the menu over a demo or a picture.)
  let click = buttons != 0 && Menu.held == 0
  Menu.held = buttons
  let esc = struck(Keyheld, 0, key_down(256))
  let enter = struck(Keyheld, 1, Keys.enter) || moused == 5
  let back = struck(Keyheld, 2, key_down(259)) || moused == 6
  let up = struck(Keyheld, 3, Keys.up) || moused == 2
  let down = struck(Keyheld, 4, Keys.down) || moused == 1
  let left = struck(Keyheld, 5, Keys.left) || moused == 3
  let right = struck(Keyheld, 6, Keys.right) || moused == 4
  let yes = struck(Keyheld, 7, key_down('Y' as i32))
  let no = struck(Keyheld, 8, key_down('N' as i32))
  let space = struck(Keyheld, 9, Keys.space)
  let fire = struck(Keyheld, 10, key_down(341))
  var fkey = 0
  for i in 0..11 {
    if struck(Keyheld, 11 + i, key_down(290 + i)) && fkey == 0 { fkey = i + 1 }
  }
  let less = struck(Keyheld, 22, key_down('-' as i32))
  let more = struck(Keyheld, 23, key_down('=' as i32))
  var letter = 0
  for i in 0..26 {
    if struck(Keyheld, 24 + i, key_down('A' as i32 + i)) && letter == 0 { letter = 'A' as i32 + i }
  }
  for i in 0..10 {
    if struck(Keyheld, 50 + i, key_down('0' as i32 + i)) && letter == 0 { letter = '0' as i32 + i }
  }
  let any = esc || enter || back || up || down || left || right || space || fire ||
            fkey != 0 || less || more || letter != 0 || click
  // (What a line that is set lower or higher is set to: -1, 1, or 0.)
  var set = 0
  // (What a line that is chosen does: the menu and the line.)
  var chosen = -1
  Rnd = [{ play: Random.play, other: Random.other }; 1]
  if Menu.leaving > 0 {
    // (Leaving: nothing else, until the sound is over.)
    Menu.leaving -= 1
    if Menu.leaving == 0 { Shell.quit = true }
  } else if Slot.typing {
    // A name for a saved game is typed (saveStringEnter).
    let first = Slot.which * SLOTNAME
    if back {
      if Slot.at > 0 {
        Slot.at -= 1
        Slotnames[first + Slot.at].c = 0
      }
    } else if esc {
      // (Not after all: the name as it was.)
      Slot.typing = false
      for i in 0..SLOTNAME { Slotnames[first + i].c = Slotnames[SLOTS * SLOTNAME + i].c }
    } else if enter {
      Slot.typing = false
      if Slotnames[first].c != 0 {
        // (M_DoSave.)
        Slot.save = true
        Menu.on = false
        if Slot.quick == -2 { Slot.quick = Slot.which }
        write_names(Bytes, Slotnames, Slot.room)
      }
    } else {
      let typed = if letter != 0 {
        letter
      } else if space {
        32
      } else if less {
        45
      } else {
        0
      }
      if typed != 0 && Slot.at < SLOTNAME - 1 &&
         name_width(Bytes, Hufont, Slotnames, Slot.which) < (SLOTNAME - 2) * 8 {
        Slotnames[first + Slot.at].c = typed as u8
        Slot.at += 1
      }
    }
  } else if Menu.prompt != 0 {
    if any && (!Menu.answer || space || esc || yes || no) {
      let asked = Menu.prompt
      Menu.prompt = 0
      // (Back to the menu it was asked from, if any; a yes shuts it.)
      Menu.on = Menu.under && !(yes && Menu.answer)
      if yes && asked >= PROMPT_QUIT && asked < PROMPT_ENDGAME {
        // (M_QuitResponse: a last sound, and three seconds for it.)
        sound(Sounds, Rnd, quit_sounds[(Menu.tic >> 2) & 7], 0)
        Menu.leaving = 105
        Menu.prompt = asked
        Menu.on = true
      } else if yes && asked == PROMPT_ENDGAME {
        // (M_EndGameResponse, D_StartTitle: back to the title.)
        Laston[Menu.which].item = Menu.item
        Shell.page = -1
        Shell.turn = true
      } else if yes && asked == PROMPT_NIGHTMARE {
        Shell.start = true
        Shell.skill = 4
        Menu.on = false
      } else if yes && asked == PROMPT_QUICKSAVE {
        Slot.which = Slot.quick
        Slot.save = true
        sound(Sounds, Rnd, SFX_SWTCHX, 0)
      } else if yes && asked == PROMPT_QUICKLOAD {
        Slot.which = Slot.quick
        Slot.load = true
        sound(Sounds, Rnd, SFX_SWTCHX, 0)
      }
      if Menu.leaving == 0 { sound(Sounds, Rnd, SFX_SWTCHX, 0) }
    }
  } else if !Menu.on {
    if (less || more) && !Shown.map {
      set = if less { -1 } else { 1 }
      chosen = MENU_OPTIONS * 16 + 3
      sound(Sounds, Rnd, SFX_STNMOV, 0)
    } else if fkey == 1 {
      // Help.
      Menu.on = true
      Menu.which = MENU_READ1
      Menu.item = 0
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
    } else if fkey == 2 || fkey == 3 {
      // Save, load: from the first menu.
      Menu.on = true
      Menu.which = MENU_MAIN
      Menu.item = Laston[MENU_MAIN].item
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
      chosen = MENU_MAIN * 16 + if fkey == 2 { 3 } else { 2 }
    } else if fkey == 4 {
      // How loud.
      Menu.on = true
      Menu.which = MENU_SOUND
      Menu.item = 0
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
    } else if fkey == 5 {
      chosen = MENU_OPTIONS * 16 + 2
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
    } else if fkey == 6 {
      // Saving in a hurry (M_QuickSave): the first time the place is
      // chosen, from then on it is only asked.
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
      if !Shell.game {
        sound(Sounds, Rnd, SFX_OOF, 0)
      } else if !Wi.on && !Fin.on {
        if Slot.quick < 0 {
          Menu.on = true
          Menu.which = MENU_SAVE
          Menu.item = Laston[MENU_SAVE].item
          read_names(Bytes, Slotnames, Slot.room)
          Slot.quick = -2
        } else {
          Menu.under = Menu.on
          Menu.prompt = PROMPT_QUICKSAVE
          Menu.answer = true
          Menu.on = true
        }
      }
    } else if fkey == 7 {
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
      chosen = MENU_OPTIONS * 16
    } else if fkey == 8 {
      chosen = MENU_OPTIONS * 16 + 1
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
    } else if fkey == 9 {
      // Loading in a hurry (M_QuickLoad).
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
      Menu.under = Menu.on
      Menu.prompt = if Slot.quick < 0 { PROMPT_NOSPOT } else { PROMPT_QUICKLOAD }
      Menu.answer = Slot.quick >= 0
      Menu.on = true
    } else if fkey == 10 {
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
      chosen = MENU_MAIN * 16 + 5
    } else if fkey == 11 {
      // The picture lighter by a step, and after the fourth as it is.
      Gamma = (Gamma + 1) % 5
      Inv[0].message = MSG_GAMMA + Gamma
      Shell.lighter = true
    } else if pausekey && Shell.game {
      Pause.send = true
    } else if esc {
      Menu.on = true
      Menu.which = MENU_MAIN
      Menu.item = Laston[MENU_MAIN].item
      sound(Sounds, Rnd, SFX_SWTCHN, 0)
    } else if any && !Shell.game {
      // (Any key, while a demo or a picture is shown: G_Responder.)
      Menu.on = true
      Menu.which = MENU_MAIN
      Menu.item = Laston[MENU_MAIN].item
    }
  } else {
    let lines = menus[Menu.which].lines
    let first = menus[Menu.which].first
    // (A place nothing is saved in cannot be loaded from.)
    let kind = if Menu.which == MENU_LOAD && Slotnames[Menu.item * SLOTNAME].c == 0 {
      0
    } else {
      menu_lines[first + Menu.item].kind
    }
    if down {
      // (Over the lines that are nothing, with a sound for each.)
      var going = true
      while going {
        Menu.item = (Menu.item + 1) % lines
        sound(Sounds, Rnd, SFX_PSTOP, 0)
        going = menu_lines[first + Menu.item].kind == -1
      }
    } else if up {
      var going = true
      while going {
        Menu.item = (Menu.item + lines - 1) % lines
        sound(Sounds, Rnd, SFX_PSTOP, 0)
        going = menu_lines[first + Menu.item].kind == -1
      }
    } else if left || right {
      if kind == 2 {
        sound(Sounds, Rnd, SFX_STNMOV, 0)
        set = if left { -1 } else { 1 }
        chosen = Menu.which * 16 + Menu.item
      }
    } else if enter {
      if kind != 0 {
        Laston[Menu.which].item = Menu.item
        chosen = Menu.which * 16 + Menu.item
        if kind == 2 {
          set = 1
          sound(Sounds, Rnd, SFX_STNMOV, 0)
        } else {
          sound(Sounds, Rnd, SFX_PISTOL, 0)
        }
      }
    } else if esc {
      Laston[Menu.which].item = Menu.item
      Menu.on = false
      sound(Sounds, Rnd, SFX_SWTCHX, 0)
    } else if back {
      Laston[Menu.which].item = Menu.item
      if menus[Menu.which].back != 0 {
        Menu.which = menus[Menu.which].back
        Menu.item = Laston[Menu.which].item
        sound(Sounds, Rnd, SFX_SWTCHN, 0)
      }
    } else if letter != 0 {
      // The next line with that letter, from the one after the skull
      // round to the skull.
      var found = -1
      for step in 1..lines + 1 {
        let line = (Menu.item + step) % lines
        if found < 0 && menu_lines[first + line].letter == letter { found = line }
      }
      if found >= 0 {
        Menu.item = found
        sound(Sounds, Rnd, SFX_PSTOP, 0)
      }
    }
  }
  // What the line that was chosen does.
  if chosen == MENU_MAIN * 16 {
    Menu.which = MENU_EPISODE
    Menu.item = Laston[MENU_EPISODE].item
  } else if chosen == MENU_MAIN * 16 + 1 {
    Menu.which = MENU_OPTIONS
    Menu.item = Laston[MENU_OPTIONS].item
  } else if chosen == MENU_MAIN * 16 + 2 {
    // (M_LoadGame.)
    Menu.which = MENU_LOAD
    Menu.item = Laston[MENU_LOAD].item
    read_names(Bytes, Slotnames, Slot.room)
  } else if chosen == MENU_MAIN * 16 + 3 {
    // (M_SaveGame: only a game of the player's, and only in a level.)
    if !Shell.game {
      Menu.under = Menu.on
      Menu.prompt = PROMPT_SAVEDEAD
      Menu.answer = false
    } else if !Wi.on && !Fin.on {
      Menu.which = MENU_SAVE
      Menu.item = Laston[MENU_SAVE].item
      read_names(Bytes, Slotnames, Slot.room)
    }
  } else if chosen == MENU_MAIN * 16 + 4 {
    Menu.which = MENU_READ1
    Menu.item = Laston[MENU_READ1].item
  } else if chosen == MENU_MAIN * 16 + 5 {
    // (M_QuitDOOM.)
    Menu.under = Menu.on
    Menu.prompt = PROMPT_QUIT + Menu.tic % 8
    Menu.answer = true
    Menu.on = true
  } else if chosen == MENU_EPISODE * 16 {
    Menu.which = MENU_SKILL
    Menu.item = Laston[MENU_SKILL].item
  } else if chosen > MENU_EPISODE * 16 && chosen < MENU_SKILL * 16 {
    // (The other episodes are not in this WAD: how to get them.)
    Menu.under = Menu.on
    Menu.prompt = PROMPT_SHAREWARE
    Menu.answer = false
    Menu.which = MENU_READ1
    Menu.item = Laston[MENU_READ1].item
  } else if chosen >= MENU_SKILL * 16 && chosen < MENU_SKILL * 16 + 4 {
    Shell.start = true
    Shell.skill = chosen - MENU_SKILL * 16
    Menu.on = false
  } else if chosen == MENU_SKILL * 16 + 4 {
    // (The fifth skill is asked about first: M_VerifyNightmare.)
    Menu.under = Menu.on
    Menu.prompt = PROMPT_NIGHTMARE
    Menu.answer = true
  } else if chosen == MENU_OPTIONS * 16 {
    // (M_EndGame.)
    if !Shell.game {
      sound(Sounds, Rnd, SFX_OOF, 0)
    } else {
      Menu.under = Menu.on
      Menu.prompt = PROMPT_ENDGAME
      Menu.answer = true
      Menu.on = true
    }
  } else if chosen == MENU_OPTIONS * 16 + 1 {
    // (M_ChangeMessages: said even where nothing is said.)
    Hud.off = !Hud.off
    Inv[0].message = if Hud.off { MSG_MSGOFF } else { MSG_MSGON }
    Hud.must = true
  } else if chosen == MENU_OPTIONS * 16 + 2 {
    // (M_ChangeDetail.)
    View.detail = 1 - View.detail
    Shell.resize = true
    Inv[0].message = if View.detail == 0 { MSG_DETAILHI } else { MSG_DETAILLO }
  } else if chosen == MENU_OPTIONS * 16 + 3 {
    // (M_SizeDisplay.)
    if set < 0 && View.blocks > 3 {
      View.blocks -= 1
    } else if set > 0 && View.blocks < 11 {
      View.blocks += 1
    }
    Shell.resize = true
  } else if chosen == MENU_OPTIONS * 16 + 5 {
    Menu.mouse = min(max(Menu.mouse + set, 0), 9)
  } else if chosen == MENU_OPTIONS * 16 + 7 {
    Menu.which = MENU_SOUND
    Menu.item = Laston[MENU_SOUND].item
  } else if chosen == MENU_READ1 * 16 {
    Menu.which = MENU_READ2
    Menu.item = Laston[MENU_READ2].item
  } else if chosen == MENU_READ2 * 16 {
    Menu.which = MENU_MAIN
    Menu.item = Laston[MENU_MAIN].item
  } else if chosen >= MENU_LOAD * 16 && chosen < MENU_LOAD * 16 + SLOTS {
    // (M_LoadSelect.)
    Slot.which = chosen - MENU_LOAD * 16
    Slot.load = true
    Menu.on = false
  } else if chosen >= MENU_SAVE * 16 && chosen < MENU_SAVE * 16 + SLOTS {
    // (M_SaveSelect: its name is typed first, over the one it has, which
    // is kept for the case that it is not saved after all.)
    Slot.which = chosen - MENU_SAVE * 16
    Slot.typing = true
    Slot.at = name_length(Slotnames, Slot.which)
    for i in 0..SLOTNAME {
      Slotnames[SLOTS * SLOTNAME + i].c = Slotnames[Slot.which * SLOTNAME + i].c
    }
  } else if chosen == MENU_SOUND * 16 {
    Volume.sfx = min(max(Volume.sfx + set, 0), 15)
  } else if chosen == MENU_SOUND * 16 + 2 {
    Volume.music = min(max(Volume.music + set, 0), 15)
  }
  // (The file of the place: the step that writes or reads it comes
  // after this one.)
  if Slot.save || Slot.load { Saved.file = "doomsav{Slot.which}.sav" }
  // (What is around a smaller view is drawn anew while the menu is
  // over it, when the view's size changes, and once more after.)
  if was || Menu.on || Shell.resize { Border.count = 3 }
  // The skull blinks.
  Menu.count -= 1
  if Menu.count <= 0 {
    Menu.skull ^= 1
    Menu.count = 8
  }
  Random.other = Rnd[0].other
}

// The next of the round (D_DoAdvanceDemo): a picture for some seconds,
// or a demo.
system turn_page() {
  Shell.turn = false
  Shell.game = false
  Shell.demo = false
  Shell.page = (Shell.page + 1) % 6
  if Shell.page == 0 {
    Shell.pagetic = 170
    // (The title's tune, once: the one written for this chip.)
    Tune.name = lump_name("D_INTROA")
    Tune.looping = false
  } else if Shell.page == 2 || Shell.page == 4 {
    Shell.pagetic = 200
  } else {
    Demo.lump = if Shell.page == 1 {
      "DEMO1"
    } else if Shell.page == 3 {
      "DEMO2"
    } else {
      "DEMO3"
    }
    Shell.wanted = true
  }
}

// A game starts from nothing (G_InitNew): the player's own, of the
// skill that was chosen, or a demo's, which says what it was played in.
// After `read_demo` for a demo; before the level is loaded.
system enter_game() {
  Shell.fresh = true
  Pause.on = false
  Pause.send = false
  if Shell.start {
    Level.episode = 1
    Level.map = 1
    Level.skill = Shell.skill
    Level.nomonsters = false
    Ticcmds = []
    Demo.tic = 0
    Demo.over = false
  } else {
    Level.episode = Demo.episode
    Level.map = Demo.map
    Level.skill = Demo.skill
    Level.nomonsters = Demo.nomonsters
  }
  Level.exited = false
  Level.secret = false
  Level.reborn = false
  Wi.on = false
  Wi.over = false
  Wi.didsecret = false
  Fin.on = false
  Random.play = 0
  Random.other = 0
}

// The level is loaded: the game goes on from here.
system entered() {
  Shell.game = Shell.start
  Shell.demo = !Shell.start
  Shell.start = false
  Shell.wanted = false
  Shell.fresh = false
  Shell.turn = false
}

// A demo that is over is followed by the next of the round
// (G_CheckDemoStatus). After a tic of the game.
system demo_end() {
  if Shell.demo && (Demo.over || Level.exited) { Shell.turn = true }
}

// A picture of the round stays its time (D_PageTicker).
system page_tick() {
  Shell.pagetic -= 1
  if Shell.pagetic < 0 { Shell.turn = true }
}

// The picture of the round that is shown (D_PageDrawer).
system draw_page() {
  let name = if Shell.page == 0 {
    pic(Lumps, "TITLEPIC")
  } else if Shell.page == 2 {
    pic(Lumps, "CREDIT")
  } else {
    pic(Lumps, "HELP2")
  }
  draw_patch(Screen, Bytes, name, 0, 0)
}

// How wide a line of text is in the game's letters (M_StringWidth).
fn text_width(bytes: Bytes, font: Hufont, words: text[48]) -> i32 {
  var width = 0
  for i in 0..len(words) {
    var c = words[i] as u8 as i32
    if c >= 97 && c <= 122 { c -= 32 }
    width += if c >= HU_FONTSTART && c <= HU_FONTEND {
      short_at(bytes, font[c - HU_FONTSTART].at)
    } else {
      4
    }
  }
  width
}

// The name of a place for a saved game, in the game's letters: where it
// ends.
proc draw_name(screen: mut Screen, bytes: Bytes, font: Hufont, names: Slotnames,
               slot: i32, atx: i32, y: i32) -> i32 {
  var x = atx
  for i in 0..name_length(names, slot) {
    let c = names[slot * SLOTNAME + i].c as i32
    if c >= HU_FONTSTART && c <= HU_FONTEND {
      let patch = font[c - HU_FONTSTART].at
      if x + short_at(bytes, patch) <= SCREENWIDTH { draw_patch(screen, bytes, patch, x, y) }
      x += short_at(bytes, patch)
    } else {
      x += 4
    }
  }
  x
}

// Something that is set lower or higher: a bar of `width` parts, and
// where on it it is set (M_DrawThermo).
proc draw_thermo(screen: mut Screen, bytes: Bytes, lumps: Lumps, x: i32, y: i32,
                 width: i32, at: i32) {
  draw_patch(screen, bytes, pic(lumps, "M_THERML"), x, y)
  for i in 0..width { draw_patch(screen, bytes, pic(lumps, "M_THERMM"), x + 8 + i * 8, y) }
  draw_patch(screen, bytes, pic(lumps, "M_THERMR"), x + 8 + width * 8, y)
  draw_patch(screen, bytes, pic(lumps, "M_THERMO"), x + 8 + at * 8, y)
}

// While the game is stopped that is written over the view, or at the top
// where there is none (of D_Display).
system draw_pause() {
  draw_patch(Screen, Bytes, pic(Lumps, "M_PAUSE"),
             View.x + (View.scaled - 68) / 2,
             if Shown.map { 4 } else { View.y + 4 })
}

// The menu over whatever else is on the screen (M_Drawer): what is
// asked in the middle of the screen, or else the menu's own pictures,
// its lines one under the other, and the skull at one of them.
system draw_menu() {
  if Menu.prompt != 0 {
    var lines = 0
    for i in 0..len(prompt_lines) {
      if prompt_lines[i].prompt == Menu.prompt { lines += 1 }
    }
    let height = short_at(Bytes, Hufont[0].at + 2)
    var y = SCREENHEIGHT / 2 - height * lines / 2
    for i in 0..len(prompt_lines) {
      if prompt_lines[i].prompt == Menu.prompt {
        if prompt_lines[i].line == "%" {
          // (The name of the place for saving in a hurry, in quotes.)
          let quote = text_width(Bytes, Hufont, "'")
          let width = quote + name_width(Bytes, Hufont, Slotnames, Slot.quick) +
                      text_width(Bytes, Hufont, "'?")
          let x = SCREENWIDTH / 2 - width / 2
          draw_text(Screen, Bytes, Hufont, "'", x, y)
          draw_text(Screen, Bytes, Hufont, "'?",
                    draw_name(Screen, Bytes, Hufont, Slotnames, Slot.quick, x + quote, y), y)
        } else {
          draw_text(Screen, Bytes, Hufont, prompt_lines[i].line,
                    SCREENWIDTH / 2 - text_width(Bytes, Hufont, prompt_lines[i].line) / 2, y)
        }
        y += height
      }
    }
  } else if Menu.on {
    let x = menus[Menu.which].x
    let y = menus[Menu.which].y
    if Menu.which == MENU_MAIN {
      draw_patch(Screen, Bytes, pic(Lumps, "M_DOOM"), 94, 2)
    } else if Menu.which == MENU_EPISODE {
      draw_patch(Screen, Bytes, pic(Lumps, "M_EPISOD"), 54, 38)
    } else if Menu.which == MENU_SKILL {
      draw_patch(Screen, Bytes, pic(Lumps, "M_NEWG"), 96, 14)
      draw_patch(Screen, Bytes, pic(Lumps, "M_SKILL"), 54, 38)
    } else if Menu.which == MENU_OPTIONS {
      draw_patch(Screen, Bytes, pic(Lumps, "M_OPTTTL"), 108, 15)
      draw_patch(Screen, Bytes,
                 if View.detail == 0 { pic(Lumps, "M_GDHIGH") } else { pic(Lumps, "M_GDLOW") },
                 x + 175, y + LINEHEIGHT * 2)
      draw_patch(Screen, Bytes,
                 if Hud.off { pic(Lumps, "M_MSGOFF") } else { pic(Lumps, "M_MSGON") },
                 x + 120, y + LINEHEIGHT)
      draw_thermo(Screen, Bytes, Lumps, x, y + LINEHEIGHT * 6, 10, Menu.mouse)
      draw_thermo(Screen, Bytes, Lumps, x, y + LINEHEIGHT * 4, 9, View.blocks - 3)
    } else if Menu.which == MENU_READ1 {
      // (What to read: how to get the other episodes, then the keys.)
      draw_patch(Screen, Bytes, pic(Lumps, "HELP2"), 0, 0)
    } else if Menu.which == MENU_READ2 {
      draw_patch(Screen, Bytes, pic(Lumps, "HELP1"), 0, 0)
    } else if Menu.which == MENU_SOUND {
      draw_patch(Screen, Bytes, pic(Lumps, "M_SVOL"), 60, 38)
      draw_thermo(Screen, Bytes, Lumps, x, y + LINEHEIGHT, 16, Volume.sfx)
      draw_thermo(Screen, Bytes, Lumps, x, y + LINEHEIGHT * 3, 16, Volume.music)
    }
    if Menu.which == MENU_LOAD || Menu.which == MENU_SAVE {
      // (M_DrawLoad, M_DrawSave: the six places, each its name in a
      // frame; and after the name that is typed, where the next letter
      // goes.)
      draw_patch(Screen, Bytes,
                 if Menu.which == MENU_LOAD { pic(Lumps, "M_LOADG") } else { pic(Lumps, "M_SAVEG") },
                 72, 28)
      for i in 0..SLOTS {
        let top = y + LINEHEIGHT * i
        draw_patch(Screen, Bytes, pic(Lumps, "M_LSLEFT"), x - 8, top + 7)
        for k in 0..24 { draw_patch(Screen, Bytes, pic(Lumps, "M_LSCNTR"), x + k * 8, top + 7) }
        draw_patch(Screen, Bytes, pic(Lumps, "M_LSRGHT"), x + 24 * 8, top + 7)
        let typed = Slot.typing && Slot.which == i
        if Slotnames[i * SLOTNAME].c == 0 && !typed {
          draw_text(Screen, Bytes, Hufont, "empty slot", x, top)
        } else {
          let end = draw_name(Screen, Bytes, Hufont, Slotnames, i, x, top)
          if typed { draw_text(Screen, Bytes, Hufont, "_", end, top) }
        }
      }
    }
    for i in 0..menus[Menu.which].lines {
      let name = menu_lines[menus[Menu.which].first + i].name
      if len(name) > 0 { draw_patch(Screen, Bytes, pic(Lumps, name), x, y + i * LINEHEIGHT) }
    }
    draw_patch(Screen, Bytes,
               if Menu.skull == 0 { pic(Lumps, "M_SKULL1") } else { pic(Lumps, "M_SKULL2") },
               x + SKULLXOFF, y - 5 + Menu.item * LINEHEIGHT)
  }
}

// After the world was written (G_DoSaveGame): the player is told.
system saved() {
  if Saved.ok { Inv[0].message = MSG_GGSAVED }
}

// After the world was read (G_DoLoadGame): the game that was saved goes
// on, whatever was going on before. (What the menu, the screen and the
// machine are at is not the file's: `transient`.)
system loaded() {
  if Saved.ok {
    Slot.loaded = true
    Shell.game = true
    Shell.demo = false
    Shell.turn = false
    Shell.start = false
    Shell.wanted = false
    Shell.fresh = false
    Shown.map = false
    Pause.on = false
    Sounds = []
  }
}

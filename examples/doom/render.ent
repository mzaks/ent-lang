//
// The view of the level (r_main.c, r_bsp.c): from where it is seen, the
// tree is walked from the front to the back, and of every wall the
// columns of the picture are found that it is seen in and nothing nearer
// has taken.
import files
import wad
import fixed
import tables
import angles
import data
import level
import video

// What is seen to the left and the right of straight on: a quarter turn
// in all.
const FIELDOFVIEW = 2048
// The status bar's height, which the view is above.
const SBARHEIGHT = 32
// How many ranges of columns that are full the walk keeps at most.
const MAXSEGS = 32

// How big the view is in the picture (R_ExecuteSetViewSize): `blocks` is
// the size the player chose, 3 to 11 (nought: 9, as it starts; 10 is as
// wide as the picture, 11 the whole of it).
// (`detail`: 1 where the view is drawn in half as many columns, each
// twice as wide; `width` is how many columns there are, `scaled` how
// wide the view is in the picture.)
// (`extralight`: how much lighter everything is, for the flash of a
// shot. `fixed`: the one colour map everything is drawn with, by its
// number, while the player sees in the dark or cannot be hurt; 0 for
// none.)
transient unique View {
  blocks: i32, width: i32, height: i32, x: i32, y: i32, centerx: i32,
  centery: i32, centerxfrac: i32, centeryfrac: i32, projection: i32,
  clipangle: u32, extralight: i32, fixed: i32, detail: i32, scaled: i32
}

// Where the level is seen from: until there is a player, where one
// starts.
transient unique Viewpoint { x: i32, y: i32, z: i32, angle: u32 }

// The column of the view an angle from straight on is seen in, for the
// fine angles of the half turn in front; and the angle a column is
// seen at (R_InitTextureMapping).
transient buffer Viewangletox { x: i32 } capacity 4096
transient buffer Xtoviewangle { angle: u32 } capacity 321

// What a frame is drawn with, one row (R_SetupFrame): the eye, the
// sine and cosine of where it looks, and how far the walk has got in
// `Solidsegs`.
transient buffer Frame {
  x: i32, y: i32, z: i32, angle: u32, sin: i32, cos: i32, clipangle: u32,
  newend: i32
} capacity 1

// The ranges of columns that walls have filled, from the left to the
// right, with one before the view and one after it (solidsegs).
transient buffer Solidsegs { first: i32, last: i32 } capacity 33

// What the walk finds, in its order: a subsector it comes to (`seg` is
// -1, `first` the subsector), and the pieces of its walls that are seen,
// the columns from `first` to `last` of a seg, whose first end is seen at
// the angle `angle1`. The nearest come first.
transient buffer Walls { first: i32, last: i32, seg: i32, angle1: u32 } capacity 8192

// Which corners of a box are its ends as seen from each of the nine
// places around and in it (checkcoord).
table checkcoord { a: i32, b: i32, c: i32, d: i32 } = [
  { a: 3, b: 0, c: 2, d: 1 }, { a: 3, b: 0, c: 2, d: 0 },
  { a: 3, b: 1, c: 2, d: 0 }, { a: 0, b: 0, c: 0, d: 0 },
  { a: 2, b: 0, c: 2, d: 1 }, { a: 0, b: 0, c: 0, d: 0 },
  { a: 3, b: 1, c: 3, d: 0 }, { a: 0, b: 0, c: 0, d: 0 },
  { a: 2, b: 0, c: 3, d: 1 }, { a: 2, b: 1, c: 3, d: 1 },
  { a: 2, b: 1, c: 3, d: 0 }
]

// Which side of a line a point (x, y) is on, the line from (lx, ly),
// (ldx, ldy) on: 0 its right, 1 its left.
fn side_of_line(lx: i32, ly: i32, ldx: i32, ldy: i32, x: i32, y: i32) -> i32 {
  if ldx == 0 {
    if x <= lx {
      if ldy > 0 { 1 } else { 0 }
    } else {
      if ldy < 0 { 1 } else { 0 }
    }
  } else if ldy == 0 {
    if y <= ly {
      if ldx < 0 { 1 } else { 0 }
    } else {
      if ldx > 0 { 1 } else { 0 }
    }
  } else {
    let dx = x - lx
    let dy = y - ly
    // By the signs alone, where they say it.
    if (ldy ^ ldx ^ dx ^ dy) & 0x80000000 != 0 {
      if (ldy ^ dx) & 0x80000000 != 0 { 1 } else { 0 }
    } else {
      let left = fixed_mul(ldy >> FRACBITS, dx)
      let right = fixed_mul(dy, ldx >> FRACBITS)
      if right < left { 0 } else { 1 }
    }
  }
}

// Which side of a node's line a point is on (R_PointOnSide), and of a
// seg (R_PointOnSegSide).
fn point_on_side(nodes: Nodes, node: i32, x: i32, y: i32) -> i32 {
  side_of_line(nodes[node].x, nodes[node].y, nodes[node].dx, nodes[node].dy,
               x, y)
}
fn point_on_seg_side(segs: Segs, seg: i32, x: i32, y: i32) -> i32 {
  side_of_line(segs[seg].x1, segs[seg].y1, segs[seg].x2 - segs[seg].x1,
               segs[seg].y2 - segs[seg].y1, x, y)
}

// The subsector a point is in (R_PointInSubsector).
fn point_in_subsector(nodes: Nodes, x: i32, y: i32) -> i32 {
  var num = len(nodes) - 1
  while num & NF_SUBSECTOR == 0 {
    num = if point_on_side(nodes, num, x, y) == 0 {
      nodes[num].child0
    } else {
      nodes[num].child1
    }
  }
  num & ~NF_SUBSECTOR
}

// A piece of a wall that is seen: noted, for `draw_walls` to store and
// draw (R_StoreWallRange).
proc store_wall_range(walls: mut Walls, seg: i32, first: i32, last: i32,
                      angle1: u32) {
  walls += { first: first, last: last, seg: seg, angle1: angle1 }
}

// A wall that nothing is seen through, in the columns from `first` to
// `last`: what of it is not behind a nearer wall is seen, and the
// columns are full from now on (R_ClipSolidWallSegment).
proc clip_solid(frame: mut Frame, solid: mut Solidsegs, walls: mut Walls,
                seg: i32, first: i32, last: i32, angle1: u32) {
  // The first range that reaches up to it.
  var start = 0
  while solid[start].last < first - 1 { start += 1 }
  var done = false
  if first < solid[start].first {
    if last < solid[start].first - 1 {
      // All of it is seen: a range of its own, put in before `start`.
      store_wall_range(walls, seg, first, last, angle1)
      var next = frame[0].newend
      frame[0].newend += 1
      while next != start {
        solid[next].first = solid[next - 1].first
        solid[next].last = solid[next - 1].last
        next -= 1
      }
      solid[next].first = first
      solid[next].last = last
      done = true
    } else {
      // Up to where `start` begins, which then begins with it.
      store_wall_range(walls, seg, first, solid[start].first - 1, angle1)
      solid[start].first = first
    }
  }
  // (Its end is in `start`: nothing more.)
  if !done && last > solid[start].last {
    var next = start
    var met = false
    while !met && last >= solid[next + 1].first - 1 {
      // What is between two ranges, which are then one.
      store_wall_range(walls, seg, solid[next].last + 1,
                       solid[next + 1].first - 1, angle1)
      next += 1
      if last <= solid[next].last {
        solid[start].last = solid[next].last
        met = true
      }
    }
    if !met {
      store_wall_range(walls, seg, solid[next].last + 1, last, angle1)
      solid[start].last = last
    }
    // The ranges that `start` took in are taken out. (One more is moved
    // down than there are, as the original does: it lies after the
    // range that ends them all, and nothing looks there.)
    if next != start {
      let end = frame[0].newend
      var to = start
      while next != end {
        next += 1
        to += 1
        solid[to].first = solid[next].first
        solid[to].last = solid[next].last
      }
      frame[0].newend = to + 1
    }
  }
}

// A wall with something seen through it: what of it is not behind a
// nearer wall is seen, and the columns stay as they are
// (R_ClipPassWallSegment).
proc clip_pass(solid: Solidsegs, walls: mut Walls, seg: i32, first: i32,
               last: i32, angle1: u32) {
  var start = 0
  while solid[start].last < first - 1 { start += 1 }
  var done = false
  if first < solid[start].first {
    if last < solid[start].first - 1 {
      store_wall_range(walls, seg, first, last, angle1)
      done = true
    } else {
      store_wall_range(walls, seg, first, solid[start].first - 1, angle1)
    }
  }
  if !done && last > solid[start].last {
    var met = false
    while !met && last >= solid[start + 1].first - 1 {
      store_wall_range(walls, seg, solid[start].last + 1,
                       solid[start + 1].first - 1, angle1)
      start += 1
      if last <= solid[start].last { met = true }
    }
    if !met { store_wall_range(walls, seg, solid[start].last + 1, last, angle1) }
  }
}

// A seg of the subsector that is being walked: the columns it is seen
// in, if it faces the eye and is in the view, and what kind of wall it
// is there (R_AddLine).
proc add_line(segs: Segs, sectors: Sectors, sides: Sides, map: Viewangletox,
              frame: mut Frame, solid: mut Solidsegs, walls: mut Walls,
              seg: i32, front: i32) {
  let clip = frame[0].clipangle
  let seen1 = point_to_angle(segs[seg].x1 - frame[0].x, segs[seg].y1 - frame[0].y)
  let seen2 = point_to_angle(segs[seg].x2 - frame[0].x, segs[seg].y2 - frame[0].y)
  // (From its first end to its second the angle falls, if it faces the
  // eye.)
  let span = seen1 - seen2
  if span < ANG180 {
    var angle1 = seen1 - frame[0].angle
    var angle2 = seen2 - frame[0].angle
    var seen = true
    var tspan = angle1 + clip
    if tspan > 2 * clip {
      tspan -= 2 * clip
      // All of it to the left of the view.
      if tspan >= span { seen = false }
      angle1 = clip
    }
    tspan = clip - angle2
    if tspan > 2 * clip {
      tspan -= 2 * clip
      // All of it to the right.
      if tspan >= span { seen = false }
      angle2 = -clip
    }
    if seen {
      let x1 = map[(angle1 + ANG90) >> ANGLETOFINESHIFT].x
      let x2 = map[(angle2 + ANG90) >> ANGLETOFINESHIFT].x
      // (Not a column wide.)
      if x1 != x2 {
        let back = segs[seg].back
        // Nothing behind it, or a door that is shut: solid. A window:
        // seen through. Two sectors alike with nothing on the line
        // between them: not there at all.
        var solid_wall = false
        var open = false
        if back < 0 {
          solid_wall = true
        } else if sectors[back].ceilingheight <= sectors[front].floorheight ||
                  sectors[back].floorheight >= sectors[front].ceilingheight {
          solid_wall = true
        } else if sectors[back].ceilingheight != sectors[front].ceilingheight ||
                  sectors[back].floorheight != sectors[front].floorheight {
          open = true
        } else if sectors[back].ceilingpic != sectors[front].ceilingpic ||
                  sectors[back].floorpic != sectors[front].floorpic ||
                  sectors[back].lightlevel != sectors[front].lightlevel ||
                  sides[segs[seg].side].midtexture != 0 {
          open = true
        }
        if solid_wall {
          clip_solid(frame, solid, walls, seg, x1, x2 - 1, seen1)
        } else if open {
          clip_pass(solid, walls, seg, x1, x2 - 1, seen1)
        }
      }
    }
  }
}

// Whether anything in a node's box may be seen: it is in the view, and
// the columns it is seen in are not all full (R_CheckBBox). `box` is the
// box's first row in `Boxes`.
fn check_bbox(boxes: Boxes, map: Viewangletox, frame: Frame, solid: Solidsegs,
              box: i32) -> bool {
  let vx = frame[0].x
  let vy = frame[0].y
  let clip = frame[0].clipangle
  // Where the eye is, of the nine places around and in the box.
  let boxx = if vx <= boxes[box + BOXLEFT].edge {
    0
  } else if vx < boxes[box + BOXRIGHT].edge {
    1
  } else {
    2
  }
  let boxy = if vy >= boxes[box + BOXTOP].edge {
    0
  } else if vy > boxes[box + BOXBOTTOM].edge {
    1
  } else {
    2
  }
  let boxpos = (boxy << 2) + boxx
  var seen = true
  // (In the box: seen.)
  if boxpos != 5 {
    let x1 = boxes[box + checkcoord[boxpos].a].edge
    let y1 = boxes[box + checkcoord[boxpos].b].edge
    let x2 = boxes[box + checkcoord[boxpos].c].edge
    let y2 = boxes[box + checkcoord[boxpos].d].edge
    var angle1 = point_to_angle(x1 - vx, y1 - vy) - frame[0].angle
    var angle2 = point_to_angle(x2 - vx, y2 - vy) - frame[0].angle
    let span = angle1 - angle2
    // (The eye is on the box's edge: seen.)
    if span < ANG180 {
      var tspan = angle1 + clip
      if tspan > 2 * clip {
        tspan -= 2 * clip
        if tspan >= span { seen = false }
        angle1 = clip
      }
      tspan = clip - angle2
      if tspan > 2 * clip {
        tspan -= 2 * clip
        if tspan >= span { seen = false }
        angle2 = -clip
      }
      if seen {
        let sx1 = map[(angle1 + ANG90) >> ANGLETOFINESHIFT].x
        let sx2 = map[(angle2 + ANG90) >> ANGLETOFINESHIFT].x - 1
        if sx1 == sx2 + 1 {
          // Not a column wide.
          seen = false
        } else {
          var start = 0
          while solid[start].last < sx2 { start += 1 }
          // All its columns are full.
          if sx1 >= solid[start].first && sx2 <= solid[start].last {
            seen = false
          }
        }
      }
    }
  }
  seen
}

// The segs of a subsector (R_Subsector).
proc render_subsector(subsectors: Subsectors, segs: Segs, sectors: Sectors,
                      sides: Sides, map: Viewangletox, frame: mut Frame,
                      solid: mut Solidsegs, walls: mut Walls, num: i32) {
  let front = subsectors[num].sector
  let first = subsectors[num].firstline
  walls += { first: num, last: 0, seg: -1, angle1: 0 }
  for i in 0..subsectors[num].numlines {
    add_line(segs, sectors, sides, map, frame, solid, walls, first + i, front)
  }
}

// What is under a node, the side the eye is on first, the other if its
// box may be seen (R_RenderBSPNode).
proc render_bsp_node(nodes: Nodes, boxes: Boxes, subsectors: Subsectors,
                     segs: Segs, sectors: Sectors, sides: Sides,
                     map: Viewangletox, frame: mut Frame,
                     solid: mut Solidsegs, walls: mut Walls, bspnum: i32) {
  if bspnum & NF_SUBSECTOR != 0 {
    render_subsector(subsectors, segs, sectors, sides, map, frame, solid,
                     walls, bspnum & ~NF_SUBSECTOR)
  } else {
    let side = point_on_side(nodes, bspnum, frame[0].x, frame[0].y)
    let near = if side == 0 { nodes[bspnum].child0 } else { nodes[bspnum].child1 }
    let far = if side == 0 { nodes[bspnum].child1 } else { nodes[bspnum].child0 }
    render_bsp_node(nodes, boxes, subsectors, segs, sectors, sides, map,
                    frame, solid, walls, near)
    if check_bbox(boxes, map, frame, solid, bspnum * 8 + (side ^ 1) * 4) {
      render_bsp_node(nodes, boxes, subsectors, segs, sectors, sides, map,
                      frame, solid, walls, far)
    }
  }
}

// How big the view is, and which column each angle is seen in
// (R_ExecuteSetViewSize, R_InitTextureMapping).
system set_view_size() {
  let blocks = if View.blocks == 0 { 9 } else { View.blocks }
  let scaled = if blocks == 11 { SCREENWIDTH } else { blocks * 32 }
  let width = scaled >> View.detail
  let height = if blocks == 11 {
    SCREENHEIGHT
  } else {
    (blocks * 168 / 10) & ~7
  }
  let centerxfrac = (width / 2) << FRACBITS
  View.width = width
  View.scaled = scaled
  View.height = height
  View.centerx = width / 2
  View.centery = height / 2
  View.centerxfrac = centerxfrac
  View.centeryfrac = (height / 2) << FRACBITS
  View.projection = centerxfrac
  View.x = (SCREENWIDTH - scaled) >> 1
  View.y = if scaled == SCREENWIDTH {
    0
  } else {
    (SCREENHEIGHT - SBARHEIGHT - height) >> 1
  }
  // The column of each angle: by its tangent, as far from the middle as
  // the edge of the view is at a quarter turn's half.
  let focallength =
      fixed_div(centerxfrac, finetangent[FINEANGLES / 4 + FIELDOFVIEW / 2])
  Viewangletox = []
  for i in 0..FINEANGLES / 2 {
    var t = 0
    if finetangent[i] > FRACUNIT * 2 {
      t = -1
    } else if finetangent[i] < -FRACUNIT * 2 {
      t = width + 1
    } else {
      t = fixed_mul(finetangent[i], focallength)
      t = (centerxfrac - t + FRACUNIT - 1) >> FRACBITS
      if t < -1 { t = -1 } else if t > width + 1 { t = width + 1 }
    }
    Viewangletox += { x: t }
  }
  // The angle of each column: the smallest that is seen in it.
  Xtoviewangle = []
  for x in 0..width + 1 {
    var i = 0
    while Viewangletox[i].x > x { i += 1 }
    Xtoviewangle += { angle: ((i << ANGLETOFINESHIFT) as u32) - ANG90 }
  }
  // (What is outside the view is at its edge.)
  for i in 0..FINEANGLES / 2 {
    if Viewangletox[i].x == -1 {
      Viewangletox[i].x = 0
    } else if Viewangletox[i].x == width + 1 {
      Viewangletox[i].x = width
    }
  }
  View.clipangle = Xtoviewangle[0].angle
}

// The eye where the first player starts: 41 above the floor there.
system start_viewpoint() {
  for i in 0..len(Mapthings) {
    if Mapthings[i].type == 1 {
      let x = Mapthings[i].x << FRACBITS
      let y = Mapthings[i].y << FRACBITS
      let sector = Subsectors[point_in_subsector(Nodes, x, y)].sector
      Viewpoint.x = x
      Viewpoint.y = y
      Viewpoint.z = Sectors[sector].floorheight + 41 * FRACUNIT
      Viewpoint.angle = ANG45 * ((Mapthings[i].angle / 45) as u32)
    }
  }
}

// The walls that are seen from the viewpoint (R_RenderPlayerView, as
// far as it is).
system render_view() {
  let fine = Viewpoint.angle >> ANGLETOFINESHIFT
  Frame = [{
    x: Viewpoint.x, y: Viewpoint.y, z: Viewpoint.z, angle: Viewpoint.angle,
    sin: finesine[fine], cos: finecosine(fine as i32),
    clipangle: View.clipangle, newend: 2
  }; 1]
  // R_ClearClipSegs: nothing is full but what is outside the view.
  Solidsegs = [{ first: 0, last: 0 }; MAXSEGS + 1]
  Solidsegs[0].first = -0x7fffffff
  Solidsegs[0].last = -1
  Solidsegs[1].first = View.width
  Solidsegs[1].last = 0x7fffffff
  Walls = []
  render_bsp_node(Nodes, Boxes, Subsectors, Segs, Sectors, Sides,
                  Viewangletox, Frame, Solidsegs, Walls, len(Nodes) - 1)
}

//
// What the walk found is drawn (r_segs.c, r_plane.c, r_draw.c): the
// walls column by column, nearest first, each column from the wall's top
// to its bottom as far as nothing nearer is there; and what the walls
// leave open above and below them, the ceilings and floors, in spans
// along the rows.
//

// How many pieces of walls are stored at most: the rest are not drawn.
const MAXDRAWSEGS = 256
// A height on the screen is kept with 12 bits after the point.
const HEIGHTBITS = 12
const HEIGHTUNIT = 1 << HEIGHTBITS

// Light: 16 levels of it, each with a colour map for each of 48 scales
// (of walls) and 128 distances (of floors and ceilings); of the 32
// colour maps the first is the lightest.
const LIGHTLEVELS = 16
const LIGHTSEGSHIFT = 4
const MAXLIGHTSCALE = 48
const LIGHTSCALESHIFT = 12
const MAXLIGHTZ = 128
const LIGHTZSHIFT = 20
const NUMCOLORMAPS = 32
const DISTMAP = 2
// Where the colour map is in `Bytes`, for a light level l and a scale s
// (row l * 48 + s) or a distance z (row l * 128 + z).
transient buffer Scalelight { map: i32 } capacity 768
transient buffer Zlight { map: i32 } capacity 2048

const ANGLETOSKYSHIFT = 22

// For each column of the view: the rows nothing is drawn in yet are
// those between `ceiling` and `floor` (ceilingclip, floorclip); and how
// much farther a point is that is seen in the column than straight on
// (distscale).
transient buffer Clips { ceiling: i32, floor: i32 } capacity 320
transient buffer Distscale { scale: i32 } capacity 320

// For each row: how far a floor one unit below the eye is seen there
// (yslope); what was worked out for the height that was last drawn there
// (cached..); and the column a span that is open there started in.
transient buffer Spans {
  yslope: i32, cachedheight: i32, cacheddistance: i32, cachedxstep: i32,
  cachedystep: i32, spanstart: i32
} capacity 200

// A floor or a ceiling that is seen: its height, flat and light, and the
// columns it is seen in. The rows of each column are in `Planetops`:
// for plane p and column x, row p * 322 + x + 1 (one more column before
// and after, which are empty). A column with nothing has 255 for `top`.
transient buffer Visplanes {
  height: i32, picnum: i32, lightlevel: i32, minx: i32, maxx: i32
} capacity 128
transient buffer Planetops { top: u8, bottom: u8 } capacity 41216

// A piece of a wall that was stored, for what is drawn after the walls
// (the things, and textures in openings) to be cut by: its columns and
// its scale at both ends; whether it hides what is behind it below a
// height (`bsilheight`), above one (`tsilheight`), or both; and where in
// `Openings` its rows are, by column: those a thing behind it is cut to
// at the top and at the bottom, and the columns of a texture in its
// opening (-1: none). A row of column x is at the number + x.
transient buffer Drawsegs {
  seg: i32, x1: i32, x2: i32, scale1: i32, scale2: i32, scalestep: i32,
  silhouette: i32, bsilheight: i32, tsilheight: i32, sprtopclip: i32,
  sprbottomclip: i32, maskedtexturecol: i32
} capacity 256
const SIL_BOTTOM = 1
const SIL_TOP = 2
const SIL_BOTH = 3

// Rows of the view by its columns, for cutting what is masked: first 320
// for a thing's top and 320 for its bottom (worked out for each thing),
// then 320 that are the view's height and 320 that are -1 (what cuts
// nothing, below and above), then those of the pieces of walls.
transient buffer Openings { value: i32 } capacity 21760
const CLIPTOP = 0
const CLIPBOTTOM = 320
const SCREENHEIGHTARRAY = 640
const NEGONEARRAY = 960

// What was worked out for each piece of a wall that was stored, for
// holding it against the reference's (check/view.sh).
transient buffer Stored {
  seg: i32, distance: i32, scale: i32, scalestep: i32, offset: i32,
  centerangle: u32, midtexturemid: i32, topfrac: i32, bottomfrac: i32,
  midtexture: i32, toptexture: i32, bottomtexture: i32, masked: bool,
  markfloor: bool, markceiling: bool
} capacity 256

// How much smaller than it is a wall is seen at an angle (the scale of
// its texture), for one whose normal is at `normal` and that is
// `distance` away along it (R_ScaleFromGlobalAngle).
fn scale_from_global_angle(visangle: u32, viewangle: u32, normal: u32,
                           distance: i32, projection: i32, detail: i32) -> i32 {
  let sinea = finesine[(ANG90 + (visangle - viewangle)) >> ANGLETOFINESHIFT]
  let sineb = finesine[(ANG90 + (visangle - normal)) >> ANGLETOFINESHIFT]
  let num = fixed_mul(projection, sineb) << detail
  let den = fixed_mul(distance, sinea)
  if den > num >> FRACBITS {
    let scale = fixed_div(num, den)
    if scale > 64 * FRACUNIT {
      64 * FRACUNIT
    } else if scale < 256 {
      256
    } else {
      scale
    }
  } else {
    64 * FRACUNIT
  }
}

// The plane of that height, flat and light, a new one if there is none
// (R_FindPlane).
proc find_plane(planes: mut Visplanes, tops: mut Planetops, height: i32,
                picnum: i32, lightlevel: i32, skyflatnum: i32) -> i32 {
  // (All the sky is one.)
  let h = if picnum == skyflatnum { 0 } else { height }
  let light = if picnum == skyflatnum { 0 } else { lightlevel }
  var found = -1
  for i in 0..len(planes) {
    if found < 0 && planes[i].height == h && planes[i].picnum == picnum &&
       planes[i].lightlevel == light {
      found = i
    }
  }
  if found < 0 {
    found = len(planes)
    planes += {
      height: h, picnum: picnum, lightlevel: light, minx: SCREENWIDTH,
      maxx: -1
    }
    for x in 0..322 { tops += { top: 255, bottom: 0 } }
  }
  found
}

// The plane to mark in the columns from `start` to `stop`: `pl`, if it
// has nothing there yet, else a new one like it (R_CheckPlane).
proc check_plane(planes: mut Visplanes, tops: mut Planetops, pl: i32,
                 start: i32, stop: i32) -> i32 {
  let minx = planes[pl].minx
  let maxx = planes[pl].maxx
  let intrl = max(start, minx)
  let unionl = min(start, minx)
  let intrh = min(stop, maxx)
  let unionh = max(stop, maxx)
  var free = true
  for x in intrl..intrh + 1 {
    if tops[pl * 322 + x + 1].top != 255 { free = false }
  }
  var used = pl
  if free {
    planes[pl].minx = unionl
    planes[pl].maxx = unionh
  } else {
    used = len(planes)
    planes += {
      height: planes[pl].height, picnum: planes[pl].picnum,
      lightlevel: planes[pl].lightlevel, minx: start, maxx: stop
    }
    for x in 0..322 { tops += { top: 255, bottom: 0 } }
  }
  used
}

// A column of a texture, from row `yl` to `yh` of the view's column `x`:
// each pixel from the texture's column at `source`, `iscale` on for each
// row, made darker by the colour map at `colormap` (R_DrawColumn).
proc draw_column(screen: mut Screen, bytes: Bytes, x: i32, yl: i32, yh: i32,
                 iscale: i32, texturemid: i32, source: i32, colormap: i32,
                 centery: i32, left: i32, top: i32, wide: i32) {
  var dest = (yl + top) * SCREENWIDTH + left + (x << wide)
  var frac = texturemid + (yl - centery) * iscale
  for y in yl..yh + 1 {
    let pixel = bytes[colormap + bytes[source + ((frac >> FRACBITS) & 127)].value as i32].value
    screen[dest].pixel = pixel
    // (Twice as wide: R_DrawColumnLow.)
    if wide != 0 { screen[dest + 1].pixel = pixel }
    dest += SCREENWIDTH
    frac += iscale
  }
}

// A span of a flat, the columns `x1` to `x2` of the view's row `y`: the
// flat is 64 by 64 at `source`, the first pixel from (xfrac, yfrac) of
// it and each next one (xstep, ystep) on (R_DrawSpan).
proc draw_span(screen: mut Screen, bytes: Bytes, y: i32, x1: i32, x2: i32,
               xfrac: i32, yfrac: i32, xstep: i32, ystep: i32, source: i32,
               colormap: i32, left: i32, top: i32, wide: i32) {
  // Both in one number: 16 bits each, of which 6 say the pixel.
  var position = (((xfrac as u32) << 10) & 0xffff0000) |
                 (((yfrac >> 6) as u32) & 0x0000ffff)
  let step = (((xstep as u32) << 10) & 0xffff0000) |
             (((ystep >> 6) as u32) & 0x0000ffff)
  var dest = (y + top) * SCREENWIDTH + left + (x1 << wide)
  for x in x1..x2 + 1 {
    let spot = (position >> 26) | ((position >> 4) & 0x0fc0)
    let pixel = bytes[colormap + bytes[source + spot as i32].value as i32].value
    screen[dest].pixel = pixel
    if wide != 0 {
      dest += 1
      screen[dest].pixel = pixel
    }
    dest += 1
    position += step
  }
}

// What depends on the size of the view and on nothing else: how far the
// floor is seen in each row, how much farther the edges of the view are
// than its middle, and the colour maps of the light levels
// (R_ExecuteSetViewSize, R_InitLightTables). After `set_view_size` and
// `init_data`.
system init_view_tables() {
  Spans = []
  for y in 0..View.height {
    let dy = abs(((y - View.height / 2) << FRACBITS) + FRACUNIT / 2)
    Spans += {
      yslope: fixed_div(View.scaled / 2 * FRACUNIT, dy), cachedheight: 0,
      cacheddistance: 0, cachedxstep: 0, cachedystep: 0, spanstart: 0
    }
  }
  Distscale = []
  for x in 0..View.width {
    let cosadj =
        abs(finecosine((Xtoviewangle[x].angle >> ANGLETOFINESHIFT) as i32))
    Distscale += { scale: fixed_div(FRACUNIT, cosadj) }
  }
  Scalelight = []
  Zlight = []
  for i in 0..LIGHTLEVELS {
    let startmap = ((LIGHTLEVELS - 1 - i) * 2) * NUMCOLORMAPS / LIGHTLEVELS
    for j in 0..MAXLIGHTSCALE {
      let level = startmap - j * SCREENWIDTH / View.scaled / DISTMAP
      Scalelight += {
        map: Data.colormaps + min(max(level, 0), NUMCOLORMAPS - 1) * 256
      }
    }
    for j in 0..MAXLIGHTZ {
      let scale = fixed_div(SCREENWIDTH / 2 * FRACUNIT, (j + 1) << LIGHTZSHIFT) >>
                  LIGHTSCALESHIFT
      let level = startmap - scale / DISTMAP
      Zlight += {
        map: Data.colormaps + min(max(level, 0), NUMCOLORMAPS - 1) * 256
      }
    }
  }
}

// Stores and draws the pieces of walls the walk found, in its order, and
// marks the planes they leave open (R_Subsector's planes,
// R_StoreWallRange, R_RenderSegLoop). After `render_view`.
system draw_walls() {
  let vx = Frame[0].x
  let vy = Frame[0].y
  let vz = Frame[0].z
  let viewangle = Frame[0].angle
  // R_ClearPlanes: nothing is drawn in any column yet.
  Clips = [{ ceiling: -1, floor: View.height }; View.width]
  Visplanes = []
  Planetops = []
  Stored = []
  Drawsegs = []
  Openings = [{ value: 0 }; 640]
  for x in 0..320 { Openings += { value: View.height } }
  for x in 0..320 { Openings += { value: -1 } }
  var drawsegs = 0
  var front = 0
  var floorplane = -1
  var ceilingplane = -1
  for i in 0..len(Walls) {
    if Walls[i].seg < 0 {
      // A subsector: its floor is seen if it is below the eye, its
      // ceiling if it is above it or the sky.
      front = Subsectors[Walls[i].first].sector
      floorplane = if Sectors[front].floorheight < vz {
        find_plane(Visplanes, Planetops, Sectors[front].floorheight,
                   Sectors[front].floorpic, Sectors[front].lightlevel,
                   Data.skyflatnum)
      } else {
        -1
      }
      ceilingplane = if Sectors[front].ceilingheight > vz ||
                        Sectors[front].ceilingpic == Data.skyflatnum {
        find_plane(Visplanes, Planetops, Sectors[front].ceilingheight,
                   Sectors[front].ceilingpic, Sectors[front].lightlevel,
                   Data.skyflatnum)
      } else {
        -1
      }
    } else if drawsegs < MAXDRAWSEGS {
      let seg = Walls[i].seg
      let start = Walls[i].first
      let stop = Walls[i].last
      let rw_angle1 = Walls[i].angle1
      let side = Segs[seg].side
      let line = Segs[seg].line
      let back = Segs[seg].back
      // (It has been seen: the map shows it.)
      Lines[line].flags |= ML_MAPPED

      // How far the wall is, along its normal.
      let rw_normalangle = Segs[seg].angle + ANG90
      let offset1 = abs((rw_normalangle as i32) - (rw_angle1 as i32)) as u32
      let distangle = ANG90 - min(offset1, ANG90)
      let hyp = point_to_dist(Segs[seg].x1 - vx, Segs[seg].y1 - vy)
      let rw_distance = fixed_mul(hyp, finesine[distangle >> ANGLETOFINESHIFT])

      // Its scale at both ends, and the step between two columns.
      let scale1 = scale_from_global_angle(
          viewangle + Xtoviewangle[start].angle, viewangle, rw_normalangle,
          rw_distance, View.projection, View.detail)
      let scale2 = if stop > start {
        scale_from_global_angle(viewangle + Xtoviewangle[stop].angle,
                                viewangle, rw_normalangle, rw_distance,
                                View.projection, View.detail)
      } else {
        scale1
      }
      let rw_scalestep = if stop > start {
        (scale2 - scale1) / (stop - start)
      } else {
        0
      }

      // Which textures there are, and where each one's top is.
      let frontfloor = Sectors[front].floorheight
      let frontceiling = Sectors[front].ceilingheight
      var worldtop = frontceiling - vz
      var worldbottom = frontfloor - vz
      var worldhigh = 0
      var worldlow = 0
      var midtexture = 0
      var toptexture = 0
      var bottomtexture = 0
      var maskedtexture = false
      var markfloor = true
      var markceiling = true
      var rw_midtexturemid = 0
      var rw_toptexturemid = 0
      var rw_bottomtexturemid = 0
      // What it hides of the things behind it.
      var silhouette = 0
      var bsilheight = 0
      var tsilheight = 0
      var sprtopclip = -1
      var sprbottomclip = -1
      var maskedtexturecol = -1
      if back < 0 {
        silhouette = SIL_BOTH
        sprtopclip = SCREENHEIGHTARRAY
        sprbottomclip = NEGONEARRAY
        bsilheight = 0x7fffffff
        tsilheight = 0x80000000
        // One side: one texture from the ceiling to the floor.
        let mid = Sides[side].midtexture
        midtexture = Textrans[mid].pic
        rw_midtexturemid = if Lines[line].flags & ML_DONTPEGBOTTOM != 0 {
          // (Its bottom at the floor.)
          frontfloor + (Textures[mid].height << FRACBITS) - vz
        } else {
          worldtop
        }
        rw_midtexturemid += Sides[side].rowoffset
      } else {
        // Two sides: a texture above the opening and one below it.
        let backfloor = Sectors[back].floorheight
        let backceiling = Sectors[back].ceilingheight
        if frontfloor > backfloor {
          silhouette = SIL_BOTTOM
          bsilheight = frontfloor
        } else if backfloor > vz {
          silhouette = SIL_BOTTOM
          bsilheight = 0x7fffffff
        }
        if frontceiling < backceiling {
          silhouette |= SIL_TOP
          tsilheight = frontceiling
        } else if backceiling < vz {
          silhouette |= SIL_TOP
          tsilheight = 0x80000000
        }
        if backceiling <= frontfloor {
          sprbottomclip = NEGONEARRAY
          bsilheight = 0x7fffffff
          silhouette |= SIL_BOTTOM
        }
        if backfloor >= frontceiling {
          sprtopclip = SCREENHEIGHTARRAY
          tsilheight = 0x80000000
          silhouette |= SIL_TOP
        }
        worldhigh = backceiling - vz
        worldlow = backfloor - vz
        // (The sky on both sides: no wall is seen between them.)
        if Sectors[front].ceilingpic == Data.skyflatnum &&
           Sectors[back].ceilingpic == Data.skyflatnum {
          worldtop = worldhigh
        }
        markfloor = worldlow != worldbottom ||
                    Sectors[back].floorpic != Sectors[front].floorpic ||
                    Sectors[back].lightlevel != Sectors[front].lightlevel
        markceiling = worldhigh != worldtop ||
                      Sectors[back].ceilingpic != Sectors[front].ceilingpic ||
                      Sectors[back].lightlevel != Sectors[front].lightlevel
        // (A door that is shut.)
        if backceiling <= frontfloor || backfloor >= frontceiling {
          markceiling = true
          markfloor = true
        }
        if worldhigh < worldtop {
          let high = Sides[side].toptexture
          toptexture = Textrans[high].pic
          rw_toptexturemid = if Lines[line].flags & ML_DONTPEGTOP != 0 {
            worldtop
          } else {
            backceiling + (Textures[high].height << FRACBITS) - vz
          }
        }
        if worldlow > worldbottom {
          bottomtexture = Textrans[Sides[side].bottomtexture].pic
          rw_bottomtexturemid = if Lines[line].flags & ML_DONTPEGBOTTOM != 0 {
            worldtop
          } else {
            worldlow
          }
        }
        rw_toptexturemid += Sides[side].rowoffset
        rw_bottomtexturemid += Sides[side].rowoffset
        // (One in the opening is drawn later, with what is masked: its
        // columns are noted.)
        maskedtexture = Sides[side].midtexture != 0
        if maskedtexture {
          maskedtexturecol = len(Openings) - start
          for x in start..stop + 1 { Openings += { value: 0 } }
        }
      }

      // Where along the texture each column is, and how light.
      let segtextured = midtexture != 0 || toptexture != 0 ||
                        bottomtexture != 0 || maskedtexture
      var rw_offset = 0
      var rw_centerangle = 0 as u32
      var walllights = 0
      if segtextured {
        var offsetangle = rw_normalangle - rw_angle1
        if offsetangle > ANG180 { offsetangle = -offsetangle }
        if offsetangle > ANG90 { offsetangle = ANG90 }
        rw_offset = fixed_mul(hyp, finesine[offsetangle >> ANGLETOFINESHIFT])
        if rw_normalangle - rw_angle1 < ANG180 { rw_offset = -rw_offset }
        rw_offset += Sides[side].textureoffset + Segs[seg].offset
        rw_centerangle = ANG90 + viewangle - rw_normalangle
        // (A wall along the grid is a little darker or lighter.)
        var lightnum = (Sectors[front].lightlevel >> LIGHTSEGSHIFT) + View.extralight
        if Segs[seg].y1 == Segs[seg].y2 {
          lightnum -= 1
        } else if Segs[seg].x1 == Segs[seg].x2 {
          lightnum += 1
        }
        walllights = min(max(lightnum, 0), LIGHTLEVELS - 1) * MAXLIGHTSCALE
      }

      // (What is not seen from here is not marked.)
      if frontfloor >= vz { markfloor = false }
      if frontceiling <= vz && Sectors[front].ceilingpic != Data.skyflatnum {
        markceiling = false
      }

      // The rows of the wall's top and bottom at the first column, and
      // the step between two columns.
      worldtop >>= 4
      worldbottom >>= 4
      let centeryfrac = View.centeryfrac >> 4
      let topstep = -fixed_mul(rw_scalestep, worldtop)
      let bottomstep = -fixed_mul(rw_scalestep, worldbottom)
      var topfrac = centeryfrac - fixed_mul(worldtop, scale1)
      var bottomfrac = centeryfrac - fixed_mul(worldbottom, scale1)
      var pixhigh = 0
      var pixhighstep = 0
      var pixlow = 0
      var pixlowstep = 0
      if back >= 0 {
        worldhigh >>= 4
        worldlow >>= 4
        if worldhigh < worldtop {
          pixhigh = centeryfrac - fixed_mul(worldhigh, scale1)
          pixhighstep = -fixed_mul(rw_scalestep, worldhigh)
        }
        if worldlow > worldbottom {
          pixlow = centeryfrac - fixed_mul(worldlow, scale1)
          pixlowstep = -fixed_mul(rw_scalestep, worldlow)
        }
      }

      Stored += {
        seg: seg, distance: rw_distance, scale: scale1, scalestep: rw_scalestep,
        offset: rw_offset, centerangle: rw_centerangle,
        midtexturemid: rw_midtexturemid, topfrac: topfrac,
        bottomfrac: bottomfrac, midtexture: midtexture, toptexture: toptexture,
        bottomtexture: bottomtexture, masked: maskedtexture,
        markfloor: markfloor, markceiling: markceiling
      }
      if markceiling {
        ceilingplane = check_plane(Visplanes, Planetops, ceilingplane, start, stop)
      }
      if markfloor {
        floorplane = check_plane(Visplanes, Planetops, floorplane, start, stop)
      }

      // R_RenderSegLoop: column by column.
      var rw_scale = scale1
      for x in start..stop + 1 {
        let ceilingclip = Clips[x].ceiling
        let floorclip = Clips[x].floor
        // What is above the wall is the ceiling's.
        let yl = max((topfrac + HEIGHTUNIT - 1) >> HEIGHTBITS, ceilingclip + 1)
        if markceiling {
          let top = ceilingclip + 1
          let bottom = min(yl - 1, floorclip - 1)
          if top <= bottom {
            Planetops[ceilingplane * 322 + x + 1].top = top as u8
            Planetops[ceilingplane * 322 + x + 1].bottom = bottom as u8
          }
        }
        // What is below it is the floor's.
        let yh = min(bottomfrac >> HEIGHTBITS, floorclip - 1)
        if markfloor {
          let top = max(yh + 1, ceilingclip + 1)
          let bottom = floorclip - 1
          if top <= bottom {
            Planetops[floorplane * 322 + x + 1].top = top as u8
            Planetops[floorplane * 322 + x + 1].bottom = bottom as u8
          }
        }
        // The texture's column, its colour map and its step.
        var texturecolumn = 0
        var colormap = 0
        var iscale = 0
        if segtextured {
          let angle = (rw_centerangle + Xtoviewangle[x].angle) >> ANGLETOFINESHIFT
          texturecolumn =
              (rw_offset - fixed_mul(finetangent[angle], rw_distance)) >> FRACBITS
          colormap = if View.fixed != 0 {
            Data.colormaps + View.fixed * 256
          } else {
            Scalelight[
                walllights + min(rw_scale >> LIGHTSCALESHIFT, MAXLIGHTSCALE - 1)
            ].map
          }
          iscale = (0xffffffff as u32 / rw_scale as u32) as i32
        }
        if midtexture != 0 {
          // One side: the whole column, which is then full.
          draw_column(Screen, Bytes, x, yl, yh, iscale, rw_midtexturemid,
                      get_column(Textures, TextureColumns, midtexture,
                                 texturecolumn),
                      colormap, View.centery, View.x, View.y, View.detail)
          Clips[x].ceiling = View.height
          Clips[x].floor = -1
        } else {
          if toptexture != 0 {
            let mid = min(pixhigh >> HEIGHTBITS, floorclip - 1)
            pixhigh += pixhighstep
            if mid >= yl {
              draw_column(Screen, Bytes, x, yl, mid, iscale, rw_toptexturemid,
                          get_column(Textures, TextureColumns, toptexture,
                                     texturecolumn),
                          colormap, View.centery, View.x, View.y, View.detail)
              Clips[x].ceiling = mid
            } else {
              Clips[x].ceiling = yl - 1
            }
          } else if markceiling {
            Clips[x].ceiling = yl - 1
          }
          if bottomtexture != 0 {
            let mid = max((pixlow + HEIGHTUNIT - 1) >> HEIGHTBITS,
                          Clips[x].ceiling + 1)
            pixlow += pixlowstep
            if mid <= yh {
              draw_column(Screen, Bytes, x, mid, yh, iscale, rw_bottomtexturemid,
                          get_column(Textures, TextureColumns, bottomtexture,
                                     texturecolumn),
                          colormap, View.centery, View.x, View.y, View.detail)
              Clips[x].floor = mid
            } else {
              Clips[x].floor = yh + 1
            }
          } else if markfloor {
            Clips[x].floor = yh + 1
          }
          if maskedtexture {
            // (Kept in 16 bits.)
            Openings[maskedtexturecol + x].value = (texturecolumn as i16) as i32
          }
        }
        rw_scale += rw_scalestep
        topfrac += topstep
        bottomfrac += bottomstep
      }
      // The rows that are left open in its columns, for the things
      // behind it.
      if (silhouette & SIL_TOP != 0 || maskedtexture) && sprtopclip < 0 {
        sprtopclip = len(Openings) - start
        for x in start..stop + 1 { Openings += { value: Clips[x].ceiling } }
      }
      if (silhouette & SIL_BOTTOM != 0 || maskedtexture) && sprbottomclip < 0 {
        sprbottomclip = len(Openings) - start
        for x in start..stop + 1 { Openings += { value: Clips[x].floor } }
      }
      if maskedtexture && silhouette & SIL_TOP == 0 {
        silhouette |= SIL_TOP
        tsilheight = 0x80000000
      }
      if maskedtexture && silhouette & SIL_BOTTOM == 0 {
        silhouette |= SIL_BOTTOM
        bsilheight = 0x7fffffff
      }
      Drawsegs += {
        seg: seg, x1: start, x2: stop, scale1: scale1, scale2: scale2,
        scalestep: rw_scalestep, silhouette: silhouette,
        bsilheight: bsilheight, tsilheight: tsilheight,
        sprtopclip: sprtopclip, sprbottomclip: sprbottomclip,
        maskedtexturecol: maskedtexturecol
      }
      drawsegs += 1
    }
  }
}

// Draws the floors and ceilings the walls left open (R_DrawPlanes,
// R_MakeSpans, R_MapPlane): the sky column by column, a flat in spans
// along the rows, each as far away as its row says. After `draw_walls`.
system draw_planes() {
  let vx = Frame[0].x
  let vy = Frame[0].y
  let vz = Frame[0].z
  let viewangle = Frame[0].angle
  // (What a unit to the right and a unit on are in the flat, at a
  // distance of one: R_ClearPlanes.)
  let turned = ((viewangle - ANG90) >> ANGLETOFINESHIFT) as i32
  let basexscale = fixed_div(finecosine(turned), View.centerxfrac)
  let baseyscale = -fixed_div(finesine[turned], View.centerxfrac)
  for y in 0..len(Spans) { Spans[y].cachedheight = 0 }
  for pl in 0..len(Visplanes) {
    let minx = Visplanes[pl].minx
    let maxx = Visplanes[pl].maxx
    let base = pl * 322 + 1
    if minx > maxx {
      // (Nothing of it was marked.)
    } else if Visplanes[pl].picnum == Data.skyflatnum {
      // The sky: a texture that turns with the eye and is always as big.
      for x in minx..maxx + 1 {
        let yl = Planetops[base + x].top as i32
        let yh = Planetops[base + x].bottom as i32
        if yl <= yh {
          let angle = ((viewangle + Xtoviewangle[x].angle) >> ANGLETOSKYSHIFT) as i32
          draw_column(Screen, Bytes, x, yl, yh,
                      (FRACUNIT * SCREENWIDTH / View.width) >> View.detail,
                      SCREENHEIGHT / 2 * FRACUNIT,
                      get_column(Textures, TextureColumns, Data.skytexture,
                                 angle),
                      Data.colormaps, View.centery, View.x, View.y, View.detail)
        }
      }
    } else {
      let source = Lumps[Data.firstflat + Flattrans[Visplanes[pl].picnum].pic].at
      let planeheight = abs(Visplanes[pl].height - vz)
      let light = min(max((Visplanes[pl].lightlevel >> LIGHTSEGSHIFT) + View.extralight, 0),
                      LIGHTLEVELS - 1) * MAXLIGHTZ
      Planetops[base + maxx + 1].top = 255
      Planetops[base + minx - 1].top = 255
      for x in minx..maxx + 2 {
        // R_MakeSpans: the rows of the column before and of this one;
        // where a row ends a span is drawn, where one starts it is
        // noted.
        var t1 = Planetops[base + x - 1].top as i32
        var b1 = Planetops[base + x - 1].bottom as i32
        var t2 = Planetops[base + x].top as i32
        var b2 = Planetops[base + x].bottom as i32
        // Rows that end: the top ones, then the bottom ones.
        for part in 0..2 {
          var more = if part == 0 { t1 < t2 && t1 <= b1 } else { b1 > b2 && b1 >= t1 }
          while more {
            let y = if part == 0 { t1 } else { b1 }
            // R_MapPlane.
            let x1 = Spans[y].spanstart
            if planeheight != Spans[y].cachedheight {
              let far = fixed_mul(planeheight, Spans[y].yslope)
              Spans[y].cachedheight = planeheight
              Spans[y].cacheddistance = far
              Spans[y].cachedxstep = fixed_mul(far, basexscale)
              Spans[y].cachedystep = fixed_mul(far, baseyscale)
            }
            let distance = Spans[y].cacheddistance
            let length = fixed_mul(distance, Distscale[x1].scale)
            let angle = ((viewangle + Xtoviewangle[x1].angle) >> ANGLETOFINESHIFT) as i32
            draw_span(Screen, Bytes, y, x1, x - 1,
                      vx + fixed_mul(finecosine(angle), length),
                      -vy - fixed_mul(finesine[angle], length),
                      Spans[y].cachedxstep, Spans[y].cachedystep, source,
                      if View.fixed != 0 {
                        Data.colormaps + View.fixed * 256
                      } else {
                        Zlight[light + min(distance >> LIGHTZSHIFT, MAXLIGHTZ - 1)].map
                      },
                      View.x, View.y, View.detail)
            if part == 0 { t1 += 1 } else { b1 -= 1 }
            more = if part == 0 { t1 < t2 && t1 <= b1 } else { b1 > b2 && b1 >= t1 }
          }
        }
        // Rows that start.
        while t2 < t1 && t2 <= b2 {
          Spans[t2].spanstart = x
          t2 += 1
        }
        while b2 > b1 && b2 >= t2 {
          Spans[b2].spanstart = x
          b2 -= 1
        }
      }
    }
  }
}

// A level as the WAD has it (p_setup.c): the lumps after the one that
// names it ("E1M1"), read into what the game computes with. Heights and
// places are in fixed point from here on.
import files
import wad
import fixed
import data

// Which lump after the level's name is what (doomdata.h).
const ML_THINGS = 1
const ML_LINEDEFS = 2
const ML_SIDEDEFS = 3
const ML_VERTEXES = 4
const ML_SEGS = 5
const ML_SSECTORS = 6
const ML_NODES = 7
const ML_SECTORS = 8
const ML_REJECT = 9
const ML_BLOCKMAP = 10

// What a line's flags say.
const ML_BLOCKING = 1
const ML_BLOCKMONSTERS = 2
const ML_TWOSIDED = 4
const ML_DONTPEGTOP = 8
const ML_DONTPEGBOTTOM = 16
const ML_SECRET = 32
const ML_SOUNDBLOCK = 64
const ML_DONTDRAW = 128
const ML_MAPPED = 256

// The level to load, and what loading it found: the lump that names it
// (-1: there is no such level). `skill` is how hard the game is, 0 to 4
// (2 is "Hurt me plenty"): it says which things are there.
unique Level { episode: i32, map: i32, lump: i32, skill: i32 }

// The corners of the level's lines.
buffer Vertexes { x: i32, y: i32 } capacity 32768

// A room: how high its floor and its ceiling are, the flats on them (by
// their numbers), how light it is, and what is special about it.
buffer Sectors {
  floorheight: i32, ceilingheight: i32, floorpic: i32, ceilingpic: i32,
  lightlevel: i32, special: i32, tag: i32
} capacity 4096

// A side of a line: the textures on it (by their numbers; 0 is none),
// how they are shifted, and the sector it looks into.
buffer Sides {
  textureoffset: i32, rowoffset: i32, toptexture: i32, bottomtexture: i32,
  midtexture: i32, sector: i32
} capacity 32768

// A line of the level: from (x1, y1) to (x2, y2), which is (dx, dy) on;
// its sides by their numbers, the back one -1 where it has none, and the
// sectors they look into (-1: none behind).
buffer Lines {
  x1: i32, y1: i32, x2: i32, y2: i32, dx: i32, dy: i32,
  flags: i32, special: i32, tag: i32, front: i32, back: i32,
  frontsector: i32, backsector: i32
} capacity 16384

// A piece of a line that is one side of a subsector: its ends, the angle
// it runs at, how far along its line it starts, its line and the side of
// it that is seen, and the sectors in front of it and behind it (-1:
// none behind).
buffer Segs {
  x1: i32, y1: i32, x2: i32, y2: i32, angle: u32, offset: i32,
  line: i32, side: i32, front: i32, back: i32
} capacity 32768

// A piece of a sector that is convex: so many segs from the first one.
buffer Subsectors { sector: i32, numlines: i32, firstline: i32 } capacity 32768

// The tree that says what is in front of what: a node is a line (from
// (x, y), (dx, dy) on) with what is on its right (child0) and on its
// left (child1), each a node, or a subsector where the bit NF_SUBSECTOR
// is set. The boxes around the two are in `Boxes`.
buffer Nodes {
  x: i32, y: i32, dx: i32, dy: i32, child0: i32, child1: i32
} capacity 32768
const NF_SUBSECTOR = 0x8000

// The boxes of the nodes: for node n and its side s, rows n * 8 + s * 4
// on are the box's top, bottom, left and right.
buffer Boxes { edge: i32 } capacity 262144
const BOXTOP = 0
const BOXBOTTOM = 1
const BOXLEFT = 2
const BOXRIGHT = 3

// What is put into the level, as the WAD has it: where, turned which
// way (in degrees), what it is, and at which skills it is there.
buffer Mapthings {
  x: i32, y: i32, angle: i32, type: i32, options: i32
} capacity 16384

// The sector a side looks into, or -1 for no side.
fn side_sector(sides: Sides, side: i32) -> i32 {
  if side < 0 { -1 } else { sides[side].sector }
}

// Reads the level `Level` names (P_SetupLevel), after `init_data`: the
// textures and flats are meant by their numbers.
system load_level() {
  var name: text[8] = "E{Level.episode}M{Level.map}"
  let lump = lump_number(Lumps, lump_name(name))
  Level.lump = lump
  Vertexes = []
  Sectors = []
  Sides = []
  Lines = []
  Segs = []
  Subsectors = []
  Nodes = []
  Boxes = []
  Mapthings = []
  if lump >= 0 {
    // P_LoadVertexes: two shorts each.
    let vertexes = Lumps[lump + ML_VERTEXES].at
    for i in 0..Lumps[lump + ML_VERTEXES].size / 4 {
      Vertexes += {
        x: short_at(Bytes, vertexes + i * 4) << FRACBITS,
        y: short_at(Bytes, vertexes + i * 4 + 2) << FRACBITS
      }
    }
    // P_LoadSectors: 26 bytes each.
    let sectors = Lumps[lump + ML_SECTORS].at
    for i in 0..Lumps[lump + ML_SECTORS].size / 26 {
      let at = sectors + i * 26
      Sectors += {
        floorheight: short_at(Bytes, at) << FRACBITS,
        ceilingheight: short_at(Bytes, at + 2) << FRACBITS,
        floorpic: lump_number(Lumps, name_at(Bytes, at + 4)) - Data.firstflat,
        ceilingpic: lump_number(Lumps, name_at(Bytes, at + 12)) - Data.firstflat,
        lightlevel: short_at(Bytes, at + 20),
        special: short_at(Bytes, at + 22), tag: short_at(Bytes, at + 24)
      }
    }
    // P_LoadSideDefs: 30 bytes each.
    let sides = Lumps[lump + ML_SIDEDEFS].at
    for i in 0..Lumps[lump + ML_SIDEDEFS].size / 30 {
      let at = sides + i * 30
      Sides += {
        textureoffset: short_at(Bytes, at) << FRACBITS,
        rowoffset: short_at(Bytes, at + 2) << FRACBITS,
        toptexture: texture_number(Textures, name_at(Bytes, at + 4)),
        bottomtexture: texture_number(Textures, name_at(Bytes, at + 12)),
        midtexture: texture_number(Textures, name_at(Bytes, at + 20)),
        sector: short_at(Bytes, at + 28)
      }
    }
    // P_LoadLineDefs: 14 bytes each.
    let lines = Lumps[lump + ML_LINEDEFS].at
    for i in 0..Lumps[lump + ML_LINEDEFS].size / 14 {
      let at = lines + i * 14
      let v1 = ushort_at(Bytes, at)
      let v2 = ushort_at(Bytes, at + 2)
      Lines += {
        x1: Vertexes[v1].x, y1: Vertexes[v1].y,
        x2: Vertexes[v2].x, y2: Vertexes[v2].y,
        dx: Vertexes[v2].x - Vertexes[v1].x,
        dy: Vertexes[v2].y - Vertexes[v1].y,
        flags: short_at(Bytes, at + 4), special: short_at(Bytes, at + 6),
        tag: short_at(Bytes, at + 8), front: short_at(Bytes, at + 10),
        back: short_at(Bytes, at + 12),
        frontsector: side_sector(Sides, short_at(Bytes, at + 10)),
        backsector: side_sector(Sides, short_at(Bytes, at + 12))
      }
    }
    // P_LoadSubsectors: 4 bytes each. (Its sector is that of its first
    // seg, below: P_GroupLines.)
    let subsectors = Lumps[lump + ML_SSECTORS].at
    for i in 0..Lumps[lump + ML_SSECTORS].size / 4 {
      Subsectors += {
        sector: 0, numlines: short_at(Bytes, subsectors + i * 4),
        firstline: short_at(Bytes, subsectors + i * 4 + 2)
      }
    }
    // P_LoadNodes: 28 bytes each.
    let nodes = Lumps[lump + ML_NODES].at
    for i in 0..Lumps[lump + ML_NODES].size / 28 {
      let at = nodes + i * 28
      Nodes += {
        x: short_at(Bytes, at) << FRACBITS,
        y: short_at(Bytes, at + 2) << FRACBITS,
        dx: short_at(Bytes, at + 4) << FRACBITS,
        dy: short_at(Bytes, at + 6) << FRACBITS,
        child0: ushort_at(Bytes, at + 24), child1: ushort_at(Bytes, at + 26)
      }
      for k in 0..8 {
        Boxes += { edge: short_at(Bytes, at + 8 + k * 2) << FRACBITS }
      }
    }
    // P_LoadSegs: 12 bytes each.
    let segs = Lumps[lump + ML_SEGS].at
    for i in 0..Lumps[lump + ML_SEGS].size / 12 {
      let at = segs + i * 12
      let v1 = ushort_at(Bytes, at)
      let v2 = ushort_at(Bytes, at + 2)
      let line = short_at(Bytes, at + 6)
      let side = short_at(Bytes, at + 8)
      let near = if side == 0 { Lines[line].front } else { Lines[line].back }
      let far = if side == 0 { Lines[line].back } else { Lines[line].front }
      Segs += {
        x1: Vertexes[v1].x, y1: Vertexes[v1].y,
        x2: Vertexes[v2].x, y2: Vertexes[v2].y,
        angle: (short_at(Bytes, at + 4) << FRACBITS) as u32,
        offset: short_at(Bytes, at + 10) << FRACBITS,
        line: line, side: near, front: Sides[near].sector,
        back: if Lines[line].flags & ML_TWOSIDED != 0 {
          side_sector(Sides, far)
        } else {
          -1
        }
      }
    }
    for i in 0..len(Subsectors) {
      Subsectors[i].sector = Segs[Subsectors[i].firstline].front
    }
    // P_LoadThings: 10 bytes each.
    let things = Lumps[lump + ML_THINGS].at
    for i in 0..Lumps[lump + ML_THINGS].size / 10 {
      let at = things + i * 10
      Mapthings += {
        x: short_at(Bytes, at), y: short_at(Bytes, at + 2),
        angle: short_at(Bytes, at + 4), type: short_at(Bytes, at + 6),
        options: short_at(Bytes, at + 8)
      }
    }
  }
}

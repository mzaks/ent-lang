+// that name with ".raw" after it, one picture after another. Then the
+// program ends. DOOM_VIEW_SKIP leaves out the planes ('p') and what is
+// masked ('m').
+FILE *r_dump;
 
+static void R_RenderView (const char *skip)
+{
     // Clear buffers.
     R_ClearClipSegs ();
     R_ClearDrawSegs ();
@@ -878,13 +891,77 @@ void R_RenderPlayerView (player_t* player)

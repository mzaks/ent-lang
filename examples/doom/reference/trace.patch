diff --git i/src/doom/p_tick.c w/src/doom/p_tick.c
index 5a93b80..d35a2b7 100644
--- i/src/doom/p_tick.c
+++ w/src/doom/p_tick.c
@@ -23,6 +23,141 @@
 
 #include "doomstat.h"
 
+#include <stdio.h>
+#include <stdlib.h>
+#include "m_random.h"
+#include "i_system.h"
+#include "tables.h"
+#include "r_main.h"
+#include "r_state.h"
+
+// ent-lang: one line for each tic of a level, to compare a port against.
+// The hash of the map objects does not depend on their order.
+extern int prndindex;
+
+static unsigned int TraceMix (unsigned int hash, int value)
+{
+    int i;
+
+    for (i = 0; i < 4; i++)
+    {
+	hash ^= (unsigned int) (value >> (i * 8)) & 0xff;
+	hash *= 16777619u;
+    }
+    return hash;
+}
+
+// ent-lang: what the fixed point, the tables and the random numbers give
+// for a million pairs of numbers, to compare a port's against
+// (examples/doom/check/maths.ent prints the same).
+void P_MathsCheck (void)
+{
+    const char *name = getenv ("DOOM_MATHS");
+    FILE *file;
+    unsigned int state = 1;
+    unsigned int mul = 2166136261u, div = 2166136261u, slope = 2166136261u;
+    unsigned int angle = 2166136261u, dist = 2166136261u;
+    unsigned int aprox = 2166136261u;
+    unsigned int sine = 2166136261u, tangent = 2166136261u;
+    unsigned int arc = 2166136261u, sum = 2166136261u;
+    int i;
+
+    if (!name)
+	return;
+    file = fopen (name, "w");
+    if (!file)
+	I_Error ("P_MathsCheck: cannot write %s", name);
+
+    for (i = 0; i < 10240; i++)
+	sine = TraceMix (sine, finesine[i]);
+    for (i = 0; i < 4096; i++)
+	tangent = TraceMix (tangent, finetangent[i]);
+    for (i = 0; i < 2049; i++)
+	arc = TraceMix (arc, (int) tantoangle[i]);
+    fprintf (file, "tables %u %u %u\n", sine, tangent, arc);
+
+    viewx = viewy = 0;
+    for (i = 0; i < 1000000; i++)
+    {
+	int a, b;
+
+	state = state * 1664525u + 1013904223u;
+	a = (int) state >> (i % 24);
+	state = state * 1664525u + 1013904223u;
+	b = (int) state >> ((i / 24) % 24);
+	mul = TraceMix (mul, FixedMul (a, b));
+	div = TraceMix (div, FixedDiv (a, b));
+	slope = TraceMix (slope, SlopeDiv (a, b));
+	angle = TraceMix (angle, (int) R_PointToAngle (a, b));
+	dist = TraceMix (dist, R_PointToDist (a, b));
+	aprox = TraceMix (aprox, P_AproxDistance (a, b));
+	if (i % 100000 == 0)
+	{
+	    fprintf (file, "%d: %d %d mul %d div %d slope %d angle %u\n",
+		     i, a, b, FixedMul (a, b), FixedDiv (a, b),
+		     SlopeDiv (a, b), (unsigned int) R_PointToAngle (a, b));
+	    fprintf (file, "  dist %d aprox %d\n", R_PointToDist (a, b),
+		     P_AproxDistance (a, b));
+	}
+    }
+    fprintf (file, "mul %u div %u slope %u\n", mul, div, slope);
+    fprintf (file, "angle %u dist %u aprox %u\n", angle, dist, aprox);
+
+    M_ClearRandom ();
+    for (i = 0; i < 600; i++)
+	sum = TraceMix (sum, P_Random ());
+    fprintf (file, "random %u at %d\n", sum, prndindex);
+    fclose (file);
+    exit (0);
+}
+
+static void P_Trace (void)
+{
+    static FILE *file;
+    static boolean asked;
+    thinker_t *thinker;
+    unsigned int all = 0;
+    int count = 0;
+    player_t *player = &players[consoleplayer];
+
+    if (!asked)
+    {
+	const char *name = getenv ("DOOM_TRACE");
+
+	asked = true;
+	if (name)
+	    file = fopen (name, "w");
+    }
+    if (!file)
+	return;
+
+    for (thinker = thinkercap.next; thinker != &thinkercap;
+	 thinker = thinker->next)
+    {
+	mobj_t *mobj;
+	unsigned int hash = 2166136261u;
+
+	if (thinker->function.acp1 != (actionf_p1) P_MobjThinker)
+	    continue;
+	mobj = (mobj_t *) thinker;
+	hash = TraceMix (hash, mobj->type);
+	hash = TraceMix (hash, mobj->x);
+	hash = TraceMix (hash, mobj->y);
+	hash = TraceMix (hash, mobj->z);
+	hash = TraceMix (hash, (int) mobj->angle);
+	hash = TraceMix (hash, mobj->health);
+	hash = TraceMix (hash, (int) (mobj->state - states));
+	hash = TraceMix (hash, mobj->tics);
+	all += hash;
+	count++;
+    }
+    fprintf (file, "%d %d %d %d %d %d %d %u %d %d %08x\n",
+	     gameepisode, gamemap, leveltime, prndindex,
+	     player->mo->x, player->mo->y, player->mo->z,
+	     (unsigned int) player->mo->angle, player->health, count, all);
+    fflush (file);
+}
+
 
 int	leveltime;
 
@@ -126,6 +261,12 @@ void P_Ticker (void)
 {
     int		i;
     
+    // ent-lang: the level stays as it was loaded while views of it are
+    // written (R_RenderPlayerView): no light has flickered and no wall
+    // has moved.
+    if (getenv ("DOOM_VIEW"))
+	return;
+
     // run the tic
     if (paused)
 	return;
@@ -148,6 +289,8 @@ void P_Ticker (void)
     P_UpdateSpecials ();
     P_RespawnSpecials ();
 
+    P_Trace ();
+
     // for par times
     leveltime++;	
 }
diff --git i/src/doom/r_main.c w/src/doom/r_main.c
index 970bd19..8968f2f 100644
--- i/src/doom/r_main.c
+++ w/src/doom/r_main.c
@@ -23,10 +23,15 @@
 
 
 #include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
 #include <math.h>
 
 
 #include "doomdef.h"
+#include "p_local.h"
+#include "i_video.h"
+#include "i_system.h"
 #include "d_loop.h"
 
 #include "m_bbox.h"
@@ -859,10 +864,18 @@ void R_SetupFrame (player_t* player)
 //
 // R_RenderView
 //
-void R_RenderPlayerView (player_t* player)
-{	
-    R_SetupFrame (player);
+// ent-lang: where DOOM_VIEW names a file, the level is drawn as it is
+// seen from where each of its things is (the first DOOM_VIEW_COUNT of
+// them; the player's own view where that is not set) when the first view
+// is to be drawn, and for each the file gets where it is seen from and
+// every range of columns a wall is stored for; the pixels of each go to
+// that name with ".raw" after it, one picture after another. Then the
+// program ends. DOOM_VIEW_SKIP leaves out the planes ('p') and what is
+// masked ('m').
+FILE *r_dump;
 
+static void R_RenderView (const char *skip)
+{
     // Clear buffers.
     R_ClearClipSegs ();
     R_ClearDrawSegs ();
@@ -878,13 +891,77 @@ void R_RenderPlayerView (player_t* player)
     // Check for new console commands.
     NetUpdate ();
     
-    R_DrawPlanes ();
+    if (!skip || !strchr (skip, 'p'))
+	R_DrawPlanes ();
     
     // Check for new console commands.
     NetUpdate ();
     
-    R_DrawMasked ();
+    if (!skip || !strchr (skip, 'm'))
+	R_DrawMasked ();
 
     // Check for new console commands.
     NetUpdate ();				
 }
+
+static void R_DumpView (FILE *raw, const char *skip)
+{
+    memset (I_VideoBuffer, 0, SCREENWIDTH * SCREENHEIGHT);
+    viewsin = finesine[viewangle>>ANGLETOFINESHIFT];
+    viewcos = finecosine[viewangle>>ANGLETOFINESHIFT];
+    fprintf (r_dump, "view %d %d %d %u window %d %d at %d %d\n",
+	     viewx, viewy, viewz, (unsigned int) viewangle,
+	     viewwidth, viewheight, viewwindowx, viewwindowy);
+    R_RenderView (skip);
+    if (raw)
+	fwrite (I_VideoBuffer, 1, SCREENWIDTH * SCREENHEIGHT, raw);
+}
+
+void R_RenderPlayerView (player_t* player)
+{	
+    const char *dump_name = getenv ("DOOM_VIEW");
+    const char *dump_skip = getenv ("DOOM_VIEW_SKIP");
+    const char *dump_count = getenv ("DOOM_VIEW_COUNT");
+
+    R_SetupFrame (player);
+
+    if (dump_name)
+    {
+	char raw_name[1024];
+	FILE *raw;
+	thinker_t *thinker;
+	int left = dump_count ? atoi (dump_count) : 0;
+	unsigned int turn = 0;
+
+	r_dump = fopen (dump_name, "w");
+	if (!r_dump)
+	    I_Error ("R_RenderPlayerView: cannot write %s", dump_name);
+	snprintf (raw_name, sizeof raw_name, "%s.raw", dump_name);
+	raw = fopen (raw_name, "wb");
+	if (left <= 0)
+	    R_DumpView (raw, dump_skip);
+	for (thinker = thinkercap.next; thinker != &thinkercap && left > 0;
+	     thinker = thinker->next)
+	{
+	    mobj_t *mobj = (mobj_t *) thinker;
+
+	    if (thinker->function.acp1 != (actionf_p1) P_MobjThinker)
+		continue;
+	    // (Turned another way each time, and not along the grid.)
+	    viewx = mobj->x;
+	    viewy = mobj->y;
+	    viewz = mobj->floorz + 41 * FRACUNIT;
+	    viewangle = mobj->angle + turn;
+	    turn += 0x12345678u;
+	    validcount++;
+	    R_DumpView (raw, dump_skip);
+	    left--;
+	}
+	fclose (r_dump);
+	if (raw)
+	    fclose (raw);
+	exit (0);
+    }
+
+    R_RenderView (NULL);
+}

+// ent-lang: where DOOM_SHOTS names a file, the screen as it is drawn
+// after each of the level's tics that DOOM_SHOT_TICS lists (numbers with
+// commas between) is written to it, 320 by 200 bytes each, one after
+// another: what a port's screen is held against (check/shots.sh).
+static void D_Shot (void)
+{
+    static FILE *file;
+    static int tics[256];
+    static int count = -1;
+    static int next;
+    static int base = -1;
+
+    if (count < 0)
+    {
+	const char *name = getenv ("DOOM_SHOTS");
+	const char *list = getenv ("DOOM_SHOT_TICS");
+
+	count = 0;
+	if (name && list)
+	{
+	    file = fopen (name, "wb");
+	    while (*list && count < 256)
+	    {
+		tics[count++] = atoi (list);
+		while (*list && *list != ',')
+		    list++;
+		if (*list)
+		    list++;
+	    }
+	}
+    }
+    // (The first screen that is drawn at or after each: several tics may
+    // go by between two. Which tic it was is said on stdout, and which of
+    // the palettes the screen is shown in.)
+    // (The tics are counted from the demo's first, through the levels
+    // and what is between them.)
+    if (!file || next >= count
+	|| (gamestate != GS_LEVEL && gamestate != GS_INTERMISSION))
+	return;
+    if (base < 0)
+	base = gametic - leveltime;
+    if (gametic - base <= tics[next])
+	return;
+    fwrite (I_VideoBuffer, 1, SCREENWIDTH * SCREENHEIGHT, file);
+    fflush (file);
+    {
+	extern int st_palette;
+
+	printf ("shot %d %d\n", gametic - base - 1,
+		gamestate == GS_LEVEL ? st_palette : 0);
+    }
+    fflush (stdout);
+    while (next < count && gametic - base > tics[next])
+	next++;
+}
+
 void D_RunFrame()
 {
     int nowtime;

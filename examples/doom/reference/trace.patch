-        if ((wipe = D_Display ()))
+        wipe = D_Display ();
+        D_Shot ();
+        if (wipe)
         {
             // start wipe on this frame
             wipe_EndScreen(0, 0, SCREENWIDTH, SCREENHEIGHT);
@@ -1960,6 +2018,12 @@ void D_DoomMain (void)
 

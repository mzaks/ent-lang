+    if (!skip || !strchr (skip, 'm'))
+	R_DrawMasked ();
 
     // Check for new console commands.
     NetUpdate ();				
 }
+
+static void R_DumpView (FILE *raw, const char *skip)
+{
+    memset (I_VideoBuffer, 0, SCREENWIDTH * SCREENHEIGHT);
+    viewsin = finesine[viewangle>>ANGLETOFINESHIFT];
+    viewcos = finecosine[viewangle>>ANGLETOFINESHIFT];
+    fprintf (r_dump, "view %d %d %d %u window %d %d at %d %d\n",
+	     viewx, viewy, viewz, (unsigned int) viewangle,
+	     viewwidth, viewheight, viewwindowx, viewwindowy);
+    R_RenderView (skip);
+    if (raw)
+	fwrite (I_VideoBuffer, 1, SCREENWIDTH * SCREENHEIGHT, raw);
+}
+
+void R_RenderPlayerView (player_t* player)
+{	
+    const char *dump_name = getenv ("DOOM_VIEW");
+    const char *dump_skip = getenv ("DOOM_VIEW_SKIP");
+    const char *dump_count = getenv ("DOOM_VIEW_COUNT");
+
+    R_SetupFrame (player);
+
+    if (dump_name)
+    {
+	char raw_name[1024];
+	FILE *raw;
+	thinker_t *thinker;
+	int left = dump_count ? atoi (dump_count) : 0;
+	unsigned int turn = 0;
+
+	r_dump = fopen (dump_name, "w");
+	if (!r_dump)
+	    I_Error ("R_RenderPlayerView: cannot write %s", dump_name);
+	snprintf (raw_name, sizeof raw_name, "%s.raw", dump_name);
+	raw = fopen (raw_name, "wb");
+	if (left <= 0)
+	    R_DumpView (raw, dump_skip);
+	for (thinker = thinkercap.next; thinker != &thinkercap && left > 0;
+	     thinker = thinker->next)
+	{
+	    mobj_t *mobj = (mobj_t *) thinker;
+
+	    if (thinker->function.acp1 != (actionf_p1) P_MobjThinker)
+		continue;
+	    // (Turned another way each time, and not along the grid.)
+	    viewx = mobj->x;
+	    viewy = mobj->y;
+	    viewz = mobj->floorz + 41 * FRACUNIT;
+	    viewangle = mobj->angle + turn;
+	    turn += 0x12345678u;
+	    validcount++;
+	    R_DumpView (raw, dump_skip);
+	    left--;
+	}
+	fclose (r_dump);
+	if (raw)
+	    fclose (raw);
+	exit (0);
+    }
+
+    R_RenderView (NULL);
+}

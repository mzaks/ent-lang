// A demo played, and the screen as it is drawn after each of the tics
// that `shots` lists (check/shots.sh writes the table from what the
// reference says it drew), into shots.port: 320 by 200 bytes each, to
// hold against the reference's.
import console
import files
import wad
import fixed
import random
import data
import level
import video
import info
import render
import things
import sprites
import demo
import specials
import items
import play
import enemy
import weapon
import movers
import tick
import sounds
import screen
import shots

capacity Bytes 16777216

unique Next: i32
unique Room: i32
unique Now: bool
unique Drawn: bool
unique Again: bool

world {
  Wad.file = "doom1.wad"
  Demo.lump = "DEMO1"
  View.blocks = 10
}

system begin_level() {
  Level.episode = Demo.episode
  Level.map = Demo.map
  Level.skill = Demo.skill
  Level.nomonsters = Demo.nomonsters
  Random.play = 0
  Random.other = 0
  Clock.leveltime = 0
  Room = len(Bytes)
  for i in 0..SCREENWIDTH * SCREENHEIGHT { Bytes += { value: 0 } }
}

// Whether this tic's screen is one that is asked for.
system ask() {
  Now = Next < len(shots) && Clock.leveltime == shots[Next]
  // (The reference has two tics before its first screen, so the first
  // tic is not drawn: a shadow's look depends on all the shadows drawn
  // before.)
  Drawn = Clock.leveltime > 0 || Again
}

system look() {
  for m: Mobj where m.type == MT_PLAYER {
    Viewpoint.x = m.x
    Viewpoint.y = m.y
    Viewpoint.angle = m.angle
  }
  Viewpoint.z = Pl[0].viewz
  View.extralight = Pl[0].extralight
  View.fixed = fixed_colormap(Powers)
  Shade.palette = screen_palette(Inv, Powers)
}

system keep() {
  for i in 0..len(Screen) { Bytes[Room + i].value = Screen[i].pixel }
  if !write_bytes("shots.port", Bytes, Room, SCREENWIDTH * SCREENHEIGHT,
                  Next > 0) {
    put("could not write shots.port")
  }
  // (And which of the palettes it is shown in.)
  put("shot {Clock.leveltime} {Shade.palette}")
  Next += 1
}

// (The reference melts the first screen of a level in, by 320 random
// numbers, which the face then goes on from. Its first screen is the
// one after the second tic, see `ask`; of a level that is started
// again, the one after the first.)
system melt() {
  if Clock.leveltime == if Again { 0 } else { 1 } {
    Random.other = (Random.other + 320) & 0xff
  }
}

system next() { Clock.leveltime += 1 }

schedule setup() {
  load_wad()
  init_data()
  init_specials()
  init_sprites()
  init_status()
  read_demo()
  begin_level()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  start_screen()
  set_view_size()
  init_view_tables()
}
schedule tic() {
  begin_sounds()
  think_player()
  player_sector()
  use_lines()
  trigger_lines()
  think_weapon()
  think_things(false)
  run_lights()
  think_things(true)
  run_movers()
  update_specials()
  update_buttons()
  tick_status()
  melt()
  ask()
  // (Every tic but the first is drawn, as the reference draws them.)
  look() run_if Drawn
  clear_screen() run_if Drawn
  render_view() run_if Drawn
  draw_walls() run_if Drawn
  draw_planes() run_if Drawn
  draw_masked() run_if Drawn
  draw_weapon() run_if Drawn
  draw_status() run_if Drawn
  keep() run_if Now
  next()
}
// The level again, after the player's death.
system once_more() { Again = true }
schedule again() run_if Level.reborn {
  leave_level()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  arrive()
  once_more()
}
main {
  setup()
  loop {
    tic()
    again()
  } until Next == len(shots) || Demo.over || Level.exited
}

// A demo played, and the screen as it is drawn after each of the tics
// that `shots` lists (check/shots.sh writes the table from what the
// reference says it drew), into shots.port: 320 by 200 bytes each, to
// hold against the reference's. And the screens of the melts from one
// kind of screen into another, into shots.melt, where `melts` has by
// how many steps each goes on.
import console
import files
import wad
import fixed
import random
import data
import level
import video
import info
import render
import things
import sprites
import demo
import specials
import items
import play
import enemy
import weapon
import movers
import tick
import sounds
import screen
import between
import melt
import shots

capacity Bytes 16777216

unique Next: i32
unique Room: i32
unique Now: bool
unique Drawn: bool
unique Again: bool
// How many melts there were, which of `melts` is next, and where in
// Bytes a screen of a melt is put to be written.
unique Melted: i32
unique Step: i32
unique Meltroom: i32
unique Full: bool
// All that was asked for is written.
unique Done: bool

world {
  Wad.file = "doom1.wad"
  Demo.lump = "DEMO1"
  View.blocks = 10
  Border.count = 3
}

system begin_level() {
  Level.episode = Demo.episode
  Level.map = Demo.map
  Level.skill = Demo.skill
  Level.nomonsters = Demo.nomonsters
  Random.play = 0
  Random.other = 0
  Clock.leveltime = 0
  Room = len(Bytes)
  for i in 0..SCREENWIDTH * SCREENHEIGHT { Bytes += { value: 0 } }
  Meltroom = len(Bytes)
  for i in 0..SCREENWIDTH * SCREENHEIGHT { Bytes += { value: 0 } }
  Full = View.blocks == 11
}

// Whether this tic's screen is one that is asked for.
system ask() {
  // (The tics are counted from the demo's first, through the levels
  // and what is between them.)
  Now = Next < len(shots) && Demo.tic - 1 == shots[Next]
  // (The reference has two tics before its first screen, so the first
  // tic is not drawn: a shadow's look depends on all the shadows drawn
  // before.)
  Drawn = Clock.leveltime > 0 || Again
}

system look() {
  for m: Mobj where m.type == MT_PLAYER {
    Viewpoint.x = m.x
    Viewpoint.y = m.y
    Viewpoint.angle = m.angle
  }
  Viewpoint.z = Pl[0].viewz
  View.extralight = Pl[0].extralight
  View.fixed = fixed_colormap(Powers)
  Shade.palette = screen_palette(Inv, Powers)
}

system keep() {
  for i in 0..len(Screen) { Bytes[Room + i].value = Screen[i].pixel }
  if !write_bytes("shots.port", Bytes, Room, SCREENWIDTH * SCREENHEIGHT,
                  Next > 0) {
    put("could not write shots.port")
  }
  // (And which of the palettes it is shown in.)
  put("shot {Demo.tic - 1} {Shade.palette}")
  Next += 1
  Done = Next == len(shots) && melts[Step] == 0
}

// A screen of a melt: on by as many steps as the reference's went, and
// written if it is one that is asked for.
system melt_shot() {
  let asked = Melted >= MELT_SKIP && melts[Step] != 0
  for i in 0..if asked { melts[Step] } else { 1 } {
    if melt_on(Screen, Before, After, Drops) { Melt.on = false }
  }
  if asked {
    for i in 0..len(Screen) { Bytes[Meltroom + i].value = Screen[i].pixel }
    if !write_bytes("shots.melt", Bytes, Meltroom, SCREENWIDTH * SCREENHEIGHT,
                    Step > 0) {
      put("could not write shots.melt")
    }
    put("melt {Melted} {melts[Step]}")
    Step += 1
  }
  if !Melt.on { Melted += 1 }
  Done = Next == len(shots) && melts[Step] == 0
}

system next() { Clock.leveltime += 1 }

schedule setup() {
  load_wad()
  init_data()
  init_specials()
  init_sprites()
  init_status()
  init_messages()
  read_demo()
  begin_level()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  start_messages()
  start_screen()
  set_view_size()
  init_view_tables()
}
schedule tic() run_if !Wi.on && !Fin.on {
  begin_sounds()
  think_player()
  player_sector()
  use_lines()
  trigger_lines()
  think_weapon()
  think_things(false)
  run_lights()
  think_things(true)
  run_movers()
  update_specials()
  update_buttons()
  tick_status()
  tick_messages()
  ask()
  // (Every tic but the first is drawn, as the reference draws them.)
  look() run_if Drawn
  melt_from(MELT_LEVEL) run_if Drawn
  clear_screen() run_if Drawn
  draw_border() run_if Drawn
  render_view() run_if Drawn
  draw_walls() run_if Drawn
  draw_planes() run_if Drawn
  draw_masked() run_if Drawn
  draw_weapon() run_if Drawn
  draw_status() run_if Drawn && !Full
  draw_messages() run_if Drawn
  draw_border_over() run_if Drawn
  keep() run_if Now
  melt_to() run_if Drawn
  next()
  complete_level()
}
// (A level that is not the demo's first has its first tic drawn.)
system once_more() { Again = true }
// (What is not a level is shown in the colours as they are.)
system plain() { Shade.palette = 0 }
schedule ending() run_if Fin.on {
  begin_sounds()
  tick_finale()
  plain()
  ask()
  melt_from(MELT_FINALE)
  clear_screen()
  draw_finale()
  keep() run_if Now
  melt_to()
}
schedule between() run_if Wi.on {
  begin_sounds()
  tick_between()
  plain()
  ask()
  melt_from(MELT_BETWEEN)
  clear_screen()
  draw_between()
  keep() run_if Now
  melt_to()
}
schedule onward() run_if Wi.over {
  leave_level()
  leave_between()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(false)
  start_weapon()
  start_status()
  start_messages()
  arrive()
  once_more()
  melt_anew()
  border_anew()
}
// The level again, after the player's death.
schedule again() run_if Level.reborn {
  leave_level()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  start_messages()
  arrive()
  once_more()
  melt_anew()
}
// (While one kind of screen melts into another, nothing else goes on.)
schedule melting() run_if Melt.on {
  melt_shot()
}
main {
  setup()
  loop {
    loop { melting() } until !Melt.on
    ending()
    onward()
    between()
    tic()
    again()
  } until Done || Demo.over
}

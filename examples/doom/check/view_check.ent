// What is seen from where the player starts in a level: where from, how
// big the view is, and the pieces of walls in the order they are found,
// as the reference writes them (DOOM_VIEW, reference/trace.patch). See
// check/view.sh.
import console
import files
import wad
import level
import video
import render

capacity Bytes 16777216

world {
  Wad.file = "doom1.wad"
  Level.episode = 1
  Level.map = 1
}

system report() {
  put("view {Viewpoint.x} {Viewpoint.y} {Viewpoint.z} {Viewpoint.angle} window {View.width} {View.height} at {View.x} {View.y}")
  for i in 0..len(Walls) {
    put("wall {Walls[i].first} {Walls[i].last} {Walls[i].seg}")
  }
}

schedule check() {
  load_wad()
  load_level()
  set_view_size()
  start_viewpoint()
  render_view()
  report()
}
main { check() }

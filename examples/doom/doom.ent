// Doom in ent-lang, as far as it is: reads the WAD and plays a level of
// it, without its monsters and without weapons: the arrow keys walk and
// turn (A and D step aside, Shift runs), Space opens doors and works
// switches, Tab shows the map. Start it where `doom1.wad` is
// (examples/doom/reference/fetch.sh puts the shareware one in
// build/doom/wad):
//
//   cd build/doom/wad && ../../../tools/ent run -I ../../../examples/doom \
//       ../../../examples/doom/doom.ent
import window
import files
import wad
import data
import level
import video
import automap
import fixed
import tables
import angles
import render
import info
import things
import sprites
import random
import demo
import specials
import items
import play
import enemy
import weapon
import movers
import tick
import sounds
import audio
import screen
import between

// As many bytes as the biggest WAD.
capacity Bytes 16777216

world {
  Window.width = 960
  Window.height = 600
  Window.title = "DOOM"
  Window.fps = 35
  Wad.file = "doom1.wad"
  Level.episode = 1
  Level.map = 1
  Level.skill = 2
}

// Whether the map is shown, and whether Tab was down the frame before.
unique Shown { map: bool, tab: bool }

// The keys of this tic as a demo has them (of G_BuildTiccmd): one row
// more for the player to be moved by. So what is played is a demo too.
system read_keys() {
  let run = key_down(340) || key_down(344)
  var forward = 0
  var side = 0
  var turn = 0
  if Keys.up { forward += if run { 50 } else { 25 } }
  if Keys.down { forward -= if run { 50 } else { 25 } }
  if key_down('D' as i32) { side += if run { 40 } else { 24 } }
  if key_down('A' as i32) { side -= if run { 40 } else { 24 } }
  if Keys.left { turn += if run { 1280 } else { 640 } }
  if Keys.right { turn -= if run { 1280 } else { 640 } }
  // (The keys 1 to 7 ask for a weapon: the first of them that is down.)
  var change = 0
  for i in 0..7 {
    if change == 0 && key_down('1' as i32 + i) {
      change = BT_CHANGE | i << BT_WEAPONSHIFT
    }
  }
  Ticcmds += {
    forwardmove: forward, sidemove: side, angleturn: turn,
    // (The left Ctrl key shoots.)
    buttons: (if Keys.space { BT_USE } else { 0 }) |
             (if key_down(341) { BT_ATTACK } else { 0 }) | change
  }
  let tab = key_down(258)
  if tab && !Shown.tab { Shown.map = !Shown.map }
  Shown.tab = tab
}

// The level is seen from the player's eye.
system look() {
  for m: Mobj where m.type == MT_PLAYER {
    Viewpoint.x = m.x
    Viewpoint.y = m.y
    Viewpoint.angle = m.angle
  }
  Viewpoint.z = Pl[0].viewz
  View.extralight = Pl[0].extralight
  View.fixed = fixed_colormap(Powers)
  Shade.palette = screen_palette(Inv, Powers)
  Clock.leveltime += 1
}

// The view is all of the screen above the status bar.
system whole_view() { View.blocks = 10 }

schedule setup() {
  load_wad()
  load_palette()
  init_data()
  init_specials()
  init_sprites()
  init_status()
  init_messages()
  init_audio()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  start_messages()
  start_screen()
  fit_automap()
  whole_view()
  set_view_size()
  init_view_tables()
}

schedule frame() run_if !Wi.on && !Fin.on {
  begin()
  read_keys()
  begin_sounds()
  think_player()
  player_sector()
  use_lines()
  trigger_lines()
  think_weapon()
  think_things(false)
  run_lights()
  think_things(true)
  run_movers()
  update_specials()
  update_buttons()
  hear()
  tick_status()
  tick_messages()
  look()
  clear_screen()
  render_view() run_if !Shown.map
  draw_walls() run_if !Shown.map
  draw_planes() run_if !Shown.map
  draw_masked() run_if !Shown.map
  draw_weapon() run_if !Shown.map
  draw_status()
  draw_messages()
  draw_automap() run_if Shown.map
  show_screen()
  present()
  complete_level()
}

// Between two levels: what was done in the one is counted up, and the
// way to the other shown, in the colours as they are.
system plain() { Shade.palette = 0 }
// After the last level: the text, and then the picture, for as long as
// the window is open.
schedule ending() run_if Fin.on {
  begin()
  read_keys()
  begin_sounds()
  tick_finale()
  hear()
  plain()
  clear_screen()
  draw_finale()
  show_screen()
  present()
}
schedule between() run_if Wi.on {
  begin()
  read_keys()
  begin_sounds()
  tick_between()
  hear()
  plain()
  clear_screen()
  draw_between()
  show_screen()
  present()
}
schedule onward() run_if Wi.over {
  leave_level()
  leave_between()
  quiet()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(false)
  start_weapon()
  start_status()
  start_messages()
  fit_automap()
  arrive()
}

// The same level again after the player's death.
schedule again() run_if Level.reborn {
  leave_level()
  quiet()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  start_messages()
  fit_automap()
  arrive()
}

main {
  setup()
  loop {
    ending()
    onward()
    between()
    frame()
    again()
  } until Window.closed
}

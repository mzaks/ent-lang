// Doom in ent-lang, as far as it is: reads the WAD, shows the title and
// the demos, and plays the episode from the menu: the arrow keys walk
// and turn (A and D step aside, Shift runs), Space opens doors and works
// switches, the left Ctrl key shoots, 1 to 7 choose a weapon, Tab shows
// the map, - and = make the view smaller and bigger, Esc is the menu.
// Start it where `doom1.wad` is
// (examples/doom/reference/fetch.sh puts the shareware one in
// build/doom/wad):
//
//   cd build/doom/wad && ../../../tools/ent run -I ../../../examples/doom \
//       ../../../examples/doom/doom.ent
import window
import files
import wad
import data
import level
import video
import automap
import fixed
import tables
import angles
import render
import info
import things
import sprites
import random
import demo
import specials
import items
import play
import enemy
import weapon
import movers
import tick
import sounds
import audio
import screen
import between
import shell
import melt

// As many bytes as the biggest WAD.
capacity Bytes 16777216

world {
  Window.width = 960
  Window.height = 600
  Window.title = "DOOM"
  Window.fps = 35
  Wad.file = "doom1.wad"
  Level.episode = 1
  Level.map = 1
  Level.skill = 2
  // (The view as big as the game starts with: a little smaller than the
  // screen is wide.)
  View.blocks = 9
}

// Whether the map is shown, and whether Tab was down the frame before.
unique Shown { map: bool, tab: bool }

// The keys of this tic as a demo has them (of G_BuildTiccmd): one row
// more for the player to be moved by. So what is played is a demo too.
system read_keys() {
  let run = key_down(340) || key_down(344)
  var forward = 0
  var side = 0
  var turn = 0
  if Keys.up { forward += if run { 50 } else { 25 } }
  if Keys.down { forward -= if run { 50 } else { 25 } }
  if key_down('D' as i32) { side += if run { 40 } else { 24 } }
  if key_down('A' as i32) { side -= if run { 40 } else { 24 } }
  if Keys.left { turn += if run { 1280 } else { 640 } }
  if Keys.right { turn -= if run { 1280 } else { 640 } }
  // (The keys 1 to 7 ask for a weapon: the first of them that is down.)
  var change = 0
  for i in 0..7 {
    if change == 0 && key_down('1' as i32 + i) {
      change = BT_CHANGE | i << BT_WEAPONSHIFT
    }
  }
  Ticcmds += {
    forwardmove: forward, sidemove: side, angleturn: turn,
    // (The left Ctrl key shoots.)
    buttons: (if Keys.space { BT_USE } else { 0 }) |
             (if key_down(341) { BT_ATTACK } else { 0 }) | change
  }
  let tab = key_down(258)
  if tab && !Shown.tab { Shown.map = !Shown.map }
  Shown.tab = tab
}

// The level is seen from the player's eye.
system look() {
  for m: Mobj where m.type == MT_PLAYER {
    Viewpoint.x = m.x
    Viewpoint.y = m.y
    Viewpoint.angle = m.angle
  }
  Viewpoint.z = Pl[0].viewz
  View.extralight = Pl[0].extralight
  View.fixed = fixed_colormap(Powers)
  Shade.palette = screen_palette(Inv, Powers)
  Clock.leveltime += 1
}

// The view smaller or bigger by a step (M_SizeDisplay), by the keys -
// and =, while neither the menu nor the map is shown: from a small one
// in the middle to all of the screen, without the status bar. `less`,
// `more`: whether the keys were down the tic before; `changed`: the
// view is of another size now.
unique Size { less: bool, more: bool, changed: bool }
system size_keys() {
  let less = key_down('-' as i32)
  let more = key_down('=' as i32)
  Size.changed = false
  if !Shown.map && Menu.which == MENU_NONE {
    let smaller = less && !Size.less
    let bigger = more && !Size.more
    if smaller && View.blocks > 3 {
      View.blocks -= 1
      Size.changed = true
    } else if bigger && View.blocks < 11 {
      View.blocks += 1
      Size.changed = true
    }
    if smaller || bigger {
      Rnd = [{ play: Random.play, other: Random.other }; 1]
      sound(Sounds, Rnd, SFX_STNMOV, 0)
      Random.other = Rnd[0].other
    }
  }
  Size.less = less
  Size.more = more
  if Size.changed { Border.count = 3 }
}
// (With all of the screen for the view there is no status bar, but
// under the map.)
unique Bar: bool
system whether_bar() { Bar = View.blocks != 11 || Shown.map }

schedule setup() {
  load_wad()
  load_palette()
  init_data()
  init_specials()
  init_sprites()
  init_status()
  init_messages()
  init_audio()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  start_messages()
  start_screen()
  fit_automap()
  set_view_size()
  init_view_tables()
}

// In the colours as they are.
system plain() { Shade.palette = 0 }

// What every tic begins with: the keys and the menu; the next of the
// round of title, demos and pictures; a new game or a demo started.
schedule shell() {
  begin()
  begin_sounds()
  menu_keys()
  size_keys()
  set_view_size() run_if Size.changed
  init_view_tables() run_if Size.changed
  turn_page() run_if Shell.turn
  read_demo() run_if Shell.wanted
  enter_game() run_if Shell.start || Shell.wanted
  leave_level() run_if Shell.fresh
  quiet() run_if Shell.fresh
  load_level() run_if Shell.fresh
  spawn_things() run_if Shell.fresh
  spawn_specials() run_if Shell.fresh
  start_player(true) run_if Shell.fresh
  start_weapon() run_if Shell.fresh
  start_status() run_if Shell.fresh
  start_messages() run_if Shell.fresh
  fit_automap() run_if Shell.fresh
  arrive() run_if Shell.fresh
  border_anew() run_if Shell.fresh
  melt_anew() run_if Shell.fresh
  entered() run_if Shell.fresh
}

// A picture of the round, and the menu over it.
schedule page() run_if !Shell.game && !Shell.demo {
  page_tick()
  hear()
  plain()
  melt_from(MELT_PAGE)
  clear_screen()
  draw_page()
  draw_menu()
  melt_to()
  show_screen()
  present()
}

// A tic of a level: the player's game by the keys, a demo by its own.
// The player's own game stands still while the menu is open: it is
// drawn as it is, with the menu over it.
schedule held() run_if Shell.game && Menu.which != MENU_NONE && !Wi.on && !Fin.on {
  hear()
  whether_bar()
  clear_screen()
  draw_border() run_if !Shown.map
  render_view() run_if !Shown.map
  draw_walls() run_if !Shown.map
  draw_planes() run_if !Shown.map
  draw_masked() run_if !Shown.map
  draw_weapon() run_if !Shown.map
  draw_status() run_if Bar
  draw_messages()
  draw_border_over() run_if !Shown.map
  draw_automap() run_if Shown.map
  draw_menu()
  show_screen()
  present()
}

schedule frame() run_if (Shell.game || Shell.demo) && !Wi.on && !Fin.on &&
                        !(Shell.game && Menu.which != MENU_NONE) {
  read_keys() run_if Shell.game
  think_player()
  player_sector()
  use_lines()
  trigger_lines()
  think_weapon()
  think_things(false)
  run_lights()
  think_things(true)
  run_movers()
  update_specials()
  update_buttons()
  hear()
  tick_status()
  tick_messages()
  look()
  whether_bar()
  melt_from(MELT_LEVEL)
  clear_screen()
  draw_border() run_if !Shown.map
  render_view() run_if !Shown.map
  draw_walls() run_if !Shown.map
  draw_planes() run_if !Shown.map
  draw_masked() run_if !Shown.map
  draw_weapon() run_if !Shown.map
  draw_status() run_if Bar
  draw_messages()
  draw_border_over() run_if !Shown.map
  draw_automap() run_if Shown.map
  draw_menu()
  melt_to()
  show_screen()
  present()
  complete_level()
  demo_end()
}

// After the last level: the text, and then the picture, for as long as
// the window is open.
schedule ending() run_if (Shell.game || Shell.demo) && Fin.on {
  read_keys() run_if Shell.game
  tick_finale()
  hear()
  plain()
  melt_from(MELT_FINALE)
  clear_screen()
  draw_finale()
  draw_menu()
  melt_to()
  show_screen()
  present()
}
// Between two levels: what was done in the one is counted up, and the
// way to the other shown, in the colours as they are.
schedule between() run_if (Shell.game || Shell.demo) && Wi.on {
  read_keys() run_if Shell.game
  tick_between()
  hear()
  plain()
  melt_from(MELT_BETWEEN)
  clear_screen()
  draw_between()
  draw_menu()
  melt_to()
  show_screen()
  present()
}
schedule onward() run_if Wi.over {
  leave_level()
  leave_between()
  quiet()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(false)
  start_weapon()
  start_status()
  start_messages()
  fit_automap()
  arrive()
  border_anew()
}

// The same level again after the player's death.
schedule again() run_if Level.reborn {
  leave_level()
  quiet()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  start_messages()
  fit_automap()
  arrive()
  melt_anew()
}

// One kind of screen melts into another: nothing else goes on while it
// does, and the menu is over it if it is open.
schedule melting() run_if Melt.on {
  begin()
  begin_sounds()
  melt_step()
  hear()
  draw_menu()
  show_screen()
  present()
}

main {
  setup()
  loop {
    loop { melting() } until !Melt.on || Window.closed
    shell()
    ending()
    onward()
    between()
    held()
    frame()
    again()
    page()
  } until Window.closed || Shell.quit
}

// Doom in ent-lang, as far as it is: reads the WAD and shows a level as
// it is seen from where the player starts, with the things in it;
// Tab shows the map instead. Until there is a player, the arrow keys
// turn the eye and move it, through walls too. Start it where
// `doom1.wad` is (examples/doom/reference/fetch.sh puts the shareware one
// in build/doom/wad):
//
//   cd build/doom/wad && ../../../tools/ent run -I ../../../examples/doom \
//       ../../../examples/doom/doom.ent
import window
import files
import wad
import data
import level
import video
import automap
import fixed
import tables
import angles
import render
import info
import things
import sprites

// As many bytes as the biggest WAD.
capacity Bytes 16777216

world {
  Window.width = 960
  Window.height = 600
  Window.title = "DOOM"
  Window.fps = 35
  Wad.file = "doom1.wad"
  Level.episode = 1
  Level.map = 1
  Level.skill = 2
}

// Whether the map is shown, and whether Tab was down the frame before.
unique Shown { map: bool, tab: bool }

// The eye, moved by the keys: not the player yet, and nothing stops it.
system fly() {
  if Keys.left { Viewpoint.angle += ANG45 / 16 }
  if Keys.right { Viewpoint.angle -= ANG45 / 16 }
  let fine = (Viewpoint.angle >> ANGLETOFINESHIFT) as i32
  if Keys.up {
    Viewpoint.x += finecosine(fine) * 12
    Viewpoint.y += finesine[fine] * 12
  }
  if Keys.down {
    Viewpoint.x -= finecosine(fine) * 12
    Viewpoint.y -= finesine[fine] * 12
  }
  // (Its height follows the floor it is over.)
  let sector = Subsectors[point_in_subsector(Nodes, Viewpoint.x, Viewpoint.y)].sector
  Viewpoint.z = Sectors[sector].floorheight + 41 * FRACUNIT
  let tab = key_down(258)
  if tab && !Shown.tab { Shown.map = !Shown.map }
  Shown.tab = tab
}

schedule setup() {
  load_wad()
  load_palette()
  init_data()
  init_sprites()
  load_level()
  spawn_things()
  fit_automap()
  set_view_size()
  init_view_tables()
  start_viewpoint()
}

schedule frame() {
  begin()
  fly()
  clear_screen()
  render_view() run_if !Shown.map
  draw_walls() run_if !Shown.map
  draw_planes() run_if !Shown.map
  draw_masked() run_if !Shown.map
  draw_automap() run_if Shown.map
  show_screen()
  present()
}

main {
  setup()
  loop { frame() } until Window.closed
}

// Doom in ent-lang, as far as it is: reads the WAD, shows the title and
// the demos, and plays the episode from the menu: the arrow keys walk
// and turn (A and D step aside, Shift runs), Space opens doors and works
// switches, the left Ctrl key shoots, 1 to 7 choose a weapon, Tab shows
// the map, - and = make the view smaller and bigger; the mouse turns
// and walks, its left button shoots, the right one held steps aside;
// Esc is the menu
// (F1 to F10 as in the game: F2 saves, F3 loads, F4 how loud, F5 the
// detail, F6 and F9 save and load in a hurry, F7 ends the game, F8 the
// messages, F10 leaves).
// Start it where `doom1.wad` is
// (examples/doom/reference/fetch.sh puts the shareware one in
// build/doom/wad):
//
//   cd build/doom/wad && ../../../tools/ent run -I ../../../examples/doom \
//       ../../../examples/doom/doom.ent
import window
import files
import wad
import data
import level
import video
import automap
import fixed
import tables
import angles
import render
import info
import things
import sprites
import random
import demo
import specials
import items
import play
import enemy
import weapon
import movers
import tick
import sounds
import audio
import music
import chip
import screen
import between
import shell
import melt
import world

// As many bytes as the biggest WAD.
capacity Bytes 16777216

world {
  Window.width = 960
  Window.height = 600
  Window.title = "DOOM"
  Window.fps = 35
  Wad.file = "doom1.wad"
  Level.episode = 1
  Level.map = 1
  Level.skill = 2
  // (The view as big as the game starts with: a little smaller than the
  // screen is wide.)
  View.blocks = 9
}

// The mouse's buttons pressed twice in a row are the use key
// (G_BuildTiccmd's dclick): for the middle button and for the right one,
// whether it was down, how often it went down, and for how many tics it
// has been as it is.
transient unique Clicks {
  down: bool, count: i32, time: i32, down2: bool, count2: i32, time2: i32
}

// The keys and the mouse of this tic as a demo has them (of
// G_BuildTiccmd): the one row for the player to be moved by. So what is
// played is a demo of one tic, made anew each tic: the tics before are
// not kept, and a game can go on as long as it likes.
// The mouse turns the player, and moves it forward and back; with the
// right button (or the left Alt key) held, to the sides, as the arrow
// keys then do too. Its left button shoots, the middle one walks.
system read_keys() {
  let run = key_down(340) || key_down(344)
  let strafe = key_down(342) || Mouse.right
  var forward = 0
  var side = 0
  var turn = 0
  var buttons = 0
  if Keys.up { forward += if run { 50 } else { 25 } }
  if Keys.down { forward -= if run { 50 } else { 25 } }
  if key_down('D' as i32) { side += if run { 40 } else { 24 } }
  if key_down('A' as i32) { side -= if run { 40 } else { 24 } }
  if strafe {
    if Keys.right { side += if run { 40 } else { 24 } }
    if Keys.left { side -= if run { 40 } else { 24 } }
  } else {
    if Keys.left { turn += if run { 1280 } else { 640 } }
    if Keys.right { turn -= if run { 1280 } else { 640 } }
  }
  // (The keys 1 to 7 ask for a weapon: the first of them that is down.)
  var change = 0
  for i in 0..7 {
    if change == 0 && key_down('1' as i32 + i) {
      change = BT_CHANGE | i << BT_WEAPONSHIFT
    }
  }
  // (The left Ctrl key shoots.)
  if key_down(341) || Mouse.left { buttons |= BT_ATTACK }
  if Keys.space {
    buttons |= BT_USE
    Clicks.count = 0
  }
  if Mouse.middle { forward += if run { 50 } else { 25 } }
  if Mouse.middle != Clicks.down && Clicks.time > 1 {
    Clicks.down = Mouse.middle
    if Clicks.down { Clicks.count += 1 }
    if Clicks.count == 2 {
      buttons |= BT_USE
      Clicks.count = 0
    } else {
      Clicks.time = 0
    }
  } else {
    Clicks.time += 1
    if Clicks.time > 20 {
      Clicks.count = 0
      Clicks.down = false
    }
  }
  if Mouse.right != Clicks.down2 && Clicks.time2 > 1 {
    Clicks.down2 = Mouse.right
    if Clicks.down2 { Clicks.count2 += 1 }
    if Clicks.count2 == 2 {
      buttons |= BT_USE
      Clicks.count2 = 0
    } else {
      Clicks.time2 = 0
    }
  } else {
    Clicks.time2 += 1
    if Clicks.time2 > 20 {
      Clicks.count2 = 0
      Clicks.down2 = false
    }
  }
  // (How far the mouse moved, by how fast the menu has it set.)
  let mousex = mouse_step(Mouse.dx) * (Menu.mouse + 5) / 10
  let mousey = (0 - mouse_step(Mouse.dy)) * (Menu.mouse + 5) / 10
  forward += mousey
  if strafe {
    side += mousex * 2
  } else {
    turn -= mousex * 8
  }
  Ticcmds = []
  Demo.tic = 0
  Ticcmds += {
    forwardmove: min(max(forward, -50), 50), sidemove: min(max(side, -50), 50),
    angleturn: turn, buttons: buttons | change
  }
  let tab = key_down(258)
  if tab && !Shown.tab { Shown.map = !Shown.map }
  Shown.tab = tab
}

// The level is seen from the player's eye.
system look() {
  for m: Mobj where m.type == MT_PLAYER {
    Viewpoint.x = m.x
    Viewpoint.y = m.y
    Viewpoint.angle = m.angle
  }
  Viewpoint.z = Pl[0].viewz
  View.extralight = Pl[0].extralight
  View.fixed = fixed_colormap(Powers)
  Shade.palette = screen_palette(Inv, Powers)
  Clock.leveltime += 1
}

// (With all of the screen for the view there is no status bar, but
// under the map.)
transient unique Bar: bool
system whether_bar() { Bar = View.blocks != 11 || Shown.map }

schedule setup() {
  load_wad()
  load_palette()
  init_data()
  init_specials()
  init_sprites()
  init_status()
  init_messages()
  init_audio()
  init_music()
  init_chip()
  init_tunes()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  start_messages()
  start_screen()
  fit_automap()
  set_view_size()
  init_view_tables()
}

// In the colours as they are.
system plain() { Shade.palette = 0 }

// What every tic begins with: the keys and the menu; the next of the
// round of title, demos and pictures; a new game or a demo started.
schedule shell() {
  begin()
  begin_sounds()
  menu_keys()
  // (A game saved or loaded from the menu: the world as it is between
  // two tics.)
  save_world() run_if Slot.save
  saved() run_if Slot.save
  load_world() run_if Slot.load
  loaded() run_if Slot.load
  quiet() run_if Slot.loaded
  melt_anew() run_if Slot.loaded
  border_anew() run_if Slot.loaded
  set_view_size() run_if Shell.resize
  init_view_tables() run_if Shell.resize
  turn_page() run_if Shell.turn
  read_demo() run_if Shell.wanted
  enter_game() run_if Shell.start || Shell.wanted
  leave_level() run_if Shell.fresh
  quiet() run_if Shell.fresh
  load_level() run_if Shell.fresh
  spawn_things() run_if Shell.fresh
  spawn_specials() run_if Shell.fresh
  start_player(true) run_if Shell.fresh
  start_weapon() run_if Shell.fresh
  start_status() run_if Shell.fresh
  start_messages() run_if Shell.fresh
  fit_automap() run_if Shell.fresh
  arrive() run_if Shell.fresh
  border_anew() run_if Shell.fresh
  melt_anew() run_if Shell.fresh
  entered() run_if Shell.fresh
}

// A picture of the round, and the menu over it.
schedule page() run_if !Shell.game && !Shell.demo {
  page_tick()
  hear()
  plain()
  melt_from(MELT_PAGE)
  clear_screen()
  draw_page()
  draw_menu()
  melt_to()
  show_screen()
  present()
}

// A tic of a level: the player's game by the keys, a demo by its own.
// The player's own game stands still while the menu is open: it is
// drawn as it is, with the menu over it. (The face and what the player
// is told go on, as they do in the game.)
schedule held() run_if Shell.game && Menu.on && !Wi.on && !Fin.on {
  tick_status()
  tick_messages()
  hear()
  whether_bar()
  clear_screen()
  draw_border() run_if !Shown.map
  render_view() run_if !Shown.map
  draw_walls() run_if !Shown.map
  draw_planes() run_if !Shown.map
  draw_masked() run_if !Shown.map
  draw_weapon() run_if !Shown.map
  draw_status() run_if Bar
  draw_messages()
  draw_border_over() run_if !Shown.map
  draw_automap() run_if Shown.map
  draw_menu()
  show_screen()
  present()
}

schedule frame() run_if (Shell.game || Shell.demo) && !Wi.on && !Fin.on &&
                        !(Shell.game && Menu.on) {
  read_keys() run_if Shell.game
  think_player()
  player_sector()
  use_lines()
  trigger_lines()
  think_weapon()
  think_things(false)
  run_lights()
  think_things(true)
  run_movers()
  drop_weapon()
  update_specials()
  update_buttons()
  hear()
  tick_status()
  tick_messages()
  look()
  whether_bar()
  melt_from(MELT_LEVEL)
  clear_screen()
  draw_border() run_if !Shown.map
  render_view() run_if !Shown.map
  draw_walls() run_if !Shown.map
  draw_planes() run_if !Shown.map
  draw_masked() run_if !Shown.map
  draw_weapon() run_if !Shown.map
  draw_status() run_if Bar
  draw_messages()
  draw_border_over() run_if !Shown.map
  draw_automap() run_if Shown.map
  draw_menu()
  melt_to()
  show_screen()
  present()
  complete_level()
  demo_end()
}

// After the last level: the text, and then the picture, for as long as
// the window is open.
schedule ending() run_if (Shell.game || Shell.demo) && Fin.on {
  read_keys() run_if Shell.game
  tick_finale()
  hear()
  plain()
  melt_from(MELT_FINALE)
  clear_screen()
  draw_finale()
  draw_menu()
  melt_to()
  show_screen()
  present()
}
// Between two levels: what was done in the one is counted up, and the
// way to the other shown, in the colours as they are.
schedule between() run_if (Shell.game || Shell.demo) && Wi.on {
  read_keys() run_if Shell.game
  tick_between()
  hear()
  plain()
  melt_from(MELT_BETWEEN)
  clear_screen()
  draw_between()
  draw_menu()
  melt_to()
  show_screen()
  present()
}
schedule onward() run_if Wi.over {
  leave_level()
  leave_between()
  quiet()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(false)
  start_weapon()
  start_status()
  start_messages()
  fit_automap()
  arrive()
  border_anew()
}

// The same level again after the player's death.
schedule again() run_if Level.reborn {
  leave_level()
  quiet()
  load_level()
  spawn_things()
  spawn_specials()
  start_player(true)
  start_weapon()
  start_status()
  start_messages()
  fit_automap()
  arrive()
  melt_anew()
}

// One kind of screen melts into another: nothing else goes on while it
// does, and the menu is over it if it is open.
schedule melting() run_if Melt.on {
  begin()
  begin_sounds()
  melt_step()
  hear()
  draw_menu()
  show_screen()
  present()
}

main {
  setup()
  loop {
    loop { melting() } until !Melt.on || Window.closed
    shell()
    ending()
    onward()
    between()
    held()
    frame()
    again()
    page()
  } until Window.closed || Shell.quit
}

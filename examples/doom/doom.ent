// Doom in ent-lang, as far as it is: reads the WAD and plays a level of
// it, without its monsters and without weapons: the arrow keys walk and
// turn (A and D step aside, Shift runs), Space opens doors and works
// switches, Tab shows the map. Start it where `doom1.wad` is
// (examples/doom/reference/fetch.sh puts the shareware one in
// build/doom/wad):
//
//   cd build/doom/wad && ../../../tools/ent run -I ../../../examples/doom \
//       ../../../examples/doom/doom.ent
import window
import files
import wad
import data
import level
import video
import automap
import fixed
import tables
import angles
import render
import info
import things
import sprites
import random
import demo
import specials
import items
import play
import enemy
import weapon
import movers

// As many bytes as the biggest WAD.
capacity Bytes 16777216

world {
  Window.width = 960
  Window.height = 600
  Window.title = "DOOM"
  Window.fps = 35
  Wad.file = "doom1.wad"
  Level.episode = 1
  Level.map = 1
  Level.skill = 2
  Level.nomonsters = true
}

// Whether the map is shown, and whether Tab was down the frame before.
unique Shown { map: bool, tab: bool }

// The keys of this tic as a demo has them (of G_BuildTiccmd): one row
// more for the player to be moved by. So what is played is a demo too.
system read_keys() {
  let run = key_down(340) || key_down(344)
  var forward = 0
  var side = 0
  var turn = 0
  if Keys.up { forward += if run { 50 } else { 25 } }
  if Keys.down { forward -= if run { 50 } else { 25 } }
  if key_down('D' as i32) { side += if run { 40 } else { 24 } }
  if key_down('A' as i32) { side -= if run { 40 } else { 24 } }
  if Keys.left { turn += if run { 1280 } else { 640 } }
  if Keys.right { turn -= if run { 1280 } else { 640 } }
  Ticcmds += {
    forwardmove: forward, sidemove: side, angleturn: turn,
    // (The left Ctrl key shoots.)
    buttons: (if Keys.space { BT_USE } else { 0 }) |
             (if key_down(341) { BT_ATTACK } else { 0 })
  }
  let tab = key_down(258)
  if tab && !Shown.tab { Shown.map = !Shown.map }
  Shown.tab = tab
}

// The level is seen from the player's eye.
system look() {
  for m: Mobj where m.type == MT_PLAYER {
    Viewpoint.x = m.x
    Viewpoint.y = m.y
    Viewpoint.angle = m.angle
  }
  Viewpoint.z = Pl[0].viewz
  Clock.leveltime += 1
}

schedule setup() {
  load_wad()
  load_palette()
  init_data()
  init_sprites()
  load_level()
  spawn_things()
  spawn_specials()
  start_player()
  start_weapon()
  fit_automap()
  set_view_size()
  init_view_tables()
}

schedule frame() {
  begin()
  read_keys()
  think_player()
  player_sector()
  use_lines()
  trigger_lines()
  think_weapon()
  think_things(false)
  run_lights()
  think_things(true)
  trigger_lines()
  run_movers()
  look()
  clear_screen()
  render_view() run_if !Shown.map
  draw_walls() run_if !Shown.map
  draw_planes() run_if !Shown.map
  draw_masked() run_if !Shown.map
  draw_automap() run_if Shown.map
  show_screen()
  present()
}

main {
  setup()
  loop { frame() } until Window.closed
}

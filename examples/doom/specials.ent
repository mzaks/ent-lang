//
// What is special about sectors and lines (p_spec.c, p_lights.c): lights
// that flicker and glow, so far.
//
// What a sector does over time is a row of a buffer, not an entity: the
// rows are gone through one after another in the order they were made,
// and each may draw a random number, which the next one's then follows.
import fixed
import random
import level

// A light of a sector that changes: which kind it is, its sector, the
// tics until it changes next, and what it changes between.
buffer Lights {
  kind: i32, sector: i32, count: i32, maxlight: i32, minlight: i32,
  maxtime: i32, mintime: i32, darktime: i32, brighttime: i32, direction: i32
} capacity 4096
const LIGHT_FIRE = 0
const LIGHT_FLASH = 1
const LIGHT_STROBE = 2
const LIGHT_GLOW = 3

// What moves a sector's floor or ceiling (a door, a lift, a floor, a
// ceiling), one row for each that is at it, in the order they started:
// what kind it is and of which sort, its sector, which way it goes and
// how fast, the heights it goes between, how long it waits and has
// waited, and whether it crushes. One that is done is no longer
// `active`, and its row stays.
buffer Movers {
  kind: i32, active: bool, sector: i32, type: i32, direction: i32,
  speed: i32, high: i32, low: i32, wait: i32, count: i32, crush: bool,
  status: i32, oldstatus: i32, tag: i32, born: i32, ran: i32
} capacity 4096
const MOVER_DOOR = 0
const MOVER_PLAT = 1
// (A floor that goes to a height and stays: `high` is the height,
// `low` the flat and `wait` what is special of the sector when it is
// there, for the sort that changes them.)
const MOVER_FLOOR = 2

// The sorts of lifts (plattype_e), and what one is doing (plat_e).
const PLAT_PERPETUALRAISE = 0
const PLAT_DOWNWAITUPSTAY = 1
const PLAT_RAISEANDCHANGE = 2
const PLAT_RAISETONEARESTANDCHANGE = 3
const PLAT_BLAZEDWUS = 4
const PLAT_UP = 0
const PLAT_DOWN = 1
const PLAT_WAITING = 2
const PLAT_IN_STASIS = 3
const PLATWAIT = 3
const PLATSPEED = FRACUNIT

// The sorts of doors (vldoor_e).
const VLD_NORMAL = 0
const VLD_CLOSE30THENOPEN = 1
const VLD_CLOSE = 2
const VLD_OPEN = 3
const VLD_RAISEIN5MINS = 4
const VLD_BLAZERAISE = 5
const VLD_BLAZEOPEN = 6
const VLD_BLAZECLOSE = 7
const VDOORSPEED = FRACUNIT * 2
const VDOORWAIT = 150

const GLOWSPEED = 8
const STROBEBRIGHT = 5
const FASTDARK = 15
const SLOWDARK = 35

// How many secrets the level has.
unique Secrets: i32

// The least light of the sectors next to a sector, if less than `most`
// (P_FindMinSurroundingLight).
fn min_surrounding_light(lines: Lines, sectors: Sectors, sector: i32,
                         most: i32) -> i32 {
  var least = most
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      if lines[i].frontsector == sector {
        least min= sectors[lines[i].backsector].lightlevel
      } else if lines[i].backsector == sector {
        least min= sectors[lines[i].frontsector].lightlevel
      }
    }
  }
  least
}

// The lowest ceiling of the sectors next to a sector
// (P_FindLowestCeilingSurrounding).
fn lowest_ceiling_surrounding(lines: Lines, sectors: Sectors,
                              sector: i32) -> i32 {
  var height = 0x7fffffff
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      if lines[i].frontsector == sector {
        height min= sectors[lines[i].backsector].ceilingheight
      } else if lines[i].backsector == sector {
        height min= sectors[lines[i].frontsector].ceilingheight
      }
    }
  }
  height
}

// The lowest and the highest floor of a sector and those next to it
// (P_FindLowestFloorSurrounding; P_FindHighestFloorSurrounding, which
// starts 500 below nought), and the lowest floor next to it that is
// higher than a height, that height if there is none
// (P_FindNextHighestFloor).
fn lowest_floor_surrounding(lines: Lines, sectors: Sectors, sector: i32) -> i32 {
  var floor = sectors[sector].floorheight
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      if lines[i].frontsector == sector {
        floor min= sectors[lines[i].backsector].floorheight
      } else if lines[i].backsector == sector {
        floor min= sectors[lines[i].frontsector].floorheight
      }
    }
  }
  floor
}
fn highest_floor_surrounding(lines: Lines, sectors: Sectors, sector: i32) -> i32 {
  var floor = -500 * FRACUNIT
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      if lines[i].frontsector == sector {
        floor max= sectors[lines[i].backsector].floorheight
      } else if lines[i].backsector == sector {
        floor max= sectors[lines[i].frontsector].floorheight
      }
    }
  }
  floor
}
fn next_highest_floor(lines: Lines, sectors: Sectors, sector: i32,
                      height: i32) -> i32 {
  var least = 0x7fffffff
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      let other = if lines[i].frontsector == sector {
        lines[i].backsector
      } else if lines[i].backsector == sector {
        lines[i].frontsector
      } else {
        -1
      }
      if other >= 0 && sectors[other].floorheight > height {
        least min= sectors[other].floorheight
      }
    }
  }
  if least == 0x7fffffff { height } else { least }
}

// The next sector after `start` with a tag, or -1
// (P_FindSectorFromLineTag).
fn sector_from_tag(sectors: Sectors, tag: i32, start: i32) -> i32 {
  var found = -1
  for i in 0..len(sectors) {
    if found < 0 && i > start && sectors[i].tag == tag { found = i }
  }
  found
}

// Starts what the level's sectors do by themselves (P_SpawnSpecials).
// After `spawn_things`: the random numbers go on from there.
system spawn_specials() {
  Lights = []
  Movers = []
  Secrets = 0
  for i in 0..len(Sectors) {
    let special = Sectors[i].special
    let light = Sectors[i].lightlevel
    let least = min_surrounding_light(Lines, Sectors, i, light)
    if special == 1 {
      // Flashes at random.
      Random.play = random_after(Random.play)
      Lights += {
        kind: LIGHT_FLASH, sector: i, count: (random_at(Random.play) & 64) + 1,
        maxlight: light, minlight: least, maxtime: 64, mintime: 7,
        darktime: 0, brighttime: 0, direction: 0
      }
      Sectors[i].special = 0
    } else if special == 2 || special == 3 || special == 4 || special == 12 ||
              special == 13 {
      // Blinks, fast or slow, in step with the others or not.
      let sync = special == 12 || special == 13
      var count = 1
      if !sync {
        Random.play = random_after(Random.play)
        count = (random_at(Random.play) & 7) + 1
      }
      Lights += {
        kind: LIGHT_STROBE, sector: i, count: count, maxlight: light,
        minlight: if least == light { 0 } else { least }, maxtime: 0,
        mintime: 0,
        darktime: if special == 3 || special == 12 { SLOWDARK } else { FASTDARK },
        brighttime: STROBEBRIGHT, direction: 0
      }
      // (One that also hurts stays what it is.)
      Sectors[i].special = if special == 4 { 4 } else { 0 }
    } else if special == 8 {
      Lights += {
        kind: LIGHT_GLOW, sector: i, count: 0, maxlight: light,
        minlight: least, maxtime: 0, mintime: 0, darktime: 0, brighttime: 0,
        direction: -1
      }
      Sectors[i].special = 0
    } else if special == 9 {
      Secrets += 1
    } else if special == 10 {
      // A door that shuts after thirty seconds.
      Movers += {
        kind: MOVER_DOOR, active: true, sector: i, type: VLD_NORMAL,
        direction: 0, speed: VDOORSPEED, high: 0, low: 0, wait: 0,
        count: 30 * 35, crush: false, status: 0, oldstatus: 0, tag: 0, born: 1,
        ran: -1
      }
      Sectors[i].special = 0
      Sectors[i].specialdata = len(Movers)
    } else if special == 14 {
      // A door that opens after five minutes.
      Movers += {
        kind: MOVER_DOOR, active: true, sector: i, type: VLD_RAISEIN5MINS,
        direction: 2, speed: VDOORSPEED,
        high: lowest_ceiling_surrounding(Lines, Sectors, i) - 4 * FRACUNIT,
        low: 0, wait: VDOORWAIT, count: 5 * 60 * 35, crush: false, status: 0,
        oldstatus: 0, tag: 0, born: 1,
        ran: -1
      }
      Sectors[i].special = 0
      Sectors[i].specialdata = len(Movers)
    } else if special == 17 {
      Lights += {
        kind: LIGHT_FIRE, sector: i, count: 4, maxlight: light,
        minlight: least + 16, maxtime: 0, mintime: 0, darktime: 0,
        brighttime: 0, direction: 0
      }
      Sectors[i].special = 0
    }
  }
}

// A tic of the lights (T_FireFlicker, T_LightFlash, T_StrobeFlash,
// T_Glow), each in its turn.
system run_lights() {
  for i in 0..len(Lights) {
    let sector = Lights[i].sector
    let kind = Lights[i].kind
    if kind == LIGHT_GLOW {
      if Lights[i].direction == -1 {
        Sectors[sector].lightlevel -= GLOWSPEED
        if Sectors[sector].lightlevel <= Lights[i].minlight {
          Sectors[sector].lightlevel += GLOWSPEED
          Lights[i].direction = 1
        }
      } else {
        Sectors[sector].lightlevel += GLOWSPEED
        if Sectors[sector].lightlevel >= Lights[i].maxlight {
          Sectors[sector].lightlevel -= GLOWSPEED
          Lights[i].direction = -1
        }
      }
    } else {
      Lights[i].count -= 1
      if Lights[i].count == 0 {
        if kind == LIGHT_FIRE {
          Random.play = random_after(Random.play)
          let amount = (random_at(Random.play) & 3) * 16
          Sectors[sector].lightlevel =
              if Sectors[sector].lightlevel - amount < Lights[i].minlight {
                Lights[i].minlight
              } else {
                Lights[i].maxlight - amount
              }
          Lights[i].count = 4
        } else if kind == LIGHT_FLASH {
          Random.play = random_after(Random.play)
          if Sectors[sector].lightlevel == Lights[i].maxlight {
            Sectors[sector].lightlevel = Lights[i].minlight
            Lights[i].count = (random_at(Random.play) & Lights[i].mintime) + 1
          } else {
            Sectors[sector].lightlevel = Lights[i].maxlight
            Lights[i].count = (random_at(Random.play) & Lights[i].maxtime) + 1
          }
        } else {
          if Sectors[sector].lightlevel == Lights[i].minlight {
            Sectors[sector].lightlevel = Lights[i].maxlight
            Lights[i].count = Lights[i].brighttime
          } else {
            Sectors[sector].lightlevel = Lights[i].minlight
            Lights[i].count = Lights[i].darktime
          }
        }
      }
    }
  }
}

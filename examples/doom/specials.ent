//
// What is special about sectors and lines (p_spec.c, p_lights.c): lights
// that flicker and glow, so far.
//
// What a sector does over time is a row of a buffer, not an entity: the
// rows are gone through one after another in the order they were made,
// and each may draw a random number, which the next one's then follows.
import fixed
import random
import level
import wad
import data

// A light of a sector that changes: which kind it is, its sector, the
// tics until it changes next, and what it changes between.
buffer Lights {
  kind: i32, sector: i32, count: i32, maxlight: i32, minlight: i32,
  maxtime: i32, mintime: i32, darktime: i32, brighttime: i32, direction: i32
} capacity 4096
const LIGHT_FIRE = 0
const LIGHT_FLASH = 1
const LIGHT_STROBE = 2
const LIGHT_GLOW = 3

// What moves a sector's floor or ceiling (a door, a lift, a floor, a
// ceiling), one row for each that is at it, in the order they started:
// what kind it is and of which sort, its sector, which way it goes and
// how fast, the heights it goes between, how long it waits and has
// waited, and whether it crushes. One that is done is no longer
// `active`, and its row stays.
buffer Movers {
  kind: i32, active: bool, sector: i32, type: i32, direction: i32,
  speed: i32, high: i32, low: i32, wait: i32, count: i32, crush: bool,
  status: i32, oldstatus: i32, tag: i32, born: i32, ran: i32
} capacity 4096
const MOVER_DOOR = 0
const MOVER_PLAT = 1
// (A floor that goes to a height and stays: `high` is the height,
// `low` the flat and `wait` what is special of the sector when it is
// there, for the sort that changes them.)
const MOVER_FLOOR = 2
// (A ceiling: `high` and `low` are the heights it goes between, and
// `oldstatus` the way it went before it was made to stand still.)
const MOVER_CEILING = 3

// The sorts of lifts (plattype_e), and what one is doing (plat_e).
const PLAT_PERPETUALRAISE = 0
const PLAT_DOWNWAITUPSTAY = 1
const PLAT_RAISEANDCHANGE = 2
const PLAT_RAISETONEARESTANDCHANGE = 3
const PLAT_BLAZEDWUS = 4
const PLAT_UP = 0
const PLAT_DOWN = 1
const PLAT_WAITING = 2
const PLAT_IN_STASIS = 3
const PLATWAIT = 3
const PLATSPEED = FRACUNIT

// The sorts of doors (vldoor_e).
const VLD_NORMAL = 0
const VLD_CLOSE30THENOPEN = 1
const VLD_CLOSE = 2
const VLD_OPEN = 3
const VLD_RAISEIN5MINS = 4
const VLD_BLAZERAISE = 5
const VLD_BLAZEOPEN = 6
const VLD_BLAZECLOSE = 7
const VDOORSPEED = FRACUNIT * 2
const VDOORWAIT = 150

const GLOWSPEED = 8
const STROBEBRIGHT = 5
const FASTDARK = 15
const SLOWDARK = 35

// How many secrets the level has.
unique Secrets: i32

// The least light of the sectors next to a sector, if less than `most`
// (P_FindMinSurroundingLight).
fn min_surrounding_light(lines: Lines, sectors: Sectors, sector: i32,
                         most: i32) -> i32 {
  var least = most
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      if lines[i].frontsector == sector {
        least min= sectors[lines[i].backsector].lightlevel
      } else if lines[i].backsector == sector {
        least min= sectors[lines[i].frontsector].lightlevel
      }
    }
  }
  least
}

// The lowest ceiling of the sectors next to a sector
// (P_FindLowestCeilingSurrounding).
fn lowest_ceiling_surrounding(lines: Lines, sectors: Sectors,
                              sector: i32) -> i32 {
  var height = 0x7fffffff
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      if lines[i].frontsector == sector {
        height min= sectors[lines[i].backsector].ceilingheight
      } else if lines[i].backsector == sector {
        height min= sectors[lines[i].frontsector].ceilingheight
      }
    }
  }
  height
}

// The lowest and the highest floor of a sector and those next to it
// (P_FindLowestFloorSurrounding; P_FindHighestFloorSurrounding, which
// starts 500 below nought), and the lowest floor next to it that is
// higher than a height, that height if there is none
// (P_FindNextHighestFloor).
fn lowest_floor_surrounding(lines: Lines, sectors: Sectors, sector: i32) -> i32 {
  var floor = sectors[sector].floorheight
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      if lines[i].frontsector == sector {
        floor min= sectors[lines[i].backsector].floorheight
      } else if lines[i].backsector == sector {
        floor min= sectors[lines[i].frontsector].floorheight
      }
    }
  }
  floor
}
fn highest_floor_surrounding(lines: Lines, sectors: Sectors, sector: i32) -> i32 {
  var floor = -500 * FRACUNIT
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      if lines[i].frontsector == sector {
        floor max= sectors[lines[i].backsector].floorheight
      } else if lines[i].backsector == sector {
        floor max= sectors[lines[i].frontsector].floorheight
      }
    }
  }
  floor
}
fn next_highest_floor(lines: Lines, sectors: Sectors, sector: i32,
                      height: i32) -> i32 {
  var least = 0x7fffffff
  for i in 0..len(lines) {
    if lines[i].flags & ML_TWOSIDED != 0 {
      let other = if lines[i].frontsector == sector {
        lines[i].backsector
      } else if lines[i].backsector == sector {
        lines[i].frontsector
      } else {
        -1
      }
      if other >= 0 && sectors[other].floorheight > height {
        least min= sectors[other].floorheight
      }
    }
  }
  if least == 0x7fffffff { height } else { least }
}

// The next sector after `start` with a tag, or -1
// (P_FindSectorFromLineTag).
fn sector_from_tag(sectors: Sectors, tag: i32, start: i32) -> i32 {
  var found = -1
  for i in 0..len(sectors) {
    if found < 0 && i > start && sectors[i].tag == tag { found = i }
  }
  found
}

// A switch that goes back after a second: the line, which of its
// textures (0 the top, 1 the middle, 2 the bottom), the texture it had,
// and how long still.
buffer Buttons { line: i32, where: i32, texture: i32, timer: i32 } capacity 16
const BUTTONTIME = 35
// The sides whose texture slides along (the lines with the special 48).
buffer Scrollers { side: i32 } capacity 64

// Starts what the level's sectors do by themselves (P_SpawnSpecials).
// After `spawn_things`: the random numbers go on from there.
system spawn_specials() {
  Lights = []
  Movers = []
  Buttons = [{ line: 0, where: 0, texture: 0, timer: 0 }; 16]
  Scrollers = []
  for i in 0..len(Lines) {
    if Lines[i].special == 48 && len(Scrollers) < 64 {
      Scrollers += { side: Lines[i].front }
    }
  }
  Secrets = 0
  for i in 0..len(Sectors) {
    let special = Sectors[i].special
    let light = Sectors[i].lightlevel
    let least = min_surrounding_light(Lines, Sectors, i, light)
    if special == 1 {
      // Flashes at random.
      Random.play = random_after(Random.play)
      Lights += {
        kind: LIGHT_FLASH, sector: i, count: (random_at(Random.play) & 64) + 1,
        maxlight: light, minlight: least, maxtime: 64, mintime: 7,
        darktime: 0, brighttime: 0, direction: 0
      }
      Sectors[i].special = 0
    } else if special == 2 || special == 3 || special == 4 || special == 12 ||
              special == 13 {
      // Blinks, fast or slow, in step with the others or not.
      let sync = special == 12 || special == 13
      var count = 1
      if !sync {
        Random.play = random_after(Random.play)
        count = (random_at(Random.play) & 7) + 1
      }
      Lights += {
        kind: LIGHT_STROBE, sector: i, count: count, maxlight: light,
        minlight: if least == light { 0 } else { least }, maxtime: 0,
        mintime: 0,
        darktime: if special == 3 || special == 12 { SLOWDARK } else { FASTDARK },
        brighttime: STROBEBRIGHT, direction: 0
      }
      // (One that also hurts stays what it is.)
      Sectors[i].special = if special == 4 { 4 } else { 0 }
    } else if special == 8 {
      Lights += {
        kind: LIGHT_GLOW, sector: i, count: 0, maxlight: light,
        minlight: least, maxtime: 0, mintime: 0, darktime: 0, brighttime: 0,
        direction: -1
      }
      Sectors[i].special = 0
    } else if special == 9 {
      Secrets += 1
    } else if special == 10 {
      // A door that shuts after thirty seconds.
      Movers += {
        kind: MOVER_DOOR, active: true, sector: i, type: VLD_NORMAL,
        direction: 0, speed: VDOORSPEED, high: 0, low: 0, wait: 0,
        count: 30 * 35, crush: false, status: 0, oldstatus: 0, tag: 0, born: 1,
        ran: -1
      }
      Sectors[i].special = 0
      Sectors[i].specialdata = len(Movers)
    } else if special == 14 {
      // A door that opens after five minutes.
      Movers += {
        kind: MOVER_DOOR, active: true, sector: i, type: VLD_RAISEIN5MINS,
        direction: 2, speed: VDOORSPEED,
        high: lowest_ceiling_surrounding(Lines, Sectors, i) - 4 * FRACUNIT,
        low: 0, wait: VDOORWAIT, count: 5 * 60 * 35, crush: false, status: 0,
        oldstatus: 0, tag: 0, born: 1,
        ran: -1
      }
      Sectors[i].special = 0
      Sectors[i].specialdata = len(Movers)
    } else if special == 17 {
      Lights += {
        kind: LIGHT_FIRE, sector: i, count: 4, maxlight: light,
        minlight: least + 16, maxtime: 0, mintime: 0, darktime: 0,
        brighttime: 0, direction: 0
      }
      Sectors[i].special = 0
    }
  }
}

// A tic of the lights (T_FireFlicker, T_LightFlash, T_StrobeFlash,
// T_Glow), each in its turn.
system run_lights() {
  for i in 0..len(Lights) {
    let sector = Lights[i].sector
    let kind = Lights[i].kind
    if kind == LIGHT_GLOW {
      if Lights[i].direction == -1 {
        Sectors[sector].lightlevel -= GLOWSPEED
        if Sectors[sector].lightlevel <= Lights[i].minlight {
          Sectors[sector].lightlevel += GLOWSPEED
          Lights[i].direction = 1
        }
      } else {
        Sectors[sector].lightlevel += GLOWSPEED
        if Sectors[sector].lightlevel >= Lights[i].maxlight {
          Sectors[sector].lightlevel -= GLOWSPEED
          Lights[i].direction = -1
        }
      }
    } else {
      Lights[i].count -= 1
      if Lights[i].count == 0 {
        if kind == LIGHT_FIRE {
          Random.play = random_after(Random.play)
          let amount = (random_at(Random.play) & 3) * 16
          Sectors[sector].lightlevel =
              if Sectors[sector].lightlevel - amount < Lights[i].minlight {
                Lights[i].minlight
              } else {
                Lights[i].maxlight - amount
              }
          Lights[i].count = 4
        } else if kind == LIGHT_FLASH {
          Random.play = random_after(Random.play)
          if Sectors[sector].lightlevel == Lights[i].maxlight {
            Sectors[sector].lightlevel = Lights[i].minlight
            Lights[i].count = (random_at(Random.play) & Lights[i].mintime) + 1
          } else {
            Sectors[sector].lightlevel = Lights[i].maxlight
            Lights[i].count = (random_at(Random.play) & Lights[i].maxtime) + 1
          }
        } else {
          if Sectors[sector].lightlevel == Lights[i].minlight {
            Sectors[sector].lightlevel = Lights[i].maxlight
            Lights[i].count = Lights[i].brighttime
          } else {
            Sectors[sector].lightlevel = Lights[i].minlight
            Lights[i].count = Lights[i].darktime
          }
        }
      }
    }
  }
}

// The rows of pictures that move: the last and the first of each, a
// flat's or a texture's (animdefs; those of the other episodes are not
// in this WAD and are left out where they are looked for).
table animdefs { texture: bool, last: text[8], first: text[8] } = [
  { texture: false, last: "NUKAGE3", first: "NUKAGE1" },
  { texture: false, last: "FWATER4", first: "FWATER1" },
  { texture: false, last: "SWATER4", first: "SWATER1" },
  { texture: false, last: "LAVA4", first: "LAVA1" },
  { texture: false, last: "BLOOD3", first: "BLOOD1" },
  { texture: false, last: "RROCK08", first: "RROCK05" },
  { texture: false, last: "SLIME04", first: "SLIME01" },
  { texture: false, last: "SLIME08", first: "SLIME05" },
  { texture: false, last: "SLIME12", first: "SLIME09" },
  { texture: true, last: "BLODGR4", first: "BLODGR1" },
  { texture: true, last: "SLADRIP3", first: "SLADRIP1" },
  { texture: true, last: "BLODRIP4", first: "BLODRIP1" },
  { texture: true, last: "FIREWALL", first: "FIREWALA" },
  { texture: true, last: "GSTFONT3", first: "GSTFONT1" },
  { texture: true, last: "FIRELAVA", first: "FIRELAV3" },
  { texture: true, last: "FIREMAG3", first: "FIREMAG1" },
  { texture: true, last: "FIREBLU2", first: "FIREBLU1" },
  { texture: true, last: "ROCKRED3", first: "ROCKRED1" },
  { texture: true, last: "BFALL4", first: "BFALL1" },
  { texture: true, last: "SFALL4", first: "SFALL1" },
  { texture: true, last: "WFALL4", first: "WFALL1" },
  { texture: true, last: "DBRAIN4", first: "DBRAIN1" }
]
buffer Anims { texture: bool, basepic: i32, numpics: i32 } capacity 32

// The textures of switches, off and on (alphSwitchList, the first
// episode's), and by their numbers, each next to its other.
table switchnames { off: text[8], on: text[8] } = [
  { off: "SW1BRCOM", on: "SW2BRCOM" }, { off: "SW1BRN1", on: "SW2BRN1" },
  { off: "SW1BRN2", on: "SW2BRN2" }, { off: "SW1BRNGN", on: "SW2BRNGN" },
  { off: "SW1BROWN", on: "SW2BROWN" }, { off: "SW1COMM", on: "SW2COMM" },
  { off: "SW1COMP", on: "SW2COMP" }, { off: "SW1DIRT", on: "SW2DIRT" },
  { off: "SW1EXIT", on: "SW2EXIT" }, { off: "SW1GRAY", on: "SW2GRAY" },
  { off: "SW1GRAY1", on: "SW2GRAY1" }, { off: "SW1METAL", on: "SW2METAL" },
  { off: "SW1PIPE", on: "SW2PIPE" }, { off: "SW1SLAD", on: "SW2SLAD" },
  { off: "SW1STARG", on: "SW2STARG" }, { off: "SW1STON1", on: "SW2STON1" },
  { off: "SW1STON2", on: "SW2STON2" }, { off: "SW1STONE", on: "SW2STONE" },
  { off: "SW1STRTN", on: "SW2STRTN" }
]
buffer Switches { texture: i32 } capacity 64

// A switch that was used shows its other texture, and one that can be
// used again goes back after a second (P_ChangeSwitchTexture,
// P_StartButton); one that cannot is no switch any more.
proc change_switch(lines: mut Lines, sides: mut Sides, switches: Switches,
                   buttons: mut Buttons, line: i32, again: bool) {
  if !again { lines[line].special = 0 }
  let side = lines[line].front
  var where = -1
  var was = 0
  for i in 0..len(switches) {
    if where < 0 {
      let texture = switches[i].texture
      if texture == sides[side].toptexture {
        where = 0
        sides[side].toptexture = switches[i ^ 1].texture
      } else if texture == sides[side].midtexture {
        where = 1
        sides[side].midtexture = switches[i ^ 1].texture
      } else if texture == sides[side].bottomtexture {
        where = 2
        sides[side].bottomtexture = switches[i ^ 1].texture
      }
      was = texture
    }
  }
  if where >= 0 && again {
    // (A line has one button at a time.)
    var free = -1
    var has = false
    for i in 0..len(buttons) {
      if buttons[i].timer != 0 && buttons[i].line == line { has = true }
      if free < 0 && buttons[i].timer == 0 { free = i }
    }
    if !has && free >= 0 {
      buttons[free].line = line
      buttons[free].where = where
      buttons[free].texture = was
      buttons[free].timer = BUTTONTIME
    }
  }
}

// The rows of pictures that move and the switches are found
// (P_InitPicAnims, P_InitSwitchList). After `init_data`.
system init_specials() {
  Anims = []
  for i in 0..len(animdefs) {
    if animdefs[i].texture {
      let first = texture_number(Textures, lump_name(animdefs[i].first))
      if first >= 0 {
        Anims += {
          texture: true, basepic: first,
          numpics: texture_number(Textures, lump_name(animdefs[i].last)) - first + 1
        }
      }
    } else {
      let first = lump_number(Lumps, lump_name(animdefs[i].first))
      if first >= 0 {
        Anims += {
          texture: false, basepic: first - Data.firstflat,
          numpics: lump_number(Lumps, lump_name(animdefs[i].last)) - first + 1
        }
      }
    }
  }
  Switches = []
  for i in 0..len(switchnames) {
    Switches += { texture: texture_number(Textures, lump_name(switchnames[i].off)) }
    Switches += { texture: texture_number(Textures, lump_name(switchnames[i].on)) }
  }
}

// What a level's pictures do in a tic (P_UpdateSpecials): those that
// move show the next of their row every eight tics, a wall that slides
// slides on, and a switch that goes back does when its time is up.
// After the things have had their tic.
system update_specials() {
  for a in 0..len(Anims) {
    let base = Anims[a].basepic
    let count = Anims[a].numpics
    for i in base..base + count {
      let pic = base + (Clock.leveltime / 8 + i) % count
      if Anims[a].texture {
        Textrans[i].pic = pic
      } else {
        Flattrans[i].pic = pic
      }
    }
  }
  for i in 0..len(Scrollers) {
    Sides[Scrollers[i].side].textureoffset += FRACUNIT
  }
  for i in 0..len(Buttons) {
    if Buttons[i].timer != 0 {
      Buttons[i].timer -= 1
      if Buttons[i].timer == 0 {
        let side = Lines[Buttons[i].line].front
        if Buttons[i].where == 0 {
          Sides[side].toptexture = Buttons[i].texture
        } else if Buttons[i].where == 1 {
          Sides[side].midtexture = Buttons[i].texture
        } else {
          Sides[side].bottomtexture = Buttons[i].texture
        }
      }
    }
  }
}

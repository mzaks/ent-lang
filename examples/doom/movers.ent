// The player uses what is in front of it (of P_PlayerThink: the use key,
// once for each time it goes down). After `think_player`.
system use_lines() {
  let down = Pl[0].buttons & BT_USE != 0 && Pl[0].buttons & BT_SPECIAL == 0
  if down && !Pl[0].usedown {
    Rnd = [{ play: Random.play, other: Random.other }; 1]
    let used = use_line(Lines, Sectors, Bytes, Bmap, Tm, Intercepts, Mobj,
                        Spawned.player, Sounds, Rnd)
    Random.other = Rnd[0].other
    if used >= 0 {
      Triggered += { line: used >> 1, used: true, side: used & 1, player: true,
                     shot: false, boss: false, now: true, lx: 0, ly: 0,
                     langle: 0 }
    }
  }
  Pl[0].usedown = down
}

// The lines that were set off do what they do, in their order
// (P_UseSpecialLine, P_CrossSpecialLine, P_ShootSpecialLine,
// EV_VerticalDoor, EV_DoDoor, EV_DoPlat, EV_StopPlat, EV_DoFloor,
// EV_BuildStairs): right after the player's keys, and after the turn of
// each thing that set one off, so that what they start or turn round
// is so for what moves sectors, which comes later in the tic. Gives 1
// where the level is left, 2 where by the secret way out, else 0.
// A switch shows that it was used, and is heard (P_ChangeSwitchTexture):
// from nowhere, or, while the first of the buttons is counting, from
// that button's sector, which is what the reference's code comes to.
// A sector's sound for a listener at a place (see `sound_sector`).
proc sector_sound(sectors: Sectors, sounds: mut Sounds, rnd: mut Rnd, lx: i32,
                  ly: i32, langle: u32, map: i32, sector: i32, sfx: i32) {
  sound_from(sounds, rnd, sfx, -1 - sector, sectors[sector].soundx,
             sectors[sector].soundy, lx, ly, langle, map)
}

proc switch_used(lines: mut Lines, sectors: Sectors, sides: mut Sides,
                 switches: Switches, buttons: mut Buttons, sounds: mut Sounds,
                 rnd: mut Rnd, lx: i32, ly: i32, langle: u32, map: i32,
                 line: i32, again: bool) {
  let from = if buttons[0].timer != 0 {
    lines[buttons[0].line].frontsector
  } else {
    -1
  }
  if change_switch(lines, sides, switches, buttons, line, again) {
    if from >= 0 {
      sector_sound(sectors, sounds, rnd, lx, ly, langle, map, from, SFX_SWTCHN)
    } else {
      sound(sounds, rnd, SFX_SWTCHN, 0)
    }
  }
}

proc work_lines(triggered: mut Triggered, lines: mut Lines,
                sectors: mut Sectors, movers: mut Movers, lights: mut Lights,
                inv: Inv, tm: mut Tm, rnd: mut Rnd, sides: mut Sides,
                switches: Switches, buttons: mut Buttons, things: Mobj,
                listener: entity, env: Env, sounds: mut Sounds) -> i32 {
  var out = 0
  for t in 0..len(triggered) {
    let line = triggered[t].line
    let boss = triggered[t].boss
    let special = if boss { 38 } else { lines[line].special }
    let tag = if boss { 666 } else { lines[line].tag }
    let used = triggered[t].used
    let player = triggered[t].player
    // (Where what it starts is heard from.)
    let lx = if triggered[t].now { things[listener].x } else { triggered[t].lx }
    let ly = if triggered[t].now { things[listener].y } else { triggered[t].ly }
    let langle = if triggered[t].now {
      things[listener].angle
    } else {
      triggered[t].langle
    }
    // The ways out, by a switch or by walking: the level is over when
    // the tic is (G_ExitLevel, G_SecretExitLevel).
    if player && !triggered[t].shot &&
       ((used && triggered[t].side == 0 && (special == 11 || special == 51)) ||
        (!used && (special == 52 || special == 124))) {
      out = if special == 51 || special == 124 { 2 } else { 1 }
      if used {
        switch_used(lines, sectors, sides, switches, buttons, sounds, rnd, lx,
                      ly, langle, env[0].map, line, false)
      }
    }
    if used && triggered[t].side == 0 &&
       (special == 1 || special == 26 || special == 27 || special == 28 ||
        special == 31 || special == 32 || special == 33 || special == 34 ||
        special == 117 || special == 118) {
      // A door that is opened by hand: its key, if it has a lock.
      let cards = inv[0].cards
      let blue = cards & (1 << IT_BLUECARD | 1 << IT_BLUESKULL) != 0
      let yellow = cards & (1 << IT_YELLOWCARD | 1 << IT_YELLOWSKULL) != 0
      let red = cards & (1 << IT_REDCARD | 1 << IT_REDSKULL) != 0
      // (A monster opens none that has a lock.)
      let locked = ((special == 26 || special == 32) && (!blue || !player)) ||
                   ((special == 27 || special == 34) && (!yellow || !player)) ||
                   ((special == 28 || special == 33) && (!red || !player))
      let sector = lines[line].backsector
      // (A lock the player has no key for says so.)
      if locked && triggered[t].player { sound(sounds, rnd, SFX_OOF, 0) }
      if !locked && sector >= 0 {
        let moving = sectors[sector].specialdata
        if moving != 0 {
          // It is moving: one that shuts again turns round. (A lift that
          // is there in its place goes at once.)
          if special == 1 || special == 26 || special == 27 || special == 28 ||
             special == 117 {
            // (A monster never shuts one.)
            if movers[moving - 1].kind == MOVER_PLAT {
              if player { movers[moving - 1].wait = -1 }
            } else if movers[moving - 1].direction == -1 {
              movers[moving - 1].direction = 1
            } else if player {
              movers[moving - 1].direction = -1
            }
          }
        } else {
          let stays = special == 31 || special == 32 || special == 33 ||
                      special == 34 || special == 118
          let fast = special == 117 || special == 118
          sector_sound(sectors, sounds, rnd, lx, ly, langle, env[0].map, sector, if fast { SFX_BDOPN } else { SFX_DOROPN })
          movers += {
            kind: MOVER_DOOR, active: true, sector: sector,
            type: if special == 117 {
              VLD_BLAZERAISE
            } else if special == 118 {
              VLD_BLAZEOPEN
            } else if stays {
              VLD_OPEN
            } else {
              VLD_NORMAL
            },
            direction: 1, speed: if fast { VDOORSPEED * 4 } else { VDOORSPEED },
            high: lowest_ceiling_surrounding(lines, sectors, sector) - 4 * FRACUNIT,
            low: 0, wait: VDOORWAIT, count: 0, crush: false, status: 0,
            oldstatus: 0, tag: 0, born: tm[0].links + 1,
                  ran: -1
          }
          sectors[sector].specialdata = len(movers)
          tm[0].links += 1
          // (One that stays open is opened once.)
          if stays { lines[line].special = 0 }
        }
      }
    } else if !used || triggered[t].side == 0 {
      // What the table says of the line.
      // (What a shot sets off, only a shot does.)
      let gun = special == 24 || special == 46 || special == 47
      var row = -1
      for k in 0..len(triggers) {
        if triggers[k].special == special && triggers[k].walk != used &&
           gun == triggered[t].shot {
          row = k
        }
      }
      if row >= 0 {
        let action = triggers[row].action
        let type = triggers[row].type
        var started = false
        if action == ACT_STOPPLAT {
          // The lifts of the tag stand still.
          for i in 0..len(movers) {
            if movers[i].active && movers[i].kind == MOVER_PLAT &&
               movers[i].tag == tag && movers[i].status != PLAT_IN_STASIS {
              movers[i].oldstatus = movers[i].status
              movers[i].status = PLAT_IN_STASIS
            }
          }
        } else if action == ACT_STOPCEILING {
          // The ceilings of the tag stand still (EV_CeilingCrushStop).
          for i in 0..len(movers) {
            if movers[i].active && movers[i].kind == MOVER_CEILING &&
               movers[i].tag == tag && movers[i].direction != 0 {
              movers[i].oldstatus = movers[i].direction
              movers[i].direction = 0
              started = true
            }
          }
        } else if action == ACT_LIGHT {
          // The sectors of the tag are lit otherwise (EV_LightTurnOn,
          // EV_TurnTagLightsOff, EV_StartLightStrobing). (A flicker that
          // is started has its first tic with the next.)
          started = true
          var bright = if type == 1 { 255 } else if type == 2 { 35 } else { 0 }
          for i in 0..len(sectors) {
            if sectors[i].tag == tag {
              if type == 4 {
                if sectors[i].specialdata == 0 {
                  let light = sectors[i].lightlevel
                  let least = min_surrounding_light(lines, sectors, i, light)
                  lights += {
                    kind: LIGHT_STROBE, sector: i, count: (p_random(rnd) & 7) + 1,
                    maxlight: light,
                    minlight: if least == light { 0 } else { least }, maxtime: 0,
                    mintime: 0, darktime: SLOWDARK, brighttime: STROBEBRIGHT,
                    direction: 0
                  }
                  sectors[i].special = 0
                }
              } else if type == 3 {
                sectors[i].lightlevel = min_surrounding_light(
                    lines, sectors, i, sectors[i].lightlevel)
              } else {
                // (The lightest next to it, of all the tag's sectors so
                // far: the reference keeps what it found.)
                if bright == 0 {
                  for l in 0..len(lines) {
                    if lines[l].flags & ML_TWOSIDED != 0 &&
                       (lines[l].frontsector == i || lines[l].backsector == i) {
                      let other = if lines[l].frontsector == i {
                        lines[l].backsector
                      } else {
                        lines[l].frontsector
                      }
                      bright max= sectors[other].lightlevel
                    }
                  }
                }
                sectors[i].lightlevel = bright
              }
            }
          }
        } else {
          // (Lifts of the tag that stand still go on.)
          if action == ACT_PLAT && type == PLAT_PERPETUALRAISE {
            for i in 0..len(movers) {
              if movers[i].active && movers[i].kind == MOVER_PLAT &&
                 movers[i].tag == tag && movers[i].status == PLAT_IN_STASIS {
                movers[i].status = movers[i].oldstatus
              }
            }
          }
          // (Ceilings of the tag that stand still go on, where one that
          // crushes is asked for: P_ActivateInStasisCeiling.)
          if action == ACT_CEILING && type >= CEIL_CRUSHANDRAISE {
            for i in 0..len(movers) {
              if movers[i].active && movers[i].kind == MOVER_CEILING &&
                 movers[i].tag == tag && movers[i].direction == 0 {
                movers[i].direction = movers[i].oldstatus
              }
            }
          }
          // A door or a lift in every sector of the tag that nothing
          // moves.
          var secnum = sector_from_tag(sectors, tag, -1)
          while secnum >= 0 {
            if sectors[secnum].specialdata == 0 {
              started = true
              let floor = sectors[secnum].floorheight
              var made = true
              if action == ACT_DONUT {
                // A pillar sinks into the ring around it, which rises,
                // both to the floor of what is around the ring
                // (EV_DoDonut): the ring is what is behind the pillar's
                // first line, and what is around it what is behind the
                // first line of the ring that is not the pillar's.
                var ring = -1
                for l in 0..len(lines) {
                  if ring < 0 && lines[l].flags & ML_TWOSIDED != 0 &&
                     (lines[l].frontsector == secnum || lines[l].backsector == secnum) {
                    ring = if lines[l].frontsector == secnum {
                      lines[l].backsector
                    } else {
                      lines[l].frontsector
                    }
                  }
                }
                var around = -1
                if ring >= 0 {
                  for l in 0..len(lines) {
                    if around < 0 &&
                       (lines[l].frontsector == ring || lines[l].backsector == ring) &&
                       lines[l].backsector >= 0 && lines[l].backsector != secnum {
                      around = lines[l].backsector
                    }
                  }
                }
                made = around >= 0
                if around >= 0 {
                  movers += {
                    kind: MOVER_FLOOR, active: true, sector: ring,
                    type: FLOOR_DONUTRAISE, direction: 1, speed: FLOORSPEED / 2,
                    high: sectors[around].floorheight,
                    low: sectors[around].floorpic, wait: 0, count: 0,
                    crush: false, status: 0, oldstatus: 0, tag: 0,
                    born: tm[0].links + 1, ran: -1
                  }
                  sectors[ring].specialdata = len(movers)
                  tm[0].links += 1
                  movers += {
                    kind: MOVER_FLOOR, active: true, sector: secnum,
                    type: FLOOR_LOWER, direction: -1, speed: FLOORSPEED / 2,
                    high: sectors[around].floorheight, low: 0, wait: 0,
                    count: 0, crush: false, status: 0, oldstatus: 0, tag: 0,
                    born: tm[0].links + 1, ran: -1
                  }
                }
              } else if action == ACT_CEILING {
                // A ceiling that comes down, or goes up to the highest
                // next to it (EV_DoCeiling); one that crushes goes up
                // and down for ever.
                var top = sectors[secnum].ceilingheight
                if type == CEIL_RAISETOHIGHEST {
                  top = 0
                  for l in 0..len(lines) {
                    if lines[l].flags & ML_TWOSIDED != 0 &&
                       (lines[l].frontsector == secnum || lines[l].backsector == secnum) {
                      let other = if lines[l].frontsector == secnum {
                        lines[l].backsector
                      } else {
                        lines[l].frontsector
                      }
                      top max= sectors[other].ceilingheight
                    }
                  }
                }
                movers += {
                  kind: MOVER_CEILING, active: true, sector: secnum, type: type,
                  direction: if type == CEIL_RAISETOHIGHEST { 1 } else { -1 },
                  speed: if type == CEIL_FASTCRUSHANDRAISE { CEILSPEED * 2 } else { CEILSPEED },
                  high: top,
                  low: if type == CEIL_LOWERTOFLOOR { floor } else { floor + 8 * FRACUNIT },
                  wait: 0, count: 0, crush: type >= CEIL_CRUSHANDRAISE, status: 0,
                  oldstatus: 0, tag: sectors[secnum].tag, born: tm[0].links + 1,
                  ran: -1
                }
              } else if action == ACT_STAIRS {
                // Stairs (EV_BuildStairs): the floor goes up a step, and
                // from sector to sector, through the lines that face
                // away, each next one with the same flat a step more.
                // (What is in the way of a step is hurt as by a floor
                // that crushes, which the reference does by a slip.)
                let speed = if type == 0 { FLOORSPEED / 4 } else { FLOORSPEED * 4 }
                let stairsize = if type == 0 { 8 * FRACUNIT } else { 16 * FRACUNIT }
                var height = floor + stairsize
                let flat = sectors[secnum].floorpic
                movers += {
                  kind: MOVER_FLOOR, active: true, sector: secnum,
                  type: FLOOR_LOWER, direction: 1, speed: speed, high: height,
                  low: 0, wait: 0, count: 0, crush: false, status: 1,
                  oldstatus: 0, tag: 0, born: tm[0].links + 1,
                  ran: -1
                }
                sectors[secnum].specialdata = len(movers)
                tm[0].links += 1
                var ok = true
                while ok {
                  ok = false
                  for l in 0..len(lines) {
                    if !ok && lines[l].flags & ML_TWOSIDED != 0 &&
                       lines[l].frontsector == secnum {
                      let next = lines[l].backsector
                      if sectors[next].floorpic == flat {
                        height += stairsize
                        if sectors[next].specialdata == 0 {
                          secnum = next
                          movers += {
                            kind: MOVER_FLOOR, active: true, sector: secnum,
                            type: FLOOR_LOWER, direction: 1, speed: speed,
                            high: height, low: 0, wait: 0, count: 0,
                            crush: false, status: 1, oldstatus: 0, tag: 0, born: tm[0].links + 1,
                  ran: -1
                          }
                          sectors[secnum].specialdata = len(movers)
                          tm[0].links += 1
                          ok = true
                        }
                      }
                    }
                  }
                }
              } else if action == ACT_FLOOR {
                // A floor that goes to a height (EV_DoFloor).
                var direction = 1
                var speed = FLOORSPEED
                var dest = floor
                var flat = sectors[secnum].floorpic
                var newspecial = sectors[secnum].special
                if type == FLOOR_LOWER {
                  direction = -1
                  dest = highest_floor_surrounding(lines, sectors, secnum)
                } else if type == FLOOR_LOWERTOLOWEST || type == FLOOR_LOWERANDCHANGE {
                  direction = -1
                  dest = lowest_floor_surrounding(lines, sectors, secnum)
                  if type == FLOOR_LOWERANDCHANGE {
                    // (The flat and what is special of the first sector
                    // next to it that is as low.)
                    var found = false
                    for l in 0..len(lines) {
                      if !found && lines[l].flags & ML_TWOSIDED != 0 &&
                         (lines[l].frontsector == secnum || lines[l].backsector == secnum) {
                        let other = if lines[l].frontsector == secnum {
                          lines[l].backsector
                        } else {
                          lines[l].frontsector
                        }
                        if sectors[other].floorheight == dest {
                          flat = sectors[other].floorpic
                          newspecial = sectors[other].special
                          found = true
                        }
                      }
                    }
                  }
                } else if type == FLOOR_TURBOLOWER {
                  direction = -1
                  speed = FLOORSPEED * 4
                  dest = highest_floor_surrounding(lines, sectors, secnum)
                  if dest != floor { dest += 8 * FRACUNIT }
                } else if type == FLOOR_RAISE || type == FLOOR_RAISECRUSH {
                  dest = min(lowest_ceiling_surrounding(lines, sectors, secnum),
                             sectors[secnum].ceilingheight)
                  if type == FLOOR_RAISECRUSH { dest -= 8 * FRACUNIT }
                } else if type == FLOOR_RAISETURBO {
                  speed = FLOORSPEED * 4
                  dest = next_highest_floor(lines, sectors, secnum, floor)
                } else if type == FLOOR_RAISETONEAREST {
                  dest = next_highest_floor(lines, sectors, secnum, floor)
                } else if type == FLOOR_RAISE24 {
                  dest = floor + 24 * FRACUNIT
                } else if type == FLOOR_RAISE512 {
                  dest = floor + 512 * FRACUNIT
                } else if type == FLOOR_RAISE24ANDCHANGE {
                  dest = floor + 24 * FRACUNIT
                  sectors[secnum].floorpic = sectors[lines[line].frontsector].floorpic
                  sectors[secnum].special = sectors[lines[line].frontsector].special
                }
                movers += {
                  kind: MOVER_FLOOR, active: true, sector: secnum, type: type,
                  direction: direction, speed: speed, high: dest, low: flat,
                  wait: newspecial, count: 0, crush: type == FLOOR_RAISECRUSH,
                  status: 0, oldstatus: 0, tag: 0, born: tm[0].links + 1,
                  ran: -1
                }
              } else if action == ACT_DOOR {
                let down = type == VLD_BLAZECLOSE || type == VLD_CLOSE ||
                           type == VLD_CLOSE30THENOPEN
                // (One that is open already opens without a sound.)
                if down {
                  sector_sound(sectors, sounds, rnd, lx, ly, langle, env[0].map, secnum,
                               if type == VLD_BLAZECLOSE { SFX_BDCLS } else { SFX_DORCLS })
                } else if lowest_ceiling_surrounding(lines, sectors, secnum) - 4 * FRACUNIT !=
                          sectors[secnum].ceilingheight &&
                          (type == VLD_BLAZERAISE || type == VLD_BLAZEOPEN ||
                           type == VLD_NORMAL || type == VLD_OPEN) {
                  sector_sound(sectors, sounds, rnd, lx, ly, langle, env[0].map, secnum,
                               if type == VLD_BLAZERAISE || type == VLD_BLAZEOPEN {
                                 SFX_BDOPN
                               } else {
                                 SFX_DOROPN
                               })
                }
                movers += {
                  kind: MOVER_DOOR, active: true, sector: secnum, type: type,
                  direction: if down { -1 } else { 1 },
                  speed: if type == VLD_BLAZECLOSE || type == VLD_BLAZERAISE ||
                            type == VLD_BLAZEOPEN {
                    VDOORSPEED * 4
                  } else {
                    VDOORSPEED
                  },
                  high: if type == VLD_CLOSE30THENOPEN {
                    sectors[secnum].ceilingheight
                  } else {
                    lowest_ceiling_surrounding(lines, sectors, secnum) - 4 * FRACUNIT
                  },
                  low: 0, wait: VDOORWAIT, count: 0, crush: false, status: 0,
                  oldstatus: 0, tag: 0, born: tm[0].links + 1,
                  ran: -1
                }
              } else {
                let lowest = min(lowest_floor_surrounding(lines, sectors, secnum), floor)
                var status = PLAT_DOWN
                var speed = PLATSPEED
                var low = lowest
                var high = floor
                var wait = TICRATE * PLATWAIT
                if type == PLAT_RAISETONEARESTANDCHANGE {
                  speed = PLATSPEED / 2
                  sectors[secnum].floorpic = sectors[lines[line].frontsector].floorpic
                  high = next_highest_floor(lines, sectors, secnum, floor)
                  low = 0
                  wait = 0
                  status = PLAT_UP
                  // (It hurts no more.)
                  sectors[secnum].special = 0
                } else if type == PLAT_RAISEANDCHANGE {
                  speed = PLATSPEED / 2
                  sectors[secnum].floorpic = sectors[lines[line].frontsector].floorpic
                  high = floor + triggers[row].amount * FRACUNIT
                  low = 0
                  wait = 0
                  status = PLAT_UP
                } else if type == PLAT_DOWNWAITUPSTAY {
                  speed = PLATSPEED * 4
                } else if type == PLAT_BLAZEDWUS {
                  speed = PLATSPEED * 8
                } else {
                  // Up and down for ever, starting either way.
                  high = max(highest_floor_surrounding(lines, sectors, secnum), floor)
                  status = p_random(rnd) & 1
                }
                sector_sound(sectors, sounds, rnd, lx, ly, langle, env[0].map, secnum,
                             if type == PLAT_RAISETONEARESTANDCHANGE ||
                                type == PLAT_RAISEANDCHANGE {
                               SFX_STNMOV
                             } else {
                               SFX_PSTART
                             })
                movers += {
                  kind: MOVER_PLAT, active: true, sector: secnum, type: type,
                  direction: 0, speed: speed, high: high, low: low, wait: wait,
                  count: 0, crush: false, status: status, oldstatus: 0, tag: tag, born: tm[0].links + 1,
                  ran: -1
                }
              }
              if made {
                sectors[secnum].specialdata = len(movers)
                tm[0].links += 1
              }
            }
            secnum = sector_from_tag(sectors, tag, secnum)
          }
        }
        // One that is walked over once is done; a switch that is used
        // once, when it started something.
        if !boss && !triggers[row].again && (!used || started) {
          lines[line].special = 0
        }
        // A switch shows that it was used, when it started something;
        // one that was shot, always.
        if !boss && ((used && started) || triggered[t].shot) {
          switch_used(lines, sectors, sides, switches, buttons, sounds, rnd, lx,
                      ly, langle, env[0].map, line, triggers[row].again)
        }
      }
    }
  }
  triggered = []
  out
}

// After `use_lines`.
system trigger_lines() {
  Rnd = [{ play: Random.play, other: Random.other }; 1]
  let out = work_lines(Triggered, Lines, Sectors, Movers, Lights, Inv, Tm, Rnd,
                       Sides, Switches, Buttons, Mobj, Spawned.player, Env,
                       Sounds)
  Random.play = Rnd[0].play
  Random.other = Rnd[0].other
  if out != 0 {
    Level.exited = true
    Level.secret = out == 2
  }
}

// A sector's floor or ceiling has moved (P_ChangeSector,
// PIT_ChangeSector): every thing in the squares the sector reaches
// finds its floor and ceiling anew, column by column as the blockmap has
// them. What does not fit: the dead are crushed to bits, what was left
// by the dead is gone, and anything else that can be hurt is in the way
// (which is what is given back) and, with `crunches`, hurt every fourth
// tic.
proc change_sector(lines: mut Lines, sectors: mut Sectors, subsectors:
                   Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap: mut Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                   spechit: mut Spechit, touched: mut Touched, triggered: mut
                   Triggered, intercepts: mut Intercepts, sight: mut Sight,
                   rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env,
                   blast: mut Blast, sounds: mut Sounds, things: mut Mobj, player: entity, sector:
                   i32, crunches: bool) -> bool {
  gather_blast(things, bmap, blast, true, sectors[sector].bbleft,
               sectors[sector].bbright, sectors[sector].bbbottom,
               sectors[sector].bbtop)
  var nofit = false
  for k in 0..len(blast) {
    let it = thing_by_id(things, blast[k].id)
    let onfloor = things[it].z == things[it].floorz
    // (With something solid in it, a thing has the floor and ceiling of
    // its own sector, whatever openings it reaches into: the reference
    // stops looking there.)
    let x = things[it].x
    let y = things[it].y
    let radius = things[it].radius
    var inside = false
    for o, other in things
        where o != it && !other.gone && other.flags & MF_NOBLOCKMAP == 0 &&
              other.flags & MF_SOLID != 0 &&
              abs(other.x - x) < other.radius + radius &&
              abs(other.y - y) < other.radius + radius {
      inside = true
    }
    let own = subsectors[point_in_subsector(nodes, x, y)].sector
    let (openfloor, openceiling) = heights_at(
        lines, sectors, subsectors, nodes, bytes, bmap, x, y, radius,
        things[it].flags,
        things[it].flags & MF_MISSILE == 0 && things[it].type != MT_PLAYER)
    let floorz = if inside { sectors[own].floorheight } else { openfloor }
    let ceilingz = if inside { sectors[own].ceilingheight } else { openceiling }
    things[it].floorz = floorz
    things[it].ceilingz = ceilingz
    if onfloor {
      things[it].z = floorz
    } else if things[it].z + things[it].height > ceilingz {
      things[it].z = ceilingz - things[it].height
    }
    if ceilingz - floorz < things[it].height {
      if things[it].health <= 0 {
        things[it].state = S_GIBS
        things[it].tics = states[S_GIBS].tics
        things[it].sprite = states[S_GIBS].sprite
        things[it].frame = states[S_GIBS].frame
        things[it].flags &= ~MF_SOLID
        things[it].height = 0
        things[it].radius = 0
      } else if things[it].flags & MF_DROPPED != 0 {
        things[it].gone = true
      } else if things[it].flags & MF_SHOOTABLE != 0 {
        nofit = true
        if crunches && env[0].leveltime & 3 == 0 {
          damage_mobj(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, sounds, things, player, it, none, none, 10)
          // (Blood, any way.)
          let mo = spawn_mobj(things, sectors, subsectors, nodes, bmap, tm, rnd, env,
                              things[it].x, things[it].y,
                              things[it].z + things[it].height / 2, MT_BLOOD)
          things[mo].momx = sub_random(rnd) << 12
          things[mo].momy = sub_random(rnd) << 12
        }
      }
    }
  }
  nofit
}

// A tic of what moves a sector (T_VerticalDoor, T_PlatRaise, T_MoveFloor,
// T_MovePlane): the plane is moved a step, the things are fitted anew,
// and if one does not fit the step is taken back.
proc move_one(lines: mut Lines, sectors: mut Sectors, subsectors: Subsectors,
              segs: Segs, nodes: Nodes, bytes: Bytes, bmap: mut Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm, spechit: mut Spechit,
              touched: mut Touched, triggered: mut Triggered, intercepts: mut
              Intercepts, sight: mut Sight, rnd: mut Rnd, inv: mut Inv,
              powers: Powers, env: Env, blast: mut Blast, sounds: mut Sounds, things: mut Mobj,
              player: entity, movers: mut Movers, i: i32) {
  let sector = movers[i].sector
  let type = movers[i].type
  // What it does this tic: wait, or move a plane to a height.
  var moving = false
  var ceiling = true
  var mdir = 0
  var dest = 0
  let speed = movers[i].speed
  // (A lift going down crushes nothing.)
  let crush = movers[i].crush && !(movers[i].kind == MOVER_PLAT &&
                                   movers[i].status == PLAT_DOWN)
  let plat = movers[i].kind == MOVER_PLAT
  // (What it crushes it hurts: a floor or a ceiling that crushes, and
  // stairs. Doors and lifts hurt nothing.)
  let ceil = movers[i].kind == MOVER_CEILING
  let crunches = if ceil {
    movers[i].crush && movers[i].direction == -1
  } else {
    movers[i].kind != MOVER_PLAT && movers[i].kind != MOVER_DOOR &&
    (movers[i].crush || movers[i].status == 1)
  }
  let goes = movers[i].kind == MOVER_FLOOR
  let status = movers[i].status
  let dir = if plat || goes || ceil { 3 } else { movers[i].direction }
  if ceil {
    // A ceiling goes up or down, or stands still.
    if movers[i].direction != 0 {
      moving = true
      mdir = movers[i].direction
      dest = if mdir == 1 { movers[i].high } else { movers[i].low }
    }
  } else if goes {
    // A floor goes to its height.
    ceiling = false
    moving = true
    mdir = movers[i].direction
    dest = movers[i].high
  } else if plat {
    // A lift goes up, or down, or waits where it is.
    ceiling = false
    if status == PLAT_UP {
      moving = true
      mdir = 1
      dest = movers[i].high
    } else if status == PLAT_DOWN {
      moving = true
      mdir = -1
      dest = movers[i].low
    } else if status == PLAT_WAITING {
      movers[i].count -= 1
      if movers[i].count == 0 {
        movers[i].status = if sectors[sector].floorheight == movers[i].low {
          PLAT_UP
        } else {
          PLAT_DOWN
        }
        sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_PSTART)
      }
    }
  } else if dir == 0 {
    // A door waits at the top.
    movers[i].count -= 1
    if movers[i].count == 0 {
      if type == VLD_BLAZERAISE || type == VLD_NORMAL {
        movers[i].direction = -1
        sound_sector(things, player, env, sectors, sounds, rnd, sector,
                     if type == VLD_NORMAL { SFX_DORCLS } else { SFX_BDCLS })
      } else if type == VLD_CLOSE30THENOPEN {
        movers[i].direction = 1
        sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_DOROPN)
      }
    }
  } else if dir == 2 {
    // (It opens after a while.)
    movers[i].count -= 1
    if movers[i].count == 0 && type == VLD_RAISEIN5MINS {
      movers[i].direction = 1
      movers[i].type = VLD_NORMAL
      sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_DOROPN)
    }
  } else if dir == -1 {
    moving = true
    mdir = -1
    dest = sectors[sector].floorheight
  } else {
    moving = true
    mdir = 1
    dest = movers[i].high
  }

  var res = RES_OK
  if moving {
    // T_MovePlane.
    let lastpos = if ceiling {
      sectors[sector].ceilingheight
    } else {
      sectors[sector].floorheight
    }
    let past = if mdir == -1 { lastpos - speed < dest } else { lastpos + speed > dest }
    let next = if past { dest } else { lastpos + mdir * speed }
    let left = sectors[sector].bbleft
    let right = sectors[sector].bbright
    let bottom = sectors[sector].bbbottom
    let top = sectors[sector].bbtop
    var revert = false
    for pass in 0..2 {
      if pass == 0 || revert {
        let height = if pass == 0 { next } else { lastpos }
        if ceiling {
          sectors[sector].ceilingheight = height
        } else {
          sectors[sector].floorheight = height
        }
        let nofit = change_sector(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, sounds, things, player, sector, crunches)
        if pass == 0 {
          // What a thing in the way does to the move: it is taken
          // back, but for a floor going up or a ceiling coming down
          // that crushes, and a ceiling going up.
          if nofit {
            if past {
              revert = true
            } else if ceiling && mdir == 1 {
              revert = false
            } else {
              res = RES_CRUSHED
              revert = !(crush && ((ceiling && mdir == -1) || (!ceiling && mdir == 1)))
            }
          }
          if past { res = RES_PASTDEST }
        }
      }
    }
  }

  // What it does when it got there, or something was in the way. (What
  // moves stone is heard every eighth tic, and when it stops.)
  let grinds = moving && env[0].leveltime & 7 == 0
  if ceil {
    if grinds && type != CEIL_SILENTCRUSHANDRAISE {
      sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_STNMOV)
    }
    if moving && res == RES_PASTDEST && type == CEIL_SILENTCRUSHANDRAISE {
      sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_PSTOP)
    }
    if moving && mdir == 1 {
      if res == RES_PASTDEST {
        if type == CEIL_RAISETOHIGHEST {
          sectors[sector].specialdata = 0
          movers[i].active = false
        } else if type >= CEIL_CRUSHANDRAISE {
          movers[i].direction = -1
        }
      }
    } else if moving {
      if res == RES_PASTDEST {
        if type == CEIL_CRUSHANDRAISE || type == CEIL_SILENTCRUSHANDRAISE {
          movers[i].speed = CEILSPEED
        }
        if type >= CEIL_CRUSHANDRAISE {
          movers[i].direction = 1
        } else {
          sectors[sector].specialdata = 0
          movers[i].active = false
        }
      } else if res == RES_CRUSHED &&
                (type == CEIL_CRUSHANDRAISE || type == CEIL_SILENTCRUSHANDRAISE ||
                 type == CEIL_LOWERANDCRUSH) {
        // (Slowly through what is in the way.)
        movers[i].speed = CEILSPEED / 8
      }
    }
  } else if goes {
    if grinds { sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_STNMOV) }
    if res == RES_PASTDEST {
      sectors[sector].specialdata = 0
      if type == FLOOR_LOWERANDCHANGE || type == FLOOR_DONUTRAISE {
        sectors[sector].special = movers[i].wait
        sectors[sector].floorpic = movers[i].low
      }
      movers[i].active = false
      sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_PSTOP)
    }
  } else if moving && plat {
    if status == PLAT_UP {
      if grinds && (type == PLAT_RAISEANDCHANGE || type == PLAT_RAISETONEARESTANDCHANGE) {
        sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_STNMOV)
      }
      if res == RES_CRUSHED && !movers[i].crush {
        movers[i].count = movers[i].wait
        movers[i].status = PLAT_DOWN
        sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_PSTART)
      } else if res == RES_PASTDEST {
        movers[i].count = movers[i].wait
        movers[i].status = PLAT_WAITING
        sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_PSTOP)
        // (All but the one that goes for ever are done at the top.)
        if type != PLAT_PERPETUALRAISE {
          sectors[sector].specialdata = 0
          movers[i].active = false
        }
      }
    } else if res == RES_PASTDEST {
      movers[i].count = movers[i].wait
      movers[i].status = PLAT_WAITING
      sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_PSTOP)
    }
  } else if moving && dir == -1 {
    if res == RES_PASTDEST {
      if type == VLD_CLOSE30THENOPEN {
        movers[i].direction = 0
        movers[i].count = 35 * 30
      } else if type == VLD_BLAZERAISE || type == VLD_BLAZECLOSE ||
                type == VLD_NORMAL || type == VLD_CLOSE {
        sectors[sector].specialdata = 0
        movers[i].active = false
        if type == VLD_BLAZERAISE || type == VLD_BLAZECLOSE {
          sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_BDCLS)
        }
      }
    } else if res == RES_CRUSHED {
      // (A door goes up again, unless it is one that shuts.)
      if type != VLD_BLAZECLOSE && type != VLD_CLOSE {
        movers[i].direction = 1
        sound_sector(things, player, env, sectors, sounds, rnd, sector, SFX_DOROPN)
      }
    }
  } else if moving && dir == 1 {
    if res == RES_PASTDEST {
      if type == VLD_BLAZERAISE || type == VLD_NORMAL {
        movers[i].direction = 0
        movers[i].count = movers[i].wait
      } else if type == VLD_CLOSE30THENOPEN || type == VLD_BLAZEOPEN ||
                type == VLD_OPEN {
        sectors[sector].specialdata = 0
        movers[i].active = false
      }
    }
  }
}

// The movers that were made before the thing with that number, and have
// not had their tic: they take their turns among the things in the
// order all were made in.
proc movers_before(lines: mut Lines, sectors: mut Sectors, subsectors:
                   Subsectors, segs: Segs, nodes: Nodes, bytes: Bytes, bmap: mut Bmap, near: mut Near, order: mut Nearorder, tm: mut Tm,
                   spechit: mut Spechit, touched: mut Touched, triggered: mut
                   Triggered, intercepts: mut Intercepts, sight: mut Sight,
                   rnd: mut Rnd, inv: mut Inv, powers: Powers, env: Env,
                   blast: mut Blast, sounds: mut Sounds, things: mut Mobj, player: entity, movers:
                   mut Movers, id: i32) {
  for i in 0..len(movers) {
    if movers[i].active && movers[i].born < id && movers[i].ran != env[0].leveltime {
      movers[i].ran = env[0].leveltime
      move_one(lines, sectors, subsectors, segs, nodes, bytes, bmap, near, order, tm, spechit, touched, triggered, intercepts, sight, rnd, inv, powers, env, blast, sounds, things, player, movers, i)
    }
  }
}

proc button_sound(things: Mobj, player: entity, sounds: mut Sounds,
                  rnd: mut Rnd, x: i32, map: i32) {
  sound_from(sounds, rnd, SFX_SWTCHN, 0, x, 0, things[player].x,
             things[player].y, things[player].angle, map)
}

// The switches that go back do when their time is up (the buttons of
// P_UpdateSpecials), and are heard: from the middle of the map, which
// is what the place the reference takes the sound to come from comes
// to (it reads the next button's numbers as a place). After
// `update_specials`.
system update_buttons() {
  Rnd = [{ play: Random.play, other: Random.other }; 1]
  for i in 0..len(Buttons) {
    if Buttons[i].timer != 0 {
      Buttons[i].timer -= 1
      if Buttons[i].timer == 0 {
        let side = Lines[Buttons[i].line].front
        if Buttons[i].where == 0 {
          Sides[side].toptexture = Buttons[i].texture
        } else if Buttons[i].where == 1 {
          Sides[side].midtexture = Buttons[i].texture
        } else {
          Sides[side].bottomtexture = Buttons[i].texture
        }
        let x = if i + 1 < len(Buttons) { Buttons[i + 1].timer } else { 0 }
        button_sound(Mobj, Spawned.player, Sounds, Rnd, x, Level.map)
      }
    }
  }
  Random.other = Rnd[0].other
}

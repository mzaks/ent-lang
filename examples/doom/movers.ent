const FLOOR_RAISE24ANDCHANGE = 8
const FLOOR_RAISECRUSH = 9
const FLOOR_RAISETURBO = 10
const FLOOR_DONUTRAISE = 11
const FLOOR_RAISE512 = 12
const FLOORSPEED = FRACUNIT

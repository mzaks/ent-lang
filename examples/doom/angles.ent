// Angles and distances by the tables (tables.c, r_main.c, p_maputl.c).
import fixed
import tables

const ANG45: u32 = 0x20000000
const ANG90: u32 = 0x40000000
const ANG180: u32 = 0x80000000
const ANG270: u32 = 0xc0000000

// A fine angle is the top 13 bits of an angle: 8192 to the turn.
const FINEANGLES = 8192
const FINEMASK = FINEANGLES - 1
const ANGLETOFINESHIFT = 19

// A slope is so many 2048ths, in `tantoangle`; the bits of a fraction
// that it has not.
const SLOPERANGE = 2048
const DBITS = FRACBITS - 11

// The cosine of a fine angle: the sine a quarter turn on.
fn finecosine(fine: i32) -> i32 { finesine[fine + FINEANGLES / 4] }

// `num / den` as a place in `tantoangle`, 0 to 2048 (SlopeDiv).
fn slope_div(num: u32, den: u32) -> i32 {
  if den < 512 {
    SLOPERANGE
  } else {
    let ans = (num << 3) / (den >> 8)
    if ans <= SLOPERANGE as u32 { ans as i32 } else { SLOPERANGE }
  }
}

// The angle of the point (dx, dy) as seen from nought (R_PointToAngle,
// which is given a point and takes the view's place from it: here who
// asks does that). The point is turned into the first eighth of a turn,
// where the table has the angle of its slope.
fn point_to_angle(dx: i32, dy: i32) -> u32 {
  if dx == 0 && dy == 0 {
    0
  } else if dx >= 0 {
    if dy >= 0 {
      if dx > dy {
        tantoangle[slope_div(dy as u32, dx as u32)]            // octant 0
      } else {
        ANG90 - 1 - tantoangle[slope_div(dx as u32, dy as u32)]   // octant 1
      }
    } else {
      let y = -dy
      if dx > y {
        -tantoangle[slope_div(y as u32, dx as u32)]            // octant 8
      } else {
        ANG270 + tantoangle[slope_div(dx as u32, y as u32)]       // octant 7
      }
    }
  } else {
    let x = -dx
    if dy >= 0 {
      if x > dy {
        ANG180 - 1 - tantoangle[slope_div(dy as u32, x as u32)]  // octant 3
      } else {
        ANG90 + tantoangle[slope_div(x as u32, dy as u32)]        // octant 2
      }
    } else {
      let y = -dy
      if x > y {
        ANG180 + tantoangle[slope_div(y as u32, x as u32)]        // octant 4
      } else {
        ANG270 - 1 - tantoangle[slope_div(x as u32, y as u32)]   // octant 5
      }
    }
  }
}

// How far the point (dx, dy) is from nought (R_PointToDist): the longer
// side over the cosine of the angle between it and the line to the point.
fn point_to_dist(dx: i32, dy: i32) -> i32 {
  let ax = abs(dx)
  let ay = abs(dy)
  let long = max(ax, ay)
  let short = min(ax, ay)
  let frac = if long != 0 { fixed_div(short, long) } else { 0 }
  let angle = ((tantoangle[frac >> DBITS] + ANG90) >> ANGLETOFINESHIFT) as i32
  fixed_div(long, finesine[angle])
}

// About how far (dx, dy) is from nought, without a table: the longer
// side and half the shorter (P_AproxDistance).
fn aprox_distance(dx: i32, dy: i32) -> i32 {
  let ax = abs(dx)
  let ay = abs(dy)
  if ax < ay { ax + ay - (ax >> 1) } else { ax + ay - (ay >> 1) }
}

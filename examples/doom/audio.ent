// Where each sound's samples are in the WAD, how many, and how many of
// them a second; no samples where the WAD has no such lump.
buffer Sfxdata { at: i32, count: i32, rate: i32 } capacity 128

// The eight places a sound is heard in: which sound (0: none), and what
// makes it (as in `Sounds`).
buffer Channels { sfx: i32, origin: i32 } capacity 8
const NUMCHANNELS = 8

// The lumps of the sounds are found: after the header of eight bytes,
// sixteen bytes at either end that are not played. After `load_wad`.
system init_audio() {
  Sfxdata = []
  for i in 0..len(sfxinfo) {
    let lump = if i == 0 { -1 } else { lump_number(Lumps, lump_name(sfxinfo[i].name)) }
    if lump >= 0 && Lumps[lump].size > 40 && ushort_at(Bytes, Lumps[lump].at) == 3 {
      Sfxdata += {
        at: Lumps[lump].at + 24,
        count: min(long_at(Bytes, Lumps[lump].at + 4), Lumps[lump].size - 8) - 32,
        rate: ushort_at(Bytes, Lumps[lump].at + 2)
      }
    } else {
      Sfxdata += { at: 0, count: 0, rate: 0 }
    }
  }
  Channels = [{ sfx: 0, origin: 0 }; 8]
}

// A level's sounds end with it (S_Start).
system quiet() {
  for c in 0..NUMCHANNELS {
    voice_stop(c)
    Channels[c].sfx = 0
  }
}

// How loud (0 to 1) and from which side (-1 to 1) the device is to
// play what the game has as 0 to 127 and 0 to 255.
fn device_volume(volume: i32, loud: f32) -> f32 { (volume as f32) / 127.0 * loud }
fn device_side(sep: i32) -> f32 { ((sep - NORM_SEP) as f32) / 128.0 }

// The sounds that go on follow what makes them, and those that are over
// or too far away now leave their places (S_UpdateSounds); a thing that
// is no more takes its sound with it (P_RemoveMobj).
proc update_channels(things: Mobj, player: entity, sectors: Sectors,
                     channels: mut Channels, map: i32, loud: f32) {
  for c in 0..NUMCHANNELS {
    if channels[c].sfx != 0 {
      let origin = channels[c].origin
      var on = voice_on(c)
      if on && origin != 0 && origin != things[player].id {
        var x = 0
        var y = 0
        if origin < 0 {
          x = sectors[-1 - origin].soundx
          y = sectors[-1 - origin].soundy
        } else {
          let it = thing_by_id(things, origin)
          on = there(things, it) && !things[it].gone
          x = things[it].x
          y = things[it].y
        }
        if on {
          let volume = heard_volume(x, y, things[player].x, things[player].y, map)
          if volume > 0 {
            voice_set(c, device_volume(volume, loud),
                      device_side(heard_sep(x, y, things[player].x, things[player].y,
                                            things[player].angle)))
          } else {
            on = false
          }
        }
      }
      if !on {
        voice_stop(c)
        channels[c].sfx = 0
      }
    }
  }
}

// The tic's sounds are started (the end of S_StartSound: S_StopSound,
// S_GetChannel).
proc start_channels(sounds: Sounds, data: Sfxdata, bytes: Bytes,
                    channels: mut Channels, loud: f32) {
  for s in 0..len(sounds) {
    let sfx = sounds[s].sfx
    let origin = sounds[s].origin
    // (What made a sound before makes this one instead.)
    if origin != 0 {
      for c in 0..NUMCHANNELS {
        if channels[c].sfx != 0 && channels[c].origin == origin {
          voice_stop(c)
          channels[c].sfx = 0
        }
      }
    }
    // A free place, or the place of one that matters no more.
    var place = -1
    for c in 0..NUMCHANNELS {
      if place < 0 && channels[c].sfx == 0 { place = c }
    }
    if place < 0 {
      for c in 0..NUMCHANNELS {
        if place < 0 && sfxinfo[channels[c].sfx].priority >= sfxinfo[sfx].priority {
          place = c
        }
      }
    }
    if place >= 0 && data[sfx].count > 0 {
      channels[place].sfx = sfx
      channels[place].origin = origin
      voice(place, bytes, data[sfx].at, data[sfx].count, data[sfx].rate,
            device_volume(sounds[s].volume, loud), device_side(sounds[s].sep))
    }
  }
}

// The tune that is heard now, by its lump's name.
unique Playing: u64

// The chip is told what it is first told. After `init_music` and
// `init_chip`.
system init_tunes() {
  for i in 0..len(Writes) { chip_write(Oper, Ochan, Chip, Writes[i].reg, Writes[i].value) }
  Writes = []
}

// What is heard of a tic: after everything that starts a sound. The
// music goes on, with another tune if another is asked for
// (S_ChangeMusic): as many samples as the device wants now.
system hear() {
  // (The sounds are worked out as loud as the game starts with, eight
  // of fifteen, and made louder or quieter here.)
  let all = if Sound.off { 0.0 } else { Sound.volume }
  let loud = all * (Volume.sfx as f32) / 8.0
  update_channels(Mobj, Spawned.player, Sectors, Channels, Level.map, loud)
  start_channels(Sounds, Sfxdata, Bytes, Channels, loud)
  music_volume(Bytes, Mus, Mchan, Ovoice, Writes, Volume.music * 8)
  if Tune.name != Playing {
    Playing = Tune.name
    tune_stop(Mus, Ovoice, Vlist, Writes)
    let lump = lump_number(Lumps, Tune.name)
    if lump >= 0 {
      tune_start(Bytes, Mus, Mchan, Mmap, Velocity, Lumps[lump].at, Tune.looping)
    }
  }
  Pcm = []
  music_samples(Bytes, Mus, Mchan, Mmap, Velocity, Ovoice, Vlist, Writes, Oper, Ochan,
                Chip, Gain, Rates, Pcm, min(stream_wants(MUSIC_RATE), 16384))
  Heights = []
  for i in 0..len(Pcm) { Heights += { value: Pcm[i].value } }
  stream(Heights, len(Heights), MUSIC_RATE, all)
}

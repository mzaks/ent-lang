// How loud the chip is to be for a loudness of 0 to 127.
table volume_mapping: i32 = [
  0, 1, 3, 5, 6, 8, 10, 11,
  13, 14, 16, 17, 19, 20, 22, 23,
  25, 26, 27, 29, 30, 32, 33, 34,
  36, 37, 39, 41, 43, 45, 47, 49,
  50, 52, 54, 55, 57, 59, 60, 61,
  63, 64, 66, 67, 68, 69, 71, 72,
  73, 74, 75, 76, 77, 79, 80, 81,
  82, 83, 84, 84, 85, 86, 87, 88,
  89, 90, 91, 92, 92, 93, 94, 95,
  96, 96, 97, 98, 99, 99, 100, 101,
  101, 102, 103, 103, 104, 105, 105, 106,
  107, 107, 108, 109, 109, 110, 110, 111,
  112, 112, 113, 113, 114, 114, 115, 115,
  116, 117, 117, 118, 118, 119, 119, 120,
  120, 121, 121, 122, 122, 123, 123, 123,
  124, 124, 125, 125, 126, 126, 127, 127
]

proc opl(writes: mut Writes, reg: i32, value: i32) {
  writes += { reg: reg, value: value }
}

// Where an instrument is in the file, and one of its two settings: the
// wave that bends (six bytes), how it is fed back, the wave that is
// heard (six bytes), and how far off the note it is played.
fn instr_at(mus: Mus, instr: i32) -> i32 { mus[0].instrs + instr * 36 }
fn setting_at(mus: Mus, instr: i32, second: i32) -> i32 {
  mus[0].instrs + instr * 36 + 4 + second * 16
}

// A voice is turned off: its pitch is written without the bit that
// sounds it (VoiceKeyOff).
proc voice_key_off(voices: Ovoice, writes: mut Writes, v: i32) {
  opl(writes, 0xb0 + v, voices[v].freq >> 8)
}

// A voice that is taken becomes free, the last of the free ones
// (ReleaseVoice). (Asked for one that is not there, the reference loses
// all its voices.)
proc release_voice(mus: mut Mus, voices: mut Ovoice, lists: mut Vlist,
                   writes: mut Writes, index: i32) {
  if index >= mus[0].used {
    mus[0].used = 0
    mus[0].free = 0
  } else {
    let v = lists[index].used
    voice_key_off(voices, writes, v)
    voices[v].channel = -1
    voices[v].note = 0
    mus[0].used -= 1
    for i in index..mus[0].used { lists[i].used = lists[i + 1].used }
    lists[mus[0].free].free = v
    mus[0].free += 1
  }
}

// One wave's settings are written (LoadOperatorData): what is written
// for its loudness.
proc load_operator(bytes: Bytes, writes: mut Writes, op: i32, data: i32,
                   loudest: bool) -> i32 {
  let level = byte_at(bytes, data + 4) | if loudest { 0x3f } else { byte_at(bytes, data + 5) }
  opl(writes, 0x40 + op, level)
  opl(writes, 0x20 + op, byte_at(bytes, data))
  opl(writes, 0x60 + op, byte_at(bytes, data + 1))
  opl(writes, 0x80 + op, byte_at(bytes, data + 2))
  opl(writes, 0xe0 + op, byte_at(bytes, data + 3))
  level
}

// A voice is set for an instrument, if it is not already
// (SetVoiceInstrument): the wave that is heard first, as quiet as can
// be until the note's loudness is set.
proc set_voice_instrument(bytes: Bytes, mus: Mus, voices: mut Ovoice,
                          writes: mut Writes, v: i32, instr: i32, second: i32) {
  if voices[v].instr != instr || voices[v].second != second {
    voices[v].instr = instr
    voices[v].second = second
    let data = setting_at(mus, instr, second)
    let feedback = byte_at(bytes, data + 6)
    let bending = feedback & 1 == 0
    voices[v].car = load_operator(bytes, writes, voice_op2[v], data + 7, true)
    voices[v].mod = load_operator(bytes, writes, voice_op1[v], data, !bending)
    opl(writes, 0xc0 + v, feedback | 0x30)
    voices[v].priority = 0x0f - (byte_at(bytes, data + 8) >> 4) + 0x0f -
                         (byte_at(bytes, data + 9) & 0x0f)
  }
}

// How loud a voice is: the note's loudness times its channel's
// (SetVoiceVolume).
proc set_voice_volume(bytes: Bytes, mus: Mus, chans: Mchan, voices: mut Ovoice,
                      writes: mut Writes, v: i32, volume: i32) {
  voices[v].volume = volume
  let data = setting_at(mus, voices[v].instr, voices[v].second)
  let channel = 2 * (volume_mapping[chans[voices[v].channel].volume] + 1)
  let full = (volume_mapping[volume] * channel) >> 9
  let car = 0x3f - full
  if car != voices[v].car & 0x3f {
    voices[v].car = car | (voices[v].car & 0xc0)
    opl(writes, 0x40 + voice_op2[v], voices[v].car)
    // (Where the two waves are heard side by side, both are as loud.)
    let level = byte_at(bytes, data + 5)
    if byte_at(bytes, data + 6) & 1 != 0 && level != 0x3f {
      let mod = max(level, car) | (voices[v].mod & 0xc0)
      if mod != voices[v].mod {
        voices[v].mod = mod
        opl(writes, 0x40 + voice_op1[v], mod | (byte_at(bytes, data + 4) & 0xc0))
      }
    }
  }
}

// What is written for the pitch of a voice's note (FrequencyForVoice).
proc voice_frequency(bytes: Bytes, mus: Mus, chans: Mchan, voices: Ovoice,
                     v: i32) -> i32 {
  let instr = instr_at(mus, voices[v].instr)
  var note = voices[v].note
  if ushort_at(bytes, instr) & GENMIDI_FIXED == 0 {
    note += short_at(bytes, setting_at(mus, voices[v].instr, voices[v].second) + 14)
  }
  while note < 0 { note += 12 }
  while note > 95 { note -= 12 }
  var index = 64 + 32 * note + chans[voices[v].channel].bend
  // (The second setting of an instrument may be a little out of tune.)
  if voices[v].second != 0 { index += byte_at(bytes, instr + 2) / 2 - 64 }
  if index < 0 { index = 0 }
  if index < 284 {
    frequency_curve[index]
  } else {
    let octave = min((index - 284) / (12 * 32), 7)
    frequency_curve[(index - 284) % (12 * 32) + 284] | octave << 10
  }
}

// The pitch is written if it is another, with the bit that sounds the
// voice (UpdateVoiceFrequency).
proc update_voice_frequency(bytes: Bytes, mus: Mus, chans: Mchan,
                            voices: mut Ovoice, writes: mut Writes, v: i32) {
  let freq = voice_frequency(bytes, mus, chans, voices, v)
  if voices[v].freq != freq {
    opl(writes, 0xa0 + v, freq & 0xff)
    opl(writes, 0xb0 + v, freq >> 8 | 0x20)
    voices[v].freq = freq
  }
}

// A free voice plays a note of an instrument, if there is one
// (GetFreeVoice, VoiceKeyOn).
proc voice_key_on(bytes: Bytes, mus: mut Mus, chans: Mchan, voices: mut Ovoice,
                  lists: mut Vlist, writes: mut Writes, channel: i32, instr: i32,
                  second: i32, note: i32, key: i32, volume: i32) {
  if mus[0].free > 0 {
    let v = lists[0].free
    mus[0].free -= 1
    for i in 0..mus[0].free { lists[i].free = lists[i + 1].free }
    lists[mus[0].used].used = v
    mus[0].used += 1
    voices[v].channel = channel
    voices[v].key = key
    let at = instr_at(mus, instr)
    voices[v].note = if ushort_at(bytes, at) & GENMIDI_FIXED != 0 {
      byte_at(bytes, at + 3)
    } else {
      note
    }
    set_voice_instrument(bytes, mus, voices, writes, v, instr, second)
    set_voice_volume(bytes, mus, chans, voices, writes, v, volume)
    voices[v].freq = 0
    update_voice_frequency(bytes, mus, chans, voices, writes, v)
  }
}

// A key is let go: the voices that play it are free (KeyOffEvent).
proc key_off(mus: mut Mus, voices: mut Ovoice, lists: mut Vlist,
             writes: mut Writes, channel: i32, key: i32) {
  var i = 0
  while i < mus[0].used {
    let v = lists[i].used
    if voices[v].channel == channel && voices[v].key == key {
      release_voice(mus, voices, lists, writes, i)
    } else {
      i += 1
    }
  }
}

// All of a channel's notes end (AllNotesOff).
proc all_notes_off(mus: mut Mus, voices: mut Ovoice, lists: mut Vlist,
                   writes: mut Writes, channel: i32) {
  var i = 0
  while i < mus[0].used {
    if voices[lists[i].used].channel == channel {
      release_voice(mus, voices, lists, writes, i)
    } else {
      i += 1
    }
  }
}

// A key is pressed (KeyOnEvent): a drum is an instrument of its own for
// each key. Where no voice is free one is taken away: one that plays an
// instrument's second setting, or else of the last channel.
proc key_on(bytes: Bytes, mus: mut Mus, chans: Mchan, voices: mut Ovoice,
            lists: mut Vlist, writes: mut Writes, channel: i32, key: i32,
            volume: i32) {
  if volume <= 0 {
    key_off(mus, voices, lists, writes, channel, key)
  } else if channel != PERCUSSION || (key >= 35 && key <= 81) {
    let instr = if channel == PERCUSSION { 128 + key - 35 } else { chans[channel].instr }
    let note = if channel == PERCUSSION { 60 } else { key }
    if mus[0].free == 0 {
      var found = 0
      for i in 0..mus[0].used {
        if voices[lists[i].used].second != 0 ||
           voices[lists[i].used].channel >= voices[lists[found].used].channel {
          found = i
        }
      }
      release_voice(mus, voices, lists, writes, found)
    }
    voice_key_on(bytes, mus, chans, voices, lists, writes, channel, instr, 0, note,
                 key, volume)
    if ushort_at(bytes, instr_at(mus, instr)) & GENMIDI_DOUBLE != 0 {
      voice_key_on(bytes, mus, chans, voices, lists, writes, channel, instr, 1, note,
                   key, volume)
    }
  }
}

// A channel is to be so loud: no louder than music is, nor than it was
// when the tune started (SetChannelVolume).
proc set_channel_volume(bytes: Bytes, mus: Mus, chans: mut Mchan,
                        voices: mut Ovoice, writes: mut Writes, channel: i32,
                        volume: i32) {
  chans[channel].base = volume
  chans[channel].volume = min(min(volume, mus[0].volume), mus[0].start)
  for v in 0..OPL_VOICES {
    if voices[v].channel == channel {
      set_voice_volume(bytes, mus, chans, voices, writes, v, voices[v].volume)
    }
  }
}

// A channel's notes are bent (PitchBendEvent): its voices get their new
// pitch, and become the last of those that are taken.
proc pitch_bend(bytes: Bytes, mus: Mus, chans: mut Mchan, voices: mut Ovoice,
                lists: mut Vlist, writes: mut Writes, channel: i32, bend: i32) {
  chans[channel].bend = bend
  // (The free list's rows that are not in use hold the others meanwhile.)
  var kept = 0
  var moved = 0
  for i in 0..mus[0].used {
    let v = lists[i].used
    if voices[v].channel == channel {
      update_voice_frequency(bytes, mus, chans, voices, writes, v)
      lists[mus[0].free + moved].free = v
      moved += 1
    } else {
      lists[kept].used = v
      kept += 1
    }
  }
  for i in 0..moved { lists[kept + i].used = lists[mus[0].free + i].free }
}

// The channel one of the tune's own is played on (mus2mid.c,
// GetMIDIChannel, and TrackChannelForEvent): the drums on the last, the
// others in the order they come. `fresh` where it comes now.
proc tune_channel(map: mut Mmap, own: i32) -> i32 {
  if own != PERCUSSION && map[own].channel == -1 {
    var most = -1
    for i in 0..16 { most = max(most, map[i].channel) }
    // (The tenth is left out: that is where the drums are counted.)
    map[own].channel = if most + 1 == 9 { 10 } else { most + 1 }
  }
  if own == PERCUSSION {
    PERCUSSION
  } else if map[own].channel == 15 {
    9
  } else {
    map[own].channel
  }
}

// Which of the sixteen key-hardnesses a channel has (the reference
// keeps them by its own numbering, in which the drums are the tenth).
fn hardness(channel: i32) -> i32 {
  if channel == PERCUSSION {
    9
  } else if channel == 9 {
    15
  } else {
    channel
  }
}

// A number in a tune: seven bits a byte, the high bit says another
// follows. How many bytes it has.
fn delay_bytes(bytes: Bytes, at: i32) -> i32 {
  var n = 1
  while byte_at(bytes, at + n - 1) & 0x80 != 0 { n += 1 }
  n
}
fn delay_at(bytes: Bytes, at: i32) -> i32 {
  var value = 0
  for i in 0..delay_bytes(bytes, at) { value = value * 128 + (byte_at(bytes, at + i) & 0x7f) }
  value
}

// How many bytes an event of a tune has after its first, by its kind.
fn event_bytes(bytes: Bytes, at: i32) -> i32 {
  let kind = byte_at(bytes, at) & 0x70
  if kind == 0x10 {
    if byte_at(bytes, at + 1) & 0x80 != 0 { 2 } else { 1 }
  } else if kind == 0x40 {
    2
  } else if kind == 0x60 || kind == 0x50 || kind == 0x70 {
    0
  } else {
    1
  }
}

// The channels start a tune as they always do (InitChannel), none of
// the tune's own has had its say, and the keys are hit as hard as they
// were when the tune was first started.
proc tune_begin(mus: mut Mus, chans: mut Mchan, map: mut Mmap, vel: mut Velocity) {
  mus[0].pos = mus[0].score
  mus[0].start = mus[0].volume
  mus[0].due = 0
  mus[0].again = false
  for i in 0..16 {
    chans[i].instr = 0
    chans[i].volume = min(mus[0].volume, 100)
    chans[i].base = 100
    chans[i].bend = 0
    map[i].channel = -1
    vel[i].now = vel[i].start
  }
}

// A tune is started (I_OPL_RegisterSong, I_OPL_PlaySong): the lump at
// `at`. How hard the keys are hit at its end is found by reading it
// through, for the tune after it.
proc tune_start(bytes: Bytes, mus: mut Mus, chans: mut Mchan, map: mut Mmap,
                vel: mut Velocity, at: i32, looping: bool) {
  mus[0].score = at + ushort_at(bytes, at + 6)
  mus[0].on = true
  mus[0].looping = looping
  for i in 0..16 { vel[i].start = vel[i].end }
  tune_begin(mus, chans, map, vel)
  var pos = mus[0].score
  var going = true
  while going {
    let first = byte_at(bytes, pos)
    let channel = hardness(tune_channel(map, first & 0x0f))
    let kind = first & 0x70
    if kind == 0x10 && byte_at(bytes, pos + 1) & 0x80 != 0 {
      vel[channel].end = byte_at(bytes, pos + 2) & 0x7f
    }
    if kind == 0x60 || kind == 0x50 || kind == 0x70 { going = false }
    pos += 1 + event_bytes(bytes, pos)
    if going && first & 0x80 != 0 { pos += delay_bytes(bytes, pos) }
  }
  for i in 0..16 { map[i].channel = -1 }
}

// The tune ends: all notes do (I_OPL_StopSong).
proc tune_stop(mus: mut Mus, voices: mut Ovoice, lists: mut Vlist,
               writes: mut Writes) {
  if mus[0].on {
    for channel in 0..16 { all_notes_off(mus, voices, lists, writes, channel) }
  }
  mus[0].on = false
}

// The notes that are due now are played (mus2mid, ProcessEvent): one
// after another until one says how long to wait. At the tune's end it
// starts again a moment later, if it is to. Call it while `due` is
// nought and the tune is on.
proc tune_events(bytes: Bytes, mus: mut Mus, chans: mut Mchan, map: mut Mmap,
                 vel: mut Velocity, voices: mut Ovoice, lists: mut Vlist,
                 writes: mut Writes) {
  if mus[0].again { tune_begin(mus, chans, map, vel) }
  var going = true
  while going {
    let pos = mus[0].pos
    let first = byte_at(bytes, pos)
    let own = first & 0x0f
    // (A channel that has its say for the first time has all its notes
    // ended before: there may be some left from the time before.)
    let fresh = own != PERCUSSION && map[own].channel == -1
    let channel = tune_channel(map, own)
    if fresh { all_notes_off(mus, voices, lists, writes, channel) }
    let kind = first & 0x70
    let a = byte_at(bytes, pos + 1)
    let b = byte_at(bytes, pos + 2)
    if kind == 0x00 {
      key_off(mus, voices, lists, writes, channel, a & 0x7f)
    } else if kind == 0x10 {
      if a & 0x80 != 0 { vel[hardness(channel)].now = b & 0x7f }
      key_on(bytes, mus, chans, voices, lists, writes, channel, a & 0x7f,
             vel[hardness(channel)].now)
    } else if kind == 0x20 {
      pitch_bend(bytes, mus, chans, voices, lists, writes, channel, a / 2 - 64)
    } else if kind == 0x30 {
      if a == 11 { all_notes_off(mus, voices, lists, writes, channel) }
    } else if kind == 0x40 {
      if a == 0 {
        chans[channel].instr = b & 0x7f
      } else if a == 3 {
        set_channel_volume(bytes, mus, chans, voices, writes, channel,
                           if b & 0x80 != 0 { 127 } else { b })
      }
    } else {
      // The end.
      going = false
      if mus[0].looping {
        mus[0].again = true
        mus[0].due = MUSIC_AGAIN
      } else {
        mus[0].on = false
      }
    }
    if going {
      mus[0].pos = pos + 1 + event_bytes(bytes, pos)
      if first & 0x80 != 0 {
        let delay = delay_at(bytes, mus[0].pos)
        mus[0].pos += delay_bytes(bytes, mus[0].pos)
        if delay > 0 {
          mus[0].due = delay * MUSIC_TIC
          going = false
        }
      }
    }
  }
}

// The voices are all free and set for nothing, the keys are hit as hard
// as can be, and music is as loud as the game starts with (InitVoices;
// eight of fifteen in the menu, times eight). After `load_wad`; what it
// leaves in `Writes` is for the chip.
system init_music() {
  Mus = [{
    score: 0, pos: 0, on: false, looping: false, again: false, due: 0,
    volume: 64, start: 64, free: OPL_VOICES, used: 0,
    instrs: Lumps[lump_number(Lumps, lump_name("GENMIDI"))].at + 8
  }; 1]
  Mchan = [{ instr: 0, volume: 64, base: 100, bend: 0 }; 16]
  Mmap = [{ channel: -1 }; 16]
  Velocity = [{ start: 127, now: 127, end: 127 }; 16]
  Ovoice = [{
    instr: -1, second: 0, channel: -1, key: 0, note: 0, freq: 0, volume: 0,
    car: 0, mod: 0, priority: 0
  }; OPL_VOICES]
  Vlist = [{ free: 0, used: 0 }; OPL_VOICES]
  for i in 0..OPL_VOICES { Vlist[i].free = i }
  // What the chip is first told (OPL_InitRegisters): every wave as
  // quiet as can be and everything else nought (also in registers the
  // chip has not), then that waves may have other shapes than the plain
  // one, and which bit of a pitch hurries a note's loudness along.
  Writes = []
  for reg in 0x40..0x56 { opl(Writes, reg, 0x3f) }
  for reg in 0x60..0xf6 { opl(Writes, reg, 0) }
  for reg in 1..0x40 { opl(Writes, reg, 0) }
  opl(Writes, 0x04, 0x60)
  opl(Writes, 0x04, 0x80)
  opl(Writes, 0x01, 0x20)
  opl(Writes, 0x08, 0x40)
}

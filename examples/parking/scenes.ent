// The places to park in (parking-SPEC.md, 9): each a row of `scenes`
// and the rows of `things` that have its number. A thing is a box by
// its middle, its heading (degrees) and its size, of a height
// (park.ent's `Height`); `stage()` makes the scene chosen of them and
// stands the vehicle chosen at its start, and `judge()` says whether it
// is parked: standing, all of its body in the slot, and headed along it.
//
// What moves in a scene is in `movers`: `watch_car()` and `move()` go
// before every step of the vehicle.
//
// These are places for one vehicle (the first); the slot is its `Goal`
// and all the edges are its `Place` (park.ent). The last row of
// `scenes` is the car park of many, which lot.ent makes.
//
// Metres; x to the right and y up, as park.ent has them.
import math
import vehicles
import park

// A scene: where the vehicle starts (its rear axle's middle and its
// heading, degrees), the slot (a box by its middle, heading and size)
// that it is to stand in, headed along it either way, or only as the
// slot is where `turned` says so, and what of the place is shown: so
// many metres across, round (cx, cy). `dark`: a place without light,
// where cameras see worse. `hitch`: the trailer it comes with (a row of
// `trailers` and one; 0: none), which is then what is to stand in the
// slot.
table scenes { name: text[40], x: f32, y: f32, heading: f32,
               slot_x: f32, slot_y: f32, slot_heading: f32, slot_length: f32,
               slot_width: f32, turned: bool, cx: f32, cy: f32, across: f32, dark: bool,
               hitch: i32 } = [
  { name: "Parallel, a gap of 6.2 m at the kerb", x: 4.2, y: 3.35, heading: 0.0,
    slot_x: 0.0, slot_y: 1.1, slot_heading: 0.0, slot_length: 6.2, slot_width: 2.2,
    turned: false, cx: 0.0, cy: 3.2, across: 24.0, dark: false, hitch: 0 },
  { name: "A bay between two cars, 2.5 m wide", x: -7.0, y: 7.2, heading: 0.0,
    slot_x: 0.0, slot_y: 2.5, slot_heading: 90.0, slot_length: 5.0, slot_width: 2.5,
    turned: false, cx: 0.0, cy: 5.0, across: 24.0, dark: false, hitch: 0 },
  { name: "A garage, its door 2.4 m wide", x: -7.5, y: 2.2, heading: 0.0,
    slot_x: 0.0, slot_y: 8.2, slot_heading: 90.0, slot_length: 6.0, slot_width: 2.8,
    turned: false, cx: 0.0, cy: 5.4, across: 26.0, dark: false, hitch: 0 },
  { name: "A dead end 7 m wide: turn round", x: 0.8, y: 2.0, heading: 0.0,
    slot_x: 4.0, slot_y: 5.0, slot_heading: 180.0, slot_length: 9.0, slot_width: 3.6,
    turned: true, cx: 6.0, cy: 3.5, across: 22.0, dark: false, hitch: 0 },
  // The places made to fool the sensors (parking-SPEC.md, 9: 6 to 10).
  { name: "A bollard in the corner of a bay", x: -7.0, y: 7.2, heading: 0.0,
    slot_x: 0.0, slot_y: 2.5, slot_heading: 90.0, slot_length: 5.0, slot_width: 2.5,
    turned: false, cx: 0.0, cy: 5.0, across: 24.0, dark: false, hitch: 0 },
  { name: "A wheel stop before the wall", x: -7.0, y: 7.2, heading: 0.0,
    slot_x: 0.0, slot_y: 2.5, slot_heading: 90.0, slot_length: 5.0, slot_width: 2.5,
    turned: false, cx: 0.0, cy: 5.0, across: 24.0, dark: false, hitch: 0 },
  { name: "A lorry's tail lift over the gap", x: 5.2, y: 4.0, heading: 0.0,
    slot_x: 0.0, slot_y: 1.1, slot_heading: 0.0, slot_length: 6.2, slot_width: 2.2,
    turned: false, cx: 0.0, cy: 3.2, across: 26.0, dark: false, hitch: 0 },
  { name: "White walls in a dark garage", x: -7.0, y: 8.0, heading: 0.0,
    slot_x: 0.0, slot_y: 2.75, slot_heading: 90.0, slot_length: 5.5, slot_width: 2.7,
    turned: false, cx: 0.0, cy: 5.0, across: 24.0, dark: true, hitch: 0 },
  { name: "A charger: back up to the post", x: -7.0, y: 7.8, heading: 0.0,
    slot_x: 0.0, slot_y: 3.2, slot_heading: 90.0, slot_length: 5.2, slot_width: 2.7,
    turned: true, cx: 0.0, cy: 5.0, across: 24.0, dark: false, hitch: 0 },
  // The places where things move (parking-SPEC.md, 9: 11 and 12).
  { name: "A bay: a walker, a trolley, a door", x: -7.0, y: 7.2, heading: 0.0,
    slot_x: 0.0, slot_y: 2.5, slot_heading: 90.0, slot_length: 5.0, slot_width: 2.5,
    turned: false, cx: 0.0, cy: 5.0, across: 24.0, dark: false, hitch: 0 },
  { name: "Backing out between two vans", x: 0.0, y: 4.1, heading: -90.0,
    slot_x: 6.0, slot_y: 6.6, slot_heading: 0.0, slot_length: 9.0, slot_width: 3.0,
    turned: true, cx: 0.0, cy: 5.0, across: 28.0, dark: false, hitch: 0 },
  // A place to back a trailer into (parking-SPEC.md, 9: 14).
  { name: "A yard: back the trailer into the bay", x: 11.0, y: 13.0, heading: 0.0,
    slot_x: 0.0, slot_y: 3.1, slot_heading: 90.0, slot_length: 6.0, slot_width: 3.4,
    turned: false, cx: 3.0, cy: 11.0, across: 46.0, dark: false, hitch: 1 },
  // The car park of many vehicles (parking-SPEC.md, 9: 13), which
  // lot.ent makes: of this row only what is shown of it, and its name.
  { name: "A car park: six park at once", x: 0.0, y: 0.0, heading: 0.0,
    slot_x: 0.0, slot_y: 0.0, slot_heading: 0.0, slot_length: 0.0, slot_width: 0.0,
    turned: false, cx: 23.75, cy: 18.0, across: 76.0, dark: false, hitch: 0 }
]
// So many of the places are for one vehicle: all but the last.
const SINGLE: i32 = 12

table things { scene: i32, x: f32, y: f32, heading: f32, length: f32, width: f32,

// Layout: boxes inside boxes, each as wide and high as it is told, as its
// content needs or as there is room, placed in a row or a column inside
// the box it is in. A library: a program imports it, makes boxes, says
// which is inside which, and runs `layout` every frame, which works out
// what has changed since it last ran (examples/layout_demo.ent draws the
// result in a window).
//
// The sizes are those of Clay (github.com/nicbarker/clay): a box is
// `fixed` (as wide as `w` says), `fit` (as wide as what is in it) or
// `grow` (as wide as its share of the room that is left).

// Where a box is and how big: what `layout` works out. A box that is
// inside no other keeps what the program gave it.
component Box { x: f32, y: f32, w: f32, h: f32 }

// How wide and how high a box is to be: `Fixed`, as `Box.w` and `Box.h`
// say when `layout` starts; `Fit`, as what is inside it needs; `Grow`, as
// there is room in the box it is in (starting from what `Box` says).
enum Sizing { Fixed, Fit, Grow }
component Size { w: Sizing, h: Sizing }

// What a box does with the boxes inside it: one after another in a row,
// or below one another; `pad` between its edge and them, `gap` between
// them.
component Stack { row: bool, pad: f32, gap: f32 }

// Where a box comes among those in the same box: smaller first. Boxes
// without one, or with the same, are in the order they were made.
component Slot { at: i32 }

// What `layout` keeps for itself, and gives to every box that has not
// got it: what the boxes inside a box come to (how many, their widths and
// heights added and the largest, and how many of them grow).
component Content {
  count: i32, sum_w: f32, max_w: f32, sum_h: f32, max_h: f32,
  grow_w: i32, grow_h: i32
}

// From a box to the one it is in; the boxes in one box are in the order
// of their slots.
relation Inside from Box to Box tree ordered by Slot.at capacity 256

// Three passes over the boxes, each a `for` along the tree, and each
// reactive: it runs for a box only where something it reads has changed
// since it last ran, in the box itself, in the box it is in, in the one
// before it or in one inside it. A box that is given the size it has is
// not written, so that nothing follows from it.
system layout() {
  for e, b: Box without Content {
    e.add(Content {
      count: 0, sum_w: 0.0, max_w: 0.0, sum_h: 0.0, max_h: 0.0,
      grow_w: 0, grow_h: 0
    })
  }

  // As wide and as high as what is in it, from the innermost boxes out:
  // a box adds up the boxes inside it, which have been visited. Only
  // where it is asked for another size, stands them another way, or one
  // of them has another size, or has come or gone.
  for e, b: mut Box, s: Size, k: Stack, c: mut Content
      cascade Inside leaves first
      on changed Size, changed Stack, changed Box.w down Inside,
         changed Box.h down Inside, changed Size down Inside {
    c.count = 0
    c.sum_w = 0.0
    c.max_w = 0.0
    c.sum_h = 0.0
    c.max_h = 0.0
    c.grow_w = 0
    c.grow_h = 0
    for inside, child in e.in(Inside) {
      if let w = Box(child).w, let h = Box(child).h,
         let sw = Size(child).w, let sh = Size(child).h {
        c.count += 1
        c.sum_w += w
        c.max_w max= w
        c.sum_h += h
        c.max_h max= h
        if sw == Sizing.Grow { c.grow_w += 1 }
        if sh == Sizing.Grow { c.grow_h += 1 }
      }
    }
    let gaps = if c.count > 1 { k.gap * (c.count - 1) as f32 } else { 0.0 }
    if s.w == Sizing.Fit {
      let w = (if k.row { c.sum_w + gaps } else { c.max_w }) + 2.0 * k.pad
      if b.w != w { b.w = w }
    }
    if s.h == Sizing.Fit {
      let h = (if k.row { c.max_h } else { c.sum_h + gaps }) + 2.0 * k.pad
      if b.h != h { b.h = h }
    }
  }

  // The room that is left in a box goes to those inside it that grow:
  // along the row or column in equal shares, across it all of it. From
  // the outermost boxes in, since a box that grew has more room to give;
  // only where the box it is in has another size or other boxes in it.
  for b: mut Box, s: Size,
      outer: Box up Inside, k: Stack up Inside, c: Content up Inside
      cascade Inside
      on changed Size, changed Box.w up Inside, changed Box.h up Inside,
         changed Stack up Inside, changed Content up Inside {
    let gaps = if c.count > 1 { k.gap * (c.count - 1) as f32 } else { 0.0 }
    let room_w = outer.w - 2.0 * k.pad
    let room_h = outer.h - 2.0 * k.pad
    if s.w == Sizing.Grow {
      let w = if k.row { b.w + (room_w - c.sum_w - gaps) / c.grow_w as f32 }
              else { room_w }
      if b.w != w { b.w = w }
    }
    if s.h == Sizing.Grow {
      let h = if k.row { room_h }
              else { b.h + (room_h - c.sum_h - gaps) / c.grow_h as f32 }
      if b.h != h { b.h = h }
    }
  }

  // A box starts where the one before it in the same box ends, and a
  // gap further; the first inside the padding of the box they are in.
  // Only where the box it is in has moved, or the one before it has
  // moved, has another size or is another.
  for b: mut Box, outer: Box up Inside, k: Stack up Inside,
      optional prev: Box before Inside cascade Inside
      on changed Box.x up Inside, changed Box.y up Inside,
         changed Stack up Inside, changed Box before Inside {
    var x = outer.x + k.pad
    var y = outer.y + k.pad
    if let px = prev.x, let py = prev.y, let w = prev.w, let h = prev.h {
      if k.row { x = px + w + k.gap } else { y = py + h + k.gap }
    }
    if b.x != x { b.x = x }
    if b.y != y { b.y = y }
  }
}

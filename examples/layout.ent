// Layout: boxes inside boxes, each as wide and high as it is told, as its
// content needs or as there is room, placed in a row or a column inside
// the box it is in. A library: a program imports it, makes boxes, says
// which is inside which, and runs `layout` every frame, which works out
// what has changed since it last ran (examples/layout_demo.ent draws the
// result in a window).
//
// The sizes are those of Clay (github.com/nicbarker/clay): a box is
// `fixed` (as wide as `w` says), `fit` (as wide as what is in it) or
// `grow` (as wide as its share of the room that is left). Across its row
// or column a box's contents can stand in the middle or at the end
// (`Align`); a box can float over another (`Float`, `Over`), a layer
// above it; and a box can carry a line of text (`Label`), or one that
// goes on in the next line (`Wrap`).

// Where a box is and how big: what `layout` works out. A box that is
// inside no other keeps what the program gave it.
component Box { x: f32, y: f32, w: f32, h: f32 }

// How wide and how high a box is to be: `Fixed`, as `Box.w` and `Box.h`
// say when `layout` starts; `Fit`, as what is inside it needs; `Grow`, as
// there is room in the box it is in (starting from what `Box` says).
enum Sizing { Fixed, Fit, Grow }
component Size { w: Sizing, h: Sizing }

// What a box does with the boxes inside it: one after another in a row,
// or below one another; `pad` between its edge and them, `gap` between
// them.
component Stack { row: bool, pad: f32, gap: f32 }

// Across its row or column, where the boxes inside a box stand: at the
// start (as without this), in the middle or at the end.
enum Across { Start, Middle, End }
component Align { across: Across }

// A line of text in a box. The box is as big as the program makes it:
// how wide a text is, only what draws it knows (examples/layout_demo.ent
// asks the window).
component Label { text: text[126], size: f32, colour: i32 }

// A label whose text goes on in the next line where its box ends. How
// high that makes it, again only what draws it knows: the program gives
// the box that height when `layout` has given it its width, and runs
// `layout` once more, which reacts to that alone.
tag Wrap

// A box that floats over another: so far from that one's corner, in
// nobody's row, and with all that is inside it a layer above.
component Float { dx: f32, dy: f32 }

// Where a box comes among those in the same box: smaller first. Boxes
// without one, or with the same, are in the order they were made.
component Slot { at: i32 }

// What `layout` keeps for itself, and gives to every box that has not
// got it: what the boxes inside a box come to (how many, their widths and
// heights added and the largest, and how many of them grow).
component Content {
  count: i32, sum_w: f32, max_w: f32, sum_h: f32, max_h: f32,
  grow_w: i32, grow_h: i32
}

// The layer a box is in, which `layout` works out and a program draws
// by: 0, and for a box that floats, with all inside it, one more than
// the box it floats over.
component Layer { z: i32 }

// From a box to the one it is in; the boxes in one box are in the order
// of their slots.
relation (Box)-[Inside]->(Box) tree ordered by Slot.at capacity 256
// From a box that floats to the one it floats over.
relation (Float)-[Over]->(Box) tree capacity 256

// Passes over the boxes, each a `for` along a tree, and each reactive:
// it runs for a box only where something it reads has changed since it
// last ran, in the box itself, in the box it is in, in the one
// before it or in one inside it. Giving a box the size it has is no
// change, and nothing follows from it.
system layout() {
  for e, b: Box without Content {
    e.add(Content {
      count: 0, sum_w: 0.0, max_w: 0.0, sum_h: 0.0, max_h: 0.0,
      grow_w: 0, grow_h: 0
    })
    e.add(Layer { z: 0 })
  }

  // As wide and as high as what is in it, from the innermost boxes out:
  // a box adds up the boxes inside it, which have been visited. Only
  // where it is asked for another size, stands them another way, or one
  // of them has another size, or has come or gone.
  for (b: mut Box, s: Size, k: Stack, c: mut Content)
      bottom up Inside
      on changed s, changed k, changed (: Box.w)-[Inside]->(b),
         changed (: Box.h)-[Inside]->(b), changed (: Size)-[Inside]->(b) {
    c.count = 0
    c.sum_w = 0.0
    c.max_w = 0.0
    c.sum_h = 0.0
    c.max_h = 0.0
    c.grow_w = 0
    c.grow_h = 0
    for (inner: Box, wants: Size)-[Inside]->(b) {
      c.count += 1
      c.sum_w += inner.w
      c.max_w max= inner.w
      c.sum_h += inner.h
      c.max_h max= inner.h
      if wants.w == Sizing.Grow { c.grow_w += 1 }
      if wants.h == Sizing.Grow { c.grow_h += 1 }
    }
    let gaps = if c.count > 1 { k.gap * (c.count - 1) as f32 } else { 0.0 }
    if s.w == Sizing.Fit {
      let w = (if k.row { c.sum_w + gaps } else { c.max_w }) + 2.0 * k.pad
      b.w = w
    }
    if s.h == Sizing.Fit {
      let h = (if k.row { c.max_h } else { c.sum_h + gaps }) + 2.0 * k.pad
      b.h = h
    }
  }

  // The room that is left in a box goes to those inside it that grow:
  // along the row or column in equal shares, across it all of it. From
  // the outermost boxes in, since a box that grew has more room to give;
  // only where the box it is in has another size or other boxes in it.
  for (b: mut Box, s: Size)-[Inside]->(outer: Box, k: Stack, c: Content)
      top down Inside
      on changed s, changed outer.w, changed outer.h, changed k, changed c {
    let gaps = if c.count > 1 { k.gap * (c.count - 1) as f32 } else { 0.0 }
    let room_w = outer.w - 2.0 * k.pad
    let room_h = outer.h - 2.0 * k.pad
    if s.w == Sizing.Grow {
      let w = if k.row { b.w + (room_w - c.sum_w - gaps) / c.grow_w as f32 }
              else { room_w }
      b.w = w
    }
    if s.h == Sizing.Grow {
      let h = if k.row { room_h }
              else { b.h + (room_h - c.sum_h - gaps) / c.grow_h as f32 }
      b.h = h
    }
  }

  // Placing and floating take turns: a box that floats is put where the
  // box under it is, which must have been placed; and what is inside it
  // is placed from where it has been put. Three rounds reach a box that
  // floats over one inside another that floats (one nested deeper still
  // is a frame late); a round with nothing new to react to does nothing.
  for round in 0..3 {
    // A box starts where the one before it in the same box ends, and a
    // gap further; the first inside the padding of the box they are in.
    // Across the row or column it stands at the padding, or where the box
    // it is in says: in the middle of the room there, or at its end. Only
    // where the box it is in or the one before it has moved, has another
    // size or is another, or it has another size itself. It is in the
    // layer of the box it is in.
    for (b: mut Box, l: mut Layer)-[Inside]->(outer: Box, k: Stack, ol: Layer),
        optional (prev: Box)~[Inside]~>(b),
        optional (b)-[Inside]->(how: Align)
        top down Inside
        on changed b.w, changed b.h, changed outer, changed k, changed ol,
           changed prev, changed how {
      var x = outer.x + k.pad
      var y = outer.y + k.pad
      var part = 0.0
      if let across = how.across {
        if across == Across.Middle { part = 0.5 }
        if across == Across.End { part = 1.0 }
      }
      if k.row { y += (outer.h - 2.0 * k.pad - b.h) * part }
      else { x += (outer.w - 2.0 * k.pad - b.w) * part }
      if let px = prev.x, let py = prev.y, let w = prev.w, let h = prev.h {
        if k.row { x = px + w + k.gap } else { y = py + h + k.gap }
      }
      b.x = x
      b.y = y
      l.z = ol.z
    }

    // A box that floats is so far from the corner of the one it floats
    // over, which has just been placed, and a layer above it.
    for (f: mut Box, o: Float, l: mut Layer)-[Over]->(under: Box, ul: Layer)
        top down Over
        on changed o, changed under.x, changed under.y, changed ul {
      let x = under.x + o.dx
      let y = under.y + o.dy
      f.x = x
      f.y = y
      l.z = ul.z + 1
    }
  }
}

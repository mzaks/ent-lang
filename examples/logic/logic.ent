// A circuit run clock cycle by clock cycle (circuit.ent has the circuit).
//
//   schedule setup() { netlist()  levels()  build()  plan()  pins() }
//   schedule cycle() {
//     draw()  stimulus()  gates()  show()  latch()  edge()  note()  tick()
//   }
//   schedule done()  { finish() }
//
// In a cycle the inputs get their values, the ANDs are worked out so
// that each comes after its inputs, the outputs are noted, and the
// flip-flops take what stands at their inputs: first all of them note it
// (`latch`), then all of them show it (`edge`), so that none sees
// another's new value.
//
// A value is 64 bits: 64 runs of the circuit side by side, each with
// inputs of its own, and an AND of two values is the AND of all 64 at
// once.
//
// What the inputs are in a cycle stands in the buffer `Stim`, a row an
// input, and what the outputs are is put into `Seen`, a row an output:
// whoever is around the circuit fills the one and reads the other. Here
// `draw` fills `Stim` with what is worked out from the seed, which input
// it is and the cycle (`drawn`), so nothing of it is kept and the same
// can be written down for another simulator (check/equal.py); and `note`
// writes the outputs of the first of the 64 runs to the file
// "outputs.txt", a line of 0s and 1s for each cycle, where `Run.shown`
// says so, and keeps a number made of all outputs of all runs and cycles
// in `Run.sum` either way. (bus.ent is another around a circuit: a
// processor's memory.)
//
// A file "run.txt" where the program is started says how many cycles and
// the seed, two whole numbers, and with a third, 0, that no outputs are
// to be written, and with a fourth which way the gates are gone through
// (`Run.way`); without one it is 1000 cycles, seed 1.
import files
import console
import circuit

// (`written`: whether some of the outputs' lines are in their file yet.)
// `way`: how the gates are gone through (0: as entities by their level;
// 1: as rows of buffers, plain.ent; 2: as entities, only those whose
// inputs changed, events.ent).
unique Run {
  cycles: i32, seed: i64, shown: bool, cycle: i32, sum: u64, written: bool, way: i32
}

// The inputs' values of the cycle, and the outputs'.
buffer Stim { bits: u64 } capacity 16
buffer Seen { bits: u64 } capacity 16

world {
  Run.cycles = 1000
  Run.seed = 1
  Run.shown = true
}

fn mix(x: u64) -> u64 {
  let a = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9
  let b = (a ^ (a >> 27)) * 0x94d049bb133111eb
  b ^ (b >> 31)
}

// The 64 values of an input in a cycle, one for each run.
fn drawn(seed: i64, index: i32, cycle: i32) -> u64 {
  mix(mix(seed as u64 + 0x9e3779b97f4a7c15 * (index as i64 as u64 + 1)) ^
      (cycle as i64 as u64 * 0xd1342543de82ef95 + 1))
}

fn side(bits: u64, inverted: bool) -> u64 { if inverted { ~bits } else { bits } }

system plan() {
  let size = read_file("run.txt", Bytes)
  if size > 0 {
    let (cycles, next) = number(Bytes, 0)
    let (seed, after) = number(Bytes, next)
    Run.cycles = cycles
    Run.seed = seed as i64
    // (A third number, 0, for a run that writes no outputs.)
    let (shown, last) = number(Bytes, after)
    if more(Bytes, after) { Run.shown = shown != 0 }
    // (And a fourth: which way the gates are gone through.)
    let (way, end) = number(Bytes, last)
    if more(Bytes, last) { Run.way = way }
  }
  Bytes = []
  Run.cycle = 0
  Run.sum = 0
  Run.written = false
}

// A row for each input and each output.
system pins() {
  Stim = []
  Seen = []
  for i in 0..Circuit.inputs { Stim += { bits: 0 } }
  for i in 0..Circuit.outputs { Seen += { bits: 0 } }
}

system draw() {
  for i in 0..len(Stim) { Stim[i].bits = drawn(Run.seed, i, Run.cycle) }
}

system stimulus() {
  for i: Input, v: mut Value where i.index >= 0 {
    v.bits = Stim[i.index].bits
  }
}

// The ANDs, one after another by their level: each finds its inputs
// worked out.
system gates() {
  for g: And, v: mut Value in turn by g.level {
    if let a = Value(g.a).bits {
      if let b = Value(g.b).bits {
        v.bits = side(a, g.not_a) & side(b, g.not_b)
      }
    }
  }
}

// The outputs as they stand.
system show() {
  for i in 0..len(Outs) {
    if let bits = Value(Outs[i].who).bits {
      Seen[i].bits = side(bits, Outs[i].shown % 2 == 1)
    }
  }
}

// The outputs into the sum, and the first run's as a line.
system note() {
  for i in 0..len(Seen) {
    Run.sum = mix(Run.sum ^ Seen[i].bits)
    if Run.shown { Bytes += { value: (48 + (Seen[i].bits & 1)) as u8 } }
  }
  if Run.shown {
    Bytes += { value: 10 }
    // (Written out before there is no more room for a cycle's line.)
    if len(Bytes) + len(Seen) + 1 > 1000000 {
      write_bytes("outputs.txt", Bytes, 0, len(Bytes), Run.written)
      Run.written = true
      Bytes = []
    }
  }
}

system latch() {
  for f: mut Flop {
    if let bits = Value(f.from).bits { f.next = side(bits, f.inverted) }
  }
}

system edge() {
  for f: Flop, v: mut Value { v.bits = f.next }
}

system tick() {
  Run.cycle += 1
}

system finish() {
  if Run.shown {
    write_bytes("outputs.txt", Bytes, 0, len(Bytes), Run.written)
    Bytes = []
  }
  put("cycles {Run.cycle} sum {Run.sum}")
}
